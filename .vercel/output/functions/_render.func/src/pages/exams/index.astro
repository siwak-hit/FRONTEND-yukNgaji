---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
import ModalAlert from '../../components/ModalAlert.astro';
---

<Layout title="Bank Ujian - yukNgaji">
    <div class="px-6 py-8 pb-32 min-h-screen flex flex-col">

        <header class="flex justify-between items-start mb-6">
            <div class="min-w-0">
                <p class="eyebrow mb-1">Kelola Evaluasi</p>
                <h1 class="page-title">Bank Ujian</h1>
            </div>
            <button onclick="openCreateModal()" class="fab flex-shrink-0" aria-label="Buat ujian">
                <i class="fa-solid fa-plus text-lg"></i>
            </button>
        </header>

        <!-- Tombol 1: Banner Ujian Lisan / Hafalan -->
        <a href="/ujian-hafalan" class="card card-interactive card-pad mb-4 flex items-center gap-4" style="background-color: var(--accent-soft); border-color: transparent;">
            <div class="icon-chip" style="background-color:#fff; color: var(--accent-strong);">
                <i class="fa-solid fa-microphone-lines text-lg"></i>
            </div>
            <div class="flex-1 min-w-0">
                <p class="eyebrow" style="color: var(--accent-strong);">Mode Lisan</p>
                <h2 class="section-title" style="color: var(--accent-strong);">Ujian Hafalan / Lisan</h2>
                <p class="text-[11px] mt-0.5" style="color: var(--accent-strong);">Penilaian sesi kelompok, hafalan &amp; pemahaman.</p>
            </div>
            <i class="fa-solid fa-chevron-right flex-shrink-0" style="color: var(--accent-strong);"></i>
        </a>

        <!-- Tombol 2: Pilih Ujian (buka drawer) -->
        <button onclick="openExamDrawer()" class="card card-interactive card-pad w-full flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="icon-chip" style="background-color: var(--info-soft); color: var(--info);"><i class="fa-solid fa-file-lines text-lg"></i></div>
                <div class="text-left">
                    <h3 class="section-title">Pilih Ujian</h3>
                    <p id="examCountSubtitle" class="caption mt-0.5">Lihat &amp; kelola ujian tulis</p>
                </div>
            </div>
            <i class="fa-solid fa-chevron-right text-tertiary text-xs"></i>
        </button>

    </div>

    <!-- DRAWER PILIH UJIAN (search + filter mapel + list scroll) -->
    <div id="modalPilihUjian" class="modal-overlay hidden" style="z-index: 60;">
        <div class="modal-sheet modal-sheet-flush" style="height: 88dvh;">
            <div class="px-6 pt-4 pb-3 shrink-0 border-b" style="border-color: var(--hairline);">
                <div class="sheet-grabber"></div>
                <div class="flex justify-between items-center mb-3">
                    <h3 class="section-title">Pilih Ujian</h3>
                    <button onclick="closeExamDrawer()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="relative mb-3">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-tertiary text-sm pointer-events-none"></i>
                    <input type="text" id="examSearch" oninput="renderExamDrawer()" class="field field-search" placeholder="Cari judul ujian...">
                </div>
                <div class="flex gap-2 overflow-x-auto no-scrollbar">
                    <button class="exam-filter chip is-active" data-subj="all" onclick="setExamFilter('all', this)">Semua</button>
                    <button class="exam-filter chip" data-subj="tajwid" onclick="setExamFilter('tajwid', this)">Tajwid</button>
                    <button class="exam-filter chip" data-subj="fiqih" onclick="setExamFilter('fiqih', this)">Fiqih</button>
                    <button class="exam-filter chip" data-subj="tauhid" onclick="setExamFilter('tauhid', this)">Tauhid</button>
                </div>
            </div>
            <div id="examDrawerList" class="flex-1 overflow-y-auto no-scrollbar px-6 py-3 space-y-3">
                <div class="text-center py-10"><i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i></div>
            </div>
        </div>
    </div>

    <div id="modalCreateExam" class="modal-overlay hidden" style="z-index: 100;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="section-title">Buat Ujian Baru</h3>
                <button onclick="closeCreateModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="formCreateExam" class="space-y-4">
                <div>
                    <label class="field-label">Mata Pelajaran</label>
                    <select id="examSubject" required class="field field-sunken">
                        <option value="tajwid">Tajwid</option>
                        <option value="fiqih">Fiqih</option>
                        <option value="tauhid">Tauhid</option>
                    </select>
                </div>
                <div>
                    <label class="field-label">Judul Ujian</label>
                    <input type="text" id="examTitle" required placeholder="Contoh: UTS Semester 1" class="field field-sunken">
                </div>
                <div>
                    <label class="field-label">Durasi (Menit)</label>
                    <input type="number" id="examDuration" required min="5" value="60" class="field field-sunken">
                </div>
                <button type="submit" id="btnSubmitCreate" class="btn btn-primary w-full mt-2">
                    Buat &amp; Mulai Ketik Soal
                </button>
            </form>
        </div>
    </div>

    <div id="modalEditExam" class="modal-overlay hidden" style="z-index: 100;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="section-title">Pengaturan Ujian</h3>
                <button onclick="closeEditModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="formEditExam" class="space-y-4">
                <div>
                    <label class="field-label">Judul Ujian</label>
                    <input type="text" id="editTitle" required class="field field-sunken">
                </div>
                <div>
                    <label class="field-label">Durasi (Menit)</label>
                    <input type="number" id="editDuration" required min="5" class="field field-sunken">
                </div>
                <div>
                    <label class="field-label">Status Publikasi</label>
                    <select id="editStatus" required class="field field-sunken">
                        <option value="false">Draft (Tersembunyi)</option>
                        <option value="true">Published (Bisa diakses siswa)</option>
                    </select>
                </div>

                <div class="pt-2 border-t" style="border-color: var(--divider);">
                    <div class="flex items-center justify-between p-3 rounded-[var(--r-lg)]" style="background-color: var(--info-soft);">
                        <div>
                            <p class="eyebrow" style="color: var(--info);">Jadikan Ujian Daring</p>
                            <p class="text-[11px] mt-0.5" style="color: var(--info);">Siswa kerjakan dari rumah pakai link.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" id="editIsDaring" class="sr-only peer" onchange="toggleDaringMode(this.checked)">
                            <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--info)]"></div>
                        </label>
                    </div>
                </div>

                <div id="daringActionPanel" class="hidden w-full space-y-3 animate-slide-up">
                    <button type="button" onclick="copyExamLink()" class="btn !py-3 w-full text-xs" style="background-color: var(--info); color:#fff; border-radius: var(--r-md);">
                        <i class="fa-solid fa-copy"></i> Salin Link Ujian Daring ke WA
                    </button>
                    <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
                        <label class="field-label">Batas Waktu (Deadline)</label>
                        <input type="datetime-local" id="editDeadline" class="field !py-2 text-xs font-semibold">
                    </div>
                </div>

                <button type="submit" id="btnSubmitEdit" class="btn btn-primary w-full mt-2" style="background-color: var(--info);">
                    Simpan Pengaturan
                </button>
            </form>
        </div>
    </div>

    <div id="modalRetakePermission" class="modal-overlay hidden" style="z-index: 120;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-start mb-5">
                <div>
                    <h3 class="section-title">Perpanjang Waktu Ujian</h3>
                    <p id="retakeExamTitle" class="caption mt-0.5">Murid telat & belum mengerjakan</p>
                </div>
                <button onclick="closeRetakeModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- LANGKAH 1: daftar murid yang telat & belum ngerjain -->
            <div id="extListView">
                <p class="field-label mb-2">Pilih murid untuk diberi perpanjangan</p>
                <div id="extStudentList" class="space-y-2 max-h-[22rem] overflow-y-auto no-scrollbar">
                    <p class="caption text-center py-6 animate-pulse">Memuat...</p>
                </div>
            </div>

            <!-- LANGKAH 2: pilih deadline baru + opsi potong nilai -->
            <div id="extGrantView" class="hidden">
                <button onclick="backToExtList()" class="caption text-secondary mb-3 inline-flex items-center gap-1.5"><i class="fa-solid fa-arrow-left"></i> Kembali ke daftar</button>
                <div class="card card-pad mb-4 flex items-center gap-3">
                    <div class="avatar w-10 h-10 text-xs" id="extGrantInitials">??</div>
                    <div class="min-w-0">
                        <p class="eyebrow">Beri perpanjangan untuk</p>
                        <p id="extGrantName" class="section-title capitalize truncate">Nama</p>
                    </div>
                </div>

                <label class="field-label mb-2">Deadline baru</label>
                <div class="space-y-2 mb-4">
                    <button type="button" data-dur="tonight" class="ext-dur-btn btn btn-soft w-full justify-start is-active"><i class="fa-solid fa-moon"></i> Malam ini (23:59)</button>
                    <button type="button" data-dur="1d" class="ext-dur-btn btn btn-soft w-full justify-start"><i class="fa-solid fa-calendar-day"></i> Besok (+1 hari, 23:59)</button>
                    <button type="button" data-dur="2d" class="ext-dur-btn btn btn-soft w-full justify-start"><i class="fa-solid fa-calendar-week"></i> Lusa (+2 hari, 23:59)</button>
                </div>

                <label class="flex items-center justify-between p-3 rounded-[var(--r-lg)] mb-4" style="background-color: var(--warning-soft);">
                    <span class="text-xs font-semibold" style="color: var(--warning);">Potong nilai 10% (denda telat)</span>
                    <span class="relative inline-flex items-center cursor-pointer shrink-0">
                        <input type="checkbox" id="extPenalty" class="sr-only peer">
                        <span class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--warning)]"></span>
                    </span>
                </label>

                <button id="btnGrantExt" onclick="confirmGrantExt()" class="btn btn-primary w-full">
                    <i class="fa-solid fa-paper-plane"></i> Beri Perpanjangan & Salin Link
                </button>
            </div>
        </div>
    </div>

    <NavbarGuru activeMenu="exams" />
    <Toast />
    <ModalAlert />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    if (!token) window.location.replace('/');

    let currentEditExamId = null;
    let currentEditQuestions = [];

    let currentRetakeExamId = null;
    let currentRetakeExamTitle = '';
    let cachedStudents = [];

    const fetchStudentsForRetake = async () => {
        if (cachedStudents.length > 0) return cachedStudents;

        const res = await fetch(`${API_URL}/api/students`, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        const result = await res.json();

        if (!res.ok || result.status === 'error') {
            throw new Error(result.message || 'Gagal memuat data murid.');
        }

        cachedStudents = result.data || [];
        return cachedStudents;
    };

    // [OPTIMASI CACHE] Tempat menyimpan detail ujian yang sudah pernah di-klik
    let cachedExamDetails = {};

    let allExams = [];
    let examFilter = 'all';

    const fetchExams = async () => {
        try {
            const res = await fetch(`${API_URL}/api/exams`, { headers: { 'Authorization': `Bearer ${token}` }});
            const result = await res.json();
            allExams = result.data || [];
            const sub = document.getElementById('examCountSubtitle');
            if (sub) sub.textContent = allExams.length ? `${allExams.length} ujian tersedia · lihat & kelola` : 'Belum ada ujian — buat dulu';
            renderExamDrawer();
        } catch (error) { console.error(error); }
    };

    window.openExamDrawer = () => { document.getElementById('modalPilihUjian').classList.remove('hidden'); renderExamDrawer(); };
    window.closeExamDrawer = () => document.getElementById('modalPilihUjian').classList.add('hidden');
    window.setExamFilter = (subj, btn) => {
        examFilter = subj;
        document.querySelectorAll('.exam-filter').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        renderExamDrawer();
    };

    window.renderExamDrawer = () => {
        const list = document.getElementById('examDrawerList');
        if (!list) return;
        const q = (document.getElementById('examSearch')?.value || '').toLowerCase();
        const data = allExams.filter(e =>
            (examFilter === 'all' || e.subject === examFilter) &&
            (e.title || '').toLowerCase().includes(q)
        );
        if (data.length === 0) {
            list.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-folder-open text-2xl"></i></div><p class="caption font-semibold">Tidak ada ujian.</p><p class="text-[11px] text-tertiary mt-1">Buat ujian baru lewat tombol +.</p></div>`;
            return;
        }
        list.innerHTML = data.map(exam => {
            const safeTitle = (exam.title || '').replace(/'/g, "\\'");
            const status = exam.is_active
                ? `<span class="badge badge-accent"><i class="fa-solid fa-check"></i> Published</span>`
                : `<span class="badge badge-warning">Draft</span>`;
            return `
            <div class="card overflow-hidden">
                <a href="/exams/${exam.id}" class="block card-interactive card-pad !pb-3">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="badge badge-info uppercase">${exam.subject}</span>
                        ${status}
                    </div>
                    <h3 class="section-title">${exam.title}</h3>
                    <div class="flex items-center gap-4 caption mt-2">
                        <span><i class="fa-regular fa-clock mr-1"></i> ${exam.duration_minutes} Menit</span>
                        <span><i class="fa-regular fa-calendar mr-1"></i> ${new Date(exam.created_at).toLocaleDateString('id-ID')}</span>
                    </div>
                </a>
                <div class="flex items-center gap-1.5 px-4 py-2.5 border-t" style="border-color: var(--divider); background-color: var(--pearl);">
                    <button onclick="openExtModal('${exam.id}', '${safeTitle}')" class="btn-icon !w-8 !h-8" style="color: var(--warning);" title="Perpanjang waktu (dispensasi)"><i class="fa-solid fa-stopwatch text-xs"></i></button>
                    <button onclick="openEditModal('${exam.id}')" class="btn-icon !w-8 !h-8" style="color: var(--info);" title="Pengaturan"><i class="fa-solid fa-gear text-xs"></i></button>
                    <button onclick="confirmDelete('${exam.id}', '${safeTitle}')" class="btn-icon !w-8 !h-8" style="color: var(--danger);" title="Hapus"><i class="fa-solid fa-trash text-xs"></i></button>
                    <a href="/exams/${exam.id}" class="btn-soft !py-1.5 !px-3 text-xs ml-auto">Buka <i class="fa-solid fa-arrow-right ml-1"></i></a>
                </div>
            </div>`;
        }).join('');
    };

    // --- LOGIKA BUAT UJIAN ---
    window.openCreateModal = () => document.getElementById('modalCreateExam').classList.replace('hidden', 'flex');
    window.closeCreateModal = () => document.getElementById('modalCreateExam').classList.replace('flex', 'hidden');

    document.getElementById('formCreateExam').onsubmit = async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitCreate');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...'; btn.disabled = true;

        const payload = {
            subject: document.getElementById('examSubject').value,
            title: document.getElementById('examTitle').value,
            duration_minutes: parseInt(document.getElementById('examDuration').value)
        };

        try {
            const res = await fetch(`${API_URL}/api/exams`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const result = await res.json();
            if (res.ok) window.location.href = `/exams/${result.data.id}`;
            else throw new Error(result.message);
        } catch (error) {
            window.showToast?.('danger', 'Gagal', error.message);
            btn.innerHTML = 'Buat & Mulai Ketik Soal'; btn.disabled = false;
        }
    };

// [BARU] Logika UI Daring
window.toggleDaringMode = (isChecked) => {
        const panel = document.getElementById('daringActionPanel');
        if (isChecked) panel.classList.replace('hidden', 'block');
        else panel.classList.replace('block', 'hidden');
    };

// [BARU] Fungsi Salin Link dengan 'Pinjaman' Token Guru
window.copyExamLink = () => {
        const frontendUrl = window.location.origin; // Otomatis baca localhost atau domain lu

        // Bikin rute dinamis /play/[id] dan titipkan token guru di parameternya
        const link = `${frontendUrl}/play/${currentEditExamId}?token=${token}`;

        // Eksekusi copy ke clipboard
        navigator.clipboard.writeText(link).then(() => {
            window.showToast?.('success', 'Link Disalin!', `Link Ujian berhasil disalin. Silakan paste di Grup WA.`);
        }).catch(err => {
            // Fallback kalau browser ngeblokir auto-copy
            prompt('Copy link ini manual:', link);
        });
    };

    // UPDATE openEditModal biar nampilin data daring yang bener
    window.openEditModal = async (id) => {
        document.getElementById('modalEditExam').classList.replace('hidden', 'flex');
        const btn = document.getElementById('btnSubmitEdit');

        if (cachedExamDetails[id]) {
            const data = cachedExamDetails[id];
            currentEditExamId = data.id; currentEditQuestions = data.questions || [];
            document.getElementById('editTitle').value = data.title;
            document.getElementById('editDuration').value = data.duration_minutes;
            document.getElementById('editStatus').value = data.is_active ? 'true' : 'false';

            // [BARU] Setup Mode Daring
            document.getElementById('editIsDaring').checked = data.is_daring;
            if (data.deadline_at) {
                const tzoffset = (new Date()).getTimezoneOffset() * 60000;
                document.getElementById('editDeadline').value = new Date(new Date(data.deadline_at) - tzoffset).toISOString().slice(0, 16);
            } else {
                document.getElementById('editDeadline').value = '';
            }
            toggleDaringMode(data.is_daring);

            btn.innerHTML = 'Simpan Pengaturan'; btn.disabled = false;
            return;
        }

        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memuat...'; btn.disabled = true;
        try {
            const res = await fetch(`${API_URL}/api/exams/${id}`, { headers: { 'Authorization': `Bearer ${token}` }});
            const result = await res.json();
            if (res.ok) {
                cachedExamDetails[id] = result.data;
                currentEditExamId = result.data.id; currentEditQuestions = result.data.questions || [];
                document.getElementById('editTitle').value = result.data.title;
                document.getElementById('editDuration').value = result.data.duration_minutes;
                document.getElementById('editStatus').value = result.data.is_active ? 'true' : 'false';

                // [BARU] Setup Mode Daring
                document.getElementById('editIsDaring').checked = result.data.is_daring;
                if (result.data.deadline_at) {
                    const tzoffset = (new Date()).getTimezoneOffset() * 60000;
                    document.getElementById('editDeadline').value = new Date(new Date(result.data.deadline_at) - tzoffset).toISOString().slice(0, 16);
                }
                toggleDaringMode(result.data.is_daring);

                btn.innerHTML = 'Simpan Pengaturan'; btn.disabled = false;
            }
        } catch (e) { window.showToast?.('danger', 'Error', 'Gagal memuat.'); closeEditModal(); }
    };

    // UPDATE formEditExam.onsubmit biar nge-submit payload yang baru
    document.getElementById('formEditExam').onsubmit = async (e) => {
        e.preventDefault();
        const isPublishing = document.getElementById('editStatus').value === 'true';
        const isDaring = document.getElementById('editIsDaring').checked;
        const deadlineVal = document.getElementById('editDeadline').value;

        if (isPublishing && currentEditQuestions.length < 10) return window.showToast?.('warning', 'Gagal', 'Minimal 10 soal untuk publish!');
        if (isDaring && !deadlineVal) return window.showToast?.('warning', 'Peringatan', 'Silakan tentukan batas waktu deadline!');

        const btn = document.getElementById('btnSubmitEdit');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...'; btn.disabled = true;

        const payload = {
            title: document.getElementById('editTitle').value,
            duration_minutes: parseInt(document.getElementById('editDuration').value),
            is_active: isPublishing,
            is_daring: isDaring,
            deadline_at: isDaring ? deadlineVal : null,
            questions: currentEditQuestions
        };

        try {
            const res = await fetch(`${API_URL}/api/exams/${currentEditExamId}`, { method: 'PUT', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) {
                window.showToast?.('success', 'Berhasil', 'Pengaturan ujian diperbarui.');
                if (cachedExamDetails[currentEditExamId]) {
                    cachedExamDetails[currentEditExamId] = { ...cachedExamDetails[currentEditExamId], ...payload };
                }
                closeEditModal(); fetchExams();
            } else throw new Error((await res.json()).message);
        } catch (error) { window.showToast?.('danger', 'Gagal', error.message); btn.innerHTML = 'Simpan Pengaturan'; btn.disabled = false; }
    };

    window.closeEditModal = () => document.getElementById('modalEditExam').classList.replace('flex', 'hidden');

    // ===========================================================
    // PERPANJANGAN WAKTU UJIAN (mirror konsep PR)
    // ===========================================================
    let currentExtExamId = null;
    let currentExtExamTitle = '';
    let extEligible = [];        // murid telat + belum ngerjain
    let extGrantTarget = null;   // {id, name}
    let extDur = 'tonight';

    window.openExtModal = async (examId, examTitle) => {
        currentExtExamId = examId;
        currentExtExamTitle = examTitle;
        document.getElementById('retakeExamTitle').innerText = examTitle;
        document.getElementById('modalRetakePermission').classList.replace('hidden', 'flex');
        backToExtList();

        const listEl = document.getElementById('extStudentList');
        listEl.innerHTML = '<p class="caption text-center py-6 animate-pulse">Memuat...</p>';

        try {
            const [students, exRes, resultsRes] = await Promise.all([
                fetchStudentsForRetake(),
                fetch(`${API_URL}/api/exams/${examId}`, { headers: { Authorization: `Bearer ${token}` } }).then(r => r.json()),
                fetch(`${API_URL}/api/exams/${examId}/results`, { headers: { Authorization: `Bearer ${token}` } }).then(r => r.json())
            ]);

            const exam = exRes.data || {};
            if (!exam.is_daring || !exam.deadline_at) {
                listEl.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-circle-info"></i></div><p class="caption">Ujian ini bukan ujian daring / belum punya deadline. Perpanjangan hanya untuk ujian daring berdeadline.</p></div>`;
                return;
            }

            const isLate = new Date() > new Date(exam.deadline_at);

            let extList = exam.extended_students;
            try { while (typeof extList === 'string') extList = JSON.parse(extList); } catch (e) {}
            if (!Array.isArray(extList)) extList = [];

            const doneIds = new Set((resultsRes.data || []).map(r => String(r.student_id)));

            extEligible = (students || []).filter(s => {
                if (doneIds.has(String(s.id))) return false;
                const n = (s.name || '').toLowerCase();
                if (n.includes('john doe') || n.includes('xaveria') || n.includes('xaviera')) return false;
                return isLate; // deadline global lewat → semua yg belum ngerjain dianggap telat
            }).map(s => ({ ...s, _ext: extList.find(e => (typeof e === 'object' ? e.student_id : e) === s.id) || null }));

            if (!isLate) {
                listEl.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-hourglass-half"></i></div><p class="caption">Deadline ujian belum lewat. Belum ada murid yang perlu perpanjangan.</p></div>`;
                return;
            }
            renderExtList();
        } catch (e) {
            console.error(e);
            listEl.innerHTML = '<p class="caption text-center py-6" style="color:var(--danger)">Gagal memuat data.</p>';
        }
    };

    const renderExtList = () => {
        const listEl = document.getElementById('extStudentList');
        if (!extEligible.length) {
            listEl.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-circle-check"></i></div><p class="caption">Semua murid sudah mengerjakan. 🎉</p></div>`;
            return;
        }
        listEl.innerHTML = extEligible.map(s => {
            const initials = (s.name || '?').substring(0, 2).toUpperCase();
            const safeName = (s.name || '').replace(/'/g, "\\'");
            let badge = '';
            if (s._ext && s._ext.until) {
                const valid = new Date(s._ext.until) > new Date();
                badge = valid
                    ? `<span class="badge badge-accent flex-shrink-0">Diperpanjang</span>`
                    : `<span class="badge badge-warning flex-shrink-0">Expired</span>`;
            }
            return `
            <button onclick="openGrantView('${s.id}','${safeName}')" class="card card-interactive card-pad !py-3 w-full flex items-center gap-3 text-left">
                <div class="avatar w-9 h-9 text-xs flex-shrink-0">${initials}</div>
                <div class="min-w-0 flex-1">
                    <p class="caption font-semibold text-ink truncate capitalize">${s.name}</p>
                    <p class="text-[10px] text-tertiary font-medium">${s.grade || '-'}</p>
                </div>
                ${badge}
                <i class="fa-solid fa-chevron-right text-tertiary text-xs"></i>
            </button>`;
        }).join('');
    };

    window.openGrantView = (id, name) => {
        extGrantTarget = { id, name };
        extDur = 'tonight';
        document.getElementById('extGrantName').innerText = name;
        document.getElementById('extGrantInitials').innerText = (name || '?').substring(0, 2).toUpperCase();
        document.getElementById('extPenalty').checked = false;
        document.querySelectorAll('.ext-dur-btn').forEach(b => b.classList.toggle('is-active', b.dataset.dur === 'tonight'));
        document.getElementById('extListView').classList.add('hidden');
        document.getElementById('extGrantView').classList.remove('hidden');
    };

    window.backToExtList = () => {
        extGrantTarget = null;
        document.getElementById('extGrantView').classList.add('hidden');
        document.getElementById('extListView').classList.remove('hidden');
    };

    document.querySelectorAll('.ext-dur-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            extDur = btn.dataset.dur;
            document.querySelectorAll('.ext-dur-btn').forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
        });
    });

    const buildExtUntil = (dur) => {
        const d = new Date();
        if (dur === '1d') d.setDate(d.getDate() + 1);
        else if (dur === '2d') d.setDate(d.getDate() + 2);
        d.setHours(23, 59, 0, 0);
        const pad = n => n.toString().padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:00+07`;
    };

    window.confirmGrantExt = async () => {
        if (!extGrantTarget || !currentExtExamId) return;
        const withPenalty = document.getElementById('extPenalty').checked;
        const until = buildExtUntil(extDur);

        const btn = document.getElementById('btnGrantExt');
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';

        try {
            const res = await fetch(`${API_URL}/api/exams/${currentExtExamId}/grant-extension`, {
                method: 'POST',
                headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: extGrantTarget.id, extension_until: until, with_penalty: withPenalty })
            });
            if (!res.ok) throw new Error((await res.json()).message || 'Gagal');

            const link = `${window.location.origin}/play/${currentExtExamId}?token=${token}&retake_student_id=${extGrantTarget.id}`;
            const waText = `Assalamualaikum ${extGrantTarget.name},\n\nUstadz sudah memberi perpanjangan waktu untuk ujian *${currentExtExamTitle}*${withPenalty ? ' (catatan: nilai dipotong 10% karena telat)' : ''}.\n\nSilakan kerjakan lewat link ini ya:\n${link}`;
            try { await navigator.clipboard.writeText(waText); } catch (e) {}

            window.showToast?.('success', 'Perpanjangan Diberikan', 'Pesan & link sudah disalin. Paste ke WhatsApp murid.');
            extEligible = extEligible.map(s => s.id === extGrantTarget.id ? { ...s, _ext: { until, penalty: withPenalty } } : s);
            backToExtList();
            renderExtList();
        } catch (e) {
            window.showToast?.('danger', 'Gagal', e.message || 'Gagal memberi perpanjangan.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = original;
        }
    };

    window.closeRetakeModal = () => {
        currentExtExamId = null;
        currentExtExamTitle = '';
        extGrantTarget = null;
        document.getElementById('modalRetakePermission').classList.replace('flex', 'hidden');
    };

    // --- LOGIKA HAPUS UJIAN ---
    window.confirmDelete = (id, title) => {
        window.showConfirm('Hapus Ujian?', `Ujian "${title}" beserta semua soalnya akan dihapus permanen.`, async () => {
            try {
                const res = await fetch(`${API_URL}/api/exams/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }});
                if(res.ok) {
                    window.showToast?.('success', 'Terhapus', 'Ujian berhasil dihapus.');

                    // Bersihkan ujian yang dihapus dari Cache
                    delete cachedExamDetails[id];

                    fetchExams();
                }
            } catch(e) { window.showToast?.('danger', 'Error', 'Gagal menghapus ujian.'); }
        });
    };

    fetchExams();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { 0% { transform: translateY(30px) scale(0.95); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
    .ext-dur-btn.is-active { background-color: var(--accent) !important; color: #fff !important; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
