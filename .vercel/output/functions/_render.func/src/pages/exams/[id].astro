---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Exam Builder - yukNgaji">
    <div class="min-h-screen flex flex-col pb-32">

        <header class="sticky top-0 z-50 border-b px-4 py-3 flex items-center justify-between" style="background-color: var(--canvas); border-color: var(--hairline);">
            <div class="flex items-center gap-3 min-w-0">
              <button onclick="handleBack()" class="btn-icon" title="Kembali">
                <i class="fa-solid fa-chevron-left text-sm"></i>
              </button>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h1 id="uiTitle" class="section-title truncate">Memuat...</h1>
                    <span id="examStatusBadge" class="badge badge-warning flex-shrink-0">Draft</span>
                </div>
                <p id="uiMeta" class="eyebrow truncate">-</p>
              </div>
            </div>

            <div class="flex items-center gap-2 flex-shrink-0">
              <button id="btnSaveExam" onclick="saveExamAction()" class="btn-icon disabled:opacity-80" title="Simpan">
                <i class="fa-solid fa-save text-sm"></i>
              </button>
              <div class="relative">
                <button onclick="toggleExamMenu(event)" class="btn-icon" aria-label="Menu"><i class="fa-solid fa-ellipsis-vertical text-sm"></i></button>
                <div id="examMenu" class="hidden absolute right-0 top-full mt-2 card w-56 z-[60] overflow-hidden" style="box-shadow: var(--shadow-pop);">
                  <div class="p-2 space-y-0.5">
                    <button onclick="closeExamMenu(); previewExam();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                      <div class="icon-chip-sm" style="background-color: var(--info-soft); color: var(--info);"><i class="fa-solid fa-eye"></i></div>
                      <span class="caption font-semibold text-ink flex-1">Preview (POV Siswa)</span>
                    </button>
                    <button onclick="closeExamMenu(); openUploadTemplate();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                      <div class="icon-chip-sm" style="background-color: var(--warning-soft); color: var(--warning);"><i class="fa-solid fa-file-arrow-up"></i></div>
                      <span class="caption font-semibold text-ink flex-1">Upload via Template</span>
                    </button>
                    <button id="menuPublishBtn" onclick="closeExamMenu(); publishExamToggle();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                      <div id="menuPublishIconWrap" class="icon-chip-sm" style="background-color: var(--accent-soft); color: var(--accent-strong);"><i id="menuPublishIcon" class="fa-solid fa-paper-plane"></i></div>
                      <span id="menuPublishLabel" class="caption font-semibold text-ink flex-1">Terbitkan Ujian</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
        </header>

        <main class="flex-1 px-6 py-6 max-w-2xl mx-auto w-full">
            <div id="questionsContainer"></div>
        </main>
    </div>

    <!-- FAB Tambah Soal (fixed, pojok kanan bawah) -->
    <div class="fixed inset-x-0 bottom-0 z-40 pointer-events-none">
        <div class="max-w-md mx-auto relative">
            <button onclick="openAddQuestionModal()" class="btn btn-primary pointer-events-auto absolute right-6 bottom-6 !py-3.5 !px-5 gap-2" style="box-shadow: var(--shadow-accent);">
                <i class="fa-solid fa-plus"></i> Tambah Soal
            </button>
        </div>
    </div>

    <!-- MODAL TAMBAH SOAL -->
    <div id="modalAddQuestion" class="modal-overlay hidden" style="z-index: 110;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="section-title">Tambah Soal</h3>
                <button onclick="closeAddQuestionModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="formAddQuestion" class="space-y-4">
                <div>
                    <label class="field-label">Tipe Soal</label>
                    <select id="addType" class="field field-sunken" onchange="toggleAddType()">
                        <option value="multiple_choice">Pilihan Ganda</option>
                        <option value="fill_in_blanks">Isian Berurut (Kolom)</option>
                    </select>
                </div>
                <div>
                    <label class="field-label">Teks Soal</label>
                    <textarea id="addQuestion" rows="2" class="field field-sunken text-sm" placeholder="Tulis pertanyaan..."></textarea>
                </div>
                <div id="addPGSection" class="space-y-3">
                    <div class="grid grid-cols-2 gap-2">
                        <input id="addOptA" class="field field-sunken text-sm" placeholder="Pilihan A">
                        <input id="addOptB" class="field field-sunken text-sm" placeholder="Pilihan B">
                        <input id="addOptC" class="field field-sunken text-sm" placeholder="Pilihan C">
                        <input id="addOptD" class="field field-sunken text-sm" placeholder="Pilihan D">
                    </div>
                    <div>
                        <label class="field-label">Kunci Jawaban</label>
                        <select id="addKey" class="field text-accent font-semibold">
                            <option value="A">Kunci: A</option>
                            <option value="B">Kunci: B</option>
                            <option value="C">Kunci: C</option>
                            <option value="D">Kunci: D</option>
                        </select>
                    </div>
                </div>
                <div id="addBlankNote" class="hidden rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
                    <p class="caption">Soal isian dibuat dulu, lalu atur kolom jawaban langsung di kartu soal.</p>
                </div>
                <div>
                    <label class="field-label"><i class="fa-solid fa-lightbulb" style="color: var(--warning);"></i> Clue / Hint (opsional)</label>
                    <input id="addHint" class="field field-sunken text-sm" placeholder="Bantuan jika siswa kesusahan...">
                </div>
                <button type="submit" class="btn btn-primary w-full mt-1"><i class="fa-solid fa-plus"></i> Tambah Soal</button>
            </form>
        </div>
    </div>

    <!-- MODAL UPLOAD VIA TEMPLATE -->
    <div id="modalUploadTemplate" class="modal-overlay hidden" style="z-index: 115;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="section-title">Upload Soal via Template</h3>
                    <p class="caption mt-0.5">Tempel banyak soal sekaligus, lalu cek & simpan.</p>
                </div>
                <button onclick="closeUploadTemplate()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="rounded-[var(--r-lg)] p-3 mb-3" style="background-color: var(--surface-sunken);">
                <p class="caption leading-relaxed">
                    Format per soal (dipisah <b>baris kosong</b>):<br>
                    <code class="text-[11px]">TIPE: pilgan | tf | isian</code><br>
                    <code class="text-[11px]">Q: pertanyaan</code> · untuk <b>pilgan</b> isi <code>A:</code>–<code>D:</code> &amp; <code>KUNCI: A</code> · untuk <b>tf</b> cukup <code>KUNCI: A</code> (Benar) / <code>B</code> (Salah) · untuk <b>isian</b> <code>KUNCI: jawaban1, jawaban2</code> (tiap kolom) · <code>CLUE:</code> opsional.
                </p>
            </div>

            <button type="button" onclick="downloadExamTemplate()" class="btn btn-soft w-full mb-3 text-xs"><i class="fa-solid fa-download"></i> Unduh Contoh Template</button>

            <textarea id="templatePasteArea" rows="9" class="field field-sunken text-xs font-mono" placeholder="Tempel isi template di sini..."></textarea>

            <p id="templateParseHint" class="caption mt-2 text-center hidden"></p>

            <button id="btnParseTemplate" onclick="parseAndAddTemplate()" class="btn btn-primary w-full mt-3">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Proses &amp; Tambahkan Soal
            </button>
        </div>
    </div>

    <div id="modalConfirmBack" class="modal-overlay hidden" style="z-index: 100;">
        <div class="modal-sheet text-center" style="max-width: 22rem;">
            <div class="sheet-grabber"></div>
            <div class="icon-chip mx-auto mb-4" style="width:3.5rem;height:3.5rem;font-size:1.5rem;background-color: var(--warning-soft); color: var(--warning);">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="section-title mb-2">Perubahan Belum Disimpan!</h3>
            <p class="body-text mb-6">Anda memiliki soal yang baru diketik dan belum disimpan. Yakin ingin keluar dari editor?</p>
            <div class="flex gap-3">
                <button onclick="closeBackModal()" class="btn btn-soft flex-1" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Batal</button>
                <button onclick="forceBack()" class="btn flex-1" style="background-color: var(--danger); color:#fff; border-radius: var(--r-pill);">Ya, Keluar</button>
            </div>
        </div>
    </div>

    <div id="modalConfirmPublish" class="modal-overlay hidden" style="z-index: 100;">
        <div class="modal-sheet text-center" style="max-width: 22rem;">
            <div class="sheet-grabber"></div>
            <div id="publishModalIconWrap" class="icon-chip mx-auto mb-4" style="width:3.5rem;height:3.5rem;font-size:1.5rem;background-color: var(--accent-soft); color: var(--accent-strong);">
                <i id="publishModalIcon" class="fa-solid fa-paper-plane"></i>
            </div>
            <h3 id="publishModalTitle" class="section-title mb-2">Terbitkan Ujian?</h3>
            <p id="publishModalDesc" class="body-text mb-6">Ujian ini akan segera aktif dan langsung dapat diakses oleh siswa. Pastikan semua soal dan kunci jawaban sudah benar.</p>
            <div class="flex gap-3">
                <button onclick="closePublishModal()" class="btn btn-soft flex-1" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Batal</button>
                <button id="btnConfirmPublish" class="btn flex-1" style="background-color: var(--accent); color:#fff; border-radius: var(--r-pill);">Terbitkan</button>
            </div>
        </div>
    </div>

    <div id="modalPreviewTutorialChoice" class="modal-overlay hidden" style="z-index: 120;">
        <div class="modal-sheet text-center" style="max-width: 22rem;">
            <div class="sheet-grabber"></div>
            <div class="icon-chip mx-auto mb-4" style="width:3.5rem;height:3.5rem;font-size:1.5rem;background-color: var(--info-soft); color: var(--info);">
                <i class="fa-solid fa-eye"></i>
            </div>
            <h3 class="section-title mb-2">Mode Simulasi Ujian</h3>
            <p class="body-text mb-6">Kamu sudah pernah melihat tutorial simulasi untuk ujian ini. Mau menampilkan tutorial lagi sebelum masuk preview?</p>
            <div class="flex gap-3">
                <button onclick="startTeacherPreview(false)" class="btn btn-soft flex-1" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Tidak</button>
                <button onclick="startTeacherPreview(true)" class="btn btn-primary flex-1" style="background-color: var(--info);">Ya, Tutorial</button>
            </div>
        </div>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const examId = window.location.pathname.split('/').pop();

    let examConfig = {};
    let questionsData = [];
    let currentQIndex = 0;

    // Pelacak Perubahan & Proses
    let isDirty = false;
    let isSaving = false;

    // --- UI MANAGER: TOMBOL SIMPAN ---
    const setDirtyState = (state) => {
        isDirty = state;
        const btnSave = document.getElementById('btnSaveExam');
        if (!btnSave) return;

        if (state) {
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="fa-solid fa-save text-sm"></i>';
            btnSave.classList.remove('bg-green-50', 'text-green-600');
            btnSave.classList.add('bg-gray-100', 'text-gray-600', 'hover:bg-gray-200');
            btnSave.title = "Simpan Perubahan";
        } else {
            btnSave.disabled = true;
            btnSave.innerHTML = '<i class="fa-solid fa-check text-sm"></i>';
            btnSave.classList.remove('bg-gray-100', 'text-gray-600', 'hover:bg-gray-200');
            btnSave.classList.add('bg-green-50', 'text-green-600');
            btnSave.title = "Sudah Tersimpan";
        }
    };

    // --- UI MANAGER: STATUS PUBLISHED / DRAFT (indikator badge + item menu) ---
    const updatePublishUI = (isActive) => {
        const badge = document.getElementById('examStatusBadge');
        const label = document.getElementById('menuPublishLabel');
        const iconWrap = document.getElementById('menuPublishIconWrap');
        const icon = document.getElementById('menuPublishIcon');

        if (badge) {
            badge.textContent = isActive ? 'Published' : 'Draft';
            badge.className = 'badge flex-shrink-0 ' + (isActive ? 'badge-accent' : 'badge-warning');
        }
        if (label) label.textContent = isActive ? 'Tarik ke Draft' : 'Terbitkan Ujian';
        if (icon) icon.className = 'fa-solid ' + (isActive ? 'fa-folder-open' : 'fa-paper-plane');
        if (iconWrap) {
            iconWrap.style.backgroundColor = isActive ? 'var(--warning-soft)' : 'var(--accent-soft)';
            iconWrap.style.color = isActive ? 'var(--warning)' : 'var(--accent-strong)';
        }
    };

    // --- MENU TITIK TIGA (header) ---
    window.toggleExamMenu = (e) => {
        if (e) e.stopPropagation();
        const menu = document.getElementById('examMenu');
        const willOpen = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        if (willOpen) {
            const close = (ev) => {
                if (!menu.contains(ev.target) && !ev.target.closest('[onclick^="toggleExamMenu"]')) {
                    menu.classList.add('hidden');
                    document.removeEventListener('click', close);
                }
            };
            setTimeout(() => document.addEventListener('click', close), 10);
        }
    };
    window.closeExamMenu = () => document.getElementById('examMenu')?.classList.add('hidden');

    const init = async () => {
        try {
            const res = await fetch(`${API_URL}/api/exams/${examId}`, { headers: { 'Authorization': `Bearer ${token}` }});
            const result = await res.json();

            if (res.ok) {
                examConfig = result.data;
                questionsData = result.data.questions.map(q => {
                    // Pastikan correct_answer jadi Array di frontend jika dia fill_in_blanks
                    if (q.question_type === 'fill_in_blanks' && typeof q.correct_answer === 'string') {
                        try { q.correct_answer = JSON.parse(q.correct_answer); } catch(e) { q.correct_answer = ['']; }
                    }
                    return q;
                }) || [];

                document.getElementById('uiTitle').innerText = examConfig.title;
                document.getElementById('uiMeta').innerText = `${examConfig.subject} • ${examConfig.duration_minutes} Menit`;

                // Set UI sesuai status DB
                updatePublishUI(examConfig.is_active);

                if(questionsData.length === 0) addEmptyQuestion();
                else renderAllQuestions();

                setDirtyState(false);
            }
        } catch (e) {
            console.error(e);
            window.showToast?.('danger', 'Error', 'Gagal memuat ujian.');
        }
    };

    // --- LOGIKA KEMBALI ---
    window.handleBack = () => {
        if (isDirty) document.getElementById('modalConfirmBack').classList.replace('hidden', 'flex');
        else window.location.href = '/exams';
    };
    window.closeBackModal = () => document.getElementById('modalConfirmBack').classList.replace('flex', 'hidden');
    window.forceBack = () => window.location.href = '/exams';

    // --- TAMBAH / HAPUS SOAL (Ubah jadi Dirty) ---
    window.addEmptyQuestion = () => {
        questionsData.push({
            question_type: 'multiple_choice', // Tipe default
            question: '',
            options: { A: '', B: '', C: '', D: '' },
            correct_answer: 'A',
            hint: '',
            image_url: null
        });
        currentQIndex = questionsData.length - 1;
        renderAllQuestions();
        setDirtyState(true);
    };

    // --- MODAL TAMBAH SOAL ---
    window.openAddQuestionModal = () => {
        document.getElementById('formAddQuestion').reset();
        document.getElementById('addType').value = 'multiple_choice';
        toggleAddType();
        document.getElementById('modalAddQuestion').classList.remove('hidden');
    };
    window.closeAddQuestionModal = () => document.getElementById('modalAddQuestion').classList.add('hidden');
    window.toggleAddType = () => {
        const isBlank = document.getElementById('addType').value === 'fill_in_blanks';
        document.getElementById('addPGSection').classList.toggle('hidden', isBlank);
        document.getElementById('addBlankNote').classList.toggle('hidden', !isBlank);
    };
    document.getElementById('formAddQuestion').onsubmit = (e) => {
        e.preventDefault();
        const type = document.getElementById('addType').value;
        const q = {
            question_type: type,
            question: document.getElementById('addQuestion').value,
            hint: document.getElementById('addHint').value,
            image_url: null
        };
        if (type === 'fill_in_blanks') {
            q.options = {};
            q.correct_answer = [''];
        } else {
            q.options = {
                A: document.getElementById('addOptA').value,
                B: document.getElementById('addOptB').value,
                C: document.getElementById('addOptC').value,
                D: document.getElementById('addOptD').value
            };
            q.correct_answer = document.getElementById('addKey').value;
        }
        questionsData.push(q);
        currentQIndex = questionsData.length - 1;
        renderAllQuestions();
        setDirtyState(true);
        closeAddQuestionModal();
        window.showToast?.('success', 'Ditambah', 'Soal baru ditambahkan. Lengkapi & simpan.');
    };

    // --- UPLOAD VIA TEMPLATE ---
    window.openUploadTemplate = () => {
        document.getElementById('templatePasteArea').value = '';
        document.getElementById('templateParseHint').classList.add('hidden');
        document.getElementById('modalUploadTemplate').classList.remove('hidden');
    };
    window.closeUploadTemplate = () => document.getElementById('modalUploadTemplate').classList.add('hidden');

    window.downloadExamTemplate = () => {
        const sample = `TIPE: pilgan
Q: Hukum mempelajari ilmu fiqih adalah?
A: Mubah
B: Fardhu kifayah
C: Haram
D: Makruh
KUNCI: B
CLUE: Cukup sebagian umat yang mempelajarinya.

TIPE: tf
Q: Niat termasuk salah satu rukun wudhu.
A: Benar
B: Salah
KUNCI: A

TIPE: isian
Q: Sebutkan dua rukun shalat secara berurutan (takbir lalu ...).
KUNCI: Takbiratul ihram, Membaca Al-Fatihah
CLUE: Diawali takbir.`;
        const blob = new Blob([sample], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'template_ujian_yukNgaji.txt'; a.click();
        URL.revokeObjectURL(url);
    };

    // Parser format bank-soal → disesuaikan untuk exam_questions
    const parseExamTemplate = (raw) => {
        const blocks = raw.replace(/\r/g, '').split(/\n\s*\n/).map(b => b.trim()).filter(Boolean);
        const result = [];
        blocks.forEach(block => {
            const lines = block.split('\n').map(l => l.trim()).filter(Boolean);
            const get = (key) => {
                const line = lines.find(l => l.toUpperCase().startsWith(key + ':'));
                return line ? line.slice(line.indexOf(':') + 1).trim() : '';
            };
            const tipe = (get('TIPE') || 'pilgan').toLowerCase();
            const question = get('Q') || get('SOAL');
            if (!question) return;
            const hint = get('CLUE') || get('HINT') || '';
            const kunci = get('KUNCI');

            if (tipe === 'isian' || tipe === 'fill_in_blanks') {
                const answers = (kunci || '').split(',').map(s => s.trim()).filter(Boolean);
                if (!answers.length) return;
                result.push({ question_type: 'fill_in_blanks', question, options: {}, correct_answer: answers, hint: hint || null, image_url: null });
                return;
            }

            // pilgan / tf → multiple_choice
            let options;
            if (tipe === 'tf') {
                options = { A: get('A') || 'Benar', B: get('B') || 'Salah', C: '', D: '' };
            } else {
                options = { A: get('A'), B: get('B'), C: get('C'), D: get('D') };
            }
            const key = (kunci || 'A').toUpperCase().charAt(0);
            if (!['A', 'B', 'C', 'D'].includes(key)) return;
            if (!options[key]) return; // kunci menunjuk opsi kosong → lewati
            result.push({ question_type: 'multiple_choice', question, options, correct_answer: key, hint: hint || null, image_url: null });
        });
        return result;
    };

    window.parseAndAddTemplate = () => {
        const raw = document.getElementById('templatePasteArea').value.trim();
        const hintEl = document.getElementById('templateParseHint');
        if (!raw) { window.showToast?.('warning', 'Kosong', 'Tempel dulu isi templatenya.'); return; }

        let parsed = [];
        try { parsed = parseExamTemplate(raw); } catch (e) { parsed = []; }

        if (!parsed.length) {
            hintEl.textContent = 'Tidak ada soal valid terbaca. Cek format (TIPE/Q/KUNCI).';
            hintEl.style.color = 'var(--danger)';
            hintEl.classList.remove('hidden');
            return;
        }

        questionsData.push(...parsed);
        currentQIndex = questionsData.length - 1;
        renderAllQuestions();
        setDirtyState(true);
        closeUploadTemplate();
        window.showToast?.('success', 'Berhasil', `${parsed.length} soal ditambahkan dari template. Cek lalu simpan.`);
    };

    // --- NAVIGASI VIEWER (prev/next/jump) ---
    window.qPrev = () => { if (currentQIndex > 0) { currentQIndex--; renderAllQuestions(); } };
    window.qNext = () => { if (currentQIndex < questionsData.length - 1) { currentQIndex++; renderAllQuestions(); } };
    window.qJump = (v) => { currentQIndex = parseInt(v) || 0; renderAllQuestions(); };

    window.changeQuestionType = (index, type) => {
        questionsData[index].question_type = type;
        if (type === 'fill_in_blanks') {
            questionsData[index].correct_answer = ['']; // Inisiasi 1 kolom awal
        } else {
            questionsData[index].correct_answer = 'A';  // Balik ke PG
        }
        setDirtyState(true);
        renderAllQuestions();
    };

    window.addBlank = (index) => {
        questionsData[index].correct_answer.push('');
        setDirtyState(true);
        renderAllQuestions();
    };

    window.removeBlank = (index, blankIndex) => {
        questionsData[index].correct_answer.splice(blankIndex, 1);
        setDirtyState(true);
        renderAllQuestions();
    };

    window.updateBlank = (index, blankIndex, value) => {
        questionsData[index].correct_answer[blankIndex] = value;
        setDirtyState(true);
    };

    window.removeQuestion = (index) => {
        questionsData.splice(index, 1);
        if (currentQIndex >= questionsData.length) currentQIndex = Math.max(0, questionsData.length - 1);
        renderAllQuestions();
        setDirtyState(true);
        window.showToast?.('warning', 'Dihapus', 'Soal dihapus dari tampilan (Simpan untuk mematenkan).');
    };

    // --- KETIKAN / UPLOAD (Ubah jadi Dirty) ---
    document.getElementById('questionsContainer').addEventListener('input', (e) => {
        const target = e.target;
        const index = parseInt(target.getAttribute('data-index'));
        const field = target.getAttribute('data-field');

        if (isNaN(index)) return;

        setDirtyState(true);

        if (field === 'question') questionsData[index].question = target.value;
        else if (field === 'hint') questionsData[index].hint = target.value;
        else if (field === 'correct') questionsData[index].correct_answer = target.value;
        else if (field.startsWith('opt_')) {
            const optKey = field.split('_')[1];
            questionsData[index].options[optKey] = target.value;
        }
    });

    window.handleImageUpload = (e, index) => {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (event) => {
                questionsData[index].image_url = event.target.result;
                renderAllQuestions();
                setDirtyState(true);
            };
            reader.readAsDataURL(file);
        }
    };

    window.removeImage = (index) => {
        questionsData[index].image_url = null;
        renderAllQuestions();
        setDirtyState(true);
    };

    const renderAllQuestions = () => {
        const container = document.getElementById('questionsContainer');
        const total = questionsData.length;
        if (total === 0) {
            container.innerHTML = `<div class="card card-pad"><div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-inbox text-2xl"></i></div><p class="caption font-semibold">Belum ada soal.</p><p class="text-[11px] text-tertiary mt-1">Tekan tombol "Tambah Soal" di pojok kanan bawah.</p></div></div>`;
            return;
        }
        if (currentQIndex >= total) currentQIndex = total - 1;
        if (currentQIndex < 0) currentQIndex = 0;
        const i = currentQIndex;
        const q = questionsData[i];
        const jump = Array.from({ length: total }, (_, idx) => `<option value="${idx}" ${idx === i ? 'selected' : ''}>Soal ${idx + 1}</option>`).join('');

        const answerSection = q.question_type === 'fill_in_blanks' ? `
            <div>
                <div class="flex justify-between items-center mb-2">
                    <label class="field-label !mb-0">Kunci Isian (Urut)</label>
                    <button type="button" onclick="addBlank(${i})" class="badge badge-info active:scale-95"><i class="fa-solid fa-plus"></i> Kolom</button>
                </div>
                <div class="space-y-2">
                    ${(Array.isArray(q.correct_answer) ? q.correct_answer : ['']).map((ans, bIdx) => `
                        <div class="flex items-center gap-2">
                            <div class="w-9 h-9 rounded-[var(--r-md)] flex items-center justify-center text-xs font-bold flex-shrink-0" style="background-color: var(--accent-soft); color: var(--accent-strong);">${bIdx + 1}</div>
                            <input type="text" value="${ans}" oninput="updateBlank(${i}, ${bIdx}, this.value)" placeholder="Ketik kata yang benar..." class="field field-sunken text-sm flex-1">
                            ${bIdx > 0 ? `<button type="button" onclick="removeBlank(${i}, ${bIdx})" class="btn-icon !w-9 !h-9 flex-shrink-0" style="color: var(--danger);"><i class="fa-solid fa-xmark"></i></button>` : ''}
                        </div>
                    `).join('')}
                </div>
            </div>
        ` : `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                ${['A', 'B', 'C', 'D'].map(opt => `
                    <div class="flex items-center field field-sunken !p-0 overflow-hidden">
                        <div class="w-9 self-stretch flex items-center justify-center font-bold text-secondary" style="background-color: var(--hairline);">${opt}</div>
                        <input type="text" data-index="${i}" data-field="opt_${opt}" value="${q.options[opt] || ''}" placeholder="Pilihan ${opt}" class="flex-1 px-3 py-2.5 bg-transparent text-sm outline-none">
                    </div>
                `).join('')}
            </div>
            <div>
                <label class="field-label">Kunci Jawaban</label>
                <select data-index="${i}" data-field="correct" class="field text-accent font-semibold">
                    ${['A','B','C','D'].map(opt => `<option value="${opt}" ${q.correct_answer === opt ? 'selected' : ''}>Kunci: ${opt}</option>`).join('')}
                </select>
            </div>
        `;

        container.innerHTML = `
            <div class="card card-pad">
                <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b" style="border-color: var(--divider);">
                    <h3 class="section-title">Soal ${i + 1} <span class="text-tertiary font-normal">/ ${total}</span></h3>
                    <button onclick="removeQuestion(${i})" class="badge badge-danger active:scale-95"><i class="fa-solid fa-trash"></i> Hapus</button>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="field-label">Tipe Soal</label>
                        <select onchange="changeQuestionType(${i}, this.value)" class="field field-sunken text-sm font-medium">
                            <option value="multiple_choice" ${q.question_type !== 'fill_in_blanks' ? 'selected' : ''}>Pilihan Ganda</option>
                            <option value="fill_in_blanks" ${q.question_type === 'fill_in_blanks' ? 'selected' : ''}>Isian Berurut (Kolom)</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Teks Soal</label>
                        <textarea data-index="${i}" data-field="question" rows="2" placeholder="Tulis pertanyaan di sini..." class="field field-sunken text-sm">${q.question || ''}</textarea>
                    </div>
                    ${answerSection}
                    <div>
                        <label class="field-label"><i class="fa-solid fa-lightbulb" style="color: var(--warning);"></i> Clue / Hint Siswa</label>
                        <input type="text" data-index="${i}" data-field="hint" value="${q.hint || ''}" placeholder="Bantuan jika siswa kesusahan..." class="field field-sunken text-sm">
                    </div>
                </div>

                <div class="flex items-center justify-between gap-2 mt-5 pt-3 border-t" style="border-color: var(--divider);">
                    <button onclick="qPrev()" class="btn-icon" ${i === 0 ? 'disabled' : ''} aria-label="Sebelumnya"><i class="fa-solid fa-chevron-left"></i></button>
                    <select onchange="qJump(this.value)" class="field !py-2 !px-3 !w-auto text-sm font-medium">${jump}</select>
                    <button onclick="qNext()" class="btn-icon" ${i === total - 1 ? 'disabled' : ''} aria-label="Berikutnya"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>`;
    };
    // --- MODAL PUBLISH / UNPUBLISH (DINAMIS) ---
    window.publishExamToggle = () => {
        // Validasi soal 10 hanya jika mau diterbitkan
        if (!examConfig.is_active && questionsData.length < 10) {
            window.showToast?.('warning', 'Gagal Terbit', 'Minimal harus ada 10 soal untuk bisa menerbitkan ujian.');
            return;
        }

        const modalTitle = document.getElementById('publishModalTitle');
        const modalDesc = document.getElementById('publishModalDesc');
        const btnConfirm = document.getElementById('btnConfirmPublish');
        const iconModal = document.getElementById('publishModalIcon');
        const iconWrap = document.getElementById('publishModalIconWrap');

        if (examConfig.is_active) {
            // Setting Modal untuk "Tarik ke Draft"
            modalTitle.innerText = 'Tarik ke Draft?';
            modalDesc.innerText = 'Ujian akan ditarik dan disembunyikan. Siswa tidak akan bisa mengakses ujian ini lagi dari Portal mereka.';
            btnConfirm.innerText = 'Tarik ke Draft';
            btnConfirm.style.backgroundColor = 'var(--warning)';
            btnConfirm.onclick = () => forcePublish(false);
            iconModal.className = 'fa-solid fa-folder-open';
            iconWrap.style.backgroundColor = 'var(--warning-soft)';
            iconWrap.style.color = 'var(--warning)';
        } else {
            // Setting Modal untuk "Terbitkan"
            modalTitle.innerText = 'Terbitkan Ujian?';
            modalDesc.innerText = 'Ujian ini akan segera aktif dan langsung dapat diakses oleh siswa. Pastikan semua soal sudah benar.';
            btnConfirm.innerText = 'Terbitkan';
            btnConfirm.style.backgroundColor = 'var(--accent)';
            btnConfirm.onclick = () => forcePublish(true);
            iconModal.className = 'fa-solid fa-paper-plane';
            iconWrap.style.backgroundColor = 'var(--accent-soft)';
            iconWrap.style.color = 'var(--accent-strong)';
        }

        document.getElementById('modalConfirmPublish').classList.replace('hidden', 'flex');
    };

    window.closePublishModal = () => document.getElementById('modalConfirmPublish').classList.replace('flex', 'hidden');

    window.forcePublish = (targetStatus) => {
        const btn = document.getElementById('btnConfirmPublish');
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-1"></i> ${targetStatus ? 'Menerbitkan...' : 'Menarik...'}`;
        btn.disabled = true;
        saveExamAction(targetStatus);
    };

    // --- API SIMPAN MASTER (MENG-HANDLE SAVE & PUBLISH BERSAMAAN) ---
    window.saveExamAction = async (targetActiveState = examConfig.is_active) => {
        if (isSaving) return;
        if (targetActiveState === examConfig.is_active && !isDirty) return; // Ignore jika tombol dipaksa klik saat sudah saved

        isSaving = true;
        const btnSave = document.getElementById('btnSaveExam');

        // Tampilkan loading cuma kalau actionnya Save biasa
        if (targetActiveState === examConfig.is_active && btnSave) {
            btnSave.disabled = true;
            btnSave.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-sm"></i>';
        }

        const payload = {
            title: examConfig.title,
            duration_minutes: examConfig.duration_minutes,
            is_active: targetActiveState,
            questions: questionsData
        };

        try {
            const res = await fetch(`${API_URL}/api/exams/${examId}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                setDirtyState(false);

                if (targetActiveState !== examConfig.is_active) {
                    // Update State dan UI SPA Jika status ujian berganti
                    examConfig.is_active = targetActiveState;
                    updatePublishUI(targetActiveState);
                    closePublishModal();
                    window.showToast?.('success', 'Status Berubah', targetActiveState ? 'Ujian telah Terbit!' : 'Ujian ditarik ke Draft.');
                } else {
                    window.showToast?.('success', 'Tersimpan', 'Draft disimpan dengan aman.');
                }
            } else {
                const err = await res.json();
                throw new Error(err.message);
            }
        } catch (e) {
            window.showToast?.('danger', 'Error', e.message || 'Gagal menyimpan.');
            setDirtyState(true);
        } finally {
            isSaving = false;
            const btnPublish = document.getElementById('btnConfirmPublish');
            if (btnPublish) btnPublish.disabled = false;
        }
    };

    // --- Logika Preview POV Murid / Simulasi Guru ---
    window.previewExam = () => {
        if (typeof isDirty !== 'undefined' && isDirty) {
            window.showToast?.('warning', 'Simpan Dulu', 'Ada perubahan yang belum disimpan. Simpan dulu sebelum melihat preview.');
            return;
        }

        if (typeof questionsData !== 'undefined' && questionsData.length === 0) {
            window.showToast?.('warning', 'Kosong', 'Belum ada soal untuk disimulasikan.');
            return;
        }

        const examId = window.location.pathname.split('/').pop();
        const previewTutorialKey = `teacher_preview_tutorial_seen_${examId}`;
        const hasSeenTutorial = localStorage.getItem(previewTutorialKey) === 'true';

        // Pertama kali preview ujian ini: langsung paksa tutorial
        if (!hasSeenTutorial) {
            localStorage.setItem(previewTutorialKey, 'true');
            startTeacherPreview(true);
            return;
        }

        // Kedua kali dan seterusnya: tanya mau tutorial lagi atau langsung preview
        document.getElementById('modalPreviewTutorialChoice')?.classList.replace('hidden', 'flex');
    };

    window.startTeacherPreview = (withTutorial) => {
        const examId = window.location.pathname.split('/').pop();

        document.getElementById('modalPreviewTutorialChoice')?.classList.replace('flex', 'hidden');

        const tutorialMode = withTutorial ? 'force' : 'skip';

        window.location.href =
            `/play/${examId}?preview=true&teacher_preview=true&preview_tutorial=${tutorialMode}&preview_final_flow=true`;
    };

    init();
</script>

<style>
    .animate-slide-up {
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes slideUp {
        0% { transform: translateY(20px) scale(0.95); opacity: 0; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
    }
</style>
