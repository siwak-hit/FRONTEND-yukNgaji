---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Toast from '../../components/Toast.astro';
import ModalAlert from '../../components/ModalAlert.astro'; // Pastikan komponen ini di-import
---

<Layout title="Daftar Anak - yukNgaji">
    <div class="px-6 py-8 pb-32 min-h-screen flex flex-col">

        <PageHeader title="Data Anak" eyebrow="Manajemen Kelas">
            <button slot="action" onclick="openAddModal()" class="fab" aria-label="Tambah anak">
                <i class="fa-solid fa-plus text-lg"></i>
            </button>
        </PageHeader>

        <section class="space-y-4 mb-6">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-tertiary text-sm pointer-events-none"></i>
                <input type="text" id="searchInput"
                    class="field field-search"
                    placeholder="Cari nama Anak...">
            </div>

            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
                <button class="filter-btn chip is-active" data-grade="all">Semua</button>
                <button class="filter-btn chip" data-grade="Iqro 1-3">Iqro 1-3</button>
                <button class="filter-btn chip" data-grade="Iqro 4-6">Iqro 4-6</button>
                <button class="filter-btn chip" data-grade="Al-Quran">Al-Quran</button>
            </div>
        </section>

        <section class="flex-1">
            <div id="studentContainer" class="space-y-3">
                <div class="skeleton card h-[4.5rem]"></div>
                <div class="skeleton card h-[4.5rem]"></div>
                <div class="skeleton card h-[4.5rem]"></div>
            </div>

            <div id="pagination" class="mt-8 flex justify-center items-center gap-4 hidden">
                <button id="prevPage" class="btn-icon disabled:opacity-30" aria-label="Sebelumnya">
                    <i class="fa-solid fa-chevron-left text-sm"></i>
                </button>
                <span id="pageInfo" class="caption font-semibold text-secondary">Hal 1 dari 1</span>
                <button id="nextPage" class="btn-icon disabled:opacity-30" aria-label="Berikutnya">
                    <i class="fa-solid fa-chevron-right text-sm"></i>
                </button>
            </div>
        </section>

    </div>

    <div id="modalStudent" class="modal-overlay hidden">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-6">
                <h3 id="modalTitle" class="section-title">Tambah Anak Baru</h3>
                <button onclick="closeStudentModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <form id="formStudent" class="space-y-4">
                <div>
                    <label class="field-label">Nama Lengkap</label>
                    <input type="text" id="inpName" required class="field field-sunken" placeholder="Misal: Budi Santoso">
                </div>
                <div>
                    <label class="field-label">Tingkat Kelas</label>
                    <select id="inpGrade" class="field field-sunken">
                        <option value="Iqro 1-3">Iqro 1-3</option>
                        <option value="Iqro 4-6">Iqro 4-6</option>
                        <option value="Al-Quran">Al-Quran</option>
                    </select>
                </div>
                <div>
                    <label class="field-label">Umur (Opsional)</label>
                    <input type="number" id="inpAge" min="3" max="99" class="field field-sunken" placeholder="Misal: 8">
                </div>

                <button type="submit" id="btnSaveStudent" class="btn btn-primary w-full mt-2">
                    Simpan Data
                </button>
            </form>
        </div>
    </div>

    <NavbarGuru activeMenu="students" />
    <Toast />
    <ModalAlert />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    let allStudents = [];
    let filteredStudents = [];
    let currentPage = 1;
    const itemsPerPage = 10;
    let currentFilter = 'all';

    // State untuk Form Modal
    let isEditMode = false;
    let currentStudentId = null;

    const token = localStorage.getItem('token');
    const container = document.getElementById('studentContainer');
    const searchInput = document.getElementById('searchInput');

    if (!token) window.location.replace('/');

    const renderData = () => {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const paginatedData = filteredStudents.slice(start, end);

        container.innerHTML = '';

        if (paginatedData.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-user-slash text-2xl"></i></div>
                    <p class="caption font-semibold">Anak tidak ditemukan.</p>
                </div>
            `;
            document.getElementById('pagination').classList.add('hidden');
            return;
        }

        paginatedData.forEach(student => {
            const initials = student.name.substring(0, 2).toUpperCase();
            container.innerHTML += `
                <div class="card card-pad !p-3.5 flex items-center justify-between group">
                    <div class="flex items-center gap-3.5 cursor-pointer flex-1 min-w-0" onclick="window.location.href='/student/${student.id}'">
                        <div class="avatar w-12 h-12 text-base flex-shrink-0">${initials}</div>
                        <div class="min-w-0">
                            <h4 class="section-title capitalize truncate">${student.name}</h4>
                            <p class="eyebrow mt-1">${student.grade} ${student.age ? `· ${student.age} th` : ''}</p>
                        </div>
                    </div>

                    <div class="flex gap-2 flex-shrink-0 pl-2">
                        <button onclick="openEditModal('${student.id}')" class="btn-icon !w-9 !h-9" style="color: var(--info);" aria-label="Edit">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                        <button onclick="confirmDelete('${student.id}')" class="btn-icon !w-9 !h-9" style="color: var(--danger);" aria-label="Hapus">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </div>
                </div>
            `;
        });

        // Update Pagination Info
        const totalPages = Math.ceil(filteredStudents.length / itemsPerPage);
        document.getElementById('pagination').classList.remove('hidden');
        document.getElementById('pageInfo').innerText = `Hal ${currentPage} dari ${totalPages || 1}`;
        document.getElementById('prevPage').disabled = currentPage === 1;
        document.getElementById('nextPage').disabled = currentPage === totalPages || totalPages === 0;
    };

    const applyFilterAndSearch = () => {
        const searchTerm = searchInput.value.toLowerCase();
        filteredStudents = allStudents.filter(student => {
            const matchSearch = student.name.toLowerCase().includes(searchTerm);
            const matchFilter = currentFilter === 'all' || student.grade === currentFilter;
            return matchSearch && matchFilter;
        });
        currentPage = 1; 
        renderData();
    };

    // Filter Logic
    searchInput.addEventListener('input', applyFilterAndSearch);
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            currentFilter = btn.getAttribute('data-grade');
            applyFilterAndSearch();
        });
    });

    // Pagination Logic
    document.getElementById('prevPage').addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderData(); } });
    document.getElementById('nextPage').addEventListener('click', () => {
        const totalPages = Math.ceil(filteredStudents.length / itemsPerPage);
        if (currentPage < totalPages) { currentPage++; renderData(); }
    });

    // --- CRUD LOGIC START ---

    // Fetch Semua Siswa
    const fetchStudents = async () => {
        try {
            const res = await fetch(`${API_URL}/api/students`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await res.json();
            allStudents = result.data;
            filteredStudents = [...allStudents];
            applyFilterAndSearch(); // Supaya urutan & filter aman
        } catch (e) {
            console.error(e);
        }
    };

    // Buka Modal Tambah
    window.openAddModal = () => {
        isEditMode = false;
        currentStudentId = null;
        document.getElementById('modalTitle').innerText = 'Tambah Anak Baru';
        document.getElementById('formStudent').reset();
        document.getElementById('modalStudent').classList.remove('hidden');
    };

    // Buka Modal Edit
    window.openEditModal = (id) => {
        isEditMode = true;
        currentStudentId = id;
        document.getElementById('modalTitle').innerText = 'Edit Data Anak';
        
        // Cari data di state lokal
        const student = allStudents.find(s => s.id === id);
        if(student) {
            document.getElementById('inpName').value = student.name;
            document.getElementById('inpGrade').value = student.grade;
            document.getElementById('inpAge').value = student.age || '';
        }
        document.getElementById('modalStudent').classList.remove('hidden');
    };

    // Tutup Modal
    window.closeStudentModal = () => {
        document.getElementById('modalStudent').classList.add('hidden');
    };

    // Submit Form (POST & PUT)
    document.getElementById('formStudent').onsubmit = async (e) => {
        e.preventDefault();
        
        const payload = {
            name: document.getElementById('inpName').value,
            grade: document.getElementById('inpGrade').value,
            age: document.getElementById('inpAge').value ? parseInt(document.getElementById('inpAge').value) : null
        };

        const url = isEditMode ? `${API_URL}/api/students/${currentStudentId}` : `${API_URL}/api/students`;
        const method = isEditMode ? 'PUT' : 'POST';
        const btn = document.getElementById('btnSaveStudent');

        try {
            btn.innerText = "Menyimpan...";
            btn.disabled = true;

            const res = await fetch(url, {
                method: method,
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json' 
                },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                window.showToast?.('success', 'Berhasil', `Anak berhasil ${isEditMode ? 'diperbarui' : 'ditambahkan'}.`);
                closeStudentModal();
                fetchStudents(); // Refresh data grid
            } else {
                window.showToast?.('danger', 'Gagal', 'Terjadi kesalahan pada server.');
            }
        } catch (err) {
            window.showToast?.('danger', 'Gagal', 'Koneksi terputus.');
        } finally {
            btn.innerText = "Simpan Data";
            btn.disabled = false;
        }
    };

    // Hapus Data (DELETE)
    window.confirmDelete = (id) => {
        currentStudentId = id;
        // Panggil fungsi global ModalAlert
        if(window.showModalAlert) {
            window.showModalAlert(
                'Hapus Data Anak?',
                'Data Anak beserta riwayat konsultasi dan ujian akan dihapus permanen. Lanjutkan?',
                'Hapus Permanen',
                'Batal',
                () => executeDelete()
            );
        }
    };

    const executeDelete = async () => {
        try {
            const res = await fetch(`${API_URL}/api/students/${currentStudentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (res.ok) {
                window.showToast?.('success', 'Dihapus', 'Data Anak berhasil dihapus dari sistem.');
                fetchStudents();
            } else {
                window.showToast?.('danger', 'Gagal', 'Gagal menghapus Anak.');
            }
        } catch (err) {
            console.error(err);
        }
    };

    // --- CRUD LOGIC END ---

    // Initial load
    fetchStudents();
</script>