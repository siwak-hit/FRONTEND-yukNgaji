---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Feedback - yukNgaji">
    <div class="min-h-screen flex flex-col items-center justify-center px-6 py-10" style="background-color: var(--parchment);">

        <!-- PILIH IDENTITAS -->
        <div id="identitySelection" class="hidden card w-full max-w-md p-6 animate-slide-up">
            <div class="text-center mb-6">
                <div class="icon-chip mx-auto mb-4"><i class="fa-solid fa-users"></i></div>
                <h1 class="section-title mb-1">Kamu Siapa?</h1>
                <p class="caption">Pilih namamu dari daftar di bawah untuk mengisi evaluasi akhir.</p>
            </div>

            <div id="studentSelectionList" class="flex flex-col gap-2 max-h-72 overflow-y-auto pr-1">
                <div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-2xl" style="color: var(--accent);"></i></div>
            </div>
        </div>

        <!-- FORM FEEDBACK -->
        <div id="feedbackCard" class="hidden card w-full max-w-md p-6 animate-slide-up">
            <div class="text-center mb-6">
                <div class="icon-chip mx-auto mb-4 text-2xl"><i class="fa-solid fa-heart-circle-check"></i></div>
                <p class="eyebrow mb-1">Misi Terakhir</p>
                <h1 class="page-title mb-2">Bantu Ustadz Sebentar</h1>
                <p class="body-text">
                    Jawab jujur ya <span id="displayStudentName" class="font-bold" style="color: var(--accent-strong);"></span>. Setelah ini evaluasimu lengkap!
                </p>
            </div>

            <form id="feedbackForm" class="space-y-5">
                <div>
                    <label class="field-label">Aplikasinya nyaman dipakai?</label>
                    <div class="grid grid-cols-5 gap-2" data-rating-group="comfort">
                        <button type="button" onclick="selectRating('comfort', 1)" class="rating-btn" data-value="1">😵<span>1</span></button>
                        <button type="button" onclick="selectRating('comfort', 2)" class="rating-btn" data-value="2">😕<span>2</span></button>
                        <button type="button" onclick="selectRating('comfort', 3)" class="rating-btn" data-value="3">🙂<span>3</span></button>
                        <button type="button" onclick="selectRating('comfort', 4)" class="rating-btn" data-value="4">😄<span>4</span></button>
                        <button type="button" onclick="selectRating('comfort', 5)" class="rating-btn" data-value="5">🤩<span>5</span></button>
                    </div>
                </div>

                <div>
                    <label class="field-label">Ujiannya terasa susah?</label>
                    <div class="grid grid-cols-5 gap-2" data-rating-group="difficulty">
                        <button type="button" onclick="selectRating('difficulty', 1)" class="rating-btn" data-value="1">😎<span>1</span></button>
                        <button type="button" onclick="selectRating('difficulty', 2)" class="rating-btn" data-value="2">🙂<span>2</span></button>
                        <button type="button" onclick="selectRating('difficulty', 3)" class="rating-btn" data-value="3">🤔<span>3</span></button>
                        <button type="button" onclick="selectRating('difficulty', 4)" class="rating-btn" data-value="4">😵<span>4</span></button>
                        <button type="button" onclick="selectRating('difficulty', 5)" class="rating-btn" data-value="5">😭<span>5</span></button>
                    </div>
                    <p class="caption mt-2">1 = gampang, 5 = susah banget</p>
                </div>

                <div>
                    <label class="field-label">Bagian yang paling kamu suka</label>
                    <select id="favoritePart" class="field cursor-pointer">
                        <option value="">Pilih salah satu...</option>
                        <option value="soal">Soal ujiannya</option>
                        <option value="miaw">Maskot Miaw</option>
                        <option value="koin">Koin / bantuan ujian</option>
                        <option value="hint">Petunjuk / hint</option>
                        <option value="wrapped">Catatan Ngajiku / wrapped</option>
                        <option value="leaderboard">Leaderboard / peringkat</option>
                    </select>
                </div>

                <div>
                    <label class="field-label">Bagian mana yang bikin bingung?</label>
                    <textarea id="hardestPart" rows="3" class="field resize-none" placeholder="Contoh: bagian koin, tombol hint, dll..."></textarea>
                </div>

                <div>
                    <label class="field-label">Saran fitur tambahan</label>
                    <textarea id="suggestion" rows="3" class="field resize-none" placeholder="Menurut kamu, aplikasi ini perlu ditambah apa?"></textarea>
                </div>

                <div>
                    <label class="field-label">Pesan bebas buat Ustadz / Kak Aziz</label>
                    <textarea id="message" rows="3" class="field resize-none" placeholder="Boleh dikosongkan kalau tidak ada."></textarea>
                </div>

                <button type="submit" id="btnSubmitFeedback" class="btn btn-primary w-full">
                    Kirim & Simpan ke Raport
                </button>
            </form>
        </div>

        <!-- SUKSES -->
        <div id="successCard" class="hidden card w-full max-w-md p-8 text-center animate-slide-up">
            <div class="text-5xl mb-4">✅</div>
            <h2 id="successTitle" class="page-title mb-2">Terima Kasih!</h2>
            <p id="successDesc" class="body-text mb-6">Feedback kamu sudah terkirim. Laporan akhir kamu sudah lengkap.</p>
            <div class="rounded-[var(--r-md)] px-4 py-3 mb-6" style="background: var(--accent-soft); border: 1px solid var(--hairline);">
                <p id="successNoteText" class="text-[11px] font-extrabold uppercase tracking-widest" style="color: var(--accent-strong);">Sekarang kamu boleh menutup browser ini.</p>
            </div>
            <button id="btnSuccessClose" onclick="finishFeedback()" class="btn btn-primary w-full">Selesai</button>
        </div>
    </div>
    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const urlParams = new URLSearchParams(window.location.search);

    let studentId = urlParams.get('student_id');
    const examId = urlParams.get('exam_id');
    const isPreview = urlParams.get('preview') === 'true';
    let token = urlParams.get('token') || localStorage.getItem('token') || sessionStorage.getItem('temp_pr_token');

    const ratings = { comfort: 0, difficulty: 0 };

    document.addEventListener('DOMContentLoaded', async () => {
        if (studentId) {
            document.getElementById('feedbackCard').classList.remove('hidden');
        } else if (token) {
            document.getElementById('identitySelection').classList.remove('hidden');
            await loadStudentsForSelection();
        } else {
            document.getElementById('identitySelection').classList.remove('hidden');
            document.getElementById('studentSelectionList').innerHTML = '<p class="text-center text-xs font-bold py-4" style="color: var(--danger);">Akses Ditolak.<br>Buka melalui link resmi dari Ustadz.</p>';
        }
    });

    async function loadStudentsForSelection() {
        const container = document.getElementById('studentSelectionList');
        try {
            const [studentRes, fbRes] = await Promise.all([
                fetch(`${API_URL}/api/students`, { headers: { 'Authorization': `Bearer ${token}` } }),
                fetch(`${API_URL}/api/feedbacks`, { headers: { 'Authorization': `Bearer ${token}` } })
            ]);

            const [studentData, fbData] = await Promise.all([studentRes.json(), fbRes.json()]);
            const students = studentData.data || [];
            const feedbacks = fbData.data || [];
            const submittedIds = new Set(feedbacks.map(fb => String(fb.student_id)));
            const pendingStudents = students.filter(s => !submittedIds.has(String(s.id)));

            if (pendingStudents.length === 0) {
                container.innerHTML = `<div class="rounded-[var(--r-md)] p-5 text-center" style="background: var(--accent-soft); border: 1px solid var(--hairline);"><i class="fa-solid fa-circle-check text-3xl mb-2" style="color: var(--accent);"></i><p class="text-xs font-bold" style="color: var(--accent-strong);">Alhamdulillah, seluruh murid sudah mengisi form evaluasi!</p></div>`;
                return;
            }

            container.innerHTML = pendingStudents.map(s => {
                const isCompleted = s.is_exams_completed !== false;
                const lockedStyle = isCompleted ? '' : 'opacity:0.55;';
                const trailing = isCompleted
                    ? '<i class="fa-solid fa-chevron-right text-[10px]" style="color: var(--ink-tertiary);"></i>'
                    : '<i class="fa-solid fa-lock text-[10px]" style="color: var(--ink-tertiary);" title="Belum Selesai Ujian"></i>';

                return `
                    <button onclick="selectIdentity('${s.id}', '${s.name.replace(/'/g, "\\'")}', ${isCompleted})"
                        class="card card-interactive w-full text-left p-3 flex items-center gap-3" style="${lockedStyle}">
                        <span class="w-9 h-9 rounded-full font-black flex items-center justify-center text-xs shrink-0" style="background: var(--accent-soft); color: var(--accent-strong);">${s.name.substring(0,2).toUpperCase()}</span>
                        <span class="min-w-0 flex-1">
                            <span class="block font-bold text-xs truncate" style="color: var(--ink);">${s.name}</span>
                            <span class="block text-[9px] font-bold uppercase mt-0.5" style="color: var(--ink-tertiary);">${s.grade || 'Siswa'}</span>
                        </span>
                        ${trailing}
                    </button>
                `;
            }).join('');
        } catch (err) {
            container.innerHTML = `<p class="text-center text-xs font-bold py-4" style="color: var(--danger);">Gagal memuat data kelas.</p>`;
        }
    }

    window.selectIdentity = (id, name, isCompleted) => {
        if (!isCompleted) {
            return window.showToast?.('warning', 'Ujian Belum Selesai', 'Maaf, kamu harus menyelesaikan semua ujian terlebih dahulu sebelum mengisi form evaluasi ini.');
        }
        studentId = id;
        document.getElementById('displayStudentName').innerText = name.split(' ')[0];
        document.getElementById('identitySelection').classList.add('hidden');
        document.getElementById('feedbackCard').classList.remove('hidden');
    };

    window.selectRating = (type, value) => {
        ratings[type] = value;
        document.querySelectorAll(`[data-rating-group="${type}"] .rating-btn`).forEach(btn => btn.classList.remove('selected'));
        document.querySelector(`[data-rating-group="${type}"] [data-value="${value}"]`)?.classList.add('selected');
    };

    // Tampilkan kartu sukses; kalau preview → teks "Simulasi ujian user berakhir".
    const showSuccess = () => {
        document.getElementById('feedbackCard').classList.add('hidden');
        document.getElementById('successCard').classList.remove('hidden');
        if (isPreview) {
            document.getElementById('successTitle').innerText = 'Simulasi Selesai';
            document.getElementById('successDesc').innerText = 'Ini mode pratinjau guru, jadi jawaban TIDAK dikirim ke database.';
            document.getElementById('successNoteText').innerText = 'Simulasi ujian user berakhir';
            document.getElementById('btnSuccessClose').innerText = 'Tutup Simulasi';
        }
    };

    window.finishFeedback = () => {
        if (isPreview) { window.location.href = '/exams'; return; }
        window.location.replace('/selesai');
    };

    document.getElementById('feedbackForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!studentId) return window.showToast?.('danger', 'Gagal', 'Identitas siswa tidak ditemukan.');
        if (!ratings.comfort || !ratings.difficulty) return window.showToast?.('warning', 'Isi Dulu', 'Pilih nilai kenyamanan dan kesulitan dulu ya.');

        const btn = document.getElementById('btnSubmitFeedback');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...';

        try {
            // [PREVIEW] Mode pratinjau: TIDAK mengirim ke DB, cukup tampilkan sukses simulasi.
            if (isPreview) {
                await new Promise(resolve => setTimeout(resolve, 600));
                showSuccess();
                window.showToast?.('success', 'Simulasi Berhasil', 'Data tidak dikirim karena ini mode simulasi.');
                return;
            }

            const res = await fetch(`${API_URL}/api/onboarding/feedback`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_id: studentId,
                    exam_id: examId,
                    comfort_rating: ratings.comfort,
                    difficulty_rating: ratings.difficulty,
                    favorite_part: document.getElementById('favoritePart').value,
                    hardest_part: document.getElementById('hardestPart').value.trim(),
                    suggestion: document.getElementById('suggestion').value.trim(),
                    message: document.getElementById('message').value.trim(),
                    source: 'app_general'
                })
            });

            const result = await res.json();
            if (!res.ok) throw new Error(result.message || 'Gagal mengirim feedback.');

            showSuccess();
            window.showToast?.('success', 'Terkirim', 'Feedback kamu berhasil disimpan.');

        } catch (err) {
            window.showToast?.('danger', 'Gagal', err.message);
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });
</script>

<style is:global>
    .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { 0% { transform: translateY(20px) scale(0.97); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }

    /* Tombol rating — gaya minimalis hijau (design system) */
    .rating-btn {
        background: var(--parchment);
        border: 1px solid var(--hairline);
        border-radius: var(--r-md);
        min-height: 60px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
        font-size: 1.3rem; font-weight: 800; color: var(--ink-secondary);
        transition: transform 0.15s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        cursor: pointer;
    }
    .rating-btn span { font-size: 0.62rem; font-weight: 800; }
    .rating-btn.selected {
        background: var(--accent-soft);
        border-color: var(--accent);
        color: var(--accent-strong);
        transform: translateY(-2px);
    }
</style>
