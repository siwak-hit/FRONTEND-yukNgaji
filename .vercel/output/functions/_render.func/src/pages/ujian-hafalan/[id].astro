---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Detail Ujian Hafalan - yukNgaji">
    <div class="px-6 py-8 min-h-screen">
        <header class="flex items-center gap-3 mb-6">
            <a href="/ujian-hafalan" class="btn-icon flex-shrink-0" aria-label="Kembali">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div class="min-w-0">
                <p id="subjectBadge" class="eyebrow">MEMUAT...</p>
                <h1 id="pageTitle" class="page-title truncate">Ujian Hafalan</h1>
            </div>
        </header>

        <section id="summaryCard" class="grid grid-cols-3 gap-3 mb-6">
            <div class="card p-4 text-center">
                <p class="eyebrow">Total</p>
                <p id="sumTotal" class="text-2xl font-bold text-ink mt-1">0</p>
            </div>
            <div class="card p-4 text-center" style="background-color: var(--accent-soft); border-color: transparent;">
                <p class="eyebrow" style="color: var(--accent-strong);">Selesai</p>
                <p id="sumDone" class="text-2xl font-bold mt-1" style="color: var(--accent-strong);">0</p>
            </div>
            <div class="card p-4 text-center" style="background-color: var(--warning-soft); border-color: transparent;">
                <p class="eyebrow" style="color: var(--warning);">Sisa</p>
                <p id="sumLeft" class="text-2xl font-bold mt-1" style="color: var(--warning);">0</p>
            </div>
        </section>

        <section class="card card-pad mb-6">
            <div class="flex items-center justify-between mb-5">
                <h2 class="section-title">Target Hafalan</h2>
                <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                    <i class="fa-solid fa-book-open"></i>
                </div>
            </div>

            <div id="sectionList" class="grid grid-cols-1 gap-3">
                <div class="text-center py-6">
                    <i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i>
                </div>
            </div>
        </section>

        <section class="card card-pad mb-8">
            <div class="flex items-center justify-between mb-5 gap-3">
                <h2 class="section-title">Daftar Peserta</h2>
                <button onclick="createSessionPreview()" id="btnCreateSession" class="btn btn-primary !py-2.5 !px-5 text-sm flex-shrink-0">
                    Buat Sesi
                </button>
            </div>

            <div id="studentList" class="grid grid-cols-2 gap-3">
                <div class="col-span-2 text-center py-6">
                    <i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i>
                </div>
            </div>
        </section>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const templateId = window.location.pathname.split('/').pop();

    let pageData = null;

    const getInitials = (name = '') => {
        return name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '--';
    };

    const getStatusMeta = (student) => {
        const tested = !!student.oral_result;
        if (!tested) {
            return { label: 'Belum', badge: 'badge-warning', dim: false };
        }
        const status = student.oral_result.status || 'done';
        if (status === 'passed') return { label: 'Lulus', badge: 'badge-accent', dim: true };
        if (status === 'need_remedial' || status === 'failed') return { label: 'Remedial', badge: 'badge-danger', dim: true };
        return { label: 'Selesai', badge: 'badge-neutral', dim: true };
    };

    const fetchDetail = async () => {
        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal memuat detail evaluasi.');
            }

            pageData = result.data;
            renderPage();
        } catch (error) {
            console.error(error);
            window.showToast?.('danger', 'Gagal', error.message);
        }
    };

    const renderPage = () => {
        const { template, sections, students, summary } = pageData;

        document.getElementById('subjectBadge').innerText = template.subject;
        document.getElementById('pageTitle').innerText = template.title;

        document.getElementById('sumTotal').innerText = summary.total_students;
        document.getElementById('sumDone').innerText = summary.tested_students;
        document.getElementById('sumLeft').innerText = summary.not_tested_students;

        // Render List Materi
        document.getElementById('sectionList').innerHTML = sections.map((section, index) => {
            const totalItems = section.oral_exam_items?.length || 0;
            return `
                <div class="rounded-[var(--r-lg)] p-4" style="background-color: var(--surface-sunken);">
                    <div class="flex items-start gap-3 mb-3">
                        <div class="icon-chip-sm" style="background-color:#fff; color: var(--accent-strong);">${index + 1}</div>
                        <div>
                            <p class="caption font-semibold text-ink leading-tight">${section.title}</p>
                            <p class="text-[10px] font-medium text-tertiary mt-0.5">Wajib: ${section.min_required} dari ${totalItems} Materi</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                        ${(section.oral_exam_items || []).map(item => `
                            <span class="badge badge-neutral" style="background-color:#fff;">${item.short_label || item.title}</span>
                        `).join('')}
                    </div>
                </div>
            `;
        }).join('');

        // Render List Siswa
        document.getElementById('studentList').innerHTML = students.map(student => {
            const meta = getStatusMeta(student);
            const tested = !!student.oral_result;

            return `
                <div class="card p-4 text-center ${meta.dim ? 'opacity-60' : 'card-interactive'}">
                    <div class="avatar w-12 h-12 mx-auto text-sm mb-3">${getInitials(student.name)}</div>
                    <p class="caption font-semibold text-ink truncate w-full">${student.name}</p>
                    <p class="text-[10px] font-medium text-tertiary mt-0.5 truncate w-full">${student.grade || '-'}</p>
                    <div class="mt-3">
                        <span class="badge ${meta.badge}">${meta.label}${tested ? ` · ${student.oral_result.final_score || 0}` : ''}</span>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.createSessionPreview = async () => {
        const notTested = pageData.students.filter(s => !s.oral_result);
        if (notTested.length === 0) {
            window.showToast?.('success', 'Selesai', 'Semua siswa sudah diuji.');
            return;
        }

        const btn = document.getElementById('btnCreateSession');
        const originalText = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btn.classList.add('opacity-70', 'cursor-not-allowed');

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions`, {
                method: 'POST',
                headers: {
                    Authorization: `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({})
            });

            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal membuat sesi.');
            }

            const sessionId = result.data.session.id;
            window.location.href = `/ujian-hafalan/${templateId}/session/${sessionId}`;

        } catch (error) {
            console.error(error);
            window.showToast?.('danger', 'Gagal', error.message);

            btn.disabled = false;
            btn.innerHTML = originalText;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
    };

    fetchDetail();
</script>
