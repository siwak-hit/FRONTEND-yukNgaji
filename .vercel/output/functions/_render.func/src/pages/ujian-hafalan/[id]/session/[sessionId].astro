    };

    // ==========================================
    // LOGIKA GENERATOR PERTANYAAN (UPDATE 2)
    // ==========================================
    const generateQuestions = () => {
        // Mengambil dari sessionData yang sekarang sudah berisi understanding_prompts
        const prompts = sessionData.understanding_prompts || [];

        // Jika data dari DB kosong, baru gunakan fallback
        if (prompts.length === 0) {
            return ["Jelaskan kembali intisari dari materi yang baru saja dipelajari."];
        }

        // Ambil 2-3 soal secara acak dari database
        const count = Math.floor(Math.random() * 2) + 2;
        // Mengacak array prompt
        const shuffled = [...prompts].sort(() => 0.5 - Math.random());

        // Mengembalikan properti 'prompt' dari objek yang diambil
        return shuffled.slice(0, count).map(p => p.prompt);
    };

    // FUNGSI BARU: Ganti mode antara Hafalan dan Pemahaman
    window.switchAssessmentMode = (mode) => {
        const hafalanView = document.getElementById('hafalanView');
        const pemahamanView = document.getElementById('pemahamanView');
        const modeSelect = document.getElementById('modeSelect');

        if (modeSelect) modeSelect.value = mode;

        if (mode === 'hafalan') {
            hafalanView.classList.replace('hidden', 'block');
            pemahamanView.classList.replace('block', 'hidden');
        } else {
            hafalanView.classList.replace('block', 'hidden');
            pemahamanView.classList.replace('hidden', 'block');

            // Setup nilai default soal pemahaman jika siswa belum pernah buka tab ini
            selectedStudents.forEach(student => {
                if (!understandingScores[student.id]) {
                    understandingScores[student.id] = {
                        rating: 0,
                        note: '',
                        questions: generateQuestions(),
                        questionStates: [] // Array track soal dicoret (true/false)
                    };
                }
            });

            if (!activeUnderstandingStudent && selectedStudents.length > 0) {
                activeUnderstandingStudent = selectedStudents[0].id;
            }

            renderUnderstandingCards();
            renderFinalScorePreview();
            saveSessionToStorage();
        }
    };

    window.openUnderstandingStep = () => {
        if (!hasSessionStarted) return window.showToast?.('warning', 'Sesi Belum Dimulai', 'Mulai sesi terlebih dahulu.');

        switchAssessmentMode('pemahaman');
        setTimeout(() => {
            document.getElementById('mainAssessmentSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 150);
    };

    const renderUnderstandingCards = () => {
        const container = document.getElementById('understandingCardsContainer');
        if (!container) return;

        if (!activeUnderstandingStudent && selectedStudents.length > 0) {
            activeUnderstandingStudent = selectedStudents[0].id;
        }

        const student = selectedStudents.find(s => String(s.id) === String(activeUnderstandingStudent));
        if (!student) return;

        const current = understandingScores[student.id];

        // 1. Render Elemen Select Siswa
        const selectHtml = `
            <div class="mb-5 pb-4 border-b-2 border-slate-50 flex flex-col gap-2">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                    <i class="fa-solid fa-user-graduate text-purple-500"></i> Siswa Yang Sedang Diuji (Pemahaman)
                </label>
                <select onchange="switchUnderstandingStudent(this.value)" class="w-full bg-slate-50 border-2 border-slate-200 rounded-xl px-3 py-2.5 text-xs font-black text-slate-700 outline-none focus:border-purple-500 transition-all cursor-pointer">
                    ${selectedStudents.map(s => `
                        <option value="${s.id}" ${String(activeUnderstandingStudent) === String(s.id) ? 'selected' : ''}>${s.name}</option>
                    `).join('')}
                </select>
            </div>
        `;

        // 2. Render Form Pemahaman
        const cardHtml = `
            <div class="bg-white border-2 border-slate-100 rounded-3xl p-5 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-4 border-b-2 border-slate-50">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-purple-50 border-2 border-purple-100 text-purple-600 rounded-full flex items-center justify-center font-black text-xs shadow-inner">
                            ${getInitials(student.name)}
                        </div>
                        <div>
                            <p class="text-sm font-black text-slate-800">${student.name}</p>
                            <p class="text-[10px] font-bold text-slate-400">Tes lisan individu</p>
                        </div>
                    </div>
                    <button onclick="refreshStudentQuestions('${student.id}', event)" class="w-8 h-8 flex items-center justify-center bg-purple-50 text-purple-600 rounded-xl hover:bg-purple-100 transition-all" title="Acak Soal Baru">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </button>
                </div>

                <div id="questions-container-${student.id}" class="mb-5 space-y-2.5">
                    ${current.questions.map((q, i) => {
                        const isAsked = current.questionStates?.[i] || false;
                        return `
                            <div onclick="toggleQuestionStrikethrough('${student.id}', ${i})" class="cursor-pointer flex items-start gap-2.5 bg-purple-50/50 hover:bg-purple-50 p-3 rounded-2xl border border-purple-100/50 transition-colors group">
                                <span class="w-5 h-5 shrink-0 rounded-full bg-white text-purple-500 border border-purple-200 flex items-center justify-center text-[10px] font-black shadow-sm group-hover:bg-purple-100 transition-colors">${i+1}</span>
                                <p id="q-text-${student.id}-${i}" class="text-xs font-bold leading-relaxed mt-0.5 transition-all select-none ${isAsked ? 'text-slate-400 line-through' : 'text-slate-700'}">${q}</p>
