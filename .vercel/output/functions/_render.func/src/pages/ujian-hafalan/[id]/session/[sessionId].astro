                                <button onclick="setScore('${student.id}', '${item.id}', 1, ${secIdx})" id="btn-1-${student.id}-${item.id}"
                                    class="flex-1 py-1.5 text-[9px] font-black rounded-md transition-all ${score === 1 ? 'bg-amber-100 shadow-sm text-amber-600 border border-amber-200' : 'text-slate-400 hover:text-amber-500 border border-transparent'}">Ikut</button>
                                <button onclick="setScore('${student.id}', '${item.id}', 2, ${secIdx})" id="btn-2-${student.id}-${item.id}"
                                    class="flex-1 py-1.5 text-[9px] font-black rounded-md transition-all ${score === 2 ? 'bg-green-100 shadow-sm text-green-600 border border-green-200' : 'text-slate-400 hover:text-green-500 border border-transparent'}">Hafal</button>
                            </div>
                        </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    };

    window.switchMatrixStudent = (secIdx, studentId) => {
        activeStudentPerSection[secIdx] = studentId;
        saveSessionToStorage();
        const section = sessionData.sections[secIdx];
        const container = document.getElementById(`matrix-student-card-container-${secIdx}`);
        if (container && section) {
            container.innerHTML = renderSingleStudentCardHtml(secIdx, studentId, section.oral_exam_items || []);
        }
    };

    // FUNGSI BARU (Gantikan fungsi window.toggleTestedItem sebelumnya)
    window.toggleGlobalTestedItem = (itemId, secIdx) => {
        const section = sessionData.sections[secIdx];
        const maxAllowed = section.min_required || section.oral_exam_items.length;

        // Pengecekan sebelum mengubah status menjadi 'true' (diceklis)
        if (!testedItems[itemId]) {
            const currentCount = (section.oral_exam_items || []).filter(item => testedItems[item.id]).length;
            if (currentCount >= maxAllowed) {
                // Mencegah klik lebih dari batas
                return;
            }
        }

        // Toggle state
        testedItems[itemId] = !testedItems[itemId];

        // Render ulang Checkbox UI untuk langsung mendisable sisanya
        const chkContainer = document.getElementById(`global-checkboxes-container-${secIdx}`);
        if (chkContainer) {
            chkContainer.innerHTML = renderGlobalCheckboxesHtml(secIdx);
        }

        // Render ulang form matriks penilaian siswa aktif (memunculkan/menghilangkan baris penilaian)
        const studentId = activeStudentPerSection[secIdx];
        const container = document.getElementById(`matrix-student-card-container-${secIdx}`);
        if (container && section && studentId) {
            container.innerHTML = renderSingleStudentCardHtml(secIdx, studentId, section.oral_exam_items || []);
        }

        saveSessionToStorage();
        updatePreviewScores();
    };

    window.toggleMatrixSection = (index) => {
        const body = document.getElementById(`body-matrix-${index}`);
        const icon = document.getElementById(`icon-matrix-${index}`);
        const header = document.getElementById(`header-matrix-${index}`);

        if (body.classList.contains('hidden')) {
            document.querySelectorAll('.matrix-body').forEach(el => el.classList.replace('block', 'hidden'));
            document.querySelectorAll('.matrix-icon').forEach(el => el.className = 'matrix-icon fa-solid fa-chevron-down text-slate-400 transition-transform');
            document.querySelectorAll('.matrix-header').forEach(el => el.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-slate-50 border-slate-100');

            body.classList.replace('hidden', 'block');
            icon.className = 'matrix-icon fa-solid fa-chevron-up text-indigo-600 transition-transform';
            header.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-indigo-50 border-indigo-500';
        } else {
            body.classList.replace('block', 'hidden');
            icon.className = 'matrix-icon fa-solid fa-chevron-down text-slate-400 transition-transform';
            header.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-slate-50 border-slate-100';
        }
    };

    window.nextMatrixSection = (currentIndex) => {
        const nextIndex = currentIndex + 1;
        if (nextIndex < sessionData.sections.length) {
            toggleMatrixSection(nextIndex);
            setTimeout(() => document.getElementById(`header-matrix-${nextIndex}`).scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
        }
    };

    window.setScore = (studentId, itemId, score, sectionIndex) => {
        assessmentScores[studentId][itemId] = score;
        saveSessionToStorage();

        // Manual update class tombol agar instan dan enteng tanpa re-render total select option
        [0, 1, 2].forEach(val => {
            const btn = document.getElementById(`btn-${val}-${studentId}-${itemId}`);
            if (!btn) return;
            btn.className = 'flex-1 py-1.5 text-[9px] font-black rounded-md transition-all border border-transparent text-slate-400';
            if (val === score) {
                if (val === 0) btn.classList.add('bg-white', 'shadow-sm', 'text-slate-600', 'border-slate-200');
                if (val === 1) btn.classList.add('bg-amber-100', 'shadow-sm', '!text-amber-600', 'border-amber-200');
                if (val === 2) btn.classList.add('bg-green-100', 'shadow-sm', '!text-green-600', 'border-green-200');
            }
        });
        updatePreviewScores();
    };

    const updatePreviewScores = () => {
        const previewContainer = document.getElementById('memorizationPreview');
        if (!previewContainer) return;

        previewContainer.innerHTML = selectedStudents.map(student => {
            const mem = calculateMemorizationScore(student.id);

            let checkedCount = 0;
            sessionData.sections.forEach(sec => {
                (sec.oral_exam_items || []).forEach(item => {
                    if (testedItems[item.id]) checkedCount++;
                });
            });

            return `
                <div class="flex items-center justify-between bg-white p-3 rounded-2xl border-2 border-indigo-100/50 shadow-sm">
                     <div class="flex items-center gap-3">
                         <div class="w-8 h-8 shrink-0 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-[10px] font-black border border-indigo-100">${getInitials(student.name)}</div>
