            const iconClass = isFirst ? 'fa-chevron-up text-indigo-600' : 'fa-chevron-down text-slate-400';
            const bodyClass = isFirst ? 'block' : 'hidden';

            if (!activeStudentPerSection[secIdx] && selectedStudents.length > 0) {
                activeStudentPerSection[secIdx] = selectedStudents[0].id;
            }

            const maxAllowed = section.min_required || items.length;

            return `
                <div class="mb-4">
