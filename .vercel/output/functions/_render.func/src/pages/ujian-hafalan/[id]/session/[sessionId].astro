                        ${[1, 2, 3, 4, 5].map(star => `
                            <button onclick="setUnderstandingRating('${student.id}', ${star})" data-rating="${star}"
                                    class="rating-btn-${student.id} flex-1 py-2 rounded-xl border-2 flex items-center justify-center text-sm font-black transition-all ${current.rating === star ? 'bg-amber-100 border-amber-400 text-amber-600 shadow-sm' : 'bg-slate-50 border-slate-100 text-slate-400 hover:border-amber-200 hover:text-amber-500'}">
                                ${star}
                            </button>
                        `).join('')}
                    </div>

                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Catatan (Opsional)</label>
                    <textarea oninput="setUnderstandingNote('${student.id}', this.value)"
                              class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl p-3 text-xs font-bold text-slate-700 focus:border-purple-500 focus:ring-0 outline-none resize-none h-16 transition-all"
                              placeholder="Tambahkan catatan evaluasi...">${current.note || ''}</textarea>
                </div>
            </div>
        `;

        container.innerHTML = selectHtml + cardHtml;
    };

    window.switchUnderstandingStudent = (studentId) => {
        activeUnderstandingStudent = studentId;
        saveSessionToStorage();
        renderUnderstandingCards();
    };

    window.toggleQuestionStrikethrough = (studentId, index) => {
        const current = understandingScores[studentId];
        if (!current.questionStates) current.questionStates = [];

        current.questionStates[index] = !current.questionStates[index];

        const qText = document.getElementById(`q-text-${studentId}-${index}`);
        if (qText) {
            if (current.questionStates[index]) {
                qText.classList.replace('text-slate-700', 'text-slate-400');
                qText.classList.add('line-through');
            } else {
                qText.classList.replace('text-slate-400', 'text-slate-700');
                qText.classList.remove('line-through');
            }
        }
        saveSessionToStorage();
    };

    window.refreshStudentQuestions = (studentId, event) => {
        const btn = event?.currentTarget;
        if (btn) {
            btn.querySelector('i').classList.add('fa-spin');
            setTimeout(() => btn.querySelector('i').classList.remove('fa-spin'), 500);
        }

        understandingScores[studentId].questions = generateQuestions();
        understandingScores[studentId].questionStates = []; // Reset coretan
        renderUnderstandingCards();
        saveSessionToStorage();
    };

    window.setUnderstandingRating = (studentId, rating) => {
        understandingScores[studentId].rating = rating;

        // Update styling tombol rating secara dinamis tanpa merender ulang seluruh komponen
        document.querySelectorAll(`.rating-btn-${studentId}`).forEach(btn => {
            const btnRating = parseInt(btn.dataset.rating);
            if (btnRating === rating) {
                btn.className = `rating-btn-${studentId} flex-1 py-2 rounded-xl border-2 flex items-center justify-center text-sm font-black transition-all bg-amber-100 border-amber-400 text-amber-600 shadow-sm`;
            } else {
                btn.className = `rating-btn-${studentId} flex-1 py-2 rounded-xl border-2 flex items-center justify-center text-sm font-black transition-all bg-slate-50 border-slate-100 text-slate-400 hover:border-amber-200 hover:text-amber-500`;
            }
        });

        // Tetap kalkulasi dan update preview skor akhir
        renderFinalScorePreview();
    };

    window.setUnderstandingNote = (studentId, note) => {
        understandingScores[studentId].note = note;
    };

    const calculateMemorizationScore = (studentId) => {
        let total = 0;
        let maxTotal = 0;
        let passedSections = 0;
        let totalSections = 0;

        sessionData.sections.forEach(section => {
            const items = section.oral_exam_items || [];

            // Filter hanya materi yang dicentang secara global (berlaku ke semua siswa)
            const checkedItems = items.filter(item => testedItems[item.id]);

            if (checkedItems.length > 0) {
                totalSections++;

                const hafalCount = checkedItems.filter(item => Number(assessmentScores?.[studentId]?.[item.id] || 0) === 2).length;
                if (hafalCount >= Number(section.min_required || 0)) passedSections++;

                checkedItems.forEach(item => {
                    total += Number(assessmentScores?.[studentId]?.[item.id] || 0);
                    maxTotal += 2; // Setiap 1 materi maksimal poinnya adalah 2 (Hafal)
                });
            }
        });

        const score = maxTotal > 0 ? Math.round((total / maxTotal) * 100) : 0;
        return { score, passedSections, totalSections, passedMinimum: totalSections > 0 ? (passedSections >= totalSections) : false };
    };

    const calculateFinalScore = (studentId) => {
        const mem = calculateMemorizationScore(studentId);
        const rating = Number(understandingScores?.[studentId]?.rating || 0);
        const understandingScore = rating * 20;
        const finalScore = Math.round((mem.score * 0.7) + (understandingScore * 0.3));

        // Logika Status Berdasarkan Nilai Akhir
        let status = 'Kurang';
        if (finalScore >= 90) status = 'Sempurna';
        else if (finalScore >= 70) status = 'Bagus';
        else if (finalScore >= 60) status = 'Cukup';
        else if (finalScore >= 50) status = 'Belum Cukup';

        return {
            memorization_score: mem.score,
            understanding_score: understandingScore,
            final_score: finalScore,
            status: status,
            passedSections: mem.passedSections,
            totalSections: mem.totalSections
        };
    };

    const renderFinalScorePreview = () => {
        const container = document.getElementById('finalScorePreview');
        if (!container) return;

        container.innerHTML = selectedStudents.map(student => {
            const result = calculateFinalScore(student.id);

            // Konfigurasi Tema Warna Berdasarkan Nilai Akhir
            let theme = { border: 'border-red-100', bgIcon: 'bg-red-50', textIcon: 'text-red-600', textScore: 'text-red-600', textStatus: 'text-red-500' }; // < 50

            if (result.final_score >= 90) { // Sempurna
                theme = { border: 'border-emerald-200', bgIcon: 'bg-emerald-50', textIcon: 'text-emerald-600', textScore: 'text-emerald-600', textStatus: 'text-emerald-500' };
            } else if (result.final_score >= 70) { // Bagus
                theme = { border: 'border-green-200', bgIcon: 'bg-green-50', textIcon: 'text-green-600', textScore: 'text-green-600', textStatus: 'text-green-500' };
            } else if (result.final_score >= 60) { // Cukup
                theme = { border: 'border-blue-200', bgIcon: 'bg-blue-50', textIcon: 'text-blue-600', textScore: 'text-blue-600', textStatus: 'text-blue-500' };
            } else if (result.final_score >= 50) { // Belum Cukup
                theme = { border: 'border-amber-200', bgIcon: 'bg-amber-50', textIcon: 'text-amber-600', textScore: 'text-amber-500', textStatus: 'text-amber-500' };
            }

            return `
                <div class="bg-white border-2 ${theme.border} rounded-2xl p-4 flex items-center justify-between shadow-sm transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full ${theme.bgIcon} ${theme.textIcon} border-2 ${theme.border} flex items-center justify-center font-black text-xs">
                            ${getInitials(student.name)}
                        </div>
                        <div>
                            <p class="text-xs font-black text-slate-800">${student.name}</p>
                            <p class="text-[9px] font-bold text-slate-400">Hafalan: ${result.memorization_score} • Lisan: ${result.understanding_score}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-black ${theme.textScore}">${result.final_score}</p>
                        <p class="text-[8px] font-black uppercase tracking-widest ${theme.textStatus}">${result.status}</p>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.submitAssessment = async () => {
        const notRated = selectedStudents.filter(student => !Number(understandingScores?.[student.id]?.rating || 0));
        if (notRated.length > 0) return window.showToast?.('warning', 'Belum Lengkap', `Rating pemahaman ${notRated[0].name} belum diisi.`);

        const payloadResults = selectedStudents.map(student => {
            const final = calculateFinalScore(student.id);
            const items = [];

            sessionData.sections.forEach(section => {
                (section.oral_exam_items || []).forEach(item => {
                    // Cek status centang global
                    const isTested = testedItems[item.id] || false;
                    items.push({
                        item_id: item.id,
                        // Jika tidak diujikan, pastikan nilainya default 0 yang terkirim
                        score: isTested ? Number(assessmentScores?.[student.id]?.[item.id] || 0) : 0
                    });
                });
            });

            return {
                student_id: student.id,
                memorization_score: final.memorization_score,
                understanding_score: final.understanding_score,
                final_score: final.final_score,
                understanding_rating: Number(understandingScores?.[student.id]?.rating || 0),
                notes: understandingScores?.[student.id]?.note || null,
                status: final.status,
                duration_seconds: totalSeconds - remainingSeconds,
                items
            };
        });

        if (sessionMode === 'simulation') {
            clearSessionStorage();
            return window.showToast?.('success', 'Simulasi Selesai', 'Data tidak dikirim ke database karena ini mode simulasi.');
        }

        const btn = document.getElementById('btnSubmitFinalAssessment');
        const originalText = btn?.innerHTML;
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
            btn.classList.add('opacity-70', 'cursor-not-allowed');
        }

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}/results`, {
                method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ results: payloadResults })
            });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal menyimpan hasil evaluasi.');

            clearInterval(timerInterval);
            clearSessionStorage(); // Bersihkan local storage karena data sudah aman masuk DB
            window.showToast?.('success', 'Tersimpan', 'Hasil evaluasi hafalan berhasil disimpan.');
            setTimeout(() => { window.location.href = `/ujian-hafalan/${templateId}`; }, 900);
        } catch (error) {
            console.error(error); window.showToast?.('danger', 'Gagal', error.message);
            if (btn) { btn.disabled = false; btn.innerHTML = originalText; btn.classList.remove('opacity-70', 'cursor-not-allowed'); }
        }
    };

    fetchSession();
</script>

