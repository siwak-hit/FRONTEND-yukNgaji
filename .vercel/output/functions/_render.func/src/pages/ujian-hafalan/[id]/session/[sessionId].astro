---
import Layout from '../../../../layouts/Layout.astro';
import Toast from '../../../../components/Toast.astro';
---

<Layout title="Sesi Ujian Hafalan - yukNgaji">
    <div id="floatingTimerWrapper" class="fixed top-6 left-1/2 -translate-x-1/2 z-[500] transition-all duration-500 -translate-y-[150%] opacity-0 pointer-events-none">
        <div id="floatingTimerBg" class="bg-[var(--accent)] text-white px-5 py-2.5 rounded-full border-2 border-white/20 flex items-center gap-3 backdrop-blur-md shadow-[0_12px_40px_rgba(0,0,0,0.18)]">
            <i class="fa-solid fa-stopwatch animate-pulse"></i>
            <span id="floatingTimerText" class="font-bold text-lg tabular-nums tracking-tight leading-none">10:00</span>
        </div>
    </div>

    <div class="min-h-screen px-6 py-8 pb-32 relative">
        <header class="flex items-center gap-3 mb-6">
            <a id="btnBackDetail" href="/ujian-hafalan" class="btn-icon flex-shrink-0" aria-label="Kembali">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div class="min-w-0">
                <p id="sessionBadge" class="eyebrow">Sesi Evaluasi</p>
                <h1 id="sessionTitle" class="page-title truncate">Memuat...</h1>
                <p id="sessionDesc" class="caption mt-0.5 truncate">Menyiapkan data sesi...</p>
            </div>
        </header>

        <div class="relative z-40 mb-6">
            <div id="sessionDashboardCard" class="card overflow-hidden transition-colors duration-500" style="box-shadow: var(--shadow-pop);">

                <div id="timerHeader" class="p-5 bg-[var(--ink)] text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500">
                    <div class="relative z-10">
                        <h2 class="text-[10px] font-bold opacity-70 uppercase tracking-widest mb-0.5">Timer Sesi</h2>
                        <div id="timerBox" class="text-4xl font-bold tabular-nums tracking-tight leading-none">10:00</div>
                    </div>
                    <div class="relative z-10 text-right flex items-center gap-2">
                        <button id="btnResetSession" onclick="resetSessionWithConfirm()" class="hidden px-3 py-2.5 bg-white/10 hover:bg-white/20 active:scale-95 rounded-[var(--r-md)] text-xs font-semibold backdrop-blur-sm transition-all flex items-center gap-1.5 border border-white/20">
                            <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                        <button id="btnToggleSlot" onclick="toggleSlotAccordion()" class="px-4 py-2.5 bg-white/10 hover:bg-white/20 active:scale-95 rounded-[var(--r-md)] text-xs font-semibold backdrop-blur-sm transition-all flex items-center gap-2 border border-white/20">
                            <i class="fa-solid fa-users"></i> Peserta (<span id="slotCounterTop">0/5</span>)
                            <i id="slotAccordionIcon" class="fa-solid fa-chevron-up transition-transform duration-300"></i>
                        </button>
                    </div>
                    <div class="absolute bottom-0 left-0 w-full h-1.5 bg-black/20">
                        <div id="timerBar" class="h-full bg-white/80 transition-all duration-1000" style="width: 100%;"></div>
                    </div>
                </div>

                <div id="modalStartMode" class="modal-overlay hidden" style="z-index: 600;">
                    <div class="modal-sheet">
                        <div class="sheet-grabber"></div>
                        <div class="text-center mb-5">
                            <div class="icon-chip mx-auto mb-3" style="width:3.5rem;height:3.5rem;font-size:1.5rem;background-color: var(--accent-soft); color: var(--accent-strong);">
                                <i class="fa-solid fa-play"></i>
                            </div>
                            <h3 class="section-title">Mulai Sesi?</h3>
                            <p class="caption mt-1">Tentukan target waktu dan pilih mode sesi.</p>
                        </div>

                        <div class="mb-5">
                            <label class="field-label">Durasi Target Sesi (Menit)</label>
                            <input type="number" id="sessionDurationInput" value="10" min="1" max="180" class="field field-sunken text-center font-bold" />
                        </div>

                        <div class="grid grid-cols-1 gap-3">
                            <button onclick="startSession('simulation')" class="btn btn-soft w-full" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Simulasi Saja</button>
                            <button onclick="startSession('real')" class="btn btn-primary w-full">Real, Simpan Data</button>
                        </div>

                        <button onclick="closeStartModeModal()" class="w-full mt-4 py-2 caption text-tertiary font-medium">Batal</button>
                    </div>
                </div>

                <div id="slotAccordionBody" class="block transition-all duration-300 bg-white">
                    <div class="p-5">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="section-title">Pilih Peserta Sesi</h3>
                                <p class="caption mt-0.5">Pilih maksimal 5 siswa</p>
                            </div>
                            <button onclick="openStartModeModal()" id="btnOpenStartModal" class="btn btn-primary !py-2.5 !px-5 text-sm flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                                Mulai Sesi
                            </button>
                        </div>
                        <div id="slotList" class="w-full">
                            <div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-accent text-xl"></i></div>
                        </div>
                    </div>
                </div>

                <div id="activeSessionBody" class="hidden transition-all duration-300 border-t p-4" style="background-color: var(--pearl); border-color: var(--hairline);">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="eyebrow">Peserta Sedang Diuji</h3>
                    </div>
                    <div id="sessionStudents" class="flex overflow-x-auto gap-3 pb-2 snap-x no-scrollbar">
                        </div>
                </div>
            </div>
        </div>

        <section id="mainAssessmentSection" class="hidden animate-slide-up mt-6">
            <div class="flex flex-col sm:flex-row items-center justify-between card card-pad !p-4 mb-6 gap-3">
                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <div>
                        <h2 class="section-title">Panel Evaluasi</h2>
                        <p class="caption mt-0.5">Pilih tahap penilaian</p>
                    </div>
                </div>
                <select id="modeSelect" onchange="switchAssessmentMode(this.value)" class="field !w-full sm:!w-auto !py-2.5 text-sm font-semibold cursor-pointer">
                    <option value="hafalan">Tahap 1: Hafalan</option>
                    <option value="pemahaman">Tahap 2: Pemahaman</option>
                </select>
            </div>

            <div id="hafalanView" class="block animate-slide-up">
                <div class="flex flex-col lg:flex-row gap-6 items-start">
                    <div class="w-full lg:w-2/3 card card-pad">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5 gap-3">
                            <div>
                                <h2 class="section-title">Matriks Evaluasi</h2>
                                <p class="caption mt-1">Selesaikan materi secara berurutan ke bawah.</p>
                            </div>
                            <div class="flex gap-1.5 rounded-[var(--r-md)] p-1.5 shrink-0" style="background-color: var(--surface-sunken);">
                                <span class="badge badge-neutral" style="background-color:#fff;">Belum: 0</span>
                                <span class="badge badge-warning">Ikut: 1</span>
                                <span class="badge badge-accent">Hafal: 2</span>
                            </div>
                        </div>
                        <div id="assessmentMatrixContainer" class="space-y-4"></div>
                    </div>

                    <div class="w-full lg:w-1/3 card card-pad sticky top-4" style="background-color: var(--accent-soft); border-color: transparent;">
                        <h3 class="section-title" style="color: var(--accent-strong);">Preview Poin</h3>
                        <p class="caption mb-4" style="color: var(--accent-strong);">Skor akan dikalkulasi otomatis.</p>
                        <div id="memorizationPreview" class="space-y-2 mb-6"></div>
                        <button onclick="openUnderstandingStep()" class="btn btn-primary w-full">
                            Lanjut Pemahaman <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="pemahamanView" class="hidden animate-slide-up">
                <div class="flex flex-col lg:flex-row gap-6 items-start">
                    <div class="w-full lg:w-2/3 card card-pad">
                        <div class="flex items-center justify-between mb-5">
                            <div>
                                <h2 class="section-title">Tes Pemahaman Individu</h2>
                                <p class="caption mt-1">Tanyakan soal lalu beri rating untuk tiap siswa.</p>
                            </div>
                            <div class="icon-chip" style="background-color: #f3eafe; color: #8b5cf6;">
                                <i class="fa-solid fa-brain"></i>
                            </div>
                        </div>

                        <div id="understandingCardsContainer"></div>
                    </div>

                    <div class="w-full lg:w-1/3 card card-pad sticky top-4" style="background-color: var(--accent-soft); border-color: transparent;">
                        <h3 class="section-title mb-3" style="color: var(--accent-strong);">Preview Nilai Akhir</h3>
                        <div id="finalScorePreview" class="flex flex-col gap-3 mb-6"></div>
                        <button onclick="submitAssessment()" id="btnSubmitFinalAssessment" class="btn btn-primary w-full text-base">
                            Simpan Evaluasi Sesi
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const pathParts = window.location.pathname.split('/');
    const templateId = pathParts[2];
    const sessionId = pathParts[4];
    let sessionData = null;
    let remainingSeconds = 600;
    let totalSeconds = 600;
    let timerInterval = null;
    let selectedStudents = [];
    let sessionMode = 'setup';
    let hasSessionStarted = false;

    let assessmentScores = {};
    let understandingScores = {};

    // VARIABLE BARU
    let activeUnderstandingStudent = null;
    let testedItems = {};             // Format: { studentId: { itemId: true/false } }
    let activeStudentPerSection = {}; // Format: { sectionIndex: studentId }

    const STORAGE_KEY = `oral_exam_session_${sessionId}`;

    const saveSessionToStorage = () => {
        if (!hasSessionStarted) return;
        const state = {
            remainingSeconds, totalSeconds, hasSessionStarted, sessionMode, selectedStudents,
            assessmentScores, understandingScores, testedItems, activeStudentPerSection,
            activeUnderstandingStudent // Tambahkan ke storage
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    };

    const loadSessionFromStorage = () => {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return false;
        try {
            const state = JSON.parse(saved);
            remainingSeconds = state.remainingSeconds;
            totalSeconds = state.totalSeconds;
            hasSessionStarted = state.hasSessionStarted;
            sessionMode = state.sessionMode;
            selectedStudents = state.selectedStudents;
            assessmentScores = state.assessmentScores;
            understandingScores = state.understandingScores;
            testedItems = state.testedItems || {};
            activeStudentPerSection = state.activeStudentPerSection || {};
            activeUnderstandingStudent = state.activeUnderstandingStudent || null; // Muat dari storage
            return true;
        } catch (e) {
            console.error("Gagal load session storage", e);
            return false;
        }
    };

    const clearSessionStorage = () => {
        localStorage.removeItem(STORAGE_KEY);
    };

    // Fungsi memicu pembatalan/reset ber-konfirmasi
    window.resetSessionWithConfirm = () => {
        if (confirm("Apakah Anda yakin ingin mengulang sesi ini? Semua progres penilaian saat ini di local storage akan dihapus.")) {
            clearInterval(timerInterval);
            clearSessionStorage();
            window.location.reload();
        }
    };

    // ==========================================
    // LOGIKA FLOATING TIMER (Intersection Observer)
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
        const dashboardCard = document.getElementById('sessionDashboardCard');
        const floatWrapper = document.getElementById('floatingTimerWrapper');

        if (dashboardCard && floatWrapper) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    // Munculkan timer kapsul JIKA sesi sudah mulai DAN timer aslinya menghilang dari layar
                    if (!entry.isIntersecting && hasSessionStarted) {
                        floatWrapper.classList.remove('-translate-y-[150%]', 'opacity-0');
                        floatWrapper.classList.add('translate-y-0', 'opacity-100');
                    } else {
                        // Sembunyikan jika timer asli terlihat lagi di layar
                        floatWrapper.classList.add('-translate-y-[150%]', 'opacity-0');
                        floatWrapper.classList.remove('translate-y-0', 'opacity-100');
                    }
                });
            }, { threshold: 0 }); // Threshold 0 = trigger saat 100% menghilang

            observer.observe(dashboardCard);
        }
    });

    // ==========================================
    // SETUP DAN TIMER
    // ==========================================
    window.toggleSlotAccordion = () => {
        if (hasSessionStarted) return;
        const body = document.getElementById('slotAccordionBody');
        const icon = document.getElementById('slotAccordionIcon');
        if (body.classList.contains('hidden')) {
            body.classList.replace('hidden', 'block');
            icon.style.transform = 'rotate(0deg)';
        } else {
            body.classList.replace('block', 'hidden');
            icon.style.transform = 'rotate(180deg)';
        }
    };

    const getInitials = (name = '') => name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '--';
    const formatTime = (seconds) => {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    };

    const startTimer = () => {
        clearInterval(timerInterval);
        const timerHeader = document.getElementById('timerHeader');
        const timerBox = document.getElementById('timerBox');
        const timerBar = document.getElementById('timerBar');

        const floatBg = document.getElementById('floatingTimerBg');
        const floatText = document.getElementById('floatingTimerText');

        timerHeader.className = 'p-5 bg-green-600 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
        floatBg.className = 'bg-green-600 text-white px-5 py-2.5 rounded-full shadow-[0_12px_40px_rgba(79,70,229,0.3)] border-2 border-white/20 flex items-center gap-3 backdrop-blur-md transition-colors duration-500';

        timerInterval = setInterval(() => {
            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                const txt = '00:00';
                timerBox.innerText = txt; floatText.innerText = txt;

                timerHeader.className = 'p-5 bg-red-600 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-red-600 text-white px-5 py-2.5 rounded-full shadow-[0_12px_40px_rgba(79,70,229,0.3)] border-2 border-white/20 flex items-center gap-3 backdrop-blur-md transition-colors duration-500';

                timerBar.className = 'h-full bg-white/50 rounded-full transition-all duration-1000';
                timerBar.style.width = '0%';
                window.showToast?.('warning', 'Waktu Habis', 'Sesi sudah melewati target waktu.');
                return;
            }

            remainingSeconds--;
            saveSessionToStorage();
            const percent = Math.max(0, (remainingSeconds / totalSeconds) * 100);
            const txt = formatTime(remainingSeconds);
            timerBox.innerText = txt; floatText.innerText = txt;
            timerBar.style.width = `${percent}%`;

            if (remainingSeconds <= 60) {
                timerHeader.className = 'p-5 bg-red-500 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-red-500 text-white px-5 py-2.5 rounded-full shadow-lg border-2 border-white/20 flex items-center gap-3 transition-colors duration-500';
                timerBar.className = 'h-full bg-white/70 transition-all duration-1000';
            } else if (remainingSeconds <= 180) {
                timerHeader.className = 'p-5 bg-amber-500 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-amber-500 text-white px-5 py-2.5 rounded-full shadow-lg border-2 border-white/20 flex items-center gap-3 transition-colors duration-500';
                timerBar.className = 'h-full bg-white/70 transition-all duration-1000';
            }
        }, 1000);
    };

    const fetchSession = async () => {
        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal memuat sesi.');
            sessionData = result.data;

            // Deteksi refresh halaman
            const hasCache = loadSessionFromStorage();
            renderSession();

            if (hasCache && hasSessionStarted) {
                executeStartSessionUI();
                renderActiveParticipants();
                startTimer();
                document.getElementById('mainAssessmentSection').classList.remove('hidden'); // UPDATE ID
                renderAssessmentMatrix();
                updatePreviewScores();

                // Hapus kondisi document.getElementById('understandingSection') bawaan yang lama
                if (Object.keys(understandingScores).length > 0) {
                    renderUnderstandingCards();
                    renderFinalScorePreview();
                }
            }
        } catch (error) { window.showToast?.('danger', 'Gagal', error.message); }
    };

    const initAssessmentState = () => {
        selectedStudents.forEach(student => {
            if (!assessmentScores[student.id]) assessmentScores[student.id] = {};
        });

        sessionData.sections.forEach(section => {
            (section.oral_exam_items || []).forEach(item => {
                // Inisialisasi checkbox global
                if (testedItems[item.id] === undefined) testedItems[item.id] = false;

                // Inisialisasi skor siswa
                selectedStudents.forEach(student => {
                    if (assessmentScores[student.id][item.id] === undefined) assessmentScores[student.id][item.id] = 0;
                });
            });
        });
    };

    const executeStartSessionUI = () => {
        document.getElementById('sessionDesc').innerText = `${selectedStudents.length} Peserta Diuji • Target ${Math.floor(totalSeconds / 60)} Menit`;
        document.getElementById('slotAccordionBody').classList.replace('block', 'hidden');
        document.getElementById('btnToggleSlot').classList.add('hidden');
        // document.getElementById('preAssessmentArea').classList.add('hidden');
        document.getElementById('activeSessionBody').classList.replace('hidden', 'block');
        document.getElementById('sessionDashboardCard').classList.replace('border-indigo-500', 'border-green-500');
        document.getElementById('btnResetSession')?.classList.remove('hidden');
    };

    const renderSession = () => {
        const { template, session, sections, students, available_students } = sessionData;
        document.getElementById('btnBackDetail').href = `/ujian-hafalan/${template.id}`;
        document.getElementById('sessionBadge').innerText = `${template.subject} • ${session.session_name || 'Sesi'}`;
        document.getElementById('sessionTitle').innerText = template.title;

        const availableCount = available_students ? available_students.length : 0;

        // FIX: Hanya set durasi default jika sesi belum berjalan agar tidak menimpa data local storage
        if (!hasSessionStarted) {
            totalSeconds = session.target_duration_seconds || 600;
            remainingSeconds = totalSeconds;
        }

        document.getElementById('sessionDesc').innerText = hasSessionStarted
            ? `${selectedStudents.length} Peserta Diuji • Target ${Math.floor(totalSeconds / 60)} Menit`
            : `${availableCount} Siswa Tersedia • Target ${Math.floor(totalSeconds / 60)} Menit`;

        document.getElementById('timerBox').innerText = formatTime(remainingSeconds);

        renderSlots();
    };

    const renderSlots = () => {
        const slotList = document.getElementById('slotList');
        const slotCounterTop = document.getElementById('slotCounterTop');
        const btnStart = document.getElementById('btnOpenStartModal');
        const availableStudents = sessionData.available_students || [];

        if (slotCounterTop) slotCounterTop.innerText = `${selectedStudents.length}/5`;
        if (btnStart) btnStart.disabled = selectedStudents.length === 0;

        const selectedIds = new Set(selectedStudents.map(s => String(s.id)));

        const selectedHtml = `
            <div class="grid grid-cols-5 gap-2 mb-5">
                ${Array.from({ length: 5 }).map((_, index) => {
                    const student = selectedStudents[index];
                    if (!student) {
                        return `<div class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 text-[10px] font-black shadow-inner">Slot ${index + 1}</div>`;
                    }
                    return `
                        <button onclick="removeStudentFromSlot('${student.id}')" class="aspect-square rounded-2xl border-2 border-indigo-200 bg-indigo-50 hover:bg-red-50 hover:border-red-200 hover:text-red-500 group flex flex-col items-center justify-center p-2 active:scale-95 transition-all text-center">
                            <div class="w-8 h-8 rounded-full bg-white text-indigo-600 group-hover:text-red-500 flex items-center justify-center text-[10px] font-black border-2 border-indigo-100 group-hover:border-red-200 mb-1 shadow-sm">${getInitials(student.name)}</div>
                            <p class="text-[8px] font-black text-indigo-800 group-hover:text-red-600 truncate w-full">${student.name}</p>
                        </button>
                    `;
                }).join('')}
            </div>
        `;

        const availableHtml = `
            <div class="grid grid-cols-2 gap-2 max-h-60 overflow-y-auto pr-1">
                ${availableStudents.map(student => {
                    const isSelected = selectedIds.has(String(student.id));
                    const disabled = isSelected || selectedStudents.length >= 5;
                    return `
                        <button onclick="addStudentToSlot('${student.id}')"
                            class="rounded-2xl border-2 p-3 text-left transition-all ${
                                isSelected ? 'bg-indigo-50 border-indigo-200 text-indigo-700' :
                                disabled ? 'bg-slate-50 border-slate-100 text-slate-300 opacity-50' : 'bg-white border-slate-100 text-slate-700 hover:border-indigo-200 active:scale-95 shadow-sm'
                            }" ${disabled ? 'disabled' : ''}>
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 shrink-0 rounded-full bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-[10px] font-black">${getInitials(student.name)}</div>
                                <div class="min-w-0">
                                    <p class="text-[11px] font-black truncate">${student.name}</p>
                                    <p class="text-[9px] font-bold opacity-60 truncate">${student.grade || '-'}</p>
                                </div>
                            </div>
                        </button>
                    `;
                }).join('')}
            </div>
        `;
        slotList.innerHTML = selectedHtml + availableHtml;
    };

    window.addStudentToSlot = (studentId) => {
        if (hasSessionStarted || selectedStudents.length >= 5) return;
        const student = (sessionData.available_students || []).find(s => String(s.id) === String(studentId));
        if (!student || selectedStudents.some(s => String(s.id) === String(studentId))) return;
        selectedStudents.push(student);
        renderSlots();
    };

    window.removeStudentFromSlot = (studentId) => {
        if (hasSessionStarted) return;
        selectedStudents = selectedStudents.filter(s => String(s.id) !== String(studentId));
        renderSlots();
    };

    window.openStartModeModal = () => {
        if (selectedStudents.length === 0) return window.showToast?.('warning', 'Pilih Siswa', 'Masukkan minimal 1 siswa ke slot.');
        document.getElementById('modalStartMode')?.classList.replace('hidden', 'flex');
    };

    window.closeStartModeModal = () => document.getElementById('modalStartMode')?.classList.replace('flex', 'hidden');

    window.startSession = async (mode) => {
        if (selectedStudents.length === 0) return window.showToast?.('warning', 'Pilih Siswa', 'Masukkan minimal 1 siswa ke slot.');

        // Ambil menit kustom dari UI input
        const customMinutes = parseInt(document.getElementById('sessionDurationInput').value) || 10;
        totalSeconds = customMinutes * 60;
        remainingSeconds = totalSeconds;

        sessionMode = mode;
        hasSessionStarted = true;
        window.closeStartModeModal();

        initAssessmentState();
        saveSessionToStorage();
        executeStartSessionUI();

        if (mode === 'simulation') {
            window.showToast?.('info', 'Mode Simulasi', 'Timer berjalan, tapi data penilaian tidak dikirim ke database.');
            renderActiveParticipants();
            startTimer();
            startAssessmentMatrix();
            return;
        }

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}/start`, {
                method: 'POST',
                headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_ids: selectedStudents.map(s => s.id) })
            });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal memulai sesi real.');
            window.showToast?.('success', 'Sesi Real Dimulai', 'Silakan mulai evaluasi.');
            renderActiveParticipants();
            startTimer();
            startAssessmentMatrix();
        } catch (error) {
            console.error(error);
            hasSessionStarted = false;
            sessionMode = 'setup';
            clearSessionStorage();
            window.location.reload();
        }
    };

    const renderActiveParticipants = () => {
        const sessionStudents = document.getElementById('sessionStudents');
        if (!sessionStudents) return;

        sessionStudents.innerHTML = selectedStudents.map(student => `
            <div class="bg-white border-2 border-slate-100 rounded-2xl p-3 text-center shadow-sm min-w-[100px] snap-center shrink-0">
                <div class="w-10 h-10 bg-slate-50 border-2 border-slate-100 text-slate-700 rounded-full flex items-center justify-center font-black text-xs mx-auto mb-2">${getInitials(student.name)}</div>
                <p class="text-[11px] font-black text-slate-800 truncate w-full">${student.name}</p>
            </div>
        `).join('');
    };

    // ==========================================
    // RENDER MATRIKS HORIZONTAL
    // ==========================================
    const startAssessmentMatrix = () => {
        initAssessmentState();
        document.getElementById('mainAssessmentSection').classList.remove('hidden'); // UPDATE ID
        renderAssessmentMatrix();
        updatePreviewScores();
    };

    // Helper untuk menyingkat teks materi otomatis (DI-UPDATE: Paksa cek kata kunci duluan)
    const getShortName = (item) => {
        // Gabungkan title dan short_label agar pengecekan kebal terhadap struktur DB Anda
        const text = ((item.title || '') + ' ' + (item.short_label || '')).toLowerCase();

        // Tajwid - Nun Mati & Tanwin
        if (text.includes('idzhar halqi')) return 'IDZ';
        if (text.includes('idgham bighunnah')) return 'IDG BG';
        if (text.includes('idgham bilaghunnah')) return 'IDG BLG';
        if (text.includes('iqlab')) return 'IQ';
        if (text.includes('ikhfa haqiqi') || (text.includes('ikhfa') && !text.includes('syafawi'))) return 'IKH';

        // Tajwid - Mim Mati
        if (text.includes('ikhfa syafawi')) return 'IKH SYF';
        if (text.includes('idgham mimi') || text.includes('mutamatsilain')) return 'IDG MM';
        if (text.includes('idzhar syafawi')) return 'IDZ SYF';

        // Alif Lam
        if (text.includes('syamsiyah')) return 'SYAM';
        if (text.includes('qomariyah')) return 'QOM';

        // Mad
        if (text.includes('thobi') || text.includes('thabi')) return 'M THOB';
        if (text.includes('aridh')) return 'M ARIDH';
        if (text.includes('lin') || text.includes('layyin')) return 'M LIN';
        if (text.includes('muttashil')) return 'WJB';
        if (text.includes('munfashil')) return 'JAIZ';

        // Fallback jika tidak ada di daftar atas
        let fallback = (item.short_label || item.title || '').toUpperCase();
        if (fallback.length > 15) {
            const words = fallback.split(' ');
            if (words.length >= 2) return words[0].substring(0, 3) + ' ' + words[1].substring(0, 3);
        }
        return fallback;
    };

    // Fungsi render khusus Checkbox Toggle Global (DI-UPDATE FLEX LAYOUT)
    const renderGlobalCheckboxesHtml = (secIdx) => {
        const section = sessionData.sections[secIdx];
        const items = section.oral_exam_items || [];
        const maxAllowed = section.min_required || items.length;

        // Hitung berapa materi yang sudah di-ceklis di bab ini
        const checkedCount = items.filter(item => testedItems[item.id]).length;
        const isMaxReached = checkedCount >= maxAllowed;

        return items.map(item => {
            const isChecked = testedItems[item.id];
            // Disable JIKA batas max sudah tercapai DAN item ini kebetulan sedang tidak di-ceklis
            const isDisabled = !isChecked && isMaxReached;

            return `
                <label class="relative inline-flex flex-none ${isDisabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer'}" title="${isDisabled ? `Maksimal ${maxAllowed} materi tercapai` : ''}">
                    <input type="checkbox" onchange="toggleGlobalTestedItem('${item.id}', ${secIdx})" ${isChecked ? 'checked' : ''} ${isDisabled ? 'disabled' : ''} class="peer sr-only" />

                    <div class="px-3 py-2 rounded-xl border-2 text-[10px] font-black transition-all select-none whitespace-nowrap w-max flex items-center justify-center
                        border-slate-200 bg-white text-slate-400
                        ${!isDisabled ? 'hover:border-indigo-200 hover:text-indigo-500' : ''}
                        peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 peer-checked:shadow-sm">
                        ${getShortName(item)}
                    </div>
                </label>
            `;
        }).join('');
    };


    const renderAssessmentMatrix = () => {
        const container = document.getElementById('assessmentMatrixContainer');
        container.innerHTML = sessionData.sections.map((section, secIdx) => {
            const items = section.oral_exam_items || [];
            if(items.length === 0) return '';

            const isFirst = secIdx === 0;
