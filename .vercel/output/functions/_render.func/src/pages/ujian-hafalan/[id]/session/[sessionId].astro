    @keyframes slideUp { 0% { transform: translateY(30px) scale(0.95); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
    #sessionStudents::-webkit-scrollbar { display: none; }
    #sessionStudents { -ms-overflow-style: none; scrollbar-width: none; }
    @keyframes pulse-once {
        0% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    .animate-pulse-once { animation: pulse-once 0.5s ease; }

    /* Efek transisi halus */
    .fade-in-content {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
