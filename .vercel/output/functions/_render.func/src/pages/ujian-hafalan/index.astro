---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Ujian Hafalan - yukNgaji">
    <div class="px-6 py-8 min-h-screen">
        <header class="flex items-center gap-3 mb-6">
            <a href="/exams" class="btn-icon flex-shrink-0" aria-label="Kembali">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div class="min-w-0">
                <p class="eyebrow">Evaluasi Lisan</p>
                <h1 class="page-title">Ujian Hafalan</h1>
            </div>
        </header>

        <main id="oralExamList" class="space-y-4">
            <div class="text-center py-10">
                <i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i>
            </div>
        </main>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');

    const SUBJECT_STYLE = {
        tajwid: { icon: 'fa-book-quran',        badge: 'TAJWID', chipBg: 'var(--accent-soft)', chipText: 'var(--accent-strong)' },
        fiqih:  { icon: 'fa-person-praying',    badge: 'FIQIH',  chipBg: 'var(--info-soft)',   chipText: 'var(--info)' },
        tauhid: { icon: 'fa-star-and-crescent', badge: 'TAUHID', chipBg: '#f3eafe',            chipText: '#8b5cf6' },
    };

    const fetchOralExams = async () => {
        const container = document.getElementById('oralExamList');

        try {
            const res = await fetch(`${API_URL}/api/oral-exams`, {
                headers: { Authorization: `Bearer ${token}` }
            });

            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal memuat ujian hafalan.');
            }

            const subjectOrder = ['tajwid', 'fiqih', 'tauhid'];

            const data = (result.data || []).sort((a, b) => {
                return subjectOrder.indexOf(a.subject) - subjectOrder.indexOf(b.subject);
            });

            if (data.length === 0) {
                container.innerHTML = `
                    <div class="empty-state card">
                        <div class="empty-icon text-2xl">📖</div>
                        <p class="caption font-semibold">Belum ada template ujian hafalan.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = data.map(item => {
                const style = SUBJECT_STYLE[item.subject] || SUBJECT_STYLE.tajwid;

                return `
                    <div class="card card-pad">
                        <div class="flex items-start gap-4">
                            <div class="icon-chip" style="width:3.5rem;height:3.5rem;font-size:1.5rem;background-color:${style.chipBg};color:${style.chipText};">
                                <i class="fa-solid ${style.icon}"></i>
                            </div>

                            <div class="flex-1 min-w-0">
                                <p class="eyebrow" style="color:${style.chipText};">${style.badge}</p>
                                <h2 class="section-title mt-0.5">${item.title}</h2>
                                <p class="caption mt-1 leading-relaxed">${item.description || 'Evaluasi hafalan dan pemahaman siswa.'}</p>

                                <div class="grid grid-cols-2 gap-2 mt-4">
                                    <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--surface-sunken);">
                                        <p class="eyebrow">Per Sesi</p>
                                        <p class="text-sm font-bold text-ink mt-0.5">${item.max_students_per_session || 5} Siswa</p>
                                    </div>
                                    <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--surface-sunken);">
                                        <p class="eyebrow">Durasi</p>
                                        <p class="text-sm font-bold text-ink mt-0.5">${item.target_session_minutes || 10} Menit</p>
                                    </div>
                                </div>

                                <a href="/ujian-hafalan/${item.id}" class="btn btn-primary w-full mt-4 text-sm">
                                    Buka Evaluasi <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (error) {
            console.error(error);
            container.innerHTML = `
                <div class="empty-state card" style="border-color: var(--danger-soft);">
                    <div class="empty-icon" style="background-color: var(--danger-soft); color: var(--danger);"><i class="fa-solid fa-triangle-exclamation text-2xl"></i></div>
                    <p class="caption font-semibold" style="color: var(--danger);">${error.message}</p>
                </div>
            `;
        }
    };

    fetchOralExams();
</script>
