---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Hafalan Anak - yukNgaji">
    <div class="px-5 py-7 pb-32 min-h-screen flex flex-col">

        <!-- HEADER -->
        <header class="flex items-center gap-3 mb-6">
            <a href="/dashboard" class="btn-icon flex-shrink-0" aria-label="Kembali">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div class="min-w-0">
                <p class="eyebrow">Pantau Setoran Anak</p>
                <h1 class="page-title">Hafalan</h1>
            </div>
        </header>

        <!-- HIGHLIGHT (tertinggi & terbawah) -->
        <div id="performaHighlight" class="hidden mb-6 grid-cols-2 gap-3 animate-slide-up">
            <div class="card card-interactive card-pad" style="background-color: var(--accent-soft); border-color: transparent;" id="cardHigh">
                <p class="eyebrow mb-2" style="color: var(--accent-strong);">Tertinggi 🚀</p>
                <div class="flex items-center gap-3">
                    <div id="highAvatar" class="avatar w-10 h-10 text-xs flex-shrink-0"></div>
                    <div class="min-w-0">
                        <h4 id="highName" class="caption font-semibold text-ink truncate capitalize">--</h4>
                        <p id="highSurah" class="text-[10px] font-medium truncate" style="color: var(--accent-strong);">--</p>
                    </div>
                </div>
            </div>
            <div class="card card-interactive card-pad" style="background-color: var(--warning-soft); border-color: transparent;" id="cardLow">
                <p class="eyebrow mb-2" style="color: var(--warning);">Paling Bawah 🌱</p>
                <div class="flex items-center gap-3">
                    <div id="lowAvatar" class="avatar w-10 h-10 text-xs flex-shrink-0" style="background-color:#fff; color: var(--warning);"></div>
                    <div class="min-w-0">
                        <h4 id="lowName" class="caption font-semibold text-ink truncate capitalize">--</h4>
                        <p id="lowSurah" class="text-[10px] font-medium truncate" style="color: var(--warning);">--</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEARCH -->
        <div class="relative mb-5">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-tertiary text-sm pointer-events-none"></i>
            <input type="text" id="searchInput" class="field field-search" placeholder="Cari nama Anak...">
        </div>

        <!-- LIST -->
        <section id="mainContent" class="flex flex-col gap-2.5">
            <div class="skeleton card h-20"></div>
            <div class="skeleton card h-20"></div>
            <div class="skeleton card h-20"></div>
        </section>

    </div>

    <!-- MODAL SETOR HAFALAN -->
    <div id="modalSetorHafalan" class="modal-overlay hidden" style="z-index: 80;">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-4">
                <div class="min-w-0">
                    <h3 class="section-title">Setor Hafalan</h3>
                    <p id="setorStudentName" class="caption mt-0.5 truncate">--</p>
                </div>
                <button onclick="closeSetorModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div id="setorInfo" class="rounded-[var(--r-md)] p-3 mb-3 caption font-semibold text-center" style="background-color: var(--accent-soft); color: var(--accent-strong);"></div>
            <p id="setorWarning" class="hidden text-center caption font-semibold mb-3 rounded-[var(--r-md)] p-2" style="background-color: var(--warning-soft); color: var(--warning);"></p>

            <div class="seg mb-3">
                <button id="setorTabMaju" onclick="setSetorMode('maju')" class="seg-btn is-active">▲ Setor Maju</button>
                <button id="setorTabMundur" onclick="setSetorMode('mundur')" class="seg-btn">▼ Koreksi Mundur</button>
            </div>

            <div id="setorSectionMaju">
                <p class="field-label">Tambah berapa ayat?</p>
                <div id="setorGridMaju" class="grid grid-cols-4 gap-2 mb-4"></div>
            </div>
            <div id="setorSectionMundur" class="hidden">
                <p class="field-label" style="color: var(--danger);">Mundur berapa ayat?</p>
                <div id="setorGridMundur" class="grid grid-cols-4 gap-2 mb-4"></div>
                <p class="text-[10px] text-tertiary text-center mb-2">Jika mundur melewati batas surat, sistem otomatis pindah ke surat sebelumnya.</p>
            </div>

            <button onclick="closeSetorModal()" class="btn btn-soft w-full">Tutup</button>
        </div>
    </div>

    <NavbarGuru activeMenu="hafalan" />
    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    if (!token) window.location.replace('/');

    const JUZ_AMMA = [
        { id: 1,  name: "An-Nas",       ayahs: 6  }, { id: 2,  name: "Al-Falaq",     ayahs: 5  },
        { id: 3,  name: "Al-Ikhlas",    ayahs: 4  }, { id: 4,  name: "Al-Masad",     ayahs: 5  },
        { id: 5,  name: "An-Nasr",      ayahs: 3  }, { id: 6,  name: "Al-Kafirun",   ayahs: 6  },
        { id: 7,  name: "Al-Kausar",    ayahs: 3  }, { id: 8,  name: "Al-Ma'un",     ayahs: 7  },
        { id: 9,  name: "Quraisy",      ayahs: 4  }, { id: 10, name: "Al-Fil",       ayahs: 5  },
        { id: 11, name: "Al-Humazah",   ayahs: 9  }, { id: 12, name: "Al-'Asr",      ayahs: 3  },
        { id: 13, name: "At-Takasur",   ayahs: 8  }, { id: 14, name: "Al-Qari'ah",   ayahs: 11 },
        { id: 15, name: "Al-'Adiyat",   ayahs: 11 }, { id: 16, name: "Az-Zalzalah",  ayahs: 8  },
        { id: 17, name: "Al-Bayyinah",  ayahs: 8  }, { id: 18, name: "Al-Qadr",      ayahs: 5  },
        { id: 19, name: "Al-'Alaq",     ayahs: 19 }, { id: 20, name: "At-Tin",       ayahs: 8  },
        { id: 21, name: "Al-Insyirah",  ayahs: 8  }, { id: 22, name: "Ad-Duha",      ayahs: 11 },
        { id: 23, name: "Al-Lail",      ayahs: 21 }, { id: 24, name: "Asy-Syams",    ayahs: 15 },
        { id: 25, name: "Al-Balad",     ayahs: 20 }, { id: 26, name: "Al-Fajr",      ayahs: 30 },
        { id: 27, name: "Al-Gasyiyah",  ayahs: 26 }, { id: 28, name: "Al-A'la",      ayahs: 19 },
        { id: 29, name: "At-Tariq",     ayahs: 17 }, { id: 30, name: "Al-Buruj",     ayahs: 22 },
        { id: 31, name: "Al-Insyiqaq",  ayahs: 25 }, { id: 32, name: "Al-Mutaffifin",ayahs: 36 },
        { id: 33, name: "Al-Infitar",   ayahs: 19 }, { id: 34, name: "At-Takwir",    ayahs: 29 },
        { id: 35, name: "Abasa",        ayahs: 42 }, { id: 36, name: "An-Nazi'at",   ayahs: 46 },
        { id: 37, name: "An-Naba'",     ayahs: 40 }
    ];
    const TOTAL_AYAHS = JUZ_AMMA.reduce((a, s) => a + s.ayahs, 0);

    let allStudents = [];
    let searchQuery = '';

    const fetchStudents = async () => {
        const res = await fetch(`${API_URL}/api/students`, { headers: { 'Authorization': `Bearer ${token}` } });
        const result = await res.json();
        if (res.ok) return result.data;
        throw new Error(result.message);
    };

    const getOverallProgress = (student) => {
        if (!student.current_surah_id) return 0;
        let sum = 0;
        for (const s of JUZ_AMMA) { if (s.id < student.current_surah_id) sum += s.ayahs; }
        sum += student.current_ayah || 0;
        return Math.min(100, Math.round((sum / TOTAL_AYAHS) * 100));
    };

    const renderCards = () => {
        const container = document.getElementById('mainContent');
        const filtered = allStudents.filter(s => s.name.toLowerCase().includes(searchQuery.toLowerCase()));

        if (filtered.length === 0) {
            container.innerHTML = `
                <div class="empty-state card">
                    <div class="empty-icon"><i class="fa-solid fa-users-slash text-2xl"></i></div>
                    <p class="caption font-semibold">Tidak ditemukan</p>
                    <p class="text-[11px] text-tertiary mt-1">Coba kata kunci lain.</p>
                </div>`;
            return;
        }

        container.innerHTML = filtered.map((s, idx) => {
            const surah = s.current_surah_id ? JUZ_AMMA.find(x => x.id === s.current_surah_id) : null;
            const surahText = surah ? `${surah.name} · Ayat ${s.current_ayah}/${surah.ayahs}` : 'Belum mulai hafalan';
            const pct = getOverallProgress(s);
            return `
                <div onclick="window.location.href='/hafalan/detail?id=${s.id}'" class="card card-interactive card-pad !p-3.5 cursor-pointer" style="animation: fadeUp 0.2s ease both; animation-delay: ${idx * 25}ms">
                    <div class="flex items-center gap-3">
                        <div class="avatar w-12 h-12 text-sm flex-shrink-0">${s.name.substring(0, 2).toUpperCase()}</div>
                        <div class="flex-1 min-w-0">
                            <h3 class="section-title capitalize truncate">${s.name}</h3>
                            <p class="caption mt-0.5 truncate">${surahText}</p>
                        </div>
                        <button onclick="openSetorModal('${s.id}', event)" class="btn-icon !w-10 !h-10 flex-shrink-0" style="background-color: var(--accent-soft); border-color: transparent; color: var(--accent-strong);" title="Setor hafalan" aria-label="Setor hafalan">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                    <div class="mt-3 pt-3 border-t" style="border-color: var(--divider);">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-[10px] font-medium text-tertiary">Progres Juz Amma</span>
                            <span class="text-[10px] font-bold" style="color: var(--accent-strong);">${pct}%</span>
                        </div>
                        <div class="w-full h-1.5 rounded-full overflow-hidden" style="background-color: var(--surface-sunken);">
                            <div class="h-full rounded-full transition-all" style="width: ${pct}%; background-color: var(--accent);"></div>
                        </div>
                    </div>
                </div>`;
        }).join('');
    };

    // ===== Highlight tertinggi & terbawah =====
    const updateHighlights = () => {
        const wrap = document.getElementById('performaHighlight');
        const valid = allStudents.filter(s => {
            const n = s.name.toLowerCase();
            return s.current_surah_id !== null && s.current_surah_id !== undefined && !n.includes('john doe') && !n.includes('xaviera');
        });
        if (valid.length === 0) { wrap.classList.add('hidden'); wrap.classList.remove('grid'); return; }

        valid.sort((a, b) => (b.current_surah_id - a.current_surah_id) || (b.current_ayah - a.current_ayah));
        const high = valid[0], low = valid[valid.length - 1];
        const surahName = (id) => JUZ_AMMA.find(s => s.id === id)?.name || '-';

        document.getElementById('highAvatar').innerText = high.name.substring(0, 2).toUpperCase();
        document.getElementById('highName').innerText = high.name.split(' ')[0];
        document.getElementById('highSurah').innerText = `${surahName(high.current_surah_id)} · Ayat ${high.current_ayah}`;
        document.getElementById('cardHigh').onclick = () => window.location.href = `/hafalan/detail?id=${high.id}`;

        document.getElementById('lowAvatar').innerText = low.name.substring(0, 2).toUpperCase();
        document.getElementById('lowName').innerText = low.name.split(' ')[0];
        document.getElementById('lowSurah').innerText = `${surahName(low.current_surah_id)} · Ayat ${low.current_ayah}`;
        document.getElementById('cardLow').onclick = () => window.location.href = `/hafalan/detail?id=${low.id}`;

        wrap.classList.remove('hidden'); wrap.classList.add('grid');
    };

    // ===== Modal Setor Hafalan =====
    let setorStudentId = null;

    window.openSetorModal = (id, ev) => {
        if (ev) ev.stopPropagation();
        const s = allStudents.find(x => String(x.id) === String(id));
        if (!s) return;
        setorStudentId = s.id;
        document.getElementById('setorStudentName').textContent = s.name;

        const surahId = s.current_surah_id || 1;
        const ayah = s.current_surah_id ? (s.current_ayah || 0) : 0;
        const surah = JUZ_AMMA.find(x => x.id === surahId);
        const sisa = surah ? surah.ayahs - ayah : 0;

        const info = document.getElementById('setorInfo');
        info.textContent = s.current_surah_id ? `Sekarang di ${surah.name} — Ayat ${ayah}/${surah.ayahs}` : 'Belum mulai — setoran pertama dari An-Nas';

        const warn = document.getElementById('setorWarning');
        if (s.current_surah_id && sisa <= 3 && sisa > 0) { warn.textContent = `⚡ ${surah.name} sisa ${sisa} ayat lagi tamat!`; warn.classList.remove('hidden'); }
        else warn.classList.add('hidden');

        const OPTS = [1, 2, 3, 5, 7, 10];
        const gridMaju = document.getElementById('setorGridMaju');
        gridMaju.innerHTML = OPTS.map(n => {
            const disabled = s.current_surah_id && n > sisa;
            return `<button onclick="setorHafalanIndex(${n})" ${disabled ? 'disabled' : ''} class="py-3 rounded-[var(--r-md)] font-bold text-sm transition-all active:scale-95 ${disabled ? 'opacity-40 cursor-not-allowed' : ''}" style="background-color: var(--accent-soft); color: var(--accent-strong);">+${n}</button>`;
        }).join('');
        if (s.current_surah_id && sisa > 0 && !OPTS.includes(sisa)) {
            gridMaju.innerHTML += `<button onclick="setorHafalanIndex(${sisa})" class="col-span-4 py-3 rounded-[var(--r-md)] font-bold text-sm active:scale-95" style="background-color: var(--warning-soft); color: var(--warning);">🏁 Tamatkan sisa ${sisa} ayat</button>`;
        }
        const gridMundur = document.getElementById('setorGridMundur');
        gridMundur.innerHTML = OPTS.map(n => `<button onclick="setorHafalanIndex(${-n})" class="py-3 rounded-[var(--r-md)] font-bold text-sm active:scale-95" style="background-color: var(--danger-soft); color: var(--danger);">−${n}</button>`).join('');

        setSetorMode('maju');
        document.getElementById('modalSetorHafalan').classList.remove('hidden');
    };
    window.closeSetorModal = () => document.getElementById('modalSetorHafalan').classList.add('hidden');
    window.setSetorMode = (mode) => {
        const isMaju = mode === 'maju';
        document.getElementById('setorTabMaju').className = isMaju ? 'seg-btn is-active' : 'seg-btn';
        document.getElementById('setorTabMundur').className = !isMaju ? 'seg-btn is-active' : 'seg-btn';
        document.getElementById('setorSectionMaju').classList.toggle('hidden', !isMaju);
        document.getElementById('setorSectionMundur').classList.toggle('hidden', isMaju);
    };
    window.setorHafalanIndex = async (jumlah) => {
        if (!setorStudentId) return;
        try {
            const res = await fetch(`${API_URL}/api/students/${setorStudentId}/memorization`, {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: setorStudentId, added_ayahs: jumlah })
            });
            const result = await res.json();
            if (!res.ok) throw new Error(result.message || 'Gagal');
            const s = allStudents.find(x => String(x.id) === String(setorStudentId));
            if (s) { s.current_surah_id = result.data.current_surah_id; s.current_ayah = result.data.current_ayah; }
            let msg;
            if (result.data.promoted) msg = result.data.next_surah === 'KHATAM JUZ AMMA 🎉' ? 'MASYA ALLAH! JUZ AMMA KHATAM! 🎉' : `Tamat ${result.data.prev_surah}! Lanjut → ${result.data.next_surah} 🎉`;
            else if (result.data.demoted) msg = `Dikoreksi mundur ke ${result.data.next_surah}, ayat ${result.data.current_ayah}.`;
            else msg = jumlah > 0 ? `+${jumlah} ayat tercatat! 💪` : `Koreksi −${Math.abs(jumlah)} ayat tersimpan.`;
            window.showToast?.('success', jumlah > 0 ? 'Hafalan Dicatat' : 'Koreksi Disimpan', msg);
            closeSetorModal();
            renderCards();
            updateHighlights();
        } catch (err) { window.showToast?.('danger', 'Error', err.message || 'Gagal mencatat hafalan.'); }
    };

    // ===== Search =====
    let searchTimer;
    document.getElementById('searchInput').addEventListener('input', e => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => { searchQuery = e.target.value; renderCards(); }, 180);
    });

    // ===== Init =====
    const loadData = async () => {
        try {
            allStudents = await fetchStudents();
            renderCards();
            updateHighlights();
        } catch (err) {
            document.getElementById('mainContent').innerHTML = `
                <div class="empty-state card" style="border-color: var(--danger-soft);">
                    <div class="empty-icon" style="background-color: var(--danger-soft); color: var(--danger);"><i class="fa-solid fa-triangle-exclamation text-2xl"></i></div>
                    <p class="caption font-semibold" style="color: var(--danger);">Gagal memuat data</p>
                    <p class="text-[11px] text-tertiary mt-1">${err.message}</p>
                </div>`;
        }
    };

    loadData();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>
