---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Detail Hafalan - yukNgaji">
    <div class="px-5 py-7 pb-32 min-h-screen flex flex-col gap-5">

        <!-- Header -->
        <header class="flex items-center gap-3">
            <a href="/hafalan" class="btn-icon flex-shrink-0" aria-label="Kembali">
                <i class="fa-solid fa-chevron-left text-sm"></i>
            </a>
            <div class="min-w-0">
                <p class="eyebrow">Profil &amp; Riwayat</p>
                <h1 class="page-title">Detail Hafalan</h1>
            </div>
        </header>

        <!-- Info Siswa -->
        <section id="studentInfo" class="animate-slide-up">
            <div class="card card-pad flex items-center gap-4">
                <div class="avatar w-14 h-14 text-xl" id="studentInitials">--</div>
                <div class="flex-1 min-w-0">
                    <h2 class="section-title capitalize truncate" id="studentName">Memuat...</h2>
                    <p class="eyebrow mt-0.5" id="studentGrade">--</p>
                </div>
                <div class="text-right flex-shrink-0">
                    <p class="eyebrow">Total Hafal</p>
                    <p class="text-base font-bold mt-0.5" style="color: var(--accent-strong);" id="totalAyahs">-- Ayat</p>
                </div>
            </div>
        </section>

        <!-- Posisi Saat Ini -->
        <section class="animate-slide-up" style="animation-delay: 0.08s">
            <div class="card card-pad" style="background-color: var(--accent-soft); border-color: transparent;">
                <p class="eyebrow mb-1.5" style="color: var(--accent-strong);"><i class="fa-solid fa-book-open mr-1"></i> Posisi Saat Ini</p>
                <h2 class="display-title" style="color: var(--accent-strong);" id="currentSurah">--</h2>
                <p class="caption font-semibold mt-0.5" style="color: var(--accent-strong);" id="currentAyah">Ayat --</p>

                <div class="mt-4">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="eyebrow" style="color: var(--accent-strong);">Progres Juz Amma</span>
                        <span class="caption font-bold" style="color: var(--accent-strong);" id="overallPct">0%</span>
                    </div>
                    <div class="w-full h-2 rounded-full overflow-hidden" style="background-color: rgba(255,255,255,0.55);">
                        <div id="overallBar" class="h-full rounded-full transition-all duration-500" style="width:0%; background-color: var(--accent);"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Riwayat Setoran -->
        <section class="flex-1 animate-slide-up" style="animation-delay: 0.16s">
            <div class="flex items-center justify-between mb-3">
                <h3 class="section-title">Riwayat Setoran</h3>
                <span class="caption" id="logCount"></span>
            </div>

            <div id="logsContainer" class="space-y-2.5">
                <div class="text-center py-10">
                    <i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i>
                    <p class="caption font-semibold mt-3">Memuat riwayat...</p>
                </div>
            </div>
        </section>

    </div>

    <NavbarGuru activeMenu="hafalan" />
    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    if (!token) window.location.replace('/');

    const urlParams = new URLSearchParams(window.location.search);
    const studentId = urlParams.get('id');
    if (!studentId) window.location.replace('/hafalan');

    const JUZ_AMMA = [
        { id: 1,  name: "An-Nas",       ayahs: 6  }, { id: 2,  name: "Al-Falaq",     ayahs: 5  },
        { id: 3,  name: "Al-Ikhlas",    ayahs: 4  }, { id: 4,  name: "Al-Masad",     ayahs: 5  },
        { id: 5,  name: "An-Nasr",      ayahs: 3  }, { id: 6,  name: "Al-Kafirun",   ayahs: 6  },
        { id: 7,  name: "Al-Kausar",    ayahs: 3  }, { id: 8,  name: "Al-Ma'un",     ayahs: 7  },
        { id: 9,  name: "Quraisy",      ayahs: 4  }, { id: 10, name: "Al-Fil",       ayahs: 5  },
        { id: 11, name: "Al-Humazah",   ayahs: 9  }, { id: 12, name: "Al-'Asr",      ayahs: 3  },
        { id: 13, name: "At-Takasur",   ayahs: 8  }, { id: 14, name: "Al-Qari'ah",   ayahs: 11 },
        { id: 15, name: "Al-'Adiyat",   ayahs: 11 }, { id: 16, name: "Az-Zalzalah",  ayahs: 8  },
        { id: 17, name: "Al-Bayyinah",  ayahs: 8  }, { id: 18, name: "Al-Qadr",      ayahs: 5  },
        { id: 19, name: "Al-'Alaq",     ayahs: 19 }, { id: 20, name: "At-Tin",       ayahs: 8  },
        { id: 21, name: "Al-Insyirah",  ayahs: 8  }, { id: 22, name: "Ad-Duha",      ayahs: 11 },
        { id: 23, name: "Al-Lail",      ayahs: 21 }, { id: 24, name: "Asy-Syams",    ayahs: 15 },
        { id: 25, name: "Al-Balad",     ayahs: 20 }, { id: 26, name: "Al-Fajr",      ayahs: 30 },
        { id: 27, name: "Al-Gasyiyah",  ayahs: 26 }, { id: 28, name: "Al-A'la",      ayahs: 19 },
        { id: 29, name: "At-Tariq",     ayahs: 17 }, { id: 30, name: "Al-Buruj",     ayahs: 22 },
        { id: 31, name: "Al-Insyiqaq",  ayahs: 25 }, { id: 32, name: "Al-Mutaffifin",ayahs: 36 },
        { id: 33, name: "Al-Infitar",   ayahs: 19 }, { id: 34, name: "At-Takwir",    ayahs: 29 },
        { id: 35, name: "Abasa",        ayahs: 42 }, { id: 36, name: "An-Nazi'at",   ayahs: 46 },
        { id: 37, name: "An-Naba'",     ayahs: 40 }
    ];
    const TOTAL_AYAHS = JUZ_AMMA.reduce((a, s) => a + s.ayahs, 0);

    const cumulativeAyahs = (surahId, ayah) => {
        if (!surahId) return 0;
        let sum = 0;
        for (const s of JUZ_AMMA) { if (s.id < surahId) sum += s.ayahs; }
        return sum + (ayah || 0);
    };

    const renderLogs = (logs) => {
        const container = document.getElementById('logsContainer');
        document.getElementById('logCount').textContent = `${logs.length} entri`;

        if (!logs || logs.length === 0) {
            container.innerHTML = `
                <div class="empty-state card">
                    <div class="empty-icon"><i class="fa-solid fa-clock-rotate-left text-2xl"></i></div>
                    <p class="caption font-semibold">Belum ada riwayat setoran.</p>
                </div>`;
            return;
        }

        container.innerHTML = logs.map((log, idx) => {
            const dateStr = new Date(log.date).toLocaleDateString('id-ID', { weekday: 'long', day: '2-digit', month: 'short', year: 'numeric' });
            const isAdd = log.added_ayahs > 0;
            const icon = isAdd ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
            const tone = isAdd ? 'var(--accent-strong)' : 'var(--warning)';
            const soft = isAdd ? 'var(--accent-soft)' : 'var(--warning-soft)';
            const sign = isAdd ? '+' : '';
            return `
                <div class="card card-pad !p-3.5 flex items-center gap-3" style="animation:fadeIn 0.25s ease both;animation-delay:${idx * 0.03}s">
                    <div class="icon-chip-sm" style="background-color:${soft}; color:${tone};"><i class="fa-solid ${icon}"></i></div>
                    <div class="flex-1 min-w-0">
                        <h4 class="caption font-semibold text-ink leading-tight">${log.surah_name}</h4>
                        <p class="text-[10px] text-tertiary font-medium mt-0.5">Ayat ${log.start_ayah} — ${log.end_ayah}</p>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="caption font-bold" style="color:${tone};">${sign}${log.added_ayahs} Ayat</p>
                        <p class="text-[10px] text-tertiary font-medium mt-0.5">${dateStr}</p>
                    </div>
                </div>`;
        }).join('');
    };

    const init = async () => {
        try {
            const [stdRes, logsRes] = await Promise.all([
                fetch(`${API_URL}/api/students/${studentId}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                fetch(`${API_URL}/api/students/${studentId}/memorization-logs`, { headers: { 'Authorization': `Bearer ${token}` } })
            ]);
            if (!stdRes.ok) throw new Error('Gagal mengambil data santri');
            if (!logsRes.ok) throw new Error('Gagal mengambil riwayat');

            const student = (await stdRes.json()).data;
            const logs = (await logsRes.json()).data || [];

            document.getElementById('studentName').innerText = student.name;
            document.getElementById('studentInitials').innerText = student.name.substring(0, 2).toUpperCase();
            document.getElementById('studentGrade').innerText = student.grade;

            const cum = cumulativeAyahs(student.current_surah_id, student.current_ayah);
            document.getElementById('totalAyahs').innerText = `${cum} Ayat`;

            if (student.current_surah_id) {
                const surah = JUZ_AMMA.find(s => s.id === student.current_surah_id);
                document.getElementById('currentSurah').innerText = surah ? surah.name : 'Unknown';
                document.getElementById('currentAyah').innerText = `Ayat ${student.current_ayah} / ${surah?.ayahs ?? '--'}`;
            } else {
                document.getElementById('currentSurah').innerText = 'Belum Mulai';
                document.getElementById('currentAyah').innerText = 'Belum ada setoran';
            }

            const pct = Math.min(100, Math.round((cum / TOTAL_AYAHS) * 100));
            document.getElementById('overallPct').innerText = `${pct}%`;
            setTimeout(() => { document.getElementById('overallBar').style.width = `${pct}%`; }, 100);

            renderLogs(logs);
        } catch (err) {
            console.error(err);
            document.getElementById('logsContainer').innerHTML = `
                <div class="empty-state card" style="border-color: var(--danger-soft);">
                    <div class="empty-icon" style="background-color: var(--danger-soft); color: var(--danger);"><i class="fa-solid fa-triangle-exclamation text-2xl"></i></div>
                    <p class="caption font-semibold" style="color: var(--danger);">${err.message}</p>
                </div>`;
            window.showToast?.('danger', 'Error', err.message);
        }
    };

    init();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
    @keyframes slideUp { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>
