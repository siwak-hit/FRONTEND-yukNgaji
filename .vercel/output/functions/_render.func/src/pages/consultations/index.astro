---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Sesi Belajar - yukNgaji">
    <div class="px-6 py-8 pb-32 min-h-screen">
        
        <header class="mb-6">
            <p class="eyebrow mb-1">Tugas Rumah (PR)</p>
            <h1 class="page-title">Pusat PR</h1>
        </header>

        <div id="examPortalBanner" class="card card-pad mb-8 relative flex items-center justify-between transition-all duration-300">
            <div class="relative z-10 flex items-center gap-4">
                <div class="icon-chip" style="background-color: var(--surface-sunken); color: var(--ink-tertiary);">
                    <i class="fa-solid fa-spinner fa-spin text-lg"></i>
                </div>
                <div>
                    <h2 class="section-title mb-0.5 text-secondary">Portal Ujian Siswa</h2>
                    <p class="text-[11px] font-medium text-tertiary">Mengecek ketersediaan ujian...</p>
                </div>
            </div>
        </div>

        <!-- [GURU] Panel permintaan perpanjangan waktu PR (dispensasi) -->
        <section id="extReqPanel" class="hidden mb-8 animate-slide-up"></section>

        <section id="subjectSection" class="mb-8">
            <h3 class="eyebrow mb-4">1. Pilih Mata Pelajaran</h3>
            <div class="grid grid-cols-3 gap-3">
                {['tajwid', 'fiqih', 'tauhid'].map((subject) => (
                    <button class="subject-btn card card-interactive p-4 flex flex-col items-center gap-2.5" data-value={subject}>
                        <div class={`icon-chip ${subject === 'tajwid' ? 'bg-green-50 text-green-600' : subject === 'fiqih' ? 'bg-blue-50 text-blue-600' : 'bg-purple-50 text-purple-600'}`}>
                            <i class={`fa-solid ${subject === 'tajwid' ? 'fa-book-quran' : subject === 'fiqih' ? 'fa-hand-holding-heart' : 'fa-star-and-crescent'}`}></i>
                        </div>
                        <span class="caption font-semibold text-ink capitalize">{subject}</span>
                    </button>
                ))}
            </div>
        </section>

        <section id="weekSection" class="mb-8 opacity-30 pointer-events-none transition-all duration-500">
            <h3 class="eyebrow mb-4">2. Pilih Pertemuan</h3>
            <div id="weekContainer" class="flex gap-3 overflow-x-auto no-scrollbar pb-2"></div>
        </section>

        <!-- [GURU] Panel kelola & pantau PR (Pusat PR) -->
        <section id="prPanelSection" class="hidden animate-slide-up space-y-5">
            <!-- diisi via renderPRPanel() -->
        </section>

        <!-- [MURID] Pilih nama (mode PR ?pr=true) — juga dipakai alur in-class lama (disembunyikan utk guru) -->
        <section id="studentSection" class="hidden animate-slide-up">
            <div class="flex flex-col gap-4 mb-6">
                <div class="flex justify-between items-center">
                    <h3 class="eyebrow">Pilih Nama Kamu</h3>
                    <span id="sessionBadge" class="badge badge-accent"></span>
                </div>
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-tertiary text-sm pointer-events-none"></i>
                    <input type="text" id="studentSearch" class="field field-search" placeholder="Cari nama Anak...">
                </div>
            </div>
            <div id="studentGrid" class="grid grid-cols-2 gap-3"></div>
        </section>

    </div>

    <div id="modalExamPortal" class="modal-overlay hidden" style="z-index: 100;">
        <div class="modal-sheet modal-sheet-flush" style="height: 80dvh;">
            <div class="px-6 pt-4 pb-3 shrink-0 border-b" style="border-color: var(--hairline);">
                <div class="sheet-grabber"></div>
                <div class="flex justify-between items-center">
                    <div>
                        <p class="eyebrow">Portal Ujian</p>
                        <h3 class="section-title">Ujian Aktif</h3>
                    </div>
                    <button onclick="closeExamPortal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </div>
            <div id="examPortalList" class="flex-1 overflow-y-auto no-scrollbar px-6 py-3 space-y-3">
                <div class="text-center py-10"><i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i></div>
            </div>
        </div>
    </div>

    <div id="modalVerifyStudent" class="fixed inset-0 bg-gray-900/70 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white w-full max-w-sm rounded-[2rem] shadow-2xl text-center transform scale-95 transition-transform duration-300 relative overflow-hidden" id="modalVerifyStudentBox">
            
            <div class="w-full h-32 bg-indigo-500 relative">
                <img id="verifyCoverImage" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?q=80&w=600&auto=format&fit=crop" class="w-full h-full object-cover mix-blend-overlay opacity-60" alt="Kids Cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            </div>
            
            <div class="relative -mt-12 flex justify-center z-10">
                <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-lg flex items-center justify-center text-4xl font-black text-indigo-600" id="verifyInitials">
                    NA
                </div>
            </div>
            
            <div class="px-6 pb-6 pt-3">
                <h3 class="text-indigo-400 font-black text-[10px] mb-1 uppercase tracking-widest">Tunggu Sebentar...</h3>
                <h2 class="text-2xl font-black text-gray-800 mb-2 uppercase line-clamp-2 leading-tight" id="verifyName">NAMA SISWA</h2>
                
                <div class="bg-amber-50 border-2 border-dashed border-amber-200 p-3.5 rounded-2xl mb-6 mt-3">
                    <p class="text-xs font-bold text-amber-700 leading-relaxed">
                        👀 Coba dibaca lagi namanya...<br>
                        Beneran ini kamu? Jangan sampai kamu ngerjain tugas punya temenmu lho ya! 🤭
                    </p>
                </div>

                <div class="space-y-3">
                    <button onclick="closeVerifyStudent()" class="w-full py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-500 font-bold rounded-2xl transition-all shadow-sm active:scale-95 text-xs">
                        🙈 Eh Bukan, Salah Pencet!
                    </button>
                    <button id="btnProceedStudent" class="w-full py-4 bg-gray-200 text-gray-400 font-black rounded-2xl transition-all cursor-not-allowed flex items-center justify-center gap-2 text-sm" disabled>
                        <i class="fa-solid fa-hourglass-half" id="proceedLockIcon"></i>
                        <span id="proceedText">Tahan dulu (3)...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- [GURU] MODAL PILIH DURASI PERPANJANGAN -->
    <div id="modalGrantExt" class="fixed inset-0 bg-black/70 z-[210] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-[var(--r-xl)] p-6 shadow-2xl">
            <h3 class="section-title mb-1">Beri Perpanjangan</h3>
            <p id="grantExtSub" class="caption mb-3">untuk siswa</p>
            <p id="grantExtPenaltyNote" class="text-xs font-semibold mb-4 px-3 py-2 rounded-[var(--r-md)]"></p>
            <label class="field-label mb-2">Dispensasi berlaku sampai</label>
            <div class="space-y-2">
                <button data-dur="tonight" class="grant-dur-btn btn btn-soft w-full justify-start"><i class="fa-solid fa-moon"></i> Malam ini (23:59)</button>
                <button data-dur="1d" class="grant-dur-btn btn btn-soft w-full justify-start"><i class="fa-solid fa-calendar-day"></i> Besok (+1 hari, 23:59)</button>
                <button data-dur="2d" class="grant-dur-btn btn btn-soft w-full justify-start"><i class="fa-solid fa-calendar-week"></i> Lusa (+2 hari, 23:59)</button>
            </div>
            <button onclick="closeGrantExt()" class="btn w-full mt-4 text-secondary">Batal</button>
        </div>
    </div>

    <!-- [BARU] MODAL PR TERLAMBAT (DEADLINE HABIS) + FORM MINTA PERPANJANGAN -->
    <div id="modalPRLate" class="fixed inset-0 bg-black/80 z-[200] hidden items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300 opacity-0">
        <div class="bg-white w-full max-w-sm rounded-[2rem] shadow-2xl transform scale-95 transition-transform duration-300 relative overflow-hidden p-6 border-4 border-amber-400" id="modalPRLateBox">

            <div class="w-20 h-20 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border-4 border-white shadow-lg relative z-10">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <h2 class="text-xl font-black text-gray-800 mb-1 text-center">Yahh, Kamu Telat!</h2>
            <p class="text-xs text-gray-500 font-bold mb-4 text-center">Waktu pengerjaan tugas PR ini sudah habis.</p>

            <div class="bg-amber-50 border border-amber-100 rounded-2xl p-3 mb-4 text-center">
                <p class="text-[10px] font-black text-amber-800 uppercase tracking-widest mb-1">Batas Waktu Sebelumnya:</p>
                <p id="lateDeadlineText" class="text-sm font-bold text-amber-700">--</p>
            </div>

            <label class="block text-[11px] font-black text-gray-600 uppercase tracking-widest mb-2">Kenapa telat ngerjain?</label>
            <textarea id="lateReason" rows="3" maxlength="300"
                class="w-full p-3 text-sm bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none resize-none"
                placeholder="Tulis alasanmu, mis. ketiduran, ada acara keluarga, sinyal jelek..."></textarea>

            <div class="space-y-2.5 mt-5">
                <button id="btnSendLateReq" onclick="submitExtensionRequestConsul()" class="w-full py-4 bg-amber-500 hover:bg-amber-600 text-white font-black rounded-2xl shadow-lg active:scale-95 transition-all text-sm uppercase tracking-widest">
                    <i class="fa-solid fa-paper-plane mr-1"></i> Minta Perpanjangan ke Kak Aziz
                </button>
                <button onclick="closePRLateModal()" class="w-full py-3 bg-gray-100 hover:bg-gray-200 text-gray-500 font-bold rounded-2xl active:scale-95 transition-all text-xs">
                    Nanti Saja
                </button>
            </div>
        </div>
    </div>

<!-- MODAL SATPAM PR (70% Video, 30% Text) -->
<div id="modalSatpamPR" class="fixed inset-0 bg-gray-950/95 z-[120] hidden items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300 opacity-0">
    <div class="bg-white w-full max-w-sm rounded-[2rem] shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col h-[80vh] max-h-[600px] relative" id="modalSatpamBox">
        
        <!-- 70% Area Kamera -->
        <div class="relative h-[70%] bg-gray-900 overflow-hidden flex items-center justify-center z-10">
            <!-- Video Stream (di-mirror) -->
            <video id="satpamVideo" class="absolute inset-0 w-full h-full object-cover transform scale-x-[-1]" autoplay playsinline muted></video>
            
            <!-- Masking (Luar gelap, tengah terang) -->
            <div class="absolute inset-0 pointer-events-none flex items-center justify-center z-30">
                <div class="w-48 h-64 rounded-[4rem] shadow-[0_0_0_2000px_rgba(0,0,0,0.7)] pointer-events-none transition-all duration-300" id="satpamMask"></div>
            </div>
            
            <!-- Lingkaran Target (Z-INDEX 40: PALING ATAS DARI VIDEO) -->
            <div id="satpamTargetCircle" class="absolute w-48 h-64 border-4 border-dashed border-white/70 rounded-[4rem] transition-colors duration-300 pointer-events-none flex items-center justify-center z-40">
                <span id="satpamCountdown" class="text-white text-7xl font-black drop-shadow-xl hidden">3</span>
            </div>

            <canvas id="satpamCanvas" class="hidden"></canvas>
            
            <!-- Efek Pura-Pura Verifikasi (Z-INDEX 20: DI BAWAH LINGKARAN) -->
            <div id="satpamScanEffect" class="absolute inset-0 bg-indigo-600/40 hidden flex-col items-center justify-center backdrop-blur-sm z-20">
                <div class="absolute top-0 w-full h-2 bg-white animate-pulse shadow-[0_0_20px_white]" id="scannerLine" style="animation: scan 2s linear infinite;"></div>
                <i class="fa-solid fa-fingerprint text-6xl text-white mb-3"></i>
                <p class="text-white text-[10px] font-black uppercase tracking-widest text-center px-4" id="satpamProcessText">Memverifikasi Wajah...</p>
            </div>
        </div>
        
        <!-- 30% Area Teks & Instruksi (Z-INDEX 50: PALING DEPAN) -->
        <div class="h-[30%] bg-white p-5 flex flex-col justify-center text-center relative z-50">
            <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg border-4 border-gray-50 z-50">
                <i class="fa-solid fa-shield-halved text-indigo-500 text-xl"></i>
            </div>
            
            <h3 class="text-indigo-500 font-black text-[10px] mb-1 uppercase tracking-widest mt-2">TUGAS PR: <span id="satpamSubject"></span></h3>
            <h2 class="text-xl font-black text-gray-800 mb-2 uppercase line-clamp-1" id="satpamStudentName">NAMA SISWA</h2>
            
            <p id="satpamInstruction" class="text-xs font-bold text-gray-500 leading-relaxed bg-gray-50 p-2 rounded-xl border border-gray-100">
                Posisikan wajahmu di dalam garis untuk verifikasi.
            </p>

            <button onclick="closeSatpam()" id="btnCancelSatpam" class="mt-3 text-[10px] text-gray-400 font-bold uppercase tracking-widest hover:text-red-500 transition-colors">
                Batalkan
            </button>
        </div>
    </div>
</div>
    <NavbarGuru activeMenu="chat" />
    <Toast />
</Layout>

<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js" is:inline></script>

<script>
    // =======================================================================
    // 1. GLOBAL STATE & INISIALISASI
    // =======================================================================
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const urlParams = new URLSearchParams(window.location.search);
    
    // [FIX] Tangkap raw token dan cegah string "null" merusak sistem
    const rawPrToken = urlParams.get('pr_token');
    const paramPrToken = (rawPrToken && rawPrToken !== 'null') ? rawPrToken : null;
    const isPRMode = urlParams.get('pr') === 'true' || !!paramPrToken;
    
    // Logika Token Cerdas (Gabungan Guru & Murid)
    let token = localStorage.getItem('token'); 
    if (paramPrToken) {
        token = paramPrToken;
        sessionStorage.setItem('temp_pr_token', paramPrToken);
    } else if (sessionStorage.getItem('temp_pr_token') && sessionStorage.getItem('temp_pr_token') !== 'null') {
        token = sessionStorage.getItem('temp_pr_token');
    }
    
    // Kalau bener-bener gak ada token, baru tendang
    if (!token) {
        window.location.replace('/');
        throw new Error("Akses ditolak: Token tidak ditemukan.");
    }

    // Cache Memory (Biar HP nggak capek fetch berulang kali)
    const STATE = {
        subject: isPRMode ? urlParams.get('subject') : null,
        week: isPRMode ? urlParams.get('week') : null,
        students: [],
        completedIds: [],
        cachedWeeks: {},
        cachedLocks: {},
        activeExams: [],
        examCompletion: {},
        currentSatpamId: null,
        currentSatpamName: null,
        satpamStream: null,
        satpamLoopId: null
    };

    // [BARU] Logika Jembatan: Oper parameter reset_waktu ke halaman berikutnya
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const isResetRequest = urlParams.get('reset_waktu') === 'true';

        if (isResetRequest) {
            // Cari tombol yang ngarahin ke fill.astro (biasanya id="btnStart")
            const btnStart = document.getElementById('btnStart');
            if (btnStart) {
                // Ambil link aslinya (misal: /consultations/fill?id=xxx...)
                let currentHref = btnStart.getAttribute('href');
                // Tempelin reset_waktu di ujungnya
                btnStart.setAttribute('href', currentHref + '&reset_waktu=true');
            }
        }
    });

    // =======================================================================
    // 2. SETUP UI AWAL (MODE GURU VS MODE MURID)
    // =======================================================================
    const initUI = async () => {

        try {
            const sysRes = await fetch(`${API_URL}/api/onboarding/system/status`);
            if (sysRes.ok) {
                const sysData = await sysRes.json();
                // Jika sistem dikunci, HANYA murid (Mode PR) yang ditendang keluar
                // Guru tetap harus bisa akses dashboard & consultations untuk ngelepas kuncian
                if (sysData.data && sysData.data.is_maintenance && isPRMode) {
                    window.location.replace('/maintenance');
                    return; // Stop inisialisasi di sini!
                }
            }
        } catch (err) {
            console.warn("Lewati cek maintenance (API belum siap/error)");
        }

        
        if (isPRMode) {
            document.querySelector('header h1').innerText = "Pilih Nama Kamu";
            document.querySelector('header p').innerText = "Pastikan klik namamu sendiri ya!";
            
            const hideElements = ['examPortalBanner', 'subjectSection', 'weekSection'];
            hideElements.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
            
            const step3Title = document.querySelector('#studentSection h3');
            if (step3Title) step3Title.innerText = "DAFTAR SISWA KELAS";
            
            const bottomNav = document.querySelector('nav') || document.querySelector('.fixed.bottom-0.w-full');
            if (bottomNav) bottomNav.style.display = 'none';

            if (STATE.subject && STATE.week) fetchStudents();
        } else {
            checkActiveExams();
            bindSubjectButtons();
            loadExtensionRequests();
        }
    };

    // =======================================================================
    // [GURU] PANEL PERMINTAAN PERPANJANGAN WAKTU (DISPENSASI)
    // =======================================================================
    const SUBJECT_LABEL = { tajwid: 'Tajwid', fiqih: 'Fiqih', tauhid: 'Tauhid' };

    const timeAgo = (iso) => {
        const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
        if (diff < 1) return 'baru saja';
        if (diff < 60) return `${diff} menit lalu`;
        if (diff < 1440) return `${Math.floor(diff / 60)} jam lalu`;
        return `${Math.floor(diff / 1440)} hari lalu`;
    };

    let extRequests = [];

    const loadExtensionRequests = async () => {
        try {
            const res = await fetch(`${API_URL}/api/onboarding/pr-extension-requests`, { headers: { 'Authorization': `Bearer ${token}` } });
            const json = await res.json();
            extRequests = json.data || [];
            renderExtensionRequests();
        } catch (e) { console.warn('Gagal memuat permintaan perpanjangan', e); }
    };

    const renderExtensionRequests = () => {
        const panel = document.getElementById('extReqPanel');
        if (!extRequests.length) { panel.classList.add('hidden'); panel.innerHTML = ''; return; }

        const cards = extRequests.map(r => {
            const initials = (r.student_name || '?').substring(0, 2).toUpperCase();
            const reason = r.reason ? r.reason.replace(/</g, '&lt;') : '(tanpa alasan)';
            const subj = SUBJECT_LABEL[r.subject] || (r.subject || '').toUpperCase();
            return `
                <div class="card card-pad mb-3">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="avatar w-10 h-10 text-xs flex-shrink-0">${initials}</div>
                        <div class="min-w-0 flex-1">
                            <p class="caption font-semibold text-ink truncate capitalize">${r.student_name}</p>
                            <p class="text-[10px] text-tertiary font-medium">${subj} · Pertemuan ${r.week} · ${timeAgo(r.created_at)}</p>
                        </div>
                    </div>
                    <div class="rounded-[var(--r-md)] p-3 mb-3" style="background-color: var(--surface-sunken);">
                        <p class="text-[10px] font-black text-tertiary uppercase tracking-widest mb-1">Alasan Telat</p>
                        <p class="caption text-ink">${reason}</p>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="openGrantExt('${r.id}', true, '${(r.student_name||'').replace(/'/g,"\\'")}')" class="btn w-full text-xs !py-2.5" style="background-color: var(--warning-soft); color: var(--warning);">
                            <i class="fa-solid fa-scissors"></i> Perpanjang + Potong
                        </button>
                        <button onclick="openGrantExt('${r.id}', false, '${(r.student_name||'').replace(/'/g,"\\'")}')" class="btn btn-primary w-full text-xs !py-2.5">
                            <i class="fa-solid fa-check"></i> Perpanjang Saja
                        </button>
                    </div>
                </div>`;
        }).join('');

        panel.innerHTML = `
            <div class="flex items-center justify-between mb-3">
                <h3 class="eyebrow flex items-center gap-2"><i class="fa-solid fa-bell" style="color: var(--warning);"></i> Permintaan Perpanjangan (${extRequests.length})</h3>
            </div>
            ${cards}`;
        panel.classList.remove('hidden');
    };

    let grantTarget = { id: null, penalty: false };

    window.openGrantExt = (requestId, withPenalty, studentName) => {
        grantTarget = { id: requestId, penalty: withPenalty };
        document.getElementById('grantExtSub').innerHTML = `untuk <b class="text-ink capitalize">${studentName || 'siswa'}</b>`;
        const note = document.getElementById('grantExtPenaltyNote');
        if (withPenalty) {
            note.textContent = '⚠️ Nilai PR siswa akan dipotong 10%.';
            note.style.backgroundColor = 'var(--warning-soft)';
            note.style.color = 'var(--warning)';
        } else {
            note.textContent = '✅ Nilai PR siswa tidak dipotong.';
            note.style.backgroundColor = 'var(--accent-soft)';
            note.style.color = 'var(--accent-strong)';
        }
        document.getElementById('modalGrantExt').classList.replace('hidden', 'flex');
    };

    window.closeGrantExt = () => document.getElementById('modalGrantExt').classList.replace('flex', 'hidden');

    const buildUntil = (dur) => {
        const d = new Date();
        if (dur === '1d') d.setDate(d.getDate() + 1);
        else if (dur === '2d') d.setDate(d.getDate() + 2);
        d.setHours(23, 59, 0, 0);
        const pad = n => n.toString().padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:00+07`;
    };

    document.querySelectorAll('.grant-dur-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!grantTarget.id) return;
            const until = buildUntil(btn.dataset.dur);
            document.querySelectorAll('.grant-dur-btn').forEach(b => b.disabled = true);
            try {
                const res = await fetch(`${API_URL}/api/onboarding/pr-extension-respond`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ request_id: grantTarget.id, extension_until: until, with_penalty: grantTarget.penalty })
                });
                if (!res.ok) throw new Error('Gagal');
                window.showToast?.('success', 'Dispensasi Diberikan', grantTarget.penalty ? 'Waktu diperpanjang (nilai dipotong 10%).' : 'Waktu diperpanjang tanpa potongan nilai.');
                extRequests = extRequests.filter(r => r.id !== grantTarget.id);
                renderExtensionRequests();
                closeGrantExt();
            } catch (e) {
                window.showToast?.('danger', 'Error', 'Gagal memberi dispensasi. Coba lagi.');
            } finally {
                document.querySelectorAll('.grant-dur-btn').forEach(b => b.disabled = false);
            }
        });
    });

    // =======================================================================
    // 3. CORE FUNCTIONS (Sesi Belajar & Fetch Data)
    // =======================================================================
    const bindSubjectButtons = () => {
        document.querySelectorAll('.subject-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                // UI Highlight
                document.querySelectorAll('.subject-btn').forEach(b => b.classList.remove('border-green-600', 'ring-2', 'ring-green-100'));
                btn.classList.add('border-green-600', 'ring-2', 'ring-green-100');
                
                STATE.subject = btn.getAttribute('data-value');
                
                // Fetch Lock Status & Weeks Paralel (Biar Cepat)
                try {
                    const [resWeeks, resLocks] = await Promise.all([
                        STATE.cachedWeeks[STATE.subject] ? Promise.resolve({ data: STATE.cachedWeeks[STATE.subject] }) : fetch(`${API_URL}/api/onboarding/available-weeks/${STATE.subject}`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json()),
                        STATE.cachedLocks[STATE.subject] ? Promise.resolve({ data: STATE.cachedLocks[STATE.subject] }) : fetch(`${API_URL}/api/onboarding/pr-locks/${STATE.subject}`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json())
                    ]);

                    STATE.cachedWeeks[STATE.subject] = resWeeks.data;
                    STATE.cachedLocks[STATE.subject] = resLocks.data || [];
                    
                    renderWeekButtons(resWeeks.data, resLocks.data || []);
                    document.getElementById('weekSection').classList.remove('opacity-30', 'pointer-events-none');
                    document.getElementById('studentSection').classList.add('hidden');
                    document.getElementById('prPanelSection').classList.add('hidden');
                } catch (e) { console.error("Gagal memuat data minggu:", e); }
            });
        });
    };

    const renderWeekButtons = (weeksArray, lockedWeeks = []) => {
        const container = document.getElementById('weekContainer');
        container.innerHTML = '';
        if (!weeksArray || weeksArray.length === 0) {
            container.innerHTML = `<div class="p-4 text-xs text-orange-500 bg-orange-50 rounded-xl w-full">Belum ada materi...</div>`;
            return;
        }
        
        weeksArray.forEach(weekNum => {
            const isLocked = lockedWeeks.includes(weekNum);
            const btn = document.createElement('button');
            btn.className = "week-btn relative flex-shrink-0 w-12 h-12 rounded-[var(--r-md)] font-bold transition-all active:scale-90 flex items-center justify-center";
            btn.style.cssText = "background-color: var(--canvas); border: 1px solid var(--hairline); color: var(--ink-secondary);";
            btn.innerHTML = `${weekNum}${isLocked ? `<span class="absolute -top-1 -right-1 w-3 h-3 rounded-full border-2 border-white" style="background-color: var(--accent);" title="PR aktif"></span>` : ''}`;
            btn.onclick = () => {
                document.querySelectorAll('.week-btn').forEach(b => { b.classList.remove('is-week-active'); b.style.backgroundColor = 'var(--canvas)'; b.style.color = 'var(--ink-secondary)'; b.style.borderColor = 'var(--hairline)'; });
                btn.classList.add('is-week-active');
                btn.style.backgroundColor = 'var(--accent)'; btn.style.color = '#fff'; btn.style.borderColor = 'var(--accent)';
                openPRPanel(weekNum);
            };
            container.appendChild(btn);
        });
    };

    const fetchStudents = async () => {
        if (!STATE.subject || !STATE.week) return;
        try {
            document.getElementById('studentSection').classList.remove('hidden');
            document.getElementById('sessionBadge').innerText = `${STATE.subject.toUpperCase()} - MG ${STATE.week}`;

            // Fetch Paralel: Status Pengerjaan & Daftar Siswa
            const [resStatus, resStd] = await Promise.all([
                fetch(`${API_URL}/api/onboarding/status?subject=${STATE.subject}&week=${STATE.week}`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json()),
                STATE.students.length > 0 ? Promise.resolve({ data: STATE.students }) : fetch(`${API_URL}/api/students/stats/enriched`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json())
            ]);

            STATE.completedIds = resStatus.data || [];
            if (STATE.students.length === 0) STATE.students = resStd.data || [];
            
            renderStudentGrid(STATE.students, STATE.completedIds);
            if (!isPRMode) document.getElementById('studentSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (e) { console.error("Gagal sinkronisasi data siswa:", e); }
    };

    // =======================================================================
    // [GURU] PUSAT PR — kelola & pantau tugas rumah (cached, hemat server)
    // =======================================================================
    const prCache = { status: {}, detail: {} };

    window.openPRPanel = async (week) => {
        STATE.week = week;
        const subject = STATE.subject;
        document.getElementById('studentSection').classList.add('hidden');
        const panel = document.getElementById('prPanelSection');
        panel.classList.remove('hidden');
        panel.innerHTML = `<div class="card card-pad text-center py-10"><i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i></div>`;
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });

        const key = `${subject}-${week}`;
        try {
            const [students, status, detail] = await Promise.all([
                STATE.students.length ? Promise.resolve(STATE.students) : fetch(`${API_URL}/api/students/stats/enriched`, { headers:{ Authorization:`Bearer ${token}` }}).then(r=>r.json()).then(d=>d.data||[]),
                prCache.status[key] ? Promise.resolve(prCache.status[key]) : fetch(`${API_URL}/api/onboarding/status?subject=${subject}&week=${week}`, { headers:{ Authorization:`Bearer ${token}` }}).then(r=>r.json()).then(d=>d.data||[]),
                (key in prCache.detail) ? Promise.resolve(prCache.detail[key]) : fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${subject}&week=${week}`, { headers:{ Authorization:`Bearer ${token}` }}).then(r=>r.json()).then(d=>Array.isArray(d.data)?d.data[0]:d.data)
            ]);
            if (!STATE.students.length) STATE.students = students;
            prCache.status[key] = status;
            prCache.detail[key] = detail || null;
            STATE.completedIds = status;
            const isLocked = (STATE.cachedLocks[subject] || []).includes(week);
            renderPRPanel({ subject, week, isLocked, detail: detail || null, students: STATE.students, doneIds: status });
        } catch (e) {
            panel.innerHTML = `<div class="card card-pad text-center py-8"><p class="caption" style="color: var(--danger);">Gagal memuat data PR.</p></div>`;
        }
    };

    const renderPRPanel = ({ subject, week, isLocked, detail, students, doneIds }) => {
        const panel = document.getElementById('prPanelSection');
        const total = students.length;
        const done = students.filter(s => doneIds.includes(s.id)).length;
        const left = total - done;

        let dDays = 1, dTime = '23:59';
        if (detail && detail.deadline_at) {
            const dl = new Date(detail.deadline_at);
            dDays = Math.max(0, Math.ceil((dl - new Date()) / 86400000));
            dTime = `${String(dl.getHours()).padStart(2,'0')}:${String(dl.getMinutes()).padStart(2,'0')}`;
        }

        const rows = students.map(s => {
            const isDone = doneIds.includes(s.id);
            const initials = s.name.substring(0,2).toUpperCase();
            return `
                <div class="flex items-center gap-3 py-2.5" style="border-top: 1px solid var(--divider);">
                    <div class="avatar w-9 h-9 text-xs flex-shrink-0">${initials}</div>
                    <div class="min-w-0 flex-1">
                        <p class="caption font-semibold text-ink truncate capitalize">${s.name}</p>
                        <p class="text-[10px] text-tertiary font-medium">${s.grade || '-'}</p>
                    </div>
                    ${isDone
                        ? `<span class="badge badge-accent flex-shrink-0"><i class="fa-solid fa-check"></i> Sudah</span>`
                        : `<button onclick="copyResetLinkConsul('${s.id}', '${s.name.replace(/'/g,"\\'")}')" class="badge badge-warning flex-shrink-0 active:scale-95" title="Salin link bantuan/reset untuk siswa ini">Belum <i class="fa-solid fa-link ml-0.5"></i></button>`}
                </div>`;
        }).join('');

        panel.innerHTML = `
            <div class="card card-pad">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <div class="min-w-0">
                        <p class="eyebrow">Pertemuan ${week} · ${subject.toUpperCase()}</p>
                        <h3 class="section-title">Bagikan PR</h3>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                        <input type="checkbox" class="sr-only peer" id="prLockSwitch" onchange="togglePRConsul(this)" ${isLocked?'checked':''}>
                        <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent)]"></div>
                    </label>
                </div>
                <div id="prControls" class="${isLocked?'space-y-3':'hidden'}">
                    <button onclick="copyPRLinkConsul()" class="btn btn-primary w-full"><i class="fa-solid fa-link"></i> Salin Link PR</button>
                    <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
                        <label class="field-label">Batas Waktu (Deadline)</label>
                        <div class="grid grid-cols-2 gap-2 mb-2">
                            <select id="prDeadlineDays" class="field !py-2 text-xs font-semibold">
                                <option value="0" ${dDays===0?'selected':''}>Hari Ini</option>
                                <option value="1" ${dDays===1?'selected':''}>Besok</option>
                                <option value="2" ${dDays===2?'selected':''}>2 Hari Lagi</option>
                                <option value="3" ${dDays===3?'selected':''}>3 Hari Lagi</option>
                                <option value="7" ${dDays===7?'selected':''}>1 Minggu Lagi</option>
                            </select>
                            <select id="prDeadlineTime" class="field !py-2 text-xs font-semibold">
                                <option value="12:00" ${dTime==='12:00'?'selected':''}>12:00 Siang</option>
                                <option value="15:00" ${dTime==='15:00'?'selected':''}>15:00 Sore</option>
                                <option value="18:00" ${dTime==='18:00'?'selected':''}>18:00 Maghrib</option>
                                <option value="21:00" ${dTime==='21:00'?'selected':''}>21:00 Malam</option>
                                <option value="23:59" ${dTime==='23:59'?'selected':''}>23:59 Penuh</option>
                            </select>
                        </div>
                        <button onclick="saveDeadlineConsul()" class="btn-soft w-full !py-2 text-xs"><i class="fa-solid fa-floppy-disk"></i> Simpan Deadline</button>
                    </div>
                </div>
                <p id="prHintIdle" class="caption mt-1 ${isLocked?'hidden':''}">Aktifkan switch untuk membagikan pertemuan ini sebagai PR ke siswa.</p>
            </div>

            <div class="card card-pad">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="section-title">Progress Siswa</h3>
                    <span class="caption">${done}/${total} selesai</span>
                </div>
                <div class="grid grid-cols-3 gap-2 mb-2">
                    <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--surface-sunken);"><p class="eyebrow">Total</p><p class="text-lg font-bold text-ink mt-0.5">${total}</p></div>
                    <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--accent-soft);"><p class="eyebrow" style="color:var(--accent-strong);">Sudah</p><p class="text-lg font-bold mt-0.5" style="color:var(--accent-strong);">${done}</p></div>
                    <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--warning-soft);"><p class="eyebrow" style="color:var(--warning);">Belum</p><p class="text-lg font-bold mt-0.5" style="color:var(--warning);">${left}</p></div>
                </div>
                <div class="max-h-72 overflow-y-auto no-scrollbar">${rows || '<p class="caption text-center py-4">Belum ada siswa.</p>'}</div>
            </div>
        `;
    };

    window.togglePRConsul = async (el) => {
        const subject = STATE.subject, week = STATE.week, checked = el.checked;
        document.getElementById('prControls')?.classList.toggle('hidden', !checked);
        document.getElementById('prHintIdle')?.classList.toggle('hidden', checked);
        try {
            await fetch(`${API_URL}/api/onboarding/pr-lock`, { method:'POST', headers:{ Authorization:`Bearer ${token}`, 'Content-Type':'application/json' }, body: JSON.stringify({ subject, week, is_locked: checked })});
            const arr = STATE.cachedLocks[subject] || [];
            STATE.cachedLocks[subject] = checked ? Array.from(new Set([...arr, week])) : arr.filter(w => w !== week);
            window.showToast?.('success', 'Status Diperbarui', checked ? `Pertemuan ${week} aktif sebagai PR.` : `Pertemuan ${week} ditutup.`);
        } catch (e) { window.showToast?.('danger', 'Error', 'Gagal mengubah status PR.'); el.checked = !checked; }
    };

    window.copyPRLinkConsul = () => {
        const link = `${window.location.origin}/consultations?subject=${STATE.subject}&week=${STATE.week}&pr=true&pr_token=${token}`;
        navigator.clipboard.writeText(link)
            .then(() => window.showToast?.('success','Link Disalin!',`Link PR ${STATE.subject.toUpperCase()} Pert. ${STATE.week} siap dibagikan ke Grup WA.`))
            .catch(() => prompt('Copy link ini:', link));
    };

    window.saveDeadlineConsul = async () => {
        const subject = STATE.subject, week = STATE.week;
        const days = parseInt(document.getElementById('prDeadlineDays').value);
        const [h, m] = document.getElementById('prDeadlineTime').value.split(':');
        const d = new Date(); d.setDate(d.getDate() + days); d.setHours(parseInt(h), parseInt(m), 0, 0);
        const pad = n => n.toString().padStart(2,'0');
        const fmt = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:00+07`;
        try {
            await fetch(`${API_URL}/api/onboarding/pr-lock`, { method:'POST', headers:{ Authorization:`Bearer ${token}`, 'Content-Type':'application/json' }, body: JSON.stringify({ subject, week, is_locked:true, deadline_at: fmt })});
            prCache.detail[`${subject}-${week}`] = { deadline_at: fmt };
            window.showToast?.('success','Deadline Disimpan',`Batas pengerjaan: ${h}:${m} WIB`);
        } catch (e) { window.showToast?.('danger','Error','Gagal menyimpan deadline.'); }
    };

    window.copyResetLinkConsul = (studentId, studentName) => {
        const link = `${window.location.origin}/consultations/fill?id=${studentId}&subject=${STATE.subject}&week=${STATE.week}&pr=true&pr_token=${token}&reset_waktu=true`;
        navigator.clipboard.writeText(link)
            .then(() => window.showToast?.('success','Link Bantuan Disalin!',`Link reset/lanjut untuk ${studentName} siap dikirim.`))
            .catch(() => prompt('Copy link ini:', link));
    };

    const renderStudentGrid = (students, doneIds) => {
        const grid = document.getElementById('studentGrid');
        if (!students || students.length === 0) return grid.innerHTML = '<p class="col-span-2 text-center py-10 text-gray-400 text-xs italic">Siswa tidak ditemukan...</p>';
        
        grid.innerHTML = students.map(s => {
            const isFinished = doneIds.includes(s.id);
            const photoUrl = s.photo_url || '';
            const safeName = s.name.replace(/'/g, "\\'");
            return `
                <div class="student-card ${isFinished ? 'opacity-40 grayscale pointer-events-none' : 'active:scale-95 cursor-pointer'} bg-white p-4 rounded-3xl border border-gray-50 shadow-sm flex flex-col items-center text-center gap-3 transition-all"
                    ${!isFinished ? `onclick="openVerifyStudent('${s.id}', '${safeName}', '${photoUrl}')"` : ''}>
                    <div class="relative">
                        <div class="w-14 h-14 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center text-lg font-bold">${s.name.substring(0, 2).toUpperCase()}</div>
                        ${isFinished ? '<div class="absolute -top-1 -right-1 w-5 h-5 bg-green-500 text-white rounded-full flex items-center justify-center text-[10px] shadow-sm"><i class="fa-solid fa-check"></i></div>' : ''}
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800 text-[11px] line-clamp-1 capitalize">${s.name}</h4>
                        <p class="text-[9px] text-gray-400 font-bold uppercase mt-1 tracking-tighter">${isFinished ? 'SELESAI' : s.grade}</p>
                    </div>
                </div>
            `;
        }).join('');
    };

    document.getElementById('studentSearch').addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        renderStudentGrid(STATE.students.filter(s => s.name.toLowerCase().includes(term)), STATE.completedIds);
    });

    // =======================================================================
    // 4. SATPAM PINTAR (AI FACE DETECTOR - OPTIMIZED)
    // =======================================================================
    window.openVerifyStudent = async (id, name, imageUrl) => {
        // [BARU] LOGIKA PENGECEKAN DEADLINE PR (FIXED FAIL-OPEN BUG)
        if (isPRMode) {
            try {
                // Fetch detail PR lock dari backend
                const res = await fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${STATE.subject}&week=${STATE.week}`, { headers: { 'Authorization': `Bearer ${token}` }});
                const prDetail = await res.json();
                
                const prData = Array.isArray(prDetail.data) ? prDetail.data[0] : prDetail.data;

                if (prData) {
                    const now = new Date();
                    
                    // Parse JSONB dengan super aman (Looping kalau stringified berkali-kali)
                    let extendedList = prData.extended_students;
                    try {
                        while (typeof extendedList === 'string') {
                            extendedList = JSON.parse(extendedList);
                        }
                    } catch(e) {}

                    if (!Array.isArray(extendedList)) extendedList = [];

                    const extRecord = extendedList.find(ext => ext.student_id === id);

                    if (extRecord) {
                        // KASUS 1: PUNYA DISPENSASI
                        const extDeadline = new Date(extRecord.until);
                        
                        console.log("⏱️ Cek Waktu Dispensasi:");
                        console.log("Sekarang:", now.toLocaleString());
                        console.log("Batas Dispensasi:", extDeadline.toLocaleString());

                        if (now > extDeadline) {
                            openPRLateModal(extRecord.until, id, name);
                            return; // STOP MUTLAK! Jangan buka kamera!
                        }
                        if (extRecord.penalty) {
                            window.showToast?.('info', 'Dispensasi Aktif', 'Akses perpanjangan berhasil. Ingat, nilaimu dipotong 10%!');
                        } else {
                            window.showToast?.('info', 'Dispensasi Aktif', 'Akses perpanjangan berhasil. Semangat ngerjainnya!');
                        }
                        
                    } else if (prData.deadline_at) {
                        // KASUS 2: GAK PUNYA DISPENSASI
                        const originalDeadline = new Date(prData.deadline_at);

                        console.log("⏱️ Cek Waktu Normal:");
                        console.log("Sekarang:", now.toLocaleString());
                        console.log("Batas Normal:", originalDeadline.toLocaleString());

                        if (now > originalDeadline) {
                            openPRLateModal(prData.deadline_at, id, name);
                            return; // STOP MUTLAK! Jangan buka kamera!
                        }
                    }
                }
            } catch(e) {
                console.error("Gagal ngecek deadline:", e);
                window.showToast?.('danger', 'Error', 'Gagal memverifikasi waktu dengan server.');
                return; // STOP MUTLAK! Kalau server error, fail-closed biar aman.
            }

            // Kalau BENAR-BENAR lolos semua penjagaan di atas, baru buka Satpam!
            return openSatpamModal(id, name);
        }
        
        // ==========================================
        // Logika Modal Verifikasi Guru Biasa (Bukan PR)
        // ==========================================
        document.getElementById('verifyInitials').innerText = name.substring(0, 2).toUpperCase();
        document.getElementById('verifyName').innerText = name;
        const coverImg = document.getElementById('verifyCoverImage');
        coverImg.src = (imageUrl && imageUrl.trim() !== '' && imageUrl !== 'null') ? imageUrl : 'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?q=80&w=600&auto=format&fit=crop';
        
        pendingStudentUrl = `/consultations/fill?id=${id}&subject=${STATE.subject}&week=${STATE.week}`;
        
        const modal = document.getElementById('modalVerifyStudent');
        modal.classList.replace('hidden', 'flex');
        setTimeout(() => { modal.classList.replace('opacity-0', 'opacity-100'); document.getElementById('modalVerifyStudentBox').classList.replace('scale-95', 'scale-100'); }, 10);
        
        const btn = document.getElementById('btnProceedStudent');
        btn.disabled = true; btn.className = 'w-full py-4 bg-gray-200 text-gray-400 font-black rounded-2xl cursor-not-allowed flex items-center justify-center gap-2 text-sm';
        let timeLeft = 3; document.getElementById('proceedText').innerText = `Tunggu ya (${timeLeft})...`;
        
        window.verifyTimer = setInterval(() => {
            timeLeft--;
            if (timeLeft > 0) document.getElementById('proceedText').innerText = `Tunggu ya (${timeLeft})...`;
            else {
                clearInterval(window.verifyTimer); btn.disabled = false;
                btn.className = 'w-full py-4 bg-green-500 hover:bg-green-600 text-white font-black rounded-2xl shadow-lg active:scale-95 flex items-center justify-center gap-2 text-sm';
                document.getElementById('proceedText').innerText = 'IYA BENAR, INI AKU! 🚀';
            }
        }, 1000);
    };

    let pendingStudentUrl = '';
    
    const openSatpamModal = async (id, name) => {
        STATE.currentSatpamId = id; STATE.currentSatpamName = name;
        document.getElementById('satpamStudentName').innerText = name;
        document.getElementById('satpamSubject').innerText = STATE.subject;
        
        pendingStudentUrl = `/consultations/fill?id=${id}&subject=${STATE.subject}&week=${STATE.week}&pr=true&pr_token=${paramPrToken}`;

        const modal = document.getElementById('modalSatpamPR');
        modal.classList.replace('hidden', 'flex');
        setTimeout(() => { modal.classList.replace('opacity-0', 'opacity-100'); document.getElementById('modalSatpamBox').classList.replace('scale-95', 'scale-100'); }, 10);

        await startSatpamCamera();
    };

    const startSatpamCamera = async () => {
        const video = document.getElementById('satpamVideo');
        const instruction = document.getElementById('satpamInstruction');
        
        try {
            // [TAHAP 1] Coba request kamera depan dengan resolusi ideal
            STATE.satpamStream = await navigator.mediaDevices.getUserMedia({ 
                video: { facingMode: 'user', width: { ideal: 480 }, height: { ideal: 640 } } 
            });
        } catch (err1) {
            try {
                // [TAHAP 2] Fallback: Minta SEMBARANG kamera pokoknya nyala!
                STATE.satpamStream = await navigator.mediaDevices.getUserMedia({ video: true });
            } catch (err2) {
                // [TAHAP 3] Penjelasan UX kalau beneran gagal/ditolak/dikunci aplikasi lain
                instruction.innerHTML = `
                    <span class='text-red-500 font-bold text-[10px]'>
                        <i class="fa-solid fa-triangle-exclamation"></i> Kamera gagal diakses.<br>
                        Pastikan tidak ada aplikasi lain (WA/Kamera) yang sedang terbuka di background. Tutup lalu <b>Refresh</b> halaman.
                    </span>`;
                const targetCircle = document.getElementById('satpamTargetCircle');
                if (targetCircle) targetCircle.classList.replace('border-white/70', 'border-red-500');
                
                return; // STOP DI SINI! Jangan lanjut baca metadata video
            }
        }

        // Kalau berhasil tembus (dari Tahap 1 atau 2), masukin stream-nya ke elemen video
        video.srcObject = STATE.satpamStream;
            
        video.onloadedmetadata = async () => {
            video.play();
            video.width = video.videoWidth; // Cegah error aspect ratio AI
            video.height = video.videoHeight;
            
            // UX: User bisa ngaca sambil nunggu AI download
            instruction.innerHTML = "<span class='text-blue-500 font-bold'><i class='fa-solid fa-spinner fa-spin mr-1'></i> Memuat sensor biometrik...<br><span class='text-[10px] text-gray-400'>Silakan posisikan wajah ke tengah layar.</span></span>";
            
            if (!window.isSatpamAILoaded) {
                try {
                    await faceapi.nets.tinyFaceDetector.loadFromUri('https://justadudewhohacks.github.io/face-api.js/models');
                    window.isSatpamAILoaded = true;
                } catch (err) {
                    instruction.innerHTML = "<span class='text-red-500 font-bold'>Gagal memuat AI. Pastikan internet stabil.</span>";
                    return;
                }
            }

            instruction.innerHTML = "<span class='text-gray-600 font-bold'>Kamera aktif. <br>Tahan wajah Anda di dalam lingkaran...</span>";
            runFaceDetectionLoop(); 
        };
    };

    const runFaceDetectionLoop = () => {
        const video = document.getElementById('satpamVideo');
        const instruction = document.getElementById('satpamInstruction');
        const targetCircle = document.getElementById('satpamTargetCircle');
        
        let scanProgress = 0;
        let noFaceTime = 0;
        let isVerifying = false;
        
        // [UPDATE 1] Threshold diturunkan ke 0.4. 
        // Biar AI lebih "peka" menangkap wajah walau cahaya agak kurang / remang-remang.
        const aiOptions = new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.4 });

        const loop = async () => {
            if (!STATE.satpamStream || isVerifying) return; 

            try {
                const detection = await faceapi.detectSingleFace(video, aiOptions);

                if (detection) {
                    const box = detection.box; 
                    const vidW = video.videoWidth; 
                    const vidH = video.videoHeight;
                    
                    const faceCenterX = box.x + (box.width / 2); 
                    const faceCenterY = box.y + (box.height / 2);

                    // [UPDATE 2] Toleransi Posisi Diperlebar (dari 0.3 jadi 0.35)
                    // Karena layar HP sering nge-crop video, titik tengah AI sering geser. Kita kasih area tengah lebih luas!
                    const isCenteredX = Math.abs(faceCenterX - (vidW / 2)) < (vidW * 0.35); 
                    const isCenteredY = Math.abs(faceCenterY - (vidH / 2)) < (vidH * 0.35);
                    
                    // [UPDATE 3] Ukuran Minimal Wajah diturunkan dikit
                    const isBigEnough = box.width > (vidW * 0.15); 

                    // [UPDATE 4] Proporsi Wajah dilebarkan (0.5 sampai 1.2)
                    // AI kadang ngebentuk kotak yang sedikit melebar tergantung letak HP.
                    const faceRatio = box.width / box.height;
                    const isFullFace = faceRatio > 0.5 && faceRatio < 1.2;

                    if (isCenteredX && isCenteredY && isBigEnough && isFullFace) {
                        // --- WAJAH PAS DI TENGAH! ---
                        noFaceTime = 0;
                        scanProgress += 5; // Hitung mundur

                        targetCircle.className = 'absolute w-48 h-64 border-4 rounded-[4rem] flex items-center justify-center z-40 transition-colors duration-300 pointer-events-none border-solid';
                        targetCircle.style.borderColor = `rgba(34, 197, 94, ${scanProgress / 100})`; 
                        targetCircle.style.boxShadow = `0 0 ${scanProgress / 5}px rgba(34, 197, 94, 0.6)`;

                        if (scanProgress < 30) instruction.innerHTML = "<span class='text-green-500 font-bold'>Tahan sebentar...</span>";
                        else if (scanProgress < 70) instruction.innerHTML = "<span class='text-green-500 font-bold'>Jangan bergerak-gerak...</span>";
                        else if (scanProgress >= 100) {
                            isVerifying = true;
                            instruction.innerHTML = "<span class='text-green-600 font-black tracking-widest'>BERHASIL!</span>";
                            targetCircle.style.borderColor = 'rgb(34, 197, 94)'; 
                            targetCircle.style.boxShadow = '0 0 25px rgb(34, 197, 94)';
                            executeRealUpload(); 
                            return; 
                        }
                    } else {
                        // --- WAJAH KELUAR JALUR / KETUTUP ---
                        noFaceTime = 0; scanProgress = 0; 
                        targetCircle.style.boxShadow = 'none';
                        targetCircle.className = 'absolute w-48 h-64 border-4 rounded-[4rem] flex items-center justify-center z-40 transition-colors duration-300 pointer-events-none border-dashed border-orange-400';
                        
                        if (!isFullFace) {
                            instruction.innerHTML = "<span class='text-orange-500 font-bold'>Wajah harus terlihat penuh! Singkirkan tangan/penutup.</span>";
                        } else if (!isBigEnough) {
                            instruction.innerHTML = "<span class='text-orange-500 font-bold'>Wajah terlalu jauh. Maju sedikit!</span>";
                        } else {
                            instruction.innerHTML = "<span class='text-orange-500 font-bold'>Arahkan wajah pas ke tengah lingkaran!</span>";
                        }
                    }
                } else {
                    // --- TIDAK ADA WAJAH ---
                    noFaceTime += 150; scanProgress = 0; 
                    if (noFaceTime > 3000) { 
                        targetCircle.style.boxShadow = 'none';
                        targetCircle.className = 'absolute w-48 h-64 border-4 rounded-[4rem] flex items-center justify-center z-40 transition-colors duration-300 pointer-events-none border-dashed border-red-500';
                        instruction.innerHTML = "<span class='text-red-500 font-bold'>Wajah tidak terdeteksi!<br>Arahkan wajah ke kamera.</span>";
                    } else if (noFaceTime > 500) {
                        targetCircle.style.boxShadow = 'none';
                        targetCircle.className = 'absolute w-48 h-64 border-4 rounded-[4rem] flex items-center justify-center z-40 transition-colors duration-300 pointer-events-none border-dashed border-white/70';
                        instruction.innerHTML = "Posisikan wajahmu di dalam garis untuk verifikasi.";
                    }
                }
            } catch (e) { console.warn("AI Frame Dropped"); }

            STATE.satpamLoopId = setTimeout(loop, 150);
        };

        loop();
    };

    const executeRealUpload = async () => {
        const video = document.getElementById('satpamVideo');
        const canvas = document.getElementById('satpamCanvas');
        const scanEffect = document.getElementById('satpamScanEffect');
        const instruction = document.getElementById('satpamInstruction');

        // Jepret Foto (Kualitas 70% biar cepat upload)
        canvas.width = video.videoWidth; canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
        const base64Image = canvas.toDataURL('image/jpeg', 0.7);
        
        video.pause();
        scanEffect.classList.remove('hidden'); scanEffect.classList.add('flex');
        document.getElementById('btnCancelSatpam').style.display = 'none';
        instruction.innerHTML = "<span class='text-indigo-600 font-bold'>Mengunggah data biometrik...</span>";

        try {
            const uploadPromise = fetch(`${API_URL}/api/onboarding/upload-satpam`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify({ student_id: STATE.currentSatpamId, student_name: STATE.currentSatpamName, subject: STATE.subject, week: STATE.week, image: base64Image })
            });

            setTimeout(() => { document.getElementById('satpamProcessText').innerText = "MENCOCOKKAN IDENTITAS..."; }, 1500);

            // Pastikan animasi minimal tayang 3 detik walaupun upload selesai duluan
            const [uploadRes] = await Promise.all([ uploadPromise, new Promise(resolve => setTimeout(resolve, 3000)) ]);

            if (!uploadRes.ok) throw new Error("Server menolak upload");

            document.getElementById('satpamProcessText').innerText = "AKSES DIBERIKAN!";
            document.getElementById('satpamProcessText').classList.replace('text-white', 'text-green-300');
            
            if (pendingStudentUrl) window.location.href = pendingStudentUrl;

        } catch (e) {
            document.getElementById('satpamProcessText').innerText = "GAGAL TERHUBUNG!";
            document.getElementById('satpamProcessText').classList.replace('text-white', 'text-red-400');
            instruction.innerHTML = "<span class='text-red-600 font-bold'>Gagal menyimpan foto. Silakan coba lagi.</span>";
            setTimeout(window.closeSatpam, 2500);
        }
    };

    window.closeSatpam = () => {
        const modal = document.getElementById('modalSatpamPR');
        modal.classList.replace('opacity-100', 'opacity-0');
        document.getElementById('modalSatpamBox').classList.replace('scale-100', 'scale-95');
        
        if (STATE.satpamLoopId) clearTimeout(STATE.satpamLoopId);
        if (STATE.satpamStream) { STATE.satpamStream.getTracks().forEach(track => track.stop()); STATE.satpamStream = null; }

        setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
    };

    // =======================================================================
    // 5. EXAM PORTAL (SISA FUNGSI GURU)
    // =======================================================================
    window.closeVerifyStudent = () => {
        const modal = document.getElementById('modalVerifyStudent');
        modal.classList.replace('opacity-100', 'opacity-0');
        document.getElementById('modalVerifyStudentBox').classList.replace('scale-100', 'scale-95');
        if(window.verifyTimer) clearInterval(window.verifyTimer);
        setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
    };
    
    // =======================================================================
    // PORTAL UJIAN — list ujian aktif + salin link (konsep PR/di rumah)
    // =======================================================================
    window.openExamPortal = () => {
        document.getElementById('modalExamPortal').classList.remove('hidden');
        renderExamPortalList();
    };
    window.closeExamPortal = () => document.getElementById('modalExamPortal').classList.add('hidden');

    const renderExamPortalList = () => {
        const box = document.getElementById('examPortalList');
        const exams = STATE.activeExams || [];
        const total = STATE.students.length || 0;
        if (!exams.length) {
            box.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-folder-open text-2xl"></i></div><p class="caption font-semibold">Belum ada ujian aktif.</p></div>`;
            return;
        }
        box.innerHTML = exams.map(ex => {
            const done = (ex.results || []).length;
            const safeTitle = (ex.title || '').replace(/'/g, "\\'");
            const status = ex.isFullyCompleted
                ? `<span class="badge badge-accent"><i class="fa-solid fa-flag-checkered"></i> Tuntas</span>`
                : `<span class="badge badge-warning">${done}/${total} selesai</span>`;
            return `
                <div class="card overflow-hidden">
                    <div class="card-pad !pb-3">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="badge badge-info uppercase">${ex.subject || '-'}</span>
                            ${status}
                        </div>
                        <h3 class="section-title">${ex.title}</h3>
                        <p class="caption mt-1"><i class="fa-regular fa-clock mr-1"></i> ${ex.duration_minutes || '-'} Menit</p>
                    </div>
                    <div class="flex items-center gap-2 px-4 py-2.5 border-t" style="border-color: var(--divider); background-color: var(--pearl);">
                        <button onclick="copyExamLinkConsul('${ex.id}', '${safeTitle}')" class="btn btn-primary !py-2 !px-4 text-xs flex-1"><i class="fa-solid fa-link"></i> Salin Link Ujian</button>
                        <a href="/exams/${ex.id}" class="btn-icon !w-9 !h-9" title="Buka editor ujian"><i class="fa-solid fa-pen text-xs"></i></a>
                    </div>
                </div>`;
        }).join('');
    };

    window.copyExamLinkConsul = (examId, title) => {
        const link = `${window.location.origin}/play/${examId}?token=${token}`;
        navigator.clipboard.writeText(link)
            .then(() => window.showToast?.('success', 'Link Disalin!', `Link ujian "${title}" siap dibagikan ke siswa.`))
            .catch(() => prompt('Copy link ini:', link));
    };

    // (Fungsi CheckActiveExams dan Exam Portal yang lama tetap aman dan berjalan)
    const checkActiveExams = async () => {
        const banner = document.getElementById('examPortalBanner');
        try {
            const res = await fetch(`${API_URL}/api/exams`, { headers: { 'Authorization': `Bearer ${token}` }});
            if (!res.ok) throw new Error("API Error"); 
            const activeExams = ((await res.json()).data || []).filter(e => e.is_active);

            if (activeExams.length === 0) {
                banner.className = "card card-pad mb-8 relative flex items-center justify-between cursor-not-allowed";
                banner.style.borderStyle = 'dashed';
                banner.removeAttribute('onclick');
                banner.innerHTML = `<div class="relative z-10"><h2 class="section-title mb-0.5 text-secondary"><i class="fa-solid fa-lock mr-2 text-tertiary"></i> Portal Terkunci</h2><p class="text-[11px] font-medium text-tertiary">Belum ada ujian yang di-publish oleh Kak Aziz.</p></div><div class="icon-chip" style="background-color: var(--surface-sunken); color: var(--ink-tertiary);"><i class="fa-solid fa-lock"></i></div>`;
                return;
            }

            if (STATE.students.length === 0) STATE.students = (await fetch(`${API_URL}/api/students/stats/enriched`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r=>r.json())).data || [];
            
            let availableCount = 0;
            STATE.activeExams = await Promise.all(activeExams.map(async (exam) => {
                const rData = await fetch(`${API_URL}/api/exams/${exam.id}/results`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r=>r.json());
                exam.results = rData.data || []; 
                exam.isFullyCompleted = exam.results.length >= STATE.students.length;
                if (!exam.isFullyCompleted) availableCount++;
                return exam;
            }));

            if (availableCount > 0) {
                banner.className = "card card-interactive card-pad mb-8 relative flex items-center justify-between cursor-pointer";
                banner.style.backgroundColor = 'var(--ink)';
                banner.style.borderColor = 'transparent';
                banner.setAttribute('onclick', 'openExamPortal()');
                banner.innerHTML = `<div class="relative z-10"><h2 class="section-title mb-0.5 text-white"><i class="fa-solid fa-gamepad mr-2"></i> Portal Ujian Siswa</h2><p class="text-[11px] font-medium" style="color: rgba(255,255,255,0.6);">Ada <b style="color:#fff;">${availableCount} Ujian</b> belum tuntas.</p></div><div class="icon-chip" style="background-color: var(--accent); color:#fff;"><i class="fa-solid fa-play ml-0.5"></i></div>`;
            } else {
                banner.className = "card card-pad mb-8 relative flex items-center justify-between cursor-not-allowed";
                banner.style.backgroundColor = 'var(--accent-soft)';
                banner.style.borderColor = 'transparent';
                banner.removeAttribute('onclick');
                banner.innerHTML = `<div class="relative z-10"><h2 class="section-title mb-0.5" style="color: var(--accent-strong);"><i class="fa-solid fa-flag-checkered mr-2"></i> Ujian Tuntas</h2><p class="text-[11px] font-medium" style="color: var(--accent-strong);">Seluruh siswa telah menyelesaikan ujian.</p></div><div class="icon-chip" style="background-color: #fff; color: var(--accent-strong);"><i class="fa-solid fa-check"></i></div>`;
            }
        } catch (e) {
            if (banner) {
                banner.className = "card card-pad mb-8 relative flex items-center justify-between cursor-not-allowed";
                banner.style.borderStyle = 'dashed';
                banner.removeAttribute('onclick');
                banner.innerHTML = `<div class="relative z-10"><h2 class="section-title mb-0.5 text-secondary"><i class="fa-solid fa-triangle-exclamation mr-2 text-tertiary"></i> Portal Belum Tersedia</h2><p class="text-[11px] font-medium text-tertiary">Fitur ujian sedang dalam tahap pengembangan.</p></div>`;
            }
        }
    };

    let lateReqStudentId = null;

    window.openPRLateModal = (deadlineString, studentId = null, studentName = '') => {
        const modal = document.getElementById('modalPRLate');
        const box = document.getElementById('modalPRLateBox');
        lateReqStudentId = studentId;

        // Format tanggal biar enak dibaca anak-anak
        const d = new Date(deadlineString);
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
        document.getElementById('lateDeadlineText').innerText = d.toLocaleDateString('id-ID', options);
        const reasonEl = document.getElementById('lateReason');
        if (reasonEl) reasonEl.value = '';

        modal.classList.replace('hidden', 'flex');
        setTimeout(() => {
            modal.classList.replace('opacity-0', 'opacity-100');
            box.classList.replace('scale-95', 'scale-100');
        }, 10);
    };

    window.submitExtensionRequestConsul = async () => {
        const reason = document.getElementById('lateReason').value.trim();
        if (!reason) { window.showToast?.('warning', 'Tulis Alasan', 'Isi dulu alasan kenapa kamu telat ya.'); return; }
        if (!lateReqStudentId) { window.showToast?.('danger', 'Error', 'Data siswa tidak ditemukan.'); return; }

        const btn = document.getElementById('btnSendLateReq');
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Mengirim...';

        try {
            const res = await fetch(`${API_URL}/api/onboarding/pr-extension-request`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: lateReqStudentId, subject: STATE.subject, week: STATE.week, reason })
            });
            if (!res.ok) throw new Error('Gagal');

            const box = document.getElementById('modalPRLateBox');
            box.innerHTML = `
                <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border-4 border-white shadow-lg">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h2 class="text-xl font-black text-gray-800 mb-1 text-center">Permintaan Terkirim!</h2>
                <p class="text-xs text-gray-500 font-bold mb-5 text-center">Tunggu Kak Aziz menyetujui perpanjangan waktumu. Coba pilih namamu lagi nanti ya.</p>
                <button onclick="closePRLateModal()" class="w-full py-4 bg-emerald-600 text-white font-black rounded-2xl shadow-lg active:scale-95 transition-all text-sm uppercase tracking-widest">Oke, Mengerti</button>`;
        } catch (e) {
            window.showToast?.('danger', 'Gagal', 'Permintaan tidak terkirim. Coba lagi ya.');
            btn.disabled = false;
            btn.innerHTML = original;
        }
    };

    window.closePRLateModal = () => {
        const modal = document.getElementById('modalPRLate');
        const box = document.getElementById('modalPRLateBox');
        modal.classList.replace('opacity-100', 'opacity-0');
        box.classList.replace('scale-100', 'scale-95');
        setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
    };

    // Jalankan sistem!
    initUI();
</script>

