---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
---

<Layout title="Feedback Aplikasi - yukNgaji">
    <div class="px-6 py-8 pb-20 min-h-screen bg-slate-50 flex flex-col relative">

        <header class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3 min-w-0">
                <a href="/dashboard" class="w-10 h-10 bg-white text-slate-500 border-2 border-slate-200 hover:bg-slate-100 rounded-xl shadow-sm flex items-center justify-center shrink-0 active:scale-95 transition-all">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
                <div class="min-w-0 pr-2">
                    <h1 class="text-xl font-black text-slate-800 tracking-tight truncate">Suara Murid</h1>
                    <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mt-0.5 truncate">Saran & Evaluasi Aplikasi</p>
                </div>
            </div>
            <button onclick="copyFeedbackLink()" class="w-10 h-10 bg-indigo-50 text-indigo-600 border-2 border-indigo-100 hover:bg-indigo-100 rounded-xl shadow-sm flex items-center justify-center shrink-0 active:scale-95 transition-all" title="Salin Link Publik">
                <i class="fa-solid fa-link"></i>
            </button>
        </header>

        <div class="mb-6 space-y-3 relative z-10">
            <div class="bg-indigo-600 rounded-3xl p-5 text-white shadow-lg shadow-indigo-600/20 relative overflow-hidden">
                <div class="relative z-10">
                    <h2 class="text-[10px] font-black opacity-80 uppercase tracking-widest mb-1">Total Feedback</h2>
                    <div class="flex items-end gap-3">
                        <span id="totalFeedbackCount" class="text-4xl font-black tabular-nums tracking-tight leading-none">0</span>
                        <span class="text-xs font-bold text-indigo-200 mb-1">Pesan Masuk</span>
                    </div>
                </div>
                <i class="fa-solid fa-comments absolute -bottom-4 -right-2 text-7xl text-white opacity-10"></i>
            </div>

            <div class="relative">
                <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" id="searchFeedback" placeholder="Cari nama murid..." class="w-full bg-white border-2 border-slate-200 rounded-2xl pl-11 pr-4 py-3.5 text-xs font-bold text-slate-700 outline-none focus:border-indigo-500 transition-all shadow-sm">
            </div>
        </div>

        <div id="feedbackContainer" class="flex-1 flex flex-col gap-4">
            <div class="text-center py-16 flex flex-col items-center justify-center">
                <i class="fa-solid fa-spinner fa-spin text-3xl text-indigo-500 mb-3"></i>
                <p class="text-xs font-bold text-slate-400">Menarik data evaluasi...</p>
            </div>
        </div>

        <div id="paginationControls" class="hidden items-center justify-between mt-6 bg-white p-2 rounded-2xl border-2 border-slate-100 shadow-sm">
            <button id="btnPrevPage" onclick="prevPage()" class="w-10 h-10 flex items-center justify-center bg-slate-50 border border-slate-200 rounded-xl text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 hover:border-indigo-200 disabled:opacity-30 disabled:cursor-not-allowed transition-all">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span id="pageInfo" class="text-xs font-black text-slate-600 tracking-widest">1 dari 1</span>
            <button id="btnNextPage" onclick="nextPage()" class="w-10 h-10 flex items-center justify-center bg-slate-50 border border-slate-200 rounded-xl text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 hover:border-indigo-200 disabled:opacity-30 disabled:cursor-not-allowed transition-all">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

    </div>
    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    if (!token) window.location.replace('/');

    let allFeedbacks = [];
    let filteredFeedbacks = [];
    let currentPage = 1;
    const itemsPerPage = 1;

    // Helpers
    const getInitials = (name = '') => name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '??';
    const formatDate = (dateStr) => new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' });
    const renderStars = (rating = 0, colorClass = "text-amber-400") => Array.from({length: 5}, (_, i) => `<i class="fa-solid fa-star ${i + 1 <= rating ? colorClass : 'text-slate-200'}"></i>`).join('');

    // COPY LINK LOGIC
    window.copyFeedbackLink = async () => {

        const link = `${window.location.origin}/feedback?token=${token}`;
        try {
            await navigator.clipboard.writeText(link);
            window.showToast?.('success', 'Link Tersalin!', 'Bagikan link ini ke grup murid.');
        } catch(err) {
            window.showToast?.('danger', 'Gagal', 'Gagal menyalin link.');
        }
    };

    // SEARCH DEBOUNCE
    let searchTimeout;
    document.getElementById('searchFeedback')?.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            const keyword = e.target.value.toLowerCase();
            filteredFeedbacks = allFeedbacks.filter(fb => (fb.students?.name || '').toLowerCase().includes(keyword));
            currentPage = 1;
            renderFeedbackPage();
        }, 300);
    });

    const fetchFeedbacks = async () => {
        try {
            const res = await fetch(`${API_URL}/api/feedbacks`, { headers: { 'Authorization': `Bearer ${token}` } });
            const result = await res.json();
            if (!res.ok) throw new Error(result.message);

            allFeedbacks = result.data || [];
            filteredFeedbacks = [...allFeedbacks];

            document.getElementById('totalFeedbackCount').innerText = allFeedbacks.length;
            renderFeedbackPage();
        } catch (error) {
            document.getElementById('feedbackContainer').innerHTML = `<div class="bg-rose-50 border-2 border-rose-100 rounded-3xl p-6 text-center"><i class="fa-solid fa-triangle-exclamation text-3xl text-rose-500 mb-2"></i><p class="text-xs font-bold text-rose-600">Gagal memuat feedback.</p></div>`;
        }
    };

    // RENDER PAGINATION
    const renderFeedbackPage = () => {
        const container = document.getElementById('feedbackContainer');
        const pagination = document.getElementById('paginationControls');
        const pageInfo = document.getElementById('pageInfo');
        const btnPrev = document.getElementById('btnPrevPage');
        const btnNext = document.getElementById('btnNextPage');

        if (filteredFeedbacks.length === 0) {
            container.innerHTML = `<div class="bg-white border-2 border-slate-100 border-dashed rounded-3xl p-8 text-center flex flex-col items-center justify-center h-48"><div class="w-16 h-16 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center text-3xl mb-3"><i class="fa-solid fa-inbox"></i></div><p class="text-xs font-bold text-slate-400">Tidak ada feedback ditemukan.</p></div>`;
            pagination.classList.replace('flex', 'hidden');
            return;
        }

        const totalPages = Math.ceil(filteredFeedbacks.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = totalPages;

        // Ambil 1 item saja sesuai page
        const fb = filteredFeedbacks[currentPage - 1];
        const s = fb.students || {};
        const e = fb.exams || {};

        let textBlocks = '';
        if (fb.favorite_part) textBlocks += `<div class="mb-3"><span class="text-[9px] font-black text-emerald-500 uppercase block mb-0.5"><i class="fa-solid fa-heart mr-1"></i> Bagian Paling Disukai</span><p class="text-xs font-bold text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed">${fb.favorite_part}</p></div>`;
        if (fb.hardest_part) textBlocks += `<div class="mb-3"><span class="text-[9px] font-black text-rose-500 uppercase block mb-0.5"><i class="fa-solid fa-face-dizzy mr-1"></i> Paling Bikin Pusing</span><p class="text-xs font-bold text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed">${fb.hardest_part}</p></div>`;
        if (fb.suggestion) textBlocks += `<div class="mb-3"><span class="text-[9px] font-black text-indigo-500 uppercase block mb-0.5"><i class="fa-solid fa-lightbulb mr-1"></i> Saran Murid</span><p class="text-xs font-bold text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed">${fb.suggestion}</p></div>`;
        if (fb.message) textBlocks += `<div class="mb-3"><span class="text-[9px] font-black text-slate-400 uppercase block mb-0.5"><i class="fa-solid fa-comment mr-1"></i> Pesan Bebas</span><p class="text-xs font-bold text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed italic">"${fb.message}"</p></div>`;

        container.innerHTML = `
            <div class="bg-white border-2 border-slate-100 rounded-3xl p-5 shadow-sm animate-slide-up transition-all hover:border-indigo-200 group">
                <div class="flex items-start justify-between mb-4 border-b-2 border-slate-50 pb-4">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 font-black text-xs flex items-center justify-center shrink-0 border border-indigo-100 shadow-inner">${getInitials(s.name)}</div>
                        <div class="min-w-0">
                            <h3 class="text-sm font-black text-slate-800 truncate">${s.name || 'Unknown'}</h3>
                            <p class="text-[9px] font-bold text-slate-400 mt-0.5">${formatDate(fb.created_at)}</p>
                        </div>
                    </div>
                </div>
                <div class="flex gap-4 mb-5 bg-slate-50 p-3 rounded-2xl border border-slate-100">
                    <div class="flex-1"><p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Kenyamanan</p><div class="text-[10px] space-x-0.5">${renderStars(fb.comfort_rating, 'text-amber-400')}</div></div>
                    <div class="w-px bg-slate-200"></div>
                    <div class="flex-1"><p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Kesulitan Ujian</p><div class="text-[10px] space-x-0.5">${renderStars(fb.difficulty_rating, 'text-rose-400')}</div></div>
                </div>
                <div class="space-y-1">${textBlocks || '<p class="text-[10px] font-bold text-slate-400 italic text-center py-2">Hanya mengirim rating bintang.</p>'}</div>
            </div>
        `;

        if (totalPages > 1) {
            pagination.classList.replace('hidden', 'flex');
            pageInfo.innerText = `${currentPage} dari ${totalPages}`;
            btnPrev.disabled = currentPage === 1;
            btnNext.disabled = currentPage === totalPages;
        } else {
            pagination.classList.replace('flex', 'hidden');
        }
    };

    window.prevPage = () => { if(currentPage > 1) { currentPage--; renderFeedbackPage(); }};
    window.nextPage = () => { if(currentPage < Math.ceil(filteredFeedbacks.length/itemsPerPage)) { currentPage++; renderFeedbackPage(); }};

    fetchFeedbacks();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { 0% { transform: translateY(20px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
</style>
