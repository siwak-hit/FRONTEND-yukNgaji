---
// src/pages/wrapped/[id].astro — "Credits scene" satu gulungan (bukan slide per slide)
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Catatan Ngajiku - yukNgaji">
  <audio id="bgMusic" loop preload="auto"><source src="/backsound.mp3" type="audio/mpeg"></audio>

  <div id="wrappedRoot" class="fixed inset-0 overflow-hidden text-white" style="background:#0b1020;">

    <!-- Bintik bintang halus -->
    <div id="starfield" class="absolute inset-0 pointer-events-none opacity-60"></div>

    <!-- ===================== COVER ===================== -->
    <div id="cover" class="absolute inset-0 z-40 flex flex-col items-center justify-center text-center px-6">
      <div id="coverPolaroids" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

      <div class="relative z-10 flex flex-col items-center">
        <div class="text-5xl mb-5 animate-bob">🎬</div>
        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-amber-300 mb-2">Catatan Ngajiku</p>
        <h1 id="coverName" class="text-3xl sm:text-4xl font-black leading-tight mb-3 capitalize">Memuat…</h1>
        <p class="text-sm text-slate-300 font-bold max-w-xs mb-8">Sebuah perjalanan singkat penuh perjuangan. Tekan tombol untuk memutar.</p>

        <button id="btnStart" onclick="startCredits()" class="cw-btn-primary text-base px-8 py-4">
          <i class="fa-solid fa-play"></i> Putar Catatan Ngajiku
        </button>
      </div>
    </div>

    <!-- ===================== CREDITS ROLL ===================== -->
    <div id="creditsViewport" class="absolute inset-0 z-20 overflow-y-auto no-scrollbar hidden">
      <div id="creditsRoll" class="max-w-md mx-auto px-5 flex flex-col items-center text-center" style="padding-top: 22vh; padding-bottom: 16vh;">

        <!-- 1. Foto awal -->
        <section class="cw-sec">
          <div class="cw-polaroid mx-auto" style="transform: rotate(-3deg);">
            <img id="heroPhoto" src="" crossorigin="anonymous" alt="Foto">
            <p class="cw-polaroid-cap" id="heroCap">Perjalananmu</p>
          </div>
          <h2 class="cw-h2 mt-7">Halo, <span id="rollName" class="text-amber-300 capitalize">Kamu</span> 👋</h2>
          <p class="cw-p">Mari kita putar ulang momen-momen ngajimu.</p>
        </section>

        <!-- 2. Ucapan selamat -->
        <section class="cw-sec">
          <div class="text-5xl mb-4">🌟</div>
          <h2 class="cw-h2">Kamu Luar Biasa!</h2>
          <p class="cw-p">Mengulang ayat selepas maghrib, menahan kantuk di malam hari, melawan rasa malas — dan kamu tetap bertahan sampai garis akhir.</p>
          <p class="cw-p mt-3">Setiap tetes keringat saat belajar adalah saksi indah di akhirat kelak. Terima kasih sudah tidak menyerah. 💚</p>
        </section>

        <!-- 3. Total koin + serang/penyerang -->
        <section class="cw-sec">
          <p class="cw-eyebrow">Total Koin Terkumpul</p>
          <div class="cw-bignum" id="rollCoins">0</div>
          <div class="grid grid-cols-2 gap-3 w-full mt-6 text-left">
            <div class="cw-card">
              <p class="cw-card-title text-rose-300"><i class="fa-solid fa-crosshairs"></i> Kamu Serang</p>
              <ul class="cw-list" id="rollAttacked"></ul>
            </div>
            <div class="cw-card">
              <p class="cw-card-title text-amber-300"><i class="fa-solid fa-shield-halved"></i> Menyerangmu</p>
              <ul class="cw-list" id="rollAttackers"></ul>
            </div>
          </div>
        </section>

        <!-- 4. Hafalan -->
        <section class="cw-sec">
          <div class="text-5xl mb-3">📖</div>
          <p class="cw-eyebrow">Hafalan Juz Amma</p>
          <div class="cw-bignum text-emerald-300"><span id="rollMemCount">0</span><span class="text-2xl text-slate-400 font-bold"> surah</span></div>
          <div class="cw-bar mt-4"><div id="rollMemBar" class="cw-bar-fill" style="width:0%;background:#34d399;"></div></div>
          <div id="rollSurahs" class="flex flex-wrap justify-center gap-1.5 mt-5"></div>
        </section>

        <!-- 5. Absensi -->
        <section class="cw-sec">
          <div class="text-5xl mb-3">🗓️</div>
          <p class="cw-eyebrow">Rekap Kehadiran</p>
          <div class="grid grid-cols-3 gap-3 w-full mt-4">
            <div class="cw-card text-center"><div class="text-3xl font-black text-emerald-300" id="rollHadir">0</div><p class="cw-card-sub">Hadir</p></div>
            <div class="cw-card text-center"><div class="text-3xl font-black text-amber-300" id="rollIzin">0</div><p class="cw-card-sub">Izin</p></div>
            <div class="cw-card text-center"><div class="text-3xl font-black text-rose-300" id="rollAlpa">0</div><p class="cw-card-sub">Alpa</p></div>
          </div>
          <p class="cw-p mt-4" id="rollAttNote"></p>
        </section>

        <!-- 6. Galeri -->
        <section class="cw-sec">
          <div class="text-5xl mb-3">📸</div>
          <p class="cw-eyebrow">Galeri Momen</p>
          <p class="cw-p mb-4">Jepretan rahasia selama kamu berjuang.</p>
          <div id="rollGallery" class="grid grid-cols-2 gap-3 w-full"></div>
        </section>

        <!-- 7. Rekaman suara -->
        <section class="cw-sec">
          <div class="text-5xl mb-3">🎙️</div>
          <p class="cw-eyebrow">Rekaman Saat Ujian</p>
          <p class="cw-p mb-4">Dengarkan kembali suaramu saat mengerjakan tiap ujian.</p>
          <div id="rollVoices" class="flex flex-col gap-3 w-full"></div>
        </section>

        <!-- 8. Credits text -->
        <section class="cw-sec">
          <p class="cw-eyebrow mb-6">— Catatan Ngajiku —</p>
          <div class="space-y-5 text-center">
            <div><p class="cw-credit-role">Pemeran Utama</p><p class="cw-credit-name capitalize" id="creditName">Kamu</p></div>
            <div><p class="cw-credit-role">Sutradara</p><p class="cw-credit-name">Dirimu Sendiri</p></div>
            <div><p class="cw-credit-role">Pendukung Setia</p><p class="cw-credit-name">Ust Suyatno, Ust Idris, Kak Aziz, Kak Bayu, dan teman-teman</p></div>
          </div>
          <p class="cw-p mt-8 max-w-xs mx-auto">Jadikan Al-Quran sahabat sejatimu di mana pun kamu berada. Kami bangga padamu. 🤍</p>
        </section>

        <!-- 9. Penutup + Feedback -->
        <section class="cw-sec">
          <div class="text-5xl mb-4">🎉</div>
          <h2 class="cw-h2">Sampai Jumpa!</h2>
          <p class="cw-p mb-7">Satu langkah lagi — ceritakan kesanmu lewat formulir singkat ini ya.</p>
          <button onclick="goToFeedback()" class="cw-btn-primary text-base px-8 py-4 animate-bob-slow">
            <i class="fa-solid fa-pen-to-square"></i> Isi Formulir Feedback
          </button>
          <p id="previewEndNote" class="hidden mt-6 text-[11px] font-black uppercase tracking-widest text-amber-300">Simulasi ujian user berakhir</p>
        </section>

      </div>
    </div>

    <!-- Kontrol mengambang (saat credits jalan) -->
    <div id="rollControls" class="hidden absolute top-4 inset-x-4 z-50 flex items-center justify-end">
      <div class="flex items-center gap-2">
        <button id="btnRecScreen" onclick="toggleScreenRecord()" class="cw-pill"><i class="fa-solid fa-circle text-rose-400"></i> Rekam</button>
        <button id="btnPauseRoll" onclick="togglePause()" class="cw-pill"><i class="fa-solid fa-pause"></i></button>
      </div>
    </div>
  </div>

  <!-- Modal: tawaran rekam layar -->
  <div id="modalScreenRec" class="fixed inset-0 z-[300] hidden items-center justify-center p-5 bg-black/80 backdrop-blur-sm">
    <div class="bg-white text-slate-800 w-full max-w-sm rounded-[2rem] p-7 text-center shadow-2xl animate-pop-in">
      <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 border border-rose-100"><i class="fa-solid fa-video"></i></div>
      <h3 class="text-xl font-black mb-2">Rekam Layar Momen Ini?</h3>
      <p class="text-xs font-bold text-slate-500 leading-relaxed mb-6">Biar bisa kamu simpan & bagikan, kamu bisa merekam layar saat animasi berjalan. (Opsional)</p>
      <div class="flex gap-2">
        <button onclick="declineScreenRecord()" class="flex-1 py-3 bg-slate-100 text-slate-500 font-bold rounded-xl active:scale-95 transition-all text-sm">Lewati</button>
        <button onclick="acceptScreenRecord()" class="flex-1 py-3 bg-rose-500 text-white font-black rounded-xl shadow-lg shadow-rose-500/30 active:scale-95 transition-all text-sm">Ya, Rekam</button>
      </div>
    </div>
  </div>

  <!-- Photo viewer -->
  <div id="photoViewerModal" class="fixed inset-0 z-[320] hidden items-center justify-center bg-black/90 p-4" onclick="closePhotoViewer()">
    <img id="viewerImage" src="" crossorigin="anonymous" class="max-w-full max-h-[85vh] rounded-2xl shadow-2xl" onclick="event.stopPropagation()">
    <button onclick="closePhotoViewer()" class="absolute top-6 right-6 w-11 h-11 bg-white/15 text-white rounded-full flex items-center justify-center text-xl"><i class="fa-solid fa-xmark"></i></button>
  </div>

  <Toast />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token') || localStorage.getItem('token');
  const studentId = window.location.pathname.split('/').pop();
  const isPreview = urlParams.get('preview') === 'true';
  const afterWrappedUrl = urlParams.get('after') ? decodeURIComponent(urlParams.get('after')) : null;

  let bgMusic;
  let allPhotos = [];

  const authHeaders = { 'Authorization': `Bearer ${token}` };
  const getJson = (url) => fetch(url, { headers: authHeaders }).then(r => r.json()).catch(() => ({ data: null }));

  const JUZ_AMMA = [
    "An-Nas","Al-Falaq","Al-Ikhlas","Al-Lahab","An-Nasr","Al-Kafirun","Al-Kausar","Al-Ma'un","Quraisy","Al-Fil",
    "Al-Humazah","Al-'Asr","At-Takasur","Al-Qari'ah","Al-'Adiyat","Az-Zalzalah","Al-Bayyinah","Al-Qadr","Al-'Alaq","At-Tin",
    "Al-Insyirah","Ad-Duha","Al-Lail","Asy-Syams","Al-Balad","Al-Fajr","Al-Gasyiyah","Al-A'la","At-Tariq","Al-Buruj",
    "Al-Insyiqaq","Al-Mutaffifin","Al-Infitar","At-Takwir","Abasa","An-Nazi'at","An-Naba'"
  ];

  // ===================== STARFIELD + POLAROID DEKORASI =====================
  const buildStarfield = () => {
    const sf = document.getElementById('starfield');
    let html = '';
    for (let i = 0; i < 40; i++) {
      const x = Math.random() * 100, y = Math.random() * 100, s = Math.random() * 2 + 1, o = Math.random() * 0.6 + 0.2;
      html += `<span style="position:absolute;left:${x}%;top:${y}%;width:${s}px;height:${s}px;background:#fff;border-radius:50%;opacity:${o};"></span>`;
    }
    sf.innerHTML = html;
  };

  const decorateCover = () => {
    const wrap = document.getElementById('coverPolaroids');
    if (!allPhotos.length) return;
    const spots = [
      { top: '8%', left: '6%', rot: -8 }, { top: '12%', right: '5%', rot: 7 },
      { bottom: '10%', left: '8%', rot: 6 }, { bottom: '14%', right: '7%', rot: -6 }
    ];
    wrap.innerHTML = spots.map((s, i) => {
      const p = allPhotos[i % allPhotos.length];
      const pos = ['top','left','right','bottom'].map(k => s[k] != null ? `${k}:${s[k]};` : '').join('');
      return `<div class="cw-polaroid cw-polaroid-sm" style="position:absolute;${pos}transform:rotate(${s.rot}deg);opacity:0.85;"><img src="${p.url}" crossorigin="anonymous"></div>`;
    }).join('');
  };

  // ===================== FETCH & RENDER =====================
  const renderList = (obj) => {
    const entries = Object.entries(obj).sort((a, b) => b[1] - a[1]).slice(0, 3);
    if (!entries.length) return '<li class="opacity-60">— kosong —</li>';
    return entries.map(([k, v]) => `<li>${k} <span class="opacity-50 text-[10px]">(${v}x)</span></li>`).join('');
  };

  const renderGallery = (photos) => {
    const grid = document.getElementById('rollGallery');
    if (!photos.length) { grid.innerHTML = '<p class="cw-p col-span-2 opacity-70">Belum ada foto momen.</p>'; return; }
    grid.innerHTML = photos.slice(0, 8).map((p, i) => `
      <div class="cw-polaroid" style="transform:rotate(${(i % 2 ? 2.5 : -2.5)}deg);" onclick="openPhotoViewer('${p.url}')">
        <img src="${p.url}" crossorigin="anonymous">
        <p class="cw-polaroid-cap">${p.label || 'Momen'}</p>
      </div>`).join('');
  };

  const renderVoices = (recordings) => {
    const wrap = document.getElementById('rollVoices');
    if (!recordings.length) { wrap.innerHTML = '<p class="cw-p opacity-70">Belum ada rekaman ujian.</p>'; return; }
    wrap.innerHTML = recordings.slice(0, 3).map((r, i) => `
      <div class="cw-voice">
        <button class="cw-voice-btn" data-idx="${i}" onclick="toggleVoice(${i})"><i class="fa-solid fa-play"></i></button>
        <div class="flex-1 text-left">
          <p class="text-sm font-black capitalize">${r.subject || ('Ujian ' + (i + 1))}</p>
          <p class="text-[10px] font-bold opacity-60">Rekaman suaramu</p>
        </div>
        <audio data-voice="${i}" src="${r.url}" preload="none"></audio>
      </div>`).join('');
  };

  const initData = async () => {
    buildStarfield();
    bgMusic = document.getElementById('bgMusic');
    if (bgMusic) bgMusic.volume = 0.45;
    if (isPreview) document.getElementById('previewEndNote').classList.remove('hidden');

    try {
      if (isPreview) {
        setText('coverName', 'Siswa Teladan'); setText('rollName', 'Siswa Teladan'); setText('creditName', 'Siswa Teladan');
        setText('rollCoins', '5.200');
        document.getElementById('rollAttacked').innerHTML = renderList({ 'Si Fulan': 5 });
        document.getElementById('rollAttackers').innerHTML = renderList({ 'Budi': 2 });
        setText('rollMemCount', '12'); document.getElementById('rollMemBar').style.width = '32%';
        document.getElementById('rollSurahs').innerHTML = JUZ_AMMA.slice(0, 12).map(s => `<span class="cw-chip">${s}</span>`).join('');
        setText('rollHadir', '45'); setText('rollIzin', '3'); setText('rollAlpa', '0');
        setText('rollAttNote', 'Kehadiranmu keren! Pertahankan ya.');
        allPhotos = [
          { url: 'https://dummyimage.com/400x400/1e293b/cbd5e1&text=Foto+1', label: 'Pas ngerjain PR' },
          { url: 'https://dummyimage.com/400x400/334155/e2e8f0&text=Foto+2', label: 'Pas ngerjain Tugas' },
          { url: 'https://dummyimage.com/400x400/475569/f1f5f9&text=Foto+3', label: 'Pas ngerjain Ujian' }
        ];
        document.getElementById('heroPhoto').src = allPhotos[0].url; setText('heroCap', 'Perjalananmu');
        renderGallery(allPhotos); decorateCover();
        renderVoices([{ subject: 'Ujian Tajwid' }, { subject: 'Ujian Fiqih' }].map(x => ({ ...x, url: '' })));
        return;
      }

      const std = (await getJson(`${API_URL}/api/students/${studentId}`)).data || {};
      const name = std.name || 'Siswa';
      setText('coverName', name); setText('rollName', name); setText('creditName', name);
      setText('rollCoins', (std.poin || 0).toLocaleString('id-ID'));

      // Kehadiran
      try {
        const att = (await getJson(`${API_URL}/api/students/${studentId}/attendance`)).data;
        const st = att?.stats || {};
        setText('rollHadir', st.hadir || 0); setText('rollIzin', st.izin || 0); setText('rollAlpa', st.alpa || 0);
        let note = 'Kehadiran sempurna! Luar biasa dedikasimu. ⭐';
        if (st.alpa > 0) note = `Ada ${st.alpa} hari tanpa keterangan. Yuk lebih rajin lagi!`;
        else if (st.izin > 0) note = 'Kamu sempat izin/sakit — semoga sehat & semangat terus ya. 🤲';
        setText('rollAttNote', note);
      } catch (e) {}

      // Hafalan
      try {
        const mem = (await getJson(`${API_URL}/api/students/${studentId}/memorization-logs`)).data || [];
        let maxId = 0;
        mem.forEach(m => { const idx = JUZ_AMMA.findIndex(s => s.toLowerCase() === String(m.surah_name).toLowerCase()); if (idx + 1 > maxId) maxId = idx + 1; });
        const done = JUZ_AMMA.slice(0, maxId);
        setText('rollMemCount', done.length);
        document.getElementById('rollMemBar').style.width = `${Math.min(100, (done.length / 37) * 100)}%`;
        document.getElementById('rollSurahs').innerHTML = done.map(s => `<span class="cw-chip">${s}</span>`).join('') || '<span class="cw-chip opacity-60">Belum ada</span>';
      } catch (e) {}

      // Koin / serang-menyerang (dari riwayat poin)
      try {
        const logs = (await getJson(`${API_URL}/api/students/${studentId}/point-history?days=all&limit=200`)).data || [];
        const attacked = {}, attackers = {};
        logs.forEach(log => {
          if (log.icon === '🔥') {
            const m = String(log.title || '').match(/<strong>(.*?)<\/strong>/);
            if (m && m[1]) {
              if (log.title.includes('mencuri poin dari')) attacked[m[1]] = (attacked[m[1]] || 0) + 1;
              else if (log.title.includes('berhasil diserang oleh')) attackers[m[1]] = (attackers[m[1]] || 0) + 1;
            }
          }
        });
        document.getElementById('rollAttacked').innerHTML = renderList(attacked);
        document.getElementById('rollAttackers').innerHTML = renderList(attackers);
      } catch (e) {}

      // Foto (satpam/PR, tugas, ujian)
      try {
        const [sat, cons, exam] = await Promise.all([
          getJson(`${API_URL}/api/students/${studentId}/satpam-logs`),
          getJson(`${API_URL}/api/students/${studentId}/consultations`),
          getJson(`${API_URL}/api/students/${studentId}/exam-captures`)
        ]);
        const raw = [];
        (sat.data || []).forEach(i => i.photo_url && raw.push({ url: i.photo_url, label: 'Pas ngerjain PR' }));
        (cons.data || []).forEach(i => i.image_url && raw.push({ url: i.image_url, label: 'Pas ngerjain Tugas' }));
        (exam.data || []).forEach(i => i.capture_url && raw.push({ url: i.capture_url, label: 'Pas ngerjain Ujian' }));
        const seen = new Set();
        allPhotos = raw.filter(p => !seen.has(p.url) && seen.add(p.url));
        if (allPhotos.length) {
          document.getElementById('heroPhoto').src = allPhotos[0].url; setText('heroCap', 'Perjalananmu');
        } else {
          const av = `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=1e293b&color=cbd5e1`;
          allPhotos = [{ url: av, label: 'Foto Profilmu' }];
          document.getElementById('heroPhoto').src = av;
        }
        renderGallery([...allPhotos].sort(() => 0.5 - Math.random()));
        decorateCover();
      } catch (e) {}

      // Rekaman suara per ujian
      try {
        const rec = (await getJson(`${API_URL}/api/students/${studentId}/exam-recordings`)).data || [];
        renderVoices(rec.map(r => ({ subject: r.subject, url: r.recording_url })));
      } catch (e) { renderVoices([]); }

    } catch (err) {
      console.error(err);
      window.showToast?.('danger', 'Error', 'Gagal memuat data.');
    }
  };

  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.innerText = val; };

  // ===================== CREDITS ROLL (auto-scroll) =====================
  let viewport, rafId = null, paused = false, speed = 0.9;

  let finished = false;

  window.startCredits = () => {
    document.getElementById('cover').style.display = 'none';
    document.getElementById('creditsViewport').classList.remove('hidden');
    document.getElementById('rollControls').classList.remove('hidden');
    viewport = document.getElementById('creditsViewport');

    // Kunci scroll selama animasi berjalan — user wajib menunggu sampai selesai.
    viewport.style.overflowY = 'hidden';

    try { bgMusic?.play().catch(() => {}); } catch (e) {}

    // Tawarkan rekam layar dulu, baru jalan.
    document.getElementById('modalScreenRec').classList.replace('hidden', 'flex');
  };

  const beginRoll = () => {
    cancelAnimationFrame(rafId);
    const step = () => {
      if (!paused && viewport) {
        viewport.scrollTop += speed;
        const atEnd = viewport.scrollTop + viewport.clientHeight >= viewport.scrollHeight - 4;
        if (atEnd) { finishRoll(); return; }
      }
      rafId = requestAnimationFrame(step);
    };
    rafId = requestAnimationFrame(step);
  };

  // Dipanggil saat animasi selesai: buka scroll & sembunyikan tombol pause/play.
  const finishRoll = () => {
    finished = true;
    paused = true;
    cancelAnimationFrame(rafId);
    if (viewport) viewport.style.overflowY = 'auto';
    const pauseBtn = document.getElementById('btnPauseRoll');
    if (pauseBtn) pauseBtn.classList.add('hidden');
  };

  const setPaused = (p) => {
    paused = p;
    const icon = document.querySelector('#btnPauseRoll i');
    if (icon) icon.className = p ? 'fa-solid fa-play' : 'fa-solid fa-pause';
  };
  window.togglePause = () => setPaused(!paused);

  // ===================== SCREEN RECORD (opsional) =====================
  let screenRecorder = null, screenChunks = [], screenStream = null;

  window.acceptScreenRecord = async () => {
    document.getElementById('modalScreenRec').classList.replace('flex', 'hidden');
    try {
      if (!navigator.mediaDevices?.getDisplayMedia) throw new Error('unsupported');
      screenStream = await navigator.mediaDevices.getDisplayMedia({ video: { frameRate: 30 }, audio: true });
      screenChunks = [];
      screenRecorder = new MediaRecorder(screenStream);
      screenRecorder.ondataavailable = e => { if (e.data && e.data.size) screenChunks.push(e.data); };
      screenRecorder.onstop = () => {
        try {
          const blob = new Blob(screenChunks, { type: screenRecorder.mimeType || 'video/webm' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = `CatatanNgajiku_${Date.now()}.webm`; a.click();
          setTimeout(() => URL.revokeObjectURL(url), 4000);
          window.showToast?.('success', 'Rekaman Tersimpan', 'Video momenmu sedang diunduh.');
        } catch (e) {}
        screenStream?.getTracks().forEach(t => t.stop());
        const b = document.getElementById('btnRecScreen');
        if (b) b.innerHTML = '<i class="fa-solid fa-circle text-rose-400"></i> Rekam';
      };
      screenStream.getVideoTracks()[0].addEventListener('ended', () => stopScreenRecord());
      screenRecorder.start();
      const b = document.getElementById('btnRecScreen');
      if (b) b.innerHTML = '<i class="fa-solid fa-stop"></i> Stop';
      window.showToast?.('info', 'Merekam Layar', 'Tekan "Stop" kapan saja untuk menyimpan.');
    } catch (e) {
      window.showToast?.('warning', 'Tidak Bisa Merekam', 'Perangkat/browser ini tidak mendukung rekam layar.');
    } finally {
      beginRoll();
    }
  };

  window.declineScreenRecord = () => {
    document.getElementById('modalScreenRec').classList.replace('flex', 'hidden');
    beginRoll();
  };

  const stopScreenRecord = () => { try { if (screenRecorder && screenRecorder.state !== 'inactive') screenRecorder.stop(); } catch (e) {} };
  window.toggleScreenRecord = () => {
    if (screenRecorder && screenRecorder.state === 'recording') stopScreenRecord();
    else { document.getElementById('modalScreenRec').classList.replace('hidden', 'flex'); }
  };

  // ===================== VOICE PLAYBACK =====================
  let currentVoice = null;
  window.toggleVoice = (idx) => {
    const audio = document.querySelector(`audio[data-voice="${idx}"]`);
    const btnIcon = document.querySelector(`.cw-voice-btn[data-idx="${idx}"] i`);
    if (!audio || !audio.src) { window.showToast?.('info', 'Tidak Ada Suara', 'Rekaman untuk ujian ini tidak tersedia.'); return; }

    document.querySelectorAll('audio[data-voice]').forEach(a => {
      if (a !== audio) { a.pause(); a.currentTime = 0; const i = document.querySelector(`.cw-voice-btn[data-idx="${a.dataset.voice}"] i`); if (i) i.className = 'fa-solid fa-play'; }
    });

    if (audio.paused) {
      try { bgMusic && (bgMusic.volume = 0.12); } catch (e) {}
      audio.play();
      if (btnIcon) btnIcon.className = 'fa-solid fa-pause';
      currentVoice = audio;
      audio.onended = () => { if (btnIcon) btnIcon.className = 'fa-solid fa-play'; try { bgMusic && (bgMusic.volume = 0.45); } catch (e) {} };
    } else {
      audio.pause();
      if (btnIcon) btnIcon.className = 'fa-solid fa-play';
      try { bgMusic && (bgMusic.volume = 0.45); } catch (e) {}
    }
  };

  // ===================== PHOTO VIEWER =====================
  window.openPhotoViewer = (url) => { document.getElementById('viewerImage').src = url; document.getElementById('photoViewerModal').classList.replace('hidden', 'flex'); };
  window.closePhotoViewer = () => document.getElementById('photoViewerModal').classList.replace('flex', 'hidden');

  // ===================== FEEDBACK / SELESAI =====================
  window.goToFeedback = () => {
    stopScreenRecord();
    try { bgMusic?.pause(); } catch (e) {}
    if (afterWrappedUrl) { window.location.replace(afterWrappedUrl); return; }
    const params = new URLSearchParams();
    if (studentId) params.set('student_id', studentId);
    if (token) params.set('token', token);
    if (isPreview) { params.set('preview', 'true'); }
    window.location.href = `/feedback?${params.toString()}`;
  };

  initData();
</script>

