                    <h3 class="section-title">Soal ${viewerIndex + 1} <span class="text-tertiary font-normal">/ ${total}</span></h3>
                </div>
                <div class="pt-4">${renderViewerBody(q)}</div>
                <div class="flex items-center justify-between gap-2 mt-5 pt-3 border-t" style="border-color: var(--divider);">
                    <button onclick="viewerPrev()" class="btn-icon" ${viewerIndex === 0 ? 'disabled' : ''} aria-label="Sebelumnya"><i class="fa-solid fa-chevron-left"></i></button>
                    <select onchange="viewerJump(this.value)" class="field !py-2 !px-3 !w-auto text-sm font-medium">${jump}</select>
                    <button onclick="viewerNext()" class="btn-icon" ${viewerIndex === total - 1 ? 'disabled' : ''} aria-label="Berikutnya"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>`;
    };

    window.viewerCurrent = () => viewerQuestions[viewerIndex];
    window.viewerPrev = () => { if (viewerIndex > 0) { viewerIndex--; renderViewer(); } };
    window.viewerNext = () => { if (viewerIndex < viewerQuestions.length - 1) { viewerIndex++; renderViewer(); } };
    window.viewerJump = (v) => { viewerIndex = parseInt(v) || 0; renderViewer(); };

    // Preview POV siswa (mengerjakan PR) — hasil TIDAK disimpan ke DB
    window.previewAsStudent = () => {
        if (!viewerSubject || !viewerWeek) return;
        const url = `/consultations/fill?preview=true&subject=${viewerSubject}&week=${viewerWeek}`;
        window.open(url, '_blank');
    };

    window.deleteCurrentSoal = () => {
        const q = viewerQuestions[viewerIndex];
        if (!q) return;
        window.showConfirm('Hapus Soal?', 'Soal ini akan dihapus permanen dan tidak bisa dikembalikan.', async () => {
            try {
                const res = await fetch(`${API_URL}/api/onboarding/questions/${q.id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw 0;
                window.showToast?.('success', 'Terhapus', 'Soal berhasil dihapus.');
                viewerQuestions.splice(viewerIndex, 1);
                if (accordionSummary[viewerWeek]) accordionSummary[viewerWeek][viewerSubject] = Math.max(0, (accordionSummary[viewerWeek][viewerSubject] || 1) - 1);
                isSummaryCached = false;
                if (viewerIndex >= viewerQuestions.length) viewerIndex = Math.max(0, viewerQuestions.length - 1);
                renderViewer();
                populateHome();
            } catch { window.showToast?.('danger', 'Error', 'Gagal menghapus soal.'); }
        }, { type: 'danger', confirmText: 'Hapus' });
    };

    // ---- Modal Petunjuk & Template ----
    window.openTemplateModal = () => document.getElementById('modalTemplate').classList.remove('hidden');
    window.closeTemplateModal = () => document.getElementById('modalTemplate').classList.add('hidden');

    // ---- Mode PR (modal) ----
    window.closePRModal = () => document.getElementById('modalPR').classList.add('hidden');
    window.prToggleLock = (subject, week, el) => {
        toggleLockPR(subject, week, el.checked);
        const panel = document.getElementById(`prActionPanel-${week}-${subject}`);
        if (panel) panel.classList.toggle('hidden', !el.checked);
    };
    const buildPRPanel = (subject, week, isLocked, dDays, dTime) => `
        <div class="flex items-center justify-between rounded-[var(--r-lg)] p-3 mb-3" style="background-color: var(--info-soft);">
            <div class="flex items-start gap-3">
                <div class="icon-chip" style="background-color:#fff; color: var(--info);"><i class="fa-solid fa-house-laptop"></i></div>
                <div><h4 class="caption font-semibold" style="color: var(--info);">Bagikan sebagai PR</h4><p class="text-[11px]" style="color: var(--info);">Buka gembok untuk membagikan ke murid.</p></div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input type="checkbox" class="sr-only peer" onchange="prToggleLock('${subject}', ${week}, this)" ${isLocked ? 'checked' : ''}>
                <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--info)]"></div>
            </label>
        </div>
        <div id="prActionPanel-${week}-${subject}" class="${isLocked ? 'block' : 'hidden'} space-y-3">
            <div class="grid grid-cols-2 gap-2">
                <button onclick="copyPRLink('${subject}', ${week})" class="btn !py-3 text-xs" style="background-color: var(--info); color:#fff; border-radius: var(--r-md);"><i class="fa-solid fa-link"></i> Link Biasa</button>
                <button onclick="openResetModal('${subject}', ${week})" class="btn !py-3 text-xs" style="background-color: var(--warning); color:#fff; border-radius: var(--r-md);"><i class="fa-solid fa-clock-rotate-left"></i> Link Reset</button>
            </div>
            <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
                <label class="field-label">Batas Waktu (Deadline)</label>
                <div class="grid grid-cols-2 gap-2 mb-2">
                    <select id="deadlineDays-${week}-${subject}" class="field !py-2 text-xs font-semibold">
                        <option value="0" ${dDays === 0 ? 'selected' : ''}>Hari Ini</option>
                        <option value="1" ${dDays === 1 ? 'selected' : ''}>Besok</option>
                        <option value="2" ${dDays === 2 ? 'selected' : ''}>2 Hari Lagi</option>
                        <option value="3" ${dDays === 3 ? 'selected' : ''}>3 Hari Lagi</option>
                        <option value="7" ${dDays === 7 ? 'selected' : ''}>1 Minggu Lagi</option>
                    </select>
                    <select id="deadlineTime-${week}-${subject}" class="field !py-2 text-xs font-semibold">
                        <option value="12:00" ${dTime === '12:00' ? 'selected' : ''}>12:00 Siang</option>
                        <option value="15:00" ${dTime === '15:00' ? 'selected' : ''}>15:00 Sore</option>
                        <option value="18:00" ${dTime === '18:00' ? 'selected' : ''}>18:00 Maghrib</option>
                        <option value="21:00" ${dTime === '21:00' ? 'selected' : ''}>21:00 Malam</option>
                        <option value="23:59" ${dTime === '23:59' ? 'selected' : ''}>23:59 Penuh</option>
                    </select>
                </div>
                <button onclick="savePRDeadline('${subject}', ${week})" class="btn-soft w-full !py-2 text-xs"><i class="fa-solid fa-floppy-disk"></i> Simpan Deadline</button>
            </div>
            <button onclick="openExtensionModal('${subject}', ${week})" class="btn btn-secondary w-full !py-2.5 text-xs" style="border-style: dashed;"><i class="fa-solid fa-user-clock"></i> Beri Dispensasi (Telat)</button>
        </div>`;
    window.openPRModal = async () => {
        if (!viewerSubject) return;
        const subject = viewerSubject, week = viewerWeek;
        const body = document.getElementById('prModalBody');
        body.innerHTML = `<div class="py-10 text-center"><i class="fa-solid fa-spinner fa-spin text-2xl text-accent"></i></div>`;
        document.getElementById('modalPR').classList.remove('hidden');
        let isLocked = false, dDays = 1, dTime = '23:59';
        try { const r = await fetch(`${API_URL}/api/onboarding/pr-locks/${subject}`, { headers: { 'Authorization': `Bearer ${token}` } }); const d = await r.json(); isLocked = (d.data || []).includes(week); } catch (e) {}
        try {
            const r = await fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` } });
            const d = await r.json();
            if (d.data && d.data.deadline_at) {
                const dl = new Date(d.data.deadline_at); const now = new Date();
                dDays = Math.max(0, Math.ceil((dl - now) / (1000 * 60 * 60 * 24)));
                dTime = `${dl.getHours().toString().padStart(2, '0')}:${dl.getMinutes().toString().padStart(2, '0')}`;
            }
        } catch (e) {}
        body.innerHTML = buildPRPanel(subject, week, isLocked, dDays, dTime);
    };

    // ---- Bulk action (3 tipe + checkbox) ----
    const BULK_HINT = {
        soal: 'Pilih soal yang ingin dihapus dari pertemuan & mapel ini.',
        mapel: 'Pilih mapel — semua soal di dalamnya (pertemuan ini) akan dihapus.',
        pertemuan: 'Pilih pertemuan — semua mapel & soal di dalamnya akan dihapus.'
    };
    window.openBulkModal = () => { bulkType = 'soal'; switchBulkType('soal'); document.getElementById('modalBulk').classList.remove('hidden'); };
    window.closeBulkModal = () => document.getElementById('modalBulk').classList.add('hidden');
    window.switchBulkType = (type) => {
        bulkType = type;
        ['soal', 'mapel', 'pertemuan'].forEach(t => {
            const id = t === 'pertemuan' ? 'bulkTabWeek' : (t === 'mapel' ? 'bulkTabMapel' : 'bulkTabSoal');
            document.getElementById(id).className = (t === type) ? 'seg-btn is-active' : 'seg-btn';
        });
        document.getElementById('bulkHint').textContent = BULK_HINT[type];
        document.getElementById('bulkSelectAll').checked = false;
        renderBulkChecklist(type);
    };
    const renderBulkChecklist = (type) => {
        const box = document.getElementById('bulkChecklist');
        let rows = [];
        if (type === 'soal') {
            rows = viewerQuestions.map((q, i) => ({ val: q.id, label: `${i + 1}. ${(q.question || '').replace(/\[BLANK\]/g, '___').slice(0, 70)}` }));
        } else if (type === 'mapel') {
            const c = accordionSummary[viewerWeek] || {};
            rows = SUBJECTS.filter(s => (c[s] || 0) > 0).map(s => ({ val: s, label: `${SUBJECT_ICON[s]} ${SUBJECT_LABEL[s]} — ${c[s]} soal` }));
        } else {
            rows = Object.keys(accordionSummary).map(Number).sort((a, b) => a - b).map(w => {
                const c = accordionSummary[w]; const t = (c.tajwid || 0) + (c.fiqih || 0) + (c.tauhid || 0);
                return { val: w, label: `Pertemuan ${w} — ${t} soal` };
            });
        }
        box.innerHTML = rows.length ? rows.map(r => `
            <label class="card card-pad !p-3 flex items-center gap-3 cursor-pointer">
                <input type="checkbox" class="bulk-item w-4 h-4 rounded cursor-pointer flex-shrink-0" style="accent-color: var(--danger);" value="${r.val}" onchange="bulkUpdateCount()">
                <span class="caption text-ink leading-snug">${r.label}</span>
            </label>`).join('') : `<div class="empty-state"><p class="caption font-semibold">Tidak ada item.</p></div>`;
        bulkUpdateCount();
    };
    window.bulkToggleAll = (checked) => { document.querySelectorAll('#bulkChecklist .bulk-item').forEach(cb => cb.checked = checked); bulkUpdateCount(); };
    window.bulkUpdateCount = () => {
        const all = [...document.querySelectorAll('#bulkChecklist .bulk-item')];
        const sel = all.filter(cb => cb.checked).length;
        document.getElementById('bulkSelCount').textContent = sel;
        document.getElementById('bulkSelectAll').checked = (sel === all.length && all.length > 0);
    };
    const fetchQuestionIds = async (week, subject) => {
        const r = await fetch(`${API_URL}/api/onboarding/questions/${subject}?week=${week}`, { headers: { 'Authorization': `Bearer ${token}` } });
        const d = await r.json(); return (d.data || []).map(q => q.id);
    };
    window.executeBulk = () => {
        const checked = [...document.querySelectorAll('#bulkChecklist .bulk-item:checked')];
        if (!checked.length) return window.showToast?.('warning', 'Perhatian', 'Pilih minimal 1 item.');
        const vals = checked.map(cb => cb.value);
        const title = bulkType === 'soal' ? 'Hapus Soal Terpilih?'
            : bulkType === 'mapel' ? 'Hapus Mapel Terpilih?'
            : 'Hapus Pertemuan Terpilih?';
        const msg = bulkType === 'soal' ? `${vals.length} soal akan dihapus permanen.`
            : bulkType === 'mapel' ? `${vals.length} mapel di Pertemuan ${viewerWeek} beserta SEMUA soalnya akan dihapus permanen.`
            : `${vals.length} pertemuan beserta SEMUA mapel & soal di dalamnya akan dihapus permanen.`;

        window.showConfirm(title, msg, async () => {
            const btn = document.getElementById('btnExecuteBulk');
            const old = btn.innerHTML; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menghapus...'; btn.disabled = true;
            try {
                let ids = [];
                if (bulkType === 'soal') {
                    ids = vals;
                } else if (bulkType === 'mapel') {
                    for (const s of vals) ids.push(...await fetchQuestionIds(viewerWeek, s));
                } else {
                    for (const w of vals) for (const s of SUBJECTS) { if ((accordionSummary[w] || {})[s] > 0) ids.push(...await fetchQuestionIds(w, s)); }
                }
                await Promise.all(ids.map(id => fetch(`${API_URL}/api/onboarding/questions/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } })));
                window.showToast?.('success', 'Berhasil', `${ids.length} soal dihapus.`);
                isSummaryCached = false;
                Object.keys(soalCache).forEach(k => delete soalCache[k]);
                await fetchAccordion();
                closeBulkModal();
                const stillThere = accordionSummary[viewerWeek] && (accordionSummary[viewerWeek][viewerSubject] || 0) > 0;
                if (stillThere) { loadAndShowViewer(viewerWeek, viewerSubject, { keepIndex: true }); }
                else {
                    document.getElementById('soalViewerSection').classList.add('hidden');
                    document.getElementById('btnPilihPertemuan').classList.remove('hidden');
                    document.getElementById('bankSoalEmpty').classList.remove('hidden');
                }
            } catch (e) {
                window.showToast?.('danger', 'Error', 'Gagal menghapus sebagian/semua item.');
            } finally { btn.innerHTML = old; btn.disabled = false; }
        }, { type: 'danger', confirmText: 'Hapus' });
    };

    // INIT
    fetchAccordion();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { from { transform: translateY(30px) scale(0.95); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    .accordion-body { display: block; }
    .accordion-body.hidden { display: none !important; }
    .toast-container, [id^="toast"], .toast { 
        z-index: 2147483647 !important; 
    }
</style>