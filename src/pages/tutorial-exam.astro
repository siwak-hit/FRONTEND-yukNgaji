---
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';
---

<Layout title="Tutorial Ujian - yukNgaji">
    <audio id="bgmTutorial" src="/audio/tutorial-bgm.mp3" loop></audio>

    <div id="tutorialBackdrop" class="fixed inset-0 bg-slate-900/75 backdrop-blur-sm z-[200] hidden transition-opacity duration-500 pointer-events-none"></div>

    <div id="mockStartScreen" class="fixed inset-0 flex flex-col items-center justify-center p-6 bg-slate-50 z-10 transition-all duration-500">
        <div class="bg-white border-4 border-indigo-100 rounded-3xl p-8 max-w-sm w-full text-center shadow-xl">
            <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                <i class="fa-solid fa-rocket"></i>
            </div>

            <h2 class="text-2xl font-black text-gray-800 mb-1">Siap Memulai?</h2>
            <p class="text-lg font-black text-indigo-600 mb-6">Siswa Tutorial</p>

            <div class="bg-slate-50 border border-gray-100 p-4 rounded-xl text-left mb-6">
                <p class="text-xs font-bold text-gray-500">
                    Persiapkan dirimu. Beli tambahan waktu di Toko Sihir jika perlu sebelum ujian dimulai!
                </p>
            </div>

            <button class="w-full py-4 bg-indigo-200 text-indigo-500 font-black rounded-xl cursor-not-allowed" disabled>
                MULAI SEKARANG
            </button>
        </div>
    </div>

    <!-- Parent inilah yang di-highlight, bukan button anaknya -->
    <div id="shopPanelStart" class="fixed bottom-6 right-6 z-[150] transition-all">
        <button id="tutShopBtn" onclick="handleShopBtnClick()" title="Buka Toko Sihir"
            class="w-14 h-14 bg-indigo-600 text-white rounded-[1.25rem] shadow-[0_8px_20px_rgba(79,70,229,0.4)] flex items-center justify-center text-xl hover:bg-indigo-700 hover:-translate-y-1 active:scale-95 transition-all outline-none border-2 border-indigo-400/50">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>

    <div class="exam-shell relative min-h-screen bg-slate-50 hidden opacity-0 transition-opacity duration-500" id="tutorialContainer">
        <header class="exam-header bg-white border-b border-slate-200 p-4 flex justify-between items-center relative z-10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center font-black text-indigo-600">
                    TU
                </div>
                <div class="text-sm font-bold text-gray-800">Siswa Tutorial</div>
            </div>

            <div class="timer-pill transition-all duration-500 border-2 border-slate-200 px-4 py-2 rounded-2xl bg-white flex items-center gap-2" id="tutTimer">
                <i class="fa-solid fa-stopwatch text-gray-400"></i>
                <span id="tutTimerText" class="font-black text-gray-700 text-sm">60:00</span>
            </div>

            <div class="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-full" id="tutProgress">
                1 / 2
            </div>
        </header>

        <main class="exam-main p-6 max-w-2xl mx-auto flex flex-col gap-6">
            <div class="question-card bg-white p-8 rounded-3xl border-2 border-slate-100 shadow-sm" id="tutQuestionCard">
                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mb-3">
                    Soal 1 · Pilihan Ganda
                </p>
                <h2 class="text-xl font-black text-gray-800 text-center">
                    Apa hukum bacaan jika Nun Mati bertemu huruf Ba'?
                </h2>
            </div>

            <div class="grid grid-cols-1 gap-3" id="tutOptions">
                <button onclick="clickOptionTutorial(this, 'A')" data-option="A"
                    class="p-4 bg-white border-2 border-slate-200 rounded-2xl text-left font-bold text-gray-600 transition-all flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50">
                    <div class="w-10 h-10 flex-shrink-0 items-center justify-center bg-slate-50 rounded-xl border-2 border-slate-200 flex font-black">
                        A
                    </div>
                    <span>Idzhar Halqi</span>
                </button>

                <button onclick="clickOptionTutorial(this, 'B')" data-option="B"
                    class="p-4 bg-white border-2 border-slate-200 rounded-2xl text-left font-bold text-gray-600 transition-all flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50">
                    <div class="w-10 h-10 flex-shrink-0 items-center justify-center bg-slate-50 rounded-xl border-2 border-slate-200 flex font-black">
                        B
                    </div>
                    <span>Iqlab</span>
                </button>
            </div>

            <div id="phase2Mock" class="hidden flex-col items-center gap-6 w-full">
                <div class="bg-white border-2 border-slate-100 p-4 rounded-3xl w-full flex justify-between items-center shadow-sm">
                    <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">
                        Soal 2 · Mode Mengetik
                    </p>
                    <span id="phase2Progress" class="text-[10px] font-black text-gray-400">
                        0 / 1 terisi
                    </span>
                </div>

                <div class="bg-indigo-50/50 border-2 border-indigo-100 p-6 rounded-3xl w-full text-center shadow-inner">
                    <h2 class="text-xl md:text-2xl font-black text-indigo-900 leading-relaxed">
                        Jawab pertanyaan dibawah ini:
                    </h2>
                </div>

                <div id="arcadeTargetBlocks" class="flex flex-wrap justify-center items-center gap-2 w-full min-h-[60px]">
                    <span class="text-xl font-black text-indigo-900">Rukun iman itu ada</span>

                    <div id="targetBlock0" class="target-block" data-answer="enam">
                        <span class="block-text text-slate-300 font-black text-xl">_ _ _ _ _</span>
                    </div>
                </div>

                <div id="arcadeInputWrapper" class="relative flex flex-col items-center justify-center mt-8 w-full flex-1 min-h-[160px] z-10 bg-slate-50/40 rounded-[2rem] border-2 border-dashed border-indigo-200 cursor-text hover:bg-slate-50/80 transition-colors" onclick="document.getElementById('arcadeInput').focus()">

                    <div id="arcadeVisualText" class="text-4xl md:text-5xl font-black text-indigo-600 uppercase tracking-widest pointer-events-none select-none w-full text-center transition-all px-4 break-words">
                        <span class="text-gray-400 text-xl md:text-2xl lowercase tracking-normal font-bold">Ketik di sini...</span>
                    </div>

                    <textarea id="arcadeInput" disabled
                        class="absolute inset-0 w-full h-full opacity-0 z-20 resize-none outline-none text-transparent bg-transparent cursor-text"
                        autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="none"></textarea>
                </div>

                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest text-center">
                    Tekan <strong class="text-indigo-500">SPASI</strong> atau <strong class="text-indigo-500">ENTER</strong> setelah mengetik
                </p>
            </div>
        </main>

        <Mascot />

        <button id="tutHintBtn" onclick="openHintModalTutorial()"
            class="hidden fixed bottom-10 right-6 w-14 h-14 bg-amber-500 text-white rounded-2xl shadow-[0_6px_0_#b45309] flex items-center justify-center text-2xl transition-all hover:-translate-y-1 active:translate-y-2 active:shadow-none z-[150]">
            <i class="fa-solid fa-lightbulb"></i>
        </button>
    </div>

    <div id="shopDrawer" class="fixed inset-0 z-[300] hidden items-end justify-center pointer-events-none">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm pointer-events-auto" onclick="handleShopBackdropClick()"></div>

        <div id="drawerContent" class="relative w-full max-w-md bg-white rounded-t-[2.5rem] p-8 transform translate-y-full transition-transform duration-500 pointer-events-auto border-t-4 border-indigo-500 shadow-[0_-10px_40px_rgba(0,0,0,0.2)]">
            <div class="flex justify-between items-center mb-6">
                <h3 class="font-black text-gray-800 text-xl">Pasar Sihir 🔮</h3>

                <div class="bg-amber-100 px-4 py-2 rounded-2xl border-2 border-amber-200 flex items-center gap-2">
                    <span>💰</span>
                    <span id="shopWallet" class="font-black text-amber-600 transition-all duration-300">500</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-4">
                <button id="btnBuyTimeTut" onclick="buyTimeTutorial(1, 100)"
                    class="p-3 rounded-2xl border-2 border-slate-100 hover:bg-indigo-50 active:scale-95 transition-all text-left">
                    <span class="block font-black text-sm text-gray-800">+1 Menit</span>
                    <span class="text-[10px] font-bold text-amber-600 mt-1 block">💰 100 Koin</span>
                </button>

                <button class="p-3 rounded-2xl border-2 border-slate-100 opacity-40 grayscale pointer-events-none text-left">
                    <span class="block font-black text-sm text-gray-800">+2 Menit</span>
                    <span class="text-[10px] font-bold text-amber-600 mt-1 block">💰 200 Koin</span>
                </button>

                <button class="p-3 rounded-2xl border-2 border-slate-100 opacity-40 grayscale pointer-events-none text-left">
                    <span class="block font-black text-sm text-gray-800">+5 Menit</span>
                    <span class="text-[10px] font-bold text-amber-600 mt-1 block">💰 500 Koin</span>
                </button>

                <button class="p-3 rounded-2xl border-2 border-slate-100 opacity-40 grayscale pointer-events-none text-left">
                    <span class="block font-black text-sm text-gray-800">+10 Menit</span>
                    <span class="text-[10px] font-bold text-amber-600 mt-1 block">💰 1000 Koin</span>
                </button>
            </div>

            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 mb-6 opacity-40">
                <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-2">
                    Beli Bebas (1 Mnt = 100 Koin)
                </p>

                <div class="flex gap-2">
                    <input type="number" disabled placeholder="Terkunci di tutorial..."
                        class="w-full px-4 py-3 text-sm font-bold bg-white border border-gray-200 rounded-xl outline-none">

                    <button disabled class="bg-gray-300 text-white px-5 py-3 rounded-xl font-black text-xs">
                        Beli
                    </button>
                </div>
            </div>

            <button id="btnCloseShopTut" onclick="handleCloseShopClick()"
                class="w-full py-3 bg-gray-100 rounded-xl text-gray-500 font-bold text-xs hover:bg-gray-200 transition-colors">
                Tutup Toko
            </button>
        </div>
    </div>

    <div id="modalHint" class="fixed inset-0 z-[400] hidden items-center justify-center p-4 pointer-events-none">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm pointer-events-auto"></div>

        <div class="bg-white w-full max-w-sm rounded-[2rem] p-8 text-center shadow-2xl relative pointer-events-auto border-2 border-amber-400 animate-slide-up">
            <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 border border-amber-100 shadow-inner">
                <i class="fa-solid fa-lightbulb animate-pulse"></i>
            </div>

            <h3 class="text-xl font-black text-gray-800 mb-4">Clue Ustadz</h3>

            <div id="hintTextContent" class="text-sm font-bold text-gray-700 bg-amber-50 border-2 border-dashed border-amber-200 rounded-xl p-4">
                "Ingat, Ba' adalah <strong>satu-satunya huruf</strong> milik hukum Iqlab. Kalau ketemu Ba', pasti Iqlab!"
            </div>

            <p class="text-[10px] font-bold text-gray-400 mt-4 uppercase tracking-widest">
                Menutup otomatis dalam <span id="hintCountdown">5</span> detik...
            </p>
        </div>
    </div>

    <div id="tutModalWrap" class="fixed inset-0 z-[600] pointer-events-none flex items-center justify-center p-6 transition-all duration-300">
        <div id="tutModalCard"
            class="bg-white w-full max-w-sm rounded-[2rem] p-8 shadow-[0_20px_60px_rgba(0,0,0,0.3)] border-4 border-indigo-500 pointer-events-auto relative transition-all duration-300 hidden">
            <div id="tutStepBadge" class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-[10px] font-black px-3 py-1 rounded-full tracking-widest uppercase">
                Langkah 1
            </div>

            <div id="tutModalIcon" class="w-16 h-16 rounded-full bg-indigo-50 text-indigo-500 flex items-center justify-center text-3xl mb-4 mx-auto border-2 border-indigo-100 shadow-inner">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h3 id="tutModalTitle" class="text-xl font-black text-gray-800 text-center mb-2">
                Memuat...
            </h3>

            <p id="tutModalDesc" class="text-sm font-bold text-gray-500 text-center leading-relaxed mb-6">
                Harap tunggu sebentar.
            </p>

            <button id="btnNextTutorial" onclick="handleNextStep()"
                class="w-full py-4 bg-indigo-600 text-white font-black rounded-xl transition-all flex items-center justify-center gap-2 shadow-[0_6px_0_#4f46e5]">
                <span id="btnNextText">Mengerti</span>
                <i id="btnNextIcon" class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <div id="tutToastCard"
            class="fixed top-6 right-4 md:right-6 bg-white w-72 rounded-2xl p-4 shadow-[0_12px_40px_rgba(0,0,0,0.2)] border-2 border-indigo-200 pointer-events-none hidden transition-all duration-300 z-[650]">
            <div class="flex items-start gap-3">
                <div id="tutToastIcon" class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-500 flex-shrink-0 flex items-center justify-center text-base border border-indigo-100">
                    <i class="fa-solid fa-star"></i>
                </div>

                <div class="flex-1 min-w-0">
                    <p id="tutToastTitle" class="text-sm font-black text-gray-800 mb-0.5"></p>
                    <p id="tutToastDesc" class="text-xs font-bold text-gray-500 leading-relaxed"></p>

                    <button id="btnNextToastTutorial" onclick="handleNextStep()"
                        class="hidden mt-3 w-full py-2.5 bg-indigo-600 text-white font-black rounded-xl text-xs shadow-[0_4px_0_#4f46e5] active:translate-y-1 active:shadow-none transition-all">
                        <span id="btnNextToastText">Lanjut</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js" is:inline defer></script>
<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const urlParams = new URLSearchParams(window.location.search);
    const returnUrl = urlParams.get('returnUrl') ? decodeURIComponent(urlParams.get('returnUrl')) : '/';
    const isPreview = urlParams.get('preview') === 'true';
    const studentId = urlParams.get('studentId');
    const token = urlParams.get('token') || localStorage.getItem('token');

    const tutorialContext = urlParams.get('tutorial_context') || '';
    const studentTutorialSubject = urlParams.get('student_tutorial_subject') || '';

    const normalizeSubjectKey = (subject = '') => {
        return String(subject)
            .trim()
            .toLowerCase()
            .replace(/\s+/g, '_')
            .replace(/[^\w-]/g, '');
    };

    function markStudentSubjectTutorialSeen() {
        if (tutorialContext !== 'student') return;
        if (!studentId || !studentTutorialSubject) return;

        const subjectKey = normalizeSubjectKey(studentTutorialSubject);
        const storageKey = `exam_tutorial_seen_subjects_${studentId}`;

        try {
            const current = JSON.parse(localStorage.getItem(storageKey) || '[]');
            const safeCurrent = Array.isArray(current) ? current : [];

            if (!safeCurrent.includes(subjectKey)) {
                safeCurrent.push(subjectKey);
                localStorage.setItem(storageKey, JSON.stringify(safeCurrent));
            }
        } catch (e) {
            localStorage.setItem(storageKey, JSON.stringify([subjectKey]));
        }
    }

    let currentStep = 0;
    let poin = 500;
    let minutes = 60;
    let hintTimer = null;
    let infoModalCallback = null;
    let autoHideTimer = null;
    let nextBtnTimer = null;

    // [FIX] Lock supaya action tutorial tidak bisa dieksekusi dobel
    let tutorialActionLocked = false;
    let stepAdvanceLocked = false;

    const steps = [
        {
            id: "welcome",
            mode: "center",
            icon: "fa-graduation-cap",
            iconColor: "indigo",
            title: "Selamat Datang! 👋",
            desc: "Ini adalah mode Ujian yukNgaji. Ikuti panduan singkat ini agar kamu bisa menggunakan semua fitur dengan lancar dan meraih nilai terbaik!",
            btnText: "Ayo Mulai!",
            interactive: false,
            backdrop: true,
        },
        {
            id: "intro_shop",
            mode: "center",
            icon: "fa-cart-shopping",
            iconColor: "indigo",
            title: "Toko Sihir 🛒",
            desc: "Waktumu terbatas! Sebelum ujian dimulai, kamu bisa membeli tambahan waktu di Toko Sihir. Yuk, coba klik tombol keranjang di pojok kanan bawah!",
            highlight: "shopPanelStart",
            interactive: true,
            backdrop: true,
        },
        {
            id: "buy_time",
            mode: "toast",
            icon: "fa-magic-sparkles",
            iconColor: "indigo",
            title: "Beli Waktu! ⏰",
            desc: "Laci Pasar Sihir terbuka! Kamu punya 500 koin. Coba klik tombol '+1 Menit' untuk membeli tambahan waktu ujian.",
            highlight: "btnBuyTimeTut",
            interactive: true,
            backdrop: false,
            autoHide: 3000,
        },
        {
            id: "close_shop",
            mode: "top",
            icon: "fa-stopwatch",
            iconColor: "green",
            title: "Waktumu Bertambah! 🎉",
            desc: "Timer di atas sudah berubah! Sekarang tutup laci Toko Sihir dengan klik tombol 'Tutup Toko' di bawah.",
            highlight: "btnCloseShopTut",
            interactive: true,
            backdrop: false,
            autoHide: 3000,
            action: () => setCloseShopEnabled(false),
        },
        {
            id: "timer_info",
            mode: "top",
            icon: "fa-stopwatch",
            iconColor: "green",
            title: "Waktu Bertambah! 🎉",
            desc: "Hebat! Lihat Timer di atas yang bersinar terang! Waktumu sudah bertambah. Mari kita lanjutkan ke soal.",
            highlight: "tutTimer",
            backdrop: true,
            interactive: false,
            btnText: "Lanjut ke Soal",
            action: () => {
                document.getElementById('shopPanelStart')?.classList.add('hidden');
                document.getElementById('mockStartScreen')?.classList.add('hidden');

                const examContainer = document.getElementById('tutorialContainer');
                if (examContainer) {
                    examContainer.classList.remove('hidden');
                    setTimeout(() => examContainer.classList.remove('opacity-0'), 50);
                }

                document.getElementById('tutHintBtn')?.classList.remove('hidden');
            },
        },
        {
            id: "intro_hint",
            mode: "center",
            icon: "fa-lightbulb",
            iconColor: "amber",
            title: "Tombol Bantuan 💡",
            desc: "Kalau kamu mentok saat mengerjakan soal, gunakan tombol Bantuan di pojok kanan bawah ini untuk mendapat petunjuk dari Ustadz. Coba klik!",
            highlight: "tutHintBtn",
            interactive: true,
            backdrop: true,
        },
        {
            id: "miaw_alert",
            mode: "toast",
            icon: "fa-cat",
            iconColor: "indigo",
            title: "Tunggu sebentar... 🤫",
            desc: "Apakah kamu mendengar suara itu? Sepertinya ada tamu tak diundang yang ingin ikut ujian...",
            btnText: "Dengar Lebih Jelas",
            interactive: false,
            backdrop: false,
            action: () => {
                const audio = new Audio('/audio/miaww.mp3');
                audio.play().catch(() => {});
            },
        },
        {
            id: "miaw_intro",
            mode: "toast",
            icon: "fa-cat",
            iconColor: "indigo",
            title: "Kenalkan, ini Miaw! 🐈",
            desc: "Dia adalah maskot yang akan menemanimu. Kamu bisa klik tubuhnya untuk memanggilnya mendekat. Dia bisa membantumu menghentikan waktu lho!",
            btnText: "Wah, Keren!",
            interactive: false,
            backdrop: false,
            action: () => {
                // [FIX] Tampilkan container dulu supaya canvas Lottie tidak 0x0
                showTutorialMascot();

                // Baru jalankan animasi Lottie setelah container sudah visible
                setTimeout(() => {
                    if (window.MiawMascot) {
                        window.MiawMascot.show();
                    }
                }, 80);
            },
        },
        {
            id: "miaw_button_guide",
            mode: "toast",
            icon: "fa-cat",
            iconColor: "indigo",
            title: "Tombol Pengusir 🚫",
            desc: "Kamu juga bisa mengusirnya lewat tombol kucing di pojok kiri bawah. Tapi hati-hati, jangan usir dia lebih dari sekali atau dia akan marah dan memotong waktumu!",
            highlight: "btnToggleCat",
            interactive: false,
            backdrop: false,
            btnText: "Lalu?",
        },
        {
            id: "miaw_prank_warning",
            mode: "toast",
            icon: "fa-ghost",
            iconColor: "indigo",
            title: "Hati-hati Jahil! 👻",
            desc: "Jika didiamkan terlalu lama tanpa diusir atau dipanggil, Miaw akan pergi sendiri dan menjahilimu dengan cara menyembunyikan soal ujian! Jadi waspada ya.",
            interactive: false,
            backdrop: false,
            btnText: "Siap, Paham!",
            action: () => {
                document.body.classList.remove('tutorial-miaw-inline');

                if (window.MiawMascot) {
                    const state = window.MiawMascot.getState();

                    if (!state.isDismissed) {
                        const mascot = document.getElementById('mascot-container');

                        if (mascot) {
                            // Jeda 2 detik, baru geser keluar ke kanan
                            setTimeout(() => {
                                mascot.classList.remove('tutorial-miaw-enter');
                                mascot.classList.add('tutorial-miaw-exit');
                                mascot.style.transition = 'right 1.2s ease-in, transform 1.2s ease-in, opacity 0.8s ease';
                                mascot.style.right = '-250px';
                                mascot.style.transform = 'translateX(0) translateY(0) scale(1)';
                                mascot.style.opacity = '0';

                                setTimeout(() => {
                                    window.MiawMascot.toggle();
                                }, 1200);
                            }, 2000);
                        } else {
                            window.MiawMascot.toggle();
                        }
                    }
                }
            },
        },
        {
            id: "mc_instruction",
            mode: "center",
            icon: "fa-list-check",
            iconColor: "indigo",
            title: "Soal Pilihan Ganda 📝",
            desc: "Untuk soal pilihan ganda, kamu cukup tap salah satu opsi yang kamu anggap benar. Jawaban yang dipilih akan langsung tersimpan otomatis.",
            interactive: false,
            backdrop: true,
            btnText: "Siap, Kerjakan!",
            action: () => {
                // Saat modal instruksi tampil, Miaw dan tombolnya turun di bawah backdrop
                setTutorialMascotUnderBackdrop(true);
            },
        },
        {
            id: "mc_q1",
            mode: "toast",
            icon: "fa-1",
            iconColor: "indigo",
            title: "Soal 1 — Yuk mulai!",
            desc: "Pilih jawaban yang kamu anggap benar. Kamu bisa lihat soalnya di bawah.",
            highlight: "tutOptions",
            interactive: true,
            backdrop: false,
            action: () => {
                // Setelah modal instruksi hilang, Miaw dan tombolnya kelihatan lagi
                setTutorialMascotUnderBackdrop(false);
            },
        },
        {
            id: "typing_instruction",
            mode: "center",
            icon: "fa-keyboard",
            iconColor: "indigo",
            title: "Mode Mengetik ⌨️",
            desc: "Ada jenis soal lain: Mode Mengetik! Kamu harus mengetik kata yang tepat untuk mengisi kotak kosong dalam pernyataan di atas.",
            interactive: false,
            backdrop: true,
            btnText: "Paham!",
            action: () => {
                document.getElementById('tutQuestionCard')?.classList.add('hidden');
                document.getElementById('tutOptions')?.classList.add('hidden');

                document.getElementById('tutHintBtn')?.classList.add('hidden');

                hideTutorialMascot();

                const progress = document.getElementById('tutProgress');
                if (progress) progress.innerText = '2 / 2';

                const phase2 = document.getElementById('phase2Mock');
                if (phase2) phase2.classList.replace('hidden', 'flex');

                const input = document.getElementById('arcadeInput');
                if (input) {
                    input.removeAttribute('disabled');
                    setTimeout(() => input.focus(), 300);
                }
            },
        },
        {
            id: "typing_task",
            mode: "toast",
            icon: "fa-keyboard",
            iconColor: "indigo",
            title: "Ketik jawabannya!",
            desc: "Isi kotak kosong pada pernyataan. Tekan SPASI atau ENTER setelah mengetik.",
            highlight: "arcadeInputWrapper", // <--- UBAH DI SINI
            interactive: true,
            backdrop: false,
            action: () => {
                const input = document.getElementById('arcadeInput');
                if (input) input.focus();
            },
        },
        {
            id: "finish",
            mode: "center",
            icon: "fa-star",
            iconColor: "gold",
            title: "Kamu Siap! 🎓",
            desc: "Luar biasa! Kamu sudah memahami semua fitur ujian yukNgaji. Tetap tenang, baca soal dengan teliti, dan berikan yang terbaik!",
            interactive: false,
            isFinal: true,
            backdrop: true,
            btnText: "Mulai Ujian Sesungguhnya",
        },
    ];

    function updateTutorialUI() {
        const step = steps[currentStep];
        if (!step) return;

        const backdrop = document.getElementById('tutorialBackdrop');
        const modalCard = document.getElementById('tutModalCard');
        const toastCard = document.getElementById('tutToastCard');
        const modalWrap = document.getElementById('tutModalWrap');
        const btnNext = document.getElementById('btnNextTutorial');
        const toastBtn = document.getElementById('btnNextToastTutorial');
        const toastBtnText = document.getElementById('btnNextToastText');

        if (!backdrop || !modalCard || !toastCard || !modalWrap || !btnNext) return;

        document.querySelectorAll('.tutorial-highlight').forEach(el => {
            el.classList.remove('tutorial-highlight');
        });

        if (autoHideTimer) clearTimeout(autoHideTimer);
        if (nextBtnTimer) clearInterval(nextBtnTimer);

        if (step.action) step.action();

        if (step.backdrop) {
            backdrop.classList.remove('hidden');
            backdrop.style.pointerEvents = 'none';
        } else {
            backdrop.classList.add('hidden');
        }

        if (step.highlight) {
            const el = document.getElementById(step.highlight);
            if (el) el.classList.add('tutorial-highlight');
        }

        if (step.mode === 'toast') {
            modalCard.classList.add('hidden');
            modalCard.style.display = 'none';

            modalWrap.style.alignItems = 'flex-start';
            modalWrap.style.justifyContent = 'flex-end';
            modalWrap.style.paddingTop = '24px';
            modalWrap.style.pointerEvents = 'none';

            document.getElementById('tutToastIcon').innerHTML = `<i class="fa-solid ${step.icon}"></i>`;
            document.getElementById('tutToastTitle').innerText = step.title;
            document.getElementById('tutToastDesc').innerText = step.desc;

            toastCard.classList.remove('hidden');

            toastCard.style.display = '';
            toastCard.style.opacity = '1';
            toastCard.style.transform = 'translateY(0)';
            toastCard.style.transition = '';

            if (toastBtn && toastBtnText) {
                if (!step.interactive) {
                    toastCard.classList.remove('pointer-events-none');
                    toastCard.style.pointerEvents = 'auto';

                    toastBtn.classList.remove('hidden');
                    toastBtn.disabled = true;
                    toastBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    toastBtn.classList.remove('active:translate-y-1', 'active:shadow-none');

                    let delay = 3;
                    const originalText = step.btnText || 'Lanjut';
                    toastBtnText.innerText = `${originalText} (${delay})`;

                    nextBtnTimer = setInterval(() => {
                        delay--;

                        if (delay > 0) {
                            toastBtnText.innerText = `${originalText} (${delay})`;
                        } else {
                            clearInterval(nextBtnTimer);
                            toastBtnText.innerText = originalText;
                            toastBtn.disabled = false;
                            toastBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                            toastBtn.classList.add('active:translate-y-1', 'active:shadow-none');
                        }
                    }, 1000);
                } else {
                    toastCard.classList.add('pointer-events-none');
                    toastCard.style.pointerEvents = '';
                    toastBtn.classList.add('hidden');
                    toastBtn.disabled = true;
                }
            }
        } else {
            toastCard.classList.add('hidden');

            if (toastBtn) {
                toastBtn.classList.add('hidden');
                toastBtn.disabled = true;
            }

            modalWrap.style.alignItems = step.mode === 'top' ? 'flex-start' : 'center';
            modalWrap.style.justifyContent = 'center';
            modalWrap.style.paddingTop = step.mode === 'top' ? '70px' : '24px';
            modalWrap.style.pointerEvents = 'none';

            const iconColorMap = {
                indigo: 'bg-indigo-50 text-indigo-500 border-indigo-100',
                amber: 'bg-amber-50 text-amber-500 border-amber-100',
                green: 'bg-green-50 text-green-500 border-green-100',
                gold: 'bg-yellow-50 text-yellow-500 border-yellow-100',
            };

            const iconClass = iconColorMap[step.iconColor] || iconColorMap.indigo;
            const tutModalIcon = document.getElementById('tutModalIcon');
            const tutModalTitle = document.getElementById('tutModalTitle');
            const tutModalDesc = document.getElementById('tutModalDesc');
            const tutStepBadge = document.getElementById('tutStepBadge');
            const btnNextText = document.getElementById('btnNextText');
            const btnNextIcon = document.getElementById('btnNextIcon');

            if (tutModalIcon) {
                tutModalIcon.className = `w-16 h-16 rounded-full flex items-center justify-center text-3xl mb-4 mx-auto border-2 shadow-inner ${iconClass}`;
                tutModalIcon.innerHTML = `<i class="fa-solid ${step.icon}"></i>`;
            }

            if (tutModalTitle) tutModalTitle.innerText = step.title;
            if (tutModalDesc) tutModalDesc.innerText = step.desc;
            if (tutStepBadge) tutStepBadge.innerText = `Langkah ${currentStep + 1}`;

            if (step.interactive) {
                btnNext.classList.add('hidden');
            } else {
                btnNext.classList.remove('hidden');

                let delay = 3;
                const originalText = step.btnText || (step.isFinal ? "Mulai Ujian Sesungguhnya" : "Mengerti");

                btnNext.disabled = true;
                btnNext.classList.add('opacity-50', 'cursor-not-allowed');
                btnNext.classList.remove('active:scale-95');

                if (btnNextText) btnNextText.innerText = `${originalText} (${delay})`;

                if (step.isFinal) {
                    btnNext.className = 'w-full py-4 bg-green-500 text-white font-black rounded-xl shadow-[0_6px_0_#16a34a] opacity-50 cursor-not-allowed';
                    if (btnNextIcon) btnNextIcon.className = "fa-solid fa-flag-checkered";

                    if (typeof confetti !== 'undefined') {
                        confetti({
                            particleCount: 200,
                            spread: 100,
                            origin: { y: 0.5 },
                            zIndex: 1000,
                        });
                    }
                } else {
                    btnNext.className = 'w-full py-4 bg-indigo-600 text-white font-black rounded-xl shadow-[0_6px_0_#4f46e5] opacity-50 cursor-not-allowed';
                    if (btnNextIcon) btnNextIcon.className = "fa-solid fa-arrow-right";
                }

                nextBtnTimer = setInterval(() => {
                    delay--;

                    if (delay > 0) {
                        if (btnNextText) btnNextText.innerText = `${originalText} (${delay})`;
                    } else {
                        clearInterval(nextBtnTimer);
                        if (btnNextText) btnNextText.innerText = originalText;

                        btnNext.disabled = false;
                        btnNext.classList.remove('opacity-50', 'cursor-not-allowed');
                        btnNext.classList.add('active:scale-95');
                    }
                }, 1000);
            }

            const borderMap = {
                indigo: 'border-indigo-500',
                amber: 'border-amber-400',
                green: 'border-green-400',
                gold: 'border-yellow-400',
            };

            modalCard.className = `bg-white w-full max-w-sm rounded-[2rem] p-8 shadow-[0_20px_60px_rgba(0,0,0,0.3)] border-4 ${borderMap[step.iconColor] || 'border-indigo-500'} pointer-events-auto relative transition-all duration-300`;
            modalCard.classList.remove('hidden');
            modalCard.style.display = '';
            modalCard.style.opacity = '1';
            modalCard.style.transform = 'translateY(0)';
            modalCard.style.pointerEvents = 'auto';
        }

        if (step.autoHide) {
            autoHideTimer = setTimeout(() => {
                const activeCard = step.mode === 'toast' ? toastCard : modalCard;

                if (activeCard && !activeCard.classList.contains('hidden')) {
                    activeCard.style.transition = 'all 0.4s ease';
                    activeCard.style.opacity = '0';
                    activeCard.style.transform = 'translateY(-20px)';

                    setTimeout(() => {
                        activeCard.classList.add('hidden');
                        activeCard.style.display = 'none';
                        activeCard.style.opacity = '';
                        activeCard.style.transform = '';

                        if (steps[currentStep]?.id === 'close_shop') {
                            setCloseShopEnabled(true);
                        }
                    }, 400);
                } else if (steps[currentStep]?.id === 'close_shop') {
                    setCloseShopEnabled(true);
                }
            }, step.autoHide);
        }
    }

    function lockTutorialAction(duration = 800) {
        if (tutorialActionLocked) return true;

        tutorialActionLocked = true;

        setTimeout(() => {
            tutorialActionLocked = false;
        }, duration);

        return false;
    }

    function safeNextStep(delay = 0) {
        if (stepAdvanceLocked) return;

        stepAdvanceLocked = true;

        setTimeout(() => {
            handleNextStep();

            setTimeout(() => {
                stepAdvanceLocked = false;
            }, 300);
        }, delay);
    }

    window.handleNextStep = async () => {
        if (currentStep < steps.length - 1) {
            currentStep++;
            updateTutorialUI();
            return;
        }

        const btn = document.getElementById('btnNextTutorial');
        const toastBtn = document.getElementById('btnNextToastTutorial');

        if (btn) {
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mempersiapkan...';
            btn.disabled = true;
        }

        if (toastBtn) {
            toastBtn.disabled = true;
        }

        if (!isPreview) {
            try {
                await fetch(`${API_URL}/api/exams/tutorial/complete`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`,
                    },
                    body: JSON.stringify({ student_id: studentId }),
                });
            } catch (e) {
                console.error(e);
            }
        } else {
            sessionStorage.setItem(`preview_tutorial_done_${urlParams.get('examId')}`, 'true');
        }
        markStudentSubjectTutorialSeen();
        window.location.replace(returnUrl);
    };

    function openShopDrawer() {
        const drawer = document.getElementById('shopDrawer');
        const content = document.getElementById('drawerContent');

        if (!drawer || !content) return;

        drawer.classList.replace('hidden', 'flex');
        setTimeout(() => content.classList.remove('translate-y-full'), 10);
    }

    function closeShopDrawer(callback) {
        const drawer = document.getElementById('shopDrawer');
        const content = document.getElementById('drawerContent');

        if (!drawer || !content) return;

        content.classList.add('translate-y-full');

        setTimeout(() => {
            drawer.classList.replace('flex', 'hidden');
            if (callback) callback();
        }, 500);
    }

    window.handleShopBtnClick = () => {
        if (currentStep !== 1) return;
        if (lockTutorialAction(1000)) return;

        const shopBtn = document.getElementById('tutShopBtn');
        if (shopBtn) {
            shopBtn.disabled = true;
            shopBtn.classList.add('pointer-events-none');
        }

        openShopDrawer();

        document.getElementById('shopPanelStart')?.classList.remove('tutorial-highlight');

        safeNextStep(400);
    };

    function setCloseShopEnabled(isEnabled) {
        const btn = document.getElementById('btnCloseShopTut');
        if (!btn) return;

        btn.disabled = !isEnabled;
        btn.dataset.ready = isEnabled ? 'true' : 'false';

        btn.classList.toggle('opacity-50', !isEnabled);
        btn.classList.toggle('cursor-not-allowed', !isEnabled);
        btn.classList.toggle('pointer-events-none', !isEnabled);
        btn.classList.toggle('hover:bg-gray-200', isEnabled);
    }

    function hideTutorialMascot() {
        document.body.classList.remove('tutorial-miaw-inline');
        document.body.classList.add('tutorial-miaw-hidden');

        const catBtn = document.getElementById('btnToggleCat');
        const mascot = document.getElementById('mascot-container');
        const mascotChat = document.getElementById('mascot-chat');

        if (catBtn) catBtn.style.display = 'none';
        if (mascot) mascot.style.display = 'none';
        if (mascotChat) mascotChat.classList.add('hidden');
    }

    function setTutorialMascotUnderBackdrop(isUnder) {
        document.body.classList.toggle('tutorial-miaw-under-backdrop', isUnder);
    }

    function showTutorialMascot() {
        document.body.classList.remove('tutorial-miaw-hidden');
        document.body.classList.add('tutorial-miaw-inline');

        const catBtn = document.getElementById('btnToggleCat');
        const mascot = document.getElementById('mascot-container');

        if (catBtn) {
            catBtn.style.display = 'flex';
            catBtn.style.opacity = '1';
        }

        if (mascot) {
            mascot.style.display = '';
            mascot.classList.remove('tutorial-miaw-exit');
            mascot.classList.remove('tutorial-miaw-enter');

            // Posisi awal dari luar frame kanan
            mascot.style.transition = 'none';
            mascot.style.right = '-220px';
            mascot.style.bottom = '-2px';
            mascot.style.transform = 'translateX(0) translateY(0) scale(1)';

            // Force reflow supaya transition kebaca
            void mascot.offsetWidth;

            // Masuk geser ke kiri sampai posisi final
            mascot.classList.add('tutorial-miaw-enter');
            mascot.style.transition = 'right 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease';
            mascot.style.right = '5.25rem';
            mascot.style.opacity = '1';
        }
    }

    window.handleShopBackdropClick = () => {
        const closeBtn = document.getElementById('btnCloseShopTut');

        if (currentStep === 3 && closeBtn?.dataset.ready === 'true') {
            handleCloseShopClick();
        }
    };

    window.buyTimeTutorial = (mins, cost) => {
        if (currentStep !== 2) return;
        if (lockTutorialAction(1500)) return;

        const buyBtn = document.getElementById('btnBuyTimeTut');
        if (buyBtn) {
            buyBtn.disabled = true;
            buyBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        }

        poin -= cost;
        minutes += mins;

        const walletEl = document.getElementById('shopWallet');
        if (walletEl) {
            walletEl.innerText = poin;
            walletEl.classList.add('scale-110', 'text-red-500');

            setTimeout(() => {
                walletEl.classList.remove('scale-110', 'text-red-500');
            }, 600);
        }

        const timerEl = document.getElementById('tutTimer');
        const timerText = document.getElementById('tutTimerText');

        if (timerEl && timerText) {
            timerText.innerText = `${minutes}:00`;
            timerEl.classList.add('scale-110', '!border-green-400', '!bg-green-50');

            const timerIcon = timerEl.querySelector('i');
            if (timerIcon) timerIcon.className = 'fa-solid fa-stopwatch text-green-500';

            timerText.classList.add('!text-green-600');
        }

        if (typeof confetti !== 'undefined') {
            confetti({
                particleCount: 60,
                spread: 50,
                origin: { y: 0.8 },
                zIndex: 1000,
            });
        }

        safeNextStep(600);
    };

    window.handleCloseShopClick = () => {
        if (currentStep !== 3) return;
        if (lockTutorialAction(1200)) return;

        const closeBtn = document.getElementById('btnCloseShopTut');
        if (closeBtn?.dataset.ready !== 'true') return;

        closeBtn.disabled = true;
        closeBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');

        document.getElementById('shopPanelStart')?.classList.add('hidden');

        closeShopDrawer(() => {
            safeNextStep(400);
        });
    };

    let isHintClosing = false;

    window.openHintModalTutorial = () => {
        if (currentStep !== 5) return;

        const hintBtn = document.getElementById('tutHintBtn');
        if (hintBtn) {
            hintBtn.classList.remove('tutorial-highlight');
            hintBtn.style.pointerEvents = 'none';
        }

        if (hintTimer) clearInterval(hintTimer);

        document.getElementById('modalHint')?.classList.replace('hidden', 'flex');
        document.getElementById('tutModalCard')?.classList.add('hidden');
        document.getElementById('tutToastCard')?.classList.add('hidden');
        document.getElementById('tutorialBackdrop')?.classList.add('hidden');

        let countdown = 5;
        const countdownEl = document.getElementById('hintCountdown');

        if (countdownEl) countdownEl.innerText = countdown;

        hintTimer = setInterval(() => {
            countdown--;

            if (countdownEl) countdownEl.innerText = countdown;

            if (countdown <= 0) {
                clearInterval(hintTimer);
                closeHintAutoAndAdvance();
            }
        }, 1000);
    };

    function closeHintAutoAndAdvance() {
        if (isHintClosing) return;

        isHintClosing = true;

        document.getElementById('modalHint')?.classList.replace('flex', 'hidden');

        const hintBtn = document.getElementById('tutHintBtn');
        if (hintBtn) hintBtn.style.pointerEvents = '';

        setTimeout(() => {
            isHintClosing = false;
            handleNextStep();
        }, 400);
    }

    window.closeHintModalTutorial = () => {
        if (hintTimer) clearInterval(hintTimer);
        closeHintAutoAndAdvance();
    };

    window.clickOptionTutorial = (btn, option) => {
        if (currentStep !== 11) return;

        document.querySelectorAll('#tutOptions button').forEach(b => {
            b.className = 'p-4 bg-white border-2 border-slate-200 rounded-2xl text-left font-bold text-gray-600 transition-all flex items-center gap-4';

            const badge = b.querySelector('div');
            if (badge) {
                badge.className = 'w-10 h-10 flex-shrink-0 items-center justify-center bg-slate-50 rounded-xl border-2 border-slate-200 flex font-black';
                badge.classList.remove('text-white');
            }
        });

        btn.classList.add('bg-indigo-50', 'border-indigo-500', '-translate-y-1', 'shadow-[0_6px_0_#4f46e5]');

        const badge = btn.querySelector('div');
        if (badge) {
            badge.classList.remove('bg-slate-50', 'border-slate-200');
            badge.classList.add('bg-indigo-500', 'border-indigo-500', 'text-white');
        }

        const toastTitle = document.getElementById('tutToastTitle');
        const toastDesc = document.getElementById('tutToastDesc');
        const toastIcon = document.getElementById('tutToastIcon');

        if (toastTitle) toastTitle.innerText = option === 'B' ? '✅ Jawaban Benar!' : '👍 Pilihan Disimpan!';
        if (toastDesc) {
            toastDesc.innerText = option === 'B'
                ? "Tepat sekali! Iqlab adalah hukum bacaan Nun Mati bertemu Ba'."
                : 'Jawabanmu tersimpan. Di ujian nyata, kamu bisa ganti jawaban sebelum waktu habis.';
        }
        if (toastIcon) {
            toastIcon.innerHTML = option === 'B'
                ? '<i class="fa-solid fa-circle-check"></i>'
                : '<i class="fa-solid fa-circle-info"></i>';
        }

        if (option === 'B' && typeof confetti !== 'undefined') {
            confetti({
                particleCount: 60,
                spread: 50,
                origin: { y: 0.5 },
                zIndex: 1000,
            });
        }

        setTimeout(() => handleNextStep(), 900);
    };

    const arcadeAnswers = ['enam'];
    const filledBlocks = new Set();

    function setupArcadeInput() {
        const input = document.getElementById('arcadeInput');
        const visualText = document.getElementById('arcadeVisualText');
        if (!input) return;

        input.addEventListener('keydown', (e) => {
            if (currentStep !== 13) return;

            if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                checkArcadeInput();
            }
        });

        input.addEventListener('input', () => {
            if (currentStep !== 13) return;

            if (visualText) {
                const val = input.value.trim();
                if (val.length > 0) {
                    visualText.innerHTML = val;
                    visualText.classList.remove('text-gray-400', 'text-xl', 'md:text-2xl', 'lowercase', 'tracking-normal');
                    visualText.classList.remove('animate-pop-text');
                    void visualText.offsetWidth;
                    visualText.classList.add('animate-pop-text');
                } else {
                    visualText.innerHTML = '<span class="text-gray-400 text-xl md:text-2xl lowercase tracking-normal font-bold">Ketik di sini...</span>';
                    visualText.className = "text-4xl md:text-5xl font-black text-indigo-600 uppercase tracking-widest pointer-events-none select-none w-full text-center transition-all px-4 break-words";
                }
            }
        });
    }

    function checkArcadeInput() {
        const input = document.getElementById('arcadeInput');
        const visualText = document.getElementById('arcadeVisualText');
        if (!input) return;

        const val = input.value.trim().toLowerCase();
        if (!val) return;

        const currentBlockIdx = filledBlocks.size;
        if (currentBlockIdx >= arcadeAnswers.length) return;
        const correct = arcadeAnswers[currentBlockIdx];

        if (val === correct) {
            filledBlocks.add(currentBlockIdx);
            const blockEl = document.getElementById(`targetBlock${currentBlockIdx}`);
            if (blockEl) {
                blockEl.classList.add('filled');
                const blockText = blockEl.querySelector('.block-text');
                if (blockText) blockText.innerText = correct.toUpperCase();
            }

            // Auto-kosongkan input & reset UI visual text
            input.value = '';
            if (visualText) {
                visualText.innerHTML = '<span class="text-gray-400 text-xl md:text-2xl lowercase tracking-normal font-bold">Ketik di sini...</span>';
                visualText.className = "text-4xl md:text-5xl font-black text-indigo-600 uppercase tracking-widest pointer-events-none select-none w-full text-center transition-all px-4 break-words";
            }

            const phase2Progress = document.getElementById('phase2Progress');
            if (phase2Progress) {
                phase2Progress.innerText = `${filledBlocks.size} / ${arcadeAnswers.length} terisi`;
            }

            const toastTitle = document.getElementById('tutToastTitle');
            const toastDesc = document.getElementById('tutToastDesc');
            if (toastTitle) toastTitle.innerText = '🎉 Kolom Terisi!';
            if (toastDesc) toastDesc.innerText = 'Pernyataan sudah lengkap dan benar. Tutorial hampir selesai!';

            if (typeof confetti !== 'undefined') {
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.5 }, zIndex: 1000 });
            }

            if (filledBlocks.size >= arcadeAnswers.length) {
                setTimeout(() => handleNextStep(), 1000); // Lanjut ke step penyelesaian tutorial
            }
        } else {
            // Jawaban Salah
            if (visualText) {
                visualText.classList.add('animate-shake-error');
                setTimeout(() => visualText.classList.remove('animate-shake-error'), 400);
            }
        }
    }

    window.MascotConfig = {
        position: {
            visibleRight: '5.25rem',
            hiddenRight: '-250px',
            bottom: '-2px',
        },
        actions: {
            onHelpExecute: (callback) => {
                if (callback) callback();
            },
        },
    };

    window.triggerAngryCat = () => {
        console.log("Miaw marah (mode tutorial)");
    };

    document.addEventListener('DOMContentLoaded', async () => {
        const bgm = document.getElementById('bgmTutorial');
        if (bgm) {
            bgm.volume = 0.2;
            bgm.play().catch(() => {});
        }

        document.body.classList.add('tutorial-active');

        if (window.MiawMascot) {
            await window.MiawMascot.init(window.MascotConfig || {});
        }

        hideTutorialMascot();

        setupArcadeInput();
        updateTutorialUI();
    });
</script>

