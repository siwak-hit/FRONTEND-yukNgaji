<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js" is:inline defer></script>
<script>
    // ==========================================================
    // 1. KONFIGURASI & VARIABEL GLOBAL
    // ==========================================================
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const examId = window.location.pathname.split('/').pop();
    const urlParams = new URLSearchParams(window.location.search);
    const retakeStudentIdFromUrl = urlParams.get('retake_student_id');

    // Auth & Preview State
    const urlToken = urlParams.get('token');
    if (urlToken) sessionStorage.setItem('temp_exam_token', urlToken);
    const token = urlToken || sessionStorage.getItem('temp_exam_token') || localStorage.getItem('token');

    if (!token) {
        window.location.replace('/');
        throw new Error("Token tidak valid.");
    }
    const isPreview = urlParams.get('preview') === 'true';
    const isTeacherPreview = isPreview && urlParams.get('teacher_preview') === 'true';
    const previewTutorialMode = urlParams.get('preview_tutorial') || 'skip';
    const isPreviewFinalFlow = isTeacherPreview && urlParams.get('preview_final_flow') === 'true';

    // ===============================
    // UX KOIN / BANTUAN OTOMATIS
    // ===============================
    let hasOpenedShopThisExam = false;
    let hasBoughtHelpThisExam = false;
    let hasShownCoinHelpOffer = false;
    let pendingCoinOffer = null;

    const HINT_COST = 70;
    let usedHintQuestionIds = new Set();
    let pendingHintQuestion = null;

    // State Murid & Lobby
    let activeStudentId = null;
    let allStudents = [];
    let completedStudentIds = [];
    let qualifiedStudentIds = [];
    let studentPoin = 0;

    let pendingTutorialStudent = null;

    const normalizeSubjectKey = (subject = '') => {
        return String(subject)
            .trim()
            .toLowerCase()
            .replace(/\s+/g, '_')
            .replace(/[^\w-]/g, '');
    };

    const getCurrentSubjectKey = () => normalizeSubjectKey(examData?.subject || 'unknown_subject');

    const getStudentTutorialSubjectsKey = (studentId) => {
        return `exam_tutorial_seen_subjects_${studentId}`;
    };

    const getStudentSeenTutorialSubjects = (studentId) => {
        try {
            const raw = localStorage.getItem(getStudentTutorialSubjectsKey(studentId));
            const parsed = JSON.parse(raw || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
            return [];
        }
    };

    const hasStudentSeenAnyTutorial = (studentData, studentId) => {
        const localSubjects = getStudentSeenTutorialSubjects(studentId);
        return studentData?.has_completed_exam_tutorial === true || localSubjects.length > 0;
    };

    const hasStudentSeenCurrentSubjectTutorial = (studentId) => {
        const subjectKey = getCurrentSubjectKey();
        return getStudentSeenTutorialSubjects(studentId).includes(subjectKey);
    };

    function goToStudentTutorial(studentId, studentName) {
        const returnParams = new URLSearchParams({
            tutorial_return_student: studentId,
            tutorial_return_name: studentName || 'Siswa'
        });

        const returnUrl = encodeURIComponent(`${window.location.pathname}?${returnParams.toString()}`);

        const tutorialParams = new URLSearchParams({
            returnUrl,
            studentId,
            token: token || '',
            tutorial_context: 'student',
            student_tutorial_subject: examData?.subject || '',
        });

        window.location.href = `/tutorial-exam?${tutorialParams.toString()}`;
    }

    window.openStudentTutorialChoice = (studentId, studentName) => {
        pendingTutorialStudent = {
            id: studentId,
            name: studentName || 'Siswa'
        };

        document.getElementById('modalStudentTutorialChoice')?.classList.replace('hidden', 'flex');
    };

    window.closeStudentTutorialChoice = () => {
        document.getElementById('modalStudentTutorialChoice')?.classList.replace('flex', 'hidden');
    };

    window.continueStudentWithTutorial = () => {
        if (!pendingTutorialStudent) return;

        const { id, name } = pendingTutorialStudent;
        pendingTutorialStudent = null;

        window.closeStudentTutorialChoice();
        goToStudentTutorial(id, name);
    };

    window.continueStudentWithoutTutorial = () => {
        if (!pendingTutorialStudent) return;

        const { id, name } = pendingTutorialStudent;
        pendingTutorialStudent = null;

        window.closeStudentTutorialChoice();

        // skipTutorialGate: true supaya tidak kena modal lagi
        window.selectStudent(id, name, { skipTutorialGate: true });
    };

    // State Ujian
    let examData = null;
    let questions = [];
    let phase1Questions = [];
    let phase2Questions = [];
    let currentPhase = 1; // 1 = PG, 2 = Arcade
    let currentIndex = 0;
    let studentAnswers = {};
    let phase2Answers = [];
    let isExamActive = false;
    let isSubmitting = false;
    let isAllExamsDone = false;

    // State Waktu
    let timeLeft = 0;
    let timerInterval = null;
    let totalDurationSeconds = 0;
    let currentTimerSpeed = 1000;
    let catFreezeTimeout = null;
    let isQuestionHiddenByMiaw = false;

    window.isTimeStoppedByCat = false;

    // State Kamera & Keamanan
    let cameraStream = null;
    let hasCapturedPhoto = false;
    let capturedBase64 = null;
    let hasTriggeredAngryCat = false;

    // State Audio / Easter Egg
    window.isEasterEggActive = false;
    let mediaRecorder;
    let audioChunks = [];
    let recordTimer;
    let recordSeconds = 0;
    let easterEggAudioBlob = null;
    let retakesLeft = 1;
    let audioCtx;
    let analyser;
    let visAnimationId;
    let streamRef;
    let currentRecordPhase = 'start'; // 'start' -> 'recording' -> 'review'

    // Kunci Storage
    const getStorageKey = () => isPreview ? `preview_progress_${examId}` : `exam_progress_${examId}`;
    const getTimerKey = () => isPreview ? `preview_timer_${examId}` : `exam_timer_${examId}`;

    const getExamStartedKey = () => isPreview
        ? `preview_exam_started_${examId}`
        : `exam_started_${examId}`;

    const getQuestionOrderKey = () => isPreview
        ? `preview_question_order_${examId}`
        : `exam_question_order_${examId}`;

    const getCurrentIndexKey = () => isPreview
        ? `preview_current_index_${examId}`
        : `exam_current_index_${examId}`;

    const getCurrentPhaseKey = () => isPreview
        ? `preview_current_phase_${examId}`
        : `exam_current_phase_${examId}`;

    const getExamDeadlineKey = () => isPreview
        ? `preview_exam_deadline_${examId}`
        : `exam_deadline_${examId}`;

    const getExpiredReasonKey = () => isPreview
        ? `preview_exam_expired_reason_${examId}`
        : `exam_expired_reason_${examId}`;

    const getLastSeenKey = () => isPreview
        ? `preview_exam_last_seen_${examId}`
        : `exam_last_seen_${examId}`;
    // Mode preview (simulasi guru) selalu dimulai dari nol — tidak boleh "nyangkut"
    // di state ujian sebelumnya yang bisa memicu kunci "minta izin guru".
    // Bersihkan SELURUH sesi preview, bukan cuma progress & timer.
    if (isPreview) {
        localStorage.removeItem(getStorageKey());
        localStorage.removeItem(getTimerKey());
        localStorage.removeItem(getExamStartedKey());
        localStorage.removeItem(getQuestionOrderKey());
        localStorage.removeItem(getCurrentIndexKey());
        localStorage.removeItem(getCurrentPhaseKey());
        localStorage.removeItem(getExamDeadlineKey());
        localStorage.removeItem(getExpiredReasonKey());
        localStorage.removeItem(getLastSeenKey());
        localStorage.removeItem('cat_help_used');
    }

    const relaxQuotes = [
        "Tarik napas perlahan... Kamu pasti bisa menyelesaikannya!",
        "Rileks sejenak. Fokuskan kembali pikiranmu.",
        "Tenang, waktu masih berjalan. Pertahankan semangatmu!"
    ];

    // ==========================================================
    // 2. FUNGSI UTILITAS & HELPER
    // ==========================================================
    const shuffleArray = (array) => {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    };

    window.showShopButton = () => {
        const panel = document.getElementById('shopPanel');
        if (panel) {
            panel.classList.remove('hidden');
            panel.classList.add('animate-slide-up');
        }
    };

    window.hideShopButton = () => {
        const panel = document.getElementById('shopPanel');
        if (panel) {
            panel.classList.add('hidden');
            panel.classList.remove('animate-slide-up');
        }
    };

    window.toggleShopDrawer = () => {
    const drawer = document.getElementById('shopDrawer');
    const content = document.getElementById('drawerContent');
    if (!drawer || !content) return;

    if (drawer.classList.contains('hidden')) {
        hasOpenedShopThisExam = true;

        drawer.classList.replace('hidden', 'flex');
        setTimeout(() => content.classList.remove('translate-y-full'), 10);
        } else {
            content.classList.add('translate-y-full');
            setTimeout(() => drawer.classList.replace('flex', 'hidden'), 500);
        }
    };

    window.showToastAlert = (type, title, msg) => {
        if (window.showToast) window.showToast(type, title, msg);
    };

    const setQuestionHiddenByMiaw = (hidden) => {
        isQuestionHiddenByMiaw = hidden;

        const questionCard = document.getElementById('questionCard');
        const optionsGrid = document.getElementById('optionsGrid');
        const hintFab = document.querySelector('.hint-fab');

        [questionCard, optionsGrid].forEach(el => {
            if (!el) return;

            el.classList.toggle('opacity-0', hidden);
            el.classList.toggle('pointer-events-none', hidden);
            el.classList.toggle('scale-95', hidden);
            el.classList.toggle('blur-sm', hidden);
            el.classList.toggle('select-none', hidden);
        });

        if (hintFab) {
            hintFab.classList.toggle('hidden', hidden);
        }

        // Saat soal disembunyikan Miaw: tonjolkan tombol panggil Miaw (pulse) + tampilkan
        // petunjuk, supaya siswa tahu cara mengembalikan soalnya.
        const catBtn = document.querySelector('.tool-cat');
        if (catBtn) {
            catBtn.classList.toggle('cat-attention', hidden);
            catBtn.setAttribute('title', hidden ? 'Tekan untuk memanggil Miaw & kembalikan soal' : 'Panggil / Usir Miaw');
        }

        const hideHint = document.getElementById('miawHideHint');
        if (hideHint) hideHint.classList.toggle('hidden', !hidden);
    };

    const freezeTimerByMiaw = (durationMs = 7000, done = () => {}) => {
        if (!isExamActive || isSubmitting) {
            done();
            return;
        }

        const timerText = document.getElementById('timerText');
        const timerContainer = document.getElementById('timerContainer');
        const timerIcon = document.getElementById('timerIcon');

        clearTimeout(catFreezeTimeout);

        window.isTimeStoppedByCat = true;

        if (timerText) timerText.innerText = 'DIBEKUKAN';

        if (timerContainer) {
            timerContainer.classList.add(
                'bg-cyan-50',
                'text-cyan-600',
                'border-cyan-200',
                'animate-pulse'
            );
        }

        if (timerIcon) {
            timerIcon.className = 'fa-solid fa-snowflake timer-icon text-cyan-500 animate-spin';
        }

        catFreezeTimeout = setTimeout(() => {
            window.isTimeStoppedByCat = false;

            if (timerContainer) {
                timerContainer.classList.remove(
                    'bg-cyan-50',
                    'text-cyan-600',
                    'border-cyan-200',
                    'animate-pulse'
                );
            }

            if (timerIcon) {
                timerIcon.className = 'fa-solid fa-stopwatch timer-icon text-gray-400';
            }

            updateTimerUI();
            done();
        }, durationMs);
    };


    // ==========================================================
    // 3. INISIALISASI (INIT) & FETCH DATA
    // ==========================================================
    const init = async () => {
        try {
            // Animasi Maskot
            if (window.MiawMascot) {
                window.MiawMascot.init({
                    texts: {
                        idlePhrases: [
                            "Pelan-pelan aja bacanya... miaw",
                            "Fokus, fokus... Waktu terus berjalan lho."
                        ],
                        warnings: [
                            "Miaw... kamu asik sendiri ya? Kok aku gak diajak main."
                        ],
                        prank: "Ok! Kalo kamu gak mau main sama aku, aku yang bakal nyembunyiin jawaban ujiannya! Mwehehehe~",
                        prankRevert: "Nah gitu dong manggil aku lagi... Nih soalnya aku balikin ya miaw!",
                        threatExecute: "Yaudah aku pergi! Tapi rasain nih waktu ujianmu aku cepetin!",
                        threatRevert: "Nah gitu dong manggil... Maap deh, waktunya aku normalin lagi miaw!",
                        helpExecute: "Ok, aku bekukan waktunya sebentar... Cepetan kerjain!",
                        helpDone: "Waktunya jalan lagi ya... Semangat!"
                    },
                    actions: {
                        onPrank: () => {
                            if (!isExamActive || isSubmitting || currentPhase !== 1) return;
                            setQuestionHiddenByMiaw(true);
                        },

                        onPrankRevert: () => {
                            setQuestionHiddenByMiaw(false);
                        },

                        onThreatExecute: () => {
                            if (!isExamActive || isSubmitting) return;

                            const penaltySeconds = 60;
                            timeLeft = Math.max(0, timeLeft - penaltySeconds);
                            localStorage.setItem(getTimerKey(), String(timeLeft));

                            const deadlineRaw = localStorage.getItem(getExamDeadlineKey());
                            if (deadlineRaw) {
                                const newDeadline = Number(deadlineRaw) - (penaltySeconds * 1000);
                                localStorage.setItem(getExamDeadlineKey(), String(newDeadline));
                            }

                            updateTimerUI();

                            document.getElementById('modalMiawLetter')?.classList.replace('hidden', 'flex');

                            if (timeLeft <= 0) {
                                localStorage.setItem(getExpiredReasonKey(), 'time_expired');
                                lockExamBecauseExpired();
                            }
                        },

                        onThreatRevert: () => {
                            if (!isExamActive || isSubmitting) return;

                            // Balikin timer ke normal
                            runExamTimer(1000);
                        },

                        onHelpExecute: (done) => {
                            // Jangan merusak logika lama: timer cuma dibekukan,
                            // bukan clear interval dan bukan reset timeLeft.
                            freezeTimerByMiaw(7000, done);
                        }
                    },
                    // Taruh maskot di pojok kanan-bawah & lebih rendah, supaya nongkrong
                    // di area kosong bawah (di bawah tombol navigasi), tidak menutupi soal/tombol.
                    position: { visibleRight: '6px', hiddenRight: '-250px', bottom: '12px' },
                    // Bubble chat di samping kiri maskot (kecuali saat maskot maju menawari bantuan).
                    bubblePlacement: 'side'
                }).catch(e => console.log("Mascot dimuat di background", e));
            }

            // Cek Progress Storage
            const savedProgress = localStorage.getItem(getStorageKey());
            const savedStudentId = localStorage.getItem(`active_student_${examId}`);

            if (savedProgress) {
                studentAnswers = JSON.parse(savedProgress);
                currentIndex = Object.keys(studentAnswers).length > 0 ? Object.keys(studentAnswers).length - 1 : 0;
            } else {
                studentAnswers = {};
                currentIndex = 0;
            }

            if (savedStudentId) activeStudentId = savedStudentId;

            // Fetch Data Ujian
            const exRes = await fetch(`${API_URL}/api/exams/${examId}`, { headers: { 'Authorization': `Bearer ${token}` }});
            if (!exRes.ok) throw new Error("Gagal mengambil data ujian");
            const exData = await exRes.json();
            examData = exData.data;

            // Pemisahan Fase Soal
            phase1Questions = [];
            phase2Questions = [];
            let rawQuestions = [];
            const savedQuestionOrder = localStorage.getItem(getQuestionOrderKey());

            if (savedQuestionOrder) {
                try {
                    const orderIds = JSON.parse(savedQuestionOrder);

                    rawQuestions = orderIds
                        .map(id => (examData.questions || []).find(q => String(q.id) === String(id)))
                        .filter(Boolean);

                    // Fallback kalau data rusak / soal berubah dari database
                    if (rawQuestions.length === 0) {
                        rawQuestions = shuffleArray(examData.questions || []);
                        localStorage.setItem(
                            getQuestionOrderKey(),
                            JSON.stringify(rawQuestions.map(q => q.id))
                        );
                    }
                } catch (e) {
                    rawQuestions = shuffleArray(examData.questions || []);
                    localStorage.setItem(
                        getQuestionOrderKey(),
                        JSON.stringify(rawQuestions.map(q => q.id))
                    );
                }
            } else {
                rawQuestions = shuffleArray(examData.questions || []);
                localStorage.setItem(
                    getQuestionOrderKey(),
                    JSON.stringify(rawQuestions.map(q => q.id))
                );
            }

            rawQuestions.forEach(q => {
                if (q.question_type === 'fill_in_blanks') {
                    if (typeof q.correct_answer === 'string') {
                        try { q.correct_answer = JSON.parse(q.correct_answer); } catch(e) {}
                    }
                    phase2Questions.push(q);
                } else {
                    const validKeys = ['A', 'B', 'C', 'D'].filter(k => q.options && q.options[k] && q.options[k].trim() !== '');
                    q.shuffledKeys = shuffleArray(validKeys);
                    phase1Questions.push(q);
                }
            });

            // Set Aktif Berdasarkan Ketersediaan Soal
            if (phase1Questions.length > 0) {
                questions = phase1Questions;
                currentPhase = 1;
            } else if (phase2Questions.length > 0) {
                questions = phase2Questions;
                currentPhase = 2;
                document.getElementById('phase1Wrapper')?.classList.add('hidden');
                document.getElementById('phase2Wrapper')?.classList.remove('hidden');
            } else {
                questions = [];
                currentPhase = 1;
            }

            if (!examData.questions || examData.questions.length === 0) {
                document.getElementById('loadingScreen').innerHTML = '<p class="text-red-500 font-bold px-6 text-center text-sm">Ujian ini belum memiliki soal.</p>';
                return;
            }

            // Setup UI Lobby Info
            document.getElementById('examSubject').innerText = `UJIAN ${examData.subject}`;
            document.getElementById('lobbyExamTitle').innerText = examData.title;
            const duration = examData.duration_minutes > 0 ? examData.duration_minutes : 60;
            document.getElementById('lobbyExamDuration').innerText = duration;
            totalDurationSeconds = duration * 60;

            const savedTime = localStorage.getItem(getTimerKey());
            timeLeft = (savedTime && !isNaN(savedTime)) ? parseInt(savedTime) : totalDurationSeconds;

            const wasExamStarted = localStorage.getItem(getExamStartedKey()) === 'true';
            let shouldLockExamAfterStudentReady = false;

            if (wasExamStarted) {
                syncTimeLeftWithDeadline();

                // Preview tidak pernah dikunci / minta izin guru kalau waktunya habis.
                if (timeLeft <= 0 && !isPreview) {
                    localStorage.setItem(getExpiredReasonKey(), 'time_expired_resume');
                    shouldLockExamAfterStudentReady = true;
                }
            }

            // Mode Preview vs Mode Murid
            if (isPreview) {
                activeStudentId = "preview_mode";
                studentPoin = 500;

                // Ambil parameter dari URL
                if (isTeacherPreview && previewTutorialMode === 'force') {
                    const returnUrl = encodeURIComponent(`/exams/${examId}`);

                    window.location.replace(
                        `/tutorial-exam?returnUrl=${returnUrl}&preview=true&teacher_preview=true&examId=${examId}`
                    );
                    return;
                }

                // Backward compatibility kalau masih ada link lama force_tutorial=true
                const legacyForceTutorial = urlParams.get('force_tutorial') === 'true';

                if (!isTeacherPreview && legacyForceTutorial) {
                    const returnUrl = encodeURIComponent(`/exams/${examId}`);

                    window.location.replace(
                        `/tutorial-exam?returnUrl=${returnUrl}&preview=true&teacher_preview=true&examId=${examId}`
                    );
                    return;
                }

                // Jika tutorial sudah beres atau tidak dipaksa, tampilkan UI Ustadz
                document.getElementById('studentNameDisplay').innerText = "Mode Ustadz";
                document.getElementById('examSubject').innerText = "PRATINJAU GURU";
                document.getElementById('previewBanner')?.classList.remove('hidden');
                document.getElementById('loadingScreen').classList.add('hidden');
                document.getElementById('startScreen').classList.replace('hidden', 'flex');
                window.showShopButton();
            } else {
                // Mode Siswa: Ambil data dan WAJIB tampilkan Lobby Grid
                const [stdRes, resRes, qualRes] = await Promise.all([
                    fetch(`${API_URL}/api/students`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json()).catch(() => ({data:[]})),
                    fetch(`${API_URL}/api/exams/${examId}/results`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json()).catch(() => ({data:[]})),
                    fetch(`${API_URL}/api/onboarding/status?subject=${examData.subject}&week=5`, { headers: { 'Authorization': `Bearer ${token}` }}).then(r => r.json()).catch(() => ({data:[]}))
                ]);

                allStudents = stdRes.data || [];
                completedStudentIds = (resRes.data || []).map(r => r.student_id);
                qualifiedStudentIds = qualRes.data || [];

                renderLobbyGrid();
                document.getElementById('loadingScreen').classList.add('hidden');
                document.getElementById('lobbyScreen').classList.replace('hidden', 'flex');
                window.hideShopButton();

                if (retakeStudentIdFromUrl) {
                    const targetStudent = allStudents.find(s => String(s.id) === String(retakeStudentIdFromUrl));

                    if (targetStudent) {
                        window.selectStudent(targetStudent.id, targetStudent.name, { skipTutorialGate: true });
                    }
                }

                const tutorialReturnStudentId = urlParams.get('tutorial_return_student');
                const tutorialReturnStudentName = urlParams.get('tutorial_return_name');

                if (tutorialReturnStudentId) {
                    const returnedStudent = allStudents.find(s => s.id === tutorialReturnStudentId);
                    const returnedName = returnedStudent?.name || tutorialReturnStudentName || 'Siswa';

                    // Bersihkan URL biar kalau reload tidak auto-select terus
                    window.history.replaceState({}, '', window.location.pathname);

                    setTimeout(() => {
                        window.selectStudent(tutorialReturnStudentId, returnedName, { skipTutorialGate: true });
                    }, 300);
                }
            }

            const walletEl = document.getElementById('shopWallet');
            if (walletEl) walletEl.innerText = studentPoin;

            if (shouldLockExamAfterStudentReady && activeStudentId) {
                lockExamBecauseExpired();
                return;
            }


            if (wasExamStarted && activeStudentId) {
                const savedPhase = parseInt(localStorage.getItem(getCurrentPhaseKey()) || '1');
                const savedIndex = parseInt(localStorage.getItem(getCurrentIndexKey()) || '0');

                currentPhase = savedPhase === 2 ? 2 : 1;

                if (currentPhase === 2 && phase2Questions.length > 0) {
                    questions = phase2Questions;
                    document.getElementById('phase1Wrapper')?.classList.add('hidden');
                    document.getElementById('phase2Wrapper')?.classList.remove('hidden');
                } else {
                    currentPhase = 1;
                    questions = phase1Questions;
                    document.getElementById('phase2Wrapper')?.classList.add('hidden');
                    document.getElementById('phase1Wrapper')?.classList.remove('hidden');
                }

                currentIndex = Math.max(0, Math.min(savedIndex, questions.length - 1));

                document.getElementById('loadingScreen')?.classList.add('hidden');
                document.getElementById('lobbyScreen')?.classList.replace('flex', 'hidden');
                document.getElementById('startScreen')?.classList.replace('flex', 'hidden');
                document.getElementById('examMainContainer')?.classList.remove('hidden');

                isExamActive = true;
                window.hideShopButton?.();
                updateTimerUI();
                runExamTimer(currentTimerSpeed || 1000);

                if (currentPhase === 1) {
                    renderQuestion();
                } else if (currentPhase === 2 && window.ArcadeTyping) {
                    window.ArcadeTyping.init(phase2Questions, phase2Answers, handlePhase2Complete);
                }

                window.showToastAlert?.(
                    'info',
                    'Ujian Dilanjutkan',
                    'Progress sebelumnya berhasil dipulihkan.'
                );
            }

        } catch (e) {
            console.error(e);
            window.showToastAlert('danger', 'Error', 'Gagal memuat ujian. Pastikan link dan token valid.');
            document.getElementById('loadingScreen').innerHTML = '<p class="text-red-500 font-bold px-6 text-center text-sm">Gagal memuat ujian. Silakan reload halaman.</p>';
        }
    };

    // ==========================================================
    // 4. LOGIKA LOBBY & NAVIGASI AWAL
    // ==========================================================
    const renderLobbyGrid = () => {
        const grid = document.getElementById('lobbyStudentGrid');
        const query = document.getElementById('lobbySearch').value.toLowerCase();

        let filtered = allStudents.filter(s => {
            const nameStr = (s.name || '').toLowerCase();
            return nameStr.includes(query);
        });

        if (filtered.length === 0) {
            grid.innerHTML = '<p class="col-span-2 text-center py-8 text-gray-400 text-xs italic">Nama tidak ditemukan.</p>';
            return;
        }

        grid.innerHTML = filtered.map(s => {
            const isDone = completedStudentIds.includes(s.id);
            const isQualified = qualifiedStudentIds.includes(s.id);
            const safeName = (s.name || 'Siswa').replace(/'/g, "\\'");
            const initial = (s.name || '??').substring(0,2).toUpperCase();

            let cardClass = 'bg-white p-4 rounded-3xl border border-gray-100 shadow-sm flex flex-col items-center text-center gap-3 transition-all ';
            let onClick = '';
            let badge = '';
            let statusText = 'BELUM';
            let statusColor = 'text-gray-400';

            if (isDone) {
                cardClass += 'opacity-50 grayscale pointer-events-none';
                statusText = 'SELESAI';
                statusColor = 'text-green-500';
                badge = '<div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 text-white rounded-full flex items-center justify-center text-xs shadow-sm border-2 border-white"><i class="fa-solid fa-check"></i></div>';
            } else if (!isQualified) {
                cardClass += 'opacity-80 active:scale-95 cursor-pointer hover:border-amber-300';
                onClick = `window.showLockModal('${safeName}')`;
                statusText = 'TERKUNCI';
                statusColor = 'text-amber-500';
                badge = '<div class="absolute -bottom-1 -right-1 w-6 h-6 bg-amber-500 text-white rounded-full flex items-center justify-center text-[10px] shadow-sm border-2 border-white"><i class="fa-solid fa-lock"></i></div>';
            } else {
                cardClass += 'active:scale-95 cursor-pointer hover:border-indigo-300';
                onClick = `window.selectStudent('${s.id}', '${safeName}')`;
            }

            return `
                <div class="${cardClass}" onclick="${onClick}">
                    <div class="relative">
                        <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-lg font-black">${initial}</div>
                        ${badge}
                    </div>
                    <div>
                        <h4 class="font-black text-gray-800 text-[11px] line-clamp-1 capitalize">${s.name || 'Siswa'}</h4>
                        <p class="text-[9px] font-bold mt-1 tracking-widest uppercase ${statusColor}">${statusText}</p>
                    </div>
                </div>
            `;
        }).join('');
    };

    document.getElementById('lobbySearch')?.addEventListener('input', renderLobbyGrid);

    window.selectStudent = (id, name, options = {}) => {
        const studentData = allStudents.find(s => s.id === id);

        // [BARU] Gerbang deadline ujian daring + dispensasi per-murid (mirror PR).
        // Murid telat & tanpa perpanjangan valid TIDAK boleh masuk.
        if (!isPreview && examData && examData.is_daring && examData.deadline_at) {
            const now = new Date();
            const deadline = new Date(examData.deadline_at);

            let extList = examData.extended_students;
            try { while (typeof extList === 'string') extList = JSON.parse(extList); } catch (e) {}
            if (!Array.isArray(extList)) extList = [];
            const extRecord = extList.find(ext => (typeof ext === 'object' ? ext.student_id : ext) === id);

            if (extRecord) {
                const extUntil = extRecord.until ? new Date(extRecord.until) : null;
                if (extUntil && now > extUntil) {
                    window.showToast?.('warning', 'Waktu Habis', 'Waktu perpanjanganmu sudah habis. Minta lagi ke Ustadz ya.');
                    return;
                }
                if (extRecord.penalty) {
                    window.showToast?.('info', 'Perpanjangan Aktif', 'Kamu telat — dapat akses, tapi nilai dipotong 10%.');
                }
            } else if (now > deadline) {
                window.showToast?.('warning', 'Waktu Ujian Habis', 'Batas waktu ujian sudah lewat. Minta perpanjangan ke Ustadz dulu ya.');
                return;
            }
        }

        if (!options.skipTutorialGate) {
            const hasSeenAnyTutorial = hasStudentSeenAnyTutorial(studentData, id);
            const hasSeenThisSubject = hasStudentSeenCurrentSubjectTutorial(id);

            // Mapel pertama / tutorial pertama siswa: WAJIB tutorial
            if (!hasSeenAnyTutorial) {
                goToStudentTutorial(id, name);
                return;
            }

            // Mapel berbeda setelah pernah tutorial: tampilkan modal pilihan
            if (!hasSeenThisSubject) {
                window.openStudentTutorialChoice(id, name);
                return;
            }
        }

        activeStudentId = id;
        localStorage.setItem(`active_student_${examId}`, id);

        if (studentData) {
            studentPoin = studentData.poin || 0;

            const walletEl = document.getElementById('shopWallet');
            if (walletEl) walletEl.innerText = studentPoin;
        }

        document.getElementById('studentNameDisplay').innerText = name;
        document.getElementById('studentInitials').innerText = name.substring(0, 2).toUpperCase();
        document.getElementById('startStudentName').innerText = name;

        document.getElementById('lobbyScreen').classList.replace('flex', 'hidden');
        document.getElementById('startScreen').classList.replace('hidden', 'flex');

        window.showShopButton();

        if (localStorage.getItem(getExamStartedKey()) === 'true') {
            syncTimeLeftWithDeadline();

            if (timeLeft <= 0) {
                localStorage.setItem(getExpiredReasonKey(), 'time_expired_resume');

                setTimeout(() => {
                    lockExamBecauseExpired();
                }, 50);

                return;
            }
        }
    };

    window.backToLobby = () => {
        activeStudentId = null;
        document.getElementById('startScreen').classList.replace('flex', 'hidden');
        document.getElementById('lobbyScreen').classList.replace('hidden', 'flex');
        window.hideShopButton(); // Sembunyikan toko saat kembali ke Lobby
    };

    window.exitPreview = () => {
        isExamActive = false;
        clearInterval(timerInterval);

        // isPreview === true di sini, jadi clearExamSession membersihkan semua key preview_*.
        clearExamSession();

        window.location.href = `/exams/${examId}`;
    };

    window.showLockModal = (studentName) => {
        document.getElementById('lockStudentName').innerText = studentName;
        document.getElementById('modalLockWeek5').classList.replace('hidden', 'flex');
    };

    window.closeLockModal = () => {
        document.getElementById('modalLockWeek5').classList.replace('flex', 'hidden');
    };

    // ==========================================================
    // 5. LOGIKA WAKTU & TOKO SIHIR
    // ==========================================================
    const runExamTimer = (speed = 1000) => {
        currentTimerSpeed = speed;

        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            if (window.isTimeStoppedByCat) return;

            localStorage.setItem(getLastSeenKey(), String(Date.now()));
            syncTimeLeftWithDeadline();

            if (timeLeft <= 0) {
                timeLeft = 0;

                localStorage.setItem(getTimerKey(), '0');
                localStorage.setItem(getExpiredReasonKey(), 'time_expired_active');

                clearInterval(timerInterval);

                window.showToastAlert?.(
                    'warning',
                    'WAKTU HABIS!',
                    'Ujian dikumpulkan otomatis.'
                );

                submitExam();
                return;
            } else {
                updateTimerUI();

                const elapsed = totalDurationSeconds - timeLeft;

                if (
                    elapsed >= Math.floor(totalDurationSeconds * 0.5) &&
                    timeLeft > 60 &&
                    speed === 1000
                ) {
                    showCoinHelpOffer('mid_exam');
                }

                if (
                    timeLeft <= 180 &&
                    timeLeft > 60 &&
                    speed === 1000
                ) {
                    showCoinHelpOffer('low_time');
                }

                if (elapsed > 0 && elapsed % 60 === 0 && timeLeft > 0 && speed === 1000) {
                    window.showTimeReminder(Math.floor(elapsed / 60));
                }
            }
        }, speed);
    };

    const startTimer = () => {
        isExamActive = true;

        localStorage.setItem(getExamStartedKey(), 'true');
        localStorage.setItem(getCurrentIndexKey(), String(currentIndex));
        localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));

        // Deadline hanya dibuat sekali.
        // Kalau reload/resume, jangan bikin deadline baru.
        if (!localStorage.getItem(getExamDeadlineKey())) {
            const deadline = Date.now() + (timeLeft * 1000);
            localStorage.setItem(getExamDeadlineKey(), String(deadline));
        }

        window.history.pushState(null, null, window.location.href);
        // Toko koin disembunyikan selama mengerjakan ujian (penawaran otomatis tetap muncul lewat modal).
        window.hideShopButton?.();
        updateTimerUI();
        runExamTimer(currentTimerSpeed || 1000);
    };

    const updateTimerUI = () => {
        const m = Math.floor(Math.max(0,timeLeft)/60).toString().padStart(2,'0');
        const s = (Math.max(0,timeLeft)%60).toString().padStart(2,'0');
        document.getElementById('timerText').innerText = `${m}:${s}`;

        const container = document.getElementById('timerContainer');
        const icon = document.getElementById('timerIcon');
        const vignette = document.getElementById('dangerVignette');

        if (timeLeft <= 60 && timeLeft > 0) {
            if (container) container.classList.add('timer-danger');
            if (icon) icon.classList.replace('text-gray-400', 'text-red-500');
            if (vignette) vignette.classList.add('vignette-active');
        } else {
            if (container) container.classList.remove('timer-danger');
            if (icon) icon.classList.replace('text-red-500', 'text-gray-400');
            if (vignette) vignette.classList.remove('vignette-active');
        }
    };

    window.showTimeReminder = (minutesPassed) => {
        const popup = document.getElementById('timeReminder');
        if (!popup) return;
        document.getElementById('timeReminderText').innerText = `Sudah ${minutesPassed} menit berlalu. Terus semangat ya!`;
        popup.classList.remove('opacity-0', 'translate-y-[-30px]', 'pointer-events-none');
        popup.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
            popup.classList.remove('opacity-100', 'translate-y-0');
            popup.classList.add('opacity-0', 'translate-y-[-30px]', 'pointer-events-none');
        }, 4000);
    };

    window.buyTime = async (mins, cost) => {
        if (studentPoin < cost) {
            window.showToast?.('danger', 'Koin Kurang', 'Kumpulkan koin lebih banyak!');
            return;
        }

        try {
            if (!isPreview) {
                const res = await fetch(`${API_URL}/api/exams/buy-time`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: activeStudentId, cost: cost, minutes: mins })
                });

                const result = await res.json();
                if (result.status !== 'success') throw new Error(result.message);

                studentPoin = result.data.new_poin;
            } else {
                studentPoin -= cost;
            }

            // [BARU] Tandai bahwa anak sudah memakai bantuan koin
            hasBoughtHelpThisExam = true;
            hasShownCoinHelpOffer = true;

            timeLeft += mins * 60;
            totalDurationSeconds += mins * 60;

            const deadlineRaw = localStorage.getItem(getExamDeadlineKey());

            if (deadlineRaw) {
                const oldDeadline = Number(deadlineRaw);
                const newDeadline = oldDeadline + (mins * 60 * 1000);
                localStorage.setItem(getExamDeadlineKey(), String(newDeadline));
            } else {
                const newDeadline = Date.now() + (timeLeft * 1000);
                localStorage.setItem(getExamDeadlineKey(), String(newDeadline));
            }

            const walletEl = document.getElementById('shopWallet');
            if (walletEl) walletEl.innerText = studentPoin;

            updateTimerUI();

            window.showToast?.(
                'success',
                'Waktu Bertambah!',
                `Waktu ujian ditambah ${mins} menit.`
            );

            const drawer = document.getElementById('shopDrawer');
            const content = document.getElementById('drawerContent');
            if (drawer && content && !drawer.classList.contains('hidden')) {
                content.classList.add('translate-y-full');
                setTimeout(() => drawer.classList.replace('flex', 'hidden'), 500);
            }
        } catch (err) {
            console.error(err);
            window.showToast?.('danger', 'Gagal', 'Gagal membeli tambahan waktu.');
        }
    };

    function getBestCoinHelpOffer() {
        if (studentPoin >= 500) {
            return {
                mins: 5,
                cost: 500,
                title: 'Tambah Waktu +5 Menit',
                text: `Kamu punya ${studentPoin} koin. Mau pakai 500 koin untuk menambah waktu 5 menit?`
            };
        }

        if (studentPoin >= 200) {
            return {
                mins: 2,
                cost: 200,
                title: 'Tambah Waktu +2 Menit',
                text: `Kamu punya ${studentPoin} koin. Mau pakai 200 koin untuk menambah waktu 2 menit?`
            };
        }

        if (studentPoin >= 100) {
            return {
                mins: 1,
                cost: 100,
                title: 'Tambah Waktu +1 Menit',
                text: `Kamu punya ${studentPoin} koin. Mau pakai 100 koin untuk menambah waktu 1 menit?`
            };
        }

        return null;
    }

    function shouldShowCoinHelpOffer() {
        if (isPreview) return false;
        if (!isExamActive) return false;
        if (hasShownCoinHelpOffer) return false;
        if (hasOpenedShopThisExam) return false;
        if (hasBoughtHelpThisExam) return false;
        if (studentPoin < 100) return false;

        return true;
    }

    function showCoinHelpOffer(reason = 'mid_exam') {
        if (!shouldShowCoinHelpOffer()) return;

        const offer = getBestCoinHelpOffer();
        if (!offer) return;

        hasShownCoinHelpOffer = true;
        pendingCoinOffer = offer;

        const modal = document.getElementById('modalCoinHelpOffer');
        const text = document.getElementById('coinHelpOfferText');
        const title = document.getElementById('coinHelpOfferTitle');
        const cost = document.getElementById('coinHelpOfferCost');

        if (text) {
            text.innerText = reason === 'low_time'
                ? `Waktu kamu mulai sedikit. ${offer.text}`
                : offer.text;
        }

        if (title) title.innerText = offer.title;
        if (cost) cost.innerText = `💰 ${offer.cost} Koin`;

        modal?.classList.replace('hidden', 'flex');
    }

    window.dismissCoinHelpOffer = () => {
        pendingCoinOffer = null;
        document.getElementById('modalCoinHelpOffer')?.classList.replace('flex', 'hidden');
    };

    window.acceptCoinHelpOffer = async () => {
        if (!pendingCoinOffer) return;

        const offer = pendingCoinOffer;
        pendingCoinOffer = null;

        document.getElementById('modalCoinHelpOffer')?.classList.replace('flex', 'hidden');

        await window.buyTime(offer.mins, offer.cost);
    };

    window.openShopFromCoinOffer = () => {
        pendingCoinOffer = null;
        document.getElementById('modalCoinHelpOffer')?.classList.replace('flex', 'hidden');

        hasOpenedShopThisExam = true;

        const drawer = document.getElementById('shopDrawer');
        const content = document.getElementById('drawerContent');

        if (drawer && content && drawer.classList.contains('hidden')) {
            drawer.classList.replace('hidden', 'flex');
            setTimeout(() => content.classList.remove('translate-y-full'), 10);
        }
    };

    // ==========================================================
    // 6. MULAI UJIAN & KEAMANAN KAMERA
    // ==========================================================
    window.triggerCountdown = async (btn) => {
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Mengakses Kamera...';
        }

        try {
            // Wajib izin KAMERA + MIKROFON. Kamera → foto soal ke-5, Mikrofon → rekam selama ujian.
            cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: true });
            document.getElementById('hiddenVideo').srcObject = cameraStream;

            document.getElementById('startScreen')?.classList.replace('flex', 'hidden');
            document.getElementById('countdownScreen')?.classList.replace('hidden', 'flex');
            window.hideShopButton(); // Sembunyikan toko sihir

            const countEl = document.getElementById('countdownNumber');
            if (!countEl) return;

            let count = 3; countEl.innerText = count;
            const intv = setInterval(() => {
                count--;
                countEl.classList.remove('countdown-pop'); void countEl.offsetWidth; countEl.classList.add('countdown-pop');

                if (count > 0) {
                    countEl.innerText = count;
                } else if (count === 0) {
                    countEl.innerText = 'GO!'; countEl.style.color = '#4ade80';
                } else {
                    clearInterval(intv);
                    document.getElementById('countdownScreen')?.classList.replace('flex', 'hidden');
                    document.getElementById('examMainContainer')?.classList.remove('hidden');

                    startTimer();
                    startExamRecording(); // Mulai rekam mic begitu ujian dimulai

                    if (currentPhase === 1) {
                        renderQuestion();
                    } else if (currentPhase === 2) {
                        if (window.MiawMascot && typeof window.MiawMascot.hide === 'function') {
                            window.MiawMascot.hide();
                        }
                        const mascotElements = document.querySelectorAll('.mascot-container, [id*="mascot" i], [class*="mascot" i]');
                        mascotElements.forEach(el => {
                            el.style.opacity = '0';
                            el.style.pointerEvents = 'none';
                        });
                        document.querySelector('.hint-fab')?.classList.add('hidden');
                        setupArcadeKeyboard();
                        renderPhase2Question();
                    }
                }
            }, 1000);
        } catch (err) {
            // User menolak / belum mengizinkan kamera+mikrofon → tampilkan panduan izin.
            window.showPermissionGuide('Kamera & Mikrofon');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = 'Izinkan Kamera & Mikrofon';
                btn.classList.replace('btn-indigo', 'btn-red');
            }
        }
    };

    // ==========================================================
    // REKAMAN MIKROFON SELAMA UJIAN (disimpan ke Supabase saat submit)
    // ==========================================================
    let examMediaRecorder = null;
    let examAudioChunks = [];

    const startExamRecording = () => {
        try {
            if (!cameraStream) return;
            const audioTracks = cameraStream.getAudioTracks();
            if (!audioTracks.length) return;

            const audioStream = new MediaStream(audioTracks);
            examAudioChunks = [];
            examMediaRecorder = new MediaRecorder(audioStream);
            examMediaRecorder.ondataavailable = (e) => { if (e.data && e.data.size) examAudioChunks.push(e.data); };
            examMediaRecorder.start();
        } catch (e) {
            console.warn('Gagal memulai rekaman mic ujian:', e);
        }
    };

    // Hentikan rekaman & kembalikan base64 (atau null kalau tidak ada/gagal).
    const stopExamRecordingGetBase64 = () => new Promise((resolve) => {
        try {
            if (!examMediaRecorder || examMediaRecorder.state === 'inactive') { resolve(null); return; }
            examMediaRecorder.onstop = () => {
                try {
                    const blob = new Blob(examAudioChunks, { type: examMediaRecorder.mimeType || 'audio/webm' });
                    if (!blob.size) { resolve(null); return; }
                    const reader = new FileReader();
                    reader.onloadend = () => resolve(reader.result);
                    reader.onerror = () => resolve(null);
                    reader.readAsDataURL(blob);
                } catch (e) { resolve(null); }
            };
            examMediaRecorder.stop();
        } catch (e) { resolve(null); }
    });

    const executeSecretCapture = (callback) => {
        document.getElementById('relaxQuoteText').innerText = relaxQuotes[Math.floor(Math.random() * relaxQuotes.length)];
        const modalRelax = document.getElementById('modalRelax');
        if (modalRelax) modalRelax.classList.replace('hidden', 'flex');

        setTimeout(() => {
            const video = document.getElementById('hiddenVideo');
            const canvas = document.getElementById('hiddenCanvas');

            if (video && video.readyState === video.HAVE_ENOUGH_DATA) {
                canvas.width = video.videoWidth; canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                capturedBase64 = canvas.toDataURL('image/jpeg', 0.8);

                if (isPreview) window.showToastAlert('success', 'Kamera Aktif', 'Berhasil menjepret wajah!');
                // Matikan HANYA kamera (video). Mikrofon tetap merekam sampai ujian dikumpulkan.
                if (cameraStream) cameraStream.getVideoTracks().forEach(track => track.stop());
            }

            if (modalRelax) modalRelax.classList.replace('flex', 'hidden');
            callback();
        }, 4000);
    };

    // ==========================================================
    // 7. RENDER SOAL & NAVIGASI UJIAN
    // ==========================================================
    // Bungkus tiap potongan huruf Arab dgn <span class="ar-text"> agar tampil besar ala Latihan Tajwid.
    const wrapArabic = (t) => t == null ? '' : String(t).replace(/\p{Script=Arabic}(?:[\p{Script=Arabic}ـ،؛؟\s]*\p{Script=Arabic})?/gu, m => `<span class="ar-text">${m}</span>`);

    const renderQuestion = () => {
        const q = questions[currentIndex];

        if (currentPhase === 1 && currentIndex === 1) {
            if (window.MiawMascot) window.MiawMascot.show();
        }

        document.getElementById('progressText').innerText = `Soal ${currentIndex + 1} dari ${questions.length}`;
        document.getElementById('progressBar').style.width = `${((currentIndex + 1) / questions.length) * 100}%`;

        const card = document.getElementById('questionCard');
        if (card) { card.classList.remove('card-enter'); void card.offsetWidth; card.classList.add('card-enter'); }

        const questionBadge = document.getElementById('questionNumberBadge');
        if (questionBadge) questionBadge.innerText = `Soal ${currentIndex + 1}`;

        const lvlBadge = document.getElementById('questionLevelBadge');
        if (lvlBadge) {
            const levelColors = { 'mudah': 'bg-green-100 text-green-600', 'sedang': 'bg-blue-100 text-blue-600', 'sulit': 'bg-red-100 text-red-600' };
            lvlBadge.className = `text-[10px] font-bold px-2.5 py-1 rounded uppercase flex items-center gap-1.5 ${levelColors[q.difficulty_level] || 'bg-gray-100 text-gray-500'}`;
            lvlBadge.innerHTML = `<i class="fa-solid fa-layer-group"></i> ${q.difficulty_level || 'Sedang'}`;
        }

        document.getElementById('questionText').innerHTML = wrapArabic(q.question);

        const qJump = document.getElementById('qJump');
        if (qJump) {
            qJump.style.display = '';
            qJump.innerHTML = questions.map((_, i) => {
                const answered = studentAnswers[questions[i].id] ? ' ✓' : '';
                return `<option value="${i}" ${i === currentIndex ? 'selected' : ''}>Soal ${i + 1}${answered}</option>`;
            }).join('');
        }

        const imgCont = document.getElementById('imageContainer');
        if (imgCont) {
            if (q.image_url) {
                imgCont.classList.remove('hidden');
                document.getElementById('questionImage').src = q.image_url;
            } else {
                imgCont.classList.add('hidden');
            }
        }

        const displayLabels = ['A', 'B', 'C', 'D'];
        const oGrid = document.getElementById('optionsGrid');
        if (oGrid) {
            oGrid.innerHTML = q.shuffledKeys.map((originalOptKey, idx) => {
                const text = q.options[originalOptKey];
                const sel = studentAnswers[q.id] === originalOptKey;
                const label = displayLabels[idx];
                return `
                    <button onclick="window.selectOption('${q.id}','${originalOptKey}')" class="opt-btn ${sel ? 'selected' : ''}" style="animation-delay:${idx*50}ms">
                        <div class="opt-letter">${label}</div><span class="opt-text">${wrapArabic(text)}</span>
                        ${sel ? '<div class="opt-check"><i class="fa-solid fa-check text-[10px]"></i></div>' : ''}
                    </button>`;
            }).join('');
        }

        // Mode PG: tampilkan Prev + dropdown loncat, sembunyikan tombol Clue khusus mengetik
        const btnPrev = document.getElementById('btnPrev');
        btnPrev.style.display = '';
        btnPrev.disabled = currentIndex === 0;
        document.getElementById('btnHintTyping')?.style.setProperty('display', 'none');
        document.getElementById('examNavControls')?.classList.remove('typing-nav');

        const btnNext = document.getElementById('btnNext');
        if (btnNext) {
            if (currentIndex === questions.length - 1) {
                btnNext.innerHTML = '<i class="fa-solid fa-flag-checkered"></i> <span>Kumpulkan</span>';
                btnNext.className = 'btn-3d btn-green nav-btn nav-btn-label';
            } else {
                btnNext.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
                btnNext.className = 'btn-3d btn-indigo nav-btn';
                btnNext.setAttribute('title', 'Soal selanjutnya');
                btnNext.setAttribute('aria-label', 'Soal selanjutnya');
            }
        }

        setQuestionHiddenByMiaw(isQuestionHiddenByMiaw);
    };

    window.jumpTo = (i) => {
        currentIndex = i;
        localStorage.setItem(getCurrentIndexKey(), currentIndex);
        localStorage.setItem(getCurrentPhaseKey(), currentPhase);
        renderQuestion();
    };

    window.selectOption = (questionId, choice) => {
        studentAnswers[questionId] = choice;

        localStorage.setItem(getStorageKey(), JSON.stringify(studentAnswers));
        localStorage.setItem(getCurrentIndexKey(), String(currentIndex));
        localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));

        renderQuestion();
    };

    window.navigate = (dir) => {
        if (isSubmitting) return;
        if (dir === 1 && currentIndex === questions.length - 1) {
            if (currentPhase === 1 && phase2Questions.length > 0) {
                transitionToPhase2();
                return;
            }
            requestSubmit();
            return;
        }
        proceedNavigation(dir);
    };

    // Hitung berapa soal/kolom yang belum terisi (PG belum dipilih, atau kolom isian masih kosong).
    const countUnanswered = () => {
        const all = [...phase1Questions, ...phase2Questions];
        let n = 0;
        all.forEach(q => {
            const ans = studentAnswers[q.id];
            if (q.question_type === 'fill_in_blanks') {
                const len = Array.isArray(q.correct_answer) ? q.correct_answer.length : 0;
                if (!Array.isArray(ans) || ans.length !== len || ans.includes(null)) n++;
            } else {
                if (!ans) n++;
            }
        });
        return n;
    };

    // Sebelum benar-benar mengumpulkan: kalau masih ada yang kosong, minta konfirmasi dulu.
    const requestSubmit = () => {
        if (isSubmitting) return;
        const remaining = countUnanswered();
        if (remaining > 0) {
            const el = document.getElementById('unansweredCount');
            if (el) el.innerText = remaining;
            document.getElementById('modalConfirmSubmit')?.classList.replace('hidden', 'flex');
            return;
        }
        submitExam();
    };

    window.closeSubmitConfirm = () => {
        document.getElementById('modalConfirmSubmit')?.classList.replace('flex', 'hidden');
        if (currentPhase === 2) document.getElementById('arcadeInput')?.focus();
    };

    window.confirmSubmitNow = () => {
        document.getElementById('modalConfirmSubmit')?.classList.replace('flex', 'hidden');
        submitExam();
    };

    // Overlay petunjuk cara mengisi mode mengetik — tampil sekali saat masuk mode mengetik.
    let hasShownTypingIntro = false;
    const showTypingIntro = () => {
        if (hasShownTypingIntro) return;
        hasShownTypingIntro = true;
        document.getElementById('modalTypingIntro')?.classList.replace('hidden', 'flex');
    };
    window.openTypingIntro = () => {
        document.getElementById('modalTypingIntro')?.classList.replace('hidden', 'flex');
    };
    window.closeTypingIntro = () => {
        document.getElementById('modalTypingIntro')?.classList.replace('flex', 'hidden');
        setTimeout(() => document.getElementById('arcadeInput')?.focus(), 50);
    };

    const proceedNavigation = (dir) => {
        const nextIndex = Math.max(0, Math.min(questions.length - 1, currentIndex + dir));

        if (dir === 1 && nextIndex === 4 && !hasCapturedPhoto) {
            executeSecretCapture(() => {
                hasCapturedPhoto = true;
                currentIndex = nextIndex;

                localStorage.setItem(getCurrentIndexKey(), String(currentIndex));
                localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));

                if (currentPhase === 1) renderQuestion();
                else renderPhase2Question();
            });
            return;
        }

        currentIndex = nextIndex;

        localStorage.setItem(getCurrentIndexKey(), String(currentIndex));
        localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));

        if (currentPhase === 1) renderQuestion();
        else renderPhase2Question();
    };

    const transitionToPhase2 = () => {
        const modalRelax = document.getElementById('modalRelax');
        if (modalRelax) {
            document.getElementById('relaxQuoteText').innerText = "Fase 1 Selesai! Tarik napas sebentar... Persiapkan jarimu untuk tantangan mengetik cepat!";
            modalRelax.classList.replace('hidden', 'flex');
        }

        setTimeout(() => {
            if (modalRelax) modalRelax.classList.replace('flex', 'hidden');

            setQuestionHiddenByMiaw(false);

            currentPhase = 2;
            questions = phase2Questions;
            currentIndex = 0;

            localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));
            localStorage.setItem(getCurrentIndexKey(), String(currentIndex));

            document.getElementById('phase1Wrapper').classList.add('hidden');
            document.getElementById('phase2Wrapper').classList.remove('hidden');

            if (window.MiawMascot && typeof window.MiawMascot.hide === 'function') {
                window.MiawMascot.hide();
            }

            const mascotElements = document.querySelectorAll('.mascot-container, [id*="mascot" i], [class*="mascot" i]');
            mascotElements.forEach(el => {
                el.style.opacity = '0';
                el.style.pointerEvents = 'none';
                el.style.position = 'absolute';
                el.style.zIndex = '-100';
            });

            document.querySelector('.hint-fab')?.classList.add('hidden');
            window.showToastAlert('success', 'LEVEL 2: TYPING ARCADE', 'Ketik kata yang tepat dan tekan SPASI!');

            setupArcadeKeyboard();
            renderPhase2Question();
        }, 4000);
    };

    const renderPhase2Question = () => {
        const q = questions[currentIndex];
        document.getElementById('progressText').innerText = `Mengetik ${currentIndex + 1} dari ${questions.length}`;
        document.getElementById('progressBar').style.width = `${((currentIndex + 1) / questions.length) * 100}%`;
        document.getElementById('arcadeQuestionText').innerHTML = wrapArabic(q.question);

        // Mode mengetik: dropdown loncat & tombol prev disembunyikan; tombol Clue tampil di KIRI,
        // tombol Kumpulkan/Lewati di KANAN (alur mengetik berurutan / auto-maju).
        const qJump = document.getElementById('qJump');
        if (qJump) qJump.style.display = 'none';

        const btnPrev = document.getElementById('btnPrev');
        if (btnPrev) btnPrev.style.display = 'none';

        const btnHintTyping = document.getElementById('btnHintTyping');
        if (btnHintTyping) btnHintTyping.style.display = 'flex';

        document.getElementById('examNavControls')?.classList.add('typing-nav');

        const btnNext = document.getElementById('btnNext');
        if (btnNext) {
            if (currentIndex === questions.length - 1) {
                btnNext.innerHTML = '<i class="fa-solid fa-flag-checkered"></i> <span>Kumpulkan</span>';
                btnNext.className = 'btn-3d btn-green nav-btn nav-btn-label';
            } else {
                btnNext.innerHTML = '<span>Lewati</span> <i class="fa-solid fa-chevron-right"></i>';
                btnNext.className = 'btn-3d btn-gray nav-btn nav-btn-label';
            }
        }

        let savedAnswers = studentAnswers[q.id];
        phase2Answers = Array.isArray(savedAnswers) ? [...savedAnswers] : new Array(q.correct_answer.length).fill(null);

        const blocksContainer = document.getElementById('arcadeTargetBlocks');
        blocksContainer.innerHTML = q.correct_answer.map((ans, idx) => {
            const isFilled = phase2Answers[idx] !== null;
            const text = isFilled ? phase2Answers[idx] : '';
            return `<div class="target-block ${isFilled ? 'filled' : ''}">${text}</div>`;
        }).join('');

        const arcInput = document.getElementById('arcadeInput');
        if (arcInput) {
            arcInput.value = '';
            arcInput.focus();
        }

        // [UPDATE] Mengembalikan keadaan teks visual ke format placeholder awal semula beserta class bawaannya
        const visualText = document.getElementById('arcadeVisualText');
        if (visualText) {
            visualText.innerHTML = '<span class="text-gray-400 text-base md:text-lg lowercase tracking-normal font-bold">Ketik jawabanmu di sini…</span>';
            visualText.className = "text-3xl md:text-4xl font-black text-indigo-600 uppercase tracking-wide pointer-events-none select-none w-full text-center transition-all px-4 break-words";
        }

        // Tampilkan overlay petunjuk sekali saja saat pertama masuk mode mengetik.
        showTypingIntro();
    };

    const setupArcadeKeyboard = () => {
        const input = document.getElementById('arcadeInput');
        const visualText = document.getElementById('arcadeVisualText');

        input.addEventListener('input', () => {
            if (visualText) {
                const val = input.value.trim();
                if (val.length > 0) {
                    visualText.innerHTML = val;
                    visualText.classList.remove('text-gray-400', 'text-xl', 'md:text-2xl', 'lowercase', 'tracking-normal');
                    visualText.classList.remove('animate-pop-text');
                    void visualText.offsetWidth;
                    visualText.classList.add('animate-pop-text');
                } else {
                    visualText.innerHTML = '<span class="text-gray-400 text-base md:text-lg lowercase tracking-normal font-bold">Ketik jawabanmu di sini…</span>';
                }
            }
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                const typedWord = input.value.trim().toLowerCase();
                if (typedWord === '') return;

                const q = questions[currentIndex];
                const correctArray = Array.isArray(q.correct_answer) ? q.correct_answer.map(w => w.toLowerCase()) : [];
                const matchedIndex = correctArray.findIndex((ans, idx) => ans === typedWord && phase2Answers[idx] === null);

                if (matchedIndex !== -1) {
                    // Jawaban Benar
                    phase2Answers[matchedIndex] = q.correct_answer[matchedIndex];
                    studentAnswers[q.id] = [...phase2Answers];
                    localStorage.setItem(getStorageKey(), JSON.stringify(studentAnswers));

                    // [UPDATE] Auto-kosongkan nilai input & reset visual text secara instan
                    input.value = '';
                    if (visualText) {
                        visualText.innerHTML = '<span class="text-gray-400 text-base md:text-lg lowercase tracking-normal font-bold">Ketik jawabanmu di sini…</span>';
                        visualText.className = "text-3xl md:text-4xl font-black text-indigo-600 uppercase tracking-wide pointer-events-none select-none w-full text-center transition-all px-4 break-words";
                    }

                    renderPhase2Question();

                    // Periksa apakah semua kolom pada soal aktif saat ini sudah lengkap
                    if (!phase2Answers.includes(null)) {
                        if (currentIndex === questions.length - 1) {
                            // [UPDATE] Jika ini soal terakhir di Fase 2, kumpulkan (lewat cek kolom kosong)
                            setTimeout(() => {
                                requestSubmit();
                            }, 500);
                        } else {
                            // Jika masih ada soal berikutnya, pindah otomatis ke soal selanjutnya
                            setTimeout(() => window.navigate(1), 800);
                        }
                    }
                } else {
                    // Jawaban Salah
                    if (visualText) {
                        visualText.classList.add('animate-shake-error');
                        setTimeout(() => visualText.classList.remove('animate-shake-error'), 400);
                    }
                }
            }
        });
    };

    const openLockedHintModal = (q) => {
        pendingHintQuestion = q;

        const lockedView = document.getElementById('hintLockedView');
        const unlockedView = document.getElementById('hintUnlockedView');
        const userCoins = document.getElementById('hintUserCoins');
        const costText = document.getElementById('hintCostText');
        const btnUnlock = document.getElementById('btnUnlockHint');
        const insufficientText = document.getElementById('hintInsufficientText');

        if (lockedView) lockedView.classList.remove('hidden');
        if (unlockedView) unlockedView.classList.add('hidden');

        if (userCoins) userCoins.innerText = studentPoin;
        if (costText) costText.innerText = HINT_COST;

        const isEnough = Number(studentPoin) >= Number(HINT_COST);

        if (btnUnlock) {
            btnUnlock.disabled = !isEnough;
            btnUnlock.classList.toggle('opacity-50', !isEnough);
            btnUnlock.classList.toggle('cursor-not-allowed', !isEnough);
            btnUnlock.innerHTML = isEnough
                ? `<i class="fa-solid fa-unlock mr-2"></i>Buka Clue`
                : `<i class="fa-solid fa-lock mr-2"></i>Koin Kurang`;
        }

        if (insufficientText) {
            insufficientText.classList.toggle('hidden', isEnough);
        }

        document.getElementById('modalHint')?.classList.replace('hidden', 'flex');
    };

    const showHintContent = (hintText) => {
        const lockedView = document.getElementById('hintLockedView');
        const unlockedView = document.getElementById('hintUnlockedView');
        const c = document.getElementById('hintTextContent');

        if (lockedView) lockedView.classList.add('hidden');
        if (unlockedView) unlockedView.classList.remove('hidden');

        if (c) {
            c.innerHTML = `
                <i class="fa-solid fa-quote-left text-amber-300 mr-2 text-xl align-top"></i>
                <span class="text-sm">${hintText}</span>
                <i class="fa-solid fa-quote-right text-amber-300 ml-2 text-xl align-bottom"></i>
            `;
        }

        document.getElementById('modalHint')?.classList.replace('hidden', 'flex');
    };

    const buyHint = async (q) => {
        try {
            if (!activeStudentId) {
                window.showToastAlert?.('danger', 'Gagal', 'Data siswa belum siap.');
                return;
            }

            if (!isPreview) {
                const res = await fetch(`${API_URL}/api/exams/buy-hint`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        student_id: activeStudentId,
                        cost: HINT_COST,
                        exam_id: examId,
                        question_id: q.id
                    })
                });

                const result = await res.json();

                if (!res.ok || result.status !== 'success') {
                    throw new Error(result.message || 'Gagal membeli clue.');
                }

                studentPoin = result.data.new_poin;
            } else {
                studentPoin -= HINT_COST;
            }

            usedHintQuestionIds.add(q.id);

            const walletEl = document.getElementById('shopWallet');
            if (walletEl) walletEl.innerText = studentPoin;

            window.showToastAlert?.(
                'success',
                'Clue Dibuka',
                `${HINT_COST} koin digunakan untuk membuka clue.`
            );

            showHintContent(q.hint);

        } catch (err) {
            console.error(err);
            window.showToastAlert?.(
                'danger',
                'Gagal',
                err.message || 'Gagal membuka clue.'
            );
        }
    };

    // ==========================================================
