        if (!hasHint) {
            pendingHintQuestion = null;
            showHintContent("Ups! Sepertinya Kak Aziz tidak memberikan clue untuk soal ini... 😅");
            return;
        }

        // Preview guru / mode simulasi tetap gratis
        if (isPreview) {
            pendingHintQuestion = null;
            showHintContent(q.hint);
            return;
        }

        // Kalau clue untuk soal ini sudah pernah dibayar, jangan bayar lagi
        if (usedHintQuestionIds.has(q.id)) {
            pendingHintQuestion = null;
            showHintContent(q.hint);
            return;
