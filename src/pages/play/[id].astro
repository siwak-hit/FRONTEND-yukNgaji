            window.location.href =
                `/wrapped/${examId}?preview=true&teacher_preview=true&after=${encodeURIComponent(afterPreviewWrapped)}`;

            return;
        }

        const fallbackAfterWrapped = appendTokenToUrl(
            `/selesai?mode=exam&exam_id=${encodeURIComponent(examId)}&subject=${encodeURIComponent(examData?.subject || 'Ujian')}&student_id=${encodeURIComponent(activeStudentId)}&final=true&feedback_required=true`
        );

        const finalAfterWrapped = afterWrappedRedirect || fallbackAfterWrapped;

        window.location.replace(
            `/wrapped/${activeStudentId}?token=${encodeURIComponent(token)}&after=${encodeURIComponent(finalAfterWrapped)}`
        );
    };

    // ==========================================================
    // GLOBAL STATE & HELPER (Letakkan di luar/di atas fungsi submit)
    // ==========================================================
    let nextAfterExamRedirect = null;
    let afterWrappedRedirect = null;

    function appendTokenToUrl(url) {
        if (!url) return url;

        try {
            const targetUrl = new URL(url, window.location.origin);

            // Asumsi variabel 'token' sudah tersedia di scope global
            if (token && !targetUrl.searchParams.get('token')) {
                targetUrl.searchParams.set('token', token);
            }

            return targetUrl.pathname + targetUrl.search;
        } catch (e) {
            return url;
        }
    }

    function getPreviewFinalSelesaiUrl() {
        const params = new URLSearchParams({
            mode: 'exam',
            preview: 'true',
            teacher_preview: 'true',
            preview_final_flow: 'true',
            exam_id: examId || '',
            subject: examData?.subject || 'Ujian',
            student_id: 'preview_mode',
            final: 'true',
            feedback_required: 'true'
        });

        if (token) params.set('token', token);

        return `/selesai?${params.toString()}`;
    }
    // ==========================================================
    // 10. PENGUMPULAN UJIAN (SUBMIT)
    // ==========================================================
    const submitExam = async () => {
        if (isSubmitting) return;
        isSubmitting = true;

        const btnNext = document.getElementById('btnNext');
        if (btnNext) {
            btnNext.disabled = true;
            btnNext.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i><span>Memproses...</span>';
            btnNext.classList.replace('btn-indigo', 'btn-gray');
            btnNext.classList.replace('btn-green', 'btn-gray');
        }

        clearInterval(timerInterval);
        isExamActive = false;
        window.isTimeStoppedByCat = false;

        clearExamSession();

        const allQuestions = [...phase1Questions, ...phase2Questions];
        let correct = 0, skipped = 0;

        allQuestions.forEach(q => {
            const ans = studentAnswers[q.id];
            if (!ans) {
                skipped++;
            } else if (q.question_type === 'fill_in_blanks') {
                if (Array.isArray(ans) && !ans.includes(null) && ans.length === q.correct_answer.length) {
                    correct++;
                } else {
                    skipped++;
                }
            } else {
                if (ans === q.correct_answer) correct++;
            }
        });

        const wrong = allQuestions.length - correct - skipped;
        const score = allQuestions.length > 0 ? Math.round((correct / allQuestions.length) * 100) : 0;

        try {
            document.getElementById('statCorrect').innerText = correct;
            document.getElementById('statWrong').innerText = wrong;
            document.getElementById('statSkip').innerText = skipped;
            document.getElementById('resultScore').innerText = score;

            const circ = 326.72; const rf = document.getElementById('ringFill');
            if(rf) setTimeout(() => { rf.style.strokeDashoffset = circ - (score/100)*circ; }, 400);

            const emoji = document.getElementById('resultEmoji'), title = document.getElementById('resultTitle');
            if (score >= 80) {
                if(emoji) emoji.innerText = '🌟';
                if(title) title.innerText = 'Luar Biasa!'; if(rf) rf.style.stroke = '#22c55e';
                if(typeof confetti !== 'undefined') confetti({ particleCount: 200, spread: 100, origin: {y:0.5}, colors:['#6366f1','#22c55e','#f59e0b'] });
            } else if (score >= 60) {
                if(emoji) emoji.innerText = '👍';
                if(title) title.innerText = 'Kerja Bagus!'; if(rf) rf.style.stroke = '#3b82f6';
            } else {
                if(emoji) emoji.innerText = '💪';
                if(title) title.innerText = 'Tetap Semangat!'; if(rf) rf.style.stroke = '#f97316';
            }

            if (isPreview) {
                document.getElementById('resultMsg').innerText = "Simulasi Selesai. Nilai ini tidak tersimpan ke database.";
                if (capturedBase64) {
                    document.getElementById('previewCameraResult')?.classList.remove('hidden');
                    document.getElementById('previewCapturedImg').src = capturedBase64;
                }
            }
        } catch (err) { console.error("Error updating UI Result", err); }

        document.getElementById('modalFinish')?.classList.replace('hidden', 'flex');

        // Hentikan rekaman mic & ambil base64-nya (untuk preview pun tetap dihentikan, tapi tidak dikirim).
        const examAudioBase64 = await stopExamRecordingGetBase64();

        if (!isPreview) {
            try {
                const btnRet = document.getElementById('btnReturnHome');
                if(btnRet) {
                    btnRet.disabled = true;
                    btnRet.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
                }

                const formattedAnswersForBackend = Object.keys(studentAnswers).map(questionId => ({
                    question_id: questionId,
                    answer: studentAnswers[questionId]
                }));

                const res = await fetch(`${API_URL}/api/exams/${examId}/submit`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        student_id: activeStudentId,
                        subject: examData ? examData.subject : "Ujian",
                        score: score, // Nilai fallback dari UI jika API gagal ngitung
                        capture_base64: capturedBase64,
                        audio_base64: examAudioBase64,
                        student_answers: formattedAnswersForBackend
                    })
                });

                const data = await res.json();

                // ==============================================================
                // [UPDATE] LOGIKA HANDLING RESPONSE
                // ==============================================================
                const payload = data.data || data;

                isAllExamsDone = payload.is_all_completed === true;

                nextAfterExamRedirect = appendTokenToUrl(
                    payload.next_redirect ||
                    `/selesai?mode=exam&exam_id=${encodeURIComponent(examId)}&subject=${encodeURIComponent(examData?.subject || 'Ujian')}&student_id=${encodeURIComponent(activeStudentId)}`
                );

                afterWrappedRedirect = appendTokenToUrl(
                    payload.after_wrapped_redirect ||
                    `${nextAfterExamRedirect}&final=true&feedback_required=true`
                );

                if (payload.score !== undefined) {
                    document.getElementById('resultScore').innerText = payload.score;

                    const rf = document.getElementById('ringFill');
                    if (rf) {
                        setTimeout(() => {
                            rf.style.strokeDashoffset = 326.72 - (payload.score / 100) * 326.72;
                        }, 400);
                    }
                }
                // ==============================================================

                if(btnRet) {
                    btnRet.disabled = false;
                    btnRet.innerHTML = 'Tutup & Selesai';
                }
            } catch(e) {
                console.error("Gagal mengirim hasil", e);
                const btnRet = document.getElementById('btnReturnHome');
                if(btnRet) {
                    btnRet.disabled = false;
                    btnRet.innerHTML = 'Tutup & Selesai';
                }
            }
        } else {
            isAllExamsDone = true;
        }
    };

    // ==========================================================
    // [UPDATE] FUNGSI RETURN REDIRECT
    // ==========================================================
    window.returnFromExam = () => {
        isExamActive = false;

        // Cek jika ini adalah akhir perjalanan (Semua ujian beres)
        if ((isPreview && isPreviewFinalFlow) || isAllExamsDone) {
            document.getElementById('modalFinish')?.classList.replace('flex', 'hidden');
            // Tampilkan modal penawaran rahasia
            document.getElementById('modalSecretOffer').classList.replace('hidden', 'flex');
            return;
        }

        if (isPreview) {
            window.location.href = `/exams/${examId}`;
            return;
        }

        proceedToFinalRedirect();
    };

    // Setelah SEMUA ujian selesai → ke Halaman Selesai versi FINAL
    // (yang memunculkan "Misi Terakhir → Catatan Ngajiku/wrapped").
    window.goToSelesai = () => {
        document.getElementById('modalSecretOffer')?.classList.replace('flex', 'hidden');

        if (isPreview) {
            window.location.href = getPreviewFinalSelesaiUrl();
            return;
        }

        const fallbackFinal = appendTokenToUrl(
            `/selesai?mode=exam&exam_id=${encodeURIComponent(examId)}&subject=${encodeURIComponent(examData?.subject || 'Ujian')}&student_id=${encodeURIComponent(activeStudentId)}&final=true&feedback_required=true`
        );
        window.location.replace(afterWrappedRedirect || fallbackFinal);
    };

    // Fungsi eksekusi rute final (Feedback)
    window.proceedToFinalRedirect = () => {
        if (isPreview) {
            window.location.href = getPreviewFinalSelesaiUrl();
            return;
        }

        const fallbackRedirect = appendTokenToUrl(
            `/selesai?mode=exam&exam_id=${encodeURIComponent(examId)}&subject=${encodeURIComponent(examData?.subject || 'Ujian')}&student_id=${encodeURIComponent(activeStudentId)}`
        );
        window.location.replace(nextAfterExamRedirect || fallbackRedirect);
    };

    // ==========================================================
    // 11. EVENT LISTENER (KEAMANAN WINDOW)
    // ==========================================================
    window.addEventListener('beforeunload', (e) => {
        if (isExamActive || window.isEasterEggActive) {
            e.preventDefault();
            e.returnValue = 'Tunggu! Misi terakhirmu belum selesai. Yakin mau keluar?';
        }
    });

    window.addEventListener('popstate', (e) => {
        if (isExamActive || window.isEasterEggActive) {
            window.history.pushState(null, null, window.location.href);

            if (window.isEasterEggActive) {
                window.showToastAlert('warning', 'Eits, Mau Kemana?', 'Selesaikan rekamannya dulu supaya kamu bisa lihat hasil akhirnya!');
            } else {
                document.getElementById('modalCheatWarning')?.classList.replace('hidden', 'flex');
            }
        }
    });

    // Update harga secara real-time saat user mengetik angka
    window.updateCustomPrice = () => {
        const input = document.getElementById('customTimeInput');
        const btn = document.getElementById('btnBuyCustom');
        const mins = parseInt(input.value) || 0;
        const cost = mins * 100; // Kalkulasi 1 menit = 100 Koin

        if (mins > 0) {
            btn.innerHTML = `Beli (💰 ${cost})`;
            btn.disabled = false;
        } else {
            btn.innerHTML = 'Beli';
            btn.disabled = true;
        }
    };

    // Eksekusi pembelian custom
    window.buyCustomTime = () => {
        const input = document.getElementById('customTimeInput');
        const mins = parseInt(input.value) || 0;

        if (mins <= 0) return;
        const cost = mins * 100;

        const btn = document.getElementById('btnBuyCustom');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btn.disabled = true;

        // Panggil fungsi buyTime bawaan
        window.buyTime(mins, cost);

        // Reset input setelah berhasil
        setTimeout(() => {
            input.value = '';
            window.updateCustomPrice();
        }, 500);
    };

    window.closeCheatWarning = () => document.getElementById('modalCheatWarning')?.classList.replace('flex', 'hidden');


    const syncTimeLeftWithDeadline = () => {
        const deadlineRaw = localStorage.getItem(getExamDeadlineKey());
        if (!deadlineRaw) return timeLeft;

        const deadline = Number(deadlineRaw);
        if (!deadline || Number.isNaN(deadline)) return timeLeft;

        const remaining = Math.ceil((deadline - Date.now()) / 1000);
        timeLeft = Math.max(0, remaining);

        localStorage.setItem(getTimerKey(), String(timeLeft));

        return timeLeft;
    };

    const lockExamBecauseExpired = () => {
        // Mode preview tidak mengenal "minta izin guru".
        // Kalau waktu habis saat simulasi, langsung akhiri & tampilkan hasil saja.
        if (isPreview) {
            if (!isSubmitting) submitExam();
            return;
        }

        isExamActive = false;
        window.isTimeStoppedByCat = false;

        clearInterval(timerInterval);

        document.getElementById('examMainContainer')?.classList.add('hidden');
        document.getElementById('startScreen')?.classList.replace('flex', 'hidden');
        document.getElementById('lobbyScreen')?.classList.replace('flex', 'hidden');
        document.getElementById('loadingScreen')?.classList.add('hidden');

        document.getElementById('modalExamExpired')?.classList.replace('hidden', 'flex');

        window.showToastAlert?.(
            'warning',
            'Waktu Habis',
            'Minta Kak Aziz membuka ulang jika ada kendala teknis.'
        );
    };

    const checkRetakePermission = async () => {
        if (isPreview || !activeStudentId) return null;

        try {
            const res = await fetch(
                `${API_URL}/api/exams/${examId}/retake-permissions/check?student_id=${activeStudentId}`,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                }
            );

            const result = await res.json();

            if (!res.ok || result.status === 'error') return null;

            return result.data || null;
        } catch (err) {
            console.error('Gagal cek izin retake:', err);
            return null;
        }
    };

    const markRetakePermissionUsed = async (permissionId) => {
        if (!permissionId || !activeStudentId) return;

        try {
            await fetch(`${API_URL}/api/exams/${examId}/retake-permissions/use`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    permission_id: permissionId,
                    student_id: activeStudentId
                })
            });
        } catch (err) {
            console.error('Gagal menandai izin retake:', err);
        }
    };

    // Membersihkan progress/timer/posisi sesi ujian, TAPI menyisakan pilihan siswa
    // (active_student) — dipakai saat guru me-reset ujian agar siswa tak perlu pilih nama lagi.
    // Preview-aware: getter mengembalikan key `preview_*` saat isPreview, dan `exam_*` saat asli.
    const clearLocalExamSession = () => {
        localStorage.removeItem('cat_help_used');
        localStorage.removeItem(getStorageKey());
        localStorage.removeItem(getTimerKey());
        localStorage.removeItem(getExamStartedKey());
        localStorage.removeItem(getQuestionOrderKey());
        localStorage.removeItem(getCurrentIndexKey());
        localStorage.removeItem(getCurrentPhaseKey());
        localStorage.removeItem(getExamDeadlineKey());
        localStorage.removeItem(getExpiredReasonKey());
    };

    // Pembersihan PENUH untuk akhir ujian (submit) / keluar preview — termasuk
    // last-seen & pilihan siswa, karena sesi memang sudah benar-benar selesai.
    const clearExamSession = () => {
        clearLocalExamSession();
        localStorage.removeItem(getLastSeenKey());
        localStorage.removeItem(`active_student_${examId}`);
    };

    const restoreSavedExamPosition = () => {
        const savedPhase = parseInt(localStorage.getItem(getCurrentPhaseKey()) || '1');
        const savedIndex = parseInt(localStorage.getItem(getCurrentIndexKey()) || '0');

        currentPhase = savedPhase === 2 ? 2 : 1;

        if (currentPhase === 2 && phase2Questions.length > 0) {
            questions = phase2Questions;
            document.getElementById('phase1Wrapper')?.classList.add('hidden');
            document.getElementById('phase2Wrapper')?.classList.remove('hidden');
            document.querySelector('.hint-fab')?.classList.add('hidden');
        } else {
            currentPhase = 1;
            questions = phase1Questions;
            document.getElementById('phase2Wrapper')?.classList.add('hidden');
            document.getElementById('phase1Wrapper')?.classList.remove('hidden');
            document.querySelector('.hint-fab')?.classList.remove('hidden');
        }

        currentIndex = Math.max(0, Math.min(savedIndex, questions.length - 1));
    };

    const applyRetakePermission = async (permission) => {
        if (!permission) return false;

        await markRetakePermissionUsed(permission.id);

        if (permission.mode === 'reset') {
            clearLocalExamSession();

            studentAnswers = {};
            phase2Answers = [];
            currentIndex = 0;
            currentPhase = 1;
            timeLeft = totalDurationSeconds;

            localStorage.setItem(getTimerKey(), String(timeLeft));
            localStorage.setItem(getExamDeadlineKey(), String(Date.now() + (timeLeft * 1000)));
            localStorage.setItem(getExamStartedKey(), 'true');
            localStorage.setItem(getCurrentPhaseKey(), String(currentPhase));
            localStorage.setItem(getCurrentIndexKey(), String(currentIndex));

            document.getElementById('modalExamExpired')?.classList.replace('flex', 'hidden');
            document.getElementById('examMainContainer')?.classList.add('hidden');
            document.getElementById('startScreen')?.classList.replace('hidden', 'flex');

            window.showToastAlert?.(
                'success',
                'Ujian Dibuka Ulang',
                'Silakan mulai ulang ujian dari awal.'
            );

            return true;
        }

        if (permission.mode === 'extra_time') {
            const extraSeconds = (Number(permission.extra_minutes) || 0) * 60;

            timeLeft = Math.max(1, timeLeft) + extraSeconds;

            const newDeadline = Date.now() + (timeLeft * 1000);

            localStorage.setItem(getTimerKey(), String(timeLeft));
            localStorage.setItem(getExamDeadlineKey(), String(newDeadline));
            localStorage.removeItem(getExpiredReasonKey());

            restoreSavedExamPosition();

            document.getElementById('modalExamExpired')?.classList.replace('flex', 'hidden');
            document.getElementById('examMainContainer')?.classList.remove('hidden');
            document.getElementById('startScreen')?.classList.replace('flex', 'hidden');
            document.getElementById('lobbyScreen')?.classList.replace('flex', 'hidden');

            isExamActive = true;
            updateTimerUI();
            runExamTimer(1000);

            if (currentPhase === 1) renderQuestion();
            else renderPhase2Question();

            window.showToastAlert?.(
                'success',
                'Waktu Ditambahkan',
                `Ujian dibuka lagi dengan tambahan ${permission.extra_minutes} menit.`
            );

            return true;
        }

        if (permission.mode === 'continue') {
            timeLeft = Math.max(60, timeLeft || 60);

            const newDeadline = Date.now() + (timeLeft * 1000);

            localStorage.setItem(getTimerKey(), String(timeLeft));
            localStorage.setItem(getExamDeadlineKey(), String(newDeadline));
            localStorage.removeItem(getExpiredReasonKey());

            document.getElementById('modalExamExpired')?.classList.replace('flex', 'hidden');
            document.getElementById('examMainContainer')?.classList.remove('hidden');

            isExamActive = true;
            updateTimerUI();
            runExamTimer(1000);

            if (currentPhase === 1) renderQuestion();
            else renderPhase2Question();

            window.showToastAlert?.(
                'success',
                'Ujian Dilanjutkan',
                'Silakan lanjutkan ujian dari progress terakhir.'
            );

            return true;
        }

        return false;
    };

    window.handleCheckRetakePermission = async (event) => {
        const btn = event?.currentTarget;

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengecek...';
        }

        const permission = await checkRetakePermission();

        if (!permission) {
            window.showToastAlert?.(
                'warning',
                'Belum Ada Izin',
                'Hubungi ustadz untuk membuka ulang ujian.'
            );

            if (btn) {
                btn.disabled = false;
                btn.innerText = 'Cek Ulang Izin';
            }

            return;
        }

        const applied = await applyRetakePermission(permission);

        if (!applied && btn) {
            btn.disabled = false;
            btn.innerText = 'Cek Ulang Izin';
        }
    };

    // ==========================================================
    // 12. JALANKAN INIT SAAT LOAD
    // ==========================================================
    init();
</script>

<style is:global>
  /* --- (CSS LU TETAP SAMA KAYA SEBELUMNYA) --- */
