---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Detail Ujian Hafalan - yukNgaji">
    <div class="px-6 py-8 min-h-screen bg-slate-50">
        <header class="flex items-center justify-between mb-8">
            <div>
                <p id="subjectBadge" class="text-[10px] font-black text-indigo-500 uppercase tracking-widest mb-1">
                    MEMUAT...
                </p>
                <h1 id="pageTitle" class="text-2xl font-black text-slate-800 tracking-tight">
                    Ujian Hafalan
                </h1>
            </div>
            <a href="/ujian-hafalan" class="w-11 h-11 bg-white border-2 border-slate-200 text-slate-500 hover:bg-slate-100 rounded-xl flex items-center justify-center active:scale-95 transition-all">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
        </header>

        <section id="summaryCard" class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-white border-2 border-slate-100 rounded-2xl p-4 text-center shadow-sm">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total</p>
                <p id="sumTotal" class="text-2xl font-black text-slate-700 mt-1">0</p>
            </div>
            <div class="bg-green-50 border-2 border-green-100 rounded-2xl p-4 text-center shadow-sm">
                <p class="text-[10px] font-black text-green-500 uppercase tracking-widest">Selesai</p>
                <p id="sumDone" class="text-2xl font-black text-green-600 mt-1">0</p>
            </div>
            <div class="bg-amber-50 border-2 border-amber-100 rounded-2xl p-4 text-center shadow-sm">
                <p class="text-[10px] font-black text-amber-500 uppercase tracking-widest">Sisa</p>
                <p id="sumLeft" class="text-2xl font-black text-amber-600 mt-1">0</p>
            </div>
        </section>

        <section class="bg-white border-2 border-slate-100 rounded-3xl p-6 mb-6 shadow-sm">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-black text-slate-800">Target Hafalan</h2>
                <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-lg">
                    <i class="fa-solid fa-book-open"></i>
                </div>
            </div>

            <div id="sectionList" class="grid grid-cols-1 gap-4">
                <div class="text-center py-6">
                    <i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl"></i>
                </div>
            </div>
        </section>

        <section class="bg-white border-2 border-slate-100 rounded-3xl p-6 mb-8 shadow-sm">
            <div class="flex items-center justify-between mb-5 gap-3">
                <h2 class="text-lg font-black text-slate-800">Daftar Peserta</h2>
                <button onclick="createSessionPreview()" id="btnCreateSession"
                    class="shrink-0 px-5 py-3 bg-indigo-600 text-white rounded-xl text-xs font-black shadow-[0_4px_0_#4f46e5] active:translate-y-1 active:shadow-none transition-all">
                    Buat Sesi
                </button>
            </div>

            <div id="studentList" class="grid grid-cols-2 gap-3">
                <div class="col-span-2 text-center py-6">
                    <i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl"></i>
                </div>
            </div>
        </section>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const templateId = window.location.pathname.split('/').pop();

    let pageData = null;

    const getInitials = (name = '') => {
        return name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '--';
    };

    const getStatusMeta = (student) => {
        const tested = !!student.oral_result;
        if (!tested) {
            return {
                label: 'Belum',
                className: 'bg-amber-50 text-amber-600 border-amber-200',
                cardClass: 'bg-white border-slate-200 hover:border-indigo-300',
                avatarClass: 'bg-slate-50 text-slate-500 border-slate-200',
                disabled: false
            };
        }

        const status = student.oral_result.status || 'done';
        if (status === 'passed') {
            return {
                label: 'Lulus',
                className: 'bg-green-50 text-green-600 border-green-200',
                cardClass: 'bg-slate-50 border-slate-200 opacity-60 grayscale',
                avatarClass: 'bg-green-50 text-green-600 border-green-200',
                disabled: true
            };
        }

        if (status === 'need_remedial' || status === 'failed') {
            return {
                label: 'Remedial',
                className: 'bg-red-50 text-red-500 border-red-200',
                cardClass: 'bg-slate-50 border-slate-200 opacity-60 grayscale',
                avatarClass: 'bg-red-50 text-red-500 border-red-200',
                disabled: true
            };
        }

        return {
            label: 'Selesai',
            className: 'bg-slate-100 text-slate-500 border-slate-200',
            cardClass: 'bg-slate-50 border-slate-200 opacity-60 grayscale',
            avatarClass: 'bg-slate-100 text-slate-500 border-slate-200',
            disabled: true
        };
    };

    const fetchDetail = async () => {
        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal memuat detail evaluasi.');
            }

            pageData = result.data;
            renderPage();
        } catch (error) {
            console.error(error);
            window.showToast?.('danger', 'Gagal', error.message);
        }
    };

    const renderPage = () => {
        const { template, sections, students, summary } = pageData;

        document.getElementById('subjectBadge').innerText = template.subject;
        document.getElementById('pageTitle').innerText = template.title;

        document.getElementById('sumTotal').innerText = summary.total_students;
        document.getElementById('sumDone').innerText = summary.tested_students;
        document.getElementById('sumLeft').innerText = summary.not_tested_students;

        // Render List Materi
        document.getElementById('sectionList').innerHTML = sections.map((section, index) => {
            const totalItems = section.oral_exam_items?.length || 0;
            return `
                <div class="bg-slate-50 border-2 border-slate-100 rounded-[1.5rem] p-5">
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 shrink-0 rounded-xl bg-white border-2 border-slate-200 text-indigo-600 flex items-center justify-center text-xs font-black shadow-sm">
                                ${index + 1}
                            </div>
                            <div>
                                <p class="text-sm font-black text-slate-800 leading-tight">${section.title}</p>
                                <p class="text-[10px] font-bold text-slate-500 mt-1">Wajib: ${section.min_required} dari ${totalItems} Materi</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        ${(section.oral_exam_items || []).map(item => `
                            <span class="text-[10px] font-bold bg-white text-slate-600 border-2 border-slate-100 px-3 py-1.5 rounded-xl shadow-sm">
                                ${item.short_label || item.title}
                            </span>
                        `).join('')}
                    </div>
                </div>
            `;
        }).join('');

        // Render List Siswa
        document.getElementById('studentList').innerHTML = students.map(student => {
            const meta = getStatusMeta(student);
            const tested = !!student.oral_result;

            return `
                <div class="relative rounded-[1.25rem] border-2 ${meta.cardClass} p-4 text-center transition-all ${!meta.disabled ? 'active:scale-95' : ''}">
                    <div class="w-12 h-12 mx-auto rounded-full border-2 ${meta.avatarClass} flex items-center justify-center font-black text-sm mb-3 shadow-sm">
                        ${getInitials(student.name)}
                    </div>
                    <p class="text-xs font-black text-slate-800 truncate w-full">${student.name}</p>
                    <p class="text-[10px] font-bold text-slate-400 mt-0.5 truncate w-full">${student.grade || '-'}</p>

                    <div class="mt-3">
                        <span class="inline-block px-3 py-1 rounded-lg border-2 text-[9px] font-black uppercase tracking-widest ${meta.className}">
                             ${meta.label} ${tested ? `(Nilai: ${student.oral_result.final_score || 0})` : ''}
                        </span>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.createSessionPreview = async () => {
        const notTested = pageData.students.filter(s => !s.oral_result);
        if (notTested.length === 0) {
            window.showToast?.('success', 'Selesai', 'Semua siswa sudah diuji.');
            return;
        }

        const btn = document.getElementById('btnCreateSession');
        const originalText = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btn.classList.add('opacity-70', 'cursor-not-allowed', 'translate-y-1');
        btn.classList.remove('shadow-[0_4px_0_#4f46e5]');

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions`, {
                method: 'POST',
                headers: {
                    Authorization: `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({})
            });

            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal membuat sesi.');
            }

            const sessionId = result.data.session.id;
            window.location.href = `/ujian-hafalan/${templateId}/session/${sessionId}`;

        } catch (error) {
            console.error(error);
            window.showToast?.('danger', 'Gagal', error.message);

            btn.disabled = false;
            btn.innerHTML = originalText;
            btn.classList.remove('opacity-70', 'cursor-not-allowed', 'translate-y-1');
            btn.classList.add('shadow-[0_4px_0_#4f46e5]');
        }
    };

    fetchDetail();
</script>
