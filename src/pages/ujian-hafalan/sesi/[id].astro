---
import Layout from '../../../layouts/Layout.astro';
import Toast from '../../../components/Toast.astro';
import ModalAlert from '../../../components/ModalAlert.astro';
import Loading from '../../../components/Loading.astro';

// Stok foto kejutan per anak: taruh filenya di src/assets/murid/<nama-anak>/…
// Didaftar saat BUILD (import.meta.glob), jadi tak perlu API/upload — cukup deploy ulang
// setelah menambah foto. Nama folder dicocokkan longgar dengan nama murid (huruf kecil, spasi → -).
const files = import.meta.glob('/src/assets/murid/**/*.{jpg,jpeg,png,gif,webp,JPG,JPEG,PNG,GIF,WEBP}', {
    eager: true, query: '?url', import: 'default',
});
const photos: Record<string, string[]> = {};
for (const [path, url] of Object.entries(files)) {
    const folder = path.split('/').slice(-2)[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    (photos[folder] ||= []).push(url as string);
}
---

<Layout title="Sesi Ujian Lisan - yukNgaji">
    <!-- ============ ANTRIAN ============ -->
    <div id="queueView" class="px-6 py-8 pb-32 min-h-screen">
        <header class="flex items-center gap-3 mb-5">
            <a href="/ujian-hafalan" class="btn-icon flex-shrink-0" aria-label="Kembali"><i class="fa-solid fa-chevron-left"></i></a>
            <div class="min-w-0">
                <p id="qEyebrow" class="eyebrow">Ujian Lisan</p>
                <h1 id="qTitle" class="page-title truncate">Memuat...</h1>
            </div>
        </header>

        <div class="card card-pad mb-4">
            <div class="flex items-center justify-between mb-1.5">
                <p class="caption font-bold text-ink"><span id="qDone">0</span>/<span id="qTotal">0</span> murid selesai</p>
                <p class="caption" id="qAvg">—</p>
            </div>
            <div class="h-2 rounded-full overflow-hidden" style="background: var(--surface-sunken);">
                <div id="qBar" class="h-full transition-all" style="width:0%; background: var(--accent);"></div>
            </div>
        </div>

        <!-- Link layar murid (device kedua) -->
        <div class="card card-pad mb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="icon-chip" style="background-color: var(--info-soft); color: var(--info);"><i class="fa-solid fa-tv"></i></div>
                <div class="min-w-0 flex-1">
                    <p class="caption font-bold text-ink">Layar Murid</p>
                    <p class="text-[11px] text-tertiary">Buka link ini di HP/laptop yang dilihat anak</p>
                </div>
            </div>
            <p id="liveUrl" class="text-[11px] font-mono break-all px-3 py-2 rounded-lg mb-2" style="background: var(--surface-sunken); color: var(--ink-secondary);">memuat...</p>
            <div class="flex gap-2">
                <button id="btnCopyLive" class="btn-soft !py-2 !px-3 text-xs flex-1"><i class="fa-solid fa-copy"></i> Salin link</button>
                <a id="btnOpenLive" href="#" target="_blank" rel="noopener" class="btn-soft !py-2 !px-3 text-xs flex-1 text-center"><i class="fa-solid fa-arrow-up-right-from-square"></i> Buka</a>
            </div>
        </div>

        <div class="card card-pad !py-3 mb-5 flex items-center justify-between gap-3">
            <div class="min-w-0">
                <p class="caption font-bold text-ink">Waktu bersiap</p>
                <p class="text-[11px] text-tertiary">Soal muncul duluan, timer jalan setelah hitungan ini</p>
            </div>
            <div class="flex gap-2 flex-shrink-0">
                <button class="gap-btn chip" data-gap="3">3 dtk</button>
                <button class="gap-btn chip" data-gap="5">5 dtk</button>
            </div>
        </div>

        <div id="queueList" class="space-y-2.5">
            <div class="text-center py-10"><i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i></div>
        </div>
    </div>

    <!-- ============ PAPAN KENDALI GURU ============ -->
    <div id="playView" class="hidden fixed inset-0 z-50 flex flex-col" style="background: var(--canvas);">
        <header class="flex items-center gap-3 px-5 py-3 border-b" style="border-color: var(--hairline);">
            <button id="btnQuit" class="btn-icon !w-9 !h-9" aria-label="Keluar"><i class="fa-solid fa-xmark"></i></button>
            <div class="min-w-0 flex-1">
                <p class="eyebrow">Sedang diuji</p>
                <p id="pName" class="section-title truncate capitalize">-</p>
            </div>
            <span id="liveDot" class="badge badge-accent flex-shrink-0"><i class="fa-solid fa-circle text-[7px]"></i> Layar</span>
        </header>

        <!-- Panel A: guru memilih perintah mana yang dimunculkan -->
        <div id="ctrlPick" class="flex-1 overflow-y-auto px-6 py-5 pb-28">
            <p class="field-label mb-2">Pilih perintah yang mau dimunculkan</p>
            <div id="promptList" class="space-y-2.5"></div>
            <p class="caption text-center mt-3">Tidak harus semua. Nilai dihitung dari perintah yang dijalankan saja.</p>
        </div>

        <!-- Tombol simpan: menempel di bawah, selalu kelihatan -->
        <div id="saveBar" class="hidden absolute inset-x-0 bottom-0 px-6 py-4" style="background: var(--canvas); border-top: 1px solid var(--hairline);">
            <button id="btnFinish" class="btn btn-primary w-full" disabled><i class="fa-solid fa-flag-checkered"></i> Selesai &amp; Simpan Nilai</button>
        </div>

        <!-- Panel B: perintah sedang berjalan -->
        <div id="ctrlRun" class="hidden flex-1 flex flex-col">
            <main class="flex-1 flex flex-col items-center justify-center text-center px-7">
                <span id="pCategory" class="badge badge-warning capitalize mb-3">kategori</span>
                <h2 id="pPrompt" class="text-2xl font-bold leading-snug" style="color: var(--ink); letter-spacing: var(--tracking-tight);">-</h2>

                <div class="relative my-8" style="width:190px;height:190px;">
                    <svg viewBox="0 0 120 120" class="absolute inset-0 -rotate-90" style="width:100%;height:100%;">
                        <circle cx="60" cy="60" r="52" fill="none" stroke="var(--surface-sunken)" stroke-width="10"></circle>
                        <circle id="pRing" cx="60" cy="60" r="52" fill="none" stroke="var(--accent)" stroke-width="10"
                                stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="0"></circle>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span id="pTimer" class="font-black leading-none" style="font-size:3.4rem; color: var(--ink);">0</span>
                        <span id="pTimerCap" class="caption mt-1">detik</span>
                    </div>
                </div>

                <p id="pPhase" class="caption"><i class="fa-solid fa-bullhorn"></i> Bacakan perintahnya sekarang</p>
            </main>

            <footer class="px-6 pb-8 pt-3">
                <div class="flex gap-2 mb-3">
                    <button id="btnSheetMsg" class="btn-soft !py-2.5 flex-1 text-xs"><i class="fa-solid fa-comment-dots"></i> Pesan</button>
                    <button id="btnSheetPhoto" class="btn-soft !py-2.5 flex-1 text-xs"><i class="fa-solid fa-image"></i> Foto</button>
                </div>
                <div class="flex gap-2">
                    <button id="btnPass" class="btn flex-1 !py-4" style="background-color: var(--surface-sunken); color: var(--ink-secondary);"><i class="fa-solid fa-flag"></i> Menyerah</button>
                    <button id="btnEnough" class="btn btn-primary !py-4 text-base" style="flex:2;"><i class="fa-solid fa-check"></i> Cukup</button>
                </div>
                <p class="caption text-center mt-2">"Cukup" = anak sudah selesai · "Menyerah" = anak tidak tahu (nilai 0).</p>
            </footer>
        </div>

        <!-- Laci kirim pesan / foto ke layar murid (dipakai saat perintah sedang jalan) -->
        <div id="sheet" class="hidden absolute inset-0 z-40 flex items-end" style="background: rgba(0,0,0,.45);">
            <div class="w-full card card-pad overflow-y-auto" style="max-height:82%; border-radius: var(--r-lg) var(--r-lg) 0 0;">
                <div class="flex items-center justify-between mb-4">
                    <p id="sheetTitle" class="section-title">Kirim ke Layar</p>
                    <button id="sheetClose" class="btn-icon !w-8 !h-8" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <div id="sheetMsg">
                    <p class="field-label">Penyemangat</p>
                    <div id="tplInfo" class="flex flex-wrap gap-2 mb-5"></div>
                    <p class="field-label">Peringatan</p>
                    <div id="tplWarn" class="flex flex-wrap gap-2"></div>
                </div>

                <div id="sheetPhoto" class="hidden">
                    <div id="photoGrid" class="grid grid-cols-3 gap-2"></div>
                </div>

                <p class="caption text-center mt-4">Tampil 5 detik di layar murid, lalu hilang sendiri.</p>
            </div>
        </div>

        <!-- konfirmasi saat waktu habis -->
        <div id="modalTimeUp" class="hidden absolute inset-0 z-30 flex items-center justify-center px-8" style="background: rgba(0,0,0,.45);">
            <div class="card card-pad text-center" style="max-width:20rem;">
                <div class="icon-chip mx-auto mb-3" style="width:3.2rem;height:3.2rem;font-size:1.3rem;background-color: var(--warning-soft); color: var(--warning);">
                    <i class="fa-solid fa-hourglass-end"></i>
                </div>
                <h3 class="section-title mb-1">Waktu habis</h3>
                <p class="body-text mb-5">Apakah <b id="tuName">anak</b> sudah selesai menyetorkannya?</p>
                <div class="flex gap-3">
                    <button id="btnTuNo" class="btn btn-soft flex-1" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Belum</button>
                    <button id="btnTuYes" class="btn btn-primary flex-1">Sudah</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ REKAP NILAI ============ -->
    <div id="resultView" class="hidden fixed inset-0 z-50 overflow-y-auto px-6 py-8" style="background: var(--canvas);">
        <div class="max-w-md mx-auto text-center">
            <p class="eyebrow">Hasil Ujian Lisan</p>
            <h2 id="rName" class="page-title capitalize mb-4">-</h2>
            <div class="card card-pad mb-5">
                <div id="rScore" class="font-black leading-none" style="font-size:4rem; color: var(--accent);">0</div>
                <p class="caption mt-1">nilai akhir</p>
                <p id="rBonus" class="caption mt-2"></p>
            </div>
            <p class="field-label text-left mb-2">Rincian</p>
            <div id="rDetail" class="space-y-2 text-left"></div>
            <button id="btnResultNext" class="btn btn-primary w-full mt-6">Bersiap ke Anak Berikutnya</button>
        </div>
    </div>

    <Toast />
    <ModalAlert />
    <Loading />
    <script type="application/json" id="photoData" set:html={JSON.stringify(photos)}></script>
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    if (!token) window.location.replace('/');
    const H = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };
    const sessionId = window.location.pathname.split('/').pop();

    const SUBJ = { tajwid: 'Tajwid', fiqih: 'Fiqih', tauhid: 'Tauhid' };
    const esc = (s) => (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const $ = (id) => document.getElementById(id);
    const RING = 2 * Math.PI * 52;

    // Sesi dimuat SEKALI (sesi + antrian + perintah lengkap), sisanya jalan di memori.
    let session = null;
    let row = null;             // murid yang sedang diuji
    let plan = [];              // perintah anak ini (urutan bebas, guru yang pilih)
    let cur = null;             // perintah yang sedang jalan
    let curStart = 0;           // stempel waktu SERVER saat perintah dimulai
    let items = [];             // hasil mentah urut kerjaan: {prompt_id, used_seconds, outcome}
    let timerId = null;
    let clockOffset = 0;        // selisih jam device ini vs server
    const srvNow = () => Date.now() + clockOffset;

    // Waktu bersiap sebelum timer asli jalan: preferensi guru, diingat browser.
    const GAP_KEY = 'oral_gap_seconds';
    let gapSeconds = 3;

    const setGap = (n, save) => {
        gapSeconds = [3, 5].includes(n) ? n : 3;
        if (save) localStorage.setItem(GAP_KEY, String(gapSeconds));
        document.querySelectorAll('.gap-btn').forEach(b => b.classList.toggle('is-active', parseInt(b.dataset.gap) === gapSeconds));
    };
    document.querySelectorAll('.gap-btn').forEach(b => b.addEventListener('click', () => setGap(parseInt(b.dataset.gap), true)));
    setGap(parseInt(localStorage.getItem(GAP_KEY)) || 3);

    // ---------------- LAYAR MURID ----------------
    // Satu-satunya jembatan ke device kedua: guru menulis state, layar murid membaca tiap detik.
    // Hitung mundurnya jalan lokal dari `startAt` (jam server), jadi telat polling tidak menggeser timer.
    let liveBase = { phase: 'idle' };   // state terakhir yang dikirim — pesan/gambar ditempel di atasnya

    const pushLive = async (state) => {
        liveBase = state;
        try {
            const res = await fetch(`${API_URL}/api/oral/sessions/${sessionId}/live`, {
                method: 'POST', headers: H, body: JSON.stringify({ state }),
            });
            const json = await res.json();
            if (!res.ok) throw new Error(json.message);
            clockOffset = json.data.now - Date.now();
            liveBase = json.data.state;                 // simpan startAt hasil stempel server
            $('liveDot').className = 'badge badge-accent flex-shrink-0';
            return json.data.state;
        } catch {
            // Layar murid mungkin tak terpakai / internet putus — ujian tetap boleh jalan di HP guru.
            $('liveDot').className = 'badge badge-danger flex-shrink-0';
            return null;
        }
    };

    const liveLink = () => `${window.location.origin}/tampil/${session.live_code}`;

    $('btnCopyLive').addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(liveLink());
            window.showToast?.('success', 'Tersalin', 'Buka link itu di device murid.');
        } catch {
            window.showToast?.('warning', 'Gagal menyalin', 'Ketik manual linknya ya.');
        }
    });

    // ---------------- KIRIM PESAN / FOTO KE LAYAR MURID ----------------
    // Ditempel ke state yang sedang tampil (tidak menimpa fase ujian) lalu dibersihkan lagi.
    // Foto memakai URL file statis (src/assets/murid/<anak>/…), bukan base64 — enteng dipolling.
    const SHOW_MS = 5000;
    const PHOTOS = JSON.parse($('photoData').textContent || '{}');
    const slug = (s) => String(s || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');
    let wipeId = null;

    const TEMPLATES = {
        info: ['Semangat, kamu pasti bisa! 💪', 'Tenang… tarik napas dulu 😊', 'Mantap! Lanjutkan ⭐',
               'Sedikit lagi, ayo! 🚀', 'Suaranya dilantangkan ya 🔊'],
        warn: ['Fokus! Jangan menoleh 👀', 'Jangan lihat catatan ❗', 'Waktu hampir habis ⏰',
               'Ssst… jangan berisik 🤫', 'Duduk yang rapi dulu 🪑'],
    };

    const showOnScreen = (extra) => {
        const until = srvNow() + SHOW_MS;
        pushLive({ ...liveBase, ...(extra.msg ? { msg: { ...extra.msg, until } } : { media: { url: extra.url, until } }) });
        clearTimeout(wipeId);
        wipeId = setTimeout(() => pushLive({ ...liveBase, msg: null, media: null }), SHOW_MS + 400);
        $('sheet').classList.add('hidden');
    };

    const renderTemplates = () => {
        const chips = (kind) => TEMPLATES[kind].map((t, i) =>
            `<button data-tpl="${kind}:${i}" class="chip ${kind === 'warn' ? 'chip-warn' : ''}">${esc(t)}</button>`).join('');
        $('tplInfo').innerHTML = chips('info');
        $('tplWarn').innerHTML = chips('warn');
        document.querySelectorAll('[data-tpl]').forEach(b => b.addEventListener('click', () => {
            const [kind, i] = b.dataset.tpl.split(':');
            showOnScreen({ msg: { text: TEMPLATES[kind][i], kind } });
        }));
    };
    renderTemplates();

    // Stok foto anak yang sedang diuji saja (folder dicocokkan dengan namanya).
    const renderPhotos = () => {
        const list = PHOTOS[slug(row?.name)] || [];
        $('photoGrid').innerHTML = list.length
            ? list.map(u => `<button data-photo="${esc(u)}" class="overflow-hidden" style="border-radius: var(--r-md);">
                    <img src="${esc(u)}" alt="" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" /></button>`).join('')
            : `<p class="caption col-span-3 text-center py-6">Belum ada foto untuk ${esc(row?.name || 'anak ini')}.<br>Taruh filenya di <b>src/assets/murid/${esc(slug(row?.name))}/</b> lalu deploy ulang.</p>`;
        $('photoGrid').querySelectorAll('[data-photo]').forEach(b =>
            b.addEventListener('click', () => showOnScreen({ url: b.dataset.photo })));
    };

    const openSheet = (mode) => {
        $('sheetTitle').textContent = mode === 'photo' ? 'Kirim Foto' : 'Kirim Pesan';
        $('sheetMsg').classList.toggle('hidden', mode === 'photo');
        $('sheetPhoto').classList.toggle('hidden', mode !== 'photo');
        if (mode === 'photo') renderPhotos();
        $('sheet').classList.remove('hidden');
    };

    $('btnSheetMsg').addEventListener('click', () => openSheet('msg'));
    $('btnSheetPhoto').addEventListener('click', () => openSheet('photo'));
    $('sheetClose').addEventListener('click', () => $('sheet').classList.add('hidden'));
    $('sheet').addEventListener('click', (e) => { if (e.target === $('sheet')) $('sheet').classList.add('hidden'); });

    // Dipanggil saat pindah anak / tutup papan kendali — pesan & foto tak boleh nyangkut.
    const clearOverlay = () => { clearTimeout(wipeId); $('sheet').classList.add('hidden'); };

    // ---------------- ANTRIAN ----------------
    const renderQueue = () => {
        $('qTitle').textContent = session.title || `Sesi ${SUBJ[session.subject] || session.subject}`;
        $('qEyebrow').textContent = `${SUBJ[session.subject] || session.subject} · ${Math.round(session.per_student_seconds / 60)} menit/anak`;
        $('liveUrl').textContent = liveLink();
        $('btnOpenLive').href = liveLink();

        const done = session.queue.filter(q => q.status === 'done');
        $('qDone').textContent = done.length;
        $('qTotal').textContent = session.queue.length;
        $('qBar').style.width = `${session.queue.length ? (done.length / session.queue.length) * 100 : 0}%`;
        $('qAvg').textContent = done.length
            ? `rata-rata ${Math.round(done.reduce((a, b) => a + (b.final_score || 0), 0) / done.length)}`
            : '—';

        $('queueList').innerHTML = session.queue.map((q, i) => {
            const total = q.prompts.reduce((s, p) => s + p.duration_seconds, 0);
            const isDone = q.status === 'done';
            return `
            <div class="card card-pad !py-3 flex items-center gap-3">
                <div class="avatar w-10 h-10 text-xs flex-shrink-0">${esc((q.name || '?').substring(0, 2).toUpperCase())}</div>
                <div class="min-w-0 flex-1">
                    <p class="caption font-semibold text-ink truncate capitalize">${i + 1}. ${esc(q.name)}</p>
                    <p class="text-[10px] text-tertiary font-medium">${q.prompts.length} perintah · ${total} detik</p>
                </div>
                ${isDone
                    ? `<div class="text-right flex-shrink-0">
                         <p class="text-lg font-black leading-none" style="color: var(--accent-strong);">${q.final_score}</p>
                         <button data-detail="${q.student_id}" class="text-[10px] font-bold" style="color: var(--info);">lihat rincian</button>
                       </div>`
                    : `<button data-start="${q.student_id}" class="btn btn-primary !py-2 !px-4 text-xs flex-shrink-0">Panggil <i class="fa-solid fa-play ml-1"></i></button>`}
            </div>`;
        }).join('');
        $('queueList').querySelectorAll('[data-start]').forEach(b => b.addEventListener('click', () => startStudent(b.dataset.start)));
        $('queueList').querySelectorAll('[data-detail]').forEach(b => b.addEventListener('click', () => {
            const q = session.queue.find(x => x.student_id === b.dataset.detail);
            showResult(q.name, q.final_score, q.details || [], false);
        }));
    };

    const load = async () => {
        window.boxBusy($('queueList'), 'Memuat antrian...');
        try {
            const res = await fetch(`${API_URL}/api/oral/sessions/${sessionId}`, { headers: H });
            const json = await res.json();
            if (!res.ok) throw new Error(json.message || 'Gagal memuat sesi.');
            session = json.data;
            renderQueue();
        } catch (e) {
            $('queueList').innerHTML = `<div class="empty-state card"><p class="caption" style="color:var(--danger)">${esc(e.message)}</p></div>`;
        }
    };

    // ---------------- PAPAN KENDALI ----------------
    const startStudent = (studentId) => {
        row = session.queue.find(q => q.student_id === studentId);
        if (!row || !row.prompts.length) { window.showToast?.('warning', 'Kosong', 'Murid ini belum punya perintah.'); return; }
        plan = row.prompts.slice();
        items = []; cur = null;
        clearOverlay();
        $('pName').textContent = row.name;
        $('queueView').classList.add('hidden');
        $('resultView').classList.add('hidden');
        $('playView').classList.remove('hidden');
        showPicker();
    };

    // Layar murid: nama anak yang dipanggil + "tunggu aba-aba".
    const showPicker = (note, celebrate) => {
        cur = null;
        clearInterval(timerId);
        clearOverlay();
        $('ctrlRun').classList.add('hidden');
        $('ctrlPick').classList.remove('hidden');
        $('saveBar').classList.remove('hidden');
        renderPrompts();
        pushLive({
            phase: 'ready', name: row.name, note: note || null,
            index: items.length, total: plan.length,
            celebrate: celebrate ? Date.now() : null,   // dipakai layar murid buat meledakkan confetti
        });
    };

    const renderPrompts = () => {
        $('promptList').innerHTML = plan.map((p, i) => {
            const it = items.find(x => x.prompt_id === p.id);
            return `
            <div class="card card-pad !py-3 flex items-center gap-3 ${it ? 'opacity-60' : ''}">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-0.5">
                        <span class="badge badge-warning capitalize">${esc(p.category)}</span>
                        <span class="caption">${p.duration_seconds} dtk</span>
                    </div>
                    <p class="caption text-ink">${esc(p.title)}</p>
                </div>
                ${it
                    ? `<i class="fa-solid fa-circle-check text-lg flex-shrink-0" style="color: var(--accent);"></i>`
                    : `<button data-run="${i}" class="btn btn-primary !py-2 !px-4 text-xs flex-shrink-0">Mulai <i class="fa-solid fa-play ml-1"></i></button>`}
            </div>`;
        }).join('');
        $('promptList').querySelectorAll('[data-run]').forEach(b =>
            b.addEventListener('click', () => runPrompt(plan[parseInt(b.dataset.run)], b)));
        $('btnFinish').disabled = !items.length;
        $('btnFinish').innerHTML = `<i class="fa-solid fa-flag-checkered"></i> Selesai &amp; Simpan Nilai${items.length ? ` (${items.length}/${plan.length})` : ''}`;
    };

    const runPrompt = async (p, btn) => {
        const restore = window.btnBusy(btn, 'Menyiapkan...');
        const state = await pushLive({
            phase: 'run', name: row.name, category: p.category, title: p.title,
            index: items.length + 1, total: plan.length,
            prep: gapSeconds, duration: p.duration_seconds,
        });
        restore();
        cur = p;
        // Kalau push gagal (offline), jalan sendiri pakai jam lokal.
        curStart = state?.startAt || srvNow();

        $('pCategory').textContent = p.category;
        $('pPrompt').textContent = p.title;
        $('ctrlPick').classList.add('hidden');
        $('saveBar').classList.add('hidden');
        $('ctrlRun').classList.remove('hidden');
        $('btnEnough').disabled = $('btnPass').disabled = true;   // baru aktif setelah fase bersiap
        $('btnEnough').innerHTML = '<i class="fa-solid fa-check"></i> Cukup';

        clearInterval(timerId);
        tick();
        timerId = setInterval(tick, 200);
    };

    const tick = () => {
        const elapsed = (srvNow() - curStart) / 1000;
        if (elapsed < gapSeconds) {                       // fase bersiap: anak membaca soalnya dulu
            const left = Math.ceil(gapSeconds - elapsed);
            $('pTimer').textContent = left;
            $('pTimer').style.color = 'var(--ink-secondary)';
            $('pTimerCap').textContent = 'bersiap';
            $('pPhase').innerHTML = '<i class="fa-solid fa-bullhorn"></i> Bacakan perintahnya sekarang';
            $('pRing').style.strokeDashoffset = String(RING * (1 - left / gapSeconds));
            $('pRing').setAttribute('stroke', 'var(--ink-tertiary)');
            return;
        }
        $('btnEnough').disabled = $('btnPass').disabled = false;
        $('pTimerCap').textContent = 'detik';
        $('pPhase').innerHTML = '<i class="fa-solid fa-microphone"></i> Anak sedang menjawab';
        const left = Math.max(0, Math.ceil(cur.duration_seconds - (elapsed - gapSeconds)));
        paintTimer(left, cur.duration_seconds);
        if (left <= 0) { clearInterval(timerId); askTimeUp(); }
    };

    const paintTimer = (left, total) => {
        $('pTimer').textContent = left;
        const ring = $('pRing');
        ring.style.strokeDashoffset = String(RING * (1 - left / total));
        const warn = left <= 5;
        ring.setAttribute('stroke', warn ? 'var(--danger)' : 'var(--accent)');
        $('pTimer').style.color = warn ? 'var(--danger)' : 'var(--ink)';
    };

    const askTimeUp = () => {
        $('sheet').classList.add('hidden');       // jangan sampai laci menutupi konfirmasi
        $('btnEnough').disabled = $('btnPass').disabled = true;
        $('tuName').textContent = row.name;
        $('modalTimeUp').classList.remove('hidden');
    };

    const record = (outcome) => {
        clearInterval(timerId);
        const answered = (srvNow() - curStart) / 1000 - gapSeconds;
        const used = (outcome === 'early' || outcome === 'pass')   // dua-duanya berhenti sebelum waktu habis
            ? Math.min(cur.duration_seconds, Math.max(0, Math.round(answered)))
            : cur.duration_seconds;
        items.push({ prompt_id: cur.id, used_seconds: used, outcome });
        // Confetti cuma buat yang selesai sebelum waktu habis — kena tenggat tidak dirayakan.
        if (items.length >= plan.length) submitResult();
        else showPicker(outcome === 'early' ? 'Mantap! Tunggu perintah berikutnya.' : 'Tunggu perintah berikutnya.', outcome === 'early');
    };

    $('btnEnough').addEventListener('click', () => record('early'));
    $('btnPass').addEventListener('click', () => {
        window.showConfirm('Menyerah?', `${row?.name || 'Anak ini'} tidak bisa menjawab perintah ini. Nilainya 0.`, () => record('pass'));
    });
    $('btnTuYes').addEventListener('click', () => { $('modalTimeUp').classList.add('hidden'); record('timeout_done'); });
    $('btnTuNo').addEventListener('click', () => { $('modalTimeUp').classList.add('hidden'); record('timeout_undone'); });

    $('btnFinish').addEventListener('click', () => {
        const sisa = plan.length - items.length;
        if (!sisa) return submitResult();
        window.showConfirm('Simpan sekarang?',
            `Nilai dihitung dari ${items.length} perintah yang sudah dijalankan saja. ${sisa} perintah sisanya diabaikan.`, submitResult);
    });

    const backToQueue = () => {
        clearInterval(timerId);
        clearOverlay();
        $('modalTimeUp').classList.add('hidden');
        $('saveBar').classList.add('hidden');
        $('playView').classList.add('hidden');
        $('resultView').classList.add('hidden');
        $('queueView').classList.remove('hidden');
        pushLive({ phase: 'idle' });
    };

    $('btnQuit').addEventListener('click', () => {
        window.showConfirm('Hentikan ujian?', `Hasil ${row?.name || 'murid ini'} belum tersimpan dan harus diulang dari awal.`, backToQueue);
    });

    // ---------------- HASIL ----------------
    const submitResult = async () => {
        clearInterval(timerId);
        cur = null;
        $('ctrlRun').classList.add('hidden');
        $('ctrlPick').classList.remove('hidden');
        $('saveBar').classList.remove('hidden');
        renderPrompts();
        clearOverlay();
        pushLive({ phase: 'ready', name: row.name, note: 'Menghitung nilaimu...', index: items.length, total: plan.length });
        const restore = window.btnBusy($('btnFinish'), 'Menyimpan nilai...');
        try {
            const res = await fetch(`${API_URL}/api/oral/sessions/${sessionId}/students/${row.student_id}/result`, {
                method: 'POST', headers: H, body: JSON.stringify({ items }),
            });
            const json = await res.json();
            if (!res.ok) throw new Error(json.message || 'Gagal menyimpan nilai.');

            // Perbarui state lokal — tak perlu fetch ulang sesi.
            row.status = 'done';
            row.final_score = json.data.final_score;
            row.details = json.data.details;
            restore();
            $('playView').classList.add('hidden');
            renderQueue();
            showResult(row.name, row.final_score, row.details, true);
        } catch (e) {
            restore();
            window.showToast?.('danger', 'Gagal', e.message);
        }
    };

    const OUTCOME_COLOR = { early: 'var(--accent-strong)', timeout_done: 'var(--warning)', timeout_undone: 'var(--danger)', pass: 'var(--ink-tertiary)' };

    const showResult = (name, score, details, toLive) => {
        $('rName').textContent = name;
        $('rScore').textContent = score;
        // Bonus ke nilai ujian tulis: +20% dari nilai lisan, dibatasi 100.
        $('rBonus').innerHTML = `Menambah nilai ujian tulis <b>+${Math.round(score * 0.2)}</b> poin (maks 100).`;
        $('rDetail').innerHTML = (details || []).map(d => `
            <div class="card card-pad !py-2.5 flex items-center gap-3">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-0.5">
                        <span class="badge badge-warning capitalize">${esc(d.category)}</span>
                        <span class="caption">${d.used}/${d.duration} dtk</span>
                    </div>
                    <p class="caption text-ink">${esc(d.title)}</p>
                    <p class="text-[11px] font-semibold mt-0.5" style="color:${OUTCOME_COLOR[d.outcome] || 'var(--ink-secondary)'}">${esc(d.outcome_label || '')}</p>
                </div>
                <span class="text-lg font-black flex-shrink-0" style="color:${OUTCOME_COLOR[d.outcome] || 'var(--ink)'}">${d.score}</span>
            </div>`).join('');
        $('resultView').classList.remove('hidden');
        // `total` = jumlah perintah yang disiapkan, biar layar murid bisa bilang "dari N perintah".
        if (toLive) pushLive({ phase: 'result', name, score, details, total: plan.length });
    };

    $('btnResultNext').addEventListener('click', backToQueue);

    load();
</script>

<style>
    /* Chip template peringatan — dibedakan warnanya biar guru tak salah tekan. */
    .chip-warn { border-color: var(--danger); color: var(--danger); background-color: var(--danger-soft); }
</style>
