---
import Layout from '../../../../layouts/Layout.astro';
import Toast from '../../../../components/Toast.astro';
---

<Layout title="Sesi Ujian Hafalan - yukNgaji">
    <div id="floatingTimerWrapper" class="fixed top-6 left-1/2 -translate-x-1/2 z-[500] transition-all duration-500 -translate-y-[150%] opacity-0 pointer-events-none">
        <div id="floatingTimerBg" class="bg-indigo-600 text-white px-5 py-2.5 rounded-full shadow-[0_12px_40px_rgba(79,70,229,0.3)] border-2 border-white/20 flex items-center gap-3 backdrop-blur-md">
            <i class="fa-solid fa-stopwatch animate-pulse"></i>
            <span id="floatingTimerText" class="font-black text-lg tabular-nums tracking-tight leading-none">10:00</span>
        </div>
    </div>

    <div class="min-h-screen bg-slate-50 px-6 py-8 pb-32 relative">
        <header class="flex items-center justify-between mb-6">
            <div>
                <p id="sessionBadge" class="text-[10px] font-black text-indigo-500 uppercase tracking-widest mb-1">
                    Sesi Evaluasi
                </p>
                <h1 id="sessionTitle" class="text-2xl font-black text-slate-800 tracking-tight">
                    Memuat...
                </h1>
                <p id="sessionDesc" class="text-xs text-slate-500 font-bold mt-1">
                    Menyiapkan data sesi...
                </p>
            </div>

            <a id="btnBackDetail" href="/ujian-hafalan"
                class="w-11 h-11 bg-white text-slate-500 border-2 border-slate-200 hover:bg-slate-100 rounded-xl shadow-sm flex items-center justify-center active:scale-95 transition-all">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
        </header>

        <div class="relative z-40 mb-6">
            <div id="sessionDashboardCard" class="bg-white border-2 border-indigo-500 rounded-3xl shadow-[0_12px_40px_rgba(79,70,229,0.15)] overflow-hidden transition-colors duration-500">

                <div id="timerHeader" class="p-5 bg-indigo-600 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500">
                    <div class="relative z-10">
                        <h2 class="text-[10px] font-black opacity-80 uppercase tracking-widest mb-0.5">Timer Sesi</h2>
                        <div id="timerBox" class="text-4xl font-black tabular-nums tracking-tight leading-none">10:00</div>
                    </div>
                    <div class="relative z-10 text-right">
                        <button id="btnToggleSlot" onclick="toggleSlotAccordion()" class="px-4 py-2.5 bg-white/10 hover:bg-white/20 active:scale-95 rounded-xl text-xs font-black backdrop-blur-sm transition-all flex items-center gap-2 border border-white/20">
                            <i class="fa-solid fa-users"></i> Peserta (<span id="slotCounterTop">0/5</span>)
                            <i id="slotAccordionIcon" class="fa-solid fa-chevron-up transition-transform duration-300"></i>
                        </button>
                    </div>
                    <div class="absolute bottom-0 left-0 w-full h-1.5 bg-black/20">
                        <div id="timerBar" class="h-full bg-white/80 transition-all duration-1000" style="width: 100%;"></div>
                    </div>
                </div>

                <div id="slotAccordionBody" class="block transition-all duration-300 bg-white">
                    <div class="p-5">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-sm font-black text-slate-800">Pilih Peserta Sesi</h3>
                                <p class="text-[10px] font-bold text-slate-400">Pilih maksimal 5 siswa</p>
                            </div>
                            <button onclick="openStartModeModal()" id="btnOpenStartModal"
                                class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl text-xs font-black shadow-[0_4px_0_#4f46e5] active:translate-y-1 active:shadow-none transition-all disabled:opacity-50 disabled:cursor-not-allowed disabled:active:translate-y-0 disabled:active:shadow-none" disabled>
                                Mulai Sesi
                            </button>
                        </div>
                        <div id="slotList" class="w-full">
                            <div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-indigo-500 text-xl"></i></div>
                        </div>
                    </div>
                </div>

                <div id="activeSessionBody" class="hidden transition-all duration-300 bg-slate-50 border-t-2 border-slate-100 p-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Peserta Sedang Diuji</h3>
                    </div>
                    <div id="sessionStudents" class="flex overflow-x-auto gap-3 pb-2 snap-x">
                        </div>
                </div>
            </div>
        </div>

        <div id="preAssessmentArea">
            <section class="bg-white border-2 border-slate-100 rounded-3xl p-6 shadow-sm mb-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-lg font-black text-slate-800">Patokan Materi</h2>
                        <p class="text-[11px] font-bold text-slate-400 mt-1">Acuan guru dalam melakukan uji hafalan</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 border-2 border-indigo-100 rounded-2xl flex items-center justify-center text-xl shadow-inner">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                </div>
                <div id="sessionSections" class="space-y-4">
                    <div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl"></i></div>
                </div>
            </section>
        </div>

        <section id="assessmentMatrixSection" class="hidden animate-slide-up">
            <div class="flex flex-col lg:flex-row gap-6 items-start">
                <div class="w-full lg:w-2/3 bg-white border-2 border-slate-100 rounded-3xl p-5 md:p-6 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5 gap-3">
                        <div>
                            <h2 class="text-lg font-black text-slate-800">Matriks Evaluasi</h2>
                            <p class="text-[11px] font-bold text-slate-400 mt-1">Selesaikan materi secara berurutan ke bawah.</p>
                        </div>
                        <div class="flex gap-2 bg-slate-50 border-2 border-slate-100 rounded-xl p-2 shrink-0">
                            <span class="text-[10px] font-bold text-slate-500 px-2 py-1 rounded bg-white shadow-sm border border-slate-200">Belum: 0</span>
                            <span class="text-[10px] font-bold text-amber-600 px-2 py-1 rounded bg-amber-50 shadow-sm border border-amber-200">Ikut: 1</span>
                            <span class="text-[10px] font-bold text-green-600 px-2 py-1 rounded bg-green-50 shadow-sm border border-green-200">Hafal: 2</span>
                        </div>
                    </div>

                    <div id="assessmentMatrixContainer" class="space-y-4">
                        </div>
                </div>

                <div class="w-full lg:w-1/3 bg-indigo-50 border-2 border-indigo-100 rounded-3xl p-6 sticky top-4">
                    <h3 class="text-sm font-black text-indigo-900 mb-1">Preview Poin</h3>
                    <p class="text-[10px] font-bold text-indigo-400 mb-4">Skor akan dikalkulasi otomatis.</p>

                    <div id="memorizationPreview" class="space-y-2 mb-6">
                        </div>

                    <button onclick="openUnderstandingStep()" class="w-full py-4 bg-green-500 text-white rounded-2xl text-sm font-black shadow-[0_6px_0_#16a34a] active:translate-y-1 active:shadow-none transition-all">
                        Lanjut Tes Pemahaman
                    </button>
                </div>
            </div>
        </section>

        <section id="understandingSection" class="hidden animate-slide-up bg-white border-2 border-slate-100 rounded-3xl p-6 shadow-sm mt-6">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h2 class="text-lg font-black text-slate-800">Tes Pemahaman Individu</h2>
                    <p class="text-[11px] font-bold text-slate-400 mt-1">
                        Tanyakan soal acak di bawah ini lalu beri rating untuk tiap siswa.
                    </p>
                </div>

                <div class="w-12 h-12 bg-purple-50 text-purple-600 border-2 border-purple-100 rounded-2xl flex items-center justify-center text-xl shadow-inner shrink-0">
                    <i class="fa-solid fa-brain"></i>
                </div>
            </div>

            <div id="understandingCards" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                </div>

            <div class="mt-6 bg-green-50 border-2 border-green-100 rounded-3xl p-6">
                <h3 class="text-sm font-black text-green-900 mb-3">Preview Nilai Akhir</h3>
                <div id="finalScorePreview" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
                    </div>

                <button onclick="submitAssessment()" id="btnSubmitFinalAssessment"
                    class="w-full py-4 bg-green-500 text-white rounded-2xl text-base font-black shadow-[0_6px_0_#16a34a] active:translate-y-1 active:shadow-none transition-all">
                    Simpan Evaluasi Sesi
                </button>
            </div>
        </section>

    </div>

    <div id="modalStartMode" class="fixed inset-0 z-[600] hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-[2.5rem] p-8 shadow-2xl border-4 border-indigo-500 animate-slide-up">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-indigo-50 text-indigo-600 border-2 border-indigo-100 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 shadow-inner">
                    <i class="fa-solid fa-play"></i>
                </div>
                <h3 class="text-xl font-black text-slate-800">Mulai Sesi?</h3>
                <p class="text-xs font-bold text-slate-500 mt-2 leading-relaxed">
                    Pilih mode sesi. Mode simulasi tidak akan menyimpan data ke server.
                </p>
            </div>

            <div class="grid grid-cols-1 gap-3">
                <button onclick="startSession('simulation')" class="w-full py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-black active:scale-95 transition-all border-2 border-slate-200">
                    Simulasi Saja
                </button>
                <button onclick="startSession('real')" class="w-full py-4 bg-green-500 text-white rounded-2xl font-black shadow-[0_6px_0_#16a34a] active:translate-y-1 active:shadow-none transition-all">
                    Real, Simpan Data
                </button>
            </div>

            <button onclick="closeStartModeModal()" class="w-full mt-5 py-2 text-xs font-bold text-slate-400 hover:text-slate-600 transition-colors">
                Batal
            </button>
        </div>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const pathParts = window.location.pathname.split('/');
    const templateId = pathParts[2];
    const sessionId = pathParts[4];

    let sessionData = null;
    let remainingSeconds = 600;
    let totalSeconds = 600;
    let timerInterval = null;
    let selectedStudents = [];
    let sessionMode = 'setup';
    let hasSessionStarted = false;

    let assessmentScores = {};
    let understandingScores = {};

    // ==========================================
    // LOGIKA FLOATING TIMER (Intersection Observer)
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
        const dashboardCard = document.getElementById('sessionDashboardCard');
        const floatWrapper = document.getElementById('floatingTimerWrapper');

        if (dashboardCard && floatWrapper) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    // Munculkan timer kapsul JIKA sesi sudah mulai DAN timer aslinya menghilang dari layar
                    if (!entry.isIntersecting && hasSessionStarted) {
                        floatWrapper.classList.remove('-translate-y-[150%]', 'opacity-0');
                        floatWrapper.classList.add('translate-y-0', 'opacity-100');
                    } else {
                        // Sembunyikan jika timer asli terlihat lagi di layar
                        floatWrapper.classList.add('-translate-y-[150%]', 'opacity-0');
                        floatWrapper.classList.remove('translate-y-0', 'opacity-100');
                    }
                });
            }, { threshold: 0 }); // Threshold 0 = trigger saat 100% menghilang

            observer.observe(dashboardCard);
        }
    });

    // ==========================================
    // SETUP DAN TIMER
    // ==========================================
    window.toggleSlotAccordion = () => {
        if (hasSessionStarted) return;
        const body = document.getElementById('slotAccordionBody');
        const icon = document.getElementById('slotAccordionIcon');
        if (body.classList.contains('hidden')) {
            body.classList.replace('hidden', 'block');
            icon.style.transform = 'rotate(0deg)';
        } else {
            body.classList.replace('block', 'hidden');
            icon.style.transform = 'rotate(180deg)';
        }
    };

    const getInitials = (name = '') => name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '--';
    const formatTime = (seconds) => {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    };

    const startTimer = () => {
        clearInterval(timerInterval);
        const timerHeader = document.getElementById('timerHeader');
        const timerBox = document.getElementById('timerBox');
        const timerBar = document.getElementById('timerBar');

        const floatBg = document.getElementById('floatingTimerBg');
        const floatText = document.getElementById('floatingTimerText');

        timerHeader.className = 'p-5 bg-green-600 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
        floatBg.className = 'bg-green-600 text-white px-5 py-2.5 rounded-full shadow-[0_12px_40px_rgba(79,70,229,0.3)] border-2 border-white/20 flex items-center gap-3 backdrop-blur-md transition-colors duration-500';

        timerInterval = setInterval(() => {
            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                const txt = '00:00';
                timerBox.innerText = txt; floatText.innerText = txt;

                timerHeader.className = 'p-5 bg-red-600 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-red-600 text-white px-5 py-2.5 rounded-full shadow-[0_12px_40px_rgba(79,70,229,0.3)] border-2 border-white/20 flex items-center gap-3 backdrop-blur-md transition-colors duration-500';

                timerBar.className = 'h-full bg-white/50 rounded-full transition-all duration-1000';
                timerBar.style.width = '0%';
                window.showToast?.('warning', 'Waktu Habis', 'Sesi sudah melewati target waktu.');
                return;
            }

            remainingSeconds--;
            const percent = Math.max(0, (remainingSeconds / totalSeconds) * 100);
            const txt = formatTime(remainingSeconds);
            timerBox.innerText = txt; floatText.innerText = txt;
            timerBar.style.width = `${percent}%`;

            if (remainingSeconds <= 60) {
                timerHeader.className = 'p-5 bg-red-500 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-red-500 text-white px-5 py-2.5 rounded-full shadow-lg border-2 border-white/20 flex items-center gap-3 transition-colors duration-500';
                timerBar.className = 'h-full bg-white/70 transition-all duration-1000';
            } else if (remainingSeconds <= 180) {
                timerHeader.className = 'p-5 bg-amber-500 text-white flex items-center justify-between relative overflow-hidden transition-colors duration-500';
                floatBg.className = 'bg-amber-500 text-white px-5 py-2.5 rounded-full shadow-lg border-2 border-white/20 flex items-center gap-3 transition-colors duration-500';
                timerBar.className = 'h-full bg-white/70 transition-all duration-1000';
            }
        }, 1000);
    };

    const fetchSession = async () => {
        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}`, { headers: { Authorization: `Bearer ${token}` } });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal memuat sesi.');
            sessionData = result.data;
            renderSession();
        } catch (error) { window.showToast?.('danger', 'Gagal', error.message); }
    };

    const renderSession = () => {
        const { template, session, sections, students, available_students } = sessionData;
        document.getElementById('btnBackDetail').href = `/ujian-hafalan/${template.id}`;
        document.getElementById('sessionBadge').innerText = `${template.subject} • ${session.session_name || 'Sesi'}`;
        document.getElementById('sessionTitle').innerText = template.title;

        const availableCount = available_students ? available_students.length : 0;
        document.getElementById('sessionDesc').innerText = `${availableCount} Siswa Tersedia • Target ${Math.floor(session.target_duration_seconds / 60)} Menit`;

        totalSeconds = session.target_duration_seconds || 600;
        remainingSeconds = totalSeconds;
        document.getElementById('timerBox').innerText = formatTime(remainingSeconds);

        document.getElementById('sessionSections').innerHTML = sections.map((section, index) => {
            const totalItems = section.oral_exam_items?.length || 0;
            return `
                <div class="bg-slate-50 border-2 border-slate-100 rounded-3xl p-5 mb-3">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 shrink-0 rounded-2xl bg-white border-2 border-slate-200 text-indigo-600 flex items-center justify-center text-sm font-black shadow-sm">${index + 1}</div>
                            <h3 class="text-sm font-black text-slate-800 leading-tight">${section.title}</h3>
                        </div>
                        <span class="px-3 py-1.5 bg-white border-2 border-slate-200 text-slate-600 text-[10px] font-black rounded-xl uppercase tracking-widest shrink-0 self-start md:self-auto shadow-sm">
                            Wajib ${section.min_required} dari ${totalItems}
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2 md:ml-[3.25rem]">
                        ${(section.oral_exam_items || []).map(item => `<span class="text-[10px] font-bold bg-white text-indigo-600 border-2 border-indigo-100 px-3 py-2 rounded-xl shadow-sm">${item.short_label || item.title}</span>`).join('')}
                    </div>
                </div>
            `;
        }).join('');

        renderSlots();
    };

    const renderSlots = () => {
        const slotList = document.getElementById('slotList');
        const slotCounterTop = document.getElementById('slotCounterTop');
        const btnStart = document.getElementById('btnOpenStartModal');
        const availableStudents = sessionData.available_students || [];

        if (slotCounterTop) slotCounterTop.innerText = `${selectedStudents.length}/5`;
        if (btnStart) btnStart.disabled = selectedStudents.length === 0;

        const selectedIds = new Set(selectedStudents.map(s => String(s.id)));

        const selectedHtml = `
            <div class="grid grid-cols-5 gap-2 mb-5">
                ${Array.from({ length: 5 }).map((_, index) => {
                    const student = selectedStudents[index];
                    if (!student) {
                        return `<div class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 text-[10px] font-black shadow-inner">Slot ${index + 1}</div>`;
                    }
                    return `
                        <button onclick="removeStudentFromSlot('${student.id}')" class="aspect-square rounded-2xl border-2 border-indigo-200 bg-indigo-50 hover:bg-red-50 hover:border-red-200 hover:text-red-500 group flex flex-col items-center justify-center p-2 active:scale-95 transition-all text-center">
                            <div class="w-8 h-8 rounded-full bg-white text-indigo-600 group-hover:text-red-500 flex items-center justify-center text-[10px] font-black border-2 border-indigo-100 group-hover:border-red-200 mb-1 shadow-sm">${getInitials(student.name)}</div>
                            <p class="text-[8px] font-black text-indigo-800 group-hover:text-red-600 truncate w-full">${student.name}</p>
                        </button>
                    `;
                }).join('')}
            </div>
        `;

        const availableHtml = `
            <div class="grid grid-cols-2 gap-2 max-h-60 overflow-y-auto pr-1">
                ${availableStudents.map(student => {
                    const isSelected = selectedIds.has(String(student.id));
                    const disabled = isSelected || selectedStudents.length >= 5;
                    return `
                        <button onclick="addStudentToSlot('${student.id}')"
                            class="rounded-2xl border-2 p-3 text-left transition-all ${
                                isSelected ? 'bg-indigo-50 border-indigo-200 text-indigo-700' :
                                disabled ? 'bg-slate-50 border-slate-100 text-slate-300 opacity-50' : 'bg-white border-slate-100 text-slate-700 hover:border-indigo-200 active:scale-95 shadow-sm'
                            }" ${disabled ? 'disabled' : ''}>
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 shrink-0 rounded-full bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-[10px] font-black">${getInitials(student.name)}</div>
                                <div class="min-w-0">
                                    <p class="text-[11px] font-black truncate">${student.name}</p>
                                    <p class="text-[9px] font-bold opacity-60 truncate">${student.grade || '-'}</p>
                                </div>
                            </div>
                        </button>
                    `;
                }).join('')}
            </div>
        `;
        slotList.innerHTML = selectedHtml + availableHtml;
    };

    window.addStudentToSlot = (studentId) => {
        if (hasSessionStarted || selectedStudents.length >= 5) return;
        const student = (sessionData.available_students || []).find(s => String(s.id) === String(studentId));
        if (!student || selectedStudents.some(s => String(s.id) === String(studentId))) return;
        selectedStudents.push(student);
        renderSlots();
    };

    window.removeStudentFromSlot = (studentId) => {
        if (hasSessionStarted) return;
        selectedStudents = selectedStudents.filter(s => String(s.id) !== String(studentId));
        renderSlots();
    };

    window.openStartModeModal = () => {
        if (selectedStudents.length === 0) return window.showToast?.('warning', 'Pilih Siswa', 'Masukkan minimal 1 siswa ke slot.');
        document.getElementById('modalStartMode')?.classList.replace('hidden', 'flex');
    };

    window.closeStartModeModal = () => document.getElementById('modalStartMode')?.classList.replace('flex', 'hidden');

    window.startSession = async (mode) => {
        if (selectedStudents.length === 0) return window.showToast?.('warning', 'Pilih Siswa', 'Masukkan minimal 1 siswa ke slot.');

        sessionMode = mode;
        hasSessionStarted = true;
        window.closeStartModeModal();

        document.getElementById('sessionDesc').innerText = `${selectedStudents.length} Peserta Diuji • Target ${Math.floor(totalSeconds / 60)} Menit`;

        document.getElementById('slotAccordionBody').classList.replace('block', 'hidden');
        document.getElementById('btnToggleSlot').classList.add('hidden');
        document.getElementById('preAssessmentArea').classList.add('hidden');

        document.getElementById('activeSessionBody').classList.replace('hidden', 'block');
        document.getElementById('sessionDashboardCard').classList.replace('border-indigo-500', 'border-green-500');

        if (mode === 'simulation') {
            window.showToast?.('info', 'Mode Simulasi', 'Timer berjalan, tapi data penilaian tidak dikirim ke database.');
            renderActiveParticipants();
            startTimer();
            startAssessmentMatrix();
            return;
        }

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}/start`, {
                method: 'POST',
                headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_ids: selectedStudents.map(s => s.id) })
            });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal memulai sesi real.');

            window.showToast?.('success', 'Sesi Real Dimulai', 'Silakan mulai evaluasi.');
            renderActiveParticipants();
            startTimer();
            startAssessmentMatrix();
        } catch (error) {
            console.error(error);
            hasSessionStarted = false;
            sessionMode = 'setup';

            document.getElementById('sessionDesc').innerText = `${sessionData.available_students?.length || 0} Siswa Tersedia • Target ${Math.floor(totalSeconds / 60)} Menit`;
            document.getElementById('preAssessmentArea').classList.remove('hidden');
            window.showToast?.('danger', 'Gagal', error.message);
        }
    };

    const renderActiveParticipants = () => {
        const sessionStudents = document.getElementById('sessionStudents');
        if (!sessionStudents) return;

        sessionStudents.innerHTML = selectedStudents.map(student => `
            <div class="bg-white border-2 border-slate-100 rounded-2xl p-3 text-center shadow-sm min-w-[100px] snap-center shrink-0">
                <div class="w-10 h-10 bg-slate-50 border-2 border-slate-100 text-slate-700 rounded-full flex items-center justify-center font-black text-xs mx-auto mb-2">${getInitials(student.name)}</div>
                <p class="text-[11px] font-black text-slate-800 truncate w-full">${student.name}</p>
            </div>
        `).join('');
    };

    // ==========================================
    // RENDER MATRIKS HORIZONTAL
    // ==========================================
    const startAssessmentMatrix = () => {
        if (Object.keys(assessmentScores).length === 0) {
            selectedStudents.forEach(student => {
                assessmentScores[student.id] = {};
                sessionData.sections.forEach(section => {
                    (section.oral_exam_items || []).forEach(item => { assessmentScores[student.id][item.id] = 0; });
                });
            });
        }

        document.getElementById('assessmentMatrixSection').classList.remove('hidden');
        renderAssessmentMatrix();
        updatePreviewScores();
    };

    const renderAssessmentMatrix = () => {
        const container = document.getElementById('assessmentMatrixContainer');
        container.innerHTML = sessionData.sections.map((section, secIdx) => {
            const items = section.oral_exam_items || [];
            if(items.length === 0) return '';

            const isFirst = secIdx === 0;
            const headerClass = isFirst ? 'bg-indigo-50 border-indigo-500' : 'bg-slate-50 border-slate-100';
            const iconClass = isFirst ? 'fa-chevron-up text-indigo-600' : 'fa-chevron-down text-slate-400';
            const bodyClass = isFirst ? 'block' : 'hidden';

            const studentCards = selectedStudents.map(student => `
                <div class="bg-white border-2 border-slate-100 rounded-3xl p-5 shadow-sm flex flex-col transition-all">
                    <div class="flex items-center gap-3 mb-4 pb-4 border-b-2 border-slate-50">
                        <div class="w-10 h-10 shrink-0 rounded-full bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xs font-black text-slate-600">${getInitials(student.name)}</div>
                        <div class="min-w-0">
                            <p class="text-sm font-black text-slate-800 truncate">${student.name}</p>
                        </div>
                    </div>

                    <div class="space-y-2">
                        ${items.map(item => {
                            const score = assessmentScores[student.id][item.id] || 0;
                            return `
                            <div class="flex items-center justify-between gap-3 bg-slate-50/50 p-2 rounded-2xl hover:bg-slate-50 transition-colors">
                                <p class="text-xs font-bold text-slate-600 truncate flex-1 pl-2" title="${item.title}">${item.short_label || item.title}</p>
                                <div class="flex bg-white rounded-xl p-1 border-2 border-slate-100 gap-1 shrink-0 w-[150px] shadow-sm">
                                    <button onclick="setScore('${student.id}', '${item.id}', 0, ${secIdx})" id="btn-0-${student.id}-${item.id}"
                                        class="flex-1 py-2 text-[10px] font-black rounded-lg transition-all ${score === 0 ? 'bg-slate-100 shadow-sm text-slate-600 border border-slate-200' : 'text-slate-400 hover:text-slate-600 border border-transparent'}">Belum</button>
                                    <button onclick="setScore('${student.id}', '${item.id}', 1, ${secIdx})" id="btn-1-${student.id}-${item.id}"
                                        class="flex-1 py-2 text-[10px] font-black rounded-lg transition-all ${score === 1 ? 'bg-amber-100 shadow-sm text-amber-600 border border-amber-200' : 'text-slate-400 hover:text-amber-500 border border-transparent'}">Ikut</button>
                                    <button onclick="setScore('${student.id}', '${item.id}', 2, ${secIdx})" id="btn-2-${student.id}-${item.id}"
                                        class="flex-1 py-2 text-[10px] font-black rounded-lg transition-all ${score === 2 ? 'bg-green-100 shadow-sm text-green-600 border border-green-200' : 'text-slate-400 hover:text-green-500 border border-transparent'}">Hafal</button>
                                </div>
                            </div>
                        `}).join('')}
                    </div>
                </div>
            `).join('');

            return `
                <div class="mb-4">
                    <button onclick="toggleMatrixSection(${secIdx})" id="header-matrix-${secIdx}" class="matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors ${headerClass}">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-white text-indigo-600 border-2 border-indigo-100 flex items-center justify-center font-black shadow-sm">${secIdx + 1}</div>
                            <div class="text-left">
                                <h3 class="text-sm font-black text-slate-800">${section.title}</h3>
                                <p class="text-[10px] font-bold text-slate-500 mt-0.5">${items.length} materi uji</p>
                            </div>
                        </div>
                        <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm border border-slate-100">
                            <i id="icon-matrix-${secIdx}" class="matrix-icon fa-solid ${iconClass} transition-transform"></i>
                        </div>
                    </button>

                    <div id="body-matrix-${secIdx}" class="matrix-body ${bodyClass} mt-3 animate-slide-up">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                            ${studentCards}
                        </div>

                        ${secIdx < sessionData.sections.length - 1 ? `
                            <button onclick="nextMatrixSection(${secIdx})" class="w-full mt-5 py-4 bg-indigo-50 hover:bg-indigo-100 border-2 border-indigo-200 text-indigo-600 rounded-2xl text-xs font-black active:scale-95 transition-all flex items-center justify-center gap-2 shadow-sm">
                                Simpan & Lanjut Materi Berikutnya <i class="fa-solid fa-arrow-down"></i>
                            </button>
                        ` : `
                            <div class="mt-5 p-6 bg-green-50 border-2 border-green-200 rounded-3xl text-center shadow-sm">
                                <div class="w-16 h-16 bg-white border-2 border-green-100 rounded-full flex items-center justify-center text-green-500 text-3xl mx-auto mb-3"><i class="fa-solid fa-check"></i></div>
                                <h3 class="text-base font-black text-green-800 mb-1">Semua materi selesai dinilai!</h3>
                                <p class="text-[11px] font-bold text-green-600">Cek Preview Nilai di panel samping dan lanjut ke Tes Pemahaman.</p>
                            </div>
                        `}
                    </div>
                </div>
            `;
        }).join('');
    };

    window.toggleMatrixSection = (index) => {
        const body = document.getElementById(`body-matrix-${index}`);
        const icon = document.getElementById(`icon-matrix-${index}`);
        const header = document.getElementById(`header-matrix-${index}`);

        if (body.classList.contains('hidden')) {
            document.querySelectorAll('.matrix-body').forEach(el => el.classList.replace('block', 'hidden'));
            document.querySelectorAll('.matrix-icon').forEach(el => el.className = 'matrix-icon fa-solid fa-chevron-down text-slate-400 transition-transform');
            document.querySelectorAll('.matrix-header').forEach(el => el.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-slate-50 border-slate-100');

            body.classList.replace('hidden', 'block');
            icon.className = 'matrix-icon fa-solid fa-chevron-up text-indigo-600 transition-transform';
            header.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-indigo-50 border-indigo-500';
        } else {
            body.classList.replace('block', 'hidden');
            icon.className = 'matrix-icon fa-solid fa-chevron-down text-slate-400 transition-transform';
            header.className = 'matrix-header w-full flex items-center justify-between p-4 border-2 rounded-3xl transition-colors bg-slate-50 border-slate-100';
        }
    };

    window.nextMatrixSection = (currentIndex) => {
        const nextIndex = currentIndex + 1;
        if (nextIndex < sessionData.sections.length) {
            toggleMatrixSection(nextIndex);
            setTimeout(() => document.getElementById(`header-matrix-${nextIndex}`).scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
        }
    };

    window.setScore = (studentId, itemId, score, sectionIndex) => {
        assessmentScores[studentId][itemId] = score;

        [0, 1, 2].forEach(val => {
            const btn = document.getElementById(`btn-${val}-${studentId}-${itemId}`);
            if (!btn) return;

            btn.className = 'flex-1 py-2 text-[10px] font-black rounded-lg transition-all border border-transparent text-slate-400';

            if (val === score) {
                if (val === 0) btn.classList.add('bg-slate-100', 'shadow-sm', 'text-slate-600', 'border-slate-200');
                if (val === 1) btn.classList.add('bg-amber-100', 'shadow-sm', '!text-amber-600', 'border-amber-200');
                if (val === 2) btn.classList.add('bg-green-100', 'shadow-sm', '!text-green-600', 'border-green-200');
            } else {
                if (val === 0) btn.classList.add('hover:text-slate-600');
                if (val === 1) btn.classList.add('hover:text-amber-500');
                if (val === 2) btn.classList.add('hover:text-green-500');
            }
        });
        updatePreviewScores();
    };

    const updatePreviewScores = () => {
        const previewContainer = document.getElementById('memorizationPreview');
        previewContainer.innerHTML = selectedStudents.map(student => {
            let total = 0; let maxTotal = 0;
            Object.values(assessmentScores[student.id]).forEach(score => { total += score; maxTotal += 2; });
            return `
                <div class="flex items-center justify-between bg-white p-3 rounded-2xl border-2 border-indigo-100/50 shadow-sm">
                    <div class="flex items-center gap-3">
                         <div class="w-8 h-8 shrink-0 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-[10px] font-black border border-indigo-100">${getInitials(student.name)}</div>
                         <div class="min-w-0">
                            <p class="text-[11px] font-black text-indigo-900 truncate">${student.name}</p>
                            <p class="text-[9px] font-bold text-indigo-400">Max: ${maxTotal} Poin</p>
                         </div>
                    </div>
                    <div class="text-sm font-black text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-xl border-2 border-indigo-100">${total}</div>
                </div>
            `;
        }).join('');
    };

    // ==========================================
    // LOGIKA GENERATOR PERTANYAAN (UPDATE 2)
    // ==========================================
    const generateQuestions = () => {
        const items = [];
        sessionData.sections.forEach(sec => {
            (sec.oral_exam_items || []).forEach(item => items.push(item.short_label || item.title));
        });

        if (items.length === 0) return ["Coba jelaskan kembali intisari dari materi yang baru saja dipelajari."];

        const templates = [
            "Jelaskan secara singkat pengertian dari {0}.",
            "Berikan contoh cara membaca / penerapan {0}.",
            "Apa ciri-ciri atau tanda dari {0}?",
            "Mengapa kita harus memperhatikan {0} dalam membaca?",
        ];

        if (items.length > 1) {
            templates.push("Menurutmu, apa bedanya antara {0} dan {1}?");
            templates.push("Kapan hukum {0} dipakai dibandingkan {1}?");
        }

        const count = Math.floor(Math.random() * 2) + 2; // Acak 2-3 pertanyaan
        const questions = [];

        for(let i=0; i<count; i++) {
            const tpl = templates[Math.floor(Math.random() * templates.length)];
            const item1 = items[Math.floor(Math.random() * items.length)];
            let item2 = items[Math.floor(Math.random() * items.length)];

            while(item1 === item2 && items.length > 1) {
                item2 = items[Math.floor(Math.random() * items.length)];
            }

            const q = tpl.replace('{0}', `<strong class="text-purple-600">${item1}</strong>`)
                         .replace('{1}', `<strong class="text-purple-600">${item2}</strong>`);
            questions.push(q);
        }
        return questions;
    };

    window.openUnderstandingStep = () => {
        if (!hasSessionStarted) {
            window.showToast?.('warning', 'Sesi Belum Dimulai', 'Mulai sesi terlebih dahulu.');
            return;
        }

        selectedStudents.forEach(student => {
            if (!understandingScores[student.id]) {
                understandingScores[student.id] = {
                    rating: 0,
                    note: '',
                    questions: generateQuestions() // Generate 2-3 pertanyaan acak untuk siswa ini
                };
            }
        });

        document.getElementById('understandingSection')?.classList.remove('hidden');
        renderUnderstandingCards();
        renderFinalScorePreview();

        setTimeout(() => {
            document.getElementById('understandingSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 150);
    };

    const renderUnderstandingCards = () => {
        const container = document.getElementById('understandingCards');
        if (!container) return;

        container.innerHTML = selectedStudents.map(student => {
            const current = understandingScores[student.id];

            return `
                <div class="bg-white border-2 border-slate-100 rounded-3xl p-5 shadow-sm">
                    <div class="flex items-center gap-3 mb-4 pb-4 border-b-2 border-slate-50">
                        <div class="w-10 h-10 bg-slate-50 border-2 border-slate-100 text-slate-700 rounded-full flex items-center justify-center font-black text-xs shadow-inner">
                            ${getInitials(student.name)}
                        </div>
                        <div>
                            <p class="text-sm font-black text-slate-800">${student.name}</p>
                            <p class="text-[10px] font-bold text-slate-400">Tes lisan individu</p>
                        </div>
                    </div>

                    <div class="mb-5 space-y-2.5">
                        <p class="text-[10px] font-black text-purple-500 uppercase tracking-widest px-1">Pertanyaan Lisan Acak</p>
                        <div class="grid grid-cols-1 gap-2">
                            ${current.questions.map((q, i) => `
                                <div class="flex items-start gap-2.5 bg-purple-50/50 p-3 rounded-2xl border border-purple-100/50">
                                    <span class="w-5 h-5 shrink-0 rounded-full bg-white text-purple-500 border border-purple-200 flex items-center justify-center text-[10px] font-black shadow-sm">${i+1}</span>
                                    <p class="text-xs font-bold text-slate-700 leading-relaxed mt-0.5">${q}</p>
                                </div>
                            `).join('')}
                        </div>
                    </div>

                    <div class="bg-slate-50/50 p-4 rounded-3xl border-2 border-slate-50">
                        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-center mb-3">Beri Nilai Pemahaman</p>
                        <div class="grid grid-cols-5 gap-2 mb-4">
                            ${[1, 2, 3, 4, 5].map(value => `
                                <button onclick="setUnderstandingRating('${student.id}', ${value})"
                                    class="py-3 rounded-2xl border-2 text-xs font-black active:scale-95 transition-all ${
                                        Number(current.rating) === value
                                            ? 'bg-purple-600 text-white border-purple-600 shadow-[0_4px_0_#7e22ce]'
                                            : 'bg-white text-slate-400 border-slate-100 hover:border-purple-200 hover:text-purple-400'
                                    }">
                                    ${value}
                                </button>
                            `).join('')}
                        </div>
                        <textarea
                            oninput="setUnderstandingNote('${student.id}', this.value)"
                            class="w-full bg-white border-2 border-slate-100 rounded-2xl p-3 text-xs font-bold text-slate-600 outline-none focus:border-purple-300 resize-none shadow-sm"
                            rows="2"
                            placeholder="Catatan kelemahan/kelebihan...">${current.note || ''}</textarea>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.setUnderstandingRating = (studentId, rating) => {
        understandingScores[studentId].rating = rating;
        renderUnderstandingCards();
        renderFinalScorePreview();
    };

    window.setUnderstandingNote = (studentId, note) => {
        understandingScores[studentId].note = note;
    };

    const calculateMemorizationScore = (studentId) => {
        let total = 0; let maxTotal = 0; let passedSections = 0; let totalSections = 0;
        sessionData.sections.forEach(section => {
            const items = section.oral_exam_items || [];
            const hafalCount = items.filter(item => Number(assessmentScores?.[studentId]?.[item.id] || 0) === 2).length;
            if (hafalCount >= Number(section.min_required || 0)) passedSections++;
            totalSections++;
            items.forEach(item => { total += Number(assessmentScores?.[studentId]?.[item.id] || 0); maxTotal += 2; });
        });
        const score = maxTotal > 0 ? Math.round((total / maxTotal) * 100) : 0;
        return { score, passedSections, totalSections, passedMinimum: passedSections >= totalSections };
    };

    const calculateFinalScore = (studentId) => {
        const mem = calculateMemorizationScore(studentId);
        const rating = Number(understandingScores?.[studentId]?.rating || 0);
        const understandingScore = rating * 20;
        const finalScore = Math.round((mem.score * 0.7) + (understandingScore * 0.3));
        const status = mem.passedMinimum && rating >= 3 ? 'passed' : 'need_remedial';
        return { memorization_score: mem.score, understanding_score: understandingScore, final_score: finalScore, status, passedSections: mem.passedSections, totalSections: mem.totalSections };
    };

    const renderFinalScorePreview = () => {
        const container = document.getElementById('finalScorePreview');
        if (!container) return;
        container.innerHTML = selectedStudents.map(student => {
            const result = calculateFinalScore(student.id);
            const passed = result.status === 'passed';
            return `
                <div class="bg-white border-2 ${passed ? 'border-green-100' : 'border-amber-100'} rounded-2xl p-4 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full ${passed ? 'bg-green-50 text-green-600 border-green-100' : 'bg-amber-50 text-amber-600 border-amber-100'} border-2 flex items-center justify-center font-black text-xs">
                            ${getInitials(student.name)}
                        </div>
                        <div>
                            <p class="text-xs font-black text-slate-800">${student.name}</p>
                            <p class="text-[9px] font-bold text-slate-400">H: ${result.memorization_score} • P: ${result.understanding_score}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-black ${passed ? 'text-green-600' : 'text-amber-500'}">${result.final_score}</p>
                        <p class="text-[8px] font-black uppercase tracking-widest ${passed ? 'text-green-500' : 'text-amber-500'}">${passed ? 'Lulus' : 'Remedial'}</p>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.submitAssessment = async () => {
        const notRated = selectedStudents.filter(student => !Number(understandingScores?.[student.id]?.rating || 0));
        if (notRated.length > 0) return window.showToast?.('warning', 'Belum Lengkap', `Rating pemahaman ${notRated[0].name} belum diisi.`);

        const payloadResults = selectedStudents.map(student => {
            const final = calculateFinalScore(student.id);
            const items = [];
            sessionData.sections.forEach(section => {
                (section.oral_exam_items || []).forEach(item => { items.push({ item_id: item.id, score: Number(assessmentScores?.[student.id]?.[item.id] || 0) }); });
            });
            return {
                student_id: student.id, memorization_score: final.memorization_score, understanding_score: final.understanding_score,
                final_score: final.final_score, understanding_rating: Number(understandingScores?.[student.id]?.rating || 0),
                notes: understandingScores?.[student.id]?.note || null, status: final.status, duration_seconds: totalSeconds - remainingSeconds, items
            };
        });

        if (sessionMode === 'simulation') return window.showToast?.('success', 'Simulasi Selesai', 'Data tidak dikirim ke database karena ini mode simulasi.');

        const btn = document.getElementById('btnSubmitFinalAssessment');
        const originalText = btn?.innerHTML;
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...'; btn.classList.add('opacity-70', 'cursor-not-allowed'); }

        try {
            const res = await fetch(`${API_URL}/api/oral-exams/${templateId}/sessions/${sessionId}/results`, {
                method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ results: payloadResults })
            });
            const result = await res.json();
            if (!res.ok || result.status !== 'success') throw new Error(result.message || 'Gagal menyimpan hasil evaluasi.');

            clearInterval(timerInterval);
            window.showToast?.('success', 'Tersimpan', 'Hasil evaluasi hafalan berhasil disimpan.');
            setTimeout(() => { window.location.href = `/ujian-hafalan/${templateId}`; }, 900);
        } catch (error) {
            console.error(error); window.showToast?.('danger', 'Gagal', error.message);
            if (btn) { btn.disabled = false; btn.innerHTML = originalText; btn.classList.remove('opacity-70', 'cursor-not-allowed'); }
        }
    };

    fetchSession();
</script>

<style>
    .animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideUp { 0% { transform: translateY(30px) scale(0.95); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
    #sessionStudents::-webkit-scrollbar { display: none; }
    #sessionStudents { -ms-overflow-style: none; scrollbar-width: none; }
</style>
