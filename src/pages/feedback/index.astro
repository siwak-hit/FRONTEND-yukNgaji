---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
---

<Layout title="Feedback - yukNgaji">
    <div class="min-h-screen bg-slate-50 flex flex-col items-center justify-center px-6 py-10 relative overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-72 h-72 bg-indigo-100 rounded-full mix-blend-multiply filter blur-[80px] opacity-80"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-72 h-72 bg-amber-100 rounded-full mix-blend-multiply filter blur-[80px] opacity-80"></div>

        <div id="feedbackCard" class="relative z-10 w-full max-w-md bg-white rounded-[2rem] p-6 shadow-xl border border-indigo-100 animate-slide-up">
            <div class="text-center mb-6">
                <div class="w-20 h-20 bg-indigo-50 text-indigo-600 rounded-[1.5rem] flex items-center justify-center text-4xl mx-auto mb-4 border border-indigo-100 shadow-inner">
                    <i class="fa-solid fa-heart-circle-check animate-bounce"></i>
                </div>

                <p class="text-[10px] font-black text-indigo-500 uppercase tracking-widest mb-1">
                    Misi Terakhir
                </p>
                <h1 class="text-2xl font-black text-gray-800 mb-2">
                    Bantu Ustadz Sebentar
                </h1>
                <p class="text-xs font-bold text-gray-500 leading-relaxed">
                    Jawab singkat saja ya. Setelah ini Ujian kamu lengkap dan kamu boleh menutup browser.
                </p>
            </div>

            <form id="feedbackForm" class="space-y-5">
                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-3">
                        Aplikasinya nyaman dipakai?
                    </label>

                    <div class="grid grid-cols-5 gap-2" data-rating-group="comfort">
                        <button type="button" onclick="selectRating('comfort', 1)" class="rating-btn" data-value="1">😵<span>1</span></button>
                        <button type="button" onclick="selectRating('comfort', 2)" class="rating-btn" data-value="2">😕<span>2</span></button>
                        <button type="button" onclick="selectRating('comfort', 3)" class="rating-btn" data-value="3">🙂<span>3</span></button>
                        <button type="button" onclick="selectRating('comfort', 4)" class="rating-btn" data-value="4">😄<span>4</span></button>
                        <button type="button" onclick="selectRating('comfort', 5)" class="rating-btn" data-value="5">🤩<span>5</span></button>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-3">
                        Ujiannya terasa susah?
                    </label>

                    <div class="grid grid-cols-5 gap-2" data-rating-group="difficulty">
                        <button type="button" onclick="selectRating('difficulty', 1)" class="rating-btn" data-value="1">😎<span>1</span></button>
                        <button type="button" onclick="selectRating('difficulty', 2)" class="rating-btn" data-value="2">🙂<span>2</span></button>
                        <button type="button" onclick="selectRating('difficulty', 3)" class="rating-btn" data-value="3">🤔<span>3</span></button>
                        <button type="button" onclick="selectRating('difficulty', 4)" class="rating-btn" data-value="4">😵<span>4</span></button>
                        <button type="button" onclick="selectRating('difficulty', 5)" class="rating-btn" data-value="5">😭<span>5</span></button>
                    </div>
                    <p class="text-[9px] font-bold text-gray-400 mt-2">
                        1 = gampang, 5 = susah banget
                    </p>
                </div>

                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-2">
                        Bagian yang paling kamu suka
                    </label>
                    <select id="favoritePart" class="input-field">
                        <option value="">Pilih salah satu...</option>
                        <option value="soal">Soal ujiannya</option>
                        <option value="miaw">Maskot Miaw</option>
                        <option value="koin">Koin / bantuan ujian</option>
                        <option value="hint">Petunjuk / hint</option>
                        <option value="wrapped">Catatan Ngajiku / wrapped</option>
                        <option value="leaderboard">Leaderboard / peringkat</option>
                    </select>
                </div>

                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-2">
                        Bagian mana yang bikin bingung?
                    </label>
                    <textarea id="hardestPart" rows="3" class="input-field resize-none" placeholder="Contoh: bagian koin, tombol hint, soal mengetik, dll..."></textarea>
                </div>

                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-2">
                        Saran fitur tambahan
                    </label>
                    <textarea id="suggestion" rows="3" class="input-field resize-none" placeholder="Menurut kamu, aplikasi ini perlu ditambah apa?"></textarea>
                </div>

                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest block mb-2">
                        Pesan bebas buat Ustadz / Kak Aziz
                    </label>
                    <textarea id="message" rows="3" class="input-field resize-none" placeholder="Boleh dikosongkan kalau tidak ada."></textarea>
                </div>

                <button type="submit" id="btnSubmitFeedback"
                    class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl shadow-[0_6px_0_#4f46e5] active:translate-y-[6px] active:shadow-none transition-all">
                    Kirim & Simpan ke Raport
                </button>
            </form>
        </div>

        <div id="successCard" class="hidden relative z-10 w-full max-w-md bg-white rounded-[2rem] p-8 shadow-xl border border-green-100 text-center animate-slide-up">
            <div class="text-6xl mb-4 animate-bounce">✅</div>
            <h2 class="text-2xl font-black text-gray-800 mb-2">
                Terima Kasih!
            </h2>
            <p class="text-xs font-bold text-gray-500 leading-relaxed mb-6">
                Feedback kamu sudah terkirim. Laporan akhir kamu sudah lengkap.
            </p>

            <div class="bg-green-50 border border-green-100 rounded-2xl p-4 mb-6">
                <p class="text-[10px] font-black text-green-700 uppercase tracking-widest">
                    Sekarang kamu boleh menutup browser ini.
                </p>
            </div>

            <button onclick="window.location.replace('/selesai')"
                class="w-full py-4 bg-green-600 text-white font-black rounded-2xl shadow-[0_6px_0_#16a34a] active:translate-y-[6px] active:shadow-none transition-all">
                Selesai
            </button>
        </div>
    </div>

    <Toast />
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const urlParams = new URLSearchParams(window.location.search);

    const studentId = urlParams.get('student_id');
    const examId = urlParams.get('exam_id');

    const isPreview = urlParams.get('preview') === 'true';
    const isTeacherPreview = urlParams.get('teacher_preview') === 'true';

    let token = urlParams.get('token') || localStorage.getItem('token') || sessionStorage.getItem('temp_pr_token');

    const ratings = {
        comfort: 0,
        difficulty: 0
    };

    window.selectRating = (type, value) => {
        ratings[type] = value;

        document.querySelectorAll(`[data-rating-group="${type}"] .rating-btn`).forEach(btn => {
            btn.classList.remove('selected');
        });

        document.querySelector(`[data-rating-group="${type}"] [data-value="${value}"]`)?.classList.add('selected');
    };

    document.getElementById('feedbackForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!studentId) {
            window.showToast?.('danger', 'Gagal', 'Data siswa tidak ditemukan.');
            return;
        }

        if (!ratings.comfort || !ratings.difficulty) {
            window.showToast?.('warning', 'Isi Dulu', 'Pilih nilai kenyamanan dan tingkat kesulitan dulu ya.');
            return;
        }

        const btn = document.getElementById('btnSubmitFeedback');
        const originalText = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...';

        try {
            // [BARU] Mode simulasi guru:
            if (isPreview && isTeacherPreview) {
                await new Promise(resolve => setTimeout(resolve, 700));

                const successTitle = document.querySelector('#successCard h2');
                const successDesc = document.querySelector('#successCard p');

                if (successTitle) successTitle.innerText = 'Simulasi Selesai!';
                if (successDesc) {
                    successDesc.innerText = 'Alur feedback berhasil ditampilkan. Data tidak dikirim ke database karena ini mode simulasi guru.';
                }

                document.getElementById('feedbackCard').classList.add('hidden');
                document.getElementById('successCard').classList.remove('hidden');

                window.showToast?.(
                    'success',
                    'Simulasi Berhasil',
                    'Feedback tidak dikirim ke database karena ini mode simulasi guru.'
                );

                return;
            }

            const res = await fetch(`${API_URL}/api/onboarding/feedback`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    student_id: studentId,
                    exam_id: examId,
                    comfort_rating: ratings.comfort,
                    difficulty_rating: ratings.difficulty,
                    favorite_part: document.getElementById('favoritePart').value,
                    hardest_part: document.getElementById('hardestPart').value.trim(),
                    suggestion: document.getElementById('suggestion').value.trim(),
                    message: document.getElementById('message').value.trim(),
                    source: 'exam_final'
                })
            });

            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal mengirim feedback.');
            }

            document.getElementById('feedbackCard').classList.add('hidden');
            document.getElementById('successCard').classList.remove('hidden');

            window.showToast?.('success', 'Terkirim', 'Feedback kamu berhasil disimpan.');
        } catch (err) {
            console.error(err);
            window.showToast?.('danger', 'Gagal', err.message || 'Gagal mengirim feedback.');
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });
</script>

<style is:global>
    .animate-slide-up {
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes slideUp {
        0% {
            transform: translateY(20px) scale(0.96);
            opacity: 0;
        }

        100% {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    .input-field {
        width: 100%;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 1rem;
        padding: 0.85rem 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #334155;
        outline: none;
        transition: all 0.2s ease;
    }

    .input-field:focus {
        border-color: #6366f1;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
    }

    .rating-btn {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 1rem;
        min-height: 64px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        font-size: 1.35rem;
        font-weight: 900;
        color: #64748b;
        transition: all 0.2s ease;
    }

    .rating-btn span {
        font-size: 0.65rem;
        font-weight: 900;
    }

    .rating-btn.selected {
        background: #eef2ff;
        border-color: #6366f1;
        color: #4f46e5;
        transform: translateY(-3px);
        box-shadow: 0 6px 0 #c7d2fe;
    }
</style>
