                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#f87171', text: '100', value: 100, textFillStyle: '#7f1d1d' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#38bdf8', text: '250', value: 250, textFillStyle: '#0c4a6e' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#a855f7', text: '500', value: 500, textFillStyle: '#ffffff' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#ef4444', text: '1000!', value: 1000, size: window.innerWidth < 400 ? 4 : 6, textFillStyle: '#ffffff' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' }
                ];
            }
        } else {
            const config = waveConfig[Math.min(currentWave - 1, waveConfig.length - 1)];
            const checkboxes = document.querySelectorAll('.chk-friend:checked');

            let players = [activeStudent.name];
            checkboxes.forEach(c => players.push(c.value));

            const playerColors = ['#34d399', '#60a5fa', '#fbbf24', '#f87171', '#c084fc'];

            players.forEach((p, index) => {
                segments.push({ fillStyle: playerColors[index], text: p.substring(0,8), value: config.prize, isWinner: true, name: p, textFillStyle: '#ffffff' });
                for(let i = 0; i < config.zonks; i++) {
                    segments.push({ fillStyle: '#e2e8f0', text: 'ZONK', value: 0, isWinner: false, textFillStyle: '#64748b' });
                }
            });
            segments.sort(() => Math.random() - 0.5);
        }

        if (theWheel) {
            theWheel.stopAnimation(false);
            theWheel.clearCanvas();
        }

        theWheel = new Winwheel({
            canvasId: 'canvasWinwheel',
            numSegments: segments.length,
            segments: segments,
            outerRadius: 140,
            innerRadius: 30,
            textFontSize: 11,
            textMargin: 0,
            lineWidth: 2,
            strokeStyle: '#ffffff',
            animation: { type: 'spinToStop', duration: 4, spins: 8, callbackFinished: 'onWheelFinish()' }
        });
        theWheel.draw();
    };

    window.startSpin = async () => {
        if (checkSpinCooldown()) return;

        let cost = 0;
        if (currentGachaMode === 'solo') {
            const select = document.getElementById('gachaTargetPrize');
            cost = parseInt(select.options[select.selectedIndex].dataset.cost);
        } else {
            const config = waveConfig[Math.min(currentWave - 1, waveConfig.length - 1)];
            cost = config.cost;
        }

        if (activeStudent.poin < cost) return window.showCustomAlert('Koin Kurang', `Butuh ${cost} Koin untuk memutar di tingkat ini.`, 'warning');

        const btn = document.getElementById('btnSpinWheel');
        btn.disabled = true;
        btn.innerText = 'Memutar Roda...';

        try {
            const res = await fetch(`${API_URL}/api/digital-rewards/game-win`, {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: activeStudent.id, reward_amount: -cost })
            });
            const data = await res.json();
            if (!res.ok) throw new Error('Koneksi terputus');

            activeStudent.poin = data.data.new_poin;
            updateShopUI();
            incrementSpinCount(); // Tambahkan riwayat spin untuk cooldown!

            theWheel.stopAnimation(false);
            theWheel.rotationAngle = 0;
            theWheel.draw();
            theWheel.startAnimation();
        } catch (e) {
            btn.disabled = false;
            btn.innerText = `Putar Sekarang (${cost} Koin)`;
            window.showCustomAlert('Error', 'Gagal memproses pembayaran putaran roda.', 'error');
