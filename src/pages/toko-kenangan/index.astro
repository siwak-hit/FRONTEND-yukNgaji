    window.onWheelFinish = async () => {
        const winningSegment = theWheel.getIndicatedSegment();
        const select = document.getElementById('gachaTargetPrize');
        const cost = parseInt(select.options[select.selectedIndex].dataset.cost);
        const btn = document.getElementById('btnSpinWheel');

        if (winningSegment.value > 0) {
            if (window.confetti) window.confetti({ particleCount: 150, spread: 80, zIndex: 9999, origin: { y: 0.5 } });

            if (currentGachaMode === 'ramean') {
                const oldWave = currentWave;
                currentWave = Math.min(currentWave + 1, waveConfig.length);

                // Cari ID teman berdasarkan nama lengkap yang tersimpan di properti juring wheel
                const winnerStudent = allStudents.find(s => s.name === winningSegment.name);
                const winnerId = winnerStudent ? winnerStudent.id : activeStudent.id;

                try {
                    const res = await fetch(`${API_URL}/api/digital-rewards/gacha-ramean-win`, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            spinner_id: activeStudent.id,
                            winner_id: winnerId,
                            reward_amount: winningSegment.value
                        })
                    });
                    const result = await res.json();

                    if (winningSegment.name === activeStudent.name) {
                        activeStudent.poin = result.data.new_poin;
                        updateShopUI();
                        const msg = `WAVE ${oldWave} SELESAI! Kamu memenangkan taruhan ini! +${winningSegment.value} Koin ditambahkan. Lanjut ke Wave ${currentWave}!`;
                        window.showCustomAlert('🎉 SELAMAT!', msg, 'success');
                    } else {
                        // Jika teman yang menang, koin dikirim ke backend teman, wave kelompok tetap naik!
                        const msg = `WAVE ${oldWave} SELESAI! Pemenangnya adalah ${winningSegment.name}. Koin hadiah langsung dikirim ke akunnya! Perjalanan kelompok berlanjut ke Wave ${currentWave}!`;
                        window.showCustomAlert('Hasil Ramean', msg, 'info');
                    }
                } catch (e) {
                    console.error("Gagal memproses hadiah gacha ramean:", e);
                }
            } else {
                // SOLO MODE
                const msg = `Wow! Kamu mendapatkan ${winningSegment.value} Koin!`;
                window.showCustomAlert('🎉 SELAMAT!', msg, 'success');

                try {
                    const res = await fetch(`${API_URL}/api/digital-rewards/game-win`, {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ student_id: activeStudent.id, reward_amount: winningSegment.value })
                    });
                    const data = await res.json();
                    activeStudent.poin = data.data.new_poin;
                    updateShopUI();
                } catch (e) { console.error(e); }
            }

        } else {
            if (currentGachaMode === 'ramean') {
                currentWave = Math.max(1, currentWave - 1);
                window.showCustomAlert('Yahh Zonk!', `Semuanya sial! Roda berhenti di ZONK. Kamu diturunkan ke Wave ${currentWave}.`, 'danger');
            } else {
                window.showCustomAlert('Yahh Zonk!', 'Sayang sekali kali ini kamu belum beruntung. Ayo coba lagi!', 'danger');
            }
        }

        updateGachaCostAndWheel();
    };

    // ==============================================================
    // GAME: KARTU GOSOK HIKMAH
    // ==============================================================

    const SCRATCH_BASE_REWARD = 50;
    const SCRATCH_CLEAR_TARGET = 55;

    const SCRATCH_DAILY_FREE_CARDS = 10;
    const SCRATCH_EXTRA_CARD_COST = 200;

    const SCRATCH_TIME_LIMIT = 30;

    let scratchTimerInterval = null;
    let scratchTimeLeft = SCRATCH_TIME_LIMIT;
    let scratchCardActive = false;
    let scratchFailedByLeaving = false;

    const SCRATCH_COST_TABLE = {
        default: [50, 60, 75, 90],
        silver: [100, 150, 200, 275],
        gold: [350, 500, 700, 950, 1250]
    };


    let currentScratchQuestion = null;
    let currentScratchReward = SCRATCH_BASE_REWARD;
    let currentScratchHintIndex = 0;

    let scratchWave = Number(localStorage.getItem('scratch_wave') || 1);

    let scratchCanvas = null;
    let scratchCtx = null;
    let scratchDrawing = false;
    let scratchCardPaid = false;
    let scratchClaimed = false;
    let scratchListenersReady = false;

    const getTodayKey = () => {
        const now = new Date();

        return [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, '0'),
            String(now.getDate()).padStart(2, '0')
        ].join('-');
    };

    const getScratchStoragePrefix = () => {
        const studentId = activeStudent?.id || 'guest';

        return `scratch_${studentId}_${getTodayKey()}`;
    };

    const getScratchCardsUsed = () => {
        return Number(localStorage.getItem(`${getScratchStoragePrefix()}_used`) || 0);
    };

    const setScratchCardsUsed = (value) => {
        localStorage.setItem(`${getScratchStoragePrefix()}_used`, String(Math.max(0, value)));
    };

    const getScratchExtraCards = () => {
        return Number(localStorage.getItem(`${getScratchStoragePrefix()}_extra`) || 0);
    };

    const setScratchExtraCards = (value) => {
        localStorage.setItem(`${getScratchStoragePrefix()}_extra`, String(Math.max(0, value)));
    };

    const getScratchTotalCardsToday = () => {
        return SCRATCH_DAILY_FREE_CARDS + getScratchExtraCards();
    };

    const getScratchCardsLeftToday = () => {
        return Math.max(0, getScratchTotalCardsToday() - getScratchCardsUsed());
    };

    const consumeScratchCardStock = () => {
        setScratchCardsUsed(getScratchCardsUsed() + 1);
        updateScratchWaveUI();
    };

    const addScratchExtraCardStock = () => {
        setScratchExtraCards(getScratchExtraCards() + 1);
        updateScratchWaveUI();
    };

    const getScratchTierByReward = (reward = getScratchRewardByWave()) => {
        if (reward > 2000) return 'gold';
        if (reward >= 500) return 'silver';
        return 'default';
    };

    const getScratchTierStartWave = (tier) => {
        for (let wave = 1; wave <= Math.max(100, scratchWave + 10); wave++) {
            const reward = SCRATCH_BASE_REWARD * Math.pow(2, wave - 1);
            if (getScratchTierByReward(reward) === tier) {
                return wave;
            }
        }

        return 1;
    };

    const getScratchTierIndex = () => {
        const tier = getScratchTierByReward();
        const startWave = getScratchTierStartWave(tier);

        return Math.max(0, scratchWave - startWave);
    };

    const getScratchCostByWave = () => {
        const tier = getScratchTierByReward();
        const tierIndex = getScratchTierIndex();
        const table = SCRATCH_COST_TABLE[tier];

        if (tierIndex < table.length) {
            return table[tierIndex];
        }

        // Kalau sudah melebihi tabel, harga lanjut naik otomatis.
        const lastCost = table[table.length - 1];
        const extraIndex = tierIndex - table.length + 1;

        if (tier === 'gold') {
            return lastCost + extraIndex * 350;
        }

        if (tier === 'silver') {
            return lastCost + extraIndex * 100;
        }

        return lastCost + extraIndex * 25;
    };

    const getQuestionPoolByWave = () => {
        const tier = getScratchTierByReward();

        return SCRATCH_QUESTIONS[tier] || SCRATCH_QUESTIONS.easy;
    };

    const getScratchEl = (id) => document.getElementById(id);

    const normalizeScratchAnswer = (value = '') => {
        return value
            .toLowerCase()
            .trim()
            .replace(/['’`]/g, '')
            .replace(/-/g, ' ')
            .replace(/\s+/g, ' ');
    };

    const isScratchAnswerCorrect = (userValue = '', correctValue = '') => {
        const userAnswer = normalizeScratchAnswer(userValue);
        const correctAnswer = normalizeScratchAnswer(correctValue);

        if (!userAnswer || !correctAnswer) return false;

        // Contoh:
        // correctAnswer = "haji"
        // userAnswer = "rukun islam ke 5 pergi haji"
        // hasilnya tetap benar karena mengandung kata "haji"
        if (userAnswer.includes(correctAnswer)) return true;

        // Biar jawaban pendek seperti "muhammad" tetap bisa benar untuk "nabi muhammad"
        if (correctAnswer.includes(userAnswer) && userAnswer.length >= 4) return true;

        return false;
    };

    const getScratchRewardByWave = () => {
        return SCRATCH_BASE_REWARD * Math.pow(2, Math.max(1, scratchWave) - 1);
    };

    const updateScratchCardTheme = () => {
        const cardBox = getScratchEl('scratchCardBox');
        const resultArea = getScratchEl('scratchResultArea');
        const resultLabel = getScratchEl('scratchResultLabel');
        const prizeText = getScratchEl('scratchPrizeText');

        if (!cardBox || !resultArea || !resultLabel || !prizeText) return;

        const reward = getScratchRewardByWave();

        cardBox.className = 'relative w-full h-[150px] rounded-2xl overflow-hidden border-4 mb-3 select-none transition-all';
        resultArea.className = 'absolute inset-0 flex flex-col items-center justify-center p-4 text-center transition-all';
        resultLabel.className = 'text-[10px] font-black uppercase tracking-widest mb-1';
        prizeText.className = 'font-black text-2xl';

        if (reward > 1000) {
            // Layer asli kontras untuk kartu gold
            cardBox.classList.add(
                'bg-slate-900',
                'border-yellow-300',
                'shadow-[0_0_25px_rgba(251,191,36,0.45)]'
            );

            resultArea.classList.add(
                'bg-slate-900'
            );

            resultLabel.classList.add(
                'text-yellow-200'
            );

            prizeText.classList.add(
                'text-yellow-300'
            );
        } else if (reward >= 500) {
            // Layer asli kontras untuk kartu silver
            cardBox.classList.add(
                'bg-slate-900',
                'border-slate-300',
                'shadow-[0_0_20px_rgba(148,163,184,0.45)]'
            );

            resultArea.classList.add(
                'bg-slate-900'
            );

            resultLabel.classList.add(
                'text-slate-300'
            );

            prizeText.classList.add(
                'text-white'
            );
        } else {
            // Layer asli kontras untuk kartu default abu gelap
            cardBox.classList.add(
                'bg-teal-50',
                'border-teal-100'
            );

            resultArea.classList.add(
                'bg-teal-50'
            );

            resultLabel.classList.add(
                'text-teal-600'
            );

            prizeText.classList.add(
                'text-teal-700'
            );
        }
    };

    const updateScratchWaveUI = () => {
        const reward = getScratchRewardByWave();
        const cost = getScratchCostByWave();
        const cardsLeft = getScratchCardsLeftToday();

        const waveText = getScratchEl('scratchWaveText');
        const rewardText = getScratchEl('scratchRewardText');
        const costText = getScratchEl('scratchCostText');
        const stockText = getScratchEl('scratchCardStockText');

        if (waveText) waveText.innerText = `Wave ${scratchWave}`;
        if (rewardText) rewardText.innerText = `${reward}`;
        if (costText) costText.innerText = `${cost}`;
        if (stockText) stockText.innerText = `${cardsLeft}`;

        updateScratchCardTheme();

        const buyBtn = getScratchEl('btnBuyScratch');

        if (buyBtn && !scratchCardPaid) {
            const hasCard = cardsLeft > 0;

            buyBtn.disabled = !hasCard;
            buyBtn.innerText = hasCard
                ? `Pakai Kartu (${cardsLeft} tersisa)`
                : 'Kartu Habis - Beli di Toko';
        }
    };

    const resetScratchWave = () => {
        scratchWave = 1;
        localStorage.setItem('scratch_wave', String(scratchWave));
        updateScratchWaveUI();
    };

    const increaseScratchWave = () => {
        scratchWave += 1;
        localStorage.setItem('scratch_wave', String(scratchWave));
        updateScratchWaveUI();
    };

    const getRandomScratchQuestion = () => {
        const pool = getQuestionPoolByWave();

        return pool[Math.floor(Math.random() * pool.length)];
    };

    const setScratchButton = (text, disabled = false) => {
        const btn = getScratchEl('btnBuyScratch');
        if (!btn) return;

        btn.innerText = text;
        btn.disabled = disabled;
    };

    const updateScratchTimerUI = () => {
        const timerText = getScratchEl('scratchTimerText');
        if (!timerText) return;

        timerText.innerText = scratchCardActive ? `${scratchTimeLeft}s` : '--';

        if (scratchTimeLeft <= 10 && scratchCardActive) {
            timerText.classList.remove('text-rose-600');
            timerText.classList.add('text-red-600', 'animate-pulse');
        } else {
            timerText.classList.remove('text-red-600', 'animate-pulse');
            timerText.classList.add('text-rose-600');
        }
    };

    const stopScratchTimer = () => {
        if (scratchTimerInterval) {
            clearInterval(scratchTimerInterval);
            scratchTimerInterval = null;
        }

        scratchCardActive = false;
        updateScratchTimerUI();
    };

    const startScratchTimer = () => {
        stopScratchTimer();

        scratchTimeLeft = SCRATCH_TIME_LIMIT;
        scratchCardActive = true;
        scratchFailedByLeaving = false;

        updateScratchTimerUI();

        scratchTimerInterval = setInterval(() => {
            scratchTimeLeft -= 1;
            updateScratchTimerUI();

            if (scratchTimeLeft <= 0) {
                handleScratchTimeout();
            }
        }, 1000);
    };

    const handleScratchTimeout = () => {
        if (scratchClaimed || !scratchCardActive) return;

        stopScratchTimer();

        scratchClaimed = true;
        scratchCardPaid = false;
        scratchDrawing = false;

        const input = getScratchEl('scratchAnswer');
        const prizeText = getScratchEl('scratchPrizeText');
        const resultLabel = getScratchEl('scratchResultLabel');

        if (input) input.disabled = true;

        if (prizeText) prizeText.innerText = currentScratchQuestion?.answer?.toUpperCase() || '---';
        if (resultLabel) resultLabel.innerText = 'Waktu Habis';

        if (scratchCanvas) {
            scratchCanvas.style.transition = 'opacity 0.45s ease-out';
            scratchCanvas.style.opacity = '0';
            scratchCanvas.style.pointerEvents = 'none';
        }

        resetScratchWave();

        window.showCustomAlert?.(
            'Waktu Habis',
            `Jawaban yang benar adalah "${currentScratchQuestion?.answer || '-'}". Kartu hangus dan wave kembali ke Wave 1.`,
            'danger'
        );

        setTimeout(() => {
            prepareNewScratchQuestion();
        }, 1400);
    };

    const failScratchBecauseUserLeft = () => {
        if (!scratchCardActive || scratchClaimed || !scratchCardPaid) return;

        scratchFailedByLeaving = true;

        stopScratchTimer();

        scratchClaimed = true;
        scratchCardPaid = false;
        scratchDrawing = false;

        const input = getScratchEl('scratchAnswer');
        const prizeText = getScratchEl('scratchPrizeText');
        const resultLabel = getScratchEl('scratchResultLabel');

        if (input) input.disabled = true;

        if (prizeText) prizeText.innerText = currentScratchQuestion?.answer?.toUpperCase() || '---';
        if (resultLabel) resultLabel.innerText = 'Kartu Hangus';

        if (scratchCanvas) {
            scratchCanvas.style.transition = 'opacity 0.45s ease-out';
            scratchCanvas.style.opacity = '0';
            scratchCanvas.style.pointerEvents = 'none';
        }

        resetScratchWave();

        window.showCustomAlert?.(
            'Kartu Hangus',
            'Kamu keluar dari halaman saat kartu aktif. Untuk mencegah cari jawaban di luar, kartu dianggap gagal dan wave direset.',
            'danger'
        );

        setTimeout(() => {
            prepareNewScratchQuestion();
        }, 1400);
    };

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            failScratchBecauseUserLeft();
        }
    });

    window.addEventListener('blur', () => {
        failScratchBecauseUserLeft();
    });

    const renderScratchHints = () => {
        const hintList = getScratchEl('scratchHintList');
        const btnHint = getScratchEl('btnHint');

        if (!hintList || !currentScratchQuestion) return;

        hintList.innerHTML = '';

        for (let i = 0; i <= currentScratchHintIndex; i++) {
            const li = document.createElement('li');
            li.innerText = `"${currentScratchQuestion.hint[i]}"`;
            hintList.appendChild(li);
        }

        if (btnHint) {
            btnHint.disabled = currentScratchHintIndex >= currentScratchQuestion.hint.length - 1;
        }
    };

    const prepareNewScratchQuestion = () => {
        stopScratchTimer();
        scratchFailedByLeaving = false;

        currentScratchQuestion = getRandomScratchQuestion();
        currentScratchReward = getScratchRewardByWave();
        currentScratchHintIndex = 0;

        scratchCardPaid = false;
        scratchClaimed = false;
        scratchDrawing = false;

        const playArea = getScratchEl('scratchPlayArea');
        const input = getScratchEl('scratchAnswer');
        const prizeText = getScratchEl('scratchPrizeText');
        const resultLabel = getScratchEl('scratchResultLabel');

        // Awal modal: area soal, input, dan kartu disembunyikan dulu
        if (playArea) {
            playArea.classList.add('hidden');
        }

        if (input) {
            input.value = '';
            input.disabled = false;
        }

        if (prizeText) prizeText.innerText = currentScratchQuestion.answer.toUpperCase();
        if (resultLabel) resultLabel.innerText = 'Jawaban Asli';

        renderScratchHints();
        updateScratchWaveUI();

        const cardsLeft = getScratchCardsLeftToday();

        setScratchButton(
            cardsLeft > 0 ? `Pakai Kartu (${cardsLeft} tersisa)` : 'Kartu Habis - Beli di Toko',
            cardsLeft <= 0
        );
    };

    window.openScratchModal = () => {
        const modal = getScratchEl('modalScratch');

        if (!modal) {
            console.error('Elemen #modalScratch tidak ditemukan.');
            return window.showCustomAlert?.(
                'Modal Tidak Ditemukan',
                'Elemen modalScratch belum ada di HTML.',
                'error'
            );
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        setTimeout(() => {
            prepareNewScratchQuestion();
        }, 50);
    };

    window.closeScratchModal = () => {
        if (scratchCardActive && !scratchClaimed && scratchCardPaid) {
            failScratchBecauseUserLeft();
        }

        const modal = getScratchEl('modalScratch');
        if (!modal) return;

        modal.classList.remove('flex');
        modal.classList.add('hidden');
    };

    window.addHint = () => {
        if (!currentScratchQuestion) return;

        if (currentScratchHintIndex >= currentScratchQuestion.hint.length - 1) {
            return window.showToastAlert?.('warning', 'Hint Habis', 'Semua hint sudah dibuka.');
        }

        currentScratchHintIndex += 1;
        renderScratchHints();
    };

    const initScratchCanvas = (isPaid) => {
        scratchCanvas = getScratchEl('scratchCanvas');
        if (!scratchCanvas) return;

        scratchCtx = scratchCanvas.getContext('2d', { willReadFrequently: true });

        const rect = scratchCanvas.getBoundingClientRect();

        scratchCanvas.width = Math.max(1, Math.floor(rect.width));
        scratchCanvas.height = Math.max(1, Math.floor(rect.height));

        scratchCtx.globalCompositeOperation = 'source-over';
        scratchCtx.clearRect(0, 0, scratchCanvas.width, scratchCanvas.height);

        const reward = getScratchRewardByWave();

        if (reward > 1000) {
            // Gold: atas bawah agak gelap, tengah cerah
            const goldGradient = scratchCtx.createLinearGradient(0, 0, 0, scratchCanvas.height);
            goldGradient.addColorStop(0, '#b7791f');
            goldGradient.addColorStop(0.25, '#f6d365');
            goldGradient.addColorStop(0.5, '#fff7ad');
            goldGradient.addColorStop(0.75, '#d69e2e');
            goldGradient.addColorStop(1, '#9c6b16');

            scratchCtx.fillStyle = goldGradient;
        } else if (reward >= 500) {
            // Silver: atas bawah agak gelap, tengah silver cerah
            const silverGradient = scratchCtx.createLinearGradient(0, 0, 0, scratchCanvas.height);
            silverGradient.addColorStop(0, '#9ca3af');
            silverGradient.addColorStop(0.28, '#d1d5db');
            silverGradient.addColorStop(0.5, '#f8fafc');
            silverGradient.addColorStop(0.72, '#cbd5e1');
            silverGradient.addColorStop(1, '#8b939e');

            scratchCtx.fillStyle = silverGradient;
        } else {
            // Default: bukan gradient, abu gelap polos
            scratchCtx.fillStyle = '#64748b';
        }

        scratchCtx.fillRect(0, 0, scratchCanvas.width, scratchCanvas.height);

        scratchCtx.fillStyle = reward >= 500 ? '#1f2937' : '#e2e8f0';
        scratchCtx.font = 'bold 18px Arial';
        scratchCtx.textAlign = 'center';
        scratchCtx.textBaseline = 'middle';

        scratchCtx.fillText(
            isPaid ? 'GOSOK DI SINI' : 'BELI KARTU DULU',
            scratchCanvas.width / 2,
            scratchCanvas.height / 2
        );

        scratchCanvas.style.opacity = '1';
        scratchCanvas.style.pointerEvents = 'auto';

        if (!scratchListenersReady) {
            scratchCanvas.addEventListener('pointerdown', startScratch);
            scratchCanvas.addEventListener('pointermove', scratchMove);
            scratchCanvas.addEventListener('pointerup', stopScratch);
            scratchCanvas.addEventListener('pointerleave', stopScratch);
            scratchCanvas.addEventListener('pointercancel', stopScratch);

            scratchListenersReady = true;
        }
    };

    const getScratchPointerPosition = (event) => {
        const rect = scratchCanvas.getBoundingClientRect();

        return {
            x: event.clientX - rect.left,
            y: event.clientY - rect.top
        };
    };

    const startScratch = (event) => {
        if (!scratchCardPaid || scratchClaimed || !scratchCanvas || !scratchCtx) {
            return;
        }

        event.preventDefault();

        const input = getScratchEl('scratchAnswer');
        if (input) {
            input.disabled = true;
        }

        scratchDrawing = true;
        scratchCanvas.setPointerCapture?.(event.pointerId);

        scratchAt(event);
    };

    const scratchMove = (event) => {
        if (!scratchDrawing || !scratchCardPaid || scratchClaimed) {
            return;
        }

        event.preventDefault();
        scratchAt(event);
    };

    const stopScratch = (event) => {
        if (!scratchDrawing) return;

        scratchDrawing = false;
        scratchCanvas?.releasePointerCapture?.(event.pointerId);

        checkScratchPercentage();
    };

    const scratchAt = (event) => {
        if (!scratchCtx || !scratchCanvas) return;

        const pos = getScratchPointerPosition(event);

        scratchCtx.globalCompositeOperation = 'destination-out';
        scratchCtx.beginPath();
        scratchCtx.arc(pos.x, pos.y, 18, 0, Math.PI * 2);
        scratchCtx.fill();

        checkScratchPercentage();
    };

    const checkScratchPercentage = () => {
        if (!scratchCanvas || !scratchCtx || scratchClaimed || !scratchCardPaid) return;

        const imageData = scratchCtx.getImageData(0, 0, scratchCanvas.width, scratchCanvas.height);
        const pixels = imageData.data;

        let transparentPixels = 0;

        for (let i = 3; i < pixels.length; i += 4) {
            if (pixels[i] === 0) {
                transparentPixels++;
            }
        }

        const totalPixels = scratchCanvas.width * scratchCanvas.height;
        const clearPercentage = (transparentPixels / totalPixels) * 100;

        if (clearPercentage >= SCRATCH_CLEAR_TARGET) {
            finishScratchCard();
        }
    };

    window.buyExtraScratchCard = async () => {
        if (!activeStudent?.id) {
            return window.showCustomAlert?.('Data Tidak Ada', 'Pilih siswa terlebih dahulu.', 'warning');
        }

        if ((activeStudent.poin || 0) < SCRATCH_EXTRA_CARD_COST) {
            return window.showCustomAlert?.(
                'Koin Kurang',
                `Butuh ${SCRATCH_EXTRA_CARD_COST} koin untuk membeli 1 kartu tambahan.`,
                'warning'
            );
        }

        const btn = getScratchEl('btnBuyExtraScratchCard');
        if (btn) {
            btn.disabled = true;
            btn.innerText = 'Membeli kartu tambahan...';
        }

        try {
            const res = await fetch(`${API_URL}/api/digital-rewards/game-win`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    student_id: activeStudent.id,
                    reward_amount: -SCRATCH_EXTRA_CARD_COST
                })
            });

            const result = await res.json();

            if (!res.ok || result.status !== 'success') {
                throw new Error(result.message || 'Gagal membeli kartu tambahan.');
            }

            activeStudent.poin = result.data.new_poin;
            updateShopUI?.();

            addScratchExtraCardStock();

            window.showToastAlert?.(
                'success',
                'Kartu Bertambah',
                'Kamu berhasil membeli 1 kartu tambahan untuk hari ini.'
            );
        } catch (error) {
            console.error(error);

            window.showCustomAlert?.(
                'Gagal',
                error.message || 'Gagal membeli kartu tambahan.',
                'error'
            );
        } finally {
            updateScratchWaveUI();
        }
    };

    const claimScratchReward = async (rewardAmount) => {
        if (!activeStudent?.id) {
            throw new Error('Data siswa tidak ditemukan.');
        }

        const res = await fetch(`${API_URL}/api/digital-rewards/game-win`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                student_id: activeStudent.id,
                reward_amount: rewardAmount
            })
        });

        const result = await res.json();

        if (!res.ok || result.status !== 'success') {
            throw new Error(result.message || 'Gagal klaim reward scratch.');
        }

        activeStudent.poin = result.data.new_poin;
        updateShopUI?.();

        return result.data.new_poin;
    };

    window.buyScratchCard = async () => {
        if (!activeStudent) {
            return window.showCustomAlert?.('Data Tidak Ada', 'Pilih siswa terlebih dahulu.', 'warning');
        }

        if (getScratchCardsLeftToday() <= 0) {
            return window.showCustomAlert?.(
                'Kartu Habis',
                `Kartu hari ini sudah habis. Silakan beli item "+1 Kartu Gosok" di toko seharga ${SCRATCH_EXTRA_CARD_COST} koin.`,
                'warning'
            );
        }

        setScratchButton('Memasukkan kartu...', true);

        try {
            consumeScratchCardStock();

            scratchCardPaid = true;
            scratchClaimed = false;
            currentScratchReward = getScratchRewardByWave();

            const playArea = getScratchEl('scratchPlayArea');
            const input = getScratchEl('scratchAnswer');
            const prizeText = getScratchEl('scratchPrizeText');
            const resultLabel = getScratchEl('scratchResultLabel');

            if (prizeText) prizeText.innerText = '---';
            if (resultLabel) resultLabel.innerText = 'Jawaban Asli';

            if (input) {
                input.value = '';
                input.disabled = false;
            }

            renderScratchHints();
            updateScratchCardTheme();

            if (playArea) {
                playArea.classList.remove('hidden');
            }

            requestAnimationFrame(() => {
                initScratchCanvas(true);

                const answerInput = getScratchEl('scratchAnswer');
                if (answerInput) answerInput.focus();
            });

            setScratchButton('Kartu sedang aktif...', true);
            startScratchTimer();

            window.showToastAlert?.(
                'success',
                'Kartu Dipakai',
                'Isi jawaban dulu, lalu gosok kartunya.'
            );
        } catch (error) {
            console.error(error);

            setScratchButton(
                getScratchCardsLeftToday() > 0
                    ? `Pakai Kartu (${getScratchCardsLeftToday()} tersisa)`
                    : 'Kartu Habis - Beli di Toko',
                getScratchCardsLeftToday() <= 0
            );

            window.showCustomAlert?.(
                'Gagal',
                error.message || 'Gagal memakai kartu scratch.',
                'error'
            );
        }
    };

    const finishScratchCard = async () => {
        if (scratchClaimed) return;

        stopScratchTimer();

        scratchClaimed = true;
        scratchCardPaid = false;
        scratchDrawing = false;

        const input = getScratchEl('scratchAnswer');
        const rawUserAnswer = input?.value || '';
        const rawCorrectAnswer = currentScratchQuestion?.answer || '';

        const isCorrect = isScratchAnswerCorrect(rawUserAnswer, rawCorrectAnswer);
        const rewardAmount = isCorrect ? currentScratchReward : 0;

        const prizeText = getScratchEl('scratchPrizeText');
        const resultLabel = getScratchEl('scratchResultLabel');

        // Jawaban asli baru muncul setelah scratch mencapai target
        if (prizeText) prizeText.innerText = rawCorrectAnswer.toUpperCase();
        if (resultLabel) {
            resultLabel.innerText = isCorrect ? 'Jawaban Benar!' : 'Jawaban Asli';
        }

        if (scratchCanvas) {
            scratchCanvas.style.transition = 'opacity 0.45s ease-out';
            scratchCanvas.style.opacity = '0';
            scratchCanvas.style.pointerEvents = 'none';
        }

        try {
            if (rewardAmount > 0) {
                await claimScratchReward(rewardAmount);

                if (window.confetti) {
                    window.confetti({
                        particleCount: 140,
                        spread: 80,
                        origin: { y: 0.65 },
                        zIndex: 9999
                    });
                }

                window.showCustomAlert?.(
                    'Jawaban Benar!',
                    `Jawaban aslinya adalah "${rawCorrectAnswer}". Kamu mendapatkan ${rewardAmount} koin. Wave naik ke ${scratchWave + 1}.`,
                    'success'
                );

                increaseScratchWave();
            } else {
                resetScratchWave();

                window.showCustomAlert?.(
                    'Yah, Belum Berhasil',
                    `Jawaban yang benar adalah "${rawCorrectAnswer}". Karena jawaban kosong atau salah, reward 0 dan wave kembali ke Wave 1.`,
                    'danger'
                );
            }
        } catch (error) {
            console.error(error);

            window.showCustomAlert?.(
                'Gagal Klaim',
                error.message || 'Reward gagal diproses.',
                'error'
            );
        } finally {
            setTimeout(() => {
                prepareNewScratchQuestion();
            }, 1400);
        }
    };

    updateScratchWaveUI();
    init();
</script>


