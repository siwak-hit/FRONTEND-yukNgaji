    window.resetWave = () => {
        currentWave = 1;
        updateGachaCostAndWheel();
    };

    // BUG FIX: Limit Checkbox (Disable jika sudah 4)
    window.handleFriendCheckbox = () => {
        const checkboxes = document.querySelectorAll('.chk-friend');
        const checkedCount = document.querySelectorAll('.chk-friend:checked').length;

        checkboxes.forEach(chk => {
            if (!chk.checked) {
                chk.disabled = checkedCount >= 4;
                chk.parentElement.style.opacity = (checkedCount >= 4) ? '0.4' : '1';
                chk.parentElement.style.cursor = (checkedCount >= 4) ? 'not-allowed' : 'pointer';
            } else {
                chk.parentElement.style.opacity = '1';
            }
        });
        updateGachaCostAndWheel();
    };

    window.updateGachaCostAndWheel = () => {
        if (checkSpinCooldown()) return renderWheel();

        if (currentGachaMode === 'solo') {
            const select = document.getElementById('gachaTargetPrize');
            const cost = select.options[select.selectedIndex].dataset.cost;
            document.getElementById('btnSpinWheel').innerText = `Putar Sekarang (${cost} Koin)`;
            document.getElementById('btnSpinWheel').disabled = false;
        } else {
            const config = waveConfig[Math.min(currentWave - 1, waveConfig.length - 1)];
            document.getElementById('waveTitle').innerText = `Wave ${config.wave}`;
            document.getElementById('waveDesc').innerText = `Biaya: ${config.cost} | Hadiah: ${config.prize} | Zonk/Pemain: ${config.zonks}`;
            document.getElementById('btnSpinWheel').innerText = `Putar Sekarang (${config.cost} Koin)`;
            document.getElementById('btnSpinWheel').disabled = false;
        }
        renderWheel();
    };

    window.renderWheel = () => {
        let segments = [];

        if (currentGachaMode === 'solo') {
            const select = document.getElementById('gachaTargetPrize');
            const targetPrize = parseInt(select.value);

            if (targetPrize === 100) {
                segments = [
                    { fillStyle: '#facc15', text: '10', value: 10, textFillStyle: '#854d0e' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#f87171', text: '25', value: 25, textFillStyle: '#7f1d1d' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#38bdf8', text: '50', value: 50, textFillStyle: '#0c4a6e' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#a855f7', text: '100!', value: 100, size: window.innerWidth < 400 ? 5 : 10, textFillStyle: '#ffffff' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' }
                ];
            } else if (targetPrize === 500) {
                segments = [
                    { fillStyle: '#facc15', text: '25', value: 25, textFillStyle: '#854d0e' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#f87171', text: '50', value: 50, textFillStyle: '#7f1d1d' },
                    { fillStyle: '#e2e8f0', text: 'ZONK', value: 0, textFillStyle: '#64748b' },
                    { fillStyle: '#38bdf8', text: '100', value: 100, textFillStyle: '#0c4a6e' },
