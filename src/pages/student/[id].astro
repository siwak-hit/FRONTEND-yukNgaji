    // ================================================================
    // LOGIKA MODAL RAPORT
    // ================================================================
    const convertToGrade = (s) => s >= 85 ? 'A' : s >= 70 ? 'B' : s >= 60 ? 'C' : 'D';

    const getRaportSubjectBreakdown = (subject, avgElementId) => {
        const subjectName = subject.charAt(0).toUpperCase() + subject.slice(1);

        const weeklyScore = parseInt(document.getElementById(avgElementId)?.innerText) || 0;
        const examRaw = studentExamResults.find(e => e.subject === subject)?.score;
        const hasExamScore = examRaw !== null && examRaw !== undefined;
        const examScore = hasExamScore ? Number(examRaw || 0) : null;

        const oralRaw = studentOralSummary?.[subject];
        const hasOralScore = oralRaw !== null && oralRaw !== undefined;
        const oralScore = hasOralScore ? Number(oralRaw || 0) : null;

        let finalScore = 0;
        let formula = '';

        if (hasExamScore && hasOralScore) {
            finalScore = Math.round(
                (weeklyScore * 0.3) +
                (examScore * 0.5) +
                (oralScore * 0.2)
            );
            formula = '30% tugas + 50% ujian + 20% lisan';
        } else if (hasExamScore) {
            finalScore = Math.round(
                (weeklyScore * 0.3) +
                (examScore * 0.7)
            );
            formula = '30% tugas + 70% ujian';
        } else if (hasOralScore) {
            finalScore = Math.round(
                (weeklyScore * 0.6) +
                (oralScore * 0.4)
            );
            formula = '60% tugas + 40% lisan';
        } else {
            finalScore = weeklyScore;
            formula = 'sementara dari nilai tugas';
        }

        const grade = convertToGrade(finalScore);

        return {
            weekly: weeklyScore,
            exam: hasExamScore ? examScore : null,
            oral: hasOralScore ? oralScore : null,
            final_score: finalScore,
            grade,
            formula
        };
    };

    const buildAcademicBreakdown = () => ({
        tajwid: getRaportSubjectBreakdown('tajwid', 'avgTajwid'),
        fiqih: getRaportSubjectBreakdown('fiqih', 'avgFiqih'),
        tauhid: getRaportSubjectBreakdown('tauhid', 'avgTauhid'),
        quran: {
            weekly: null,
