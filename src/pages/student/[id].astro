                label,
                item.formula || '-',
                `${item.final_score ?? '-'} (${item.grade || '-'})`
            ];
        });

        const colDetail = [
            { label: 'Mapel',   x: margin,                  w: contentW * 0.24 },
            { label: 'Rumus',   x: margin + contentW * 0.24, w: contentW * 0.52 },
            { label: 'Hasil',   x: margin + contentW * 0.76, w: contentW * 0.24 }
        ];

        p2Y = drawTable(doc, p2Y, colDetail, detailRows);
        p2Y += 8;

        // ---- G. RINGKASAN ABSENSI BULANAN ----
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(11);
        doc.text('G. RINGKASAN ABSENSI BULANAN', margin, p2Y); p2Y += 6;

        const monthlySummary = buildMonthlyAttendanceSummary();
        const colAbsen = [
            { label: 'Bulan',      x: margin,                   w: contentW * 0.50 },
            { label: 'Izin/Sakit', x: margin + contentW * 0.50, w: contentW * 0.25 },
            { label: 'Alpa',       x: margin + contentW * 0.75, w: contentW * 0.25 }
        ];

        if (monthlySummary.length > 0) {
            const rowH = 8;
            doc.setFillColor(220, 220, 220);
            colAbsen.forEach(c => doc.rect(c.x, p2Y, c.w, rowH, 'F'));
            doc.rect(margin, p2Y, contentW, rowH);
            colAbsen.slice(1).forEach(c => doc.line(c.x, p2Y, c.x, p2Y + rowH));
            doc.setFont('helvetica', 'bold'); doc.setFontSize(8);
            colAbsen.forEach(c => doc.text(c.label, c.x + c.w / 2, p2Y + rowH / 2 + 1.5, { align: 'center' }));
            p2Y += rowH;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            monthlySummary.forEach((row, idx) => {
                if (idx % 2 === 0) {
                    doc.setFillColor(250, 250, 250);
                    colAbsen.forEach(c => doc.rect(c.x, p2Y, c.w, rowH, 'F'));
                }
                doc.rect(margin, p2Y, contentW, rowH);
                colAbsen.slice(1).forEach(c => doc.line(c.x, p2Y, c.x, p2Y + rowH));

                doc.setTextColor(0, 0, 0);
                doc.text(row.label, colAbsen[0].x + 3, p2Y + rowH / 2 + 1.5);

                doc.setTextColor(row.izin > 0 ? 180 : 0, row.izin > 0 ? 120 : 0, 0);
                doc.text(row.izin > 0 ? `${row.izin} hari` : '-', colAbsen[1].x + colAbsen[1].w / 2, p2Y + rowH / 2 + 1.5, { align: 'center' });

                doc.setTextColor(row.alpa > 0 ? 180 : 0, 0, 0);
                doc.text(row.alpa > 0 ? `${row.alpa} hari` : '-', colAbsen[2].x + colAbsen[2].w / 2, p2Y + rowH / 2 + 1.5, { align: 'center' });

                doc.setTextColor(0, 0, 0);
                p2Y += rowH;
            });

            doc.setFillColor(225, 225, 225);
            colAbsen.forEach(c => doc.rect(c.x, p2Y, c.w, rowH, 'F'));
            doc.rect(margin, p2Y, contentW, rowH);
            colAbsen.slice(1).forEach(c => doc.line(c.x, p2Y, c.x, p2Y + rowH));
            doc.setFont('helvetica', 'bold'); doc.setFontSize(8);
