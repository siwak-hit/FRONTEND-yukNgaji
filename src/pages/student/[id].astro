---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
import StudentTopBar from '../../components/student/StudentTopBar.astro';
import ProfileCard from '../../components/student/ProfileCard.astro';
import StatsPanel from '../../components/student/StatsPanel.astro';
import ActivityPanel from '../../components/student/ActivityPanel.astro';
import StudentModals from '../../components/student/StudentModals.astro';
---

<Layout title="Detail Anak - yukNgaji">
    <div class="px-6 py-8 pb-32 min-h-screen">
        <StudentTopBar />
        <ProfileCard />
        <StatsPanel />
        <ActivityPanel />
    </div>

    <NavbarGuru activeMenu="students" />
    <Toast />
    <StudentModals />
</Layout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" is:inline></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
    const token = localStorage.getItem('token');
    const pathParts = window.location.pathname.split('/');
    const studentId = pathParts[pathParts.length - 1];

    if (!token) window.location.replace('/');

    // ================================================================
    // STUDENT NAVIGATOR — list semua siswa, navigasi prev/next, search
    // ================================================================
    let allStudents = [];       // [{id, name, grade}, ...]
    let currentStudentIndex = -1;
    let searchDebounceTimer = null;
    let studentExamResults = [];

    let studentOralSummary = {
        tajwid: null,
        fiqih: null,
        tauhid: null
    };

    let studentOralDetail = {
        tajwid: null,
        fiqih: null,
        tauhid: null
    };

    const loadAllStudents = async () => {
        try {
            const res = await fetch(`${API_URL}/api/students`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const json = await res.json();
            allStudents = (json.data || []).sort((a, b) => a.name.localeCompare(b.name, 'id'));
            currentStudentIndex = allStudents.findIndex(s => String(s.id) === String(studentId));
            updateNavigatorUI();
        } catch (e) {
            console.error('Gagal load daftar siswa:', e);
        }
    };

    window.toggleInfaqCan = () => {
        const modal = document.getElementById('modalKaleng');
        const messageEl = document.getElementById('kalengMessage');
        messageEl.innerHTML = getKalengMessage();
        // Tombol "Ingatkan Siswa" hanya relevan kalau kaleng masih dipegang
        document.getElementById('btnOpenRemindInfaqModal')?.classList.toggle('hidden', !hasCan);
        modal.classList.remove('hidden');
    };

    // Pastikan tombol tutup modal kaleng tetap berfungsi
    document.getElementById('closeModalKaleng').addEventListener('click', () => {
        document.getElementById('modalKaleng').classList.add('hidden');
    });

    // ─── Pengingat kaleng via push notif ──────────────────────
    document.getElementById('btnOpenRemindInfaqModal')?.addEventListener('click', () => {
        document.getElementById('modalKaleng').classList.add('hidden');
        document.getElementById('modalRemindInfaq').classList.remove('hidden');
    });
    document.getElementById('closeModalRemindInfaq')?.addEventListener('click', () => {
        document.getElementById('modalRemindInfaq').classList.add('hidden');
    });
    document.getElementById('btnSendInfaqReminder')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        if (btn.disabled) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim...</span>';
        try {
            const message = document.getElementById('infaqReminderMessage').value.trim();
            const res = await fetch(`${API_URL}/api/students/${studentId}/remind-infaq`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message || undefined })
            });
            const json = await res.json();
            if (!res.ok) throw new Error(json.message || 'Gagal mengirim notifikasi.');
            window.showToast?.('success', 'Terkirim', json.message || 'Pengingat kaleng berhasil dikirim.');
            document.getElementById('modalRemindInfaq').classList.add('hidden');
            document.getElementById('infaqReminderMessage').value = '';
        } catch (err) {
            window.showToast?.('danger', 'Gagal', err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = original;
        }
    });

    window.renderConsultations = () => {
        const container = document.getElementById('consContainer');
        const filterValue = document.getElementById('filterKonsul')?.value || 'all';

        // Pastikan data tersedia
        if (!globalConsultations?.data || globalConsultations.data.length === 0) {
            container.innerHTML = '<p class="text-center text-gray-400 text-sm py-4">Belum ada riwayat kuesioner.</p>';
            return;
        }

        const now = new Date();

        // 1. Filter berdasarkan waktu
        let filteredData = globalConsultations.data.filter(item => {
            if (filterValue === 'all') return true;
            const itemDate = new Date(item.created_at);
            const diffDays = (now - itemDate) / (1000 * 60 * 60 * 24);
            return diffDays <= parseInt(filterValue);
        });

        // 2. Batasi maksimal 5 data terakhir
        filteredData = filteredData.slice(0, 5);

        // 3. Render ke HTML
        container.innerHTML = filteredData.length ? filteredData.map(item => `
            <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-3">
                <div class="flex justify-between items-center"><span class="text-[10px] font-bold bg-blue-50 text-blue-600 px-2 py-1 rounded-md uppercase">Mg ${item.week} • ${item.subject}</span><span class="text-[10px] text-gray-400 font-bold uppercase">${new Date(item.created_at).toLocaleDateString('id-ID')}</span></div>
                <div class="grid grid-cols-3 gap-2 py-2 border-y border-dashed border-gray-100">
                    <div class="text-center"><p class="text-[9px] text-gray-400 font-bold uppercase">Akhlak</p><p class="text-sm font-black text-green-600">${item.akhlak_score}</p></div>
                    <div class="text-center border-x border-dashed border-gray-100"><p class="text-[9px] text-gray-400 font-bold uppercase">Disiplin</p><p class="text-sm font-black text-blue-600">${item.disiplin_score}</p></div>
                    <div class="text-center"><p class="text-[9px] text-gray-400 font-bold uppercase">Keaktifan</p><p class="text-sm font-black text-purple-600">${item.aktif_score}</p></div>
                </div>
                ${item.image_url ? `<img src="${item.image_url}" class="w-full h-48 object-cover object-top rounded-2xl border border-gray-100 mt-2 shadow-sm" alt="Foto Konsul">` : ''}

                ${item.week ? `<button onclick="openReviewModal('${item.subject}', ${item.week})" class="mt-2 w-full py-2.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 rounded-xl text-[10px] font-bold transition-colors border border-indigo-100 shadow-sm flex items-center justify-center gap-2"><i class="fa-solid fa-magnifying-glass"></i> Lihat Jawaban Anak</button>` : ''}
            </div>
        `).join('') : '<p class="text-center text-gray-400 text-sm py-4">Tidak ada data di rentang waktu ini.</p>';
    };

    const updateNavigatorUI = () => {
        const counter = document.getElementById('studentNavCounter');
        const input   = document.getElementById('studentSearchInput');
        const btnPrev = document.getElementById('btnPrevStudent');
        const btnNext = document.getElementById('btnNextStudent');

        if (currentStudentIndex >= 0) {
            counter.textContent = `${currentStudentIndex + 1}/${allStudents.length}`;
            input.placeholder   = allStudents[currentStudentIndex]?.name || 'Cari nama siswa...';
        } else {
            counter.textContent = `-/${allStudents.length}`;
        }

        btnPrev.disabled = currentStudentIndex <= 0;
        btnNext.disabled = currentStudentIndex >= allStudents.length - 1;
    };

    window.navigateStudent = (direction) => {
        const newIndex = currentStudentIndex + direction;
        if (newIndex < 0 || newIndex >= allStudents.length) return;
        const target = allStudents[newIndex];
        window.location.href = `/student/${target.id}`;
    };

    // Logika buka-tutup Menu Aksi Cepat (Raport, Kaleng, Poin)
    window.toggleQuickActions = () => {
        const menu = document.getElementById('dropdownQuickActions');
        menu.classList.toggle('hidden');
    };

    // Search dengan debounce
    const renderDropdown = (query) => {
        const dropdown = document.getElementById('studentSearchDropdown');
        if (!query.trim()) {
            dropdown.classList.add('hidden');
            dropdown.innerHTML = '';
            return;
        }

        const q = query.toLowerCase();
        const matched = allStudents.filter(s => s.name.toLowerCase().includes(q)).slice(0, 8);

        if (matched.length === 0) {
            dropdown.innerHTML = `<div class="px-4 py-3 text-xs text-gray-400 text-center">Tidak ditemukan</div>`;
            dropdown.classList.remove('hidden');
            return;
        }

        dropdown.innerHTML = matched.map((s, i) => {
            const highlighted = s.name.replace(
                new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'),
                '<mark class="bg-yellow-100 text-yellow-800 rounded">$1</mark>'
            );
            const isActive = String(s.id) === String(studentId);
            return `
                <button onclick="goToStudent('${s.id}')"
                    class="w-full flex items-center gap-3 px-4 py-3 text-left hover:bg-gray-50 transition-colors ${isActive ? 'bg-green-50' : ''} ${i > 0 ? 'border-t border-gray-50' : ''}">
                    <div class="w-7 h-7 rounded-lg bg-green-100 text-green-600 text-[10px] font-black flex items-center justify-center flex-shrink-0">
                        ${s.name.substring(0, 2).toUpperCase()}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold text-gray-800 truncate">${highlighted}</p>
                        <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wide truncate">${s.grade || ''}</p>
                    </div>
                    ${isActive ? '<i class="fa-solid fa-circle-check text-green-500 text-xs flex-shrink-0"></i>' : ''}
                </button>`;
        }).join('');

        dropdown.classList.remove('hidden');
    };

    window.openEditAbsensiModal = () => {
    document.getElementById('modalEditAbsensi').classList.replace('hidden', 'flex');
    renderEditAbsensiDates();
    toggleIzinReason(); // Pastikan kondisi form sesuai saat pertama dibuka
};

window.closeEditAbsensiModal = () => {
    document.getElementById('modalEditAbsensi').classList.replace('flex', 'hidden');
};

// Logika untuk menampilkan/menyembunyikan Keterangan Izin
window.toggleIzinReason = () => {
    const newStatus = document.getElementById('newStatusAbsensi').value;
    const containerReason = document.getElementById('containerAlasanIzin');

    if (newStatus === 'izin') {
        containerReason.classList.remove('hidden');
    } else {
        containerReason.classList.add('hidden');
    }
};

window.renderEditAbsensiDates = () => {
    const filter = document.getElementById('filterStatusAbsensi').value;
    const selectTanggal = document.getElementById('selectTanggalAbsensi');
    let dates = [];

    if (filter === 'hadir') dates = attendanceDetailGlobal.hadirDates || [];
    if (filter === 'izin') dates = attendanceDetailGlobal.izinDates || [];
    if (filter === 'alpa') dates = attendanceDetailGlobal.alpaDates || [];

    if (dates.length === 0) {
        selectTanggal.innerHTML = '<option value="">-- Tidak ada tanggal dengan status ini --</option>';
        selectTanggal.disabled = true;
    } else {
        selectTanggal.disabled = false;
        selectTanggal.innerHTML = dates.map(d => {
            const displayStatus = d.status.replace(/^izin_/i, '').replace(/_/g, ' ').toUpperCase();
            return `<option value="${d.date}">${d.date} (${displayStatus})</option>`;
        }).join('');
    }
};

window.saveEditAbsensi = async () => {
    const date = document.getElementById('selectTanggalAbsensi').value;
    let newStatus = document.getElementById('newStatusAbsensi').value;

    // Jika yang dipilih adalah izin, gabungkan status dengan keterangannya
    if (newStatus === 'izin') {
        const reason = document.getElementById('reasonIzinAbsensi').value;
        newStatus = `izin_${reason}`;
    }

    if (!date) return window.showToast?.('warning', 'Peringatan', 'Tidak ada tanggal yang dipilih.');

    // Loading UX
    const btn = document.querySelector('button[onclick="saveEditAbsensi()"]');
    const originalBtnText = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Menyimpan...';
    btn.disabled = true;

    try {
        const res = await fetch(`${API_URL}/api/students/${studentId}/attendance`, {
            method: 'PUT',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ date, newStatus })
        });

        if (!res.ok) throw new Error('Gagal memperbarui data absensi.');

        window.showToast?.('success', 'Berhasil', 'Absensi berhasil diperbarui.');
        closeEditAbsensiModal();

        // Refresh data di background
        await fetchData();

        // Buka ulang modal raport agar angka langsung update
        openRaportModal();
    } catch (error) {
        window.showToast?.('danger', 'Error', error.message);
    } finally {
        // Kembalikan tombol ke state awal
        btn.innerHTML = originalBtnText;
        btn.disabled = false;
    }
};

    window.goToStudent = (id) => {
        document.getElementById('studentSearchDropdown').classList.add('hidden');
        document.getElementById('studentSearchInput').value = '';
        if (String(id) !== String(studentId)) {
            window.location.href = `/student/${id}`;
        }
    };

    // Event listeners untuk search
    document.getElementById('studentSearchInput').addEventListener('input', (e) => {
        clearTimeout(searchDebounceTimer);
        const val = e.target.value;
        searchDebounceTimer = setTimeout(() => renderDropdown(val), 280);
    });

    document.getElementById('studentSearchInput').addEventListener('focus', (e) => {
        if (e.target.value.trim()) renderDropdown(e.target.value);
    });

    document.addEventListener('click', (e) => {
        // Logika tutup dropdown Quick Actions
        const btnActions = document.getElementById('btnQuickActions');
        const menuActions = document.getElementById('dropdownQuickActions');
        if (btnActions && menuActions && !btnActions.contains(e.target) && !menuActions.contains(e.target)) {
            menuActions.classList.add('hidden');
        }

        // Logika tutup dropdown Search Siswa
        const inputSearch = document.getElementById('studentSearchInput');
        const dropdownSearch = document.getElementById('studentSearchDropdown');
        if (inputSearch && dropdownSearch && !inputSearch.contains(e.target) && !dropdownSearch.contains(e.target)) {
            dropdownSearch.classList.add('hidden');
        }
    });

    // Panggil saat halaman load
    loadAllStudents();

    // ================================================================
    // TOGGLE STUDENT NAVIGATOR PANEL
    // ================================================================
    let navPanelOpen = false;

    window.toggleStudentNav = () => {
        const panel    = document.getElementById('studentNavPanel');
        const btn      = document.getElementById('btnToggleNav');
        const input    = document.getElementById('studentSearchInput');
        navPanelOpen   = !navPanelOpen;

        if (navPanelOpen) {
            panel.style.maxHeight  = '260px';
            panel.style.opacity    = '1';
            panel.style.marginTop  = '12px';
            btn.classList.remove('text-gray-400', 'bg-white', 'border-gray-100');
            btn.classList.add('text-green-600', 'bg-green-50', 'border-green-200');
            setTimeout(() => {
                panel.classList.remove('overflow-hidden');
                panel.classList.add('overflow-visible');
                input.focus();
            }, 320);
        } else {
            panel.classList.remove('overflow-visible');
            panel.classList.add('overflow-hidden');
            panel.style.maxHeight  = '0';
            panel.style.opacity    = '0';
            panel.style.marginTop  = '0';
            btn.classList.remove('text-green-600', 'bg-green-50', 'border-green-200');
            btn.classList.add('text-gray-400', 'bg-white', 'border-gray-100');
            document.getElementById('studentSearchDropdown').classList.add('hidden');
            input.value = '';
        }
    };

    let myChart = null;
    let attChart = null;
    let currentAvgRaw = 0;
    let lastRaportData = null;
    let attendanceStatsGlobal = { hadir: 0, izin: 0, alpa: 0 };
    let globalConsultations = null;
    let attendanceDetailGlobal = { izinDates: [], alpaDates: [] };
    let analisisAIGlobal = null;
    let globalProgressData = null;

    // ================================================================
    // DATA JUZ AMMA (Disusun mundur dari An-Nas ke An-Naba')
    // ================================================================
    const JUZ_AMMA = [
      { id: 1, name: "An-Nas", ayahs: 6 },
      { id: 2, name: "Al-Falaq", ayahs: 5 },
      { id: 3, name: "Al-Ikhlas", ayahs: 4 },
      { id: 4, name: "Al-Lahab", ayahs: 5 },
      { id: 5, name: "An-Nasr", ayahs: 3 },
      { id: 6, name: "Al-Kafirun", ayahs: 6 },
      { id: 7, name: "Al-Kausar", ayahs: 3 },
      { id: 8, name: "Al-Ma'un", ayahs: 7 },
      { id: 9, name: "Quraisy", ayahs: 4 },
      { id: 10, name: "Al-Fil", ayahs: 5 },
      { id: 11, name: "Al-Humazah", ayahs: 9 },
      { id: 12, name: "Al-'Asr", ayahs: 3 },
      { id: 13, name: "At-Takasur", ayahs: 8 },
      { id: 14, name: "Al-Qari'ah", ayahs: 11 },
      { id: 15, name: "Al-'Adiyat", ayahs: 11 },
      { id: 16, name: "Az-Zalzalah", ayahs: 8 },
      { id: 17, name: "Al-Bayyinah", ayahs: 8 },
      { id: 18, name: "Al-Qadr", ayahs: 5 },
      { id: 19, name: "Al-'Alaq", ayahs: 19 },
      { id: 20, name: "At-Tin", ayahs: 8 },
      { id: 21, name: "Al-Insyirah", ayahs: 8 },
      { id: 22, name: "Ad-Duha", ayahs: 11 },
      { id: 23, name: "Al-Lail", ayahs: 21 },
      { id: 24, name: "Asy-Syams", ayahs: 15 },
      { id: 25, name: "Al-Balad", ayahs: 20 },
      { id: 26, name: "Al-Fajr", ayahs: 30 },
      { id: 27, name: "Al-Gasyiyah", ayahs: 26 },
      { id: 28, name: "Al-A'la", ayahs: 19 },
      { id: 29, name: "At-Tariq", ayahs: 17 },
      { id: 30, name: "Al-Buruj", ayahs: 22 },
      { id: 31, name: "Al-Insyiqaq", ayahs: 25 },
      { id: 32, name: "Al-Mutaffifin", ayahs: 36 },
      { id: 33, name: "Al-Infitar", ayahs: 19 },
      { id: 34, name: "At-Takwir", ayahs: 29 },
      { id: 35, name: "Abasa", ayahs: 42 },
      { id: 36, name: "An-Nazi'at", ayahs: 46 },
      { id: 37, name: "An-Naba'", ayahs: 40 }
    ];

    // State hafalan
    let studentCheckpoint = { current_surah_id: null, current_ayah: 0 }; // diisi saat fetchData

    // [BARU] State foto raport
    let selectedFotoBase64 = null; // null = tidak pakai foto
    let selectedFotoUrl    = null;

    // --- CHARTS INIT ---
    const initChart = (history) => {
        const canvas = document.getElementById('progressChart');
        if (!canvas) return;
        if (myChart) myChart.destroy();

        // 1. Kumpulkan SEMUA minggu yang ada (Entah dia ngerjain mapel apa saja)
        const allWeeks = new Set([
            ...history.tajwid.map(i => i.week),
            ...history.fiqih.map(i => i.week),
            ...history.tauhid.map(i => i.week)
        ]);

        // 2. Urutkan minggu dari terkecil ke terbesar
        const sortedWeeks = Array.from(allWeeks).sort((a,b) => a-b);
        const labels = sortedWeeks.length > 0 ? sortedWeeks.map(w => `Mg-${w}`) : ['Mg-1'];

        // 3. Petakan data agar pas dengan sumbu X (Jika tidak ada nilai di minggu itu, jadikan null)
        const mapData = (arr) => sortedWeeks.map(w => {
            const found = arr.find(item => item.week === w);
            return found ? found.score : null;
        });

        myChart = new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Tajwid', data: mapData(history.tajwid), borderColor: '#22c55e', backgroundColor: '#22c55e22', tension: 0.4, fill: true },
                    { label: 'Fiqih', data: mapData(history.fiqih), borderColor: '#3b82f6', tension: 0.4 },
                    { label: 'Tauhid', data: mapData(history.tauhid), borderColor: '#a855f7', tension: 0.4 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { min: 0, max: 100 } },
                spanGaps: true // Sambung garis jika ada minggu yang bolong
            }
        });
    };

    window.closeReviewModal = () => document.getElementById('modalReview').classList.replace('flex', 'hidden');

    window.openReviewModal = async (subject, week) => {
    const modal = document.getElementById('modalReview');
    const container = document.getElementById('reviewContainer');
    const subtitle = document.getElementById('reviewSubtitle');

    modal.classList.replace('hidden', 'flex');
    container.innerHTML = '<div class="text-center py-10"><i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl"></i></div>';
    subtitle.innerText = `${subject.toUpperCase()} - MINGGU ${week}`;

    try {
        const res = await fetch(`${API_URL}/api/students/${studentId}/review/${subject}/${week}`, { headers: { 'Authorization': `Bearer ${token}` }});
        if (!res.ok) throw new Error('Gagal mengambil data review');
        const result = await res.json();
        const reviewData = result.data;

        if (!reviewData.questions || reviewData.questions.length === 0) {
            container.innerHTML = '<p class="text-xs text-gray-400 italic text-center py-8">Soal asli sudah dihapus atau tidak ditemukan.</p>';
            return;
        }

        // Parsing JSON dengan aman
        let studentAnswers = reviewData.result.student_answers;
        if (typeof studentAnswers === 'string') {
            try { studentAnswers = JSON.parse(studentAnswers);
            } catch(e) { studentAnswers = []; }
        }
        if (!Array.isArray(studentAnswers)) studentAnswers = [];
        const isLegacyData = studentAnswers.length === 0;

        // [PERBAIKAN LOGIKA]: Filter bank soal agar HANYA menampilkan soal yang dikerjakan anak (maks 6 soal)
        let filteredQuestions = reviewData.questions;
        if (!isLegacyData) {
            // Ambil semua ID soal yang benar-benar di-submit oleh anak
            const answeredIds = studentAnswers.map(a => String(a.question_id).trim());
            // Filter bank soal, sisakan hanya yang ID-nya ada di daftar answeredIds
            filteredQuestions = reviewData.questions.filter(q => answeredIds.includes(String(q.id).trim()));
        }

        // VARIABEL UNTUK MENGHITUNG STATISTIK
        let correctCount = 0;
        let wrongCount = 0;
        let emptyCount = 0;

        // 1. RENDER LIST SOAL SEKALIGUS MENGHITUNG STATISTIK (Gunakan filteredQuestions)
        const questionsHtml = filteredQuestions.map((q, idx) => {
            const type = q.type || 'pilgan';

            const ansObj = studentAnswers.find(a => String(a.question_id).trim() === String(q.id).trim());
            const studentAns = ansObj ? ansObj.answer : null;

            const safeStudentAns = studentAns ? String(studentAns).trim().toUpperCase() : '';
            const safeCorrectAns = q.correct_answer ? String(q.correct_answer).trim().toUpperCase() : '';

            let isCorrect = false;
            if (safeStudentAns && safeCorrectAns) {
                isCorrect = safeStudentAns === safeCorrectAns;
            }

            // Hitung Statistik jika bukan data legacy
            if (!isLegacyData) {
                if (!safeStudentAns) emptyCount++;
                else if (isCorrect) correctCount++;
                else wrongCount++;
            }

            let statusBadge = '';
            if (!isLegacyData) {
                statusBadge = isCorrect
                    ? `<span class="text-[9px] font-black bg-green-100 text-green-700 px-2 py-1 rounded shadow-sm border border-green-200"><i class="fa-solid fa-check mr-1"></i> BENAR</span>`
                    : `<span class="text-[9px] font-black bg-red-100 text-red-600 px-2 py-1 rounded shadow-sm border border-red-200"><i class="fa-solid fa-xmark mr-1"></i> SALAH</span>`;
            }

            let optionsHtml = '';
            if (type === 'tf' || type === 'pilgan') {
                const opts = Object.entries(q.options || {});
                optionsHtml = `<div class="grid grid-cols-1 gap-2 mt-3">` + opts.map(([k, v]) => {
                    const safeK = String(k).trim().toUpperCase();
                    const isStudentChoice = safeStudentAns === safeK;
                    const isTheCorrectKey = safeCorrectAns === safeK;

                    let optClass = "p-3 rounded-xl border flex items-center justify-between text-xs font-medium transition-all ";
                    let iconHtml = "";

                    if (isLegacyData) {
                        optClass += "bg-white border-gray-100 text-gray-600";
                    } else {
                        if (isStudentChoice && isTheCorrectKey) {
                            optClass += "bg-green-50 border-green-300 text-green-800 shadow-sm";
                            iconHtml = `<i class="fa-solid fa-check-circle text-green-500 text-lg"></i>`;
                        } else if (isStudentChoice && !isTheCorrectKey) {
                            optClass += "bg-red-50 border-red-300 text-red-800 shadow-sm opacity-90";
                            iconHtml = `<i class="fa-solid fa-circle-xmark text-red-500 text-lg"></i>`;
                        } else if (!isStudentChoice && isTheCorrectKey) {
                            optClass += "bg-green-50/30 border-green-200 text-green-700 border-dashed";
                            iconHtml = `<i class="fa-solid fa-check text-green-400 text-lg"></i>`;
                        } else {
                            optClass += "bg-white border-gray-100 text-gray-400 opacity-60";
                        }
                    }

                    const keyLabel = type === 'tf' ? (safeK === 'A' ? 'BENAR' : 'SALAH') : safeK;
                    const badgeColor = isLegacyData ? 'bg-gray-100 text-gray-400' : (isTheCorrectKey ? 'bg-green-200 text-green-700' : isStudentChoice ? 'bg-red-200 text-red-700' : 'bg-gray-100 text-gray-400');

                    return `<div class="${optClass}"><div class="flex items-center gap-3"><span class="w-6 h-6 rounded-full flex items-center justify-center font-black ${badgeColor} shrink-0">${keyLabel}</span><span>${v}</span></div>${iconHtml}</div>`;
                }).join('') + `</div>`;
            } else if (type === 'drag') {
                const expectedKeys = safeCorrectAns.split(',');
                const answeredKeys = safeStudentAns.split(',');
                let blankIdx = 0;

                const questionWithAnswers = (q.question || '').replace(/\[BLANK\]/g, () => {
                    const correctKey = expectedKeys[blankIdx] ? expectedKeys[blankIdx].trim() : null;
                    const studentKey = answeredKeys[blankIdx] ? answeredKeys[blankIdx].trim() : null;

                    let correctVal = '(kosong)';
                    let studentVal = '(kosong)';

                    if (q.options) {
                        const originalCorrectKey = Object.keys(q.options).find(k => k.toUpperCase() === correctKey);
                        if (originalCorrectKey) correctVal = q.options[originalCorrectKey];

                        const originalStudentKey = Object.keys(q.options).find(k => k.toUpperCase() === studentKey);
                        if (originalStudentKey) studentVal = q.options[originalStudentKey];
                    }

                    const isSlotCorrect = correctKey === studentKey;

                    let html = '';
                    if (isLegacyData) {
                        html = `<span class="inline-block px-2 py-1 mx-1 bg-gray-100 text-gray-400 border border-gray-200 rounded shadow-sm text-[10px] font-black">[ KOLOM JAWABAN ]</span>`;
                    } else {
                        if (!studentKey) {
                           html = `<span class="inline-flex items-center gap-1 mx-1 align-middle"><span class="inline-block px-2 py-1 bg-red-50 text-red-600 border border-red-200 rounded shadow-sm text-[10px] font-bold opacity-80">(Kosong)</span><i class="fa-solid fa-arrow-right text-gray-300 text-[8px]"></i><span class="inline-block px-2 py-1 bg-green-100 text-green-700 border border-green-300 rounded shadow-sm text-[10px] font-black">${correctVal}</span></span>`;
                        } else if (isSlotCorrect) {
                            html = `<span class="inline-block px-2 py-1 mx-1 bg-green-100 text-green-700 border border-green-300 rounded shadow-sm text-[10px] font-black"><i class="fa-solid fa-check mr-1"></i>${correctVal}</span>`;
                        } else {
                            html = `<span class="inline-flex items-center gap-1 mx-1 align-middle"><span class="inline-block px-2 py-1 bg-red-50 text-red-600 border border-red-200 rounded shadow-sm text-[10px] font-bold line-through opacity-80">${studentVal}</span><i class="fa-solid fa-arrow-right text-gray-300 text-[8px]"></i><span class="inline-block px-2 py-1 bg-green-100 text-green-700 border border-green-300 rounded shadow-sm text-[10px] font-black">${correctVal}</span></span>`;
                        }
                    }
                    blankIdx++;
                    return html;
                });

                optionsHtml = `<div class="mt-3 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 shadow-inner"><p class="text-xs font-bold text-gray-800 leading-loose">${questionWithAnswers}</p></div>`;
                if (isLegacyData) {
                    const dragOpts = `<div class="flex flex-wrap gap-2 mt-3">` + Object.entries(q.options || {}).map(([k, v]) => `<span class="px-3 py-1.5 bg-white border border-indigo-100 text-indigo-600 text-[10px] font-bold rounded-lg shadow-sm">${v}</span>`).join('') + `</div>`;
                    optionsHtml += dragOpts;
                }
            }

            let insightHtml = '';
            if (isLegacyData) {
                insightHtml = `<div class="mt-3 bg-gray-50 p-3 rounded-xl border border-gray-200 flex items-start gap-2"><i class="fa-solid fa-clock-rotate-left text-gray-400 mt-0.5"></i><div class="flex-1"><p class="text-[10px] font-bold text-gray-600 leading-relaxed mb-0.5">Menampilkan soal yang diujikan di pertemuan ini.</p><p class="text-[9px] text-gray-400 font-medium">Fitur perekaman riwayat jawaban (Benar/Salah) belum tersedia saat anak mengerjakan ujian ini.</p></div></div>`;
            } else if (!studentAns) {
                insightHtml = `<div class="mt-3 bg-red-50 p-3 rounded-xl border border-red-100 flex items-start gap-2"><i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5"></i><div class="flex-1"><p class="text-[10px] font-bold text-red-800 leading-relaxed">Anak tidak menjawab soal ini (Dikosongkan).</p></div></div>`;
            } else if (isCorrect) {
                insightHtml = `<div class="mt-3 bg-green-50 p-3 rounded-xl border border-green-100 flex items-start gap-2"><i class="fa-solid fa-lightbulb text-green-500 mt-0.5"></i><p class="text-[10px] font-bold text-green-800 leading-relaxed">Hebat! Jawaban anak sudah tepat.</p></div>`;
            } else {
                let correctAnswerText = '';
                if (type === 'drag') {
                    correctAnswerText = 'Perhatikan urutan kata yang benar pada panah hijau di atas.';
                } else if (type === 'tf') {
                    correctAnswerText = safeCorrectAns === 'A' ? 'BENAR' : 'SALAH';
                } else {
                    const origKey = Object.keys(q.options || {}).find(k => k.toUpperCase() === safeCorrectAns);
                    correctAnswerText = origKey ? q.options[origKey] : q.correct_answer;
                }

                insightHtml = `<div class="mt-3 bg-amber-50 p-3 rounded-xl border border-amber-100 flex items-start gap-2"><i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5"></i><div class="flex-1"><p class="text-[10px] font-bold text-amber-800 leading-relaxed mb-1">Kurang tepat. Coba lebih teliti lagi ya.</p><p class="text-[10px] text-amber-700 font-medium">Kunci Jawaban: <b class="font-black text-amber-900">${correctAnswerText}</b></p></div></div>`;
            }

            const badgeTipe = type === 'tf' ? '(Benar/Salah)' : type === 'drag' ? '(Drag & Drop)' : '(Pilihan Ganda)';
            const sideBorder = isLegacyData ? 'bg-gray-300' : (!isCorrect ? 'bg-red-400' : 'bg-green-400');

            return `
            <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1 ${sideBorder}"></div>
                <div class="flex justify-between items-start mb-2 pl-2">
                    <span class="text-[10px] font-bold text-gray-400">SOAL ${idx + 1} <span class="text-gray-300 ml-1">${badgeTipe}</span></span>
                    ${statusBadge}
                </div>
                <p class="text-sm font-bold text-gray-800 leading-relaxed pl-2">${type === 'drag' ? 'Lengkapi kalimat rumpang di bawah:' : q.question}</p>
                ${optionsHtml}
                ${insightHtml}
            </div>`;
        }).join('');

        // 2. BUILD SUMMARY CARD DENGAN PESAN MOTIVASI
        const score = reviewData.result.score || 0;
        const timeTaken = reviewData.result.time_taken ? `${reviewData.result.time_taken} dtk` : '-';

        let msgText = ""; let msgColor = ""; let msgIcon = "";
        if (score >= 90) {
            msgText = "Masya Allah, sempurna! Kemampuan anak ini sangat luar biasa. Pertahankan ya!";
            msgColor = "green"; msgIcon = "fa-star";
        } else if (score >= 70) {
            msgText = "Alhamdulillah, nilai yang bagus! Tinggal sedikit lagi dorongan agar bisa maksimal.";
            msgColor = "blue"; msgIcon = "fa-thumbs-up";
        } else {
            msgText = "Tetap semangat! Jadikan ini pelajaran berharga agar anak lebih teliti lagi ke depannya.";
            msgColor = "amber"; msgIcon = "fa-hand-holding-heart";
        }

        const summaryHtml = `
            <div class="bg-white p-4 rounded-3xl border border-gray-100 shadow-sm mb-2">
                <div class="grid grid-cols-3 gap-2 mb-4 text-center">
                    <div class="bg-${msgColor}-50 p-2 rounded-2xl border border-${msgColor}-100 flex flex-col justify-center">
                        <p class="text-[9px] text-${msgColor}-600 font-bold uppercase tracking-widest mb-1">Skor Akhir</p>
                        <p class="text-2xl font-black text-${msgColor}-700">${score}</p>
                    </div>
                    <div class="bg-gray-50 p-2 rounded-2xl border border-gray-200 flex flex-col justify-center">
                        <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-1">Statistik</p>
                        <p class="text-xs font-black text-gray-800 mt-1 leading-tight">
                            ${isLegacyData ? '-' : `<span class="text-green-600">${correctCount} B</span> / <span class="text-red-500">${wrongCount} S</span><br><span class="text-gray-400 text-[10px]">${emptyCount} Kosong</span>`}
                        </p>
                    </div>
                    <div class="bg-gray-50 p-2 rounded-2xl border border-gray-200 flex flex-col justify-center">
                        <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-1">Waktu</p>
                        <p class="text-sm font-black text-gray-800 mt-1">${timeTaken}</p>
                    </div>
                </div>
                <div class="bg-${msgColor}-50/50 p-3 rounded-xl border border-${msgColor}-100 flex gap-3 items-center">
                    <div class="w-8 h-8 rounded-full bg-${msgColor}-100 text-${msgColor}-600 flex items-center justify-center shrink-0">
                        <i class="fa-solid ${msgIcon}"></i>
                    </div>
                    <p class="text-[10px] font-bold text-${msgColor}-800 leading-relaxed">${msgText}</p>
                </div>
            </div>
        `;

        // 3. GABUNGKAN SUMMARY CARD + LIST SOAL KE DALAM CONTAINER
        container.innerHTML = summaryHtml + questionsHtml;

    } catch (error) {
        container.innerHTML = `<div class="text-center py-8"><p class="text-xs text-red-500 font-bold">${error.message}</p></div>`;
    }
};


