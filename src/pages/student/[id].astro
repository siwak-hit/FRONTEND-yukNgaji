    window.setorHafalan = async (jumlah) => {
        try {
            const res = await fetch(`${API_URL}/api/students/${studentId}/memorization`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: studentId, added_ayahs: jumlah })
            });
            const result = await res.json();
            if (!res.ok) throw new Error(result.message || 'Gagal');

            studentCheckpoint.current_surah_id = result.data.current_surah_id;
            studentCheckpoint.current_ayah     = result.data.current_ayah;

            renderCheckpointBadge();
            closeHafalanModal();

            let msg;
            if (result.data.promoted) {
                msg = result.data.next_surah === 'KHATAM JUZ AMMA 🎉'
                    ? `MASYA ALLAH! ${result.data.prev_surah} tamat! JUZ AMMA KHATAM! 🎉🎉🎉`
                    : `Masya Allah! Tamat ${result.data.prev_surah}! Lanjut → ${result.data.next_surah} 🎉`;
            } else if (result.data.demoted) {
                msg = `Dikoreksi mundur ke ${result.data.next_surah}, ayat ${result.data.current_ayah}.`;
            } else {
                msg = jumlah > 0
                    ? `+${jumlah} ayat tercatat! Semangat! 💪`
                    : `Koreksi −${Math.abs(jumlah)} ayat tersimpan.`;
            }
            window.showToast?.('success', jumlah > 0 ? 'Hafalan Dicatat' : 'Koreksi Disimpan', msg);
        } catch (err) {
            window.showToast?.('danger', 'Error', err.message || 'Gagal mencatat hafalan.');
        }
    };

    // ================================================================
    // HAFALAN — MODE MAJU/MUNDUR di modal harian
    // ================================================================
    let currentHafalanMode = 'maju';

    window.setHafalanMode = (mode) => {
        currentHafalanMode = mode;
        const isMaju = mode === 'maju';

        document.getElementById('tabMaju').className   = isMaju ? 'seg-btn is-active' : 'seg-btn';
        document.getElementById('tabMundur').className = !isMaju ? 'seg-btn is-active' : 'seg-btn';

        document.getElementById('sectionMaju').classList.toggle('hidden', !isMaju);
        document.getElementById('sectionMundur').classList.toggle('hidden', isMaju);
    };

    // ================================================================
    // PATCH generateSystemNote — suntikkan checkpoint ke prompt AI
    // ================================================================
    // (Ganti fungsi generateSystemNote yang sudah ada)


    window.generateSystemNote = async () => {
        const name = document.getElementById('rapName').value;
        const btn  = document.querySelector('button[onclick="generateSystemNote()"]');

        // Terjemahkan checkpoint ke teks
        const surah = getSurahById(studentCheckpoint.current_surah_id);
        const checkpointText = surah
            ? `Pencapaian Hafalan: Surah ${surah.name}, Ayat ${studentCheckpoint.current_ayah} dari ${surah.ayahs}`
            : 'Pencapaian Hafalan: belum diset';

        const academicBreakdown = buildAcademicBreakdown();

        const payload = {
            studentName: name,
            academic: {
                tajwid: document.getElementById('rapTajwid').value,
                fiqih: document.getElementById('rapFiqih').value,
                tauhid: document.getElementById('rapTauhid').value,
                quran: document.getElementById('rapQuran').value
            },
            behavior: {
                kedisiplinan: document.getElementById('rapSikap1').value,
                akhlak: document.getElementById('rapSikap2').value,
                keaktifan: document.getElementById('rapSikap3').value
            },
            checkpointText,
            academicBreakdown
        };

        try {
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Loading...';
            const res = await fetch(`${API_URL}/api/raports/generate-note`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (res.ok) {
                document.getElementById('rapNote').value = result.data;
                analisisAIGlobal = result.analisis || null;
            }
        } catch (e) { console.error(e); }
        finally { btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Generate AI'; }
    };

    // ================================================================
    // DETEKSI ANAK TERTINGGAL — Banner di Tab Tugas AI
    // ================================================================
    const renderLagBanner = (lagData) => {
        document.getElementById('lagBanner')?.remove();

        const SUBJECT_LABEL = { tajwid: 'Tajwid', fiqih: 'Fiqih', tauhid: 'Tauhid' };
        const laggingSubjects = Object.entries(lagData)
            .filter(([, v]) => v.missedWeeks && v.missedWeeks.length > 0)
            .map(([subject, v]) => ({ subject, ...v }));

        if (laggingSubjects.length === 0) return;

        const banner = document.createElement('div');
        banner.id = 'lagBanner';
        banner.className = 'mb-4 bg-amber-50 border border-amber-200 rounded-2xl p-4 space-y-3 shadow-sm';

        const itemsHtml = laggingSubjects.map(({ subject, classWeek, studentWeek, missedWeeks }) => {
            const missedLabel = missedWeeks.slice(0, 3).map(w => `Mg-${w}`).join(', ');
            const moreCount   = missedWeeks.length > 3 ? ` +${missedWeeks.length - 3} lagi` : '';

            const targetWeek = missedWeeks[0];
            const isPR = window.prLocksCache[subject]?.includes(targetWeek);

            // [BARU] Logika Pembeda Ujian Kelas & PR Rumah
            let actionHtml = '';
            if (isPR) {
                actionHtml = `
                    <div class="mt-2 w-full p-2 bg-indigo-50 border border-indigo-100 rounded-lg flex items-start gap-2 shadow-sm">
                        <div class="w-6 h-6 rounded-md bg-indigo-100 text-indigo-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-house-laptop text-[10px]"></i>
                        </div>
                        <p class="text-[9px] text-indigo-700 font-bold leading-relaxed">
                            Tugas Mg-${targetWeek} adalah <span class="bg-indigo-500 text-white px-1 py-0.5 rounded shadow-sm uppercase tracking-widest text-[7px]">PR 🏠</span>. Siswa harus mengerjakannya sendiri melalui link yang ada di grup WA.
                        </p>
                    </div>`;
            } else {
                actionHtml = `
                    <button onclick="openSusulanModal('${subject}', ${JSON.stringify(missedWeeks)})"
                        class="mt-2 w-full py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-[10px] font-bold rounded-lg active:scale-95 transition-all shadow-sm">
                        <i class="fa-solid fa-graduation-cap mr-1"></i> Berikan Ujian Susulan Mg-${targetWeek}
                    </button>`;
            }

            return `
                <div class="bg-white rounded-xl p-3 border border-amber-100">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-black text-amber-700 uppercase">${SUBJECT_LABEL[subject]}</span>
                        <span class="text-[9px] font-bold bg-amber-100 text-amber-600 px-2 py-0.5 rounded-full">
                            Kelas: Mg-${classWeek} | Anak: Mg-${studentWeek || '0'}
                        </span>
                    </div>
                    <p class="text-[10px] text-gray-600 leading-relaxed">
                        Belum ujian pertemuan: <b class="text-amber-700">${missedLabel}${moreCount}</b>
                    </p>
                    ${actionHtml}
                </div>`;
        }).join('');

        banner.innerHTML = `
            <div class="flex items-center gap-2 mb-1">
                <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                <p class="text-xs font-black text-amber-800 uppercase tracking-wide">Anak Ini Tertinggal!</p>
            </div>
            ${itemsHtml}`;

        const todoContainer = document.getElementById('todoContainer');
        todoContainer.parentElement.insertBefore(banner, todoContainer);
    };

    // ================================================================
    // MODAL UJIAN SUSULAN (trigger dari banner)
    // ================================================================
    let pendingSusulanUrl = ''; // Variabel sementara untuk menyimpan URL tujuan

    window.openSusulanModal = (subject, missedWeeks) => {
        const targetWeek = missedWeeks[0];

        // 1. Update teks di dalam modal agar dinamis
        const msgEl = document.getElementById('susulanMessage');
        msgEl.innerHTML = `Buka halaman ujian susulan <b>${subject.toUpperCase()}</b> untuk <b>Pertemuan ${targetWeek}</b>?`;

        // 2. Simpan URL tujuan
        pendingSusulanUrl = `/consultations/fill?id=${studentId}&subject=${subject}&week=${targetWeek}`;

        // 3. Tampilkan modal
        document.getElementById('modalSusulan').classList.replace('hidden', 'flex');
    };

    window.closeSusulanModal = () => {
        document.getElementById('modalSusulan').classList.replace('flex', 'hidden');
        pendingSusulanUrl = ''; // Bersihkan memori
    };

    document.getElementById('btnConfirmSusulan').onclick = () => {
        // Tombol berubah jadi loading sebentar biar kerasa responsif
        const btn = document.getElementById('btnConfirmSusulan');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Membuka...';
        btn.classList.add('opacity-80', 'pointer-events-none');

        // Pindah halaman
        if (pendingSusulanUrl) window.location.href = pendingSusulanUrl;
    };

    // ================================================================
    // LOGIKA MUROJAAH KHUSUS (Sistem Level & Filter Surat)
    // ================================================================

    const MUROJAAH_PACKAGES = [
        {
            id: 1,
            name: "Level 1 (An-Nas - Al-Qari'ah)",
            targets: [
                "An-Nas",
                "Al-Falaq",
                "Al-Ikhlas",
                "Al-Lahab",
                "An-Nasr",
                "Al-Kafirun",
                "Al-Kausar",
                "Al-Ma'un",
                "Quraisy",
                "Al-Fil",
                "Al-Humazah",
                "Al-'Asr",
                "At-Takasur",
                "Al-Qari'ah"
            ]
        },
        {
            id: 2,
            name: "Level 2 (Al-'Adiyat - Al-Gasyiyah)",
            targets: [
                "Al-'Adiyat",
                "Az-Zalzalah",
                "Al-Bayyinah",
                "Al-Qadr",
                "Al-'Alaq",
                "At-Tin",
                "Al-Insyirah",
                "Ad-Duha",
                "Al-Lail",
                "Asy-Syams",
                "Al-Balad",
                "Al-Fajr",
                "Al-Gasyiyah"
            ]
        },
        {
            id: 3,
            name: "Level 3 (Al-A'la - An-Naba')",
            targets: [
                "Al-A'la",
                "At-Tariq",
                "Al-Buruj",
                "Al-Insyiqaq",
                "Al-Mutaffifin",
                "Al-Infitar",
                "At-Takwir",
                "Abasa",
                "An-Nazi'at",
                "An-Naba'"
            ]
        }
    ];

    // Simpan data riwayat hafalan secara global buat dipakai pas ganti level
    let globalCompletedMurojaah = [];

    window.openMurojaahDrawer = async () => {
        document.getElementById('dropdownQuickActions')?.classList.add('hidden');

        const drawer = document.getElementById('drawerMurojaah');
        const selectSurah = document.getElementById('murojaahSurahSelect');
        const selectLevel = document.getElementById('murojaahLevelSelect');

        drawer.classList.replace('hidden', 'flex');

        selectSurah.innerHTML = '<option value="">⏳ Mengecek riwayat hafalan...</option>';
        selectSurah.disabled = true;

        try {
            // Isi Dropdown Level
            selectLevel.innerHTML = MUROJAAH_PACKAGES.map(pkg =>
                `<option value="${pkg.id}">${pkg.name}</option>`
            ).join('');

            // Ambil riwayat dari Backend
            const res = await fetch(`${API_URL}/api/students/${studentId}/memorization-logs`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const json = await res.json();
            const logs = json.data || [];

            // Simpan ke variabel global
            globalCompletedMurojaah = logs.map(log => log.surah_name);

            // Render opsi surat berdasarkan level 1 (default)
            renderMurojaahSurahs();

        } catch (e) {
            console.error(e);
            selectSurah.innerHTML = '<option value="">Gagal memuat riwayat.</option>';
        }
    };

    // Fungsi untuk merender ulang opsi surat tiap kali level diganti
    window.renderMurojaahSurahs = () => {
        const selectLevel = document.getElementById('murojaahLevelSelect');
        const selectSurah = document.getElementById('murojaahSurahSelect');

        const activePackage = MUROJAAH_PACKAGES.find(pkg => pkg.id === parseInt(selectLevel.value));

        selectSurah.innerHTML = '<option value="" disabled selected>-- Ketuk untuk Memilih Surat --</option>';
        selectSurah.disabled = false;

        activePackage.targets.forEach(surah => {
            const isDone = globalCompletedMurojaah.includes(surah);

            if (isDone) {
                selectSurah.innerHTML += `<option value="${surah}" disabled class="bg-gray-100 text-gray-400 italic">✅ ${surah} (Selesai)</option>`;
            } else {
                selectSurah.innerHTML += `<option value="${surah}" class="text-gray-800 font-bold">📖 ${surah}</option>`;
            }
        });
    };

    window.closeMurojaahDrawer = () => {
        document.getElementById('drawerMurojaah').classList.replace('flex', 'hidden');
    };

    window.submitMurojaah = async () => {
        const select = document.getElementById('murojaahSurahSelect');
        const surah = select.value;

        if (!surah) {
            window.showToast?.('warning', 'Pilih Surat', 'Silakan pilih target suratnya dulu ustadz.');
            return;
        }

        const targetSurahObj = JUZ_AMMA.find(s => s.name === surah);
        const totalAyahs = targetSurahObj ? targetSurahObj.ayahs : 1;

        const btn = document.getElementById('btnSubmitMurojaah');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
        btn.disabled = true;

        try {
            const res = await fetch(`${API_URL}/api/students/${studentId}/murojaah`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    surah_name: surah,
                    total_ayahs: totalAyahs
                })
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || 'Gagal simpan');
            }

            window.showToast?.('success', 'Berhasil', `Murojaah surat ${surah} berhasil dicatat!`);
            closeMurojaahDrawer();
            fetchData();

        } catch(e) {
            window.showToast?.('danger', 'Error', e.message);
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    };

    // ================================================================
    // LOGIKA DRAWER DETAIL NILAI (TRANSPARANSI)
    // ================================================================
    window.openSubjectDetailDrawer = (subject) => {
        const drawer = document.getElementById('drawerSubjectDetail');
        const titleEl = document.getElementById('detailSubjectTitle');
        const avgEl = document.getElementById('detailSubjectAvg');
        const formulaEl = document.getElementById('detailSubjectFormula');
        const listEl = document.getElementById('detailSubjectList');

        // Setup Warna & Teks Berdasarkan Mapel
        const config = {
            'tajwid': { text: 'text-green-600', bg: 'bg-green-50', icon: 'text-green-500', title: 'Tajwid' },
            'fiqih':  { text: 'text-blue-600', bg: 'bg-blue-50', icon: 'text-blue-500', title: 'Fiqih' },
            'tauhid': { text: 'text-purple-600', bg: 'bg-purple-50', icon: 'text-purple-500', title: 'Tauhid' }
        };

        const conf = config[subject];
        titleEl.innerHTML = `<i class="fa-solid fa-calculator ${conf.icon} mr-2"></i> Detail ${conf.title}`;
        avgEl.className = `text-5xl font-black mb-3 ${conf.text}`;

        let dataArr = [];
        if (globalProgressData && globalProgressData[subject]) {
            dataArr = globalProgressData[subject];
        }

        // Kalau datanya kosong
        if (dataArr.length === 0) {
            avgEl.innerText = '-';
            formulaEl.innerText = 'Belum ada nilai yang masuk.';
            listEl.innerHTML = '<p class="text-center text-xs text-gray-400 py-4 font-bold">Belum ada riwayat pertemuan.</p>';
            drawer.classList.replace('hidden', 'flex');
            return;
        }

        // Urutkan berdasarkan pertemuan
        dataArr.sort((a, b) => a.week - b.week);

        let totalScore = 0;
        let scoreStrings = [];
        let listHtml = '';

        dataArr.forEach(item => {
            const sc = item.score || 0;
            totalScore += sc;
            scoreStrings.push(sc);

            listHtml += `
                <div class="flex justify-between items-center bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
                    <span class="text-xs font-bold text-gray-600">Pertemuan ${item.week}</span>
                    <span class="text-sm font-black ${conf.text} ${conf.bg} px-3 py-1 rounded-lg border border-gray-50">${sc}</span>
                </div>
            `;
        });

        // Hitung rata-rata pakai Math.round biar presisi
        const avg = Math.round(totalScore / dataArr.length);

        avgEl.innerText = avg;
        formulaEl.innerText = `( ${scoreStrings.join(' + ')} ) / ${dataArr.length} Pertemuan = ${avg}`;
        listEl.innerHTML = listHtml;

        drawer.classList.replace('hidden', 'flex');
    };

    window.closeSubjectDetailDrawer = () => {
        document.getElementById('drawerSubjectDetail').classList.replace('flex', 'hidden');
    };

    fetchData(); // Pastikan ini tetap ada di paling bawah
</script>

<style>
    /* Animasi untuk Drawer (laci iOS) */
    @keyframes slideUpDrawer {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }
    .animate-slide-up-drawer {
        animation: slideUpDrawer 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
