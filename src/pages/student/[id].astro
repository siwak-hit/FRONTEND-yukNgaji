    // ================================================================
    // HELPER PDF: gambar satu tabel dengan header & baris data
    // col: [{ label, x, w }] — row: string[]
    // Kembalikan curY setelah tabel selesai
    // ================================================================
    const drawTable = (doc, curY, cols, rows, rowH = 8) => {
        const margin    = 15;
        const totalW    = cols.reduce((s, c) => s + c.w, 0);

        // Header
        doc.setFillColor(220, 220, 220);
        cols.forEach(c => doc.rect(c.x, curY, c.w, rowH, 'F'));
        doc.rect(margin, curY, totalW, rowH); // outer border
        cols.slice(1).forEach(c => doc.line(c.x, curY, c.x, curY + rowH)); // vertical dividers
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8);
        cols.forEach(c => doc.text(c.label, c.x + c.w / 2, curY + rowH / 2 + 1.5, { align: 'center' }));
        curY += rowH;

        // Rows
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
        rows.forEach((cells, idx) => {
            if (idx % 2 === 0) { doc.setFillColor(250, 250, 250); cols.forEach(c => doc.rect(c.x, curY, c.w, rowH, 'F')); }
            doc.rect(margin, curY, totalW, rowH);
            cols.slice(1).forEach(c => doc.line(c.x, curY, c.x, curY + rowH));
            cells.forEach((txt, i) => {
                const align = i === 0 ? 'left' : 'center';
                const xPos  = i === 0 ? cols[i].x + 3 : cols[i].x + cols[i].w / 2;
                doc.text(String(txt ?? '-'), xPos, curY + rowH / 2 + 1.5, { align });
            });
            curY += rowH;
        });

        return curY;
    };

    // ================================================================
    // PDF GENERATOR
    // ================================================================
    const generatePdfWithJsPDF = async (payload, studentName) => {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });

        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();

        const margin = 15;
        const contentW = pageW - margin * 2;
        const today    = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        // Checkpoint hafalan untuk PDF
        const pdfSurah = getSurahById(studentCheckpoint.current_surah_id);
        const checkpointLabel = pdfSurah
            ? `${pdfSurah.name}, Ayat ${studentCheckpoint.current_ayah} / ${pdfSurah.ayahs}`
            : 'Belum diset';

        // ---- HEADER ----
        doc.setFont('helvetica', 'bold'); doc.setFontSize(14);
        doc.text('MUSHOLA NURUL HIDAYAH', pageW / 2, 20, { align: 'center' });
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
        doc.text('Pengajian Perumahan Bumi Rahayu 5 - Bekasi', pageW / 2, 26, { align: 'center' });
        doc.setLineWidth(0.5);
        doc.line(margin, 30, pageW - margin, 30);

// ---- NAMA & TANGGAL ----
doc.setFontSize(10);

        // Nama rata kiri (Y = 38)
        doc.text('Nama', margin, 38);
        doc.text(`: ${studentName}`, margin + 15, 38);

        // Tanggal rata kanan di baris yang sama (Y = 38)
        doc.text(`Tanggal: ${today}`, pageW - margin, 38, { align: 'right' });

        // Pencapaian Hafalan tepat di bawah nama (Y = 44)
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
        doc.text(`Pencapaian Hafalan : ${checkpointLabel}`, margin, 44);

        // curY diturunkan ke 52 sebagai titik awal tabel & foto (biar tidak nabrak teks hafalan)
        let curY = 52;

        // ---- A. AKADEMIK & FOTO (Posisi Samping Tabel) ----

        const makeCoverImageDataUrl = (base64Src, targetWidthPx = 300, targetHeightPx = 400) => {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    canvas.width = targetWidthPx;
                    canvas.height = targetHeightPx;

                    const ctx = canvas.getContext('2d');
                    if (!ctx) {
                        reject(new Error('Canvas context gagal dibuat.'));
                        return;
                    }

                    const imgW = img.naturalWidth;
                    const imgH = img.naturalHeight;

                    const scale = Math.max(targetWidthPx / imgW, targetHeightPx / imgH);

                    const drawW = imgW * scale;
                    const drawH = imgH * scale;

                    const dx = (targetWidthPx - drawW) / 2;
                    const dy = (targetHeightPx - drawH) / 2;

                    // background putih biar rapi
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, targetWidthPx, targetHeightPx);

                    // gambar di-crop dari tengah
                    ctx.drawImage(img, dx, dy, drawW, drawH);

                    resolve(canvas.toDataURL('image/jpeg', 0.92));
                };

                img.onerror = () => reject(new Error('Gagal memproses foto untuk PDF.'));
                img.src = base64Src;
            });
        };
        const fotoW = 30;
        const fotoH = 40;
        const fotoX = pageW - margin - fotoW;
        const fotoY = curY + 6;

        // crop cover dulu
        let pdfPhotoBase64 = null;
        if (selectedFotoBase64) {
            pdfPhotoBase64 = await makeCoverImageDataUrl(selectedFotoBase64, 300, 400);
        }

        if (pdfPhotoBase64) {
            // gambar hasil crop cover langsung full ke frame
            doc.addImage(pdfPhotoBase64, 'JPEG', fotoX, fotoY, fotoW, fotoH);

            // border frame
            doc.setLineWidth(0.3);
            doc.rect(fotoX, fotoY, fotoW, fotoH);
        }

        // Bila ada foto, sempitkan lebar tabel agar tidak menabrak foto
        const tblW = selectedFotoBase64 ? contentW - fotoW - 5 : contentW;

        const colAkd = [
            { label: 'Mata Pelajaran', x: margin,                  w: tblW * 0.34 },
            { label: 'Tugas',          x: margin + tblW * 0.34,    w: tblW * 0.14 },
            { label: 'Ujian',          x: margin + tblW * 0.48,    w: tblW * 0.14 },
            { label: 'Lisan',          x: margin + tblW * 0.62,    w: tblW * 0.14 },
            { label: 'Akhir',          x: margin + tblW * 0.76,    w: tblW * 0.24 }
        ];

        const bd = payload.academic_breakdown || {};

        const formatOral = (value) => {
            return value === null || value === undefined ? '-' : String(value);
        };

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(11);
        doc.text('A. PENCAPAIAN AKADEMIK', margin, curY);
        curY += 6;

        curY = drawTable(doc, curY, colAkd, [
            [
                'Tajwid',
                String(bd.tajwid?.weekly ?? 0),
                formatOral(bd.tajwid?.exam),
                formatOral(bd.tajwid?.oral),
                `${bd.tajwid?.final_score ?? '-'} (${payload.academic_grades.tajwid})`
            ],
            [
                'Fiqih',
                String(bd.fiqih?.weekly ?? 0),
                formatOral(bd.fiqih?.exam),
