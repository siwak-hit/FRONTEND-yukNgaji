            // 2. Kumpulkan dari Jepretan Ujian Anti-Cheat
            const fotoUjian = (typeof studentExamResults !== 'undefined' ? studentExamResults : []).filter(e => e.capture_url).map(e => e.capture_url);

            // 3. Kumpulkan dari Galeri Gaya Bebas
            let fotoGaleri = [];
            try {
                const resGaleri = await fetch(`${API_URL}/api/students/${studentId}/gallery`, { headers: { 'Authorization': `Bearer ${token}` }});
                if (resGaleri.ok) fotoGaleri = ((await resGaleri.json()).data || []).map(g => g.image_url);
            } catch (err) {}

            // 4. [BARU] Kumpulkan dari Kamera Satpam PR
            let fotoSatpam = [];
            try {
                const resSatpam = await fetch(`${API_URL}/api/students/${studentId}/satpam-logs`, { headers: { 'Authorization': `Bearer ${token}` }});
                if (resSatpam.ok) fotoSatpam = ((await resSatpam.json()).data || []).map(s => s.photo_url);
            } catch (err) {}

            // 5. Gabungkan keempat sumber foto
            const semuaFotoUrl = [...fotoKonsul, ...fotoUjian, ...fotoGaleri, ...fotoSatpam];

            if (semuaFotoUrl.length === 0) {
                statusText.innerText = 'Belum ada foto sama sekali.';
                btn.innerHTML = '<i class="fa-solid fa-shuffle"></i> Acak Foto';
                btn.disabled = false;
                return;
            }

            // 6. Pilih Acak & Render
            selectedFotoUrl = semuaFotoUrl[Math.floor(Math.random() * semuaFotoUrl.length)];
