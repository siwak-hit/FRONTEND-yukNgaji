    window.getLatestRaportPhoto = async () => {
        try {
            const res = await fetch(`${API_URL}/api/students/${studentId}/latest-photo`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (!res.ok) throw new Error('Gagal fetch foto');

