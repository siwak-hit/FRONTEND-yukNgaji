---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
---

<Layout title="Ujian Selesai - yukNgaji">
    <div class="min-h-screen bg-slate-50 font-sans text-slate-800 pattern-grid flex flex-col items-center px-6 pt-10 pb-12 relative overflow-hidden select-none">
        <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
            <div class="absolute top-10 left-10 w-32 h-32 bg-yellow-300 rounded-full mix-blend-multiply filter blur-2xl opacity-60 animate-float"></div>
            <div class="absolute bottom-10 right-10 w-40 h-40 bg-indigo-300 rounded-full mix-blend-multiply filter blur-2xl opacity-60 animate-float" style="animation-delay: 2s;"></div>
            <div class="absolute top-[35%] right-[-15%] w-56 h-56 bg-green-200 rounded-full mix-blend-multiply filter blur-[80px] opacity-60"></div>
        </div>

        <div class="relative z-10 w-full max-w-md text-center animate-fade-in-up">
            <div class="w-20 h-20 bg-white border border-indigo-100 shadow-sm rounded-[2rem] flex items-center justify-center text-4xl mx-auto mb-4">
                🏆
            </div>

            <h1 class="text-3xl font-black text-slate-800 mb-1">Alhamdulillah!</h1>
            <h2 id="pageSubtitle" class="text-sm font-black text-indigo-600 mb-6 uppercase tracking-widest">
                Ujian Selesai
            </h2>

            <div id="simpleFinishCard" class="bg-white/80 backdrop-blur-md border-2 border-indigo-100 p-8 rounded-[2rem] w-full shadow-2xl text-center">
                <div class="w-24 h-24 bg-indigo-100 text-indigo-500 rounded-full flex items-center justify-center text-5xl mx-auto mb-6 shadow-inner border-4 border-white">
                    <i class="fa-solid fa-hourglass-half animate-pulse"></i>
                </div>

                <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl mb-8 text-sm font-bold text-slate-600 leading-relaxed shadow-sm">
                    Sekarang kamu boleh istirahat. Silakan tunggu hasil raport dibagikan oleh Kak Aziz ya!
                </div>

                <a href="/" class="block w-full py-4 bg-indigo-600 text-white font-black rounded-2xl shadow-lg shadow-indigo-500/30 active:scale-95 transition-all">
                    Kembali ke Beranda <i class="fa-solid fa-house ml-2"></i>
                </a>
            </div>

            <div id="examFinishContent" class="hidden w-full">
                <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-[2rem] p-5 shadow-xl mb-5">
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">
                        Hasil Ujian
                    </p>
                    <div class="inline-flex items-center gap-2 bg-indigo-50 px-4 py-1.5 rounded-full border border-indigo-100 shadow-sm">
                        <i class="fa-solid fa-book-open text-indigo-500 text-[10px]"></i>
                        <p class="text-indigo-700 font-bold uppercase tracking-widest text-[10px]" id="lbSubtitle">
                            Memuat data...
                        </p>
                    </div>
                </div>

                <div id="leaderboardContainer" class="w-full space-y-3">
                    <div class="text-center py-12 bg-white rounded-[2rem] border border-gray-100 shadow-sm">
                        <i class="fa-solid fa-spinner fa-spin text-indigo-500 text-3xl"></i>
                    </div>
                </div>

                <div id="infoScoring" class="w-full mt-6 bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm hidden opacity-0 transform translate-y-4 transition-all duration-700">
                    <h3 class="text-xs font-black text-gray-800 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info text-blue-500 text-lg"></i> Rahasia Poin Klasemen
                    </h3>

                    <div class="space-y-3">
                        <div class="flex items-start gap-3 bg-gray-50 p-3 rounded-2xl border border-gray-100">
                            <div class="text-xl">🎯</div>
                            <div>
                                <p class="text-[10px] font-black text-gray-700 uppercase">Akurasi Jawaban</p>
                                <p class="text-[9px] text-gray-500 font-medium leading-relaxed mt-0.5">
                                    Nilai dari jawaban benarmu menjadi bagian utama dalam peringkat.
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 bg-gray-50 p-3 rounded-2xl border border-gray-100">
                            <div class="text-xl">🚀</div>
                            <div>
                                <p class="text-[10px] font-black text-gray-700 uppercase">Urutan Mengumpulkan</p>
                                <p class="text-[9px] text-gray-500 font-medium leading-relaxed mt-0.5">
                                    Yang lebih cepat mengumpulkan bisa mendapat bonus kecil di klasemen.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-dashed border-gray-200 text-center">
                        <p id="finalCloseText" class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">
                            Kamu boleh menutup browser ini.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div id="modalFinalFeedback" class="fixed inset-0 z-[500] hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
            <div class="bg-white w-full max-w-sm rounded-[2rem] p-6 shadow-2xl text-center border-2 border-indigo-100 animate-slide-up relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-amber-300 rounded-full blur-3xl opacity-30 pointer-events-none"></div>
                <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-indigo-300 rounded-full blur-3xl opacity-30 pointer-events-none"></div>

                <div class="relative z-10">
                    <div class="w-20 h-20 bg-indigo-50 text-indigo-600 rounded-[1.5rem] flex items-center justify-center text-4xl mx-auto mb-4 border border-indigo-100 shadow-inner">
                        <i class="fa-solid fa-clipboard-question animate-bounce"></i>
                    </div>

                    <h3 class="text-2xl font-black text-gray-800 mb-2">Misi Terakhir!</h3>

                    <p class="text-xs font-bold text-gray-500 leading-relaxed mb-5">
                        Nilaimu sudah diterima. Tinggal isi 3 pertanyaan singkat agar laporan akhir kamu lengkap di rekap Ustadz.
                    </p>

                    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 mb-5">
                        <p class="text-[10px] font-black text-amber-700 uppercase tracking-widest">
                            Jangan ditutup dulu ya!
                        </p>
                        <p class="text-[11px] font-bold text-amber-800 mt-1 leading-relaxed">
                            Setelah feedback dikirim, baru halaman ini selesai sepenuhnya.
                        </p>
                    </div>

                    <button onclick="goToFeedbackPage()"
                        class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl shadow-[0_6px_0_#4f46e5] active:translate-y-[6px] active:shadow-none transition-all">
                        Isi Feedback Sekarang
                    </button>
                </div>
            </div>
        </div>
    </div>

    <Toast />

    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js" is:inline></script>

    <script>
        const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
        const urlParams = new URLSearchParams(window.location.search);

        const mode = urlParams.get('mode') || 'simple';
        const examId = urlParams.get('exam_id');
        const subject = urlParams.get('subject') || 'Ujian';
        const currentStudentId = urlParams.get('student_id');
        const isFinal = urlParams.get('final') === 'true';
        const feedbackRequired = urlParams.get('feedback_required') === 'true';

        const isPreview = urlParams.get('preview') === 'true';
        const isTeacherPreview = urlParams.get('teacher_preview') === 'true';

        let token = urlParams.get('token') || localStorage.getItem('token') || sessionStorage.getItem('temp_pr_token');

        const initPage = () => {
            if (mode === 'exam' && examId) {
                document.getElementById('simpleFinishCard')?.classList.add('hidden');
                document.getElementById('examFinishContent')?.classList.remove('hidden');
                document.getElementById('pageSubtitle').innerText = isFinal ? 'Penutupan Ujian' : 'Ujian Selesai';
                document.getElementById('lbSubtitle').innerText = `${subject} • Hasil Ujian`;
                fetchExamLeaderboard();
                return;
            }

            if (typeof confetti === 'function') {
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.4 } });
            }
        };

        const fetchExamLeaderboard = async () => {
            const container = document.getElementById('leaderboardContainer');
            const infoCard = document.getElementById('infoScoring');

            try {
                if (!token) throw new Error('Token tidak ditemukan.');

                const params = new URLSearchParams({
                    mode: 'exam',
                    exam_id: examId
                });

                const res = await fetch(`${API_URL}/api/onboarding/leaderboard-pr?${params.toString()}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                const data = await res.json();

                if (!res.ok || data.status !== 'success') {
                    throw new Error(data.message || 'Gagal mengambil leaderboard.');
                }

                if (!data.data || data.data.length === 0) {
                    container.innerHTML = `
                        <div class="bg-white p-8 rounded-[2rem] border border-gray-100 shadow-sm text-center">
                            <div class="text-4xl mb-3">👻</div>
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-widest">
                                Belum ada data pengerjaan.
                            </p>
                        </div>
                    `;
                    return;
                }

                if (typeof confetti === 'function') {
                    confetti({ particleCount: 150, spread: 80, origin: { y: 0.3 } });
                }

                container.innerHTML = data.data.map((student, index) => {
                    const rank = index + 1;
                    const widthPercent = Math.min(100, Number(student.composite_score || 0));
                    const isMe = String(student.student_id) === String(currentStudentId);

                    let bgClass = 'bg-white border-gray-100';
                    let barColor = 'from-gray-100 to-gray-200';
                    let rankBadge = `<div class="w-8 h-8 rounded-xl bg-gray-100 border border-gray-200 text-gray-400 font-black flex items-center justify-center shrink-0 shadow-sm">${rank}</div>`;
                    let textClass = 'text-gray-700';

                    if (rank === 1) {
                        bgClass = 'bg-amber-50 border-amber-200';
                        barColor = 'from-amber-200 to-orange-300';
                        rankBadge = `<div class="w-11 h-11 rounded-[14px] bg-gradient-to-br from-amber-300 to-orange-500 border-2 border-white text-white font-black flex items-center justify-center shrink-0 shadow-md shadow-orange-500/40"><i class="fa-solid fa-crown text-lg"></i></div>`;
                        textClass = 'text-amber-900';
                    } else if (rank === 2) {
                        bgClass = 'bg-slate-50 border-slate-200';
                        barColor = 'from-slate-200 to-slate-300';
                        rankBadge = `<div class="w-10 h-10 rounded-[12px] bg-gradient-to-br from-slate-300 to-slate-400 border-2 border-white text-white font-black flex items-center justify-center shrink-0 shadow-sm shadow-slate-400/40">2</div>`;
                        textClass = 'text-slate-800';
                    } else if (rank === 3) {
                        bgClass = 'bg-orange-50 border-orange-200';
                        barColor = 'from-orange-200 to-orange-300';
                        rankBadge = `<div class="w-9 h-9 rounded-[10px] bg-gradient-to-br from-orange-300 to-orange-400 border-2 border-white text-white font-black flex items-center justify-center shrink-0 shadow-sm shadow-orange-400/40">3</div>`;
                        textClass = 'text-orange-900';
                    }

                    if (isMe) {
                        bgClass += ' ring-2 ring-indigo-400 shadow-md transform scale-[1.02]';
                    }

                    const meBadge = isMe
                        ? `<span class="text-[8px] bg-indigo-600 text-white px-2 py-0.5 rounded-full font-black uppercase tracking-widest shadow-sm">Ini Kamu!</span>`
                        : '';

                    const timeText = student.time_taken && student.time_taken !== '-'
                        ? `⏱️ ${student.time_taken}s`
                        : '🚀 Selesai';

                    return `
                        <div class="relative w-full rounded-[2rem] border ${bgClass} p-4 overflow-hidden shadow-sm transition-all animate-slide-up" style="animation-delay: ${index * 100}ms; opacity: 0; animation-fill-mode: forwards;">
                            <div class="absolute top-0 left-0 h-full bg-gradient-to-r ${barColor} opacity-40 transition-all duration-1000 ease-out" style="width: 0%;" data-width="${widthPercent}%"></div>

                            <div class="relative z-10 flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    ${rankBadge}
                                    <div>
                                        <div class="flex items-center flex-wrap gap-1.5 mb-1">
                                            <p class="font-black uppercase tracking-wider text-sm ${textClass}">${student.name}</p>
                                            ${meBadge}
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-[9px] bg-white/60 px-2 py-0.5 rounded border border-white/40 text-gray-600 font-bold shadow-sm">🎯 ${student.raw_score}</span>
                                            <span class="text-[9px] bg-white/60 px-2 py-0.5 rounded border border-white/40 text-gray-600 font-bold shadow-sm">${timeText}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-right bg-white/80 px-3 py-2 rounded-2xl border border-white shadow-sm flex flex-col items-center justify-center min-w-[60px]">
                                    <p class="text-xl font-black ${textClass} leading-none drop-shadow-sm">${student.composite_score}</p>
                                    <p class="text-[7px] text-gray-500 font-bold uppercase tracking-widest mt-1">Poin</p>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');

                setTimeout(() => {
                    document.querySelectorAll('[data-width]').forEach(el => {
                        el.style.width = el.getAttribute('data-width');
                    });
                }, 100);

                setTimeout(() => {
                    infoCard.classList.remove('hidden');

                    const finalCloseText = document.getElementById('finalCloseText');
                    if (finalCloseText) {
                        finalCloseText.innerText = isFinal && feedbackRequired
                            ? 'Jangan tutup dulu. Tunggu misi terakhir muncul...'
                            : 'Nilai sudah tersimpan. Kamu boleh menutup browser ini.';
                    }

                    setTimeout(() => {
                        infoCard.classList.replace('opacity-0', 'opacity-100');
                        infoCard.classList.replace('translate-y-4', 'translate-y-0');
                    }, 50);

                    if (isFinal && feedbackRequired) {
                        setTimeout(() => {
                            document.getElementById('modalFinalFeedback')?.classList.replace('hidden', 'flex');
                        }, 5000);
                    }
                }, (data.data.length * 100) + 300);

            } catch (error) {
                console.error(error);
                container.innerHTML = `
                    <div class="bg-white p-6 rounded-[2rem] border border-red-100 shadow-sm text-center">
                        <i class="fa-solid fa-triangle-exclamation text-red-500 text-3xl mb-3"></i>
                        <p class="text-xs text-red-600 font-bold">${error.message || 'Gagal memuat klasemen.'}</p>
                    </div>
                `;
            }
        };

        window.goToFeedbackPage = () => {
            const params = new URLSearchParams();

            if (currentStudentId) params.set('student_id', currentStudentId);
            if (examId) params.set('exam_id', examId);
            if (subject) params.set('subject', subject);
            if (token) params.set('token', token);

            // [BARU] Mode simulasi guru tetap masuk halaman feedback,
            // tapi nanti feedback tidak benar-benar dikirim ke DB.
            if (isPreview) params.set('preview', 'true');
            if (isTeacherPreview) params.set('teacher_preview', 'true');

            window.location.href = `/feedback?${params.toString()}`;
        };

        initPage();
    </script>

    <style is:global>
        .pattern-grid {
            background-image: linear-gradient(to right, #e2e8f0 1px, transparent 1px), linear-gradient(to bottom, #e2e8f0 1px, transparent 1px);
            background-size: 24px 24px;
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0) scale(1);
            }

            50% {
                transform: translateY(-20px) scale(1.05);
            }
        }

        .animate-fade-in-up {
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .animate-slide-up {
            animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideUp {
            0% {
                transform: translateY(20px) scale(0.95);
                opacity: 0;
            }

            100% {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }
    </style>
</Layout>
