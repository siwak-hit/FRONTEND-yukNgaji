    // =================================================================
    window.closeImgUploader = () => {
        document.getElementById('modalImgUpload').classList.replace('flex', 'hidden');
        imgUploadTarget = null;
    };

    const handleImageFile = (file) => {
        if (!file || !file.type.startsWith('image/')) {
            window.showToast?.('warning', 'File tidak valid', 'Silakan pilih file gambar.');
            return;
        }
        closeImgUploader();
        uploadImageFile(file, imgUploadTarget.imgInput, imgUploadTarget.previewWrap);
    };

    const uploadImageFile = (file, targetInput, previewWrap) => {
        if (!targetInput || !previewWrap) return;

        pendingImgUploads++;
        const btnFinalSave = document.getElementById('btnFinalSave');
        const btnEditSave = document.querySelector('button[onclick="submitEditSoal()"]');
        if(btnFinalSave) btnFinalSave.disabled = true;
        if(btnEditSave) btnEditSave.disabled = true;

        const tempUrl = URL.createObjectURL(file);
        previewWrap.classList.remove('hidden');
        const previewContainerId = `upload-preview-${Date.now()}`;
        previewWrap.innerHTML = `
            <div id="${previewContainerId}" class="relative w-full max-w-[200px]">
                <img src="${tempUrl}" class="w-full h-auto object-contain rounded-lg border border-gray-200 blur-sm animate-pulse">
                <div class="absolute inset-0 bg-black/50 flex flex-col items-center justify-center text-white rounded-lg p-2">
                    <i class="fa-solid fa-spinner fa-spin text-xl"></i>
                    <p class="text-xs font-bold mt-2">Mengupload...</p>
                    <div class="w-full bg-gray-600/50 rounded-full h-1.5 mt-2">
                        <div class="bg-white rounded-full h-1.5 progress-bar" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        `;
        const progressBar = previewWrap.querySelector('.progress-bar');
        const previewParent = document.getElementById(previewContainerId);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', `${API_URL}/api/onboarding/upload-image`);
        xhr.setRequestHeader('Authorization', `Bearer ${token}`);

        xhr.upload.addEventListener('progress', (e) => {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                if (progressBar) progressBar.style.width = `${percent}%`;
            }
        });

        xhr.onload = () => {
            URL.revokeObjectURL(tempUrl);
            pendingImgUploads--;
            if (pendingImgUploads <= 0) {
                if(btnFinalSave) btnFinalSave.disabled = false;
                if(btnEditSave) btnEditSave.disabled = false;
            }

            if (xhr.status === 200) {
                const res = JSON.parse(xhr.responseText);
                targetInput.value = res.data.url;
                // Cek apakah elemen preview masih ada sebelum mengubahnya
                if (document.getElementById(previewContainerId)) {
                   previewWrap.innerHTML = `<img src="${res.data.url}" class="max-h-28 rounded-xl border border-gray-200 object-contain" onerror="this.parentElement.classList.add('hidden')">`;
                }
                window.showToast?.('success', 'Berhasil', 'Gambar telah diupload.');
                isDirty = true;
            } else {
                 const errorMsg = JSON.parse(xhr.responseText).message || 'Gagal upload.';
                 if (document.getElementById(previewContainerId)) {
                    previewWrap.innerHTML = `<div class="text-xs text-red-500 p-2 bg-red-50 rounded-lg">Gagal: ${errorMsg}</div>`;
                 }
                window.showToast?.('danger', 'Error Upload', errorMsg);
            }
        };

        xhr.onerror = () => {
            URL.revokeObjectURL(tempUrl);
            pendingImgUploads--;
            if (pendingImgUploads <= 0) {
                if(btnFinalSave) btnFinalSave.disabled = false;
                if(btnEditSave) btnEditSave.disabled = false;
            }
            if (document.getElementById(previewContainerId)) {
                previewWrap.innerHTML = `<div class="text-xs text-red-500 p-2 bg-red-50 rounded-lg">Error jaringan.</div>`;
            }
            window.showToast?.('danger', 'Error Jaringan', 'Periksa koneksi internet Anda.');
        };

        const formData = new FormData();
        formData.append('file', file);
        xhr.send(formData);
    };

    const setupImageUploader = () => {
        const dropZone = document.getElementById('imgDropZone');
        const fileInput = document.getElementById('imgUploadFileInput');

        if (!dropZone || !fileInput) return;

        dropZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) {
                handleImageFile(e.target.files[0]);
                e.target.value = ''; // Reset input
            }
        });

        const preventDefaults = (e) => { e.preventDefault(); e.stopPropagation(); };
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
            document.body.addEventListener(eventName, preventDefaults, false);
        });

        dropZone.addEventListener('dragover', () => dropZone.classList.add('border-green-500', 'bg-green-50/40'));
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-green-500', 'bg-green-50/40'));

        dropZone.addEventListener('drop', (e) => {
            dropZone.classList.remove('border-green-500', 'bg-green-50/40');
            if (e.dataTransfer.files.length) {
                handleImageFile(e.dataTransfer.files[0]);
            }
        });

        // Paste dari mana saja di window, tapi hanya jika modalnya terbuka
        window.addEventListener('paste', (e) => {
            const modal = document.getElementById('modalImgUpload');
            if(modal.classList.contains('hidden')) return;

            e.preventDefault();
            const items = (e.clipboardData || window.clipboardData).items;
            for (const item of items) {
                if (item.kind === 'file') {
                    handleImageFile(item.getAsFile());
                    break;
                }
            }
        });
    };

