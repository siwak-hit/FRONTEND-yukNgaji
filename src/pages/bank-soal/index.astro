            .map(Number).sort((a, b) => a - b);

        let pendingWeeks = allWeeks;

        // Jika siswa dipilih, filter hanya yang belum dikerjakan
        if (siswaId) {
            try {
                const r = await fetch(`${API_URL}/api/students/${siswaId}/lag-status`, { headers: { 'Authorization': `Bearer ${token}` } });
                const d = await r.json();
                const missed = d.data?.[mapel]?.missedWeeks || [];
