            container.innerHTML = '<div class="text-center py-10"><i class="fa-solid fa-check-double text-4xl text-green-200 mb-2"></i><p class="text-[10px] text-gray-400 font-black uppercase tracking-widest">Semua Siswa Terdata / Tidak Ditemukan</p></div>';
            return;
        }

        container.innerHTML = filtered.map(s => `
            <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 border border-gray-100 shadow-sm transition-all hover:border-indigo-200 hover:bg-indigo-50/30 group">
                <div class="flex items-center gap-3 min-w-0 pr-2">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center font-black text-sm text-indigo-400 border border-gray-200 shrink-0 shadow-inner group-hover:border-indigo-200">
                        ${s.name.substring(0,2).toUpperCase()}
                    </div>
                    <div class="min-w-0">
                        <span class="text-xs font-black text-gray-800 block leading-tight truncate capitalize">${s.name}</span>
                        <span class="text-[9px] font-bold text-red-400 uppercase tracking-widest">Belum Kumpul</span>
                    </div>
                </div>
                <button onclick="executeGrantExtension('${s.id}', '${s.name.replace(/'/g, "\\'")}', this)" class="px-4 py-2 rounded-xl text-[10px] font-black bg-indigo-100 text-indigo-600 hover:bg-indigo-600 hover:text-white transition-all shadow-sm active:scale-95 shrink-0 whitespace-nowrap">
                    Beri Akses
                </button>
            </div>
        `).join('');
    };

    document.getElementById('extSearch')?.addEventListener('input', renderExtStudentList);

    window.executeGrantExtension = async (studentId, studentName, btnEl) => {
        // [BARU] Ambil waktu dispensasi
        const extDeadlineVal = document.getElementById('extDeadlineInput').value;
        if (!extDeadlineVal) return window.showToast?.('warning', 'Perhatian', 'Pilih batas waktu dispensasi dulu!');

        const oldText = btnEl.innerHTML;
        btnEl.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btnEl.disabled = true;

        try {
            const res = await fetch(`${API_URL}/api/onboarding/pr-extension`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                // [BARU] Kirim extension_until
                body: JSON.stringify({ subject: extSubject, week: extWeek, student_id: studentId, extension_until: extDeadlineVal })
            });
            const data = await res.json();
            
            if (res.ok && data.status === 'success') {
                window.showToast?.('success', 'Dispensasi Diberikan!', `Akses khusus untuk ${studentName} telah dibuka.`);
                
                // Animasi Sukses di Tombol
                btnEl.innerHTML = '<i class="fa-solid fa-check"></i> Selesai';
                btnEl.classList.replace('bg-indigo-100', 'bg-green-100');
                btnEl.classList.replace('text-indigo-600', 'text-green-600');
                btnEl.classList.remove('hover:bg-indigo-600', 'hover:text-white');
                
                // Otomatis hilangkan dari daftar (krn urusannya udah kelar)
                extStudents = extStudents.filter(s => s.id !== studentId);
                setTimeout(() => { renderExtStudentList(); }, 800);
            } else {
                throw new Error(data.message || 'Gagal');
            }
        } catch (e) {
            window.showToast?.('danger', 'Gagal', 'Terjadi kesalahan sistem.');
            btnEl.innerHTML = oldText;
            btnEl.disabled = false;
        }
    };

    // =================================================================
    // 6. [BARU] PILIH PERTEMUAN → LOADING → VIEWER + BULK
    // =================================================================
    let viewerQuestions = [], viewerIndex = 0, viewerWeek = null, viewerSubject = null;
    let bulkType = 'soal';
    const SUBJECT_LABEL = { tajwid: 'Tajwid', fiqih: 'Fiqih', tauhid: 'Tauhid' };
    const SUBJECT_ICON  = { tajwid: '📖', fiqih: '⚖️', tauhid: '🕌' };

    const populateHome = () => {
        const n = Object.keys(accordionSummary || {}).length;
        const sub = document.getElementById('pilihSubtitle');
        if (sub) sub.textContent = n ? `${n} pertemuan tersedia · lihat & kelola soal` : 'Belum ada soal — tambah dulu';
    };

    // ---- Modal Pilih (step form) ----
    window.openPilihModal = async () => {
        if (Object.keys(accordionSummary || {}).length === 0) await fetchAccordion();
        const wkSel = document.getElementById('pilihWeek');
        const weeks = Object.keys(accordionSummary).map(Number).sort((a, b) => a - b);
        wkSel.innerHTML = '<option value="">— Pilih pertemuan —</option>' + weeks.map(w => {
            const c = accordionSummary[w] || {}; const t = (c.tajwid || 0) + (c.fiqih || 0) + (c.tauhid || 0);
            return `<option value="${w}">Pertemuan ${w} (${t} soal)</option>`;
        }).join('');
        wkSel.value = '';
        document.getElementById('pilihMapelStep').classList.add('hidden');
        document.getElementById('pilihLihatWrap').classList.add('hidden');
        document.getElementById('modalPilih').classList.remove('hidden');
    };
    window.closePilihModal = () => document.getElementById('modalPilih').classList.add('hidden');

    window.onPilihWeekChange = () => {
        const wk = document.getElementById('pilihWeek').value;
        const mapelStep = document.getElementById('pilihMapelStep');
        document.getElementById('pilihLihatWrap').classList.add('hidden');
        if (!wk) { mapelStep.classList.add('hidden'); return; }
        const c = accordionSummary[wk] || {};
        const mSel = document.getElementById('pilihMapel');
        mSel.innerHTML = '<option value="">— Pilih mapel —</option>' +
            SUBJECTS.filter(s => (c[s] || 0) > 0).map(s => `<option value="${s}">${SUBJECT_ICON[s]} ${SUBJECT_LABEL[s]} (${c[s]} soal)</option>`).join('');
        mSel.value = '';
        mapelStep.classList.remove('hidden');
    };
    window.onPilihMapelChange = () => {
        const m = document.getElementById('pilihMapel').value;
        document.getElementById('pilihLihatWrap').classList.toggle('hidden', !m);
    };
    window.submitPilih = () => {
        const wk = parseInt(document.getElementById('pilihWeek').value);
        const m = document.getElementById('pilihMapel').value;
        if (!wk || !m) return;
        closePilihModal();
        loadAndShowViewer(wk, m, { loading: true });
    };

    // ---- Helper loading bar (progress disinkronkan dgn fetch DB) ----
    const _wait = (ms) => new Promise(r => setTimeout(r, ms));
    const _setBar = (p) => {
        document.getElementById('loadingBar').style.width = p + '%';
        document.getElementById('loadingPct').textContent = p + '%';
    };

    // ---- Load & render viewer ----
    const loadAndShowViewer = async (week, subject, opts = {}) => {
        const { keepIndex = false, loading = false } = opts;
        const key = `${week}-${subject}`;
        const ov = document.getElementById('loadingOverlay');
        if (loading) { ov.classList.remove('hidden'); _setBar(0); await _wait(60); _setBar(50); await _wait(180); _setBar(80); }
        try {
            const res = await fetch(`${API_URL}/api/onboarding/questions/${subject}?week=${week}`, { headers: { 'Authorization': `Bearer ${token}` } });
            const result = await res.json();
            soalCache[key] = result.data || [];
        } catch (e) {
            if (loading) ov.classList.add('hidden');
            window.showToast?.('danger', 'Error', 'Gagal memuat soal.');
            return;
        }
        // Data sudah di tangan → barulah bar dipenuhkan sampai 100%
        if (loading) { _setBar(95); await _wait(120); _setBar(100); await _wait(220); }

        viewerQuestions = soalCache[key];
        viewerWeek = week; viewerSubject = subject;
        if (!keepIndex || viewerIndex >= viewerQuestions.length) viewerIndex = 0;
        document.getElementById('bankSoalEmpty').classList.add('hidden');
        document.getElementById('btnPilihPertemuan').classList.add('hidden');
        document.getElementById('soalViewerSection').classList.remove('hidden');
        renderViewer();
        if (loading) ov.classList.add('hidden');
        document.getElementById('soalViewerSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Menu titik-tiga (mini container expand) — aksi soal + Mode PR inline
    const viewerMenuHtml = () => `
        <div id="viewerMenu" class="hidden absolute right-0 top-full mt-2 card w-64 z-[50] overflow-hidden" style="box-shadow: var(--shadow-pop); max-height: 70vh; overflow-y: auto;">
            <div class="p-2 space-y-0.5">
                <button onclick="closeViewerMenu(); openEditSoal(viewerCurrent());" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                    <div class="icon-chip-sm" style="background-color: var(--info-soft); color: var(--info);"><i class="fa-solid fa-pen"></i></div>
                    <span class="caption font-semibold text-ink flex-1">Edit Soal</span>
                </button>
                <button onclick="closeViewerMenu(); deleteCurrentSoal();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--danger-soft)] transition-colors">
                    <div class="icon-chip-sm" style="background-color: var(--danger-soft); color: var(--danger);"><i class="fa-solid fa-trash"></i></div>
                    <span class="caption font-semibold flex-1" style="color: var(--danger);">Hapus Soal</span>
                </button>
                <div class="h-px my-1 mx-2" style="background-color: var(--divider);"></div>
                <div id="viewerPRSection" class="px-1 pb-1">
                    <div class="py-3 text-center"><i class="fa-solid fa-spinner fa-spin text-tertiary"></i></div>
                </div>
                <div class="h-px my-1 mx-2" style="background-color: var(--divider);"></div>
                <button onclick="closeViewerMenu(); openRemindPRModal();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                    <div class="icon-chip-sm" style="background-color: var(--accent-soft); color: var(--accent-strong);"><i class="fa-solid fa-bell"></i></div>
                    <span class="caption font-semibold text-ink flex-1">Ingatkan Siswa</span>
                </button>
                <button onclick="closeViewerMenu(); openBulkModal();" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left hover:bg-[var(--surface-sunken)] transition-colors">
                    <div class="icon-chip-sm" style="background-color: var(--surface-sunken); color: var(--ink-secondary);"><i class="fa-solid fa-list-check"></i></div>
                    <span class="caption font-semibold text-ink flex-1">Hapus Massal</span>
                </button>
            </div>
        </div>`;

    window.toggleViewerMenu = (e) => {
        if (e) e.stopPropagation();
        const menu = document.getElementById('viewerMenu');
        if (!menu) return;
        const willOpen = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        if (willOpen) {
            loadViewerPR();
            const close = (ev) => {
                if (!menu.contains(ev.target) && !ev.target.closest('[onclick^="toggleViewerMenu"]')) {
                    menu.classList.add('hidden');
                    document.removeEventListener('click', close);
                }
            };
            setTimeout(() => document.addEventListener('click', close), 10);
        }
    };
    window.closeViewerMenu = () => document.getElementById('viewerMenu')?.classList.add('hidden');

    // ---- Ingatkan Siswa (push notif ke yang belum ngerjain PR ini) ----
    window.openRemindPRModal = () => {
        if (!viewerSubject) return;
        document.getElementById('remindPRMapel').textContent = (SUBJECT_LABEL[viewerSubject] || viewerSubject).toUpperCase();
        document.getElementById('remindPRWeek').textContent = viewerWeek;
        document.getElementById('remindPRMsg').value = '';
        const m = document.getElementById('modalRemindPR');
        m.classList.remove('hidden'); m.classList.add('flex');
    };
    window.closeRemindPRModal = () => {
        const m = document.getElementById('modalRemindPR');
        m.classList.add('hidden'); m.classList.remove('flex');
    };
    document.getElementById('modalRemindPR')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) window.closeRemindPRModal();
    });
    window.sendRemindPR = async (btnEl) => {
        if (btnEl.disabled) return;
        const originalHTML = btnEl.innerHTML;
        btnEl.disabled = true;
        btnEl.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Mengirim...';
        try {
            const message = document.getElementById('remindPRMsg').value.trim();
            const res = await fetch(`${API_URL}/api/onboarding/pr-remind`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ subject: viewerSubject, week: viewerWeek, message: message || undefined })
            });
            const j = await res.json();
            if (!res.ok) throw new Error(j.message || 'Gagal mengirim pengingat.');
            window.showToast?.(j.sent > 0 ? 'success' : 'info', j.sent > 0 ? 'Terkirim!' : 'Info', j.message);
            window.closeRemindPRModal();
        } catch (err) {
            window.showToast?.('danger', 'Gagal', err.message);
        } finally {
            btnEl.disabled = false;
            btnEl.innerHTML = originalHTML;
        }
    };

    // Isi bagian Mode PR di dalam mini menu (switch + aksi PR, tanpa drawer)
    const loadViewerPR = async () => {
        const sec = document.getElementById('viewerPRSection');
        if (!sec) return;
        const subject = viewerSubject, week = viewerWeek;
        let isLocked = false, dDays = 1, dTime = '23:59';
        try { const r = await fetch(`${API_URL}/api/onboarding/pr-locks/${subject}`, { headers: { 'Authorization': `Bearer ${token}` } }); const d = await r.json(); isLocked = (d.data || []).includes(week); } catch (e) {}
        try {
            const r = await fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` } });
            const d = await r.json();
            if (d.data && d.data.deadline_at) { const dl = new Date(d.data.deadline_at); dDays = Math.max(0, Math.ceil((dl - new Date()) / 86400000)); dTime = `${String(dl.getHours()).padStart(2, '0')}:${String(dl.getMinutes()).padStart(2, '0')}`; }
        } catch (e) {}
        sec.innerHTML = buildPRPanel(subject, week, isLocked, dDays, dTime);
    };

    const renderViewerBody = (q) => {
        const typeMap = { tf: ['T/F', 'var(--info)'], drag: ['DRAG', 'var(--warning)'], urutan: ['URUTAN', 'var(--accent-strong)'] };
        const tb = typeMap[q.type] || ['PG', 'var(--ink-secondary)'];
        const levelMap = { mudah: 'badge-accent', sedang: 'badge-info', sulit: 'badge-danger' };
        const lc = levelMap[q.difficulty_level] || 'badge-neutral';
        const img = q.image_url ? `<div class="mt-3 rounded-[var(--r-md)] overflow-hidden border" style="border-color: var(--hairline);"><img src="${q.image_url}" class="w-full max-h-56 object-contain bg-white" onerror="this.parentElement.remove()"></div>` : '';

        let ans = '';
        if (q.type === 'drag') {
            const allOpts = Object.entries(q.options || {}).map(([k, v]) => `<span class="badge badge-warning">${k}: ${v}</span>`).join(' ');
            const keys = (q.correct_answer || '').split(','); let bi = 0;
            const filled = (q.question || '').replace(/\[BLANK\]/g, () => { const key = keys[bi] || '?'; const val = (q.options || {})[key] || key; bi++; return `<span class="badge badge-accent">${val}</span>`; });
            ans = `<p class="eyebrow mb-1">Kalimat Lengkap</p><p class="caption text-ink leading-relaxed mb-3">${filled}</p><p class="eyebrow mb-1">Pilihan</p><div class="flex flex-wrap gap-1.5">${allOpts}</div>`;
        } else if (q.type === 'urutan') {
            const arr = Array.isArray(q.correct_answer) && q.correct_answer.length ? q.correct_answer : (Array.isArray(q.options) ? q.options : []);
            ans = `<p class="eyebrow mb-1.5">Urutan Benar</p><div class="flex flex-wrap items-center gap-1.5">${arr.map(x => `<span class="badge badge-accent">${x}</span>`).join('<i class="fa-solid fa-arrow-right text-[10px] text-tertiary"></i>')}</div>`;
        } else {
            ans = `<p class="eyebrow mb-1.5">Pilihan Jawaban</p><div class="space-y-1.5">` + Object.entries(q.options || {}).map(([k, v]) => {
                const correct = k === q.correct_answer;
                return `<div class="flex items-center gap-2 caption ${correct ? 'font-bold' : 'text-secondary'}" style="${correct ? 'color: var(--accent-strong);' : ''}"><span class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] flex-shrink-0" style="background-color: ${correct ? 'var(--accent-soft)' : 'var(--surface-sunken)'};">${correct ? "<i class='fa-solid fa-check'></i>" : k}</span>${v}</div>`;
            }).join('') + `</div>`;
        }

        return `
            <div class="flex items-center gap-2 mb-3">
                <span class="badge" style="background-color: ${tb[1]}1f; color: ${tb[1]};">${tb[0]}</span>
                <span class="badge ${lc} capitalize">${q.difficulty_level || 'sedang'}</span>
            </div>
            <p class="text-ink font-semibold leading-relaxed" style="letter-spacing: var(--tracking-snug);">${q.question || ''}</p>
            ${img}
            <div class="mt-4 pt-3 border-t" style="border-color: var(--divider);">${ans}</div>`;
    };

    const renderViewer = () => {
        const sec = document.getElementById('soalViewerSection');
        const total = viewerQuestions.length;
        const subjLabel = SUBJECT_LABEL[viewerSubject] || viewerSubject;
        // Chip "ganti pertemuan" (jelas bisa diklik) + menu titik-tiga
        const topRow = `
            <div class="flex items-center justify-between gap-2 mb-4">
                <button onclick="openPilihModal()" class="chip" title="Ganti pertemuan / mapel">
                    <i class="fa-solid fa-layer-group"></i> Pertemuan ${viewerWeek} · ${subjLabel}
                    <i class="fa-solid fa-chevron-down text-[8px] ml-0.5"></i>
                </button>
                <div class="flex items-center gap-1.5 flex-shrink-0">
                    <button onclick="previewAsStudent()" class="btn-icon !w-9 !h-9" style="color: var(--info);" title="Preview POV siswa (tidak disimpan)"><i class="fa-solid fa-eye text-xs"></i></button>
                    <div class="relative">
                        <button onclick="toggleViewerMenu(event)" class="btn-icon !w-9 !h-9" aria-label="Aksi soal"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                        ${viewerMenuHtml()}
                    </div>
                </div>
            </div>`;

        if (total === 0) {
            sec.innerHTML = `<div class="card card-pad">${topRow}<div class="empty-state"><div class="empty-icon"><i class="fa-solid fa-inbox text-2xl"></i></div><p class="caption font-semibold">Tidak ada soal di sini.</p></div></div>`;
            return;
        }
        if (viewerIndex >= total) viewerIndex = total - 1;
        const q = viewerQuestions[viewerIndex];
        const jump = Array.from({ length: total }, (_, i) => `<option value="${i}" ${i === viewerIndex ? 'selected' : ''}>Soal ${i + 1}</option>`).join('');

        sec.innerHTML = `
            <div class="card card-pad">
                ${topRow}
                <div class="pb-3 border-b" style="border-color: var(--divider);">
                    <h3 class="section-title">Soal ${viewerIndex + 1} <span class="text-tertiary font-normal">/ ${total}</span></h3>
                </div>
                <div class="pt-4">${renderViewerBody(q)}</div>
                <div class="flex items-center justify-between gap-2 mt-5 pt-3 border-t" style="border-color: var(--divider);">
                    <button onclick="viewerPrev()" class="btn-icon" ${viewerIndex === 0 ? 'disabled' : ''} aria-label="Sebelumnya"><i class="fa-solid fa-chevron-left"></i></button>
                    <select onchange="viewerJump(this.value)" class="field !py-2 !px-3 !w-auto text-sm font-medium">${jump}</select>
                    <button onclick="viewerNext()" class="btn-icon" ${viewerIndex === total - 1 ? 'disabled' : ''} aria-label="Berikutnya"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>`;
    };

    window.viewerCurrent = () => viewerQuestions[viewerIndex];
    window.viewerPrev = () => { if (viewerIndex > 0) { viewerIndex--; renderViewer(); } };
    window.viewerNext = () => { if (viewerIndex < viewerQuestions.length - 1) { viewerIndex++; renderViewer(); } };
    window.viewerJump = (v) => { viewerIndex = parseInt(v) || 0; renderViewer(); };

    // Preview POV siswa (mengerjakan PR) — hasil TIDAK disimpan ke DB
    window.previewAsStudent = () => {
        if (!viewerSubject || !viewerWeek) return;
        const url = `/consultations/fill?preview=true&subject=${viewerSubject}&week=${viewerWeek}`;
        window.open(url, '_blank');
    };

    window.deleteCurrentSoal = () => {
        const q = viewerQuestions[viewerIndex];
        if (!q) return;
        window.showConfirm('Hapus Soal?', 'Soal ini akan dihapus permanen dan tidak bisa dikembalikan.', async () => {
            try {
                const res = await fetch(`${API_URL}/api/onboarding/questions/${q.id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw 0;
                window.showToast?.('success', 'Terhapus', 'Soal berhasil dihapus.');
                viewerQuestions.splice(viewerIndex, 1);
                if (accordionSummary[viewerWeek]) accordionSummary[viewerWeek][viewerSubject] = Math.max(0, (accordionSummary[viewerWeek][viewerSubject] || 1) - 1);
                isSummaryCached = false;
                if (viewerIndex >= viewerQuestions.length) viewerIndex = Math.max(0, viewerQuestions.length - 1);
                renderViewer();
                populateHome();
            } catch { window.showToast?.('danger', 'Error', 'Gagal menghapus soal.'); }
        }, { type: 'danger', confirmText: 'Hapus' });
    };

    // ---- Modal Petunjuk & Template ----
    window.openTemplateModal = () => document.getElementById('modalTemplate').classList.remove('hidden');
    window.closeTemplateModal = () => document.getElementById('modalTemplate').classList.add('hidden');

    // ---- Mode PR (modal) ----
    window.closePRModal = () => document.getElementById('modalPR').classList.add('hidden');
    window.prToggleLock = (subject, week, el) => {
        toggleLockPR(subject, week, el.checked);
        const panel = document.getElementById(`prActionPanel-${week}-${subject}`);
        if (panel) panel.classList.toggle('hidden', !el.checked);
    };
    const buildPRPanel = (subject, week, isLocked, dDays, dTime) => `
        <div class="flex items-center justify-between rounded-[var(--r-lg)] p-3 mb-3" style="background-color: var(--info-soft);">
            <div class="flex items-start gap-3">
                <div class="icon-chip" style="background-color:#fff; color: var(--info);"><i class="fa-solid fa-house-laptop"></i></div>
                <div><h4 class="caption font-semibold" style="color: var(--info);">Bagikan sebagai PR</h4><p class="text-[11px]" style="color: var(--info);">Buka gembok untuk membagikan ke murid.</p></div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input type="checkbox" class="sr-only peer" onchange="prToggleLock('${subject}', ${week}, this)" ${isLocked ? 'checked' : ''}>
                <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--info)]"></div>
            </label>
        </div>
        <div id="prActionPanel-${week}-${subject}" class="${isLocked ? 'block' : 'hidden'} space-y-3">
            <div class="grid grid-cols-2 gap-2">
                <button onclick="copyPRLink('${subject}', ${week})" class="btn !py-3 text-xs" style="background-color: var(--info); color:#fff; border-radius: var(--r-md);"><i class="fa-solid fa-link"></i> Link Biasa</button>
                <button onclick="openResetModal('${subject}', ${week})" class="btn !py-3 text-xs" style="background-color: var(--warning); color:#fff; border-radius: var(--r-md);"><i class="fa-solid fa-clock-rotate-left"></i> Link Reset</button>
            </div>
            <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
