            { q: "Misalkan kak Aziz nyuruh sesuatu, Apa yang kamu lakukan?", opts: [{t: "Gak mau ah", s: 0}, {t: "Mau, tapi...", s: 50}, {t: "Mau", s: 100}] },
            { q: "Habis ngaji, kamu langsung pulang atau bantu beresin meja?", opts: [{t: "Bantuin beresin", s: 100}, {t: "biasanya sih langsung pulang", s: 0}] },
            { q: "Kalau ada PR ngaji tapi kamu belum ngerjain, itu salah siapa?", opts: [{t: "Salahku sendiri", s: 100}, {t: "Salah temen gak ngingetin", s: 0}, {t:"salah kak Aziz bikin tugas susah banget", s:0}] }
        ],
        aktif: [
            { q: "Pas guru nanya ke kelas, kamu biasanya ngapain?", opts: [{t: "Langsung jawab dong!", s: 100}, {t: "Mau jawab tapi malu", s: 50}, {t: "Diem aja nunggu temen yang jawab", s: 0}] },
            { q: "Kalau ada temen yang sering nanya ke guru, menurutmu dia...", opts: [{t: "Hebat dan pintar", s: 100}, {t: "Caper banget", s: 0}, {t: "HEBAT BANGET!!! KEREN!", s: 20}] },
            { q: "Apa yang bikin kamu kadang gak mau nanya pelajaran?", opts: [{t: "Aku suka nanya kok", s: 100}, {t: "Takut salah / diketawain", s: 50}, {t: "Gak tau apa yang mau ditanya", s: 0}] }
        ]
    };

    formCetakEl.addEventListener('submit', async (e) => {
        e.preventDefault();
        // Tampilkan confirm modal dulu
        const siswaEl = document.getElementById('cetakSiswa');
        const siswaName = siswaEl.options[siswaEl.selectedIndex]?.dataset.name || '';
        const checkedWeeks = [...document.querySelectorAll('.cetak-pert-item:checked')].map(c => c.value);
        const mapel = cetakMapelEl.value;

        if (siswaName && checkedWeeks.length > 0) {
            document.getElementById('confirmCetakMsg').innerHTML =
                `Dengan membuat soal cetak ini, tugas <b>${mapel.toUpperCase()}</b> pertemuan <b>${checkedWeeks.map(w => `Mg-${w}`).join(', ')}</b> untuk <b>${siswaName}</b> akan ditandai <b>sudah dikerjakan (belum dinilai)</b>. Input nilainya nanti di halaman detail siswa.`;
            document.getElementById('modalConfirmCetak').classList.replace('hidden', 'flex');
        } else {
            await doGeneratePdf();
        }
    });

    document.getElementById('btnConfirmCetakYa').onclick = async () => {
        document.getElementById('modalConfirmCetak').classList.replace('flex', 'hidden');
        await doGeneratePdf();
    };
    document.getElementById('btnConfirmCetakBatal').onclick = () =>
        document.getElementById('modalConfirmCetak').classList.replace('flex', 'hidden');

    const doGeneratePdf = async () => {
        const btn = document.getElementById('btnCetakPreview');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        try {
            await generatePdf();
        } catch (error) {
            console.error("PDF Generation Error:", error);
            window.showToast?.('danger', 'Error', 'Gagal membuat PDF. Cek konsol untuk detail.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            btn.querySelector('.spinner')?.style && (btn.querySelector('.spinner').style.display = 'none');
        }
    };


    // Muat script eksternal sekali saja (di-cache per-src)
    const _scriptCache = {};
    const loadScript = (src) => _scriptCache[src] || (_scriptCache[src] = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src; s.onload = resolve; s.onerror = () => reject(new Error('Gagal memuat ' + src));
        document.head.appendChild(s);
    }));

    // Cache respons soal cetak per-URL biar gak ngehit endpoint berkali-kali
    const printQuestionCache = new Map();

    const generatePdf = async () => {
        const subject = document.getElementById('cetakMapel').value;
        const checkedWeeks = [...document.querySelectorAll('.cetak-pert-item:checked')].map(c => c.value);
        const limit = document.getElementById('cetakJumlah').value;
        const category = document.getElementById('cetakKategori').value;
        const includeImages = document.getElementById('cetakSertakanGambar').checked;
        const includeAkhlak = document.getElementById('cetakSertakanAkhlak').checked;
        const siswaEl = document.getElementById('cetakSiswa');
        const siswaName = siswaEl.options[siswaEl.selectedIndex]?.dataset.name || '';
        const siswaId = siswaEl.value;

        // Ambil soal dari semua pertemuan yang dipilih, gabungkan
        let raw = [];
        for (const week of checkedWeeks) {
            const url = `${API_URL}/api/exams/questions-for-print?subject=${subject}&limit=999&category=${category}&includeImages=${includeImages}&week=${week}`;
            let cached = printQuestionCache.get(url);
            if (!cached) {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) throw new Error('Gagal mengambil data soal akademis');
                cached = await res.json() || [];
                printQuestionCache.set(url, cached);
            }
            raw = raw.concat(cached);
        }

        // Shuffle (Fisher-Yates) + ambil sejumlah limit -> tiap download beda soal & beda urutan
        const shuffle = (arr) => {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        };
        // Salin (jangan mutasi cache). Tipe 'drag'/blank dibiarkan -> nanti jadi soal essai.
        let questions = shuffle(raw.map(q => ({ ...q }))).slice(0, Number(limit) || raw.length);

        if (includeAkhlak) {
            const akhlakQs = [
                ...AKHLAK_ADAB_QUESTIONS.akhlak,
                ...AKHLAK_ADAB_QUESTIONS.disiplin,
                ...AKHLAK_ADAB_QUESTIONS.aktif
            ];
            const shuffledAkhlak = akhlakQs.sort(() => 0.5 - Math.random()).slice(0, 5); // Ambil 5 soal akhlak acak

            const formattedAkhlak = shuffledAkhlak.map(q => ({
                ...q,
                type: 'pilgan',
                options: q.opts.reduce((acc, opt, i) => {
                    acc[String.fromCharCode(65 + i)] = opt.t;
                    return acc;
                }, {}),
                isAkhlak: true
            }));
            questions.push(...formattedAkhlak);
        }

        if (questions.length === 0) {
            window.showToast?.('warning', 'Tidak Ditemukan', 'Tidak ada soal yang cocok dengan kriteria Anda.');
            return;
        }

        // --- Normalisasi jadi daftar item (section + soal), penomoran berurutan ---
        const stripHtml = (s) => {
            const d = document.createElement('div');
            d.innerHTML = s ?? '';
            return (d.textContent || '').replace(/\s+/g, ' ').trim();
        };
        const normOpts = (o) => Object.entries(o || {}).map(([k, v]) => [k, stripHtml(v)]);
        const isEssay = (q) => q.type === 'drag' || q.type === 'essay' || /\[BLANK\]/i.test(q.question || '');

        const academicQuestions = questions.filter(q => !q.isAkhlak);
        const akhlakQuestions = questions.filter(q => q.isAkhlak);
        // Soal blank/drag -> essai, dikumpulkan di bawah pilgan & true/false
        const academicPilgan = academicQuestions.filter(q => !isEssay(q));
        const academicEssay = academicQuestions.filter(q => isEssay(q));

        const items = [];
        if (academicQuestions.length > 0) {
            items.push({ type: 'section', title: 'Soal Akademis' });
            academicPilgan.forEach(q => items.push({
                type: 'q', text: stripHtml(q.question), options: normOpts(q.options),
                image_url: includeImages ? q.image_url : null,
            }));
            academicEssay.forEach(q => items.push({
                type: 'essay', text: stripHtml(q.question).replace(/\[BLANK\]/gi, '________'),
                image_url: includeImages ? q.image_url : null,
            }));
        }
        if (akhlakQuestions.length > 0) {
            items.push({ type: 'section', title: 'Soal Kepribadian (Akhlak & Adab)' });
            akhlakQuestions.forEach(q => items.push({
                type: 'q', text: stripHtml(q.q), options: normOpts(q.options), image_url: null,
            }));
        }
        const totalSoal = items.filter(i => i.type === 'q' || i.type === 'essay').length;

        // Teks Arab tidak bisa dirender font vektor jsPDF -> render sbagian Arab jadi gambar
        // kecil via html2canvas (browser yg bentuk hurufnya), sisanya tetap teks vektor.
        const NUMW = 9;                 // lebar kolom nomor (tetap, biar lebar gambar bisa dihitung)
        const hasArabic = (s) => /[؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿]/.test(s || '');
        const needArabic = items.some(i => (i.type === 'q' || i.type === 'essay') &&
            (hasArabic(i.text) || (i.options || []).some(([, v]) => hasArabic(v))));

        if (needArabic) {
            await loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js');
            const snapshot = async (host, widthMm) => {
                host.style.position = 'absolute'; host.style.left = '-99999px'; host.style.top = '0';
                host.style.width = (widthMm / 25.4 * 96) + 'px';
                document.body.appendChild(host);
                // bg putih WAJIB: JPEG tak punya alpha, transparan -> jadi hitam pekat
                const canvas = await html2canvas(host, { scale: 2, backgroundColor: '#ffffff' });
                document.body.removeChild(host);
                return { data: canvas.toDataURL('image/jpeg', 0.9), wMm: widthMm, hMm: (canvas.height / 2) / 96 * 25.4 };
            };
            // Times New Roman -> punya glyph Arab di Windows, fallback aman
            const ARFONT = "'Times New Roman','Traditional Arabic','Amiri',serif";
            // Soal ber-Arab dirender UTUH (pertanyaan + opsi) jadi 1 gambar TNR,
            // biar gak kepotong / gak belang antara teks vektor & gambar.
            const soalDiv = (it) => {
                const d = document.createElement('div');
                d.style.cssText = `font-family:${ARFONT};font-size:13pt;line-height:1.6;color:#000;background:#fff;padding:1px 2px;`;
                const q = document.createElement('div');
                q.textContent = it.text;
                d.appendChild(q);
                if (it.type !== 'essay' && (it.options || []).length) {
                    const g = document.createElement('div');
                    g.style.cssText = 'display:grid;grid-template-columns:1fr 1fr;gap:2px 12px;margin-top:6px;';
                    it.options.forEach(([k, v]) => { const c = document.createElement('div'); c.textContent = `${k}. ${v}`; g.appendChild(c); });
                    d.appendChild(g);
                }
                return d;
            };
            const bodyW = 210 - 2 * 15 - NUMW; // 180mm - kolom nomor
            for (const it of items) {
                if (it.type !== 'q' && it.type !== 'essay') continue;
                if (hasArabic(it.text) || (it.options || []).some(([, v]) => hasArabic(v))) {
                    it.fullImg = await snapshot(soalDiv(it), bodyW);
                }
            }
        }

        // Preload gambar -> dataURL JPEG (re-encode biar file kecil, hindari 40MB PNG)
        const imgMap = new Map();
        await Promise.all(items.filter(i => i.image_url).map(i => new Promise(res => {
            const im = new Image();
            im.crossOrigin = 'anonymous';
            im.onload = () => {
                try {
                    const cv = document.createElement('canvas');
                    cv.width = im.naturalWidth; cv.height = im.naturalHeight;
                    cv.getContext('2d').drawImage(im, 0, 0);
                    imgMap.set(i.image_url, { data: cv.toDataURL('image/jpeg', 0.72), ratio: im.naturalHeight / im.naturalWidth });
                } catch (e) { /* tainted / CORS -> lewati gambar */ }
                res();
            };
            im.onerror = () => res();
            im.src = i.image_url;
        })));

        // --- Render PDF vektor via jsPDF (teks bisa diseleksi, ukuran KB) ---
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: 'mm', format: 'a4' });

        const M = 15, PW = 210, PH = 297, CW = PW - 2 * M;
        const lineH = 5.2, BASE = 3.8, gap = 8; // gap = ruang antar soal
        let y = M;
        let pageStartNum = 1, lastNum = 0;

        const footer = () => {
            doc.setFont('helvetica', 'normal').setFontSize(9).setTextColor(130);
            doc.text(`Soal ${pageStartNum}–${Math.max(lastNum, pageStartNum)} dari ${totalSoal}`, PW / 2, PH - 9, { align: 'center' });
            doc.setTextColor(0);
        };
        const newPage = () => { footer(); doc.addPage(); y = M; pageStartNum = lastNum + 1; };
        const ensureSpace = (h) => { if (y + h > PH - 16) newPage(); };

        // Header (hanya halaman 1)
        doc.setFont('helvetica', 'bold').setFontSize(16);
        doc.text(`SOAL ${subject.toUpperCase()}`, PW / 2, y + 5, { align: 'center' });
        doc.setFont('helvetica', 'normal').setFontSize(11);
        doc.text('Pengajian Mushola Nurul Hidayah', PW / 2, y + 11, { align: 'center' });
        y += 15;
        doc.setLineWidth(0.4); doc.line(M, y, PW - M, y);
        y += 8;

        // Baris: Nama : ...   Tanggal : ...   [ Nilai : ... ]
        const boxW = 42, boxH = 12, boxX = PW - M - boxW, rowY = y;
        doc.setDrawColor(0); doc.setLineWidth(0.4);
        doc.roundedRect(boxX, rowY - 6, boxW, boxH, 1.5, 1.5);
        doc.setFont('helvetica', 'bold').setFontSize(11);
        doc.text('Nilai :', boxX + 3, rowY + 1.5);
        doc.setFont('helvetica', 'normal');
        doc.text(`Nama    : ${siswaName || '...............................'}`, M, rowY + 1);
        doc.text('Tanggal : ..................', M + 75, rowY + 1);
        y = rowY + boxH;

        doc.setFont('helvetica', 'bold').setFontSize(10.5);
        const instr = doc.splitTextToSize('Silahkan kerjakan soal di bawah ini dengan memberikan tanda silang (X) pada jawaban yang paling benar!', CW);
        instr.forEach((ln, i) => doc.text(ln, M, y + BASE + i * lineH));
        y += instr.length * lineH + 4;

        let num = 0;
        for (const it of items) {
            if (it.type === 'section') {
                ensureSpace(lineH + 6);
                doc.setFont('helvetica', 'bold').setFontSize(12.5);
                doc.text(it.title, M, y + BASE);
                doc.setLineWidth(0.2); doc.setDrawColor(180);
                doc.line(M, y + lineH, PW - M, y + lineH);
                doc.setDrawColor(0);
                y += lineH + 4;
                continue;
            }
            num++;
            const isEssayItem = it.type === 'essay';

            const numStr = `${num}.`;
            const textX = M + NUMW;
            const textW = CW - NUMW;

            const img = imgMap.get(it.image_url);
            const imgW = img ? Math.min(56, textW) : 0; // 80% dari 70mm
            const imgH = img ? imgW * img.ratio : 0;

            // Soal ber-gambar (jalur vektor): teks+opsi di KIRI, gambar di KANAN
            const sideImg = img && !it.fullImg;
            const bodyW = sideImg ? textW - imgW - 6 : textW;
            const colW = bodyW / 2;
            const optEntries = isEssayItem ? [] : it.options;

            let bodyH;
            if (it.fullImg) {
                bodyH = it.fullImg.hMm;
            } else {
                doc.setFont('helvetica', 'normal').setFontSize(11);
                var qLines = doc.splitTextToSize(it.text, bodyW);
                let optH = 0;
                for (let r = 0; r < optEntries.length; r += 2) {
                    const l = doc.splitTextToSize(`${optEntries[r][0]}. ${optEntries[r][1]}`, colW - 3);
                    const rt = optEntries[r + 1] ? doc.splitTextToSize(`${optEntries[r + 1][0]}. ${optEntries[r + 1][1]}`, colW - 3) : [];
                    optH += Math.max(l.length, rt.length) * lineH;
                }
                bodyH = qLines.length * lineH + 2 + optH;
            }
            const answerH = isEssayItem ? 3 + 8 : 0; // essai: 1 baris jawaban (jarak 8mm)
            const contentH = bodyH + answerH;
            const blockH = sideImg ? Math.max(contentH, imgH) : contentH + (img ? imgH + 4 : 0);

            ensureSpace(blockH);
            const blockTop = y;

            // Nomor besar & tebal -> mencolok
            doc.setFont('helvetica', 'bold').setFontSize(14);
            doc.text(numStr, M, y + BASE + 0.6);

            // Gambar kanan (sejajar soal)
            if (sideImg) {
                const ix = textX + bodyW + 6;
                try { doc.addImage(img.data, 'JPEG', ix, blockTop, imgW, imgH); } catch (e) { /* skip */ }
                doc.setDrawColor(160); doc.setLineWidth(0.3);
                doc.rect(ix, blockTop, imgW, imgH);
                doc.setDrawColor(0);
            }

            if (it.fullImg) {
                try { doc.addImage(it.fullImg.data, 'JPEG', textX, y, it.fullImg.wMm, it.fullImg.hMm); } catch (e) { /* skip */ }
                y += it.fullImg.hMm;
            } else {
                // Pertanyaan (teks vektor)
                doc.setFont('helvetica', 'normal').setFontSize(11);
                qLines.forEach((ln, i) => doc.text(ln, textX, y + BASE + i * lineH));
                y += qLines.length * lineH;
                // Opsi 2 kolom
                y += 2;
                for (let r = 0; r < optEntries.length; r += 2) {
                    const l = doc.splitTextToSize(`${optEntries[r][0]}. ${optEntries[r][1]}`, colW - 3);
                    const rt = optEntries[r + 1] ? doc.splitTextToSize(`${optEntries[r + 1][0]}. ${optEntries[r + 1][1]}`, colW - 3) : [];
                    l.forEach((ln, i) => doc.text(ln, textX, y + BASE + i * lineH));
                    rt.forEach((ln, i) => doc.text(ln, textX + colW, y + BASE + i * lineH));
                    y += Math.max(l.length, rt.length) * lineH;
                }
            }

            // Gambar bawah (hanya jalur fullImg/Arab yang gak sejajar)
            if (img && !sideImg) {
                y += 2;
                try { doc.addImage(img.data, 'JPEG', textX, y, imgW, imgH); } catch (e) { /* skip */ }
                doc.setDrawColor(160); doc.setLineWidth(0.3);
                doc.rect(textX, y, imgW, imgH);
                doc.setDrawColor(0);
                y += imgH + 2;
            }

            // Baris jawaban essai
            if (isEssayItem) {
                y += 3;
                doc.setDrawColor(150); doc.setLineWidth(0.2);
                y += 8; doc.line(textX, y, (sideImg ? textX + bodyW : PW - M), y);
                doc.setDrawColor(0);
            }

            // Kalau gambar kanan lebih tinggi dari konten, dorong y biar gak ketiban
            if (sideImg) y = Math.max(y, blockTop + imgH);

            lastNum = num;
            y += gap; // ruang antar soal
        }
        footer();

        window.open(doc.output('bloburl'), '_blank');

        // Mark pertemuan "sudah dicetak" (belum dinilai) untuk siswa yang dipilih.
        // is_graded:false → tetap muncul di detail siswa sbg "belum dinilai" sampai guru input nilai.
        if (siswaId && checkedWeeks.length > 0) {
            const subject = document.getElementById('cetakMapel').value;
            await Promise.all(checkedWeeks.map(week =>
                fetch(`${API_URL}/api/grades/manual`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: siswaId, subject, week: parseInt(week), score: 0, with_penalty: false, mark_completed: true, is_graded: false })
                })
            ));
        }
    };

</script>


