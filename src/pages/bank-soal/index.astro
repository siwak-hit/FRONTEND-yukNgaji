    // Terima file dari sumber apa pun → tutup modal → kompres → upload async dgn overlay.
    const startImageUpload = async (file) => {
        if (!file || !imgUploadTarget) return;
        if (!file.type.startsWith('image/')) { window.showToast?.('warning', 'Bukan Gambar', 'File yang dipilih bukan gambar.'); return; }
        const { imgInput, previewWrap } = imgUploadTarget;
        closeImgUploader();

        const localUrl = URL.createObjectURL(file);
        const ui = showUploadingPreview(previewWrap, localUrl);
        window.pendingImgUploads++;
        markDirty?.(); isDirty = true;
        try {
            const { blob, ext } = await compressToWebp(file);
            const finalUrl = await uploadWithProgress(blob, ext, ui.progress);
            imgInput.value = finalUrl;
            ui.done(finalUrl);
        } catch (err) {
            imgInput.value = "";
            ui.fail(err.message || 'Gagal upload');
            window.showToast?.('danger', 'Gagal Upload', err.message || 'Terjadi kesalahan.');
        } finally {
            window.pendingImgUploads--;
            URL.revokeObjectURL(localUrl);
        }
    };

