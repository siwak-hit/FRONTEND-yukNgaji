    window.executeBulk = () => {
        const checked = [...document.querySelectorAll('#bulkChecklist .bulk-item:checked')];
        if (!checked.length) return window.showToast?.('warning', 'Perhatian', 'Pilih minimal 1 item.');
        const vals = checked.map(cb => cb.value);
        const title = bulkType === 'soal' ? 'Hapus Soal Terpilih?'
            : bulkType === 'mapel' ? 'Hapus Mapel Terpilih?'
            : 'Hapus Pertemuan Terpilih?';
        const msg = bulkType === 'soal' ? `${vals.length} soal akan dihapus permanen.`
            : bulkType === 'mapel' ? `${vals.length} mapel di Pertemuan ${viewerWeek} beserta SEMUA soalnya akan dihapus permanen.`
            : `${vals.length} pertemuan beserta SEMUA mapel & soal di dalamnya akan dihapus permanen.`;

        window.showConfirm(title, msg, async () => {
            const btn = document.getElementById('btnExecuteBulk');
            const old = btn.innerHTML; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menghapus...'; btn.disabled = true;
            try {
                let ids = [];
                if (bulkType === 'soal') {
                    ids = vals;
                } else if (bulkType === 'mapel') {
                    for (const s of vals) ids.push(...await fetchQuestionIds(viewerWeek, s));
                } else {
                    for (const w of vals) for (const s of SUBJECTS) { if ((accordionSummary[w] || {})[s] > 0) ids.push(...await fetchQuestionIds(w, s)); }
                }
                await Promise.all(ids.map(id => fetch(`${API_URL}/api/onboarding/questions/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } })));
                window.showToast?.('success', 'Berhasil', `${ids.length} soal dihapus.`);
                isSummaryCached = false;
                Object.keys(soalCache).forEach(k => delete soalCache[k]);
                await fetchAccordion();
