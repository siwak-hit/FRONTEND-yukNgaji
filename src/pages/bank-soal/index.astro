        if (!dz) return;
        dz.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => { if (fileInput.files[0]) { startImageUpload(fileInput.files[0]); fileInput.value = ''; } });
        dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-green-500', 'bg-green-50/40'); });
        dz.addEventListener('dragleave', () => dz.classList.remove('border-green-500', 'bg-green-50/40'));
        dz.addEventListener('drop', (e) => { e.preventDefault(); const f = e.dataTransfer.files[0]; if (f) startImageUpload(f); });
        // Paste hanya saat modal terbuka
        document.addEventListener('paste', (e) => {
            if (document.getElementById('modalImgUpload').classList.contains('hidden')) return;
            const item = [...(e.clipboardData?.items || [])].find(i => i.type.startsWith('image/'));
