---
import Layout from '../../layouts/Layout.astro';
import NavbarGuru from '../../components/NavbarGuru.astro';
import Toast from '../../components/Toast.astro';
import ModalAlert from '../../components/ModalAlert.astro';
---

<Layout title="Bank Soal - yukNgaji">
    <div class="px-6 py-8 pb-32 min-h-screen flex flex-col">

        <header class="flex justify-between items-start mb-6">
            <div class="min-w-0">
                <p class="eyebrow mb-1">Manajemen Kuesioner</p>
                <h1 class="page-title">Bank Soal</h1>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
                <div class="relative">
                    <button id="btnDownloadGroup" class="btn-icon" aria-label="Opsi download" title="Opsi download">
                        <i class="fa-solid fa-download"></i>
                    </button>
                    <div id="downloadMenu" class="absolute top-full right-0 mt-2 w-48 bg-white rounded-2xl shadow-lg border border-gray-100 p-2 z-20 hidden animate-fade-in-fast">
                        <button onclick="openTemplateModal()" class="w-full text-left text-sm font-semibold text-gray-700 px-4 py-2.5 rounded-lg hover:bg-gray-100 flex items-center gap-3"><i class="fa-solid fa-file-lines w-4 text-center"></i> Template</button>
                        <button onclick="openCetakModal()" class="w-full text-left text-sm font-semibold text-gray-700 px-4 py-2.5 rounded-lg hover:bg-gray-100 flex items-center gap-3"><i class="fa-solid fa-print w-4 text-center"></i> Cetak Soal</button>
                    </div>
                </div>
                <button id="btnOpenUpload" class="fab" aria-label="Tambah soal">
                    <i class="fa-solid fa-plus text-lg"></i>
                </button>
            </div>
        </header>

        <a href="/exams" class="card card-interactive card-pad mb-6 flex items-center justify-between" style="background-color: var(--ink);">
            <div class="flex items-center gap-4 min-w-0">
                <div class="icon-chip" style="background-color: rgba(255,255,255,0.12); color: #fff;">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-base font-semibold mb-0.5 flex items-center flex-wrap gap-1.5" style="color:#fff; letter-spacing: var(--tracking-snug);">
                        Ujian &amp; Evaluasi
                        <span class="badge" style="background-color: var(--accent); color:#fff;">Baru</span>
                    </h2>
                    <p class="text-[11px] leading-tight" style="color: rgba(255,255,255,0.72);">Buat ujian khusus dengan timer, gambar, &amp; hint.</p>
                </div>
            </div>
            <i class="fa-solid fa-chevron-right text-sm flex-shrink-0" style="color: rgba(255,255,255,0.4);"></i>
        </a>

        <section class="flex-1">
            <button id="btnPilihPertemuan" onclick="openPilihModal()" class="card card-interactive card-pad w-full flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);"><i class="fa-solid fa-layer-group text-lg"></i></div>
                    <div class="text-left">
                        <h3 class="section-title">Pilih Pertemuan</h3>
                        <p id="pilihSubtitle" class="caption mt-0.5">Lihat &amp; kelola soal per mapel</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-tertiary text-xs"></i>
            </button>

            <div id="bankSoalEmpty" class="empty-state hidden">
                <div class="empty-icon"><i class="fa-solid fa-book-open text-2xl"></i></div>
                <p class="caption font-semibold">Belum ada soal dibuka</p>
                <p class="text-[11px] text-tertiary mt-1">Tekan "Pilih Pertemuan" untuk menampilkan soal.</p>
            </div>

            <div id="soalViewerSection" class="hidden"></div>

            <!-- legacy container (tak dipakai, jaga-jaga referensi lama) -->
            <div id="accordionContainer" class="hidden"></div>
        </section>
    </div>

    <div id="modalUpload" class="modal-overlay hidden">
        <div class="modal-sheet">
            <div class="sheet-grabber"></div>
            <div class="flex justify-between items-center mb-6">
                <h3 class="section-title">Tambah Soal Baru</h3>
                <button onclick="closeUpload()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <form id="formUpload" class="space-y-4">
                <div>
                    <label class="field-label">Mata Pelajaran</label>
                    <select id="upSubject" class="field field-sunken">
                        <option value="tajwid">Tajwid</option>
                        <option value="fiqih">Fiqih</option>
                        <option value="tauhid">Tauhid</option>
                    </select>
                </div>

                <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
                    <p class="field-label !mb-2">Target Pertemuan</p>
                    <div class="space-y-1">
                        <label class="flex items-center gap-3 cursor-pointer p-2 rounded-xl hover:bg-white transition-colors">
                            <input type="radio" name="weekMode" value="baru" checked class="accent-[var(--accent)]">
                            <div>
                                <p class="caption font-semibold text-ink">Pertemuan Baru</p>
                                <p class="text-[11px] text-tertiary" id="labelPertemuanBaru">Otomatis ke minggu berikutnya</p>
                            </div>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer p-2 rounded-xl hover:bg-white transition-colors">
                            <input type="radio" name="weekMode" value="sisipan" class="accent-[var(--accent)]">
                            <div>
                                <p class="caption font-semibold text-ink">Sisipan / Tambah ke Pertemuan Lama</p>
                                <p class="text-[11px] text-tertiary">Pilih minggu yang sudah ada atau kosong</p>
                            </div>
                        </label>
                    </div>

                    <div id="sisipanDropdownWrap" class="hidden mt-3">
                        <select id="sisipanWeek" class="field">
                            <option value="">Pilih minggu...</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="field-label">File Template (.txt) <span class="text-tertiary normal-case font-normal tracking-normal">(opsional)</span></label>
                    <input type="file" id="upFile" accept=".txt" class="w-full text-sm text-secondary file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-[var(--accent-soft)] file:text-[var(--accent-strong)] cursor-pointer">
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button type="submit" class="btn btn-primary !rounded-[var(--r-md)] text-sm">
                        <i class="fa-solid fa-file-arrow-up"></i> Upload File
                    </button>
                    <button type="button" onclick="openManualFromModal()" class="btn btn-secondary !rounded-[var(--r-md)] text-sm">
                        <i class="fa-solid fa-pen"></i> Input Manual
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="modalPreview" class="fixed inset-0 z-[60] hidden flex flex-col h-screen overflow-hidden" style="background-color: var(--parchment);">
        <!-- Header overlay -->
        <header class="w-full px-5 py-3.5 border-b flex justify-between items-center flex-shrink-0" style="background-color: var(--canvas); border-color: var(--hairline);">
            <button onclick="closePreview()" class="btn-icon" aria-label="Kembali"><i class="fa-solid fa-chevron-left"></i></button>
            <div class="text-center">
                <p class="eyebrow">Bank Soal</p>
                <h3 class="section-title leading-tight">Preview &amp; Edit Soal</h3>
            </div>
            <button id="btnFinalSave" class="btn btn-primary !py-2.5 !px-5 text-sm">Simpan</button>
        </header>

        <!-- Toolbar mapel & target -->
        <div class="px-5 py-3 border-b flex items-center gap-2.5 flex-shrink-0 flex-wrap" style="background-color: var(--canvas); border-color: var(--hairline);">
            <span class="eyebrow">Mapel</span>
            <span id="previewSubjectLabel" class="badge badge-accent uppercase">-</span>
            <span class="eyebrow ml-1">Target Pertemuan</span>
            <div class="flex items-center gap-1.5">
                <span class="caption font-semibold text-secondary">MG-</span>
                <input type="number" id="targetWeek" value="1" min="1" class="field !w-14 !py-1.5 !px-2 text-center font-bold text-accent">
            </div>
        </div>

        <!-- Area konten + FAB -->
        <div class="flex-1 overflow-hidden relative">
            <div id="previewContent" class="h-full overflow-y-auto no-scrollbar max-w-md mx-auto w-full p-4 sm:p-5 space-y-4 pb-28"></div>

            <!-- FAB tambah soal (pojok kanan bawah) -->
            <div class="absolute inset-0 pointer-events-none max-w-md mx-auto w-full">
                <button id="btnTambahManual" onclick="addNewQuestionField()"
                    class="btn btn-primary pointer-events-auto absolute bottom-6 right-5 !py-3.5 !px-5 gap-2"
                    style="box-shadow: var(--shadow-accent);" title="Tambah soal baru">
                    <i class="fa-solid fa-plus"></i> Soal Baru
                </button>
            </div>
        </div>
    </div>

    <div id="modalEditSoal" class="fixed inset-0 bg-black/60 z-[70] hidden items-end sm:items-center justify-center p-0 sm:p-4 backdrop-blur-sm">
        <div class="bg-white w-full h-[90vh] sm:h-auto sm:max-h-[90vh] sm:max-w-md rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl overflow-y-auto no-scrollbar card-core-logic flex flex-col animate-slide-up">
            <div class="flex justify-between items-center mb-4 shrink-0">
                <h3 class="font-bold text-gray-800">Edit Soal</h3>
                <button onclick="closeEditSoal()" class="w-8 h-8 flex items-center justify-center bg-gray-100 rounded-full text-gray-500 active:scale-95"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <div class="flex-1 space-y-4">
                <input type="hidden" id="editSoalId">
                
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <label class="text-[10px] font-bold text-gray-500 uppercase ml-1 shrink-0">Tipe Soal:</label>
                    <select id="editSoalType" onchange="toggleEditType()" class="type-input text-xs font-bold border border-gray-200 bg-white rounded-lg px-3 py-2.5 outline-none shadow-sm w-full sm:flex-1 text-gray-700 focus:ring-2 focus:ring-blue-400">
                        <option value="pilgan">Pilihan Ganda</option>
                        <option value="tf">Benar / Salah</option>
                        <option value="drag">Drag & Drop (Menghubungkan)</option>
                        <option value="urutan">Mengurutkan (Puzzle)</option>
                    </select>
                </div>

                <div id="editDragHint" class="drag-tools hidden p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl flex flex-col gap-3">
                    <div class="flex items-start gap-2.5">
                        <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-500 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                        </div>
                        <p class="text-[10px] text-indigo-900 leading-relaxed font-medium">
                            <b class="text-indigo-700">Mode Drag & Drop:</b><br>
                            Klik tombol di bawah untuk menyisipkan kolom kosong pada soal.
                        </p>
                    </div>
                    <button type="button" onclick="insertBlank(this)" class="w-full text-[10px] font-bold bg-indigo-600 text-white px-4 py-3 rounded-lg hover:bg-indigo-700 transition-colors shadow-md shadow-indigo-600/20 active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus"></i> Sisipkan [BLANK]
                    </button>
                </div>

                <div class="urutan-tools hidden p-3 bg-teal-50 border border-teal-100 rounded-xl flex items-center gap-3 mt-3 w-full">
                    <div class="w-8 h-8 rounded-full bg-teal-200 text-teal-700 flex items-center justify-center shrink-0"><i class="fa-solid fa-list-ol"></i></div>
                    <p class="text-[10px] font-bold text-teal-800 leading-relaxed">Mode Mengurutkan aktif.<br>Masukkan opsi secara acak. Tentukan <b>URUTAN BENARNYA</b> di bagian Kunci Jawaban bawah.</p>
                </div>

                <div>
                    <label class="text-[10px] font-bold text-gray-400 uppercase">Pertanyaan</label>
                    <textarea id="editSoalQ" rows="3" class="q-input w-full mt-1 p-3 bg-gray-50 rounded-xl text-sm font-bold border border-gray-200 focus:ring-2 focus:ring-blue-400 outline-none" oninput="updateDragKeys(this)"></textarea>
                    <div class="mt-3">
                        <label class="text-[10px] font-bold text-gray-400 uppercase">Gambar / GIF (Opsional)</label>
                        <div class="flex items-center gap-2 mt-1">
                            <input type="text" id="editSoalImg" placeholder="https://... atau upload file" class="img-input flex-1 p-3 bg-gray-50 rounded-xl text-xs font-bold border border-gray-200 outline-none focus:ring-2 focus:ring-blue-400" oninput="previewEditImg(this.value)">
                            <button type="button" onclick="openImgUploader(this)" data-edit-modal="1" class="shrink-0 w-10 h-10 bg-green-50 border border-green-200 rounded-xl flex items-center justify-center cursor-pointer hover:bg-green-100 transition-colors" title="Upload / tempel / seret gambar">
                                <i class="fa-solid fa-upload text-green-600 text-sm"></i>
                            </button>
                        </div>
                        <div id="editImgPreview" class="hidden mt-2">
                            <img id="editImgPreviewEl" src="" class="max-h-28 rounded-xl border border-gray-200 object-contain" onerror="document.getElementById('editImgPreview').classList.add('hidden')">
                        </div>
                    </div>
                </div>
                
                <div id="editOptionsWrapper" class="options-wrapper flex flex-col gap-2 w-full"></div>
                <button type="button" id="editBtnAddOption" class="btn-add-option text-[10px] font-bold text-blue-500 w-full p-3 border-2 border-dashed border-blue-200 bg-blue-50 hover:bg-blue-100 rounded-xl transition-colors active:scale-95 text-center mt-2" onclick="addOptionRow(this)">+ Tambah Pilihan Jawaban</button>

                <div id="editTfWrapper" class="tf-wrapper hidden p-3 bg-blue-50 border border-blue-100 rounded-xl flex items-center gap-3 mt-3">
                    <div class="w-8 h-8 rounded-full bg-blue-200 text-blue-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-toggle-on"></i></div>
                    <p class="text-[10px] font-bold text-blue-700 leading-relaxed">Mode Benar/Salah aktif. Opsi jawaban otomatis menjadi A (Benar) dan B (Salah).</p>
                </div>

                <div class="flex flex-col gap-4 mt-4 bg-gray-50 p-4 rounded-xl border border-gray-100">
                    
                    <div class="key-standard flex flex-col sm:flex-row sm:items-center gap-2">
                        <span class="text-[10px] font-bold text-gray-400 shrink-0">KUNCI JAWABAN:</span>
                        <select id="editSoalKey" class="key-input text-xs font-bold border border-gray-200 bg-white text-green-700 rounded-lg px-3 py-2.5 shadow-sm outline-none w-full sm:flex-1"></select>
                    </div>
                    
                    <div id="editKeyDrag" class="key-drag hidden w-full">
                        <span class="text-[10px] font-bold text-gray-400 mb-2 block">KUNCI JAWABAN DRAG & DROP:</span>
                        <div class="drag-keys-container grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
                    </div>

                    <div class="key-urutan hidden w-full">
                        <span class="text-[10px] font-bold text-gray-400 mb-2 block">KUNCI JAWABAN URUTAN:</span>
                        <div class="urutan-keys-container flex flex-col gap-2"></div>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 pt-4 border-t border-gray-200">
                        <span class="text-[10px] font-bold text-gray-400 shrink-0">LEVEL KESULITAN:</span>
                        <select id="editSoalLevel" class="level-input text-xs font-bold border border-gray-200 bg-white text-indigo-700 rounded-lg px-3 py-2.5 shadow-sm outline-none w-full sm:flex-1">
                            <option value="mudah">Mudah</option>
                            <option value="sedang">Sedang</option>
                            <option value="sulit">Sulit</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <button onclick="submitEditSoal()" class="shrink-0 w-full py-4 mt-5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl shadow-lg shadow-blue-600/30 active:scale-95 transition-all">
                <i class="fa-solid fa-floppy-disk mr-2"></i>Simpan Perubahan
            </button>
        </div>
    </div>

    <!-- Modal upload gambar: paste clipboard / drag-drop / pilih file -->
    <div id="modalImgUpload" class="fixed inset-0 bg-black/60 z-[110] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-md rounded-2xl p-5 shadow-2xl relative animate-slide-up border border-gray-100">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-black text-gray-800 text-base"><i class="fa-solid fa-image text-green-600 mr-2"></i>Tambah Gambar</h3>
                <button type="button" onclick="closeImgUploader()" class="w-8 h-8 rounded-full hover:bg-gray-100 text-gray-400"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div id="imgDropZone" tabindex="0" class="border-2 border-dashed border-gray-300 rounded-2xl p-6 text-center cursor-pointer hover:border-green-400 hover:bg-green-50/40 transition-colors outline-none focus:border-green-500 focus:bg-green-50/40">
                <i class="fa-solid fa-cloud-arrow-up text-3xl text-gray-300 mb-2"></i>
                <p class="text-xs font-bold text-gray-600">Klik untuk pilih file</p>
                <p class="text-[11px] text-gray-400 mt-1">atau <b>tempel (Ctrl+V)</b> / seret gambar ke sini</p>
                <p class="text-[10px] text-gray-300 mt-2">Otomatis dikompres ke WebP · GIF tetap animasi</p>
            </div>
            <input type="file" id="imgUploadFileInput" accept="image/*,image/gif" class="hidden">
        </div>
    </div>

    <div id="modalConfirmBack" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-2xl p-6 shadow-2xl relative animate-slide-up text-center border border-gray-100">
            <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 border border-amber-100 shadow-inner">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="font-black text-gray-800 text-lg mb-2">Perubahan Belum Disimpan!</h3>
            <p class="text-xs font-bold text-gray-500 leading-relaxed mb-6">
                Anda memiliki soal yang baru diketik/diedit dan belum disimpan. Yakin ingin menutup editor?
            </p>
            <div class="flex gap-3">
                <button onclick="closeConfirmBack()" class="flex-1 py-3 bg-gray-100 text-gray-500 font-bold rounded-xl active:scale-95 transition-all">Batal</button>
                <button onclick="forceCloseAction()" class="flex-1 py-3 bg-red-600 text-white font-bold rounded-xl shadow-md shadow-red-600/20 active:scale-95 transition-all">Ya, Tutup</button>
            </div>
        </div>
    </div>

    

    <!-- [BARU] MODAL INGATKAN SISWA (push notif ke yang belum ngerjain) -->
    <div id="modalRemindPR" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-[2rem] p-6 shadow-2xl">
            <div class="text-center mb-4">
                <div class="w-14 h-14 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center text-2xl mx-auto mb-2 border border-emerald-100 shadow-inner">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <h3 class="font-black text-gray-800 text-lg leading-tight">Ingatkan Siswa</h3>
                <p class="text-[10px] text-gray-500 font-bold mt-1 uppercase tracking-widest">Mapel <span id="remindPRMapel" class="text-emerald-600"></span> • Mg-<span id="remindPRWeek" class="text-emerald-600"></span></p>
            </div>
            <p class="text-xs text-gray-500 font-medium text-center mb-4 leading-relaxed">Push notif akan dikirim <b>hanya</b> ke siswa yang <b>belum mengerjakan</b> tugas ini dan sudah mengaktifkan notifikasi di HP-nya.</p>
            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest block mb-1.5">Pesan (Opsional)</label>
            <textarea id="remindPRMsg" rows="3" class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold text-gray-700 outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm resize-none" placeholder="Kosongkan untuk pakai pesan default."></textarea>
            <button id="btnSendRemindPR" onclick="sendRemindPR(this)" class="w-full mt-4 py-3.5 bg-emerald-500 hover:bg-emerald-600 text-white font-black rounded-2xl shadow-lg active:scale-95 transition-all text-sm disabled:opacity-60 disabled:cursor-not-allowed disabled:active:scale-100">
                <i class="fa-solid fa-paper-plane mr-1"></i> Kirim Pengingat
            </button>
            <button onclick="closeRemindPRModal()" class="w-full mt-2 py-3 bg-gray-100 text-gray-500 hover:bg-gray-200 font-bold rounded-2xl active:scale-95 transition-all text-sm">
                Batal
            </button>
        </div>
    </div>

    <!-- [BARU] MODAL DISPENSASI PR -->
    <div id="modalExtension" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white w-full max-w-sm rounded-[2rem] p-6 shadow-2xl flex flex-col max-h-[85vh] transform scale-95 transition-transform duration-300" id="modalExtensionBox">
            <div class="text-center mb-4">
                <div class="w-14 h-14 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-2xl mx-auto mb-2 border border-indigo-100 shadow-inner">
                    <i class="fa-solid fa-user-clock"></i>
                </div>
                <h3 class="font-black text-gray-800 text-lg leading-tight">Beri Dispensasi</h3>
                <p class="text-[10px] text-gray-500 font-bold mt-1 uppercase tracking-widest">Mapel <span id="extMapel" class="text-indigo-600"></span> • Mg-<span id="extWeek" class="text-indigo-600"></span></p>
            </div>

            <div class="relative mb-3">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                <input type="text" id="extSearch" class="w-full pl-9 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-gray-700 focus:ring-2 focus:ring-indigo-500 outline-none shadow-sm" placeholder="Cari nama siswa...">
            </div>

            <div class="bg-indigo-50 border border-indigo-100 p-3 rounded-xl mb-3">
                <label class="text-[9px] font-black text-indigo-800 uppercase tracking-widest block mb-1">Batas Waktu Dispensasi (Untuk siswa di bawah)</label>
                <input type="datetime-local" id="extDeadlineInput" class="w-full px-3 py-2 bg-white border border-indigo-200 rounded-lg text-xs font-bold text-indigo-700 outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm">
            </div>

            <!-- Tempat List Siswa Muncul -->
            <div id="extStudentList" class="flex-1 overflow-y-auto space-y-2 pr-1 mb-4 no-scrollbar border-t border-b border-gray-50 py-2">
                <div class="text-center py-6">
                    <i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl mb-2"></i>
                    <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Mencari Data Siswa...</p>
                </div>
            </div>

