    // ================= IMAGE UPLOADER (kompres WebP + modal + progress) =================
    window.pendingImgUploads = 0; // soal tak boleh disimpan selama > 0
    let imgUploadTarget = null;   // { imgInput, previewWrap }

    // Kompres ke WebP via canvas. GIF dilewati (biar tetap animasi). Return Blob + ext.
    const compressToWebp = (file) => new Promise((resolve) => {
        if (file.type === 'image/gif') return resolve({ blob: file, ext: 'gif' });
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
            URL.revokeObjectURL(url);
            const MAX = 1280; // ponytail: cap sisi terpanjang, naikkan kalau butuh detail
            let { width: w, height: h } = img;
            if (w > MAX || h > MAX) { const s = MAX / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
            const c = document.createElement('canvas'); c.width = w; c.height = h;
            c.getContext('2d').drawImage(img, 0, 0, w, h);
            c.toBlob(b => b ? resolve({ blob: b, ext: 'webp' }) : resolve({ blob: file, ext: (file.name.split('.').pop() || 'png') }), 'image/webp', 0.82);
        };
        img.onerror = () => { URL.revokeObjectURL(url); resolve({ blob: file, ext: (file.name.split('.').pop() || 'png') }); };
        img.src = url;
    });

    // Upload pakai XHR biar dapat progress bar upload beneran.
    const uploadWithProgress = (blob, ext, onProgress) => new Promise((resolve, reject) => {
        const fd = new FormData();
        fd.append('file', blob, `soal_${Date.now()}.${ext}`);
        const xhr = new XMLHttpRequest();
        xhr.open('POST', `${API_URL}/api/onboarding/upload-image`);
        xhr.setRequestHeader('Authorization', `Bearer ${token}`);
        xhr.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(Math.round(e.loaded / e.total * 100)); };
        xhr.onload = () => {
            try { const r = JSON.parse(xhr.responseText); (xhr.status >= 200 && xhr.status < 300) ? resolve(r.data.url) : reject(new Error(r.message || 'Gagal upload')); }
            catch { reject(new Error('Respons server tidak valid')); }
        };
        xhr.onerror = () => reject(new Error('Kesalahan jaringan'));
        xhr.send(fd);
    });

    // Render preview + overlay blur/progress selagi upload; return handle {progress, done, fail}.
    const showUploadingPreview = (previewWrap, localUrl) => {
        previewWrap.classList.remove('hidden');
        previewWrap.innerHTML = `
            <div class="relative inline-block rounded-xl overflow-hidden border border-gray-200 max-w-full">
                <img src="${localUrl}" class="max-h-28 object-contain block">
                <div class="up-overlay absolute inset-0 bg-white/60 backdrop-blur-sm flex flex-col items-center justify-center gap-1.5 px-3">
                    <div class="w-full h-1.5 bg-gray-200 rounded-full overflow-hidden"><div class="up-bar h-full bg-green-500 transition-all duration-200" style="width:0%"></div></div>
                    <span class="up-label text-[10px] font-bold text-gray-600">Mengupload… 0%</span>
                </div>
            </div>`;
        const bar = previewWrap.querySelector('.up-bar');
        const label = previewWrap.querySelector('.up-label');
        const overlay = previewWrap.querySelector('.up-overlay');
        return {
            progress: (p) => { bar.style.width = p + '%'; label.textContent = `Mengupload… ${p}%`; },
            done: (finalUrl) => {
                previewWrap.innerHTML = `<img src="${finalUrl}" class="max-h-28 rounded-xl border border-gray-200 object-contain" onerror="this.closest('.img-preview')?.classList.add('hidden')">`;
            },
            fail: (msg) => {
                overlay.className = 'up-overlay absolute inset-0 bg-red-50/90 flex flex-col items-center justify-center gap-1 px-3 text-center';
                overlay.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-400"></i><span class="text-[10px] font-bold text-red-600">${msg}</span><span class="text-[9px] text-red-400">Coba upload ulang</span>`;
            }
        };
    };

