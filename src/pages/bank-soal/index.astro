    // Load siswa yang tertunggak ≥3 pertemuan saat mapel dipilih
    let cetakAllStudents = [];
    cetakMapelEl.addEventListener('change', async function() {
        const selectedMapel = this.value;
        const step2 = document.getElementById('cetakStep2');
        const step2b = document.getElementById('cetakStep2b');
        const step3 = document.getElementById('cetakStep3');
        const step4 = document.getElementById('cetakStep4');
        const step5 = document.getElementById('cetakStep5');

        [step2b, step3, step4, step5].forEach(s => s.classList.add('hidden'));

        if (!selectedMapel) { step2.classList.add('hidden'); validateCetakForm(); return; }

        step2.classList.remove('hidden');

        // Load semua siswa + lag-status mereka, filter yang tertunggak ≥3 di mapel ini
        const sel = document.getElementById('cetakSiswa');
        sel.innerHTML = '<option value="">⏳ Memuat siswa...</option>';
        sel.disabled = true;

        try {
            if (cetakAllStudents.length === 0) {
                const r = await fetch(`${API_URL}/api/students`, { headers: { 'Authorization': `Bearer ${token}` } });
                cetakAllStudents = (await r.json()).data || [];
            }

            // Ambil lag-status semua siswa secara paralel
            const lagResults = await Promise.all(cetakAllStudents.map(s =>
                fetch(`${API_URL}/api/students/${s.id}/lag-status`, { headers: { 'Authorization': `Bearer ${token}` } })
                    .then(r => r.json()).catch(() => ({ data: {} }))
            ));

            const eligible = cetakAllStudents.filter((s, i) => {
                const missed = lagResults[i]?.data?.[selectedMapel]?.missedWeeks || [];
                return missed.length >= 3;
            });

            sel.innerHTML = '<option value="">— Pilih siswa —</option>' +
                eligible.map(s => `<option value="${s.id}" data-name="${s.name}">${s.name}</option>`).join('');
            sel.disabled = false;

            if (eligible.length === 0) {
                sel.innerHTML = '<option value="">Tidak ada siswa tertunggak ≥3 pertemuan</option>';
            }
        } catch (e) {
            sel.innerHTML = '<option value="">Gagal memuat siswa</option>';
            sel.disabled = false;
        }

        validateCetakForm();
    });

    window.onCetakSiswaChange = async () => {
