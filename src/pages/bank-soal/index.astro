        const jumlahEl = document.getElementById('cetakJumlah');
        jumlahEl.innerHTML = '';
        [10, 20, 30, 40, 50].filter(s => s <= totalSoal).forEach(s => {
            const o = document.createElement('option'); o.value = s; o.textContent = `${s} soal`; jumlahEl.appendChild(o);
