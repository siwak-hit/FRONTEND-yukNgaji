---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
import ModalAlert from '../components/ModalAlert.astro';
import NavbarGuru from '../components/NavbarGuru.astro';

---

<Layout title="Dashboard Guru - yukNgaji">
    <div class="px-6 py-8 pb-16 min-h-screen flex flex-col">

        <header class="flex justify-between items-start mb-8 relative">
            <div class="min-w-0">
                <p class="eyebrow mb-1" id="welcomeMsg">Assalamu'alaikum, Ustadz!</p>
                <h1 class="page-title truncate" id="greetingName">yukNgaji</h1>
            </div>

            <div class="relative flex-shrink-0">
                <button onclick="toggleHeaderMenu()" id="btnHeaderMenu" class="btn-icon relative">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                    <span id="headerMenuBadge" class="hidden absolute top-2 right-2.5 w-2 h-2 rounded-full border border-white" style="background-color: var(--danger);"></span>
                </button>

                <div id="dropdownHeaderMenu" class="hidden absolute right-0 top-full mt-2 card w-52 z-[60] overflow-hidden origin-top-right" style="box-shadow: var(--shadow-pop);">
                    <div class="p-2 space-y-0.5">
                        <button onclick="openNotifModal(); toggleHeaderMenu();" class="w-full flex items-center gap-3 px-3 py-2.5 hover:bg-[var(--surface-sunken)] transition-colors rounded-xl text-left relative">
                            <div class="icon-chip-sm" style="background-color: var(--info-soft); color: var(--info);"><i class="fa-solid fa-bell"></i></div>
                            <span class="caption font-semibold text-ink flex-1">Pusat PR</span>
                            <span id="notifBadgeCounter" class="hidden badge badge-danger">0</span>
                        </button>

                        <button onclick="openTransferDrawer(); toggleHeaderMenu();" class="w-full flex items-center gap-3 px-3 py-2.5 hover:bg-[var(--surface-sunken)] transition-colors rounded-xl text-left">
                            <div class="icon-chip-sm" style="background-color: var(--warning-soft); color: var(--warning);"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                            <span class="caption font-semibold text-ink flex-1">Transfer Koin</span>
                        </button>

                        <button onclick="window.location.href='/studentFeedback'" class="w-full flex items-center gap-3 px-3 py-2.5 hover:bg-[var(--surface-sunken)] transition-colors rounded-xl text-left">
                            <div class="icon-chip-sm" style="background-color: var(--accent-soft); color: var(--accent-strong);"><i class="fa-solid fa-comment-dots"></i></div>
                            <span class="caption font-semibold text-ink flex-1">Feedback Murid</span>
                        </button>

                        <div class="h-px my-1 mx-2" style="background-color: var(--divider);"></div>

                        <button id="btnLogout" class="w-full flex items-center gap-3 px-3 py-2.5 hover:bg-[var(--danger-soft)] transition-colors rounded-xl text-left">
                            <div class="icon-chip-sm" style="background-color: var(--danger-soft); color: var(--danger);"><i class="fa-solid fa-power-off"></i></div>
                            <span class="caption font-semibold flex-1" style="color: var(--danger);">Keluar (Logout)</span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <section class="mb-12">
            <h2 class="eyebrow mb-3">Ringkasan Kelas</h2>
            <div class="grid grid-cols-2 gap-3">

                <div class="card card-pad flex flex-col justify-center text-center">
                    <div class="icon-chip mx-auto mb-3" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-0.5" id="statStudents"><i class="fa-solid fa-spinner fa-spin text-base" style="color: var(--accent-strong);"></i></h3>
                    <p class="eyebrow">Total Anak</p>
                </div>

                <div class="card card-pad flex flex-col justify-center text-center">
                    <div class="icon-chip mx-auto mb-3" style="background-color: var(--info-soft); color: var(--info);">
                        <i class="fa-solid fa-file-contract"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-0.5" id="statExams"><i class="fa-solid fa-spinner fa-spin text-base" style="color: var(--info);"></i></h3>
                    <p class="eyebrow">Total Ujian</p>
                </div>

                <div onclick="openNotDoneModal()" class="card card-interactive card-pad col-span-2 flex flex-col justify-between group" style="background-color: var(--danger-soft); border-color: transparent;">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="icon-chip-sm" style="background-color: rgba(229,72,77,0.14); color: var(--danger);">
                                <i class="fa-solid fa-user-clock"></i>
                            </div>
                            <span class="caption font-semibold" style="color: var(--danger);">Belum Mengerjakan PR / Ujian</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-xs group-hover:translate-x-1 transition-transform" style="color: var(--danger);"></i>
                    </div>
                    <div class="flex items-end justify-between mt-3 pl-1">
                        <h3 class="text-3xl font-bold leading-none" id="notDoneCount" style="color: var(--danger);"><i class="fa-solid fa-spinner fa-spin text-lg"></i></h3>
                        <p class="eyebrow" style="color: var(--danger);">Tunggakan Aktif</p>
                    </div>
                </div>

            </div>
        </section>

        <div class="mb-8">
            <h2 class="eyebrow mb-3">Aksi Cepat</h2>

            <a href="/absensi" id="btnAbsensi" class="card card-interactive card-pad relative block w-full mb-3 overflow-hidden">
                <div class="flex items-center justify-between z-10 relative">
                    <div class="flex items-center gap-3">
                        <div class="icon-chip" style="background-color: var(--info-soft); color: var(--info);">
                            <i class="fa-solid fa-calendar-check text-lg"></i>
                        </div>
                        <div>
                            <h3 class="section-title">Absensi Hari Ini</h3>
                            <p id="absensiStatusText" class="caption mt-0.5">Mengecek status...</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-tertiary text-xs"></i>
                </div>
                <div id="absensiPulse" class="absolute inset-0 border-2 border-transparent rounded-[var(--r-lg)] pointer-events-none"></div>
            </a>

            <button onclick="openQuickMenu()" class="card card-interactive card-pad w-full flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                        <i class="fa-solid fa-grip text-lg"></i>
                    </div>
                    <div class="text-left">
                        <h3 class="section-title">Menu Cepat</h3>
                        <p class="caption mt-0.5">Timer, denah, hafalan, galeri & lainnya</p>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right text-tertiary text-xs"></i>
            </button>
        </div>

        <!-- MODAL MENU CEPAT (grouping aksi cepat) -->
        <div id="modalQuickMenu" class="modal-overlay hidden">
            <div class="modal-sheet">
                <div class="sheet-grabber"></div>
                <div class="flex justify-between items-center mb-5">
                    <h3 class="section-title">Menu Cepat</h3>
                    <button onclick="closeQuickMenu()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <a href="/timer" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: var(--warning-soft); color: var(--warning);">
                            <i class="fa-solid fa-stopwatch"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Timer</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Durasi</p>
                        </div>
                    </a>

                    <a href="/seats" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                            <i class="fa-solid fa-chair"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Denah</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Posisi</p>
                        </div>
                    </a>

                    <a href="/hafalan" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                            <i class="fa-solid fa-book-quran"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Hafalan</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Juz Amma</p>
                        </div>
                    </a>

                    <a href="/tajwid" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: var(--accent-soft); color: var(--accent-strong);">
                            <i class="fa-solid fa-microphone-lines"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Tajwid</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Latihan Mad</p>
                        </div>
                    </a>

                    <a href="/galeri" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: #f3eafe; color: #8b5cf6;">
                            <i class="fa-solid fa-images"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Galeri</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Foto Raport</p>
                        </div>
                    </a>

                    <button onclick="closeQuickMenu(); openDailyChallengeLinkModal();" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: var(--info-soft); color: var(--info);">
                            <i class="fa-solid fa-keyboard"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Challenge</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Koin Harian</p>
                        </div>
                    </button>

                    <button onclick="closeQuickMenu(); openWrappedModal();" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center">
                        <div class="icon-chip" style="background-color: #fdeaf3; color: #db2777;">
                            <i class="fa-solid fa-gift"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Wrapped</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Kilas Balik</p>
                        </div>
                    </button>

                    <button onclick="closeQuickMenu(); copyShopLink();" class="card card-interactive p-3 flex flex-col items-center justify-center gap-2 text-center group">
                        <div class="icon-chip" style="background-color: var(--warning-soft); color: var(--warning);">
                            <i class="fa-solid fa-store"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-ink leading-tight">Toko</h3>
                            <p class="text-[10px] text-tertiary font-medium truncate">Salin Link</p>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <section class="flex-1">
            <div class="seg mb-5">
                <button id="tabList" class="seg-btn is-active">
                    <i class="fa-solid fa-users"></i> Daftar Anak
                </button>
                <button id="tabLeaderboard" class="seg-btn">
                    <i class="fa-solid fa-trophy"></i> Leaderboard
                </button>
            </div>

            <div id="contentList" class="block animate-slide-up">
                <div class="flex justify-between items-center mb-4 gap-3">
                    <select id="filterList" class="field !py-2 !px-3 !w-auto text-sm font-medium cursor-pointer">
                        <option value="abjad">Abjad (A - Z)</option>
                        <option value="nilai">Nilai Rata-rata Tertinggi</option>
                        <option value="rajin">Kehadiran Terbanyak</option>
                    </select>
                    <button class="btn-soft !py-2 !px-4 text-sm flex-shrink-0" onclick="window.location.href='/students'">Lihat Semua</button>
                </div>

                <div id="studentList" class="space-y-3">
                    <div class="text-center py-8"><i class="fa-solid fa-spinner fa-spin text-accent text-3xl"></i><p class="caption mt-3 font-semibold">Menghitung data...</p></div>
                </div>

                <div id="remainingStudentsContainer" class="mt-4 text-center hidden">
                    <span id="remainingStudentsText" class="badge badge-neutral">
                        + 5 anak lainnya
                    </span>
                </div>
            </div>

            <div id="contentLeaderboard" class="hidden animate-slide-up">
                <div class="flex items-end justify-center gap-2 mb-6 h-52 mt-6" id="podiumContainer">
                    <div class="text-center w-full"><i class="fa-solid fa-spinner fa-spin text-accent text-2xl"></i></div>
                </div>

                <div class="card overflow-hidden mb-4">
                    <div class="px-4 py-3 border-b flex items-center justify-between" style="border-color: var(--hairline); background-color: var(--pearl);">
                        <h4 class="eyebrow"><i class="fa-solid fa-ranking-star text-accent mr-1"></i> Top 5 Rata-rata</h4>
                    </div>
                    <div class="overflow-x-auto no-scrollbar">
                        <table class="w-full text-left border-collapse min-w-[300px]">
                            <thead>
                                <tr class="border-b text-[9px] uppercase tracking-wider text-tertiary" style="border-color: var(--divider);">
                                    <th class="p-3 font-semibold">Nama</th>
                                    <th class="p-3 font-semibold text-center">Tjw</th>
                                    <th class="p-3 font-semibold text-center">Fqh</th>
                                    <th class="p-3 font-semibold text-center">Thd</th>
                                    <th class="p-3 font-semibold text-center">Hadir</th>
                                </tr>
                            </thead>
                            <tbody id="leaderboardTable" class="text-xs">
                            </tbody>
                        </table>
                    </div>
                </div>
                <p class="text-center text-[10px] text-tertiary italic mb-8">* Peringkat dihitung otomatis dari nilai kuesioner dan absensi.</p>
            </div>
        </section>

        <section class="mb-6">
            <div class="mt-8 mb-4 card overflow-hidden relative z-20">
                <button onclick="toggleDangerZone()" class="w-full px-5 py-4 flex items-center justify-between transition-colors active:scale-[0.99]" style="background-color: var(--pearl);">
                    <div class="flex items-center gap-3">
                        <div class="icon-chip-sm" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">
                            <i class="fa-solid fa-gear"></i>
                        </div>
                        <span class="caption font-semibold text-ink">Pengaturan Lanjutan</span>
                    </div>
                    <i id="dangerIcon" class="fa-solid fa-chevron-down text-tertiary transition-transform duration-300"></i>
                </button>

                <div id="dangerContent" class="hidden px-5 py-4 border-t" style="border-color: var(--hairline);">

                    <!-- [BARU] SAKLAR MAINTENANCE -->
                    <div class="rounded-[var(--r-lg)] p-4 mb-4" style="background-color: var(--warning-soft);">
                        <div class="flex justify-between items-center mb-1">
                            <h4 class="section-title" style="color: var(--warning);"><i class="fa-solid fa-person-digging mr-1"></i> Mode Perbaikan</h4>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="toggleMaintenance" class="sr-only peer" onchange="promptMaintenanceToggle(this)">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                            </label>
                        </div>
                        <p class="text-[11px] leading-relaxed font-medium" style="color: var(--warning);">Aktifkan untuk memblokir akses murid ke halaman ujian/PR secara instan.</p>
                    </div>

                    <div class="rounded-[var(--r-lg)] p-4" style="background-color: var(--danger-soft);">
                        <h4 class="section-title mb-1" style="color: var(--danger);"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Zona Bahaya</h4>
                        <p class="text-[11px] leading-relaxed mb-4 font-medium" style="color: var(--danger);">Mengunduh backup CSV semua data, lalu mengosongkan tabel transaksi (otomatis / pilih manual). Nama siswa &amp; materi soal tetap aman.</p>
                        <button onclick="openResetModal()" class="btn w-full !rounded-[var(--r-md)] text-sm !py-3.5" style="background-color: var(--danger); color: #fff;">
                            <i class="fa-solid fa-bomb mr-1"></i> Reset Tahun Ajaran
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <div id="modalReset" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
            <div class="bg-white w-full max-w-md rounded-[2rem] p-6 shadow-2xl animate-slide-up relative overflow-hidden max-h-[90vh] flex flex-col">
                <div class="w-14 h-14 bg-red-50 text-red-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-3 border border-red-100 shrink-0">
                    <i class="fa-solid fa-bomb"></i>
                </div>
                <h3 class="font-black text-gray-800 text-lg mb-1 text-center shrink-0">Reset Tahun Ajaran</h3>
                <p class="text-[11px] text-gray-500 mb-4 leading-relaxed text-center shrink-0">
                    Data diunduh dulu sebagai <b>backup CSV</b> (nama file = tahun ajaran), lalu tabel terpilih dikosongkan. Nama siswa &amp; materi soal tetap aman.
                </p>

                <div class="overflow-y-auto no-scrollbar flex-1 -mx-1 px-1">
                    <!-- Pilih Mode -->
                    <div class="flex p-1 bg-gray-100 rounded-2xl mb-4 shadow-inner">
                        <button type="button" id="resetModeAutoBtn" onclick="setResetMode('auto')" class="flex-1 py-2.5 text-[11px] font-bold bg-white text-red-600 rounded-xl shadow-sm transition-all uppercase tracking-wider">Otomatis</button>
                        <button type="button" id="resetModeManualBtn" onclick="setResetMode('manual')" class="flex-1 py-2.5 text-[11px] font-bold text-gray-400 rounded-xl transition-all uppercase tracking-wider">Manual</button>
                    </div>

                    <p id="resetAutoNote" class="text-[11px] text-gray-500 bg-gray-50 border border-gray-100 rounded-xl p-3 mb-4 leading-relaxed">
                        Semua data transaksi (absensi, PR, ujian, hafalan, poin, galeri, dll) akan dikosongkan dan progres siswa direset ke nol.
                    </p>

                    <div id="resetManualList" class="hidden mb-4">
                        <div class="flex justify-between items-center mb-2 px-1">
                            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Pilih data yang direset</span>
                            <div class="flex gap-3">
                                <button type="button" onclick="toggleAllResetTables(true)" class="text-[10px] font-bold text-red-600">Pilih semua</button>
                                <button type="button" onclick="toggleAllResetTables(false)" class="text-[10px] font-bold text-gray-400">Kosongkan</button>
                            </div>
                        </div>
                        <div id="resetTableChecks" class="space-y-1.5"></div>
                    </div>
                </div>

                <div class="shrink-0 pt-3 border-t border-gray-100 mt-2">
                    <div class="bg-gray-50 p-1.5 rounded-xl border border-gray-200 mb-3">
                        <input type="password" id="resetPasswordInput" placeholder="Password akun Anda..." class="w-full px-3 py-2.5 bg-transparent text-sm font-bold text-gray-800 focus:outline-none text-center tracking-widest">
                    </div>
                    <div class="flex gap-2">
                        <button onclick="closeResetModal()" class="flex-1 py-3.5 bg-gray-100 text-gray-500 text-xs font-bold rounded-xl active:scale-95 transition-all">Batal</button>
                        <button id="btnExecuteReset" class="flex-1 py-3.5 bg-red-600 text-white text-xs font-bold rounded-xl shadow-lg active:scale-95 transition-all disabled:opacity-50 disabled:cursor-not-allowed" disabled>Unduh CSV &amp; Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL TUNGGAKAN -->
    <div id="modalNotDone" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-[2rem] p-6 shadow-2xl flex flex-col max-h-[85vh] animate-slide-up">
            <div class="text-center mb-3">
                <div class="w-14 h-14 bg-red-50 text-red-500 rounded-full flex items-center justify-center text-2xl mx-auto mb-2 border border-red-100 shadow-inner">
                    <i class="fa-solid fa-user-clock"></i>
                </div>
                <h3 class="font-black text-gray-800 text-lg">Daftar Tunggakan</h3>
                <p class="text-[10px] font-bold text-gray-400 mt-1">Pantau PR dan ujian yang belum dikerjakan.</p>
            </div>

            <!-- TAB PR / UJIAN -->
            <div class="flex p-1 bg-gray-100 rounded-2xl mb-4 shadow-inner shrink-0">
                <button id="tabMissingPR" onclick="switchMissingTab('pr')" class="flex-1 py-2.5 text-[10px] font-bold bg-white text-red-600 rounded-xl shadow-sm transition-all uppercase tracking-widest">
                    <i class="fa-solid fa-book-open mr-1"></i> Belum PR
                </button>
                <button id="tabMissingExam" onclick="switchMissingTab('exam')" class="flex-1 py-2.5 text-[10px] font-bold text-gray-400 hover:text-gray-600 transition-all uppercase tracking-widest">
                    <i class="fa-solid fa-file-pen mr-1"></i> Belum Ujian
                </button>
            </div>

            <!-- FILTER PR -->
            <div id="missingPRFilters" class="flex gap-2 mb-4">
                <select id="modalFilterSubject" class="w-full text-xs bg-gray-50 border border-gray-200 text-gray-600 rounded-xl px-2 py-2 outline-none focus:ring-2 focus:ring-red-500 transition-all font-bold cursor-pointer">
                    <option value="">Semua Pelajaran</option>
                </select>
                <select id="modalFilterWeek" class="w-full text-xs bg-gray-50 border border-gray-200 text-gray-600 rounded-xl px-2 py-2 outline-none focus:ring-2 focus:ring-red-500 transition-all font-bold cursor-pointer">
                    <option value="">Semua Pertemuan</option>
                </select>
            </div>

            <!-- FILTER UJIAN -->
            <div id="missingExamFilters" class="hidden mb-4">
                <select id="modalFilterExamSubject" onchange="loadMissingExamList()" class="w-full text-xs bg-gray-50 border border-gray-200 text-gray-600 rounded-xl px-2 py-2 outline-none focus:ring-2 focus:ring-red-500 transition-all font-bold cursor-pointer">
                    <option value="">Semua Mapel Ujian</option>
                    <option value="tajwid">Tajwid</option>
                    <option value="fiqih">Fiqih</option>
                    <option value="tauhid">Tauhid</option>
                </select>
            </div>

            <div id="notDoneListContainer" class="flex-1 overflow-y-auto space-y-2 pr-1 mb-4 custom-scrollbar">
                <div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-red-500"></i></div>
            </div>

            <button onclick="closeNotDoneModal()" class="w-full py-3.5 bg-red-500 hover:bg-red-600 text-white font-bold rounded-2xl active:scale-95 transition-all text-sm">
                Tutup
            </button>
        </div>
    </div>

