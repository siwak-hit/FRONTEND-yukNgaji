            contentLB.classList.replace('flex', 'hidden');
        } else {
            btnLB.className = activeCls;
            btnList.className = inactiveCls;
            contentLB.classList.replace('hidden', 'flex');
            contentList.classList.replace('flex', 'hidden');
            loadPRLeaderboard();
        }
    };

    const getTimeCategory = (dateString) => {
        const notifDate = new Date(dateString);
        const now = new Date();

        const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const notifMidnight = new Date(notifDate.getFullYear(), notifDate.getMonth(), notifDate.getDate());

        const diffDays = Math.floor((todayMidnight - notifMidnight) / (1000 * 60 * 60 * 24));

        if (diffDays === 0) {
            const hour = notifDate.getHours();
            if (hour < 12) return "Pagi Ini";
            if (hour < 15) return "Siang Ini";
            if (hour < 18) return "Sore Ini";
            return "Malam Ini";
        }
        if (diffDays === 1) return "Kemarin";
        if (diffDays > 1 && diffDays <= 7) return "Minggu Ini";
        return "Beberapa Minggu Lalu";
    };

    const loadNotifications = async (isFirstLoad = false) => {
        try {
            const res = await fetch(`${API_URL}/api/notifications`, { headers: { 'Authorization': `Bearer ${token}` }});
            const result = await res.json();
            notifications = result.data || [];

            if (!isFirstLoad) {
                const oldNotifs = notifications.filter(n => {
                    const diffDays = Math.floor((new Date() - new Date(n.created_at)) / (1000 * 60 * 60 * 24));
                    return diffDays > 7;
                });

                if (oldNotifs.length > 0) {
                    showConfirmGlobal(
                        "Bersih-bersih Laci",
                        `Terdapat ${oldNotifs.length} notif yang sudah lewat dari seminggu. Mau dihapus biar laci rapi?`,
                        async () => {
                            const oldIds = oldNotifs.map(n => n.id);
                            notifications = notifications.filter(n => !oldIds.includes(n.id));
                            updateNotifBadge();
                            renderNotifications();
                            try {
                                await Promise.all(oldIds.map(id => fetch(`${API_URL}/api/notifications/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }})));
                            } catch(e) {}
                        },
                        true,
                        'primary'
                    );
                }
            }

            updateNotifBadge();
            renderNotifications();
        } catch (e) { console.error("Gagal load notif", e); }
    };

    const updateNotifBadge = () => {
        const headerBadge = document.getElementById('headerMenuBadge');
        const dropBadge = document.getElementById('notifBadgeCounter');
        const countText = document.getElementById('notifCountText');

        if (notifications.length > 0) {
            if(headerBadge) headerBadge.classList.remove('hidden');
            if(dropBadge) {
                dropBadge.innerText = notifications.length;
                dropBadge.classList.remove('hidden');
                dropBadge.classList.add('inline-flex', 'items-center', 'justify-center');
            }
            if(countText) countText.innerText = notifications.length;
        } else {
            if(headerBadge) headerBadge.classList.add('hidden');
            if(dropBadge) {
                dropBadge.classList.add('hidden');
                dropBadge.classList.remove('inline-flex', 'items-center', 'justify-center');
            }
            if(countText) countText.innerText = '0';
        }
    }

    const renderNotifications = () => {
        const container = document.getElementById('notifListContainer');
        if (!container) return;

        if (notifications.length === 0) {
            container.innerHTML = `<div class="text-center py-10 flex flex-col items-center justify-center opacity-50"><i class="fa-regular fa-bell-slash text-5xl text-gray-300 mb-3"></i><p class="text-xs text-gray-500 font-bold">Belum ada notifikasi baru.</p></div>`;
            return;
        }

        const grouped = {};
        notifications.forEach(notif => {
            const cat = getTimeCategory(notif.created_at);
            if (!grouped[cat]) grouped[cat] = [];
            grouped[cat].push(notif);
        });

        const catOrder = ["Pagi Ini", "Siang Ini", "Sore Ini", "Malam Ini", "Hari Ini", "Kemarin", "Minggu Ini", "Beberapa Minggu Lalu"];

        container.innerHTML = catOrder.map(cat => {
            if (!grouped[cat] || grouped[cat].length === 0) return '';

            const listHtml = grouped[cat].map(notif => {
                const timeStr = new Date(notif.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                const isExam = notif.notif_type === 'exam';
                const theme = isExam
                    ? {
                        wrap: 'bg-blue-50/70 border-blue-100 hover:bg-blue-100/60',
                        iconWrap: 'text-blue-500 border-blue-50',
                        textMain: 'text-blue-700',
                        textAccent: 'text-blue-600',
                        icon: 'fa-file-pen',
                        label: 'UJIAN'
                    }
                    : {
                        wrap: 'bg-green-50/70 border-green-100 hover:bg-green-100/60',
                        iconWrap: 'text-green-500 border-green-50',
                        textMain: 'text-green-700',
                        textAccent: 'text-green-600',
                        icon: 'fa-book-open',
                        label: 'PR'
                    };

                const titleText = isExam
                    ? (notif.title || 'Ujian')
                    : `PR ${notif.subject}${notif.week ? ` Pertemuan ${notif.week}` : ''}`;

                return `
                <div onclick="openNotifDetail('${notif.id}')" class="${theme.wrap} border p-3.5 rounded-2xl flex gap-3 relative group cursor-pointer transition-colors">
                    <div class="w-8 h-8 rounded-full bg-white shadow-sm flex items-center justify-center ${theme.iconWrap} shrink-0 font-black text-xs border">
                        <i class="fa-solid ${theme.icon}"></i>
                    </div>

                    <div class="flex-1 min-w-0 pr-8 pointer-events-none">
                        <div class="flex items-center gap-1.5 mb-1">
                            <span class="text-[8px] font-black px-2 py-0.5 rounded-full ${isExam ? 'bg-blue-100 text-blue-600' : 'bg-green-100 text-green-600'}">
                                ${theme.label}
                            </span>
                            <span class="text-[8px] font-black text-gray-400 uppercase">${notif.subject || '-'}</span>
                        </div>

                        <p class="text-xs text-gray-700 leading-relaxed">
                            <b class="${theme.textMain}">${notif.student_name}</b>
                            telah mengerjakan <b class="${theme.textAccent}">${titleText}</b>.
                        </p>

                        <p class="text-[9px] font-bold text-gray-400 mt-1.5 uppercase tracking-wider">
                            <i class="fa-regular fa-clock"></i> ${timeStr}
                        </p>
                    </div>

                    <button onclick="event.stopPropagation(); deleteNotif('${notif.id}')" class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 bg-white border border-red-200 text-red-500 hover:text-red-700 hover:bg-red-50 rounded-xl flex items-center justify-center transition-all opacity-100 sm:opacity-0 sm:group-hover:opacity-100 active:scale-95 shadow-sm z-10">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
                `;
            }).join('');

            return `
                <div class="mb-4">
                    <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2 pl-1 border-b border-gray-100 pb-1">${cat}</h4>
                    <div class="space-y-2">
                        ${listHtml}
                    </div>
                </div>
            `;
        }).join('');
    };

    let cachedExamOptionsForLB = {};

    window.handleNotifLeaderboardModeChange = async () => {
        const mode = document.getElementById('lbMode')?.value || 'pr';
        const prFilters = document.getElementById('lbPRFilters');
        const examFilters = document.getElementById('lbExamFilters');

        if (mode === 'exam') {
            prFilters?.classList.add('hidden');
            examFilters?.classList.remove('hidden');
            await loadExamOptionsForLB();
        } else {
            examFilters?.classList.add('hidden');
            prFilters?.classList.remove('hidden');
            loadPRLeaderboard();
        }
    };

    window.loadExamOptionsForLB = async () => {
        const subject = document.getElementById('lbExamSubject')?.value || 'tajwid';
        const select = document.getElementById('lbExamId');

        if (!select) return;

        select.innerHTML = `<option value="">Memuat ujian...</option>`;

        try {
            if (!cachedExamOptionsForLB[subject]) {
                const res = await fetch(`${API_URL}/api/exams`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                const result = await res.json();

                const exams = (result.data || [])
                    .filter(e =>
                        e.is_active === true &&
                        String(e.subject || '').toLowerCase() === String(subject).toLowerCase()
                    );

                cachedExamOptionsForLB[subject] = exams;
            }

            const exams = cachedExamOptionsForLB[subject];

            if (exams.length === 0) {
                select.innerHTML = `<option value="">Belum ada ujian aktif</option>`;
                document.getElementById('lbPRContainer').innerHTML = `
                    <p class="text-center text-xs text-gray-400 italic py-10 font-medium">
                        Belum ada ujian aktif untuk mapel ini.
                    </p>
                `;
                return;
            }

            select.innerHTML = exams.map(e => `
                <option value="${e.id}">${e.title}</option>
            `).join('');

            loadPRLeaderboard();

        } catch (err) {
            console.error(err);
            select.innerHTML = `<option value="">Gagal memuat ujian</option>`;
        }
    };


    window.loadPRLeaderboard = async () => {
        const mode = document.getElementById('lbMode')?.value || 'pr';
        const container = document.getElementById('lbPRContainer');

        container.innerHTML = `
            <div class="text-center py-10">
                <i class="fa-solid fa-spinner fa-spin text-indigo-500 text-2xl"></i>
                <p class="text-[10px] text-indigo-400 font-bold mt-2">Menghitung Peringkat...</p>
            </div>
        `;

        try {
            let url = '';

            if (mode === 'exam') {
                const examId = document.getElementById('lbExamId')?.value;

                if (!examId) {
                    container.innerHTML = `<p class="text-center text-xs text-gray-400 italic py-10 font-medium">Pilih ujian terlebih dahulu.</p>`;
                    return;
                }

                url = `${API_URL}/api/onboarding/leaderboard-pr?mode=exam&exam_id=${examId}`;
            } else {
                const subj = document.getElementById('lbFilterSubject').value;
                const week = document.getElementById('lbFilterWeek').value;

                if (!subj || !week) return;

                url = `${API_URL}/api/onboarding/leaderboard-pr?subject=${subj}&week=${week}`;
            }

            const res = await fetch(url, {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            const result = await res.json();

            let data = result.data || [];

            // PR hanya yang is_pr true
            if (mode === 'pr') {
                data = data.filter(d => d.is_pr === true);
            }

            // Exclude akun dummy/testing
            data = data.filter(d => {
                const name = String(d.name || '').toLowerCase();
                return !name.includes('john doe') && !name.includes('xaviera') && !name.includes('xaveria');
            });

            data = data.slice(0, 5);

            if (data.length === 0) {
                container.innerHTML = `
                    <p class="text-center text-xs text-gray-400 italic py-10 font-medium">
                        Belum ada data leaderboard ${mode === 'exam' ? 'ujian ini' : 'PR ini'}.
                    </p>
                `;
                return;
            }

            container.innerHTML = data.map((d, i) => {
                const rankColors = [
                    'bg-amber-100 text-amber-600 border-amber-200',
                    'bg-slate-100 text-slate-500 border-slate-200',
                    'bg-orange-100 text-orange-600 border-orange-200',
                    'bg-indigo-50 text-indigo-500 border-indigo-100',
                    'bg-indigo-50 text-indigo-500 border-indigo-100'
                ];

                const modeBadge = mode === 'exam'
                    ? `<span class="bg-blue-50 text-blue-600 border border-blue-100 text-[8px] font-black px-2 py-0.5 rounded-lg">UJIAN</span>`
                    : `<span class="bg-green-50 text-green-600 border border-green-100 text-[8px] font-black px-2 py-0.5 rounded-lg">PR</span>`;

                return `
                    <div class="flex items-center gap-3 bg-white border border-gray-100 rounded-2xl p-3 shadow-sm">
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center font-black text-xs border ${rankColors[i] || rankColors[4]}">
                            #${i + 1}
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5 mb-1">
                                ${modeBadge}
                                <p class="font-black text-xs text-gray-800 truncate">${d.name}</p>
                            </div>
                            <p class="text-[9px] font-bold text-gray-400">
                                Nilai asli: ${d.raw_score ?? d.score ?? 0}
                                ${d.time_taken && d.time_taken !== '-' ? ` • ${d.time_taken}s` : ''}
                            </p>
                        </div>

                        <div class="text-right">
                            <p class="text-lg font-black text-indigo-600">${d.composite_score}</p>
                            <p class="text-[8px] font-bold text-gray-400 uppercase">Poin</p>
                        </div>
                    </div>
                `;
            }).join('');

        } catch (err) {
            console.error(err);
            container.innerHTML = `
                <div class="text-center py-10 bg-red-50 rounded-2xl border border-red-100">
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-2xl mb-2"></i>
                    <p class="text-xs font-bold text-red-500">Gagal memuat leaderboard.</p>
                </div>
            `;
        }
    };


    window.openNotifModal = () => {
        const modal = document.getElementById('modalNotif');
        const box = document.getElementById('notifBox');

        switchNotifTab('list');

        modal.classList.replace('hidden', 'flex');
        setTimeout(() => {
            modal.classList.replace('opacity-0', 'opacity-100');
            box.classList.replace('translate-y-full', 'translate-y-0');
        }, 10);
        loadNotifications(false);
