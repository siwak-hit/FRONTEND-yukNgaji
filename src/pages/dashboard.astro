    // ==============================================================
    // FETCH DATA UTAMA
    // ==============================================================
    const fetchDashboardData = async () => {
        try {
            const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

            // [UPDATE] Sekalian fetch status maintenance dari backend saat load dashboard
            try {
                const sysRes = await fetch(`${API_URL}/api/onboarding/system/status`, { headers });
                if (sysRes.ok) {
                    const sysData = await sysRes.json();
                    if (sysData.data) {
                        const toggleBtn = document.getElementById('toggleMaintenance');
                        if (toggleBtn) toggleBtn.checked = sysData.data.is_maintenance;
                    }
                }
            } catch (e) { console.log('Gagal fetch system status'); }

            const [dashRes, enrichedRes] = await Promise.all([
                fetch(`${API_URL}/api/insights/dashboard`, { headers }),
                fetch(`${API_URL}/api/students/stats/enriched`, { headers })
            ]);

            if (dashRes.status === 401 || enrichedRes.status === 401) throw new Error('Sesi habis');

            const dashData = await dashRes.json();
            const enrichedData = await enrichedRes.json();

            enrichedStudents = enrichedData.data || [];
            missingExamCache = {};

            const statStudentsEl = document.getElementById('statStudents');
            if (statStudentsEl) statStudentsEl.innerText = dashData.data.total_students || enrichedStudents.length || 0;

            const statExamsEl = document.getElementById('statExams');
            if (statExamsEl) statExamsEl.innerText = dashData.data.total_exams || 0;

            renderStudentList();
            renderLeaderboard();
            await initFiltersAndTasks();

            loadNotifications(true);

        } catch (error) {
            if (window.showToast) window.showToast('danger', 'Error', 'Gagal memuat data dashboard.');
            document.getElementById('studentList').innerHTML = '<div class="text-center py-6 text-red-500 text-xs font-bold">Gagal memuat.</div>';
            document.getElementById('podiumContainer').innerHTML = '<div class="text-center w-full text-red-500 text-xs font-bold">Gagal memuat.</div>';
        }
    };

    const renderStudentList = () => {
        const filterEl = document.getElementById('filterList');
        if (!filterEl) return;

        const filter = filterEl.value;
        const container = document.getElementById('studentList');
        const remContainer = document.getElementById('remainingStudentsContainer');
        const remText = document.getElementById('remainingStudentsText');

        if (enrichedStudents.length === 0) {
            container.innerHTML = `<div class="empty-state card" style="border-style:dashed;"><div class="empty-icon"><i class="fa-solid fa-folder-open text-2xl"></i></div><p class="caption font-semibold">Belum ada data Anak.</p></div>`;
            if (remContainer) remContainer.classList.add('hidden');
            return;
        }

        let sorted = [...enrichedStudents];
        if (filter === 'abjad') sorted.sort((a,b) => a.name.localeCompare(b.name));
        else if (filter === 'nilai') sorted.sort((a,b) => b.finalScore - a.finalScore);
        else if (filter === 'rajin') sorted.sort((a,b) => b.hadir - a.hadir);

        const top5 = sorted.slice(0, 5);
        container.innerHTML = top5.map((student, idx) => {
            const initials = student.name.substring(0, 2).toUpperCase();
            const avatarHtml = student.photo_url ? `<img src="${student.photo_url}" class="w-full h-full object-cover" alt="${student.name}" />` : initials;

            let detailBadge = '';
            if (filter === 'nilai') detailBadge = `<span class="badge badge-warning ml-2"><i class="fa-solid fa-star text-[8px]"></i> Rata: ${student.finalScore}</span>`;
            else if (filter === 'rajin') detailBadge = `<span class="badge badge-info ml-2"><i class="fa-solid fa-calendar-check text-[8px]"></i> Hadir: ${student.hadir}x</span>`;

            return `
                <div class="card card-interactive card-pad !p-3.5 flex items-center justify-between" onclick="window.location.href='/student/${student.id}'">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="relative flex-shrink-0">
                            <div class="avatar w-12 h-12 text-base overflow-hidden">
                                ${avatarHtml}
                            </div>
                            ${filter !== 'abjad' ? `<div class="absolute -top-1 -left-1 w-5 h-5 rounded-full flex items-center justify-center text-[9px] font-bold border-2 border-white z-10" style="background-color: var(--ink); color:#fff;">${idx + 1}</div>` : ''}
                        </div>
                        <div class="min-w-0">
                            <h4 class="section-title truncate max-w-[150px]">${student.name}</h4>
                            <div class="flex items-center mt-0.5">
                                <p class="eyebrow">${student.grade}</p>
                                ${detailBadge}
                            </div>
                        </div>
                    </div>
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-tertiary flex-shrink-0" style="background-color: var(--surface-sunken);">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </div>
                </div>
            `;
        }).join('');

        if (remContainer && remText) {
            if (sorted.length > 5) {
                remText.innerText = `+ ${sorted.length - 5} anak lainnya`;
                remContainer.classList.remove('hidden');
            } else {
                remContainer.classList.add('hidden');
            }
        }
    };

    const filterListEl = document.getElementById('filterList');
    if (filterListEl) filterListEl.addEventListener('change', renderStudentList);

    const renderLeaderboard = () => {
        const podiumContainer = document.getElementById('podiumContainer');
        const tableBody = document.getElementById('leaderboardTable');

        if (!podiumContainer || !tableBody) return;

        if (enrichedStudents.length === 0) {
            podiumContainer.innerHTML = `<div class="text-center w-full"><p class="text-gray-400 text-xs font-bold">Belum ada data untuk Leaderboard.</p></div>`;
            return;
        }

        const ranked = [...enrichedStudents].sort((a,b) => b.finalScore - a.finalScore);
        const top5 = ranked.slice(0, 5);

        const generateAvatar = (student, colorClass) => {
            if(!student) return `<div class="w-12 h-12 rounded-full border-2 border-dashed border-gray-300 bg-gray-50"></div>`;

            const avatarHtml = student.photo_url
                ? `<img src="${student.photo_url}" class="w-full h-full object-cover rounded-full" alt="Foto ${student.name}" />`
                : student.name.substring(0,2).toUpperCase();

            return `
                <div class="relative w-14 h-14 ${colorClass} rounded-full flex items-center justify-center font-black text-lg z-10 shadow-lg border-2 border-white cursor-pointer hover:-translate-y-1 transition-transform overflow-hidden" onclick="window.location.href='/student/${student.id}'">
                    ${avatarHtml}
                </div>
                <p class="text-[9px] font-bold mt-1 text-gray-700 truncate w-16 text-center capitalize">${student.name.split(' ')[0]}</p>
                <p class="text-[8px] font-black text-amber-500"><i class="fa-solid fa-star"></i> ${student.finalScore}</p>
            `;
        }

        podiumContainer.innerHTML = `
            <div class="flex flex-col items-center">
                ${generateAvatar(top5[1], 'bg-slate-200 text-slate-600')}
                <div class="w-20 h-20 bg-gradient-to-t from-slate-300 to-slate-100 rounded-t-xl shadow-inner flex items-start justify-center pt-2 mt-2 border border-slate-200">
                    <span class="text-slate-400 font-black text-2xl drop-shadow-sm">2</span>
                </div>
            </div>

            <div class="flex flex-col items-center">
                <i class="fa-solid fa-crown text-amber-400 text-3xl mb-1 animate-bounce drop-shadow-md"></i>
                ${generateAvatar(top5[0], 'bg-amber-100 text-amber-600 border-4 border-amber-300 w-16 h-16 text-2xl')}
                <div class="w-24 h-28 bg-gradient-to-t from-amber-400 to-amber-200 rounded-t-xl shadow-inner flex items-start justify-center pt-2 mt-2 border border-amber-300">
                    <span class="text-amber-600 font-black text-4xl drop-shadow-sm">1</span>
                </div>
            </div>

            <div class="flex flex-col items-center">
                ${generateAvatar(top5[2], 'bg-orange-100 text-orange-600')}
                <div class="w-20 h-16 bg-gradient-to-t from-orange-300 to-orange-100 rounded-t-xl shadow-inner flex items-start justify-center pt-2 mt-2 border border-orange-200">
                    <span class="text-orange-400 font-black text-xl drop-shadow-sm">3</span>
                </div>
            </div>
        `;

        tableBody.innerHTML = top5.map((s, i) => {
            const miniAvatar = s.photo_url
                ? `<img src="${s.photo_url}" class="w-full h-full object-cover" />`
                : `<span class="text-[10px]">${s.name.substring(0,2).toUpperCase()}</span>`;

            return `
            <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='/student/${s.id}'">
                <td class="p-3">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-md bg-gray-100 flex items-center justify-center font-black text-gray-500 overflow-hidden shadow-inner flex-shrink-0">
                            ${miniAvatar}
                        </div>
                        <div>
                            <p class="font-bold text-gray-800 truncate max-w-[90px]">${s.name.split(' ')[0]}</p>
                            <p class="text-[8px] font-bold text-gray-400 uppercase">${s.grade}</p>
                        </div>
                    </div>
                </td>
                <td class="p-3 text-center font-bold text-green-600">${s.t_avg > 0 ? s.t_avg : '-'}</td>
                <td class="p-3 text-center font-bold text-blue-600">${s.f_avg > 0 ? s.f_avg : '-'}</td>
                <td class="p-3 text-center font-bold text-purple-600">${s.th_avg > 0 ? s.th_avg : '-'}</td>
                <td class="p-3 text-center font-black text-gray-700 bg-gray-50/50">${s.hadir}x</td>
            </tr>
            `;
        }).join('');
    };

    fetchDashboardData();

    document.getElementById('btnLogout')?.addEventListener('click', () => {
        localStorage.clear();
        window.location.replace('/');
    });

    // --- CEK ABSENSI ---
    const checkAbsensiStatus = async () => {
        try {
            const res = await fetch(`${API_URL}/api/attendances/today-status`, { headers: { 'Authorization': `Bearer ${token}` }});
            const result = await res.json();

            const statusText = document.getElementById('absensiStatusText');
            const pulseBox = document.getElementById('absensiPulse');

            if (!statusText || !pulseBox) return;

            if (result.isDone) {
                statusText.innerText = "Selesai (Sudah Absen)";
                statusText.style.color = 'var(--accent)';
                statusText.style.fontWeight = '600';
            } else {
                statusText.innerText = result.isMandatory ? "Wajib Absen Sekarang!" : "Absensi Sunnah";
                if (result.isMandatory) {
                    statusText.style.color = 'var(--danger)';
                    statusText.style.fontWeight = '600';
                    pulseBox.style.borderColor = 'rgba(229,72,77,0.5)';
                    pulseBox.classList.add('animate-pulse');
                }
            }
        } catch (e) {}
    };
    checkAbsensiStatus();

    // ==============================================================
    // LOGIKA TRANSFER KOIN REWARD
    // ==============================================================
    window.openTransferDrawer = () => {
        const select = document.getElementById('transferStudentSelect');
        const amountInput = document.getElementById('transferAmountInput');

        if (enrichedStudents && enrichedStudents.length > 0) {
            select.innerHTML = '<option value="" disabled selected>-- Siapa yang berhasil jawab? --</option>' +
                enrichedStudents.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
        } else {
            select.innerHTML = '<option value="">Gagal memuat siswa.</option>';
        }

        amountInput.value = '';
        document.getElementById('drawerTransfer').classList.replace('hidden', 'flex');
    };

    window.closeTransferDrawer = () => {
        document.getElementById('drawerTransfer').classList.replace('flex', 'hidden');
    };

    window.setTransferAmount = (val) => {
        document.getElementById('transferAmountInput').value = val;
    };

    window.submitTransfer = async () => {
        const studentId = document.getElementById('transferStudentSelect').value;
        const amount = parseInt(document.getElementById('transferAmountInput').value);

        if (!studentId || !amount || amount <= 0) {
            window.showToast?.('warning', 'Ups', 'Pilih murid dan pastikan koin diisi dengan benar.');
            return;
        }

        const btn = document.getElementById('btnSubmitTransfer');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...';
        btn.disabled = true;

        try {
            const res = await fetch(`${API_URL}/api/onboarding/transfer-reward`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_id: studentId,
                    amount: amount
                })
            });

            if (!res.ok) throw new Error('Gagal mengirim koin');

            window.showToast?.('success', 'Terkirim!', `Berhasil transfer ${amount} koin sebagai reward.`);
            closeTransferDrawer();

            fetchDashboardData();

        } catch (err) {
            window.showToast?.('danger', 'Error', 'Gagal mentransfer koin. Coba lagi.');
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    };

    window.openDailyChallengeLinkModal = () => {
        document.getElementById('modalDailyChallengeLink')?.classList.replace('hidden', 'flex');
    };

    window.closeDailyChallengeLinkModal = () => {
        document.getElementById('modalDailyChallengeLink')?.classList.replace('flex', 'hidden');
    };

    window.copyDailyChallengeLink = async (mode) => {
        const origin = window.location.origin;

        // Ambil nilai dari inputan event
        const eventName = document.getElementById('dcEventName').value.trim();
        const eventCoin = document.getElementById('dcEventCoin').value || 5;

        // Buat parameter tambahan jika ada event
        let eventParams = '';
        if (eventName) {
            eventParams = `&eventName=${encodeURIComponent(eventName)}&eventCoin=${eventCoin}`;
        }

        const link = mode === 'preview'
            ? `${origin}/daily-challenge?preview=true&token=${token}${eventParams}`
            : `${origin}/daily-challenge?token=${token}${eventParams}`;

        const text = mode === 'preview'
            ? `Link simulasi Daily Challenge:\n${link}`
            : `Assalamualaikum, ini link Daily Challenge hari ini untuk mendapatkan koin:\n${link}`;

        await navigator.clipboard.writeText(text);

        if (window.showToastAlert) {
            window.showToastAlert(
                'success',
                'Link Disalin',
                mode === 'preview'
                    ? 'Link simulasi sudah disalin.'
                    : 'Link real murid beserta event sudah disalin.'
            );
        } else {
            alert('Link berhasil disalin!');
        }

        window.closeDailyChallengeLinkModal();
    };

    // Fungsi untuk memunculkan/menyembunyikan opsi dropdown
    window.toggleEventDuration = () => {
        const isChecked = document.getElementById('dcIsLimitedEvent').checked;
        const container = document.getElementById('dcEventDurationContainer');
        if (isChecked) {
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
        }
    };

    // Update fungsi copy yang lama menjadi ini:
    window.copyDailyChallengeLink = async (mode) => {
        const origin = window.location.origin;

        const eventName = document.getElementById('dcEventName').value.trim();
        const eventCoin = document.getElementById('dcEventCoin').value || 5;

        // Ambil data limit waktu
        const isLimited = document.getElementById('dcIsLimitedEvent').checked;
        const durationDays = parseInt(document.getElementById('dcEventDuration').value);

        let eventParams = '';
        if (eventName) {
            eventParams = `&eventName=${encodeURIComponent(eventName)}&eventCoin=${eventCoin}`;

            // Jika switch nyala, hitung deadline: Waktu Sekarang + (Jumlah Hari * Jam * Menit * Detik * Milidetik)
            if (isLimited) {
                const deadlineTimestamp = Date.now() + (durationDays * 24 * 60 * 60 * 1000);
                eventParams += `&eventDeadline=${deadlineTimestamp}`;
            }
        }

        const link = mode === 'preview'
            ? `${origin}/daily-challenge?preview=true&token=${token}${eventParams}`
            : `${origin}/daily-challenge?token=${token}${eventParams}`;

        const text = mode === 'preview'
            ? `Link simulasi Daily Challenge:\n${link}`
            : `Assalamualaikum, ini link Daily Challenge hari ini untuk mendapatkan koin:\n${link}`;

        await navigator.clipboard.writeText(text);

        if (window.showToastAlert) {
            window.showToastAlert('success', 'Link Disalin', 'Link beserta setingan event sudah disalin.');
        } else {
            alert('Link berhasil disalin!');
        }

        window.closeDailyChallengeLinkModal();
    };
</script>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .animate-slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }

    @keyframes slideUp {
        0% { transform: translateY(15px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }
</style>
