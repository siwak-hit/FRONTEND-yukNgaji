    window.closeResetModal = () => { document.getElementById('modalReset')?.classList.replace('flex', 'hidden'); };

    // Ubah objek {tabel: rows[]} menjadi 1 file CSV bertanda seksi per tabel.
    const buildBackupCsv = (backup) => {
        const esc = (v) => {
            if (v === null || v === undefined) return '';
            let s = (typeof v === 'object') ? JSON.stringify(v) : String(v);
            if (/[",\n\r]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
            return s;
        };
        let out = `BACKUP DATA yukNgaji,Tahun Ajaran ${getAcademicYear()},Diunduh ${new Date().toLocaleString('id-ID')}\n\n`;
        const data = backup?.data || {};
        for (const [table, rows] of Object.entries(data)) {
            out += `# TABEL: ${table} (${rows.length} baris)\n`;
            if (!rows.length) { out += '(kosong)\n\n'; continue; }
            const cols = Object.keys(rows[0]);
            out += cols.map(esc).join(',') + '\n';
            rows.forEach(r => { out += cols.map(c => esc(r[c])).join(',') + '\n'; });
            out += '\n';
        }
        return '﻿' + out; // BOM agar Excel membaca UTF-8
    };

    if (resetPassInput && btnExecuteReset) {
        resetPassInput.addEventListener('input', updateResetButtonState);

        btnExecuteReset.onclick = async () => {
            const password = resetPassInput.value.trim();
            if (!password) return;

            const selected = getSelectedResetTables();
            if (resetMode === 'manual' && selected.length === 0) {
                window.showToast?.('warning', 'Pilih Data', 'Centang minimal satu data untuk direset.');
                return;
            }

            const ringkas = resetMode === 'auto'
                ? 'SEMUA data transaksi & progres siswa'
                : `${selected.length} jenis data terpilih`;
            if (!confirm(`Peringatan Terakhir!\n\nData akan diunduh sebagai CSV lalu ${ringkas} akan DIKOSONGKAN permanen.\n\nLanjutkan?`)) return;

            // Pisahkan pseudo-target progres siswa dari daftar tabel
            const resetStudentProgress = resetMode === 'auto' || selected.includes('students_progress');
            const tables = selected.filter(k => k !== 'students_progress');

            btnExecuteReset.disabled = true;
            btnExecuteReset.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';

            try {
                const res = await fetch(`${API_URL}/api/admin/factory-reset`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password, mode: resetMode, tables, reset_student_progress: resetStudentProgress })
                });
                const result = await res.json();

                if (res.ok) {
                    const csv = buildBackupCsv(result.backup);
                    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url; a.download = `Tahun_Ajaran_${getAcademicYear()}.csv`;
                    document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);

                    window.showToast?.('success', 'Reset Selesai', 'Backup CSV terunduh & data dikosongkan.');
                    closeResetModal(); setTimeout(() => window.location.reload(), 2000);
                } else throw new Error(result.message);
            } catch (err) {
                window.showToast?.('danger', 'Gagal', err.message || 'Terjadi kesalahan.');
                btnExecuteReset.innerHTML = 'Unduh CSV & Reset';
                updateResetButtonState();
                resetPassInput.focus();
            }
        };
