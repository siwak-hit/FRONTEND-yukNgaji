    window.closeNotifModal = () => {
        const modal = document.getElementById('modalNotif');
        const box = document.getElementById('notifBox');
        modal.classList.replace('opacity-100', 'opacity-0');
        if (window.innerWidth < 640) box.classList.replace('translate-y-0', 'translate-y-full');
        setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
    };

    window.deleteNotif = (id) => {
        showConfirmGlobal('Hapus Notifikasi?', 'Notif ini akan dihapus permanen dari laci.', async () => {
            notifications = notifications.filter(n => n.id !== id);
            updateNotifBadge();
            renderNotifications();
            try { await fetch(`${API_URL}/api/notifications/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }}); } catch (e) {}
        }, false, 'danger');
    };

    window.clearAllNotifs = () => {
        if (notifications.length === 0) return;
        showConfirmGlobal('Hapus Semua?', 'Yakin mau hapus semua notifikasi? Laci akan kembali kosong.', async () => {
            notifications = [];
            updateNotifBadge();
            renderNotifications();
            try { await fetch(`${API_URL}/api/notifications/clear`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }}); } catch (e) {}
        }, false, 'danger');
    };

    window.openNotifDetail = async (notifId) => {
        const modal = document.getElementById('modalNotifDetail');
        const box = document.getElementById('notifDetailBox');
        const loading = document.getElementById('notifDetailLoading');
        const content = document.getElementById('notifDetailContent');

        modal.classList.replace('hidden', 'flex');
        setTimeout(() => {
            modal.classList.replace('opacity-0', 'opacity-100');
            box.classList.replace('scale-95', 'scale-100');
        }, 10);

        loading.classList.remove('hidden');
        content.classList.add('hidden');

        try {
            const res = await fetch(`${API_URL}/api/notifications/${notifId}/detail`, {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            const result = await res.json();

            if (!res.ok || result.status === 'error') {
                throw new Error(result.message || 'Gagal mengambil detail notifikasi.');
            }

            const detail = result.data;
            const isExam = detail.type === 'exam';

            document.getElementById('detailStudentName').innerText = detail.student_name || 'Siswa';

            document.getElementById('detailSubjectWeek').innerText = isExam
                ? `${detail.subject || 'UJIAN'} • ${detail.title || 'Ujian'}`
                : `${detail.subject || 'PR'} • PERTEMUAN ${detail.week || '-'}`;

            const scoreEl = document.getElementById('detailScore');
            const score = Number(detail.score || 0);

            scoreEl.innerText = score;
            scoreEl.className = `text-5xl font-black drop-shadow-sm ${
                score >= 80 ? 'text-green-600' : (score >= 60 ? 'text-amber-500' : 'text-red-500')
            }`;

            const photoEl = document.getElementById('detailSatpamPhoto');
            const placeholderEl = document.getElementById('detailSatpamPlaceholder');

            if (detail.photo_url) {
                photoEl.src = detail.photo_url;
                photoEl.classList.remove('hidden');
                placeholderEl.classList.add('hidden');
            } else {
                photoEl.src = '';
                photoEl.classList.add('hidden');
                placeholderEl.classList.remove('hidden');
            }

            loading.classList.add('hidden');
            content.classList.remove('hidden');

        } catch (err) {
            loading.innerHTML = `
                <div class="text-center">
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-3xl mb-3"></i>
                    <p class="text-xs font-bold text-gray-500">${err.message}</p>
