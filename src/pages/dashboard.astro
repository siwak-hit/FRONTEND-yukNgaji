    // ==============================================================
    let notifications = [];

    // TABS NOTIFIKASI
    window.switchNotifTab = (mode) => {
        const btnList = document.getElementById('tabNotifListBtn');
        const btnLB = document.getElementById('tabNotifLBBtn');
        const contentList = document.getElementById('contentNotifList');
        const contentLB = document.getElementById('contentNotifLB');

        const activeCls = "flex-1 py-2.5 text-[10px] font-bold bg-white text-indigo-600 rounded-xl shadow-sm transition-all uppercase tracking-widest";
        const inactiveCls = "flex-1 py-2.5 text-[10px] font-bold text-gray-400 hover:text-gray-600 transition-all uppercase tracking-widest";

        if (mode === 'list') {
            btnList.className = activeCls;
