        const spinView = document.getElementById('gachaSpinView');
        const resultView = document.getElementById('gachaResultView');
        spinView.classList.remove('hidden'); spinView.classList.add('flex');
        resultView.classList.add('hidden'); resultView.classList.remove('flex');
