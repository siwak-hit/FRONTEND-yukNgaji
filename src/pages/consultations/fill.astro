        font-size: 1.45em;
        line-height: 1.9;           /* longgar agar harakat tidak bertumpuk */
        letter-spacing: normal !important;  /* letter-spacing memutus sambungan huruf Arab */
        direction: rtl;
        unicode-bidi: isolate;      /* pisahkan dari teks latin di sekitarnya */
        font-feature-settings: "liga" 1, "calt" 1;  /* aktifkan shaping/penyambungan */
    }
