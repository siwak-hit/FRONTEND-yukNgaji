    const _syncDraftToServer = () => {
        if (isPreview || !isPRMode) return;
        let qids = [];
        try { qids = JSON.parse(localStorage.getItem(qKey)) || []; } catch (e) {}
        if (!qids.length) return; // belum mulai ngerjain, tidak ada yang disimpan
        let answers = null;
        try { answers = JSON.parse(localStorage.getItem(ansKey)); } catch (e) {}
        const idx = parseInt(localStorage.getItem(idxKey)) || 0;
        const endMs = parseInt(localStorage.getItem(timeKey));
        const session_end = !isNaN(endMs) ? new Date(endMs).toISOString() : null;
        fetch(`${API_URL}/api/onboarding/pr-draft`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: studentId, subject, week, question_ids: qids, answers: answers || {}, current_index: idx, session_end })
