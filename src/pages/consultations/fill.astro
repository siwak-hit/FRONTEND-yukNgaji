    .urutan-keterangan-num { width: 26px; height: 26px; border-radius: 8px; border: 1.5px solid; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex-shrink: 0; }
    .urutan-keterangan-text { font-size: 12px; color: #374151; font-weight: 500; line-height: 1.4; }

    #shopPanel{ bottom: 0px; }
