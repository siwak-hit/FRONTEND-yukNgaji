    .gacha-card.gc-item_double_score { background: linear-gradient(160deg, rgba(99,102,241,0.4), rgba(99,102,241,0.12)); border-color: rgba(129,140,248,0.55); }
    .gacha-card.gc-item_perisai { background: linear-gradient(160deg, rgba(59,130,246,0.4), rgba(59,130,246,0.12)); border-color: rgba(96,165,250,0.55); }
    .gacha-card.gc-item_extra_life { background: linear-gradient(160deg, rgba(236,72,153,0.42), rgba(236,72,153,0.12)); border-color: rgba(244,114,182,0.55); }
    .gacha-card.is-winner { box-shadow: 0 0 0 2.5px rgba(252,211,77,0.9) inset, 0 0 22px rgba(252,211,77,0.4); }
    .gacha-card-name { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; color: #fff; opacity: 0.92; text-align: center; line-height: 1.15; padding: 0 6px; }
