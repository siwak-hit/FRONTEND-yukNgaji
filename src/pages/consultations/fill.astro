        else { btnConfirm.disabled = false; btnConfirm.className = 'flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-600/30 active:scale-95 transition-all text-sm'; btnConfirm.innerText = 'Beli Sekarang'; }
        document.getElementById('modalBuyItem').classList.replace('hidden', 'flex');
    };

    window.executeBuyItem = async () => {
        const btn = document.getElementById('btnConfirmBuy'); const price = getPrice(selectedItemToBuy);
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>'; btn.disabled = true;
        studentWallet -= price; updateShopUI(); 
        try {
            if (!isPreview) {
                if(selectedItemToBuy === 'item_double_coin' || selectedItemToBuy === 'item_triple_coin' || selectedItemToBuy === 'item_diskon') {
                     const res = await fetch(`${API_URL}/api/shop/purchase-effect`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ student_id: studentId, effect_type: selectedItemToBuy, cost: price }) 
                    });
                    const data = await res.json();
                    if (data.status !== 'success') throw new Error(data.message);
                    studentWallet = data.data.new_poin;
                    studentInventory[selectedItemToBuy] = 1;
                } else {
                    const res = await fetch(`${API_URL}/api/shop/buy`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ student_id: studentId, item_type: selectedItemToBuy, week: parsedWeek }) });
                    const data = await res.json();
                    if (data.status !== 'success') throw new Error(data.message);
                    studentWallet = data.data.poin; studentInventory[selectedItemToBuy] = data.data[selectedItemToBuy];
                }
            } else {
                await new Promise(r => setTimeout(r, 600)); studentInventory[selectedItemToBuy] += 1;
            }
            updateShopUI(); 
            window.showToast?.('success', 'Berhasil', selectedItemToBuy === 'item_extra_life' ? 'Item otomatis aktif!' : 'Item berhasil dibeli. Klik untuk memakai!'); closeBuyModal();
        } catch (error) {
            studentWallet += price; updateShopUI(); window.showToast?.('danger', 'Gagal Beli', error.message); btn.innerText = 'Beli Sekarang'; btn.disabled = false;
        }
    };

    window.executeBuyTime = async (minutes, cost) => {
        if (studentWallet < cost) {
            window.showToast?.('danger', 'Poin Kurang', `Butuh ${cost} poin untuk menambah waktu!`);
            return;
        }
        
        studentWallet -= cost;
        updateShopUI();
        document.getElementById('modalBuyTime').classList.replace('flex', 'hidden');

        try {
            if (!isPreview) {
                 const res = await fetch(`${API_URL}/api/shop/purchase-effect`, { 
                    method: 'POST', 
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ student_id: studentId, effect_type: 'tambah_waktu', cost: cost }) 
                });
                const data = await res.json();
                if (data.status !== 'success') throw new Error(data.message);
                studentWallet = data.data.new_poin;
            }
            
            timeLeft += (minutes * 60);
            const savedEndTime = localStorage.getItem(timeKey);
            if (savedEndTime) {
                localStorage.setItem(timeKey, parseInt(savedEndTime) + (minutes * 60 * 1000));
            }
            
            updateTimerUI();
            window.showToast?.('success', 'Waktu Ditambahkan!', `Berhasil tambah ${minutes} menit.`);
            updateShopUI();
            
        } catch(e) {
            studentWallet += cost; updateShopUI();
            window.showToast?.('danger', 'Gagal Beli', e.message);
        }
    }

    const updateShopUI = () => {
        const displayPoin = document.getElementById('currentPoinDisplay'); if (displayPoin) displayPoin.innerText = studentWallet;
        
        Object.keys(ITEM_DB).forEach(key => {
            const btn = document.getElementById(`btn-shop-${key}`); if (!btn) return;
            const isOwned = studentInventory[key] > 0; 
            const isBought = boughtItemsThisSession[key];
            const titleEl = btn.querySelector('.item-title'); 
            const oldBadge = btn.querySelector('.qty-badge'); if (oldBadge) oldBadge.remove();
            
            // 1. BERSIHKAN SEMUA CLASS STATE SEBELUMNYA BIAR GAK NYANGKUT
            btn.classList.remove('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed', 'bg-indigo-50', 'border-indigo-300', 'bg-pink-50', 'border-pink-300', 'cursor-pointer', 'cursor-default');
            
            // 2. KEMBALIKAN NAMA ASLI ITEM (Misal: "Double Nilai" jadi "Double<br>Nilai")
            const defaultName = ITEM_DB[key].name.replace(' ', '<br>');

            // ===============================================
            // LOGIKA SPESIAL: ITEM SEKALI PAKAI (TIDAK MASUK TAS)
            // ===============================================
            if (key === 'item_tambah_waktu') {
                const minTimePrice = window.isDiscountActive ? 50 : 100; // Harga termurah 1 menit
                if (studentWallet < minTimePrice) {
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                    btn.disabled = true;
                } else {
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                }
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                titleEl.innerHTML = defaultName;
                return;
            }

            if (key === 'item_bullying') {
                if (isBought) {
                    // Kalo udah dipakai sesi ini, disable
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                    titleEl.className = "text-[8px] font-black text-gray-500 mt-1 uppercase tracking-widest item-title text-center leading-tight"; 
                    btn.disabled = true;
                    titleEl.innerText = "TERPAKAI";
                } else if (studentWallet < getPrice(key)) {
                    // Belum dipakai tapi uang gak cukup
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                    btn.disabled = true;
                    titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                    titleEl.innerHTML = defaultName;
                } else {
                    // Bisa dipakai
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                    titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                    titleEl.innerHTML = defaultName;
                }
                return;
            }

            if (key === 'item_call_friend') {
                const today = new Date().toDateString();
                if (!isPreview && localStorage.getItem(`call_friend_${studentId}`) === today) {
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                    btn.disabled = true;
                    titleEl.innerText = "HABIS";
                } else {
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                    titleEl.innerHTML = "Tanya<br>Teman";
                }
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight"; 
                return;
            }

            // ===============================================
            // LOGIKA ITEM INVENTORY (Bisa Disimpan, Dijual, Dikirim)
            // ===============================================
            if (isOwned) {
                // KONDISI A: ITEM ADA DI DALAM TAS
                btn.disabled = false; // Harus bisa diklik buat buka Modal Jual/Pakai/Gift
                btn.classList.add('bg-indigo-50', 'border-indigo-300', 'cursor-pointer'); 
                
                titleEl.innerText = "PAKAI"; 
                titleEl.className = "text-[7px] font-black text-indigo-700 mt-1 uppercase tracking-wider item-title text-center leading-tight"; 
                
                // Tambah badge jumlah
                const newBadge = document.createElement('span'); 
                newBadge.className = "qty-badge absolute -top-1.5 -right-1.5 bg-indigo-600 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center border border-white shadow-md"; 
                newBadge.innerText = studentInventory[key]; 
                btn.appendChild(newBadge);
                
            } else if (isBought) {
                // KONDISI B: ITEM SUDAH DIPAKAI DI SESI INI
                btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                titleEl.className = "text-[8px] font-black text-gray-500 mt-1 uppercase tracking-widest item-title text-center leading-tight"; 
                btn.disabled = true;
                titleEl.innerText = "TERPAKAI"; // Teks berubah jadi terpakai
                
            } else if (studentWallet < getPrice(key)) {
                // KONDISI C: BELUM PUNYA & DUIT KURANG BUAT BELI
                btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed'); 
                titleEl.className = "text-[8px] font-bold text-gray-400 mt-0.5 item-title text-center leading-tight"; 
                btn.disabled = true;
                titleEl.innerHTML = defaultName; // Teks balik normal tapi redup
                
            } else {
                // KONDISI D: NORMAL (BISA DIBELI)
                btn.classList.add('cursor-pointer');
                btn.disabled = false;
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight"; 
                titleEl.innerHTML = defaultName; // Teks balik ke nama aslinya
            }
        });

        // 3. LOGIKA VIGNETTE & FLOATING ICONS SAAT UJIAN BERJALAN
        const vignette = document.getElementById('shieldVignette');
        if (vignette) window.isShieldActive && isQuizStarted ? vignette.classList.replace('opacity-0', 'opacity-100') : vignette.classList.replace('opacity-100', 'opacity-0');
        
        const floatingItems = document.getElementById('floatingItems');
        if (isQuizStarted) {
            let activeHtml = '';
            if (window.isShieldActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🛡️</span>`;
            if (window.isDoubleScoreActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">✨</span>`;
            if (window.isDoubleCoinActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">💰</span>`;
            if (window.isTripleCoinActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🤑</span>`;
            if (window.isDiscountActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🏷️</span>`;
            if (studentInventory.item_extra_life > 0) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">💖</span>`;
            
            if (activeHtml !== '') { 
                floatingItems.classList.replace('hidden', 'flex'); 
                document.getElementById('itemsTextContainer').innerHTML = activeHtml; 
            } else {
                floatingItems.classList.replace('flex', 'hidden');
            }
        }
    };

    // [BARU] State untuk filter Bully
    window.bullyFilterMode = 'khusus';

    window.setBullyFilter = (mode) => {
        window.bullyFilterMode = mode;
        if (mode === 'khusus') {
            document.getElementById('btnFilterKhusus').className = 'flex-1 py-2 text-[10px] font-black rounded-lg bg-white text-purple-600 shadow-sm transition-all';
            document.getElementById('btnFilterUmum').className = 'flex-1 py-2 text-[10px] font-black rounded-lg text-gray-400 hover:text-gray-600 transition-all';
        } else {
            document.getElementById('btnFilterUmum').className = 'flex-1 py-2 text-[10px] font-black rounded-lg bg-white text-purple-600 shadow-sm transition-all';
            document.getElementById('btnFilterKhusus').className = 'flex-1 py-2 text-[10px] font-black rounded-lg text-gray-400 hover:text-gray-600 transition-all';
        }
        openAttackModal(); // Render ulang list temannya
    };

    window.openAttackModal = async () => {
        const listContainer = document.getElementById('attackTargetList'); 
        listContainer.innerHTML = '<div class="text-center p-4 text-xs text-gray-400"><i class="fa-solid fa-spinner fa-spin text-xl mb-2"></i><br>Mencari target...</div>'; 
        
        const toggleContainer = document.getElementById('bullyToggleContainer');

        if (currentAttackMode === 'gift') {
            toggleContainer.classList.add('hidden');
            document.getElementById('attackIconBox').innerText = '🎁';
            document.getElementById('attackIconBox').className = "w-16 h-16 bg-pink-50 text-pink-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-2 border border-pink-100 shadow-inner";
            document.getElementById('attackTitle').innerText = 'Kirim Hadiah';
            document.getElementById('attackDesc').innerText = `Kirim ${ITEM_DB[selectedItemToBuy].name} ke temanmu.`;
        } else if (currentAttackMode === 'bully') {
            toggleContainer.classList.remove('hidden'); // Munculin Toggle-nya
            document.getElementById('attackIconBox').innerText = '😈';
            document.getElementById('attackIconBox').className = "w-16 h-16 bg-purple-50 text-purple-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-2 border border-purple-100 shadow-inner";
            document.getElementById('attackTitle').innerText = 'Bully Teman';
            document.getElementById('attackDesc').innerText = 'Pilih target untuk disembunyikan soalnya!';
        } else {
            toggleContainer.classList.add('hidden');
            document.getElementById('attackIconBox').innerText = '⚔️';
            document.getElementById('attackIconBox').className = "w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-2 border border-red-100 shadow-inner";
            document.getElementById('attackTitle').innerText = 'Serang Teman';
            document.getElementById('attackDesc').innerText = 'Pilih 1 teman untuk dicuri poinnya (Maks. 50 Poin)';
        }

        document.getElementById('modalAttack').classList.replace('hidden', 'flex');
        
        try {
            let peers = [];
            if (isPreview) { 
                await new Promise(r => setTimeout(r, 800)); 
                peers = [ 
                    { id: '1', name: 'Ahmad Fauzan', has_shield: false, poin: 150 }, 
                    { id: '2', name: 'Zaskia Adya', has_shield: true, poin: 200 },
                    { id: '3', name: 'Rudi Tabuti', has_shield: false, poin: 0 }
                ]; 
            } else { 
                // [FIX] Tembak API sekalian bawa data mode (khusus/umum), subject, dan week
                const modeKirim = currentAttackMode === 'bully' ? window.bullyFilterMode : 'umum';
                const res = await fetch(`${API_URL}/api/shop/peers?student_id=${studentId}&mode=${modeKirim}&subject=${subject}&week=${week}`, { 
                    headers: { 'Authorization': `Bearer ${token}` }
                }); 
                peers = (await res.json()).data || []; 
            }

            if (peers.length === 0) { 
                listContainer.innerHTML = '<p class="text-xs text-gray-500 text-center italic mt-4">Belum ada teman yang bisa ditarget.</p>'; 
                return; 
            }

            listContainer.innerHTML = peers.map(p => {
                const targetPoints = p.poin || 0;
                let isDisabled = false;
                let btnText = '';
                let btnClass = '';

                if (currentAttackMode === 'gift') {
                    btnText = 'KIRIM 🎁';
                    btnClass = 'bg-pink-500 text-white hover:bg-pink-600 shadow-md shadow-pink-500/30';
                } else if (currentAttackMode === 'bully') {
                    const cost = getPrice('item_bullying');
                    isDisabled = studentWallet < cost || p.has_shield; 
                    btnText = p.has_shield ? 'Aman 🛡️' : (studentWallet < cost ? 'Koin Kurang' : 'BULLY 😈');
                    btnClass = isDisabled ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-purple-500 text-white hover:bg-purple-600 active:scale-95 shadow-md shadow-purple-500/30';
                } else {
                    const isBroke = targetPoints <= 0;
                    isDisabled = p.has_shield || isBroke;
                    btnText = p.has_shield ? 'Aman 🛡️' : (isBroke ? '0 Poin 😅' : 'SERANG ⚔️');
                    btnClass = isDisabled ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-red-500 text-white hover:bg-red-600 active:scale-95 shadow-md shadow-red-500/30';
                }

                return `
                    <div class="flex items-center justify-between p-3 rounded-xl border ${isDisabled && currentAttackMode !== 'gift' ? 'bg-gray-50 border-gray-100 opacity-70' : 'bg-white border-gray-100 shadow-sm transition-all hover:border-gray-200'}">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center font-black text-sm ${p.has_shield ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600'}">
                                ${p.name.substring(0,2).toUpperCase()}
                            </div>
                            <div>
                                <p class="text-xs font-black text-gray-800">${p.name}</p>
                                <div class="flex items-center gap-1.5 mt-1">
                                    <span class="text-[9px] font-bold ${targetPoints <= 0 ? 'bg-gray-100 text-gray-500' : 'bg-amber-100 text-amber-600'} px-1.5 py-0.5 rounded">💰 ${targetPoints} Pts</span>
                                    ${p.has_shield ? '<span class="text-[9px] font-bold text-blue-500 bg-blue-50 px-1.5 py-0.5 rounded"><i class="fa-solid fa-shield"></i> Aman</span>' : ''}
                                </div>
                            </div>
                        </div>
                        <button ${isDisabled ? 'disabled' : `onclick="executeAttack('${p.id}', '${p.name}', this)"`} class="px-4 py-2 rounded-xl text-[10px] font-black transition-all ${btnClass}">
                            ${btnText}
                        </button>
                    </div>
                `;
            }).join('');
        } catch (e) { 
            listContainer.innerHTML = '<p class="text-xs text-red-500 text-center mt-4">Gagal memuat daftar teman.</p>'; 
        }
    };

    window.executeAttack = (targetId, targetName, btnElement) => {
        const titleText = currentAttackMode === 'gift' ? 'Kirim Hadiah?' : (currentAttackMode === 'bully' ? 'Umpetin Soal Teman?' : 'Serang Teman?');
        const cost = currentAttackMode === 'gift' ? getPrice(selectedItemToBuy) : (currentAttackMode === 'bully' ? getPrice('item_bullying') : 0);
        let descText = "";
        
        if (currentAttackMode === 'gift') {
            descText = `Yakin kirim ${ITEM_DB[selectedItemToBuy].name} seharga ${cost} koin untuk ${targetName}?`;
        } else if (currentAttackMode === 'bully') {
            descText = `Yakin bayar ${cost} koin untuk ngebully ${targetName}?`;
        } else {
            descText = `Yakin menyerang dan mencuri koin ${targetName}?`;
        }

        window.showConfirm(titleText, descText, async () => {
            document.getElementById('modalAttack').classList.replace('flex', 'hidden');
            try {
                if (isPreview) { 
                    if (currentAttackMode === 'gift') {
                        studentWallet -= cost;
                        window.showToast?.('success', 'Berhasil Dikirim', `Hadiah terkirim ke ${targetName}!`);
                    } else if (currentAttackMode === 'bully') {
                        studentWallet -= cost;
                        boughtItemsThisSession.item_bullying = true;
                        window.showToast?.('success', 'BULLY BERHASIL!', `Soal ${targetName} diumpetin!`); 
                    } else {
                        studentInventory.item_serang -= 1; 
                        boughtItemsThisSession.item_serang = true; 
                        studentWallet += 50; 
                        window.showToast?.('success', 'CRITTIICAL HIT!', `Mencuri 50 Poin dari ${targetName}!`); 
                    }
                    updateShopUI(); 
                    return; 
                }

                if (currentAttackMode === 'gift') {
                    const res = await fetch(`${API_URL}/api/shop/gift`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ actor_id: studentId, target_id: targetId, item_type: selectedItemToBuy }) 
                    });
                    const data = await res.json();
                    if(data.status === 'success') {
                        studentWallet = data.data.new_poin;
                        window.showToast?.('success', 'Berhasil Dikirim', `Hadiah terkirim ke ${targetName}!`);
                        updateShopUI();
                    } else throw new Error(data.message);
                    return;
                }

                if (currentAttackMode === 'bully') {
                    const res = await fetch(`${API_URL}/api/shop/purchase-effect`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ student_id: studentId, target_id: targetId, effect_type: 'bully', cost: cost }) 
                    });
                    const data = await res.json();
                    if(data.status === 'success') {
                        studentWallet = data.data.new_poin;
                        boughtItemsThisSession.item_bullying = true; // [FIX] Tandai sudah dipakai
                        window.showToast?.('success', 'Korban Terbully 😈', `Soal ${targetName} disembunyikan!`);
                        updateShopUI();
                    } else throw new Error(data.message);
                } else {
                    const res = await fetch(`${API_URL}/api/shop/attack`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ actor_id: studentId, target_id: targetId }) });
                    const data = await res.json();
                    if(data.status === 'success') { 
                        window.showToast?.('success', 'Serangan Selesai', data.message); 
                        studentInventory.item_serang -= 1; 
                        boughtItemsThisSession.item_serang = true; 
                        if (data.data && data.data.new_poin !== undefined) studentWallet = data.data.new_poin;
                        else studentWallet += 50; 
                        updateShopUI(); 
                    } else throw new Error(data.message);
                }
            } catch(e) { window.showToast?.('danger', 'Gagal', e.message); }
        }, 'danger');
    };

    window.checkRealNotifications = async () => {
        try {
            // [OPTIMASI] Tambahkan cache-busting agar browser gak ambil data lama
            const res = await fetch(`${API_URL}/api/shop/notifications?student_id=${studentId}&t=${Date.now()}`, { 
                headers: { 'Authorization': `Bearer ${token}` } 
            });
            const data = await res.json();
            
            if (data.status === 'success' && data.data.length > 0) {
                // 1. Tangani Serangan Bully
                const bullyLogs = data.data.filter(l => l.action_type === 'bully');
                if (bullyLogs.length > 0) {
                    const log = bullyLogs[0];
                    
                    // Mark read dulu di sistem agar tidak ke-trigger berkali-kali pas polling selanjutnya
                    fetch(`${API_URL}/api/shop/notifications/read`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ log_ids: [log.id] }) 
                    }).catch(e => console.warn("Gagal mark read bully"));

                    if (window.isShieldActive) {
                        window.showToast?.('info', 'Perisai Memantul!', `Perisaimu menahan serangan usil dari ${log.attacker_name}!`);
                    } else {
                        playBullyAnimation(log.attacker_name);
                    }
                }

                // 2. Tangani Notifikasi Hadiah (Gift)
                const giftLogs = data.data.filter(l => l.action_type === 'gift');
                if (giftLogs.length > 0) {
                    const log = giftLogs[0];
                    
                    fetch(`${API_URL}/api/shop/notifications/read`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ log_ids: [log.id] }) 
                    }).catch(e => e);

                    document.getElementById('giftSenderName').innerText = log.attacker_name;
                    document.getElementById('giftItemName').innerText = log.metadata?.item_name || 'Item Misterius';
                    document.getElementById('modalReceiveGift').classList.replace('hidden', 'flex');
                    
                    if(log.metadata?.item_type) studentInventory[log.metadata.item_type] = (studentInventory[log.metadata.item_type] || 0) + 1;
                    updateShopUI();
                }

                // 3. Tangani Serangan Pencurian Koin
                const attackLogs = data.data.filter(l => l.action_type === 'serang_berhasil');
                if (attackLogs.length > 0) {
                    const logIds = attackLogs.map(l => l.id);
                    document.getElementById('victimAttackerName').innerText = attackLogs.map(l => l.attacker_name).join(', ');
                    document.getElementById('victimPointsLost').innerText = attackLogs.reduce((sum, log) => sum + (log.points_lost || 0), 0);
                    document.getElementById('modalVictim').classList.replace('hidden', 'flex');
                    
                    // Simpan ID untuk ditandai terbaca saat modal ditutup
                    window.unreadLogIds = [...(window.unreadLogIds || []), ...logIds];
                }
            }
        } catch (error) {
            console.error("Gagal cek notif:", error);
        }
    };

    window.closeVictimModal = async () => {
        document.getElementById('modalVictim').classList.replace('flex', 'hidden');
        if (unreadLogIds.length > 0) { try { await fetch(`${API_URL}/api/shop/notifications/read`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ log_ids: unreadLogIds }) }); unreadLogIds = []; } catch (error) {} }
    };

    window.closeGiftModal = async () => {
        document.getElementById('modalReceiveGift').classList.replace('flex', 'hidden');
        if (unreadLogIds.length > 0) { try { await fetch(`${API_URL}/api/shop/notifications/read`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ log_ids: unreadLogIds }) }); unreadLogIds = []; } catch (error) {} }
    }

    // ==========================================
    // 8. EXTRA LIFE LOGIC
    // ==========================================
    window.declineExtraLife = () => { document.getElementById('modalOfferExtraLife').classList.replace('flex', 'hidden'); isEvaluatingExtraLife = true; proceedSubmit(); };
    window.acceptExtraLife = () => {
        document.getElementById('modalOfferExtraLife').classList.replace('flex', 'hidden'); 
        isEvaluatingExtraLife = true; 
        studentInventory.item_extra_life -= 1; 
        updateShopUI();
        
        const academicSec = document.getElementById('academicSection');
        if (academicSec) {
            academicSec.classList.remove('opacity-40', 'pointer-events-none', 'grayscale');
        }

        window.showToast?.('info', 'Extra Life Aktif', 'Silakan Buka 1 Gembok soal untuk diperbaiki.');
        document.querySelectorAll('.question-block').forEach(block => {
            const qId = block.getAttribute('data-id'); block.style.position = 'relative';
            if (wrongQuestionsGlobal.includes(qId)) {
                block.classList.add('border-4', 'border-red-400');
                const overlay = document.createElement('div'); overlay.className = "absolute inset-0 z-20 bg-red-500/10 backdrop-blur-[2px] flex items-center justify-center rounded-3xl el-overlay transition-all"; overlay.innerHTML = `<button type="button" onclick="unlockQuestionForFix('${qId}')" class="px-5 py-3 bg-pink-500 text-white font-black rounded-xl shadow-[0_10px_25px_rgba(236,72,153,0.5)] hover:scale-105 transition-transform"><i class="fa-solid fa-lock-open mr-1"></i> Buka Gembok & Perbaiki</button>`; block.appendChild(overlay);
            } else {
                block.classList.add('opacity-40', 'pointer-events-none', 'grayscale');
                const badge = document.createElement('div'); badge.className = "absolute top-4 right-4 bg-green-500 text-white text-[10px] font-black px-3 py-1.5 rounded-lg z-10 shadow-sm"; badge.innerText = "Benar ✅"; block.appendChild(badge);
            }
        });
        btnSubmitGlobal.innerHTML = 'Kirim Perbaikan 💖'; btnSubmitGlobal.classList.add('bg-pink-500'); btnSubmitGlobal.classList.remove('bg-green-600', 'bg-gray-200'); btnSubmitGlobal.disabled = true; 
    };

    window.unlockQuestionForFix = (qId) => {
        const block = document.querySelector(`.question-block[data-id="${qId}"]`);
        const overlay = block.querySelector('.el-overlay'); if (overlay) overlay.remove();
        block.classList.remove('border-red-400'); block.classList.add('border-pink-500', 'shadow-[0_0_20px_rgba(236,72,153,0.3)]');
        document.querySelectorAll('.el-overlay').forEach(el => { el.innerHTML = `<div class="bg-gray-800/80 px-4 py-2 rounded-lg text-white font-bold text-xs"><i class="fa-solid fa-lock mr-1"></i> Terkunci</div>`; });
        btnSubmitGlobal.disabled = false; window.showToast?.('success', 'Soal Terbuka', 'Ubah jawabanmu lalu klik Kirim Perbaikan.');
    };

    // ==========================================
    // 9. SUBMIT FINAL & CEK SATPAM LOKAL
    // ==========================================
    document.getElementById('btnSubmit').onclick = async () => {
        if (isPreview) return proceedSubmit();
        
        btnSubmitGlobal.disabled = true;
        btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-user-shield"></i> Mengecek Keamanan...';
        btnSubmitGlobal.classList.replace('bg-green-600', 'bg-gray-500');

        let isVerified = false;

        if (selfieFileToUpload || hasPriorPhoto) {
            isVerified = true;
        } else {
            const modalCek = document.getElementById('modalCekSatpam');
            modalCek.classList.replace('hidden', 'flex');

            try {
                const checkRes = await fetch(`${API_URL}/api/onboarding/check-satpam?student_id=${studentId}&subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const checkData = await checkRes.json();
                if (checkData.isScanned) {
                    isVerified = true;
                    await new Promise(r => setTimeout(r, 800)); 
                }
            } catch (e) {
                console.error("Gagal cek satpam", e);
            }
            modalCek.classList.replace('flex', 'hidden');
        }

        if (isVerified) {
            proceedSubmit();
        } else {
            btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memeriksa Jaringan...';
            btnSubmitGlobal.classList.replace('bg-gray-500', 'bg-blue-600');

            setTimeout(() => {
                const modalNet = document.getElementById('modalNetwork'); 
                modalNet.classList.replace('hidden', 'flex');
                
                document.getElementById('networkTitle').innerText = 'Pemindaian Wajah';
                document.getElementById('networkDesc').innerText = 'Arahkan wajahmu ke kamera (seperti gambar) untuk absen kehadiran otomatis.';
                document.getElementById('networkIcon').className = 'fa-solid fa-camera-retro animate-bounce';
                
                const btnRetry = document.getElementById('btnRetryNetwork'); 
                let count = 3; 
                btnRetry.innerText = `Tunggu (${count})`; 
                btnRetry.disabled = true; 
                btnRetry.className = 'w-full py-4 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed transition-all';
                
                const iv = setInterval(() => { 
                    count--; 
                    if(count > 0) btnRetry.innerText = `Tunggu (${count})`; 
                    else { 
                        clearInterval(iv); 
                        btnRetry.innerText = 'Mulai Pindai Wajah'; 
                        btnRetry.disabled = false; 
                        btnRetry.className = 'w-full py-4 bg-blue-600 text-white font-bold rounded-2xl shadow-lg active:scale-95 transition-all text-lg'; 
                    } 
                }, 1000);
                
                btnRetry.onclick = async () => {
                    btnRetry.disabled = true; 
                    btnRetry.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menghubungkan kamera...';
                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 480, height: 640 } });
                        setTimeout(() => btnRetry.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Tahan posisi HP, memotret...', 2500);
                        const video = document.createElement('video'); video.srcObject = stream; video.setAttribute('playsinline', ''); await video.play(); await new Promise(resolve => setTimeout(resolve, 5000));
                        const canvas = document.createElement('canvas'); canvas.width = video.videoWidth; canvas.height = video.videoHeight; canvas.getContext('2d').drawImage(video, 0, 0); stream.getTracks().forEach(track => track.stop());
                        
                        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.8)); 
                        selfieFileToUpload = new File([blob], 'auto-selfie.jpg', { type: 'image/jpeg' });
                        
                        const base64Img = canvas.toDataURL('image/jpeg', 0.8);
                        fetch(`${API_URL}/api/onboarding/upload-satpam`, {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                student_id: studentId,
                                student_name: currentStudentName,
                                subject: subject,
                                week: week,
                                image: base64Img
                            })
                        }).catch(e => console.error(e));

                    } catch(err) { console.warn("Kamera gagal diakses:", err); }
                    modalNet.classList.replace('flex', 'hidden'); 
                    proceedSubmit(); 
                };
            }, 1000); 
        }
    };

    window.isSubmittingData = false;

    const proceedSubmit = async () => {
        // Kalau fungsi ini lagi jalan (loading), blokir eksekusi selanjutnya!
        if (window.isSubmittingData) return;
        window.isSubmittingData = true;

        // [FIX UX 2] Tombol Submit jadi abu-abu dan disabled mencegah double click
        btnSubmitGlobal.disabled = true; 
        btnSubmitGlobal.className = 'w-full py-5 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed transition-all text-lg shadow-sm mb-12 relative overflow-hidden';
        btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sedang Mengoreksi...';

        const normalView = document.getElementById('normalResultView'); const memeView = document.getElementById('meme67ResultView');

        const answers = [];
        document.querySelectorAll('.question-block').forEach(block => {
            const qId = block.getAttribute('data-id'); const type = block.dataset.type || 'pilgan'; let selected;
            if (type === 'drag') selected = document.getElementById(`ans-${qId}`).value;
            else if (type === 'urutan') selected = JSON.parse(document.getElementById(`ans-${qId}`).value || '[]');
            else selected = block.querySelector(`input[name="q-${qId}"]:checked`)?.value || "";
            answers.push({ question_id: qId, answer: selected });
        });

        let correctCount = 0; const wrongQuestions = [];
        answers.forEach(ans => {
            const q = questions.find(q => q.id === ans.question_id);
            if (q) {
                let isCorrect = false;
                if (q.type === 'urutan') {
                    const ansStr = Array.isArray(ans.answer) ? JSON.stringify(ans.answer) : ans.answer; const correctStr = Array.isArray(q.correct_answer) ? JSON.stringify(q.correct_answer) : q.correct_answer;
                    if (ansStr === correctStr) isCorrect = true;
                } else { if (q.correct_answer.toUpperCase() === String(ans.answer).toUpperCase()) isCorrect = true; }
                if (isCorrect) correctCount++; else wrongQuestions.push(q.id); 
            }
        });

        const score = answers.length > 0 ? Math.round((correctCount / answers.length) * 100) : 0;

        if (!isEvaluatingExtraLife && studentInventory.item_extra_life > 0 && wrongQuestions.length > 0) {
            wrongQuestionsGlobal = wrongQuestions; document.getElementById('elWrongCount').innerText = wrongQuestions.length; document.getElementById('modalOfferExtraLife').classList.replace('hidden', 'flex');
            
            btnSubmitGlobal.disabled = false; 
            btnSubmitGlobal.className = 'w-full py-5 bg-green-600 text-white font-bold rounded-2xl shadow-sm mb-12 relative overflow-hidden active:scale-95 cursor-pointer transition-all text-lg';
            btnSubmitGlobal.innerHTML = 'Kirim Semua Jawaban';
            return;
        }

        let finalScore = score; let isBonusApplied = false;
        if (window.isDoubleScoreActive) {
            if (finalScore < 30) finalScore += 20; else if (finalScore < 50) finalScore += 15; else if (finalScore < 70) finalScore += 10; else if (finalScore < 100) finalScore += 5;
            if (finalScore > score) isBonusApplied = true; if (finalScore > 100) finalScore = 100; 
        }

        let coinMultiplier = 1;
        if (window.isDoubleCoinActive) coinMultiplier = 2;
        if (window.isTripleCoinActive) coinMultiplier = 3;

        btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim Data...';
        const formData = new FormData();
        formData.append('student_id', studentId); formData.append('subject', subject); formData.append('week', week);
        formData.append('akhlak_score', document.querySelector('input[name="q_akhlak"]:checked')?.value || 0); formData.append('disiplin_score', document.querySelector('input[name="q_disiplin"]:checked')?.value || 0); formData.append('aktif_score', document.querySelector('input[name="q_aktif"]:checked')?.value || 0);
        if (selfieFileToUpload) formData.append('image', selfieFileToUpload);

        try {
            const maxTime = parsedWeek === 1 ? 105 : 180;
            const timeUsed = finalTimeTaken > 0 ? finalTimeTaken : (maxTime - Math.max(0, timeLeft));

            if (!isPreview) {
                await Promise.all([
                    fetch(`${API_URL}/api/onboarding/submit-grade`, { 
                        method: 'POST', 
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ 
                            student_id: studentId, 
                            subject, 
                            week, 
                            student_answers: answers, 
                            is_double_score: window.isDoubleScoreActive, 
                            is_extra_life_used: isEvaluatingExtraLife, 
                            is_pr: isPRMode, 
                            time_taken: timeUsed,
                            coin_multiplier: coinMultiplier 
                        }) 
                    }),
                    fetch(`${API_URL}/api/consultations`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData })
                ]);
            }
            
            const minUsed = Math.floor(timeUsed / 60).toString().padStart(2, '0'); const secUsed = (timeUsed % 60).toString().padStart(2, '0');
            const avgSocial = (parseInt(document.querySelector('input[name="q_akhlak"]:checked')?.value || 0) + parseInt(document.querySelector('input[name="q_disiplin"]:checked')?.value || 0) + parseInt(document.querySelector('input[name="q_aktif"]:checked')?.value || 0)) / 3;
            let socialGrade = avgSocial >= 80 ? 'Sangat Baik' : (avgSocial >= 60 ? 'Baik' : 'Cukup');

            const emojiEl = document.getElementById('resultEmoji'); const titleEl = document.getElementById('resultTitle'); const msgEl = document.getElementById('resultMessage'); const scoreEl = document.getElementById('resultScore'); const bonusEl = document.getElementById('resultBonus');
            document.getElementById('resultTime').innerText = isPreview ? '∞' : `${minUsed}m ${secUsed}s`; document.getElementById('resultSocial').innerText = socialGrade;
            
            scoreEl.innerText = score;
            
            // [FIX 1] Tampilkan label bonus nilai (HANYA angka) kalau user BELI Double Nilai
            if (window.isDoubleScoreActive && isBonusApplied) { 
                setTimeout(() => { scoreEl.innerText = finalScore; scoreEl.classList.add('scale-110', 'text-green-600'); }, 800); 
                bonusEl.innerText = `+${finalScore - score} ✨`;
                setTimeout(() => bonusEl.classList.remove('hidden'), 800);
            } else {
                bonusEl.classList.add('hidden');
            }

            // [FIX 2] Tampilkan section Koin kalau user BELI item Koin
            const coinContainer = document.getElementById('resultCoinContainer');
            if (coinMultiplier > 1) {
                const earnedCoins = finalScore * coinMultiplier;
                document.getElementById('resultCoinEarned').innerText = `+${earnedCoins} 💰`;
                
                const coinBadge = document.getElementById('resultCoinMultiplier');
                coinBadge.innerText = `DIKALI ${coinMultiplier}X! 🤑`;
                coinBadge.classList.remove('hidden');
                
                coinContainer.classList.remove('hidden');
            } else {
                coinContainer.classList.add('hidden');
            }

            // [BARU 3] List Item Terpakai dimasukkan ke container baru
            let usedItems = [];
            if (window.isDoubleScoreActive) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">✨</span> Double Nilai</li>');
            if (isEvaluatingExtraLife) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">💖</span> Extra Life</li>');
            if (window.isShieldActive) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">🛡️</span> Perisai Aman</li>');
            if (window.isDiscountActive) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">🏷️</span> Kupon Diskon</li>');
            if (window.hasCalledFriend) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">📞</span> Tanya Teman</li>');
            if (window.isDoubleCoinActive) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">💰</span> Double Koin</li>');
            if (window.isTripleCoinActive) usedItems.push('<li class="flex items-center gap-2"><span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shadow-sm">🤑</span> Triple Koin</li>');

            const usedItemsContainer = document.getElementById('resultUsedItemsContainer');
            const usedItemsList = document.getElementById('resultUsedItemsList');
            
            if (usedItems.length > 0) {
                usedItemsList.innerHTML = usedItems.join('');
                usedItemsContainer.classList.remove('hidden');
            } else {
                usedItemsContainer.classList.add('hidden');
            }

            if (finalScore === 67) {
                normalView.classList.replace('flex', 'hidden'); 
                memeView.classList.replace('hidden', 'block');
                
                const vid = document.getElementById('meme67Video'); 
                if (vid) { 
                    vid.currentTime = 0; 
                    vid.muted = true; 
                    vid.play().then(() => { vid.muted = false; vid.volume = 0.6; }).catch(() => { vid.muted = true; vid.play(); }); 
                }
                emojiEl.innerText = '🔥';

                const btnMeme = document.getElementById('btnMemeClose');
                if (btnMeme) {
                    btnMeme.disabled = true;
                    btnMeme.className = 'w-full py-4 bg-gray-800 text-gray-500 font-bold rounded-2xl text-xs cursor-not-allowed transition-all relative z-10 uppercase tracking-widest';
                    
                    let memeCount = 5;
                    btnMeme.innerText = `Tunggu (${memeCount})...`;
                    
                    const memeInterval = setInterval(() => {
                        memeCount--;
                        if (memeCount > 0) {
                            btnMeme.innerText = `Tunggu (${memeCount})...`;
                        } else {
                            clearInterval(memeInterval);
                            btnMeme.disabled = false;
                            btnMeme.innerText = 'Tutup & Kembali';
                            btnMeme.className = 'w-full py-4 bg-gray-950 text-white font-bold rounded-2xl text-xs active:scale-95 cursor-pointer transition-all relative z-10 uppercase tracking-widest shadow-lg shadow-gray-900/50';
                        }
                    }, 1000);
                }

            } else {
                normalView.classList.replace('hidden', 'flex'); memeView.classList.replace('block', 'hidden'); scoreEl.innerText = finalScore; scoreEl.className = 'text-5xl font-black leading-none transition-all duration-700';
                if (finalScore >= 80) { emojiEl.innerText = '🏆'; titleEl.innerText = 'Luar Biasa!'; msgEl.innerText = 'Alhamdulillah, nilaimu sangat bagus! Jangan sombong ya.'; scoreEl.classList.add('text-green-600'); setTimeout(() => { confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } }); }, 300); } 
                else if (finalScore >= 60) { emojiEl.innerText = '👍'; titleEl.innerText = 'Kerja Bagus!'; msgEl.innerText = 'Nilaimu sudah cukup baik. Terus usahakan belajar lebih giat lagi!'; scoreEl.classList.add('text-blue-500'); } 
                else { emojiEl.innerText = '💪'; titleEl.innerText = 'Tetap Semangat!'; msgEl.innerText = 'Jangan sedih kalau nilainya masih kecil. Kegagalan adalah awal keberhasilan!'; scoreEl.classList.add('text-amber-500'); }
            }

            if (isPreview) { msgEl.innerText = "Simulasi Selesai. Data tidak tersimpan."; const btnHome = document.getElementById('btnReturnResult'); if (btnHome) { btnHome.innerText = "Kembali ke Editor"; btnHome.onclick = () => window.location.replace('/bank-soal'); } }
            if (!isPreview) {
                if (!completedWeeksForSubject.includes(parsedWeek)) completedWeeksForSubject.push(parsedWeek);
                if ([1, 2, 3, 4, 5].every(w => completedWeeksForSubject.includes(w)) && !localStorage.getItem(`exam_reminder_${studentId}_${subject}`)) { localStorage.setItem(`exam_reminder_${studentId}_${subject}`, 'true'); window.shouldShowExamReminder = true; }
            }

            localStorage.removeItem(timeKey); localStorage.removeItem(ansKey); localStorage.removeItem(qKey); localStorage.removeItem(psychKey);
            btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-check"></i> Selesai'; 
            btnSubmitGlobal.className = 'w-full py-5 bg-gray-800 text-white font-bold rounded-2xl transition-all text-lg shadow-sm mb-12 relative overflow-hidden';
            document.getElementById('modalResult').classList.replace('hidden', 'flex');
            
            // Lepas kunci karena udah selesai
            window.isSubmittingData = false;
            
        } catch (e) {
            console.error(e); 
            // Kalau gagal karena API nolak (misal gara-gara double submit), munculin pesan dari API
            const errMsg = e.message || 'Gagal mengirim data. Coba lagi.';
            window.showToast?.('danger', 'Error', errMsg); 
            
            // [FIX UX] Balikin tombol hijau kalau gagal ngirim biar bisa dicoba lagi
            btnSubmitGlobal.disabled = false;
            btnSubmitGlobal.className = 'w-full py-5 bg-green-600 text-white font-bold rounded-2xl shadow-sm mb-12 relative overflow-hidden active:scale-95 cursor-pointer transition-all text-lg';
            btnSubmitGlobal.innerHTML = 'Kirim Semua Jawaban'; 
            
            // Lepas kunci biar user bisa nyoba pencet lagi
            window.isSubmittingData = false;
        }
    };

    window.closeResultAndCheckReminder = () => {
        document.getElementById('modalResult').classList.replace('flex', 'hidden');
        
        if (isPRMode) {
            window.location.replace(`/leaderboard-pr?subject=${subject}&week=${week}&student_id=${studentId}`);
            return;
        }

        if (window.shouldShowExamReminder) {
            document.getElementById('modalExamReminder').classList.replace('hidden', 'flex'); 
            document.getElementById('examReminderSubject').innerText = subject; 
            if (navigator.vibrate) navigator.vibrate([100, 50, 100]); 
            setTimeout(() => { confetti({ particleCount: 150, spread: 80, origin: { y: 0.5 }, colors: ['#4f46e5', '#818cf8', '#ffffff'] }); }, 300);
        } else {
            window.location.replace('/consultations');
        }
    };

    init();
</script>

