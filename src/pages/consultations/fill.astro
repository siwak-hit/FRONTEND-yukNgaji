    };

    // ===== BULLY: alur emot iblis =====
    const bWait = (ms) => new Promise(r => setTimeout(r, ms));
    let bullyAttackerName = 'Seseorang';
    let bullyFadedEls = [];

    const _bullyVisibleBlock = () => document.querySelector('#questionsList .question-block:not(.hidden)') || document.querySelector('#questionsList .question-block');

    const fadeOutQuestionText = async () => {
        bullyFadedEls = [];
        const block = _bullyVisibleBlock();
        if (!block) return;
        const targets = [...block.querySelectorAll('p, label, .urutan-card, .word-btn, .blank-slot, img')];
        for (const el of targets) {
            el.style.transition = 'opacity 0.3s ease';
            el.style.opacity = '0';
            bullyFadedEls.push(el);
            await bWait(130);
        }
    };
    const fadeInQuestionText = async () => {
        for (const el of bullyFadedEls) { el.style.opacity = '1'; await bWait(70); }
        bullyFadedEls = [];
    };

    // =======================================================
    // [2.4] PAUSE/RESUME TIMER (dipakai saat anak lagi dibully)
    // Timer dihitung dari end-timestamp di localStorage. Saat di-pause,
    // hitungan mundur dibekukan; saat resume, end-time digeser maju sebanyak
    // durasi pause supaya sisa waktu tidak berkurang selama dibully.
    // =======================================================
    let isTimerPaused = false;
    let pauseStartedAt = 0;
    window.pauseTimerForBully = () => {
        if (isTimerPaused) return;
        isTimerPaused = true;
        pauseStartedAt = Date.now();
    };
    window.resumeTimerForBully = () => {
        if (!isTimerPaused) return;
        const pausedMs = Date.now() - pauseStartedAt;
        const end = parseInt(localStorage.getItem(timeKey));
        if (!isNaN(end)) localStorage.setItem(timeKey, end + pausedMs);
        isTimerPaused = false;
    };

    window.playBullyAnimation = async (attackerName) => {
        if (window.isBullyAnimationRunning) return;
        window.isBullyAnimationRunning = true;
        isBullyAnimationRunning = true;
        bullyAttackerName = attackerName || 'Seseorang';

        // [2.4] Bekukan timer selama anak dibully biar gak rugi waktu.
        window.pauseTimerForBully();

        const overlay = document.getElementById('bullyOverlay');
        const char = document.getElementById('bullyChar');
        const speechWrap = document.getElementById('bullySpeechWrap');
        const speech = document.getElementById('bullySpeech');
        const nameEl = document.getElementById('bullyName');
        const revealBtn = document.getElementById('bullyRevealBtn');
        const avatar = document.getElementById('bullyAvatar');
        const camFrame = document.getElementById('bullyCameraFrame');
        const photo = document.getElementById('bullyPhoto');

        // reset
        overlay.classList.remove('hidden');
        overlay.classList.add('pointer-events-none');
        overlay.style.transition = 'background-color 0.8s ease';
        overlay.style.backgroundColor = 'rgba(20,10,30,0)';
        char.style.transition = 'none';
        char.style.top = '0.75rem'; char.style.right = '0.75rem'; char.style.left = 'auto';
        char.style.transform = 'scale(0.55)'; char.style.opacity = '1';
        speechWrap.classList.add('opacity-0'); nameEl.classList.add('opacity-0');
        revealBtn.classList.add('hidden', 'opacity-0');
        revealBtn.classList.add('bully-blood-pulse');
        revealBtn.style.transform = '';
        window.bullySoulGiven = false;
        avatar.classList.remove('hidden'); camFrame.classList.add('hidden');
        photo.classList.add('hidden');

        // 1. Iblis muncul di pojok kanan atas
        await bWait(80);
        char.style.transition = 'transform 0.6s ease-out, top 1s cubic-bezier(0.22,1,0.36,1), left 1s cubic-bezier(0.22,1,0.36,1)';
        char.style.transform = 'scale(0.72)';
        speech.textContent = 'Hihihi... ada yang lagi serius ngerjain tugas nih 😈';
        speechWrap.classList.remove('opacity-0');
        await bWait(2000);

        // 2. Teks soal menghilang satu per satu
        speechWrap.classList.add('opacity-0');
        await fadeOutQuestionText();
        await bWait(300);

        // 3. Iblis bergerak ke tengah + layar meredup
        overlay.style.backgroundColor = 'rgba(20,10,30,0.55)';
        char.style.top = '50%'; char.style.left = '50%'; char.style.right = 'auto';
        char.style.transform = 'translate(-50%,-50%) scale(1)';
        await bWait(1100);
        speech.textContent = 'Soal & jawabanmu sudah aku sembunyikan semua! 😈';
        speechWrap.classList.remove('opacity-0');
        nameEl.textContent = bullyAttackerName;
        nameEl.classList.remove('opacity-0');
        await bWait(1800);

        // 4. Tombol tantangan
        speech.textContent = 'Mau soalmu balik? Serahkan dulu jiwamu padaku... kalau berani 😈';
        revealBtn.classList.remove('hidden');
        requestAnimationFrame(() => revealBtn.classList.remove('opacity-0'));
        overlay.classList.remove('pointer-events-none'); // izinkan klik tombol
    };

    // Animasi "penyerahan jiwa": emoji 👻 melayang dari tombol menuju si iblis, lalu iblis menyerapnya.
    const playSoulSurrender = () => {
        const btn = document.getElementById('bullyRevealBtn');
        const char = document.getElementById('bullyChar');
        if (!btn) return;
        const brect = btn.getBoundingClientRect();
        const soul = document.createElement('div');
        soul.textContent = '👻';
        soul.style.cssText = `position:fixed; left:${brect.left + brect.width / 2}px; top:${brect.top}px; transform:translate(-50%,-50%) scale(0.6); font-size:44px; z-index:1100; pointer-events:none; opacity:1; filter:drop-shadow(0 0 14px rgba(255,255,255,0.85)); transition: all 1.1s cubic-bezier(0.22,1,0.36,1);`;
        document.body.appendChild(soul);

        let tx = window.innerWidth / 2, ty = window.innerHeight / 2;
        if (char) { const c = char.getBoundingClientRect(); tx = c.left + c.width / 2; ty = c.top + c.height / 2; }

        requestAnimationFrame(() => {
            soul.style.left = `${tx}px`;
            soul.style.top = `${ty}px`;
            soul.style.transform = 'translate(-50%,-50%) scale(0.12) rotate(25deg)';
            soul.style.opacity = '0';
        });

        // Iblis menyerap jiwa: membesar sekejap lalu kembali.
        if (char) {
            const base = char.style.transform || 'translate(-50%,-50%) scale(1)';
            setTimeout(() => { char.style.transition = 'transform 0.18s ease-out'; char.style.transform = 'translate(-50%,-50%) scale(1.2)'; }, 850);
            setTimeout(() => { char.style.transform = base; }, 1150);
        }

        setTimeout(() => soul.remove(), 1300);
    };

    window.bullyRevealQuestions = async () => {
        if (window.bullySoulGiven) return;   // sekali klik saja
        window.bullySoulGiven = true;

        const speech = document.getElementById('bullySpeech');
        const revealBtn = document.getElementById('bullyRevealBtn');
        const avatar = document.getElementById('bullyAvatar');
        const camFrame = document.getElementById('bullyCameraFrame');
        const video = document.getElementById('bullyCameraStream');
        const photo = document.getElementById('bullyPhoto');
        const overlay = document.getElementById('bullyOverlay');

        overlay.classList.add('pointer-events-none');

        // Animasi penyerahan jiwa → tombol mengecil lalu hilang permanen.
        playSoulSurrender();
        revealBtn.classList.remove('bully-blood-pulse');
        revealBtn.style.transform = 'scale(0.5)';
        revealBtn.classList.add('opacity-0');
        setTimeout(() => revealBtn.classList.add('hidden'), 500);

        speech.textContent = 'JIWAMU... AKU TERIMA! 👻';
        await bWait(1200);
        speech.textContent = 'Hihihi... sekarang serahkan wajahmu 😈📸';

        // Buka kamera & potret wajah user
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
            video.srcObject = stream;
            avatar.classList.add('hidden'); camFrame.classList.remove('hidden');
            video.classList.remove('hidden'); photo.classList.add('hidden');
            await bWait(2600);
            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth || 320; canvas.height = video.videoHeight || 320;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            stream.getTracks().forEach(t => t.stop());
            video.classList.add('hidden');
            photo.src = canvas.toDataURL('image/jpeg', 0.8);
            photo.classList.remove('hidden');
        } catch (e) {
            console.warn('Kamera bully gagal:', e);
            avatar.classList.remove('hidden'); camFrame.classList.add('hidden');
        }

        speech.textContent = `Hihihi... sekarang jiwamu akan menjadi milikku, ${currentStudentName}! 👻`;
        await bWait(2400);
        speech.textContent = `Tenang... aku cuma utusan temanmu yang bernama ${bullyAttackerName}. Wleee 😝`;
        await bWait(2800);

        await bullyEndAnimation();
    };

    const bullyEndAnimation = async () => {
        const overlay = document.getElementById('bullyOverlay');
        const char = document.getElementById('bullyChar');
        const speech = document.getElementById('bullySpeech');
        const avatar = document.getElementById('bullyAvatar');
        const camFrame = document.getElementById('bullyCameraFrame');
        const photo = document.getElementById('bullyPhoto');

        speech.textContent = 'Yaudah, soalnya aku balikin. Lanjut belajar ya! 😤';
        await bWait(1400);
        await fadeInQuestionText();
        // iblis melesat ke atas + layar terang lagi
        char.style.transition = 'transform 0.8s ease-in, opacity 0.8s ease-in';
        char.style.transform = 'translate(-50%,-160%) scale(0.4)';
        char.style.opacity = '0';
        overlay.style.backgroundColor = 'rgba(20,10,30,0)';
        await bWait(850);
        overlay.classList.add('hidden');
        avatar.classList.remove('hidden'); camFrame.classList.add('hidden'); photo.classList.add('hidden');
        char.style.opacity = '1';
        isBullyAnimationRunning = false;
        window.isBullyAnimationRunning = false;

        // [2.4] Bully selesai → lanjutkan timer (sisa waktu tetap utuh).
        window.resumeTimerForBully();
    };

    window.triggerCallFriend = async () => {
        if (window.hasCalledFriend) return;
        window.hasCalledFriend = true;

        let friendName = "Robot Teman";
        let friendAnswerRaw = "B";
        let targetQuestionId = null;

        try {
            const currentQuestionIds = questions.map(q => q.id);

            if (!isPreview) {
                let peersAnswers = [];
                try {
                    const res = await fetch(`${API_URL}/api/onboarding/peer-help?subject=${subject}&week=${week}&student_id=${studentId}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (res.ok) {
                        const result = await res.json();
                        peersAnswers = result.data || [];
                    }
                } catch (apiErr) {
                    console.warn("API Bantuan Teman belum merespon. Menggunakan Fallback.");
                }

                const matchingAnswers = peersAnswers.filter(pa => currentQuestionIds.includes(pa.question_id));

                if (matchingAnswers.length > 0) {
                    const pick = matchingAnswers[Math.floor(Math.random() * matchingAnswers.length)];
                    friendName = pick.student_name;
                    friendAnswerRaw = pick.answer;
                    targetQuestionId = pick.question_id;
                } else {
                    friendName = "Robot Teman";
                    targetQuestionId = currentQuestionIds[Math.floor(Math.random() * currentQuestionIds.length)];
                    friendAnswerRaw = "B";
                }
            } else {
                const dummyNames = ["Budi", "Aisyah", "Andi", "Reza"];
                friendName = dummyNames[Math.floor(Math.random() * dummyNames.length)];
                targetQuestionId = currentQuestionIds[0];
                friendAnswerRaw = "A";
            }

            if (!targetQuestionId) targetQuestionId = currentQuestionIds[0];

            const targetQObj = questions.find(q => q.id === targetQuestionId);
            const qIndexUI = questions.indexOf(targetQObj) + 1;
            const qType = targetQObj ? (targetQObj.type || 'pilgan') : 'pilgan';

            // Format Pesan
            let finalMsg = "";
            if (qType === 'pilgan') {
                const labelAns = (targetQObj && targetQObj.options) ? (targetQObj.options[friendAnswerRaw] || friendAnswerRaw) : friendAnswerRaw;
                finalMsg = `Kalo aku nomor ${qIndexUI} diisi sama jawaban "${labelAns}"!`;
            } else if (qType === 'tf') {
                const tfText = friendAnswerRaw === 'A' ? 'BENAR' : 'SALAH';
                finalMsg = `Pstt! Nomor ${qIndexUI} diisi ${tfText} aja!`;
            } else if (qType === 'drag') {
                const parts = friendAnswerRaw.split(',').map(k => (targetQObj && targetQObj.options) ? (targetQObj.options[k] || k) : k);
                finalMsg = `Nomor ${qIndexUI} urutannya: [ ${parts.join(', ')} ]`;
            } else {
                finalMsg = `Aku nomor ${qIndexUI} jawabannya ${friendAnswerRaw} deh kayaknya.`;
            }

            document.getElementById('cfName').innerText = friendName;
            document.getElementById('cfMessage').innerText = finalMsg;
            document.getElementById('cfAvatar').innerText = friendName.substring(0, 1).toUpperCase();

            const overlay = document.getElementById('callFriendOverlay');
            overlay.classList.remove('translate-x-full');

            setTimeout(() => {
                overlay.classList.add('translate-x-full');
            }, 7000);

        } catch (e) {
            console.error("Gagal menjalankan animasi teman:", e);
        }
    };

    // ==========================================
    // 3. INIT & FETCH DATA
    // ==========================================
    const init = async () => {
        try {
            try {
                const sysRes = await fetch(`${API_URL}/api/onboarding/system/status`);
                if (sysRes.ok) {
                    const sysData = await sysRes.json();
                    if (sysData.data && sysData.data.is_maintenance && !isPreview) {
                        window.location.replace('/maintenance');
                        return;
                    }
                }
            } catch (err) {
                console.warn("Lewati cek maintenance (API belum siap/error)");
            }

            setupKuesionerSosial();
            let allQuestions = [];

            const qListContainer = document.getElementById('questionsList');
            if (qListContainer) {
                qListContainer.innerHTML = `
                    <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center">
                        <i class="fa-solid fa-spinner fa-spin text-5xl text-green-500 mb-4"></i>
                        <h3 class="font-black text-gray-800 text-lg mb-1">Tunggu Sebentar...</h3>
                        <p class="text-xs text-gray-400 font-bold">Mempersiapkan soal dari Kak Aziz!</p>
                    </div>
                `;
            }
            if (btnSubmitGlobal) {
                btnSubmitGlobal.disabled = true;
                btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyiapkan Ujian...';
            }

            if (isPreview) {
                localStorage.removeItem(timeKey); localStorage.removeItem(ansKey);
                localStorage.removeItem(qKey); localStorage.removeItem(psychKey);

                document.getElementById('previewBanner').classList.remove('hidden');
                document.getElementById('simBullyToggle').classList.remove('hidden');
                document.getElementById('headerName').innerText = "Mode Simulasi";
                document.getElementById('headerInitials').innerText = "PR";
                document.getElementById('startDescText').innerText = "Mode Simulasi. Kamu bisa ngetes Shop & Hitung Mundur.";
                studentWallet = 1000;

                const qRes = await fetch(`${API_URL}/api/onboarding/questions/${subject}`, { headers: { 'Authorization': `Bearer ${token}` }});
                const qData = await qRes.json();
                allQuestions = Array.isArray(qData.data) ? qData.data : (qData.data[week] || []);
            } else {
                const menit = Math.floor(timeLeft / 60);
                const detik = timeLeft % 60;
                const teksWaktu = detik > 0 ? `${menit} menit ${detik} detik` : `${menit} menit`;
                document.getElementById('startDescText').innerHTML = `Pastikan fokus. Kamu punya waktu <b style="color: var(--accent-strong);">${teksWaktu}</b> untuk mengerjakan soal.`;

                // [OPTIMASI] Gunakan fetchWithTimeout biar gak loading muter terus kalau sinyal jelek
                const [stdRes, consRes, qRes] = await Promise.all([
                    fetchWithTimeout(`${API_URL}/api/students/${studentId}`, { headers: { 'Authorization': `Bearer ${token}` }}),
                    fetchWithTimeout(`${API_URL}/api/students/${studentId}/consultations`, { headers: { 'Authorization': `Bearer ${token}` }}),
                    fetchWithTimeout(`${API_URL}/api/onboarding/questions/${subject}?week=${week}&student_id=${studentId}`, { headers: { 'Authorization': `Bearer ${token}` }})
                ]);

                const student = await stdRes.json();
                const consData = await consRes.json();
                const qData = await qRes.json();

                if (!student || !student.data) {
                    window.showToast?.('danger', 'Akses Ditolak', 'Sesi telah berakhir atau Anda tidak memiliki akses ke ujian ini.');
                    setTimeout(() => window.location.replace('/'), 2000);
                    return;
                }

                currentStudentName = student.data.name?.split(' ')[0] || "Anak Baik";
                if (consData.data) {
                    completedWeeksForSubject = consData.data.filter(c => c.subject === subject).map(c => parseInt(c.week));
                }

                if (!isPreview && completedWeeksForSubject.includes(parsedWeek)) {
                    document.getElementById('startTitleText').innerText = "Sudah Selesai!";
                    document.getElementById('startDescText').innerText = "Kamu sudah pernah menyelesaikan ujian ini. Mengalihkan ke halaman hasil...";

                    const btnStartLobby = document.getElementById('btnStart');
                    if (btnStartLobby) {
                        btnStartLobby.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengalihkan...';
                        btnStartLobby.disabled = true;
                    }

                    window.showToast?.('info', 'Ujian Selesai', 'Kamu sudah pernah mengerjakan ujian ini.');

                    setTimeout(() => {
                        if (isPRMode) {
                            window.location.replace(`/leaderboard-pr?subject=${subject}&week=${week}&student_id=${studentId}`);
                        } else {
                            window.location.replace('/consultations');
                        }
                    }, 2000);
                    return; // HENTIKAN EKSEKUSI init() agar ujian tidak terbuka!
                }

                document.getElementById('headerName').innerText = student.data.name;
                document.getElementById('headerInitials').innerText = student.data.name?.substring(0,2).toUpperCase() || 'S';
                allQuestions = qData.data || [];

                if (student.data) {
                    studentWallet = Number(student.data.poin) || 0;
                    studentInventory = {
                        item_double_score: student.data.item_double_score || 0,
                        item_serang: student.data.item_serang || 0,
                        item_perisai: student.data.item_perisai || 0,
                        item_extra_life: student.data.item_extra_life || 0,
                        item_double_coin: student.data.item_double_coin || 0,
                        item_triple_coin: student.data.item_triple_coin || 0,
                        item_bullying: student.data.item_bullying || 0,
                        item_diskon: student.data.item_diskon || 0,
                        item_call_friend: student.data.item_call_friend || 0
                    };
                    window.isShieldActive = student.data.is_shield_active || false;
                    if (student.data.has_claimed_bonus) hasClaimedBonusGlobal = true;
                }
            }

            // [Gap 1: ganti device] Kalau di HP/browser ini belum ada checkpoint lokal,
            // ambil dari server lalu tanam ke localStorage. Setelah ini alur normal di bawah
            // (baca qKey/ansKey/idxKey/timeKey) otomatis melanjutkan dari checkpoint terakhir.
            if (!isPreview) {
                const hasLocal = localStorage.getItem(qKey) || localStorage.getItem(ansKey) || localStorage.getItem(timeKey);
                if (!hasLocal) {
                    try {
                        const dRes = await fetchWithTimeout(`${API_URL}/api/onboarding/pr-draft?student_id=${studentId}&subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` }});
                        if (dRes.ok) {
                            const draft = (await dRes.json()).data;
                            if (draft && Array.isArray(draft.question_ids) && draft.question_ids.length) {
                                localStorage.setItem(qKey, JSON.stringify(draft.question_ids));
                                if (draft.answers) localStorage.setItem(ansKey, JSON.stringify(draft.answers));
                                if (draft.current_index != null) localStorage.setItem(idxKey, String(draft.current_index));
                                if (draft.session_end) localStorage.setItem(timeKey, String(new Date(draft.session_end).getTime()));
                                window.showToast?.('info', 'Melanjutkan Tugas', 'Progres dari perangkat sebelumnya berhasil dimuat. Lanjut ya!');
                            }
                        }
                    } catch(e) { console.log('Gagal ambil checkpoint server', e); }
                }
            }

            const targetDisplay = 6;
            if (isPreview) {
                questions = shuffleArray(allQuestions).slice(0, Math.min(targetDisplay, allQuestions.length));
            } else {
                let savedQsIds = JSON.parse(localStorage.getItem(qKey)) || [];
                // [FIX INDIKATOR] Cap ke targetDisplay (6) walau data lama menyimpan SEMUA (n) soal,
                // supaya indikator/jumlah soal mengarah ke 6, bukan ke n.
                questions = savedQsIds.map(id => allQuestions.find(q => q.id === id)).filter(Boolean).slice(0, targetDisplay);
                if (questions.length === 0 && allQuestions.length > 0) {
                    questions = shuffleArray(allQuestions).slice(0, Math.min(targetDisplay, allQuestions.length));
                }
                // Selalu sinkronkan storage dengan set 6 soal yang benar-benar dipakai.
                if (questions.length > 0 && savedQsIds.length !== questions.length) {
                    localStorage.setItem(qKey, JSON.stringify(questions.map(q => q.id)));
                }
            }

            updateTimerUI();

            // [OPTIMASI] AWAIT KUCING DIHAPUS DARI SINI! Pindah ke startTest agar loading awal secepat kilat.

            renderQuestions();
            restoreDraftAnswers();
            checkExistingSession();
            updateShopUI();
            if (!isPreview) checkRealNotifications();

            validate();

            const btnStartLobby = document.getElementById('btnStart');
            if (btnStartLobby) {
                btnStartLobby.disabled = false;
                btnStartLobby.innerHTML = 'Mulai Sekarang <i class="fa-solid fa-rocket ml-1"></i>';
                btnStartLobby.className = 'w-full max-w-xs py-4 bg-green-600 hover:bg-green-700 text-white font-bold rounded-2xl shadow-lg shadow-green-600/30 active:scale-95 transition-all text-lg flex items-center justify-center gap-2';
            }

            isAppReady = true;

            // [ANTI-MALAS] Tampilkan countdown deadline PR di start overlay agar siswa tahu sisa waktu
            if (isPRMode) {
                try {
                    const dRes = await fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` }});
                    const dJson = await dRes.json();
                    const dData = Array.isArray(dJson.data) ? dJson.data[0] : dJson.data;
                    if (dData && dData.deadline_at) {
                        const now = new Date();
                        const banner = document.getElementById('prDeadlineBanner');
                        const deadlineText = document.getElementById('prDeadlineText');
                        const pad = n => String(n).padStart(2,'0');
                        const fmtTime = d => `${pad(d.getHours())}:${pad(d.getMinutes())}`;

                        // Cek dispensasi murid ini (telat tapi dikasih izin sampai jam tertentu)
                        let extendedList = dData.extended_students;
                        try { while (typeof extendedList === 'string') extendedList = JSON.parse(extendedList); } catch(e) {}
                        if (!Array.isArray(extendedList)) extendedList = [];
                        const extRecord = extendedList.find(ext => ext.student_id === studentId) || null;
                        const dispUntil = extRecord ? new Date(extRecord.until) : null;

                        if (banner && deadlineText) {
                            if (dispUntil && dispUntil > now) {
                                // Telat deadline, tapi diberi izin mengerjakan sampai jam X
                                deadlineText.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Kamu telat, tapi diberi izin mengerjakan sampai <b>${fmtTime(dispUntil)}</b>.`;
                                banner.style.backgroundColor = 'var(--accent-soft)';
                                banner.style.color = 'var(--accent-strong)';
                            } else {
                                const deadline = new Date(dData.deadline_at);
                                const diffMs = deadline - now;
                                if (diffMs > 0) {
                                    deadlineText.innerHTML = `<i class="fa-solid fa-clock mr-1"></i> Kerjakan sebelum <b>${fmtTime(deadline)}</b> hari ini.`;
                                    banner.style.backgroundColor = 'var(--warning-soft)';
                                    banner.style.color = 'var(--warning)';
                                } else {
                                    deadlineText.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> Deadline sudah lewat (${fmtTime(deadline)}).`;
                                    banner.style.backgroundColor = 'var(--danger-soft, #fee2e2)';
                                    banner.style.color = 'var(--danger, #ef4444)';
                                }
                            }
                            banner.classList.remove('hidden');
                        }
                    }
                } catch(e) {}
            }

        } catch (e) {
            console.error(e);
            // [OPTIMASI] Deteksi error Timeout AbortError
            const errMsg = e.name === 'AbortError' ? 'Sinyal lambat. Silakan muat ulang halaman.' : 'Gagal memuat Tugas.';
            window.showToast?.('danger', 'Error', errMsg);

            const btnStartLobby = document.getElementById('btnStart');
            if (btnStartLobby) {
                btnStartLobby.innerHTML = `<i class="fa-solid fa-rotate-right"></i> ${e.name === 'AbortError' ? 'Coba Lagi' : 'Gagal Memuat'}`;
                btnStartLobby.classList.replace('text-gray-400', 'text-red-500');
                btnStartLobby.classList.replace('bg-gray-200', 'bg-red-100');
                btnStartLobby.disabled = false;
                btnStartLobby.onclick = () => window.location.reload();
            }
        }
    };

    // ==========================================
    // 4. SOAL & RENDER HTML
    // ==========================================
    const setupKuesionerSosial = () => {
        const qBank = {
            akhlak: [
                { q: "Pas Kak Aziz lagi nerangin, apa yang kamu lakuin tadi?", opts: [{t: "Merhatiin Kok!", s: 100}, {t: "gak terlalu ( Bosen soalnya )", s: 50}, {t: "gak tau ah!", s: 0}] },
                { q: "Jujur, kadang kamu suka lupa salim ke guru gak pas datang?", opts: [{t: "Selalu salim ke semua nya", s: 100}, {t: "Ke pa Idris doang", s: 50}, {t: "Sering lupa", s: 0}] },
                { q: "Kalau kamu ditegur guru karena salah, perasaan kamu gimana?", opts: [{t: "Biasa aja", s: 100}, {t: "Agak bete", s: 50}, {t: "curhat ke temen pas udah pulang ngaji", s: 0}] }
            ],
            disiplin: [
                { q: "Misalkan kak Aziz nyuruh sesuatu, Apa yang kamu lakukan?", opts: [{t: "Gak mau ah", s: 0}, {t: "Mau, tapi...", s: 50}, {t: "Mau", s: 100}] },
                { q: "Habis ngaji, kamu langsung pulang atau bantu beresin meja?", opts: [{t: "Bantuin beresin", s: 100}, {t: "biasanya sih langsung pulang", s: 0}] },
                { q: "Kalau ada PR ngaji tapi kamu belum ngerjain, itu salah siapa?", opts: [{t: "Salahku sendiri", s: 100}, {t: "Salah temen gak ngingetin", s: 0}, {t:"salah kak Aziz bikin tugas susah banget", s:0}] }
            ],
            aktif: [
                { q: "Pas guru nanya ke kelas, kamu biasanya ngapain?", opts: [{t: "Langsung jawab dong!", s: 100}, {t: "Mau jawab tapi malu", s: 50}, {t: "Diem aja nunggu temen yang jawab", s: 0}] },
                { q: "Kalau ada temen yang sering nanya ke guru, menurutmu dia...", opts: [{t: "Hebat dan pintar", s: 100}, {t: "Caper banget", s: 0}, {t: "HEBAT BANGET!!! KEREN!", s: 20}] },
                { q: "Apa yang bikin kamu kadang gak mau nanya pelajaran?", opts: [{t: "Aku suka nanya kok", s: 100}, {t: "Takut salah / diketawain", s: 50}, {t: "Gak tau apa yang mau ditanya", s: 0}] }
            ]
        };

        let selectedQ = JSON.parse(localStorage.getItem(psychKey)) || [];
        if (selectedQ.length !== 3) {
            selectedQ = [ { cat: 'akhlak', ...shuffleArray(qBank.akhlak)[0] }, { cat: 'disiplin', ...shuffleArray(qBank.disiplin)[0] }, { cat: 'aktif', ...shuffleArray(qBank.aktif)[0] } ];
            selectedQ = selectedQ.map(q => ({ ...q, opts: shuffleArray(q.opts) }));
            localStorage.setItem(psychKey, JSON.stringify(selectedQ));
        }

        const container = document.getElementById('kuesionerContainer');
        if(container) {
            container.innerHTML = selectedQ.map((item, index) => `
                <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100 shadow-sm">
                    <p class="text-sm font-bold text-gray-800 mb-3">${index + 1}. ${item.q}</p>
                    <div class="space-y-2">
                        ${item.opts.map((opt) => `
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border border-gray-100 cursor-pointer hover:bg-gray-50 active:scale-95 transition-all">
                                <input type="radio" name="q_${item.cat}" value="${opt.s}" class="w-4 h-4 text-blue-600 focus:ring-blue-500" required>
                                <span class="text-xs font-semibold text-gray-700">${opt.t}</span>
                            </label>
                        `).join('')}
                    </div>
                </div>
            `).join('');
        }
    };

    // [BARU] Fungsi Fetch dengan batas waktu (Timeout) 15 detik
    const fetchWithTimeout = async (resource, options = {}) => {
        const { timeout = 15000 } = options;
        const controller = new AbortController();
        const id = setTimeout(() => controller.abort(), timeout);
        const response = await fetch(resource, { ...options, signal: controller.signal });
        clearTimeout(id);
        return response;
    };

    // Bungkus tiap "run" huruf Arab dengan <span class="ar-text"> agar bisa diperbesar via CSS
    // tanpa ikut memperbesar teks latin di sekitarnya (huruf Arab terlihat lebih kecil di ukuran sama).
    const wrapArabic = (text) => {
        if (text == null) return text;
        const str = String(text);
        return str.replace(
            /\p{Script=Arabic}(?:[\p{Script=Arabic}ـ،؛؟\s]*\p{Script=Arabic})?/gu,
            (m) => `<span class="ar-text">${m}</span>`
        );
    };

    const generateMediaHtml = (q) => {
        if (!q.image_url) return '';
        return `
            <div class="relative rounded-2xl overflow-hidden border border-gray-100 shadow-sm bg-gray-100 flex items-center justify-center min-h-[80px]">
                <div class="img-skeleton absolute inset-0 bg-gray-100 animate-pulse flex items-center justify-center"><i class="fa-solid fa-image text-gray-300 text-2xl"></i></div>
                <img loading="lazy" src="${q.image_url.trim()}" class="relative w-full h-auto max-h-56 object-contain mx-auto opacity-0 transition-opacity duration-300" alt="Visual Soal" onload="this.classList.replace('opacity-0','opacity-100');this.previousElementSibling.style.display='none';" onerror="this.closest('.relative').style.display='none'">
            </div>`;
    };

    const renderPilganQuestion = (q, idx) => {
        const shuffledOptions = shuffleArray(Object.entries(q.options));
        return `<div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-4 question-block" data-id="${q.id}" data-type="pilgan"><p class="text-sm font-bold text-gray-800 leading-relaxed">${idx+1}. ${wrapArabic(q.question)}</p>${generateMediaHtml(q)}<div class="grid grid-cols-1 gap-2">${shuffledOptions.map(([key, val]) => `<label class="flex items-center gap-3 p-3 rounded-xl border border-gray-50 bg-gray-50 active:bg-green-50 transition-colors cursor-pointer has-[:checked]:bg-green-50 has-[:checked]:border-green-300"><input type="radio" name="q-${q.id}" value="${key}" class="w-4 h-4 text-green-600 focus:ring-0"><span class="text-xs text-gray-600 font-medium">${wrapArabic(val)}</span></label>`).join('')}</div></div>`;
    };

    const renderTrueFalseQuestion = (q, idx) => `<div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-4 question-block" data-id="${q.id}" data-type="tf"><p class="text-sm font-bold text-gray-800 leading-relaxed text-center mb-2">${idx+1}. ${wrapArabic(q.question)}</p>${generateMediaHtml(q)}<div class="grid grid-cols-2 gap-3"><label class="flex flex-col items-center justify-center p-4 rounded-2xl border-2 border-gray-100 cursor-pointer has-[:checked]:bg-green-50 has-[:checked]:border-green-400 transition-all hover:bg-gray-50"><input type="radio" name="q-${q.id}" value="A" class="hidden"><i class="fa-solid fa-check text-4xl text-green-500 mb-2 drop-shadow-sm"></i><span class="font-black text-gray-700 tracking-widest uppercase">BENAR</span></label><label class="flex flex-col items-center justify-center p-4 rounded-2xl border-2 border-gray-100 cursor-pointer has-[:checked]:bg-red-50 has-[:checked]:border-red-400 transition-all hover:bg-gray-50"><input type="radio" name="q-${q.id}" value="B" class="hidden"><i class="fa-solid fa-xmark text-4xl text-red-500 mb-2 drop-shadow-sm"></i><span class="font-black text-gray-700 tracking-widest uppercase">SALAH</span></label></div></div>`;

    const renderDragDropQuestion = (q, idx) => {
        let blankIdx = 0;
        const qHtml = wrapArabic(q.question || '').replace(/\[BLANK\]/g, () => `<span class="blank-slot inline-block min-w-[70px] h-8 border-b-2 border-dashed border-indigo-400 bg-indigo-50 mx-1 text-center font-black text-indigo-700 align-middle cursor-pointer text-xs leading-8 shadow-inner px-2 rounded-t-lg transition-colors hover:bg-indigo-100" data-q="${q.id}" data-index="${blankIdx++}" onclick="removeBlank(this)"></span>`);
        const opts = shuffleArray(Object.entries(q.options));
        return `<div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-4 question-block" data-id="${q.id}" data-type="drag"><div class="flex gap-2"><span class="text-sm font-bold text-gray-800 shrink-0">${idx+1}.</span><p class="text-sm font-bold text-gray-800 leading-relaxed">${qHtml}</p></div>${generateMediaHtml(q)}<div class="mt-4 p-4 bg-indigo-50/50 rounded-2xl border border-indigo-100 shadow-inner"><p class="text-[10px] font-bold text-indigo-400 mb-3 uppercase tracking-widest flex items-center gap-1.5"><i class="fa-solid fa-hand-pointer"></i> Ketuk kata di bawah:</p><div class="flex flex-wrap gap-2">${opts.map(([k, v]) => `<button type="button" class="word-btn px-4 py-2.5 bg-white border border-indigo-200 text-indigo-700 text-xs font-black rounded-xl shadow-sm hover:bg-indigo-50 active:scale-95 transition-all" data-key="${k}" onclick="fillBlank('${q.id}', this)">${wrapArabic(v)}</button>`).join('')}</div></div><input type="hidden" name="q-${q.id}" id="ans-${q.id}" value=""></div>`;
    };

    // Renumber badge posisi (1,2,3,…) sesuai urutan kartu saat ini.
    const renumberUrutan = (list) => {
        if (!list) return;
        Array.from(list.children).forEach((li, i) => {
            const pos = li.querySelector('.urutan-pos');
            if (pos) pos.innerText = i + 1;
        });
    };

    const renderUrutanQuestion = (q, idx) => {
        const arr = Array.isArray(q.options) ? [...q.options] : Object.values(q.options);
        const shuffled = shuffleArray(arr.map((text, i) => ({ text, num: i + 1 })));
        const esc = (t) => String(t).replace(/"/g, '&quot;');
        // [UX] Tampilkan TEKS opsinya (bukan cuma angka) supaya siswa tahu apa yang sedang diurutkan.
        // Pakai class Tailwind (global) — bukan CSS scoped — karena kartu ini di-render lewat innerHTML.
        const cards = shuffled.map((item) => `<div class="urutan-card flex items-center gap-3 bg-white border-2 border-gray-200 rounded-2xl px-3.5 py-3 shadow-sm cursor-grab select-none active:cursor-grabbing hover:border-teal-300 transition-colors" data-val="${esc(item.text)}" style="touch-action:none;"><span class="urutan-pos w-7 h-7 shrink-0 bg-teal-500 text-white rounded-full flex items-center justify-center font-black text-[11px] shadow-sm"></span><span class="flex-1 text-[13px] font-bold text-gray-800 leading-snug">${wrapArabic(item.text)}</span><i class="fa-solid fa-grip-vertical text-gray-300 text-base shrink-0"></i></div>`).join('');

        // [FIX] Ubah value='...' menjadi value="..." agar kutip satu (') pada teks soal tidak merusak format JSON HTML
        return `<div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-4 question-block" data-id="${q.id}" data-type="urutan"><div class="flex justify-between items-start gap-4"><p class="text-sm font-bold text-gray-800 leading-relaxed flex-1">${idx+1}. ${q.question}</p><span class="px-2 py-1 bg-teal-50 text-teal-600 text-[9px] font-black rounded-lg border border-teal-100 uppercase tracking-tighter shrink-0">Puzzle</span></div>${generateMediaHtml(q)}<div class="flex items-center gap-2 bg-teal-50 border border-teal-100 rounded-xl px-3 py-2 text-[11px] font-bold text-teal-700"><i class="fa-solid fa-arrow-down-up-across-line"></i><span>Seret kartu untuk mengurutkan dari <strong>atas (1)</strong> ke bawah.</span></div><div class="sortable-list flex flex-col gap-2.5 w-full" id="sortable-${q.id}">${cards}</div><input type="hidden" name="q-${q.id}" id="ans-${q.id}" value="${JSON.stringify(shuffled.map(s => s.text)).replace(/"/g, '&quot;')}"></div>`;
    };

    const renderQuestions = () => {
        const container = document.getElementById('questionsList');
        if (questions.length === 0) {
            container.innerHTML = '<p class="text-xs text-gray-400 italic bg-gray-50 p-4 rounded-xl text-center border border-gray-100">Belum ada soal untuk pertemuan ini.</p>';
            document.getElementById('btnEarlyFinish').classList.add('hidden');
            return;
        }
        container.innerHTML = questions.map((q, idx) => {
            if (q.type === 'drag') return renderDragDropQuestion(q, idx);
            if (q.type === 'tf') return renderTrueFalseQuestion(q, idx);
            if (q.type === 'urutan') return renderUrutanQuestion(q, idx);
            return renderPilganQuestion(q, idx);
        }).join('');

        if (typeof Sortable !== 'undefined') {
            document.querySelectorAll('.sortable-list').forEach(list => {
                const qId = list.closest('.question-block').dataset.id;
                new Sortable(list, {
                    animation: 350, delay: 150, delayOnTouchOnly: true, ghostClass: 'sortable-ghost', dragClass: 'sortable-drag',
                    onEnd: () => {
                        isDirty = true;
                        document.getElementById(`ans-${qId}`).value = JSON.stringify(Array.from(list.children).map(li => li.dataset.val));
                        renumberUrutan(list);
                        executeAutoSave();
                    }
                });
                renumberUrutan(list);
            });
        }

        setupAcademicPagination();
    };

    // ===== Pagination Akademik (1 soal per layar + navigasi) =====
    let acadIndex = 0;
    let academicLocked = false;
    let academicLockReason = null; // 'manual' | 'timeup' | null

    const _acadSlides = () => Array.from(document.getElementById('questionsList').children).filter(c => c.classList.contains('question-block'));

    const setupAcademicPagination = () => {
        const slides = _acadSlides();
        slides.forEach(b => b.classList.add('q-slide'));
        // [checkpoint] Lanjut dari soal terakhir (mis. nomor 5), bukan ulang dari awal.
        const savedIdx = parseInt(localStorage.getItem(idxKey));
        acadIndex = (!isNaN(savedIdx) && savedIdx >= 0 && savedIdx < slides.length) ? savedIdx : 0;
        renderAcadView();
    };

    // [checkpoint] Simpan posisi soal terakhir tiap pindah soal.
    const persistAcadIndex = () => { try { localStorage.setItem(idxKey, String(acadIndex)); } catch (e) {} window.syncDraftToServer?.(); };

    const renderAcadView = () => {
        const slides = _acadSlides();
        if (acadIndex >= slides.length) acadIndex = Math.max(0, slides.length - 1);
        if (!academicLocked) slides.forEach((b, i) => b.classList.toggle('hidden', i !== acadIndex));
        const counter = document.getElementById('acadCounter');
        if (counter) counter.textContent = `Soal ${slides.length ? acadIndex + 1 : 0}/${slides.length}`;

        const isLastQ = slides.length > 0 && acadIndex === slides.length - 1;
        const earlyFinishBtn = document.getElementById('btnEarlyFinish');
        // Tombol "Kumpulkan" hanya muncul di soal terakhir
        if (earlyFinishBtn && !academicLocked) {
            if (isLastQ) earlyFinishBtn.classList.remove('hidden');
            else earlyFinishBtn.classList.add('hidden');
        }

        const nav = document.getElementById('academicNav');
        if (!nav) return;
        if (slides.length <= 1) { nav.innerHTML = ''; return; }
        const opts = slides.map((b, i) => `<option value="${i}" ${i === acadIndex ? 'selected' : ''}>Soal ${i + 1}</option>`).join('');

        if (isLastQ) {
            // Soal terakhir: prev/next cukup ikon chevron
            nav.innerHTML = `
                <button onclick="acadPrev()" class="btn-icon" ${acadIndex === 0 ? 'disabled' : ''} aria-label="Sebelumnya"><i class="fa-solid fa-chevron-left"></i></button>
                <select onchange="acadGoto(this.value)" class="field !py-2 !px-3 !w-auto text-sm font-medium">${opts}</select>
                <button onclick="acadNext()" class="btn-icon" disabled aria-label="Berikutnya"><i class="fa-solid fa-chevron-right"></i></button>`;
        } else {
            // Soal non-terakhir: prev/next dengan teks
            nav.innerHTML = `
                <button onclick="acadPrev()" class="btn btn-soft flex items-center gap-1.5 !py-2 !px-3 text-xs" ${acadIndex === 0 ? 'disabled' : ''} aria-label="Sebelumnya"><i class="fa-solid fa-chevron-left"></i><span>Sebelumnya</span></button>
                <select onchange="acadGoto(this.value)" class="field !py-2 !px-3 !w-auto text-sm font-medium">${opts}</select>
                <button onclick="acadNext()" class="btn btn-primary flex items-center gap-1.5 !py-2 !px-3 text-xs" aria-label="Selanjutnya"><span>Selanjutnya</span><i class="fa-solid fa-chevron-right"></i></button>`;
        }
    };

    window.acadGoto = (i) => { if (academicLocked) return; acadIndex = parseInt(i) || 0; renderAcadView(); persistAcadIndex(); };
    window.acadPrev = () => { if (acadIndex > 0) { acadIndex--; renderAcadView(); persistAcadIndex(); } };
    window.acadNext = () => { const n = _acadSlides().length; if (acadIndex < n - 1) { acadIndex++; renderAcadView(); persistAcadIndex(); } };

    window.toggleAcademicAccordion = () => {
        const body = document.getElementById('academicBody');
        const icon = document.getElementById('academicAccordionIcon');
        const collapsed = body.classList.toggle('hidden');
        if (icon) icon.style.transform = collapsed ? '' : 'rotate(180deg)';
    };

    window.fillBlank = (qId, btn) => {
        isDirty = true; const block = document.querySelector(`.question-block[data-id="${qId}"]`);
        const emptySlot = block.querySelector('.blank-slot:empty');
        if (emptySlot) { emptySlot.innerText = btn.innerText; emptySlot.dataset.key = btn.dataset.key; btn.classList.add('hidden'); updateDragAnswer(qId, block); }
    };
    window.removeBlank = (slot) => {
        isDirty = true; if (!slot.innerText) return;
        const qId = slot.dataset.q; const block = document.querySelector(`.question-block[data-id="${qId}"]`);
        const btn = block.querySelector(`.word-btn[data-key="${slot.dataset.key}"]`); if (btn) btn.classList.remove('hidden');
        slot.innerText = ''; delete slot.dataset.key; updateDragAnswer(qId, block);
    };
    const updateDragAnswer = (qId, block) => {
        document.getElementById(`ans-${qId}`).value = Array.from(block.querySelectorAll('.blank-slot')).map(s => s.dataset.key || '').join(',');
        executeAutoSave();
    };

    // ==========================================
    // 5. VALIDATION & AUTO-SAVE
    // ==========================================
    const validate = () => {
        const totalQs = questions.length + 3; let answered = 0;
        document.querySelectorAll('.question-block').forEach(block => {
            const qId = block.dataset.id; const type = block.dataset.type || 'pilgan';
            if (type === 'drag') {
                const reqLen = block.querySelectorAll('.blank-slot').length;
                if (document.getElementById(`ans-${qId}`).value.split(',').filter(Boolean).length === reqLen && reqLen > 0) answered++;
            } else if (type === 'urutan') answered++;
            else if (block.querySelector(`input[name="q-${qId}"]:checked`)) answered++;
        });

        let psychAnswered = 0;
        if (document.querySelector('input[name="q_akhlak"]:checked')) { answered++; psychAnswered++; }
        if (document.querySelector('input[name="q_disiplin"]:checked')) { answered++; psychAnswered++; }
        if (document.querySelector('input[name="q_aktif"]:checked')) { answered++; psychAnswered++; }

        if(elProgressBar) elProgressBar.style.width = `${totalQs > 0 ? (answered / totalQs) * 100 : 0}%`;

        const isTimeUp = (timeLeft <= 0 && isQuizStarted && !isEvaluatingExtraLife);
        const isAllAnswered = isTimeUp ? (psychAnswered === 3) : (answered >= totalQs);

        const reviewContainer = document.getElementById('reviewCheckboxContainer');
        const checkReview = document.getElementById('checkReview');

        if (isAllAnswered) {
            if (reviewContainer.classList.contains('hidden')) {
                reviewContainer.classList.remove('hidden');
                setTimeout(() => reviewContainer.classList.remove('opacity-0', 'translate-y-4'), 10);
            }

            if (checkReview && checkReview.checked) {
                btnSubmitGlobal.disabled = false;
                btnSubmitGlobal.innerHTML = 'Kirim Semua Jawaban';
                if (!isEvaluatingExtraLife) {
                    btnSubmitGlobal.classList.replace('bg-gray-200', 'bg-green-600');
                    btnSubmitGlobal.classList.replace('text-gray-400', 'text-white');
                    btnSubmitGlobal.classList.remove('cursor-not-allowed');
                }
            } else {
                btnSubmitGlobal.disabled = true;
                btnSubmitGlobal.innerHTML = '<i class="fa-solid fa-lock mr-1"></i> Centang Janji di Atas';
                if (!isEvaluatingExtraLife) {
                    btnSubmitGlobal.classList.replace('bg-green-600', 'bg-gray-200');
                    btnSubmitGlobal.classList.replace('text-white', 'text-gray-400');
                    btnSubmitGlobal.classList.add('cursor-not-allowed');
                }
            }
        } else {
            reviewContainer.classList.add('opacity-0', 'translate-y-4');
            setTimeout(() => reviewContainer.classList.add('hidden'), 300);
            if (checkReview) checkReview.checked = false;

            btnSubmitGlobal.disabled = true;
            btnSubmitGlobal.innerHTML = 'Kirim Semua Jawaban';
            if (!isEvaluatingExtraLife) {
                btnSubmitGlobal.classList.replace('bg-green-600', 'bg-gray-200');
                btnSubmitGlobal.classList.replace('text-white', 'text-gray-400');
                btnSubmitGlobal.classList.add('cursor-not-allowed');
            }
        }
    };

    document.getElementById('checkReview')?.addEventListener('change', validate);

    // Hitung soal akademik yang belum diisi (selaras dgn validate)
    const countUnansweredAcademic = () => {
        let unanswered = 0;
        document.querySelectorAll('#questionsList .question-block').forEach(block => {
            const qId = block.dataset.id; const type = block.dataset.type || 'pilgan';
            let done = false;
            if (type === 'drag') {
                const reqLen = block.querySelectorAll('.blank-slot').length;
                done = (document.getElementById(`ans-${qId}`)?.value.split(',').filter(Boolean).length === reqLen && reqLen > 0);
            } else if (type === 'urutan') {
                done = true; // urutan punya susunan default → dianggap terisi
            } else {
                done = !!block.querySelector(`input[name="q-${qId}"]:checked`);
            }
            if (!done) unanswered++;
        });
        return unanswered;
    };

