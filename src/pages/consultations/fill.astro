                if (currentAttackMode === 'gift') {
                    const res = await fetch(`${API_URL}/api/shop/gift`, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ actor_id: studentId, target_id: targetId, item_type: selectedItemToBuy })
                    });
                    const data = await res.json();
