    window.handleShopClick = async (itemKey) => {
        const btn = document.getElementById(`btn-shop-${itemKey}`);
        if (btn && btn.disabled) return;

        if (itemKey === 'item_tambah_waktu') {
            if (academicLockReason === 'manual') {
                window.showToast?.('info', 'Sudah Selesai', 'Kamu sudah memilih selesai lebih awal. Tidak bisa tambah waktu lagi.');
                return;
            }
            const timeContainer = document.getElementById('buyTimeContainer');
            const renderTimeBtn = (mins, baseCost) => {
                const cost = window.isDiscountActive ? Math.floor(baseCost/2) : baseCost;
                const isDisabled = studentWallet < cost;
                const btnClass = isDisabled ? "w-full flex justify-between items-center p-3 rounded-xl border border-gray-200 bg-gray-50 opacity-50 grayscale cursor-not-allowed" : "w-full flex justify-between items-center p-3 rounded-xl border border-gray-200 hover:border-teal-400 hover:bg-teal-50 active:scale-95 transition-all group cursor-pointer";
                const textClass = isDisabled ? "font-black text-gray-500" : "font-black text-gray-700 group-hover:text-teal-700";
                return `
                <button ${isDisabled ? 'disabled' : `onclick="executeBuyTime(${mins}, ${cost})"`} class="${btnClass}">
                    <span class="${textClass}">+ ${mins} Menit ${mins === 5 ? '(Max)' : ''}</span>
                    <span class="text-xs font-bold ${isDisabled ? 'bg-gray-200 text-gray-500' : 'bg-amber-100 text-amber-600'} px-2 py-1 rounded">💰 ${cost}</span>
                </button>
                `;
            };
            timeContainer.innerHTML = `
                ${renderTimeBtn(1, 100)}
                ${renderTimeBtn(2, 200)}
                ${renderTimeBtn(3, 350)}
                ${renderTimeBtn(4, 480)}
                ${renderTimeBtn(5, 500)}
            `;
            document.getElementById('modalBuyTime').classList.replace('hidden', 'flex');
            return;
        }


        if (itemKey === 'item_bullying') {
            currentAttackMode = 'bully';
            openAttackModal();
            return;
        }

        if (itemKey === 'item_call_friend') {
            const today = new Date().toDateString();
            if (!isPreview && localStorage.getItem(`call_friend_${studentId}`) === today) {
                window.showToast?.('warning', 'Sudah Dipakai', 'Kamu sudah pakai Kuota Nanya Teman hari ini!');
                return;
            }
            // Munculkan popup konfirmasi
            document.getElementById('modalCallFriendConfirm').classList.replace('hidden', 'flex');
            return;
        }

        if (studentInventory[itemKey] > 0) {
            const item = ITEM_DB[itemKey];
            const sellPrice = Math.floor(item.price / 2);

            document.getElementById('ownedItemIcon').innerText = item.icon;
            document.getElementById('ownedItemName').innerText = item.name;
            document.getElementById('sellPriceText').innerText = sellPrice;
            document.getElementById('btnSellItem').onclick = () => executeSellItem(itemKey, sellPrice);
            document.getElementById('btnUseItem').onclick = () => {
                document.getElementById('modalOwnedItemAction').classList.replace('flex', 'hidden');
                activateItem(itemKey);
            };

            document.getElementById('modalOwnedItemAction').classList.replace('hidden', 'flex');
        } else {
            previewItem(itemKey);
        }
    };

    window.confirmCallFriend = async () => {
        document.getElementById('modalCallFriendConfirm').classList.replace('flex', 'hidden');

        // [CEK] Bukan preview: pastikan ADA teman yang sudah mengerjakan SOAL YANG SAMA.
        // - Kalau belum ada hasil siapa pun → user ini pengerja pertama → item tidak bisa dipakai.
        // - Kalau ada hasil tapi tidak menyentuh soal milik user ini → juga tidak bisa dipakai.
        if (!isPreview) {
            try {
                const res = await fetch(`${API_URL}/api/onboarding/peer-help?subject=${subject}&week=${week}&student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const result = res.ok ? await res.json() : { data: [] };
                const peers = result.data || [];
                const myQids = questions.map(q => q.id);
                const hasMatch = peers.some(p => myQids.includes(p.question_id));

                if (!hasMatch) {
                    window.showToast?.(
                        'warning',
                        'Belum Bisa Tanya Teman',
                        peers.length === 0
                            ? 'Kamu pengerja pertama — belum ada teman yang bisa ditanya.'
                            : 'Belum ada teman yang mengerjakan soal yang sama denganmu.'
                    );
                    return; // Tidak diaktifkan & kuota harian TIDAK dipakai.
                }
            } catch (e) {
                window.showToast?.('danger', 'Gagal', 'Gagal mengecek bantuan teman. Coba lagi nanti.');
                return;
            }
        }

        const today = new Date().toDateString();
        window.isCallFriendActive = true;
        window.hasCalledFriend = false;
        window.pendingCallFriend = true;   // Penanda minta bantuan
        window.pendingCallFriendCount = 0; // Waktu tunggu

        if (!isPreview) {
            localStorage.setItem(`call_friend_${studentId}`, today);
        }

        window.showToast?.('success', 'Bantuan Aktif!', 'Sip! Tungguin temenmu muncul pas lagi ngerjain soal ya.');
        updateShopUI();

        if (isPreview) window.toggleShopDrawer();
    };

    window.executeSellItem = async (itemKey, sellPrice) => {
        document.getElementById('modalOwnedItemAction').classList.replace('flex', 'hidden');
        if (isPreview) {
            studentInventory[itemKey] -= 1;
            studentWallet += sellPrice;
            updateShopUI();
            window.showToast?.('success', 'Terjual!', `Item berhasil dijual seharga ${sellPrice} Poin.`);
            return;
        }

        try {
            const res = await fetch(`${API_URL}/api/shop/sell`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: studentId, item_type: itemKey })
            });
            const data = await res.json();
            if (data.status === 'success') {
                studentInventory[itemKey] -= 1;
                studentWallet = data.data.new_poin;
                updateShopUI();
                window.showToast?.('success', 'Terjual!', data.message);
            }
        } catch(e) { window.showToast?.('danger', 'Gagal', 'Gagal menjual item.'); }
    };

    window.previewItem = (itemKey) => {
        const item = ITEM_DB[itemKey]; selectedItemToBuy = itemKey;
        const currentPrice = getPrice(itemKey);

        document.getElementById('buyItemIcon').innerText = item.icon; document.getElementById('buyItemName').innerText = item.name;
        document.getElementById('buyItemPrice').innerText = `💰 ${currentPrice} Poin`;
        document.getElementById('buyItemDesc').innerText = item.desc;

        const btnConfirm = document.getElementById('btnConfirmBuy');
        if (studentWallet < currentPrice) { btnConfirm.disabled = true; btnConfirm.className = 'flex-1 py-3.5 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed text-sm'; btnConfirm.innerText = 'Poin Kurang'; }
        else { btnConfirm.disabled = false; btnConfirm.className = 'flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-600/30 active:scale-95 transition-all text-sm'; btnConfirm.innerText = 'Beli Sekarang'; }
        document.getElementById('modalBuyItem').classList.replace('hidden', 'flex');
    };

    window.executeBuyItem = async () => {
        const btn = document.getElementById('btnConfirmBuy'); const price = getPrice(selectedItemToBuy);
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>'; btn.disabled = true;
        studentWallet -= price; updateShopUI();
        try {
            if (!isPreview) {
                if(selectedItemToBuy === 'item_double_coin' || selectedItemToBuy === 'item_triple_coin' || selectedItemToBuy === 'item_diskon') {
                     const res = await fetch(`${API_URL}/api/shop/purchase-effect`, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ student_id: studentId, effect_type: selectedItemToBuy, cost: price })
                    });
                    const data = await res.json();
                    if (data.status !== 'success') throw new Error(data.message);
                    studentWallet = data.data.new_poin;
                    studentInventory[selectedItemToBuy] = 1;
                } else {
                    const res = await fetch(`${API_URL}/api/shop/buy`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ student_id: studentId, item_type: selectedItemToBuy, week: parsedWeek }) });
                    const data = await res.json();
                    if (data.status !== 'success') throw new Error(data.message);
                    studentWallet = data.data.poin; studentInventory[selectedItemToBuy] = data.data[selectedItemToBuy];
                }
            } else {
                await new Promise(r => setTimeout(r, 600)); studentInventory[selectedItemToBuy] += 1;
            }
            updateShopUI();
            window.showToast?.('success', 'Berhasil', selectedItemToBuy === 'item_extra_life' ? 'Item otomatis aktif!' : 'Item berhasil dibeli. Klik untuk memakai!'); closeBuyModal();
        } catch (error) {
            studentWallet += price; updateShopUI(); window.showToast?.('danger', 'Gagal Beli', error.message); btn.innerText = 'Beli Sekarang'; btn.disabled = false;
        }
    };

    // ==========================================
    // Penawaran cepat +30 detik saat waktu < 20 detik (harga naik tiap kali ditawari, maks 5x)
    // ==========================================
    const QUICK_OFFER_PRICES = [100, 250, 500, 800, 1200];
    let quickOfferShownCount = 0;
    let quickOfferVisible = false;
    let quickOfferPrice = QUICK_OFFER_PRICES[0];

    const updateQuickTimeOffer = () => {
        const wrap = document.getElementById('quickTimeOffer');
        if (!wrap) return;

        const inWindow = timeLeft <= 20 && timeLeft > 0 && academicLockReason !== 'manual';
        const floatingItems = document.getElementById('floatingItems');
        const timer = document.getElementById('floatingTimer');

        if (inWindow && !quickOfferVisible && quickOfferShownCount < QUICK_OFFER_PRICES.length) {
            // Tawaran muncul: tetapkan harga sesuai berapa kali sudah ditawari, lalu naikkan hitungannya.
            quickOfferPrice = QUICK_OFFER_PRICES[quickOfferShownCount];
            quickOfferShownCount++;
            quickOfferVisible = true;
            const priceEl = document.getElementById('quickTimePrice');
            if (priceEl) priceEl.innerText = quickOfferPrice;
            wrap.classList.remove('hidden');

            // Sembunyikan pil "items" agar penawaran bisa nyambung tepat di bawah timer.
            if (floatingItems) floatingItems.style.display = 'none';

            // Sambungkan ke capsule timer: ratakan radius bawah timer & samakan lebar + posisi flush.
            if (timer) {
                // Radius bawah timer diratakan (nyambung ke tombol), dan radius ATAS timer
                // disamakan dengan radius bawah tombol (rounded-b-2xl = 1rem) agar serasi.
                timer.style.borderBottomLeftRadius = '0';
                timer.style.borderBottomRightRadius = '0';
                timer.style.borderTopLeftRadius = '1rem';
                timer.style.borderTopRightRadius = '1rem';
                const r = timer.getBoundingClientRect();
                wrap.style.width = r.width + 'px';
                wrap.style.top = (r.bottom - 1) + 'px';
            }
        } else if (!inWindow) {
            // Di luar jendela <20 dtk (mis. setelah beli waktu / waktu habis): sembunyikan & pulihkan timer.
            if (!wrap.classList.contains('hidden')) wrap.classList.add('hidden');
            quickOfferVisible = false;
            if (floatingItems) floatingItems.style.display = '';
            if (timer) {
                timer.style.borderBottomLeftRadius = '';
                timer.style.borderBottomRightRadius = '';
                timer.style.borderTopLeftRadius = '';
                timer.style.borderTopRightRadius = '';
            }
            wrap.style.width = '';
            wrap.style.top = '';
        }

        // Selagi tampil: kalau koin tidak cukup → tampak abu-abu (disabled), tapi tetap bisa diklik (memunculkan toast).
        if (quickOfferVisible) {
            const btn = document.getElementById('quickTimeBtn');
            if (btn) btn.classList.toggle('quick-disabled', studentWallet < quickOfferPrice);
        }
    };

    window.buyQuickTime = async () => {
        if (academicLockReason === 'manual') return; // Sudah selesai lebih awal, timer tidak relevan
        const cost = quickOfferPrice;
        if (studentWallet < cost) {
            window.showToast?.('danger', 'Poin Kurang', `Butuh ${cost} poin untuk +30 detik.`);
            return;
        }

        const wrap = document.getElementById('quickTimeOffer');
        const btn = document.getElementById('quickTimeBtn');
        if (btn) btn.disabled = true;

        studentWallet -= cost;
        updateShopUI();

        try {
            if (!isPreview) {
                const res = await fetch(`${API_URL}/api/shop/purchase-effect`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: studentId, effect_type: 'tambah_waktu', cost: cost })
                });
                const data = await res.json();
                if (data.status !== 'success') throw new Error(data.message);
                studentWallet = data.data.new_poin;
            }

            // [FIX] Basis dari "sekarang" kalau timer sudah lewat (lihat catatan di executeBuyTime).
            const prevEnd = parseInt(localStorage.getItem(timeKey));
            const base = (!isNaN(prevEnd) && prevEnd > Date.now()) ? prevEnd : Date.now();
            localStorage.setItem(timeKey, base + 30 * 1000);
            timeLeft = Math.floor((base + 30 * 1000 - Date.now()) / 1000);

            updateTimerUI();
            updateShopUI();
            window.showToast?.('success', 'Waktu +30 Detik!', 'Gas, kebut lagi!');
            window.afterTimeAdded?.(); // [2.3] lanjutkan kalau tadi waktu sudah habis

            if (wrap) wrap.classList.add('hidden');
            quickOfferVisible = false;
            const fi = document.getElementById('floatingItems');
            if (fi) fi.style.display = '';
        } catch (e) {
            studentWallet += cost; updateShopUI();
            window.showToast?.('danger', 'Gagal', e.message || 'Gagal menambah waktu.');
        } finally {
            if (btn) btn.disabled = false;
        }
    };

    window.executeBuyTime = async (minutes, cost) => {
        if (studentWallet < cost) {
            window.showToast?.('danger', 'Poin Kurang', `Butuh ${cost} poin untuk menambah waktu!`);
            return;
        }

        studentWallet -= cost;
        updateShopUI();
        document.getElementById('modalBuyTime').classList.replace('flex', 'hidden');

        try {
            if (!isPreview) {
                 const res = await fetch(`${API_URL}/api/shop/purchase-effect`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: studentId, effect_type: 'tambah_waktu', cost: cost })
                });
                const data = await res.json();
                if (data.status !== 'success') throw new Error(data.message);
                studentWallet = data.data.new_poin;
            }

            // [FIX] Kalau waktu sudah habis, end-timestamp ada di MASA LALU. Jangan ditambah
            // ke timestamp lama (hasilnya tetap minus) — pakai waktu sekarang sebagai basis.
            const addedMs = minutes * 60 * 1000;
            const prevEnd = parseInt(localStorage.getItem(timeKey));
            const base = (!isNaN(prevEnd) && prevEnd > Date.now()) ? prevEnd : Date.now();
            localStorage.setItem(timeKey, base + addedMs);
            timeLeft = Math.floor((base + addedMs - Date.now()) / 1000);

            updateTimerUI();
            window.showToast?.('success', 'Waktu Ditambahkan!', `Berhasil tambah ${minutes} menit.`);
            updateShopUI();
            window.afterTimeAdded?.(); // [2.3] lanjutkan kalau tadi waktu sudah habis

        } catch(e) {
            studentWallet += cost; updateShopUI();
            window.showToast?.('danger', 'Gagal Beli', e.message);
        }
    }

    const updateShopUI = () => {
        const displayPoin = document.getElementById('currentPoinDisplay'); if (displayPoin) displayPoin.innerText = studentWallet;

        Object.keys(ITEM_DB).forEach(key => {
            const btn = document.getElementById(`btn-shop-${key}`); if (!btn) return;
            const isOwned = studentInventory[key] > 0;
            const isBought = boughtItemsThisSession[key];
            const titleEl = btn.querySelector('.item-title');
            const oldBadge = btn.querySelector('.qty-badge'); if (oldBadge) oldBadge.remove();

            // 1. BERSIHKAN SEMUA CLASS STATE SEBELUMNYA BIAR GAK NYANGKUT
            btn.classList.remove('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed', 'bg-indigo-50', 'border-indigo-300', 'bg-pink-50', 'border-pink-300', 'cursor-pointer', 'cursor-default');

            // 2. KEMBALIKAN NAMA ASLI ITEM (Misal: "Double Nilai" jadi "Double<br>Nilai")
            const defaultName = ITEM_DB[key].name.replace(' ', '<br>');

            // ===============================================
            // LOGIKA SPESIAL: ITEM SEKALI PAKAI (TIDAK MASUK TAS)
            // ===============================================
            if (key === 'item_tambah_waktu') {
                const minTimePrice = window.isDiscountActive ? 50 : 100; // Harga termurah 1 menit
                if (studentWallet < minTimePrice) {
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                    btn.disabled = true;
                } else {
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                }
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                titleEl.innerHTML = defaultName;
                return;
            }

            if (key === 'item_bullying') {
                if (isBought) {
                    // Kalo udah dipakai sesi ini, disable
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                    titleEl.className = "text-[8px] font-black text-gray-500 mt-1 uppercase tracking-widest item-title text-center leading-tight";
                    btn.disabled = true;
                    titleEl.innerText = "TERPAKAI";
                } else if (studentWallet < getPrice(key)) {
                    // Belum dipakai tapi uang gak cukup
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                    btn.disabled = true;
                    titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                    titleEl.innerHTML = defaultName;
                } else {
                    // Bisa dipakai
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                    titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                    titleEl.innerHTML = defaultName;
                }
                return;
            }

            if (key === 'item_call_friend') {
                const today = new Date().toDateString();
                if (!isPreview && localStorage.getItem(`call_friend_${studentId}`) === today) {
                    btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                    btn.disabled = true;
                    titleEl.innerText = "HABIS";
                } else {
                    btn.classList.add('cursor-pointer');
                    btn.disabled = false;
                    titleEl.innerHTML = "Tanya<br>Teman";
                }
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                return;
            }

            // ===============================================
            // LOGIKA ITEM INVENTORY (Bisa Disimpan, Dijual, Dikirim)
            // ===============================================
            if (isOwned) {
                // KONDISI A: ITEM ADA DI DALAM TAS
                btn.disabled = false; // Harus bisa diklik buat buka Modal Jual/Pakai/Gift
                btn.classList.add('bg-indigo-50', 'border-indigo-300', 'cursor-pointer');

                titleEl.innerText = "PAKAI";
                titleEl.className = "text-[7px] font-black text-indigo-700 mt-1 uppercase tracking-wider item-title text-center leading-tight";

                // Tambah badge jumlah
                const newBadge = document.createElement('span');
                newBadge.className = "qty-badge absolute -top-1.5 -right-1.5 bg-indigo-600 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center border border-white shadow-md";
                newBadge.innerText = studentInventory[key];
                btn.appendChild(newBadge);

            } else if (isBought) {
                // KONDISI B: ITEM SUDAH DIPAKAI DI SESI INI
                btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                titleEl.className = "text-[8px] font-black text-gray-500 mt-1 uppercase tracking-widest item-title text-center leading-tight";
                btn.disabled = true;
                titleEl.innerText = "TERPAKAI"; // Teks berubah jadi terpakai

            } else if (studentWallet < getPrice(key)) {
                // KONDISI C: BELUM PUNYA & DUIT KURANG BUAT BELI
                btn.classList.add('bg-gray-100', 'border-gray-200', 'opacity-50', 'grayscale', 'cursor-not-allowed');
                titleEl.className = "text-[8px] font-bold text-gray-400 mt-0.5 item-title text-center leading-tight";
                btn.disabled = true;
                titleEl.innerHTML = defaultName; // Teks balik normal tapi redup

            } else {
                // KONDISI D: NORMAL (BISA DIBELI)
                btn.classList.add('cursor-pointer');
                btn.disabled = false;
                titleEl.className = "text-[8px] font-bold text-gray-700 mt-0.5 item-title text-center leading-tight";
                titleEl.innerHTML = defaultName; // Teks balik ke nama aslinya
            }
        });

        // 3. LOGIKA VIGNETTE & FLOATING ICONS SAAT UJIAN BERJALAN
        const vignette = document.getElementById('shieldVignette');
        if (vignette) window.isShieldActive && isQuizStarted ? vignette.classList.replace('opacity-0', 'opacity-100') : vignette.classList.replace('opacity-100', 'opacity-0');

        const floatingItems = document.getElementById('floatingItems');
        if (isQuizStarted) {
            let activeHtml = '';
            if (window.isShieldActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🛡️</span>`;
            if (window.isDoubleScoreActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">✨</span>`;
            if (window.isDoubleCoinActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">💰</span>`;
            if (window.isTripleCoinActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🤑</span>`;
            if (window.isDiscountActive) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">🏷️</span>`;
            if (studentInventory.item_extra_life > 0) activeHtml += `<span class="text-base drop-shadow-sm animate-pulse">💖</span>`;

            if (activeHtml !== '') {
                floatingItems.classList.replace('hidden', 'flex');
                document.getElementById('itemsTextContainer').innerHTML = activeHtml;
            } else {
                floatingItems.classList.replace('flex', 'hidden');
            }
        }
    };

    // [BARU] State untuk filter Bully
    window.bullyFilterMode = 'khusus';

    window.setBullyFilter = (mode) => {
        window.bullyFilterMode = mode;
        if (mode === 'khusus') {
            document.getElementById('btnFilterKhusus').className = 'flex-1 py-2 text-[10px] font-black rounded-lg bg-white text-purple-600 shadow-sm transition-all';
            document.getElementById('btnFilterUmum').className = 'flex-1 py-2 text-[10px] font-black rounded-lg text-gray-400 hover:text-gray-600 transition-all';
        } else {
            document.getElementById('btnFilterUmum').className = 'flex-1 py-2 text-[10px] font-black rounded-lg bg-white text-purple-600 shadow-sm transition-all';
            document.getElementById('btnFilterKhusus').className = 'flex-1 py-2 text-[10px] font-black rounded-lg text-gray-400 hover:text-gray-600 transition-all';
        }
        openAttackModal(); // Render ulang list temannya
    };

    window.openAttackModal = async () => {
        const listContainer = document.getElementById('attackTargetList');
        listContainer.innerHTML = '<div class="text-center p-4 text-xs text-gray-400"><i class="fa-solid fa-spinner fa-spin text-xl mb-2"></i><br>Mencari target...</div>';

        const toggleContainer = document.getElementById('bullyToggleContainer');

