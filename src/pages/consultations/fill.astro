---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
import PhotoBooth from '../../components/PhotoBooth.astro';
import Mascot from '../../components/Mascot.astro';
---

<Layout title="Sesi Pengerjaan - yukNgaji">
    <div class="min-h-screen bg-gray-50 flex flex-col overflow-hidden relative">
        
        <header id="mainHeader" class="sticky top-0 px-6 py-4 bg-white/95 backdrop-blur-md border-b z-[80] shadow-sm flex items-center justify-between transition-all duration-500 transform translate-y-0">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-green-600 text-white rounded-lg flex items-center justify-center font-bold text-xs" id="headerInitials">--</div>
                <h2 class="font-bold text-gray-800 text-sm hidden sm:block" id="headerName">Memuat...</h2>
            </div>
            
            <div id="headerTimerDisplay" class="absolute left-1/2 -translate-x-1/2 px-6 py-2 bg-white text-gray-800 rounded-full font-mono font-black text-xl border-2 border-gray-200 shadow-md transition-all">
                <i class="fa-solid fa-stopwatch text-green-500 mr-1" id="headerTimerIcon"></i> <span id="headerTimerText">--:--</span>
            </div>

            <a href="javascript:void(0)" onclick="handleBack()" class="text-xs font-bold text-gray-400 hover:text-red-500 transition-colors bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100 active:scale-95">Keluar</a>
        </header>

        <div id="floatingTimer" onclick="toggleFloatingTimer()" class="fixed top-6 right-6 z-[250] hidden flex-row items-center bg-white rounded-full shadow-[0_5px_15px_rgba(0,0,0,0.1)] border border-gray-100 cursor-pointer transition-all duration-300 p-1 hover:scale-105">
            <div class="relative w-9 h-9 flex items-center justify-center rounded-full flex-shrink-0" id="timerRing" style="background: conic-gradient(#16a34a 100%, #f3f4f6 0%);">
                <div class="w-[26px] h-[26px] bg-white rounded-full flex items-center justify-center absolute z-10">
                    <i class="fa-solid fa-stopwatch text-green-600 text-[11px] transition-colors" id="floatTimerIcon"></i>
                </div>
            </div>
            <div id="timerTextContainer" class="overflow-hidden transition-all duration-300 w-[50px] ml-1 flex items-center justify-center">
                <span id="timerTextFloat" class="font-mono font-black text-gray-800 text-sm">--:--</span>
            </div>
        </div>

        <div id="floatingItems" onclick="toggleFloatingItems()" class="fixed top-[4.5rem] right-6 z-[250] hidden flex-row-reverse items-center bg-white rounded-full shadow-[0_5px_15px_rgba(0,0,0,0.1)] border border-gray-100 cursor-pointer transition-all duration-300 p-1 hover:scale-105">
            <div class="relative w-9 h-9 flex items-center justify-center rounded-full flex-shrink-0 bg-indigo-50 border border-indigo-100 z-10">
                <i class="fa-solid fa-box text-indigo-500 text-xs transition-transform" id="floatItemsIcon"></i>
            </div>
            <div id="itemsTextContainer" class="overflow-hidden transition-all duration-300 max-w-0 opacity-0 flex items-center justify-end gap-1.5 h-9">
            </div>
        </div>

        <div id="shopDrawerWrapper" class="fixed bottom-0 left-0 w-full z-[350] flex flex-col items-center pointer-events-none overflow-hidden transition-all duration-500">
            <div id="shopDrawerInner" class="w-full max-w-md flex flex-col items-center transform translate-y-[calc(100%-40px)] transition-transform duration-500 ease-out">
                
                <button id="btnToggleDrawer" onclick="toggleShopDrawer()" class="h-[40px] pointer-events-auto bg-indigo-600 text-white px-8 rounded-t-2xl shadow-[0_-5px_15px_rgba(79,70,229,0.3)] flex items-center justify-center gap-2 hover:bg-indigo-700 active:bg-indigo-800 transition-all border-x border-t border-indigo-400/50 outline-none">
                    <i id="shopDrawerIcon" class="fa-solid fa-store transition-transform duration-300"></i>
                    <span class="font-black text-[11px] tracking-widest uppercase">Toko Item</span>
                </button>
                
                <div id="shopDrawerContent" class="pointer-events-auto w-full bg-white/95 backdrop-blur-xl rounded-t-[2rem] p-6 shadow-[0_-10px_40px_rgba(0,0,0,0.2)] border-t border-gray-200">
                    
                    <!-- SWITCH SIMULASI BULLY -->
                    <div id="simBullyToggle" class="hidden bg-purple-50 border border-purple-100 p-3 rounded-2xl mb-4 flex justify-between items-center shadow-sm">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-purple-100 text-purple-500 rounded-full flex items-center justify-center"><i class="fa-solid fa-user-ninja"></i></div>
                            <span class="text-[10px] font-black text-purple-800 uppercase tracking-widest">Simulasi Dibully</span>
                        </div>
                        <button onclick="triggerSimBully()" class="bg-purple-600 hover:bg-purple-700 active:scale-95 transition-all text-white text-[9px] px-3 py-1.5 rounded-lg font-black uppercase shadow-md shadow-purple-500/30">Coba</button>
                    </div>

                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-black text-gray-800 text-lg"><i class="fa-solid fa-basket-shopping text-indigo-500 mr-1"></i> Pasar Sihir</h3>
                        <div class="bg-amber-100 px-3 py-1.5 rounded-xl border border-amber-200 flex items-center gap-1.5 shadow-inner">
                            <span class="text-[9px] font-bold text-amber-700 uppercase tracking-wider">Saldo:</span>
                            <span class="text-sm">💰</span>
                            <span id="currentPoinDisplay" class="text-base font-black text-amber-600 drop-shadow-sm">0</span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-4 gap-2 mb-2 pt-2 px-2 pb-4 overflow-y-auto max-h-52 custom-scrollbar">
                        
                        <button id="btn-shop-item_double_score" onclick="handleShopClick('item_double_score')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-indigo-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">✨</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Double<br>Nilai</span>
                        </button>
                        <button id="btn-shop-item_serang" onclick="handleShopClick('item_serang')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-red-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">⚔️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Serang<br>Teman</span>
                        </button>
                        <button id="btn-shop-item_perisai" onclick="handleShopClick('item_perisai')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-blue-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🛡️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Perisai<br>Aman</span>
                        </button>
                        <button id="btn-shop-item_extra_life" onclick="handleShopClick('item_extra_life')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-pink-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">💖</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Extra<br>Life</span>
                        </button>

                        <button id="btn-shop-item_tambah_waktu" onclick="handleShopClick('item_tambah_waktu')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-teal-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">⏳</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Tambah<br>Waktu</span>
                        </button>
                        <button id="btn-shop-item_double_coin" onclick="handleShopClick('item_double_coin')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-amber-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">💰</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Double<br>Koin</span>
                        </button>
                        <button id="btn-shop-item_triple_coin" onclick="handleShopClick('item_triple_coin')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-amber-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🤑</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Triple<br>Koin</span>
                        </button>
                        <button id="btn-shop-item_bullying" onclick="handleShopClick('item_bullying')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-purple-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">😈</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Bully<br>Teman</span>
                        </button>
                        
                        <button id="btn-shop-item_diskon" onclick="handleShopClick('item_diskon')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-green-50 active:scale-95 transition-all group relative col-span-2 sm:col-span-1">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🏷️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Kupon<br>Diskon</span>
                        </button>
                        <button id="btn-shop-item_call_friend" onclick="handleShopClick('item_call_friend')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-blue-50 active:scale-95 transition-all group relative col-span-2 sm:col-span-1">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">📞</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Tanya<br>Teman</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAYAR ANIMASI BULLYING DENGAN KAMERA -->
        <div id="bullyOverlay" class="fixed inset-0 pointer-events-none z-[1000] hidden items-center justify-center overflow-hidden">
            <div id="bullyCharacter" class="transform translate-x-[150vw] transition-transform duration-1000 flex flex-col items-center">
                <div class="relative bg-white border-4 border-purple-500 rounded-3xl p-4 shadow-2xl mb-4 w-64 text-center z-30">
                    <p id="bullySpeech" class="text-sm font-black text-purple-700">Wle wle wle, soalnya aku umpetin wle.... 😜</p>
                    <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-6 h-6 bg-white border-b-4 border-r-4 border-purple-500 transform rotate-45"></div>
                </div>
                
                <div class="relative flex items-center justify-center w-48 h-48">
                    <div id="bullyAvatar" class="absolute inset-0 bg-purple-100 border-4 border-purple-500 rounded-full flex items-center justify-center shadow-2xl overflow-hidden z-10 transition-all duration-500">
                        <span id="bullyInitials" class="text-5xl font-black text-purple-600">??</span>
                    </div>
                    
                    <div id="bullyCameraFrame" class="absolute inset-0 bg-white border-4 border-purple-500 rounded-full shadow-2xl overflow-hidden z-20 hidden transition-all duration-500 scale-0 opacity-0">
                        <video id="bullyCameraStream" autoplay playsinline muted class="w-full h-full object-cover transform -scale-x-100"></video>
                    </div>
                </div>

                <p id="bullyName" class="mt-4 font-black text-purple-900 text-xl bg-white/90 backdrop-blur-md px-8 py-2 border border-purple-200 rounded-full shadow-lg z-30">Pelaku</p>
            </div>
        </div>

        <div id="callFriendOverlay" class="fixed right-0 top-1/4 z-[400] transform translate-x-full transition-transform duration-700 flex items-center pointer-events-none">
            <div class="bg-white/95 backdrop-blur-md border-4 border-blue-400 p-4 rounded-l-3xl shadow-[0_10px_40px_rgba(0,0,0,0.2)] flex items-center gap-4 max-w-[280px]">
                <div class="w-16 h-16 bg-blue-100 rounded-full border-2 border-blue-500 flex items-center justify-center text-3xl shrink-0 shadow-inner font-black text-blue-600 uppercase" id="cfAvatar">
                    A
                </div>
                <div>
                    <p class="text-[10px] font-black text-blue-500 mb-1 tracking-widest uppercase" id="cfName">Ahmad</p>
                    <p class="text-xs font-bold text-gray-800 leading-tight" id="cfMessage">Kalo aku sih nomor 3 jawabannya A!</p>
                </div>
            </div>
        </div>

        <div id="previewBanner" class="hidden w-full bg-amber-500 text-white text-[10px] font-black py-3 uppercase tracking-widest z-[150] shadow-md px-6 flex items-center justify-center transition-all duration-500 relative">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-eye animate-pulse"></i> Mode Simulasi Ustadz
            </div>
            <button id="bannerExitBtn" onclick="exitPreview()" class="hidden absolute right-6 bg-black/20 hover:bg-black/40 px-3 py-1.5 rounded-lg transition-colors font-bold text-white cursor-pointer active:scale-95">Keluar</button>
        </div>

        <div class="w-full h-1.5 bg-gray-100 z-50 relative">
            <div id="progressBar" class="h-full bg-green-500 w-0 transition-all duration-500 ease-out rounded-r-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
        </div>

        <div id="vigLeft"   style="pointer-events:none;position:fixed;top:0;left:0;width:60px;height:100vh;z-index:9999;background:linear-gradient(to right,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigRight"  style="pointer-events:none;position:fixed;top:0;right:0;width:60px;height:100vh;z-index:9999;background:linear-gradient(to left,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigTop"    style="pointer-events:none;position:fixed;top:0;left:0;width:100vw;height:60px;z-index:9999;background:linear-gradient(to bottom,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigBottom" style="pointer-events:none;position:fixed;bottom:0;left:0;width:100vw;height:60px;z-index:9999;background:linear-gradient(to top,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        
        <div id="shieldVignette" class="fixed inset-0 pointer-events-none z-[110] transition-all duration-1000 opacity-0" style="box-shadow: inset 0 0 120px rgba(59, 130, 246, 0.5); border: 6px solid rgba(59, 130, 246, 0.4);"></div>

        <main class="flex-1 relative overflow-y-auto px-6 py-8 pb-32">
            
            <div id="startOverlay" class="absolute inset-0 bg-white z-[120] flex flex-col items-center justify-center p-8 text-center transition-all duration-500 pb-16 overflow-y-auto">
                <div class="w-24 h-24 bg-green-50 text-green-600 rounded-[2rem] flex items-center justify-center text-4xl mb-6 shadow-inner border border-green-100 mt-10">
                    <i class="fa-solid fa-stopwatch"></i>
                </div>
                <h1 class="text-2xl font-bold text-gray-800 mb-2" id="startTitleText">Siap Mengerjakan?</h1>
                <p id="startDescText" class="text-sm text-gray-400 mb-4 leading-relaxed">Pastikan fokus. Waktu terbatas untuk bagian akademik.</p>
                
                <div id="prSettings" class="hidden flex-col items-center w-full max-w-xs mb-6">
                    <div class="bg-indigo-50 border border-indigo-100 p-3 rounded-xl mb-3 text-left">
                        <p class="text-[10px] text-indigo-700 font-bold leading-relaxed">
                            <i class="fa-solid fa-circle-info mr-1"></i> Ini adalah Mode PR. Jawabanmu hanya bisa dikirim 1x. Jika keluar halaman, klik link dari Kak Aziz lagi ya!
                        </p>
                    </div>
                    <label class="w-full flex items-center justify-between cursor-pointer bg-gray-50 border border-gray-200 p-3 rounded-xl hover:bg-gray-100 transition-colors">
                        <div>
                            <span class="text-xs font-bold text-gray-700 block text-left"><i class="fa-solid fa-cat mr-1 text-gray-400"></i> Sembunyikan Miaw</span>
                            <span class="text-[9px] font-bold text-gray-400 block text-left mt-0.5">Fokus penuh tanpa animasi</span>
                        </div>
                        <input type="checkbox" id="toggleHideMiaw" class="w-4 h-4 text-green-600 focus:ring-green-500 rounded border-gray-300">
                    </label>
                </div>

                <button id="btnStart" disabled class="w-full max-w-xs py-4 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed transition-all text-lg flex items-center justify-center gap-2">
                    <i class="fa-solid fa-spinner fa-spin"></i> Menyiapkan Data...
                </button>
            </div>

            <div id="countdownOverlay" class="hidden fixed inset-0 bg-green-600 z-[9999] flex items-center justify-center">
                <span id="countdownText" class="text-[10rem] font-black text-white italic animate-ping">3</span>
            </div>

            <div id="testContent" class="hidden space-y-8 max-w-md mx-auto mt-4 transition-opacity duration-500">
                <section id="academicSection" class="space-y-4 transition-all duration-700">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 bg-red-600 text-white rounded-full flex items-center justify-center text-[10px] font-bold">1</span>
                        <h3 class="font-bold text-gray-800">Soal Akademik</h3>
                    </div>
                    
                    <div id="questionsList" class="space-y-6"></div>

                    <button id="btnEarlyFinish" class="w-full mt-4 py-3 bg-red-50 text-red-600 font-bold rounded-xl border border-red-100 active:scale-95 transition-all text-xs">
                        <i class="fa-solid fa-stopwatch mr-1"></i> Selesaikan Akademik Sekarang
                    </button>
                </section>

                <hr class="border-dashed border-gray-200">

                <section id="consultationSection" class="space-y-6">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-[10px] font-bold">2</span>
                        <h3 class="font-bold text-gray-800">Pojok Curhat</h3>
                    </div>
                    
                    <div class="bg-blue-50 p-5 rounded-3xl border border-blue-100 space-y-4 shadow-sm">
                        <div id="kuesionerContainer" class="space-y-4 mb-4"></div>
                        <div>
                            <label class="block text-[10px] font-bold text-blue-400 uppercase tracking-widest mb-2 ml-1">FOTO RAPORT (Bisa Nanti)</label>
                            <button type="button" onclick="openCameraModal()" id="btnOpenCamera" class="w-full h-32 border-2 border-dashed border-blue-300 rounded-2xl bg-white/50 flex flex-col items-center justify-center hover:bg-blue-100 transition-colors active:scale-95">
                                <div id="cameraIconBox">
                                    <i class="fa-solid fa-camera-retro text-3xl text-blue-400 mb-2 drop-shadow-sm"></i>
                                    <span class="block text-[10px] font-bold text-blue-500 bg-blue-100 px-3 py-1 rounded-full uppercase tracking-wider">Buka Kamera</span>
                                </div>
                                <img id="selfiePreview" class="hidden w-full h-full object-cover rounded-xl" />
                            </button>
                        </div>
                    </div>
                </section>

                <div id="reviewCheckboxContainer" class="hidden mb-4 bg-orange-50 p-4 rounded-2xl border border-orange-200 transition-all transform opacity-0 translate-y-4">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox" id="checkReview" class="mt-0.5 w-5 h-5 text-orange-600 focus:ring-orange-500 rounded border-orange-300 cursor-pointer">
                        <span class="text-xs font-bold text-orange-800 leading-relaxed">Aku sudah membaca dan mengecek semua jawabanku dengan teliti.</span>
                    </label>
                </div>

                <button id="btnSubmit" disabled class="w-full py-5 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed transition-all text-lg shadow-sm mb-12 relative overflow-hidden">
                    Kirim Semua Jawaban
                </button>
            </div>
        </main>
    </div>

    <!-- MODAL CONFIRM GLOBAL -->
    <div id="modalConfirmGlobal" class="fixed inset-0 bg-black/60 z-[9999] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white w-full max-w-sm rounded-[2rem] p-6 shadow-2xl text-center transform scale-100 animate-bounce-short border-4 border-indigo-400" id="modalConfirmBox">
            <div id="confirmGlobalIconBox" class="w-20 h-20 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border border-indigo-100 shadow-inner">
                <i id="confirmGlobalIcon" class="fa-solid fa-circle-question"></i>
            </div>
            <h3 id="confirmGlobalTitle" class="font-black text-gray-800 text-xl mb-2">Konfirmasi</h3>
            <p id="confirmGlobalMessage" class="text-sm text-gray-600 mb-6 leading-relaxed font-medium">Apakah Anda yakin?</p>
            <div class="flex gap-3">
                <button id="btnConfirmGlobalCancel" class="flex-1 py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-500 font-bold rounded-2xl active:scale-95 transition-all text-sm">Batal</button>
                <button id="btnConfirmGlobalYes" class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-600/30 active:scale-95 transition-all text-sm">Ya, Lanjutkan</button>
            </div>
        </div>
    </div>

    <div id="modalCekSatpam" class="fixed inset-0 bg-black/70 z-[9999] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center">
            <div class="w-16 h-16 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 border border-blue-100 shadow-inner">
                <i class="fa-solid fa-user-shield animate-pulse"></i>
            </div>
            <h3 class="font-bold text-gray-800 text-lg mb-2">Verifikasi Keamanan</h3>
            <p class="text-sm text-gray-500 mb-4 leading-relaxed">Sedang memeriksa histori pemindaian wajah...</p>
            <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 animate-pulse w-full"></div>
            </div>
        </div>
    </div>

    <div id="modalNetwork" class="fixed inset-0 bg-black/70 z-[400] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center">
            <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 border border-red-100">
                <i class="fa-solid fa-wifi" id="networkIcon"></i>
            </div>
            <h3 id="networkTitle" class="font-bold text-gray-800 text-lg mb-2">Jaringan Lambat</h3>
            <p id="networkDesc" class="text-sm text-gray-500 mb-4 leading-relaxed">Sepertinya jaringan anda sedang lambat, silahkan angkat HP anda sejajar dengan wajah (seperti gambar) agar sinyal lebih kuat.</p>
