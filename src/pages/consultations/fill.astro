    @keyframes bullyBloodPulse {
        0%, 100% { transform: scale(1); box-shadow: 0 14px 36px rgba(220,38,38,0.55); }
        50% { transform: scale(1.06); box-shadow: 0 18px 48px rgba(220,38,38,0.9); }
    }

    /* Overlay awal: tetap bisa di-scroll, tapi sembunyikan scrollbar-nya */
    #startOverlay { scrollbar-width: none; -ms-overflow-style: none; }
    #startOverlay::-webkit-scrollbar { display: none; width: 0; height: 0; }

    .urutan-indikator-wrap { background: #f8faff; border: 1.5px solid #bfdbfe; border-radius: 14px; padding: 10px 14px; }
    .urutan-ind-label { font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .urutan-ind-pills { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
    .urutan-ind-pill { width: 30px; height: 30px; border-radius: 8px; border: 1.5px solid; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
