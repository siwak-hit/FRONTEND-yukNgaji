    .toast-container, [id^="toast"] { z-index: 99999 !important; }

    /* Huruf Arab tampil lebih besar & rapi tanpa memperbesar teks latin di sekitarnya.
       Dipasang global karena soal/opsi dirender lewat innerHTML. */
    .ar-text {
        font-family: 'Noto Naskh Arabic', 'Amiri', 'Geeza Pro', 'Traditional Arabic', serif !important;
        /* Amiri/Noto hanya punya weight 400/500/700 — paksa 400 supaya tidak jatuh
           ke fallback non-Arab (penyebab huruf jadi terpisah-pisah di HP). */
