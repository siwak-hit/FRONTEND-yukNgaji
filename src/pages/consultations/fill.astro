            icon.className = 'w-20 h-20 bg-gray-100 text-gray-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border-4 border-white shadow-lg';
            icon.innerHTML = '<i class="fa-solid fa-lock"></i>';
            title.innerText = 'Kesempatan Sudah Habis';
            msg.innerText = 'Kamu sudah pernah diberi perpanjangan waktu tapi belum sempat mengerjakannya. Maaf, kesempatan tidak bisa dipakai lagi. Hubungi Kak Aziz langsung ya.';
