    window.triggerCallFriend = async () => {
        if (window.hasCalledFriend) return;
        window.hasCalledFriend = true;
        
        let friendName = "Robot Teman";
        let friendAnswerRaw = "B";
        let targetQuestionId = null;

        try {
            const currentQuestionIds = questions.map(q => q.id);

            if (!isPreview) {
                let peersAnswers = [];
                try {
                    const res = await fetch(`${API_URL}/api/onboarding/peer-help?subject=${subject}&week=${week}&student_id=${studentId}`, { 
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (res.ok) {
                        const result = await res.json();
                        peersAnswers = result.data || []; 
                    }
                } catch (apiErr) {
                    console.warn("API Bantuan Teman belum merespon. Menggunakan Fallback.");
                }

                const matchingAnswers = peersAnswers.filter(pa => currentQuestionIds.includes(pa.question_id));

                if (matchingAnswers.length > 0) {
                    const pick = matchingAnswers[Math.floor(Math.random() * matchingAnswers.length)];
                    friendName = pick.student_name;
                    friendAnswerRaw = pick.answer;
                    targetQuestionId = pick.question_id;
                } else {
                    friendName = "Robot Teman";
                    targetQuestionId = currentQuestionIds[Math.floor(Math.random() * currentQuestionIds.length)];
                    friendAnswerRaw = "B"; 
                }
            } else {
                const dummyNames = ["Budi", "Aisyah", "Andi", "Reza"];
                friendName = dummyNames[Math.floor(Math.random() * dummyNames.length)];
                targetQuestionId = currentQuestionIds[0];
                friendAnswerRaw = "A";
            }

            if (!targetQuestionId) targetQuestionId = currentQuestionIds[0];

            const targetQObj = questions.find(q => q.id === targetQuestionId);
            const qIndexUI = questions.indexOf(targetQObj) + 1;
            const qType = targetQObj ? (targetQObj.type || 'pilgan') : 'pilgan';

            // Format Pesan
            let finalMsg = "";
            if (qType === 'pilgan') {
                const labelAns = (targetQObj && targetQObj.options) ? (targetQObj.options[friendAnswerRaw] || friendAnswerRaw) : friendAnswerRaw;
                finalMsg = `Kalo aku nomor ${qIndexUI} diisi sama jawaban "${labelAns}"!`;
            } else if (qType === 'tf') {
                const tfText = friendAnswerRaw === 'A' ? 'BENAR' : 'SALAH';
                finalMsg = `Pstt! Nomor ${qIndexUI} diisi ${tfText} aja!`;
            } else if (qType === 'drag') {
                const parts = friendAnswerRaw.split(',').map(k => (targetQObj && targetQObj.options) ? (targetQObj.options[k] || k) : k);
                finalMsg = `Nomor ${qIndexUI} urutannya: [ ${parts.join(', ')} ]`;
            } else {
                finalMsg = `Aku nomor ${qIndexUI} jawabannya ${friendAnswerRaw} deh kayaknya.`;
            }

            document.getElementById('cfName').innerText = friendName;
            document.getElementById('cfMessage').innerText = finalMsg;
            document.getElementById('cfAvatar').innerText = friendName.substring(0, 1).toUpperCase();
            
            const overlay = document.getElementById('callFriendOverlay');
            overlay.classList.remove('translate-x-full');
            
            setTimeout(() => {
                overlay.classList.add('translate-x-full');
            }, 7000); 

        } catch (e) {
            console.error("Gagal menjalankan animasi teman:", e);
        }
    };

