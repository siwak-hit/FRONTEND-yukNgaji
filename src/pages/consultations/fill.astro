    // [I] AUTO-BUY GACHA: kalau koin > 200 dan belum beli item apa pun, "dipaksa"
    //     gacha 1 item dulu. Hanya item yang didukung endpoint /api/shop/buy.
    const GACHA_POOL = ['item_double_score', 'item_perisai', 'item_extra_life'];

    const buyItemDirect = async (pick) => {
        const price = getPrice(pick);
        try {
            if (!isPreview) {
                const res = await fetch(`${API_URL}/api/shop/buy`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ student_id: studentId, item_type: pick, week: parsedWeek })
                });
                const data = await res.json();
                if (data.status !== 'success') return false;
                studentWallet = data.data.poin; studentInventory[pick] = data.data[pick];
            } else {
                studentWallet = Math.max(0, studentWallet - price);
                studentInventory[pick] = (studentInventory[pick] || 0) + 1;
            }
            boughtItemsThisSession[pick] = true;
            updateShopUI();
            return true;
        } catch (e) { return false; }
    };

    // Animasi reel: strip item geser horizontal (perlahan → cepat → perlahan)
    // lalu berhenti tepat di item pemenang di bawah penanda tengah.
    const spinGacha = (winner) => new Promise(resolve => {
        const reel = document.getElementById('gachaReel');
        const vp = document.getElementById('gachaViewport');
        const TOTAL = 80, WIN_INDEX = 8; // pemenang dekat awal → ruang geser kiri→kanan panjang

        const cards = [];
        for (let i = 0; i < TOTAL; i++) {
            cards.push(i === WIN_INDEX ? winner : GACHA_POOL[Math.floor(Math.random() * GACHA_POOL.length)]);
        }
        reel.innerHTML = cards.map((k, i) => `
            <div class="gacha-card gc-${k}${i === WIN_INDEX ? ' is-winner' : ''}">
                <span class="text-4xl leading-none">${ITEM_DB[k].icon}</span>
                <span class="gacha-card-name">${ITEM_DB[k].name}</span>
            </div>`).join('');

        // posisi awal: strip digeser jauh ke kiri (pemenang di luar layar kiri)
        reel.style.transition = 'none';
        reel.style.transform = 'translateX(0px)';

        requestAnimationFrame(() => {
            const vpW = vp.offsetWidth;
            const stripW = reel.scrollWidth;
            const winCard = reel.children[WIN_INDEX];
            const targetAbs = winCard.offsetLeft + winCard.offsetWidth / 2;
            const end = vpW / 2 - targetAbs;          // posisi akhir: pemenang pas di tengah
            const minT = vpW - stripW;                // batas agar viewport tetap terisi
            let start = end - 7200;                    // mulai lebih ke kiri → bergerak ke kanan
            if (start < minT) start = minT;
            reel.style.transform = `translateX(${start}px)`;

            requestAnimationFrame(() => {
                // ease-in-out: pelan di awal, cepat di tengah, melambat & berhenti
                reel.style.transition = 'transform 4.8s cubic-bezier(0.42, 0, 0.18, 1)';
                reel.style.transform = `translateX(${end}px)`;
            });
        });

        let done = false;
        const finish = () => {
            if (done) return; done = true;
            reel.removeEventListener('transitionend', finish);
            const winCard = reel.children[WIN_INDEX];
            if (winCard) { winCard.classList.remove('gacha-pop'); void winCard.offsetWidth; winCard.classList.add('gacha-pop'); }
            resolve();
        };
        reel.addEventListener('transitionend', finish);
        setTimeout(finish, 5200); // fallback kalau transitionend tak terpicu
    });

    // Langsung pakai item hasil gacha (bukan cuma masuk inventory).
    const autoUseGachaItem = (key) => {
