        if (ok) autoUseGachaItem(winner);

        document.getElementById('gachaWinIcon').textContent = item.icon;
        document.getElementById('gachaWinName').textContent = item.name;
        document.getElementById('gachaWinPrice').textContent = ok ? `💰 -${price} poin` : 'Gratis (gagal memotong poin)';
