    window.closeExtReq = () => {
        const modal = document.getElementById('modalExtReq');
        const box = document.getElementById('modalExtReqBox');
        modal.classList.replace('opacity-100', 'opacity-0');
        box.classList.replace('scale-100', 'scale-95');
        setTimeout(() => { modal.classList.replace('flex', 'hidden'); try { window.close(); } catch (e) {} }, 250);
    };

    window.submitExtensionRequest = async () => {
        const reason = document.getElementById('extReqReason').value.trim();
        if (!reason) { window.showToast?.('warning', 'Tulis Alasan', 'Isi dulu alasan kenapa kamu telat ya.'); return; }

        const btn = document.getElementById('btnSendExtReq');
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Mengirim...';

        try {
            const res = await fetch(`${API_URL}/api/onboarding/pr-extension-request`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id: studentId, subject, week, reason, kind: window.extReqKind || 'late' })
            });

            if (!res.ok) throw new Error('Gagal');

            // Untuk extra_time (waktu habis di tengah), tandai sudah mengajukan agar tidak dobel.
            if (window.extReqKind === 'extra_time') window.extRequestAlreadyMade = true;

            const modal = document.getElementById('modalExtReq');
            const box = document.getElementById('modalExtReqBox');
            box.innerHTML = `
                <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border-4 border-white shadow-lg">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h2 class="text-xl font-black text-gray-800 text-center mb-1">Permintaan Terkirim!</h2>
                <p class="text-xs text-gray-500 font-bold text-center mb-5">Tunggu Kak Aziz menyetujui perpanjanganmu. Nanti kamu akan dikasih link khusus untuk lanjut dari soal terakhir. Kalau terlambat lagi, kamu bisa minta lagi tapi potongan nilai bertambah.</p>
                <button onclick="closeExtReq()" class="w-full py-4 bg-emerald-600 text-white font-black rounded-2xl shadow-lg active:scale-95 transition-all text-sm uppercase tracking-widest">Oke, Mengerti</button>`;
        } catch (e) {
            window.showToast?.('danger', 'Gagal', 'Permintaan tidak terkirim. Coba lagi ya.');
            btn.disabled = false;
            btn.innerHTML = original;
        }
    };

    const startTest = async (isNewSession = true) => {

        // [FIX BUG] Logika Pengecekan Deadline & Dispensasi disamakan dengan index.astro
        // Catatan: fetch dijalankan utk SEMUA sesi PR (baru/lanjut) supaya durasi manual (2.1)
        // selalu terbaca; tapi penghentian karena deadline hanya berlaku untuk sesi BARU.
        if (isPRMode) {
            try {
                const res = await fetch(`${API_URL}/api/onboarding/pr-locks-detail?subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` }});
                const prDetail = await res.json();

                const prData = Array.isArray(prDetail.data) ? prDetail.data[0] : prDetail.data;

                // [2.1] Pakai durasi manual dari guru kalau ada (detik). Kalau tidak, default sistem.
                if (prData && prData.duration_seconds && prData.duration_seconds > 0) {
                    totalDurationSeconds = prData.duration_seconds;
                    if (isNewSession) timeLeft = totalDurationSeconds;
                }

                // [2.7] Cek status permohonan murid (sekali pakai). Dipakai utk:
                // - kunci tombol "minta gratis" di modal waktu habis
                // - bedakan "menunggu guru" vs "kesempatan habis"
                let myReq = null;
                try {
                    const rq = await fetch(`${API_URL}/api/onboarding/pr-extension-mine?student_id=${studentId}&subject=${subject}&week=${week}`, { headers: { 'Authorization': `Bearer ${token}` }});
                    if (rq.ok) myReq = (await rq.json()).data;
                } catch(e) {}
                window.extRequestAlreadyMade = !!myReq;

                // Parse data dispensasi (dipakai utk sesi BARU & LANJUT)
                const now = new Date();
                let extRecord = null;
                if (prData) {
                    let extendedList = prData.extended_students;
                    try { while (typeof extendedList === 'string') extendedList = JSON.parse(extendedList); } catch(e) {}
                    if (!Array.isArray(extendedList)) extendedList = [];
                    extRecord = extendedList.find(ext => ext.student_id === studentId) || null;
                }
                const dispActive = !!(extRecord && new Date(extRecord.until) > now);
                // Kunci sekali-pakai per pemberian dispensasi (cegah reset waktu berkali-kali).
                const consumeKey = extRecord ? `extused_${studentId}_${subject}_${week}_${extRecord.until}` : null;

                if (isNewSession) {
                    if (extRecord) {
                        // KASUS 1: PUNYA DISPENSASI
                        if (!dispActive) {
                            // Dispensasi sudah habis lagi → boleh minta perpanjangan baru
                            window.extReqKind = 'late';
                            openExtReq('Batas waktu perpanjanganmu sudah habis lagi. Minta perpanjangan baru ke Kak Aziz ya! (Ingat: potongan nilai bertambah setiap kali)');
                            return; // STOP!
                        }
                        // Dispensasi masih aktif → tandai sudah dipakai (sesi baru pakai timer fresh).
                        if (consumeKey) localStorage.setItem(consumeKey, '1');
                        const pct = extRecord.penalty_percent || 10;
                        window.showToast?.('info', 'Dispensasi Aktif', extRecord.penalty
                            ? `Kamu telat, tapi dapet akses. Ingat, nilaimu akan dipotong ${pct}%!`
                            : 'Kamu dapat perpanjangan waktu. Semangat ngerjainnya!');
                    } else if (prData && prData.deadline_at && now > new Date(prData.deadline_at)) {
                        // KASUS 2: GAK PUNYA DISPENSASI & lewat deadline
                        if (myReq && myReq.status === 'pending') {
                            window.openInfoLocked('pending');
                        } else {
                            // Belum ada permintaan ATAU sudah pernah granted (dan terlambat lagi) → minta baru
                            window.extReqKind = 'late';
                            openExtReq('Batas waktu PR ini sudah lewat. Tulis alasanmu untuk minta perpanjangan ke Kak Aziz ya.');
                        }
                        return; // STOP!
                    }
                } else {
                    // SESI LANJUT (resume). Kalau timer sudah habis tapi ADA dispensasi aktif
                    // yang belum dipakai → kasih waktu fresh SEKALI, lanjut dari checkpoint terakhir.
                    // [2.2] Ini bikin link lama pun otomatis "hidup lagi" setelah guru memberi izin.
                    const savedEnd = parseInt(localStorage.getItem(timeKey));
                    const expired = !savedEnd || (savedEnd - Date.now()) <= 0;
                    if (expired && dispActive && consumeKey && !localStorage.getItem(consumeKey)) {
                        timeLeft = totalDurationSeconds;
                        localStorage.setItem(timeKey, Date.now() + (timeLeft * 1000));
                        localStorage.setItem(consumeKey, '1');
                        window.showToast?.('info', 'Waktu Tambahan Aktif', 'Kamu dapat waktu baru. Lanjutkan dari soal terakhirmu ya!');
                    }
                    // Kalau tetap habis (tanpa dispensasi aktif), modal "waktu habis" akan muncul
                    // otomatis lewat updateTimerUI() → handleTimeUp() di bawah.
                }
            } catch(e) { console.log("Gagal cek deadline", e); }
        }

        if (isNewSession) {
            window.isMiawHidden = document.getElementById('toggleHideMiaw')?.checked || false;
            if (window.isMiawHidden) sessionStorage.setItem(`hide_miaw_${studentId}_${subject}_${week}`, 'true');
        } else {
            window.isMiawHidden = sessionStorage.getItem(`hide_miaw_${studentId}_${subject}_${week}`) === 'true';
        }

        const shopWrapper = document.getElementById('shopDrawerWrapper');
        if (shopWrapper) { shopWrapper.style.transform = 'translateY(100%)'; shopWrapper.style.opacity = '0'; setTimeout(() => { shopWrapper.style.display = 'none'; }, 500); }
        document.getElementById('testContent').classList.remove('hidden');

        const header = document.getElementById('mainHeader');
        header.classList.add('-translate-y-full', 'opacity-0');
        setTimeout(() => {
            header.classList.add('hidden');
            header.classList.remove('sticky');
        }, 500);

        document.getElementById('floatingTimer').classList.replace('hidden', 'flex');

        isQuizStarted = true; updateShopUI(); updateTimerUI();
        warned30 = false; warned10 = false;

        if (window.MiawMascot) {
            if (window.isMiawHidden) {
                // Preventive Lottie Download: Nol KB tersedot jika disembunyikan
                window.MiawMascot.show = () => {};
                window.MiawMascot.say = () => {};
                const mascotContainer = document.getElementById('mascotContainer') || document.querySelector('.mascot-wrapper');
                if (mascotContainer) mascotContainer.style.display = 'none';
            } else {
                // Jangan pakai await! Biar sistem tidak berhenti nunggu kucing selesai didownload
                window.MiawMascot.init({
                    mode: 'peek',
                    animations: {
                        PEEK_IN: { path: '/CAT LOTTIE/SHOWING CAT.json', loop: false, speed: 1.0, lottieDuration: 3000 },
                        PEEK_OUT: { path: '/CAT LOTTIE/BACK TO HIDDEN.json', loop: false, speed: 1.2, lottieDuration: 2000 },
                        IDLE: { path: '/CAT LOTTIE/IDDLE SHOW.json', loop: true, speed: 1.0 },
                        CLICK: { path: '/CAT LOTTIE/BACK TO HIDDEN.json', loop: false, speed: 1.0, lottieDuration: 1500 }
                    },
                    texts: {
                        entering: () => `Haloo <strong>${currentStudentName}</strong>! Semangat ngerjain tugasnya ya!`,
                        idleArrive: () => {
                            const menit = Math.floor(timeLeft / 60);
                            if (menit > 0) return `Miaw! Sisa waktu tinggal <strong>${menit} menit</strong> lagi! Jangan sampai kehabisan.`;
                            return `Gawat <strong>${currentStudentName}</strong>! Waktunya kurang dari semenit, buruan!`;
                        },
                        idlePhrases: [
                            () => {
                                if (timeLeft <= 10) return `AYO CEPETAN <strong>${currentStudentName}</strong>!!!! Tinggal ${timeLeft} detik!`;
                                if (timeLeft <= 30) return `Awas <strong>${currentStudentName}</strong>! Waktunya tinggal ${timeLeft} detik lagi!`;
                                const menit = Math.floor(timeLeft / 60);
                                if (menit > 0 && menit <= 2) return `Ayo cepetan <strong>${currentStudentName}</strong>! Waktunya sisa <strong>${menit} menitan</strong> lho!`;

                                if (window.isDoubleScoreActive) return `Asiik! Sihir <strong>Double Poin ✨</strong> lagi aktif! Maksimalkan nilaimu <strong>${currentStudentName}</strong>!`;
                                if (window.isShieldActive) return `Miaw! Tenang aja <strong>${currentStudentName}</strong>, <strong>Perisai 🛡️</strong> kamu siap menahan serangan!`;
                                if (studentInventory.item_extra_life > 0) return `Kamu pegang <strong>Extra Life 💖</strong>! Santai aja <strong>${currentStudentName}</strong>, nanti bisa perbaiki 1 yang salah.`;
                                return `Fokus <strong>${currentStudentName}</strong>! Teliti lagi jawabannya ya!`;
                            },
                            () => `Miaw! <strong>${currentStudentName}</strong>, kalau bingung dilewatin dulu aja!`,
                            () => window.isShieldActive ? `Poinmu aman <strong>${currentStudentName}</strong> karena ada <strong>Perisai 🛡️</strong>!` : `Hati-hati <strong>${currentStudentName}</strong>, koinmu bisa dicuri kalau nggak beli <strong>Perisai 🛡️</strong>!`,
                            () => {
                                const answeredBlocks = [];
                                document.querySelectorAll('.question-block').forEach((block, index) => {
                                    const qId = block.dataset.id; const type = block.dataset.type || 'pilgan'; let answerText = null;
                                    if (type === 'pilgan' || type === 'tf') {
                                        const checked = block.querySelector(`input[name="q-${qId}"]:checked`);
                                        if (checked) { if (type === 'tf') answerText = checked.value === 'A' ? 'BENAR' : 'SALAH'; else { const span = checked.nextElementSibling; if (span) answerText = span.innerText; } }
                                    } else if (type === 'drag') {
                                        const slots = block.querySelectorAll('.blank-slot'); let answered = []; slots.forEach(s => { if (s.innerText) answered.push(s.innerText); }); if (answered.length > 0) answerText = answered.join(' ');
                                    } else if (type === 'urutan') {
                                        const val = document.getElementById(`ans-${qId}`)?.value; if (val && val !== '[]' && val !== '') answerText = "susunan puzzle yang itu";
                                    }
                                    if (answerText) answeredBlocks.push({ nomor: index + 1, jawaban: answerText });
                                });
                                if (answeredBlocks.length > 0) {
                                    const randomPick = answeredBlocks[Math.floor(Math.random() * answeredBlocks.length)];
                                    let textJawaban = randomPick.jawaban; if (textJawaban.length > 25) textJawaban = textJawaban.substring(0, 25) + '...';
                                    const doubtPhrases = [
                                        `Hah masa nomor <strong>${randomPick.nomor}</strong> jawabannya <strong>"${textJawaban}"</strong> sih... coba cek lagi deh <strong>${currentStudentName}</strong>!`,
                                        `Miaw! Yakin nomor <strong>${randomPick.nomor}</strong> itu <strong>"${textJawaban}"</strong>? Kayaknya ada yang aneh deh...`,
                                        `Psst <strong>${currentStudentName}</strong>, masa nomor <strong>${randomPick.nomor}</strong> jawabannya <strong>"${textJawaban}"</strong>? Diteliti lagi coba!`
                                    ];
                                    return doubtPhrases[Math.floor(Math.random() * doubtPhrases.length)];
                                }
                                return `Ayo mulai kerjain <strong>${currentStudentName}</strong>! Miaw tungguin nih!`;
                            }
                        ]
                    }
                }).then(() => {
                    setTimeout(() => window.MiawMascot.show(), 500);
                }).catch(err => console.warn("Gagal inisialisasi kucing:", err));
            }
        }

        if (isNewSession) localStorage.setItem(timeKey, Date.now() + (timeLeft * 1000));
        startCountdown();
        // [Gap 1] Buat/dorong checkpoint ke server begitu sesi mulai (qids + waktu + posisi).
        if (isPRMode && !isPreview) window.syncDraftToServer?.();
    };

    // [2.3] Countdown diekstrak jadi fungsi sendiri supaya bisa di-restart
    // setelah murid membeli/mendapat tambahan waktu saat waktu sudah habis.
    let bullyCheckCounter = 0;
    const startCountdown = () => {
        if (timerInterval) clearInterval(timerInterval);
        if (timeLeft <= 0) return;
        bullyCheckCounter = 0;

        timerInterval = setInterval(() => {
            // [2.4] Saat dibully timer dibekukan: jangan kurangi waktu & jangan trigger habis.
            if (isTimerPaused) {
                updateTimerUI();
                return;
            }
            timeLeft = Math.floor((localStorage.getItem(timeKey) - Date.now()) / 1000);
            updateTimerUI();
            updateQuickTimeOffer();

            // =======================================================
            // [FIX REAL-TIME BULLY] Cek notifikasi setiap 5 detik
            // =======================================================
            bullyCheckCounter++;
            if (!isPreview && bullyCheckCounter >= 5) {
                // Cek hanya jika animasi TIDAK sedang jalan
                if (!isBullyAnimationRunning) {
                    executeBullyPolling();
                }
                bullyCheckCounter = 0;
            }
            // =======================================================

            if (timeLeft === 30 && !warned30) {
                warned30 = true;
                if(window.MiawMascot) window.MiawMascot.say('large', `Awas <strong>${currentStudentName}</strong>! Waktu tinggal <strong>30 detik</strong> lagi!`, null, 'warning', 5000);
            }
            if (timeLeft === 10 && !warned10) {
                warned10 = true;
                if(window.MiawMascot) window.MiawMascot.say('large', `AYO CEPETAN <strong>${currentStudentName}</strong>!!!! Tinggal 10 detik!`, null, 'warning', 5000);
            }

            if (window.pendingCallFriend) {
                window.pendingCallFriendCount++;
                // Tunggu minimal 5 detik, setelah itu ada chance 30% per detik dia nongol
                if (window.pendingCallFriendCount >= 5 && Math.random() < 0.3) {
                    window.pendingCallFriend = false; // Matikan timer pencariannya
                    window.triggerCallFriend();
                }
            }

            if (isPreview && localStorage.getItem('sim_bully_pending') === 'true') {
                const maxTime = parsedWeek === 1 ? 105 : 180;
                if (timeLeft < (maxTime - 5) && Math.random() < 0.2) {
                    localStorage.removeItem('sim_bully_pending');
                    window.playBullyAnimation('Si Udin (Simulasi)');
                }
            }

            if (timeLeft <= 0) {
                timeLeft = 0;
                finalTimeTaken = totalDurationSeconds || DEFAULT_DURATION;
                clearInterval(timerInterval);
                if (!isEvaluatingExtraLife) handleTimeUp();
            }
        }, 1000);
    };

    window.executeBullyPolling = async () => {
        try {
            const res = await fetch(`${API_URL}/api/onboarding/check-bully-status?student_id=${studentId}&t=${Date.now()}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await res.json();

            if (data.status === 'success' && data.trigger_bully === true) {
                const pelaku = data.attacker_name || "Seseorang";

                // Jika user punya perisai
                if (window.isShieldActive) {
                    // [PERBAIKAN] Hancurkan perisainya setelah menahan
                    window.showToast?.('info', 'Perisai Hancur!', `${pelaku} mencoba menjahilimu. Perisaimu menahannya namun kini hancur!`);
                    window.isShieldActive = false;
                    boughtItemsThisSession.item_perisai = false; // Boleh beli perisai lagi
                    updateShopUI();
                    return;
                }

                playBullyAnimation(pelaku);
            }
        } catch (e) { console.warn("Gagal polling bully"); }
    };

    // ==========================================
    // 7. TOKO & GAMIFIKASI
    // ==========================================
    window.toggleShopDrawer = () => {
        if (!isAppReady) return;
        const inner = document.getElementById('shopDrawerInner'); const icon = document.getElementById('shopDrawerIcon'); const btn = document.getElementById('btnToggleDrawer');
        if (inner.classList.contains('translate-y-[calc(100%-40px)]')) {
            inner.classList.replace('translate-y-[calc(100%-40px)]', 'translate-y-0'); icon.classList.replace('fa-store', 'fa-chevron-down'); btn.classList.replace('h-[40px]', 'h-[48px]'); btn.classList.add('bg-indigo-800');
            // Bonus pemula HANYA muncul saat: pertemuan pertama (week 1), belum pernah klaim,
            // dan toko dibuka untuk pertama kalinya. (Tidak lagi pakai localStorage.)
            if (parsedWeek === 1 && !hasClaimedBonusGlobal) setTimeout(() => document.getElementById('modalWelcomeBonus').classList.replace('hidden', 'flex'), 300);
        } else {
            inner.classList.replace('translate-y-0', 'translate-y-[calc(100%-40px)]'); icon.classList.replace('fa-chevron-down', 'fa-store'); btn.classList.replace('h-[48px]', 'h-[40px]'); btn.classList.remove('bg-indigo-800');
        }
    };

    window.declineBonus = () => { hasClaimedBonusGlobal = true; document.getElementById('modalWelcomeBonus').classList.replace('flex', 'hidden'); };
    window.acceptBonus = async () => {
        const btn = document.getElementById('btnAcceptBonus'); btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>'; btn.disabled = true;
        try {
            if (isPreview) {
                await new Promise(r => setTimeout(r, 600)); studentWallet += 100; hasClaimedBonusGlobal = true; updateShopUI(); document.getElementById('modalWelcomeBonus').classList.replace('flex', 'hidden'); window.showToast?.('success', 'Bonus Cair!', '100 Koin gratis berhasil ditambahkan ke dompetmu.'); return;
            }
            const res = await fetch(`${API_URL}/api/shop/claim-bonus`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ student_id: studentId }) });
            const data = await res.json();
            if (data.status === 'success') {
                studentWallet = data.data.poin; hasClaimedBonusGlobal = true; updateShopUI(); document.getElementById('modalWelcomeBonus').classList.replace('flex', 'hidden'); window.showToast?.('success', 'Bonus Cair!', '100 Koin gratis!');
            } else throw new Error(data.message);
        } catch (error) {
            if (error.message.includes('sudah') || error.message.includes('pernah')) { hasClaimedBonusGlobal = true; document.getElementById('modalWelcomeBonus').classList.replace('flex', 'hidden'); }
            else { window.showToast?.('danger', 'Gagal', error.message); btn.innerText = 'Ambil Poinnya!'; btn.disabled = false; }
        }
    };

    window.activateItem = (itemKey) => {
        if (itemKey === 'item_perisai') {
            window.showConfirm('Gunakan Perisai?', 'Gunakan Perisai sekarang? (Hanya berlaku sampai jam 12 malam ini)', () => {
                window.isShieldActive = true;
                studentInventory.item_perisai -= 1;
                boughtItemsThisSession.item_perisai = true;
                updateShopUI();
                window.showToast?.('info', 'Perisai Aktif', 'Layar birumu menandakan Perisai aktif hingga malam ini!');
                if (!isPreview) fetch(`${API_URL}/api/shop/use-item`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ student_id: studentId, item_type: 'item_perisai' }) }).catch(e=>e);
            });
        }
        // [PERBAIKAN] Tambahkan logika item_serang di sini
        else if (itemKey === 'item_serang') {
            currentAttackMode = 'serang';
            openAttackModal();
        }
        else if (itemKey === 'item_double_score') {
            window.isDoubleScoreActive = true;
            studentInventory.item_double_score -= 1; boughtItemsThisSession.item_double_score = true; updateShopUI(); window.showToast?.('success', 'Sihir Aktif', 'Double Poin otomatis bekerja di akhir!');
        } else if (itemKey === 'item_double_coin') {
            if (window.isTripleCoinActive) {
                window.isTripleCoinActive = false;
                studentInventory.item_triple_coin += 1;
                window.showToast?.('warning', 'Switch Item', 'Triple Koin dimatikan. Double Koin diaktifkan!');
            } else {
                window.showToast?.('success', 'Sihir Aktif', 'Koinmu akan di-double di akhir!');
            }
            window.isDoubleCoinActive = true;
            studentInventory.item_double_coin -= 1;
            boughtItemsThisSession.item_double_coin = true;
            updateShopUI();
        } else if (itemKey === 'item_triple_coin') {
            if (window.isDoubleCoinActive) {
                window.isDoubleCoinActive = false;
                studentInventory.item_double_coin += 1;
                window.showToast?.('warning', 'Switch Item', 'Double Koin dimatikan. Triple Koin diaktifkan!');
            } else {
                window.showToast?.('success', 'Sihir Aktif', 'Jackpot! Koinmu akan dikali 3 di akhir!');
            }
            window.isTripleCoinActive = true;
            studentInventory.item_triple_coin -= 1;
            boughtItemsThisSession.item_triple_coin = true;
            updateShopUI();
        } else if (itemKey === 'item_diskon') {
            window.isDiscountActive = true;
            studentInventory.item_diskon -= 1; boughtItemsThisSession.item_diskon = true; updateShopUI(); window.showToast?.('success', 'Sihir Aktif', 'Semua harga di Toko dipotong 50%!');
        }
