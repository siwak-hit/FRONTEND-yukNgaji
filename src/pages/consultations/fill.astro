    window.closeInfoLocked = () => {
        const modal = document.getElementById('modalInfoLocked');
        const box = document.getElementById('modalInfoLockedBox');
        modal.classList.replace('opacity-100', 'opacity-0');
        box.classList.replace('scale-100', 'scale-95');
