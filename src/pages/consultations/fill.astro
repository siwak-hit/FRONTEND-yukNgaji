    .urutan-horizontal-list { display: flex !important; flex-direction: row !important; flex-wrap: wrap !important; justify-content: center !important; align-items: center !important; gap: 12px !important; width: 100%; min-height: 60px; }

    .sortable-ghost { opacity: 0.1 !important; filter: grayscale(1); transform: scale(0.9); }
    .sortable-drag { cursor: grabbing !important; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1) !important; transform: rotate(5deg) scale(1.15) !important; z-index: 100 !important; animation: wiggle 0.3s infinite ease-in-out; }
    @keyframes wiggle { 0% { transform: rotate(5deg) scale(1.15); } 50% { transform: rotate(-3deg) scale(1.15); } 100% { transform: rotate(5deg) scale(1.15); } }
