---
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
import PhotoBooth from '../../components/PhotoBooth.astro';
import Mascot from '../../components/Mascot.astro';
---

<Layout title="Sesi Pengerjaan - yukNgaji">
    <div class="min-h-screen flex flex-col overflow-hidden relative" style="background-color: var(--parchment);">

        <header id="mainHeader" class="sticky top-0 px-5 py-3 backdrop-blur-md border-b z-[80] flex items-center justify-between transition-all duration-500 transform translate-y-0" style="background-color: rgba(255,255,255,0.92); border-color: var(--hairline);">
            <div class="flex items-center gap-2.5">
                <div class="avatar w-8 h-8 text-xs" id="headerInitials">--</div>
                <h2 class="section-title text-sm hidden sm:block" id="headerName">Memuat...</h2>
            </div>

            <div id="headerTimerDisplay" class="absolute left-1/2 -translate-x-1/2 px-5 py-1.5 rounded-full font-mono font-bold text-xl transition-all" style="background-color: var(--canvas); color: var(--ink); border: 1px solid var(--hairline); box-shadow: var(--shadow-soft);">
                <i class="fa-solid fa-stopwatch mr-1" id="headerTimerIcon" style="color: var(--accent);"></i> <span id="headerTimerText">--:--</span>
            </div>

            <a href="javascript:void(0)" onclick="handleBack()" class="btn-soft !py-1.5 !px-3 text-xs" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Keluar</a>
        </header>

        <div id="floatingTimer" onclick="toggleFloatingTimer()" class="fixed top-6 right-6 z-[250] hidden flex-row items-center bg-white rounded-full shadow-[0_5px_15px_rgba(0,0,0,0.1)] border border-gray-100 cursor-pointer transition-all duration-300 p-1 hover:scale-105">
            <div class="relative w-9 h-9 flex items-center justify-center rounded-full flex-shrink-0" id="timerRing" style="background: conic-gradient(#16a34a 100%, #f3f4f6 0%);">
                <div class="w-[26px] h-[26px] bg-white rounded-full flex items-center justify-center absolute z-10">
                    <i class="fa-solid fa-stopwatch text-green-600 text-[11px] transition-colors" id="floatTimerIcon"></i>
                </div>
            </div>
            <div id="timerTextContainer" class="overflow-hidden transition-all duration-300 w-[50px] ml-1 flex items-center justify-center">
                <span id="timerTextFloat" class="font-mono font-black text-gray-800 text-sm">--:--</span>
            </div>
        </div>

        <div id="floatingItems" onclick="toggleFloatingItems()" class="fixed top-[4.5rem] right-6 z-[250] hidden flex-row-reverse items-center bg-white rounded-full shadow-[0_5px_15px_rgba(0,0,0,0.1)] border border-gray-100 cursor-pointer transition-all duration-300 p-1 hover:scale-105">
            <div class="relative w-9 h-9 flex items-center justify-center rounded-full flex-shrink-0 bg-indigo-50 border border-indigo-100 z-10">
                <i class="fa-solid fa-box text-indigo-500 text-xs transition-transform" id="floatItemsIcon"></i>
            </div>
            <div id="itemsTextContainer" class="overflow-hidden transition-all duration-300 max-w-0 opacity-0 flex items-center justify-end gap-1.5 h-9">
            </div>
        </div>

        <!-- Penawaran cepat beli waktu saat sisa < 20 detik (nyambung di bawah capsule timer) -->
        <div id="quickTimeOffer" class="fixed right-6 z-[245] hidden">
            <button id="quickTimeBtn" onclick="buyQuickTime()" class="w-full flex items-center justify-center gap-2 bg-amber-500 text-white px-3 py-2 rounded-b-2xl rounded-t-none border border-t-0 border-amber-400 active:opacity-90 transition-colors">
                <i class="fa-solid fa-bolt text-sm"></i>
                <div class="text-left leading-tight">
                    <div class="text-[11px] font-black">+30 Detik</div>
                    <div class="text-[9px] font-bold opacity-90">💰 <span id="quickTimePrice">100</span> koin</div>
                </div>
            </button>
        </div>

        <div id="shopDrawerWrapper" class="fixed bottom-0 left-0 w-full z-[350] flex flex-col items-center pointer-events-none overflow-hidden transition-all duration-500">
            <div id="shopDrawerInner" class="w-full max-w-md flex flex-col items-center transform translate-y-[calc(100%-40px)] transition-transform duration-500 ease-out">

                <button id="btnToggleDrawer" onclick="toggleShopDrawer()" class="h-[40px] pointer-events-auto text-white px-8 rounded-t-2xl flex items-center justify-center gap-2 active:scale-[0.98] transition-all outline-none" style="background-color: #2563eb; box-shadow: 0 -6px 18px rgba(37,99,235,0.32);">
                    <i id="shopDrawerIcon" class="fa-solid fa-store transition-transform duration-300"></i>
                    <span class="font-semibold text-[11px] tracking-widest uppercase">Toko Item</span>
                </button>

                <div id="shopDrawerContent" class="pointer-events-auto w-full bg-white/95 backdrop-blur-xl rounded-t-[2rem] p-6 shadow-[0_-10px_40px_rgba(0,0,0,0.2)] border-t border-gray-200">

                    <!-- SWITCH SIMULASI BULLY -->
                    <div id="simBullyToggle" class="hidden rounded-[var(--r-lg)] p-3 mb-4 flex justify-between items-center" style="background-color: #f3eafe;">
                        <div class="flex items-center gap-2">
                            <div class="icon-chip-sm" style="background-color:#fff; color:#7c3aed;"><i class="fa-solid fa-ghost"></i></div>
                            <span class="text-[11px] font-semibold uppercase tracking-widest" style="color:#6d28d9;">Simulasi Dibully</span>
                        </div>
                        <button onclick="triggerSimBully()" class="btn !py-1.5 !px-4 text-[10px]" style="background-color:#7c3aed; color:#fff; border-radius: var(--r-pill);">Coba</button>
                    </div>

                    <div class="flex justify-between items-center mb-4">
                        <h3 class="section-title text-lg"><i class="fa-solid fa-basket-shopping mr-1" style="color: var(--accent);"></i> Pasar Sihir</h3>
                        <div class="badge badge-warning !px-3 !py-1.5 !text-sm">
                            <span class="text-[10px] font-semibold uppercase tracking-wider">Saldo</span>
                            <span>💰</span>
                            <span id="currentPoinDisplay" class="font-bold">0</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-2 mb-2 pt-2 px-2 pb-4 overflow-y-auto max-h-52 custom-scrollbar">

                        <button id="btn-shop-item_double_score" onclick="handleShopClick('item_double_score')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-indigo-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">✨</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Double<br>Nilai</span>
                        </button>
                        <button id="btn-shop-item_serang" onclick="handleShopClick('item_serang')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-red-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">⚔️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Serang<br>Teman</span>
                        </button>
                        <button id="btn-shop-item_perisai" onclick="handleShopClick('item_perisai')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-blue-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🛡️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Perisai<br>Aman</span>
                        </button>
                        <button id="btn-shop-item_extra_life" onclick="handleShopClick('item_extra_life')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-pink-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">💖</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Extra<br>Life</span>
                        </button>

                        <button id="btn-shop-item_tambah_waktu" onclick="handleShopClick('item_tambah_waktu')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-teal-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">⏳</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Tambah<br>Waktu</span>
                        </button>
                        <button id="btn-shop-item_double_coin" onclick="handleShopClick('item_double_coin')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-amber-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">💰</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Double<br>Koin</span>
                        </button>
                        <button id="btn-shop-item_triple_coin" onclick="handleShopClick('item_triple_coin')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-amber-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🤑</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Triple<br>Koin</span>
                        </button>
                        <button id="btn-shop-item_bullying" onclick="handleShopClick('item_bullying')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-purple-50 active:scale-95 transition-all group relative">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">😈</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Bully<br>Teman</span>
                        </button>

                        <button id="btn-shop-item_diskon" onclick="handleShopClick('item_diskon')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-green-50 active:scale-95 transition-all group relative col-span-2 sm:col-span-1">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">🏷️</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Kupon<br>Diskon</span>
                        </button>
                        <button id="btn-shop-item_call_friend" onclick="handleShopClick('item_call_friend')" class="h-20 bg-gray-50 rounded-xl border border-gray-100 flex flex-col items-center justify-center hover:bg-blue-50 active:scale-95 transition-all group relative col-span-2 sm:col-span-1">
                            <span class="text-2xl mb-1 drop-shadow-md group-hover:scale-110 transition-transform">📞</span>
                            <span class="text-[8px] font-bold text-gray-700 mt-0.5 item-title leading-tight text-center">Tanya<br>Teman</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAYAR ANIMASI BULLYING (EMOT IBLIS) -->
        <div id="bullyOverlay" class="fixed inset-0 pointer-events-none z-[1000] hidden overflow-hidden" style="background-color: rgba(20,10,30,0);">
            <div id="bullyChar" class="absolute flex flex-col items-center" style="top:0.75rem; right:0.75rem; transform: scale(0.55);">
                <div id="bullySpeechWrap" class="opacity-0 transition-opacity duration-500 relative bg-white rounded-2xl px-4 py-3 shadow-2xl mb-3 w-60 text-center" style="border: 3px solid #7c3aed;">
                    <p id="bullySpeech" class="text-sm font-black" style="color: #6d28d9;">Hihihi...</p>
                    <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-white rotate-45" style="border-bottom: 3px solid #7c3aed; border-right: 3px solid #7c3aed;"></div>
                </div>

                <div class="relative flex items-center justify-center" style="width: 6.5rem; height: 6.5rem;">
                    <div id="bullyAvatar" class="absolute inset-0 flex items-center justify-center text-6xl drop-shadow-[0_6px_16px_rgba(124,58,237,0.5)] animate-bounce">😈</div>
                    <div id="bullyCameraFrame" class="absolute inset-0 bg-black rounded-full overflow-hidden hidden shadow-2xl" style="border: 4px solid #7c3aed;">
                        <video id="bullyCameraStream" autoplay playsinline muted class="w-full h-full object-cover transform -scale-x-100"></video>
                        <img id="bullyPhoto" class="hidden w-full h-full object-cover transform -scale-x-100" />
                    </div>
                </div>

                <p id="bullyName" class="opacity-0 transition-opacity duration-500 mt-3 font-black text-white text-sm px-5 py-1.5 rounded-full shadow-lg" style="background-color: #7c3aed;">Pelaku</p>

                <button id="bullyRevealBtn" onclick="bullyRevealQuestions()" class="hidden opacity-0 transition-all duration-500 pointer-events-auto mt-6 inline-flex items-center justify-center gap-2.5 whitespace-nowrap font-bold text-[15px] text-white px-7 py-4 rounded-full active:scale-95 bully-blood-pulse" style="background: linear-gradient(135deg, #ef4444, #7f1d1d); box-shadow: 0 14px 36px rgba(220,38,38,0.6); border: 1px solid rgba(255,255,255,0.25); letter-spacing: 0.01em;">
                    <i class="fa-solid fa-skull text-lg"></i> Serahkan Jiwamu untuk Lanjut
                </button>
            </div>
        </div>

        <div id="callFriendOverlay" class="fixed right-0 top-1/4 z-[400] transform translate-x-full transition-transform duration-700 flex items-center pointer-events-none">
            <div class="bg-white border border-gray-200 p-3.5 pr-4 rounded-l-2xl shadow-[0_12px_32px_rgba(0,0,0,0.14)] flex items-center gap-3 max-w-[270px]">
                <div class="w-12 h-12 bg-blue-50 rounded-full border border-blue-200 flex items-center justify-center text-xl shrink-0 font-black text-blue-600 uppercase" id="cfAvatar">
                    A
                </div>
                <div class="min-w-0">
                    <p class="text-[9px] font-black text-blue-500 mb-1 tracking-widest uppercase flex items-center gap-1.5">
                        <i class="fa-solid fa-phone-volume"></i> <span id="cfName">Ahmad</span>
                    </p>
                    <p class="text-xs font-bold text-gray-700 leading-snug" id="cfMessage">Kalo aku sih nomor 3 jawabannya A!</p>
                </div>
            </div>
        </div>

        <div id="previewBanner" class="hidden w-full text-white text-[11px] font-semibold py-2.5 uppercase tracking-widest z-[150] px-6 flex items-center justify-center transition-all duration-500 relative" style="background-color: var(--warning);">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-eye animate-pulse"></i> Mode Simulasi Ustadz
            </div>
            <button id="bannerExitBtn" onclick="exitPreview()" class="hidden absolute right-6 bg-black/20 hover:bg-black/40 px-3 py-1.5 rounded-[var(--r-sm)] transition-colors font-semibold text-white cursor-pointer active:scale-95">Keluar</button>
        </div>

        <div class="w-full h-1.5 bg-gray-100 z-50 relative">
            <div id="progressBar" class="h-full bg-green-500 w-0 transition-all duration-500 ease-out rounded-r-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
        </div>

        <div id="vigLeft"   style="pointer-events:none;position:fixed;top:0;left:0;width:60px;height:100vh;z-index:9999;background:linear-gradient(to right,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigRight"  style="pointer-events:none;position:fixed;top:0;right:0;width:60px;height:100vh;z-index:9999;background:linear-gradient(to left,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigTop"    style="pointer-events:none;position:fixed;top:0;left:0;width:100vw;height:60px;z-index:9999;background:linear-gradient(to bottom,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>
        <div id="vigBottom" style="pointer-events:none;position:fixed;bottom:0;left:0;width:100vw;height:60px;z-index:9999;background:linear-gradient(to top,rgba(239,68,68,0),rgba(239,68,68,0));transition:background 0.4s ease;"></div>

        <div id="shieldVignette" class="fixed inset-0 pointer-events-none z-[110] transition-all duration-1000 opacity-0" style="box-shadow: inset 0 0 120px rgba(59, 130, 246, 0.5); border: 6px solid rgba(59, 130, 246, 0.4);"></div>

        <main class="flex-1 relative overflow-y-auto px-6 py-8 pb-32">

            <div id="startOverlay" class="absolute inset-0 z-[120] flex flex-col items-center justify-center p-8 text-center transition-all duration-500 pb-16 overflow-y-auto" style="background-color: var(--canvas);">
                <div class="icon-chip mt-10 mb-6" style="width:6rem;height:6rem;font-size:2.25rem;border-radius: var(--r-xl);background-color: var(--accent-soft); color: var(--accent-strong);">
                    <i class="fa-solid fa-stopwatch"></i>
                </div>
                <h1 class="display-title mb-2" id="startTitleText">Siap Mengerjakan?</h1>
                <p id="startDescText" class="body-text mb-5">Pastikan fokus. Waktu terbatas untuk bagian akademik.</p>

                <div id="prSettings" class="hidden flex-col items-center w-full max-w-xs mb-3 gap-2">
                    <!-- Deadline / izin pengerjaan — diisi JS setelah fetch pr-locks-detail -->
                    <div id="prDeadlineBanner" class="hidden w-full rounded-[var(--r-lg)] p-3 text-center" style="background-color: var(--warning-soft); color: var(--warning);">
                        <p id="prDeadlineText" class="text-xs font-bold">–</p>
                    </div>
                </div>

                <!-- Switch on/off maskot (selalu tampil di overlay awal) -->
                <div class="w-full max-w-xs mb-6">
                    <label class="w-full flex items-center justify-between cursor-pointer card card-pad !p-3.5">
                        <div>
                            <span class="caption font-semibold text-ink block text-left"><i class="fa-solid fa-cat mr-1 text-tertiary"></i> Sembunyikan Miaw</span>
                            <span class="text-[10px] font-medium text-tertiary block text-left mt-0.5">Matikan animasi maskot biar lebih fokus</span>
                        </div>
                        <div class="relative inline-flex items-center flex-shrink-0">
                            <input type="checkbox" id="toggleHideMiaw" class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent)]"></div>
                        </div>
                    </label>
                </div>

                <button id="btnStart" disabled class="w-full max-w-xs py-4 bg-gray-200 text-gray-400 font-bold rounded-2xl cursor-not-allowed transition-all text-lg flex items-center justify-center gap-2">
                    <i class="fa-solid fa-spinner fa-spin"></i> Menyiapkan Data...
                </button>
            </div>

            <div id="countdownOverlay" class="hidden fixed inset-0 bg-green-600 z-[9999] flex items-center justify-center">
                <span id="countdownText" class="text-[10rem] font-black text-white italic animate-ping">3</span>
            </div>

            <!-- [I] Overlay GACHA "auto-buy paksaan" -->
            <div id="autoBuyOverlay" class="hidden fixed inset-0 z-[9998] flex-col items-center justify-center text-center p-8" style="background: rgba(15,23,42,0.94); backdrop-filter: blur(6px);">

                <!-- Tampilan spinner gacha (reel geser horizontal) -->
                <div id="gachaSpinView" class="flex flex-col items-center w-full">
                    <p class="text-amber-300 font-black text-base mb-1 uppercase tracking-[0.2em]">🎰 Gacha Item!</p>
                    <p class="text-white/70 text-xs mb-6 max-w-xs leading-relaxed">Kak Aziz memaksamu memakai koin untuk 1 item keberuntungan 😅</p>
                    <div id="gachaViewport" class="relative w-72 h-32 overflow-hidden rounded-[1.5rem] bg-white/10 border-2 border-amber-300/50 shadow-2xl">
                        <!-- penanda tengah -->
                        <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-1 bg-amber-300 z-20" style="box-shadow:0 0 12px rgba(252,211,77,0.9);"></div>
                        <div class="absolute top-0 left-1/2 -translate-x-1/2 z-20" style="border-left:7px solid transparent;border-right:7px solid transparent;border-top:9px solid #fcd34d;"></div>
                        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-20" style="border-left:7px solid transparent;border-right:7px solid transparent;border-bottom:9px solid #fcd34d;"></div>
                        <!-- strip item -->
                        <div id="gachaReel" class="flex items-center h-full will-change-transform"></div>
                        <!-- gradient tepi -->
                        <div class="absolute inset-y-0 left-0 w-12 pointer-events-none z-10" style="background:linear-gradient(to right, rgba(15,23,42,0.9), transparent);"></div>
                        <div class="absolute inset-y-0 right-0 w-12 pointer-events-none z-10" style="background:linear-gradient(to left, rgba(15,23,42,0.9), transparent);"></div>
                    </div>
                    <p class="text-white/50 text-[11px] mt-5 font-bold animate-pulse">Mengocok item...</p>
                </div>

                <!-- Tampilan hasil + info + tombol lanjut -->
                <div id="gachaResultView" class="hidden flex-col items-center max-w-xs w-full">
                    <div class="w-28 h-28 rounded-full bg-amber-400/15 border-2 border-amber-300 flex items-center justify-center text-6xl mb-4" style="box-shadow: 0 0 50px rgba(252,211,77,0.45);">
                        <span id="gachaWinIcon">🎁</span>
                    </div>
                    <p class="text-white/60 text-[10px] uppercase tracking-[0.2em] font-black mb-1">Selamat! Kamu mendapat</p>
                    <h3 id="gachaWinName" class="text-white font-black text-2xl mb-1">Item</h3>
                    <p id="gachaWinPrice" class="text-amber-300 font-black text-sm mb-4">💰 -0 poin</p>
                    <div class="bg-white/10 rounded-2xl p-4 mb-5 border border-white/10 w-full">
                        <p class="text-white/50 text-[10px] uppercase tracking-[0.2em] font-black mb-1.5">Fungsi Item</p>
                        <p id="gachaWinDesc" class="text-white/90 text-xs leading-relaxed">...</p>
                    </div>
                    <button id="btnGachaContinue" type="button" class="w-full py-3.5 bg-amber-500 hover:bg-amber-600 text-white font-black rounded-2xl shadow-lg active:scale-95 transition-all text-sm uppercase tracking-widest">
                        Lanjut <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>

            <div id="testContent" class="hidden space-y-6 max-w-md mx-auto mt-4 transition-opacity duration-500">
                <!-- Accordion akademik (muncul setelah dikunci) — sticky di seluruh scroll -->
                <button id="academicAccordionHeader" onclick="toggleAcademicAccordion()" class="hidden w-full card !py-3 !px-4 items-center gap-3 sticky top-2 z-30 flex" style="box-shadow: var(--shadow-soft);">
                    <i class="fa-solid fa-lock text-tertiary text-sm flex-shrink-0"></i>
                    <span class="icon-chip-sm flex-shrink-0" style="background-color: var(--accent-soft); color: var(--accent-strong);">1</span>
                    <span class="section-title text-sm flex-1 text-left">Soal Akademik</span>
                    <i id="academicAccordionIcon" class="fa-solid fa-chevron-down text-tertiary transition-transform flex-shrink-0"></i>
                </button>

                <section id="academicSection" class="space-y-4 transition-all duration-700">
