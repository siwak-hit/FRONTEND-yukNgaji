    #floatingItems{ top: 100px; }
    #quickTimeOffer{ top: 92px; }
    #quickTimeBtn{ animation: quickOfferPulse 1.2s ease-in-out infinite; }
    /* Glow saja (tanpa scale) supaya tombol tetap nempel mulus di bawah timer. */
    @keyframes quickOfferPulse {
        0%, 100% { box-shadow: 0 8px 18px rgba(245,158,11,0.40); }
        50% { box-shadow: 0 11px 26px rgba(245,158,11,0.72); }
    }
    #quickTimeBtn.quick-disabled {
        background: #cbd5e1 !important;
        border-color: #cbd5e1 !important;
        color: #64748b !important;
        animation: none !important;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08) !important;
        cursor: not-allowed;
    }
</style>
