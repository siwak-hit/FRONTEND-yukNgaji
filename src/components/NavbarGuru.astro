---
const { activeMenu = 'home' } = Astro.props;
---

<nav class="tabbar fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md px-4 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] flex items-stretch z-40">
    <a href="/dashboard" class={`tabbar-item ${activeMenu === 'home' ? 'is-active' : ''}`}>
        <i class="fa-solid fa-house-chimney text-lg"></i>
        <span class="tabbar-label">Beranda</span>
    </a>
    <a href="/students" class={`tabbar-item ${activeMenu === 'students' ? 'is-active' : ''}`}>
        <i class="fa-solid fa-user-graduate text-lg"></i>
        <span class="tabbar-label">Anak</span>
    </a>
    <a href="/bank-soal" class={`tabbar-item ${activeMenu === 'exam' ? 'is-active' : ''}`}>
        <i class="fa-solid fa-book-open-reader text-lg"></i>
        <span class="tabbar-label">Bank Soal</span>
    </a>
    <a href="/consultations" class={`tabbar-item ${activeMenu === 'chat' ? 'is-active' : ''}`}>
        <div class="relative">
            <i class="fa-solid fa-comment-dots text-lg"></i>
            <span id="notifDot" class="absolute -top-1 -right-1 w-2 h-2 rounded-full hidden" style="background-color: var(--danger);"></span>
        </div>
        <span class="tabbar-label">Konsul</span>
    </a>
</nav>

<script>
    // [UPDATE] Cek localStorage (untuk Guru) ATAU sessionStorage (untuk Murid yang lagi PR)
    const tokenGuru = localStorage.getItem('token');
    const tokenMurid = sessionStorage.getItem('temp_pr_token');
    const urlParams = new URLSearchParams(window.location.search);
    const tokenDariUrl = urlParams.get('pr_token');

    // Cek apakah ada salah satu token yang valid (bukan string "null")
    const isTokenValid = (tokenGuru && tokenGuru !== 'null') || 
                         (tokenMurid && tokenMurid !== 'null') || 
                         (tokenDariUrl && tokenDariUrl !== 'null');

    if (!isTokenValid) {
        // Jika tidak ada akses sama sekali, tendang ke halaman login
        window.location.replace('/');
    }
</script>