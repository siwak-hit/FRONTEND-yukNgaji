---
/**
 * Semua popup halaman detail siswa.
 * Pakai .modal-overlay + .modal-sheet → otomatis: drawer (bottom sheet) di
 * mobile, modal terpusat di desktop. Semua id & handler dipertahankan.
 */
---

<!-- STATUS KALENG INFAQ -->
<div id="modalKaleng" class="modal-overlay hidden" style="z-index: 50;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-4">
      <h3 class="section-title">Status Kaleng Infaq</h3>
      <button id="closeModalKaleng" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <p id="kalengMessage" class="body-text"></p>
    <button id="btnOpenRemindInfaqModal" class="btn btn-secondary w-full mt-4">
        <i class="fa-solid fa-bell"></i> Ingatkan Siswa
    </button>
  </div>
</div>

<!-- KIRIM PENGINGAT KALENG -->
<div id="modalRemindInfaq" class="modal-overlay hidden" style="z-index: 55;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-4">
      <h3 class="section-title">Kirim Pengingat Kaleng</h3>
      <button id="closeModalRemindInfaq" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <p class="body-text mb-3">Kirim pengingat push notification ke siswa ini untuk mengembalikan kaleng infaq. Pesan akan dikirim ke perangkat yang sudah mengaktifkan notifikasi.</p>
    <div class="space-y-3">
      <div>
        <label class="field-label" for="infaqReminderMessage">Pesan (Opsional)</label>
        <textarea id="infaqReminderMessage" class="field field-sunken text-sm" rows="3" placeholder="Contoh: Sepertinya kamu belum mengumpulkan kaleng, nak. Mohon segera dikembalikan ya."></textarea>
        <p class="caption text-tertiary mt-1">Jika kosong, akan menggunakan pesan default.</p>
      </div>
      <button id="btnSendInfaqReminder" class="btn btn-primary w-full">
        <i class="fa-solid fa-bell"></i> <span>Kirim Pengingat Sekarang</span>
      </button>
      <p id="infaqReminderStatus" class="caption text-tertiary text-center hidden"></p>
    </div>
  </div>
</div>

<!-- DETAIL NILAI PER-MAPEL -->
<div id="drawerSubjectDetail" class="modal-overlay hidden" style="z-index: 120;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-5">
      <div>
        <h3 class="section-title" id="detailSubjectTitle">Detail Nilai</h3>
        <p class="caption mt-0.5">Transparansi Rata-rata</p>
      </div>
      <button onclick="closeSubjectDetailDrawer()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div class="card card-pad text-center mb-5">
      <p class="eyebrow mb-1">Rata-Rata Kamu</p>
      <p class="text-5xl font-bold text-ink mb-3" id="detailSubjectAvg">0</p>
      <div class="rounded-[var(--r-md)] p-3" style="background-color: var(--surface-sunken);">
        <p class="eyebrow mb-1">Rumus Perhitungan</p>
        <p class="text-[11px] font-mono font-semibold text-secondary leading-relaxed" id="detailSubjectFormula">( 0 ) / 0 = 0</p>
      </div>
    </div>

    <h4 class="eyebrow mb-3 pl-1">Riwayat Pertemuan:</h4>
    <div class="space-y-2" id="detailSubjectList"></div>
  </div>
</div>

<!-- RAPORT -->
<div id="modalRaport" class="modal-overlay hidden" style="z-index: 70;">
  <div class="modal-sheet modal-sheet-lg">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-5">
      <h3 class="section-title">Buat &amp; Download Raport</h3>
      <button onclick="closeRaportModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form id="formRaport" class="space-y-4">
      <input type="text" id="rapName" readonly class="field field-sunken font-semibold text-secondary">

      <!-- FOTO RAPORT -->
      <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--surface-sunken);">
        <div class="flex items-center justify-between mb-2">
          <h4 class="caption font-semibold text-ink">Foto Raport <span class="text-[10px] font-normal text-tertiary ml-1">(Opsional)</span></h4>
          <div class="flex items-center gap-2">
            <button type="button" id="btnAcakFoto" onclick="acakFotoRaport()" class="badge badge-info active:scale-95" title="Ambil foto acak dari kuesioner">
              <i class="fa-solid fa-shuffle"></i> Acak Foto
            </button>
            <button type="button" id="btnHapusFoto" onclick="hapusFotoRaport()" class="hidden badge badge-danger active:scale-95">
              <i class="fa-solid fa-xmark"></i> Tanpa Foto
            </button>
          </div>
        </div>
        <div id="fotoPreviewArea" class="relative flex items-center justify-center h-28 card overflow-hidden" style="border-style: dashed;">
          <div id="fotoPlaceholder" class="text-center text-tertiary">
            <i class="fa-regular fa-image text-3xl mb-1 block"></i>
            <span id="fotoStatusText" class="text-[11px]">Tekan "Acak Foto" untuk memilih foto dari kuesioner</span>
          </div>
          <img id="fotoPreviewImg" src="" alt="Preview foto raport" class="hidden absolute inset-0 w-full h-full object-cover rounded-[var(--r-lg)]">
        </div>
      </div>

      <!-- A. AKADEMIK -->
      <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--info-soft);">
        <h4 class="caption font-semibold mb-2" style="color: var(--info);">A. Akademik (Otomatis)</h4>
        <div class="space-y-2">
          <div class="flex justify-between items-center card p-2">
            <span class="caption font-semibold text-ink">Tajwid</span>
            <div class="flex items-center gap-3">
              <p class="text-[10px] text-tertiary font-semibold text-right leading-tight">
                Tg: <span id="rapNumTajwidWeekly" style="color: var(--info);">0</span> (30%)<br>
                Uj: <span id="rapNumTajwidExam" style="color: var(--warning);">0</span> (50%)<br>
                Ls: <span id="rapNumTajwidOral" style="color: #8b5cf6;">-</span> (20%)
              </p>
              <input type="text" id="rapTajwid" disabled class="w-9 text-center rounded-[var(--r-sm)] font-bold text-xs border-none py-1.5" style="background-color: var(--info-soft); color: var(--info);">
            </div>
          </div>
          <div class="flex justify-between items-center card p-2">
            <span class="caption font-semibold text-ink">Fiqih</span>
            <div class="flex items-center gap-3">
              <p class="text-[10px] text-tertiary font-semibold text-right leading-tight">
                Tg: <span id="rapNumFiqihWeekly" style="color: var(--info);">0</span> (30%)<br>
                Uj: <span id="rapNumFiqihExam" style="color: var(--warning);">0</span> (50%)<br>
                Ls: <span id="rapNumFiqihOral" style="color: #8b5cf6;">-</span> (20%)
              </p>
              <input type="text" id="rapFiqih" disabled class="w-9 text-center rounded-[var(--r-sm)] font-bold text-xs border-none py-1.5" style="background-color: var(--info-soft); color: var(--info);">
            </div>
          </div>
          <div class="flex justify-between items-center card p-2">
            <span class="caption font-semibold text-ink">Tauhid</span>
            <div class="flex items-center gap-3">
              <p class="text-[10px] text-tertiary font-semibold text-right leading-tight">
                Tg: <span id="rapNumTauhidWeekly" style="color: var(--info);">0</span> (30%)<br>
                Uj: <span id="rapNumTauhidExam" style="color: var(--warning);">0</span> (50%)<br>
                Ls: <span id="rapNumTauhidOral" style="color: #8b5cf6;">-</span> (20%)
              </p>
              <input type="text" id="rapTauhid" disabled class="w-9 text-center rounded-[var(--r-sm)] font-bold text-xs border-none py-1.5" style="background-color: var(--info-soft); color: var(--info);">
            </div>
          </div>
        </div>
        <div class="mt-2">
          <label class="field-label" style="color: var(--info);">Al-Quran / Iqro (Manual)</label>
          <select id="rapQuran" class="field"><option value="A">A (Sangat Baik)</option><option value="B">B (Baik)</option><option value="C">C (Cukup)</option><option value="D">D (Kurang)</option></select>
        </div>
      </div>

      <!-- B. KEPRIBADIAN -->
      <div class="rounded-[var(--r-lg)] p-3" style="background-color: var(--accent-soft);">
        <div class="flex items-center gap-2 mb-2">
          <h4 class="caption font-semibold" style="color: var(--accent-strong);">B. Kepribadian</h4>
          <span class="badge badge-accent">Bisa Diubah</span>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between items-center"><span class="caption text-ink">Kedisiplinan</span><select id="rapSikap1" class="field !w-auto !py-1.5 !px-3 text-sm"><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div>
          <div class="flex justify-between items-center"><span class="caption text-ink">Akhlak &amp; Adab</span><select id="rapSikap2" class="field !w-auto !py-1.5 !px-3 text-sm"><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div>
          <div class="flex justify-between items-center"><span class="caption text-ink">Keaktifan</span><select id="rapSikap3" class="field !w-auto !py-1.5 !px-3 text-sm"><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div>
        </div>
      </div>

      <!-- C. KEHADIRAN -->
      <div class="rounded-[var(--r-lg)] p-3 relative" style="background-color: var(--warning-soft);">
        <button type="button" onclick="openEditAbsensiModal()" class="absolute top-2 right-2 badge badge-warning active:scale-95">
          <i class="fa-solid fa-pen"></i> Edit Absensi
        </button>
        <h4 class="caption font-semibold mb-2" style="color: var(--warning);">C. Kehadiran (Otomatis)</h4>
        <div class="flex justify-between items-center text-xs font-semibold">
          <span style="color: var(--accent-strong);">Hadir: <span id="rapHadir" class="font-bold">0</span></span>
          <span style="color: var(--warning);">Izin: <span id="rapIzin" class="font-bold">0</span></span>
          <span style="color: var(--danger);">Alpa: <span id="rapAlpa" class="font-bold">0</span></span>
        </div>
      </div>

      <!-- D. CATATAN -->
      <div>
        <div class="flex justify-between items-end mb-1">
          <label class="field-label !mb-0">D. Catatan <span style="color: var(--danger);">*</span></label>
          <button type="button" onclick="generateSystemNote()" class="badge" style="background-color: #f3eafe; color: #8b5cf6;"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate AI</button>
        </div>
        <textarea id="rapNote" required rows="4" class="field field-sunken text-sm"></textarea>
      </div>

      <button type="submit" id="btnSaveRaport" class="btn btn-primary w-full">
        <i class="fa-solid fa-save"></i> <span>Simpan &amp; Buka PDF</span>
      </button>
    </form>
  </div>
</div>

<!-- MUROJAAH -->
<div id="drawerMurojaah" class="modal-overlay hidden" style="z-index: 120;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-5">
      <div>
        <h3 class="section-title"><i class="fa-solid fa-rotate-left mr-2" style="color: var(--info);"></i> Misi Murojaah</h3>
        <p class="caption mt-0.5">Setor Putaran Surat Pilihan</p>
      </div>
      <button onclick="closeMurojaahDrawer()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <label class="field-label" style="color: var(--info);">Pilih Tingkatan Level</label>
    <div class="relative mb-4">
      <select id="murojaahLevelSelect" onchange="renderMurojaahSurahs()" class="field"></select>
    </div>

    <label class="field-label">Pilih Surat Target</label>
    <div class="relative mb-6">
      <select id="murojaahSurahSelect" class="field"><option value="">Memuat data surat...</option></select>
    </div>

    <button onclick="submitMurojaah()" id="btnSubmitMurojaah" class="btn btn-primary w-full">
      <i class="fa-solid fa-check-double"></i> Simpan Hasil Setoran
    </button>
  </div>
</div>

<!-- ONBOARDING HAFALAN -->
<div id="modalOnboarding" class="modal-overlay hidden" style="z-index: 80;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="text-center mb-5">
      <div class="text-4xl mb-2">📖</div>
      <h3 class="section-title">Mulai Hafalan</h3>
      <p class="caption mt-1">Tentukan posisi awal hafalan ananda sekarang.</p>
    </div>
    <div class="space-y-3">
      <div>
        <label class="field-label">Surat Saat Ini</label>
        <select id="onboardingSurah" class="field field-sunken"></select>
      </div>
      <div>
        <label class="field-label">Sudah Hafal Sampai Ayat</label>
        <select id="onboardingAyah" class="field field-sunken"></select>
      </div>
      <div class="rounded-[var(--r-md)] p-3 text-center" style="background-color: var(--warning-soft);">
        <p class="caption font-semibold" style="color: var(--warning);">⚠️ Yakin nih? Kalo boong dijewer...</p>
      </div>
      <button onclick="submitOnboarding()" class="btn btn-primary w-full"><i class="fa-solid fa-check"></i> Simpan Posisi Awal</button>
      <button onclick="closeOnboardingModal()" class="w-full py-2 caption text-tertiary font-medium">Nanti saja</button>
    </div>
  </div>
</div>

<!-- EDIT CHECKPOINT -->
<div id="modalEditCheckpoint" class="modal-overlay hidden" style="z-index: 85;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-5">
      <div>
        <h3 class="section-title">Edit Posisi Hafalan</h3>
        <p class="caption mt-0.5">Override manual oleh guru</p>
      </div>
      <button onclick="closeEditCheckpointModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="space-y-3">
      <div>
        <label class="field-label">Surat</label>
        <select id="editSurah" class="field field-sunken"></select>
      </div>
      <div>
        <label class="field-label">Posisi Ayat (sudah hafal s.d.)</label>
        <select id="editAyah" class="field field-sunken"></select>
      </div>
      <button onclick="submitEditCheckpoint()" class="btn btn-primary w-full"><i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan</button>
    </div>
  </div>
</div>

<!-- INPUT HAFALAN HARIAN -->
<div id="modalHafalan" class="modal-overlay hidden" style="z-index: 75;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-4">
      <h3 class="section-title">Setor Hafalan Hari Ini</h3>
      <button onclick="closeHafalanModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div id="hafalanInfo" class="rounded-[var(--r-md)] p-3 mb-4 caption font-semibold text-center" style="background-color: var(--accent-soft); color: var(--accent-strong);"></div>
    <p id="hafalanWarning" class="hidden text-center caption font-semibold mb-3 rounded-[var(--r-md)] p-2" style="background-color: var(--warning-soft); color: var(--warning);"></p>

    <div class="seg mb-3">
      <button id="tabMaju" onclick="setHafalanMode('maju')" class="seg-btn is-active">▲ Setor Maju</button>
      <button id="tabMundur" onclick="setHafalanMode('mundur')" class="seg-btn">▼ Koreksi Mundur</button>
    </div>

    <div id="sectionMaju">
      <p class="field-label">Tambah berapa ayat?</p>
      <div id="hafalanBtnGrid" class="grid grid-cols-4 gap-2 mb-4"></div>
    </div>

    <div id="sectionMundur" class="hidden">
      <p class="field-label" style="color: var(--danger);">Mundur berapa ayat?</p>
      <div id="hafalanBtnGridMundur" class="grid grid-cols-4 gap-2 mb-4"></div>
      <p class="text-[10px] text-tertiary text-center">Jika mundur melewati batas surat, sistem otomatis pindah ke surat sebelumnya.</p>
    </div>

    <button onclick="closeHafalanModal()" class="btn btn-soft w-full">Tutup</button>
  </div>
</div>

<!-- REVIEW JAWABAN -->
<div id="modalReview" class="modal-overlay hidden" style="z-index: 110;">
  <div class="modal-sheet modal-sheet-flush" style="height: 92dvh;">
    <div class="flex justify-between items-center px-6 pt-4 pb-4 border-b shrink-0" style="border-color: var(--hairline);">
      <div>
        <h3 class="section-title"><i class="fa-solid fa-magnifying-glass mr-2" style="color: var(--info);"></i> Review Jawaban</h3>
        <p class="caption mt-0.5" id="reviewSubtitle">Memuat data...</p>
      </div>
      <button onclick="closeReviewModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div id="reviewContainer" class="flex-1 overflow-y-auto no-scrollbar p-5 space-y-4">
      <div class="text-center py-10"><i class="fa-solid fa-spinner fa-spin text-tertiary text-2xl"></i></div>
    </div>
  </div>
</div>

<!-- RIWAYAT POIN -->
<div id="modalPointHistory" class="modal-overlay hidden" style="z-index: 9999;">
  <div class="modal-sheet modal-sheet-flush" style="height: 82dvh;" id="pointHistoryBox">
    <div class="px-6 pt-4 pb-3 shrink-0">
      <div class="sheet-grabber"></div>
      <div class="flex justify-between items-start">
        <div>
          <h3 class="page-title">Riwayat Poin</h3>
          <p class="eyebrow mt-0.5">Saldo: <span style="color: var(--warning);" id="drawerTotalPoints">0</span> Poin</p>
        </div>
        <button onclick="closePointHistory()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="flex gap-2 mt-4">
        <select id="filterDays" onchange="openPointHistory()" class="field !py-2 !px-3 flex-1 text-sm font-medium">
          <option value="all">Semua Waktu</option>
          <option value="7">7 Hari Terakhir</option>
          <option value="30">30 Hari Terakhir</option>
        </select>
        <select id="filterLimit" onchange="openPointHistory()" class="field !py-2 !px-3 !w-auto text-sm font-medium">
          <option value="10">Limit 10</option>
          <option value="25">Limit 25</option>
        </select>
      </div>
    </div>
    <div id="pointHistoryList" class="flex-1 overflow-y-auto space-y-3 no-scrollbar px-6 pb-6"></div>
  </div>
</div>

<!-- UJIAN SUSULAN -->
<div id="modalSusulan" class="modal-overlay hidden" style="z-index: 90;">
  <div class="modal-sheet text-center">
    <div class="sheet-grabber"></div>
    <div class="icon-chip mx-auto mb-4" style="width:4rem;height:4rem;font-size:1.75rem;background-color: var(--warning-soft); color: var(--warning);">
      <i class="fa-solid fa-graduation-cap"></i>
    </div>
    <h3 class="section-title mb-2">Ujian Susulan</h3>
    <p class="body-text mb-6" id="susulanMessage">Berikan ujian susulan untuk anak ini?</p>
    <div class="flex gap-3">
      <button onclick="closeSusulanModal()" class="btn btn-soft flex-1" style="background-color: var(--surface-sunken); color: var(--ink-secondary);">Batal</button>
      <button id="btnConfirmSusulan" class="btn flex-1" style="background-color: var(--warning); color: #fff; border-radius: var(--r-pill);">Mulai Ujian</button>
    </div>
  </div>
</div>

<!-- EDIT ABSENSI -->
<div id="modalEditAbsensi" class="modal-overlay hidden" style="z-index: 95;">
  <div class="modal-sheet">
    <div class="sheet-grabber"></div>
    <div class="flex justify-between items-center mb-5">
      <h3 class="section-title">Edit Riwayat Absensi</h3>
      <button type="button" onclick="closeEditAbsensiModal()" class="btn-icon !w-9 !h-9" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="space-y-4">
      <div>
        <label class="field-label">1. Filter Berdasarkan Status</label>
        <select id="filterStatusAbsensi" onchange="renderEditAbsensiDates()" class="field field-sunken">
          <option value="hadir">Hadir</option>
          <option value="izin">Izin</option>
          <option value="alpa">Alpa</option>
        </select>
      </div>
      <div>
        <label class="field-label">2. Pilih Tanggal</label>
        <select id="selectTanggalAbsensi" class="field field-sunken disabled:opacity-50"></select>
      </div>
      <div>
        <label class="field-label">3. Ubah Status Menjadi</label>
        <select id="newStatusAbsensi" onchange="toggleIzinReason()" class="field" style="background-color: var(--info-soft); color: var(--info);">
          <option value="hadir">Hadir</option>
          <option value="izin">Izin</option>
          <option value="alpa">Alpa</option>
        </select>
      </div>
      <div id="containerAlasanIzin" class="hidden">
        <label class="field-label" style="color: var(--warning);">Keterangan Izin</label>
        <select id="reasonIzinAbsensi" class="field" style="background-color: var(--warning-soft); color: var(--warning);">
          <option value="sakit">Sakit</option>
          <option value="haid">Haid</option>
          <option value="pergi_mendesak">Pergi Mendesak</option>
          <option value="belajar_untuk_ujian">Belajar untuk Ujian</option>
        </select>
      </div>
      <button type="button" onclick="saveEditAbsensi()" class="btn w-full" style="background-color: var(--warning); color: #fff; border-radius: var(--r-pill);">
        <i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan
      </button>
    </div>
  </div>
</div>

<!-- Canvas tersembunyi untuk konversi gambar URL → Base64 -->
<canvas id="hiddenCanvas" style="display:none;"></canvas>
